	my ($got, $want, $tol, $name, $class) = @_;
	$class //= 'survival';
	my $r = !defined $got ? 9**9**9 : $got == $want ? 0 : abs($got - $want) / (abs($want) || 1);
	($worst{$class}, $worst_at{$class}) = ($r, $name) if $r > ($worst{$class} // 0) && $r < 9**9**9;
	ok($r <= $tol, $name) or diag('got ' . ($got // 'undef') . ", want $want, relative $r");
}
# A seven-significant-figure literal is exact to half a unit in its seventh
# figure; that, and nothing looser, is what it can be held to.
sub sig7_ok {
	my ($got, $want, $name) = @_;
	my $half = 0.5 * 10 ** (POSIX::floor(log(abs($want)) / log(10)) - 6);
	my $d = abs($got - $want);
	($worst{statsmodels}, $worst_at{statsmodels}) = ($d / $half, $name) if $d / $half > ($worst{statsmodels} // 0);
	ok($d <= $half * (1 + 1e-9), $name) or diag("got $got, printed $want");
}
# names: R's, mapped to LikeR's where they differ
sub check_fit {
	my ($label, $f, $e, %o) = @_;
	my $tol = $o{tol} // 1e-9;
	my @idx = 0 .. $#{ $e->{coef} };
	is(scalar(@{ $f->{coef} }), scalar(@idx), "$label: number of coefficients");
	for my $j (@idx) {
		close_to($f->{coef}[$j], $e->{coef}[$j], $tol, "$label: coef $j");
		close_to($f->{se}[$j], $e->{se}[$j], $tol, "$label: se $j");
		close_to($f->{'naive.se'}[$j], $e->{naive_se}[$j], $tol, "$label: naive se $j") if $e->{naive_se};
	}
	close_to($f->{loglik}, $e->{loglik}, $tol, "$label: loglik");
	close_to($f->{'loglik.null'}, $e->{loglik0}, $tol, "$label: null loglik");
	close_to($f->{'score.test'}{statistic}, $e->{score}, $tol, "$label: score test");
	close_to($f->{'wald.test'}{statistic}, $e->{wald}, $tol, "$label: Wald test");
	close_to($f->{'robust.score.test'}{statistic}, $e->{rscore}, $tol, "$label: robust score test") if defined $e->{rscore};
	is($f->{n}, $e->{n}, "$label: n");
	is($f->{nevent}, $e->{nevent}, "$label: nevent");
	is($f->{robust}, $e->{naive_se} ? 1 : 0, "$label: robust flag");
}

# ------------------------------------------------------------ doweight.R
for my $tie (qw(breslow efron)) {
	my $w  = coxph(formula => 'Surv(time, status) ~ x', data => $DATA{testw1}, weights => 'wt', ties => $tie);
	my $r  = coxph(formula => 'Surv(time, status) ~ x', data => $DATA{testw2}, ties => $tie);
	check_fit("testw1 weighted, $tie", $w, $EXPECT{"testw1_$tie"});
	check_fit("testw2 replicated, $tie", $r, $EXPECT{"testw2_$tie"});
	# doweight.R's identity holds for Breslow only: Efron treats replicated
	# deaths as tied deaths, which a weight is not
	if ($tie eq 'breslow') {
		close_to($w->{coef}[0], $r->{coef}[0], 1e-12, "doweight.R: weights = replication, $tie");
		close_to($w->{loglik}, $r->{loglik}, 1e-12, "doweight.R: same loglik, $tie");
	}
	check_fit("testw1 weighted robust, $tie",
	          coxph(formula => 'Surv(time, status) ~ x', data => $DATA{testw1}, weights => 'wt', ties => $tie, robust => 1),
	          $EXPECT{"testw1_${tie}_robust"});
	check_fit("testw2 clustered by replicate, $tie",
	          coxph(formula => 'Surv(time, status) ~ x', data => $DATA{testw2}, ties => $tie, cluster => 'id'),
	          $EXPECT{"testw2_${tie}_cluster"});
	# and the positional form, with weights as an array
	my $d = $DATA{testw1};
	check_fit("testw1 positional, $tie", coxph($d->{time}, $d->{status}, $d->{x}, weights => $d->{wt}, ties => $tie),
	          $EXPECT{"testw1_$tie"});
}
{
	my %d = %{ $DATA{testw1} };
