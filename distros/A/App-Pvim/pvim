#!/usr/bin/env perl
use 5.010;
use strict;
use warnings;

# All runtime code lives here. Packages separate storage, commands and terminal IO.
package PVim::Store;
use File::Temp qw(tempfile);
use File::Basename qw(dirname);
use File::Spec;
use Digest::SHA qw(sha256_hex);

sub new {
    my ($class) = @_;
    my ($data) = tempfile(UNLINK => 1);
    my ($index) = tempfile(UNLINK => 1);
    binmode $data; binmode $index;
    return bless { data => $data, index => $index, next => 0, pieces => [], count => 0,
        undo => [], redo => [], state => 0, serial => 0, saved => 0, eol => "\n", final => 1 }, $class;
}
sub _seek { seek($_[0], $_[1], 0) or die "Temporary-file seek: $!\n" }
sub _record {
    my ($s, $offset, $length, $term) = @_;
    my $id = $s->{next}++;
    _seek($s->{index}, $id * 24) unless tell($s->{index}) == $id * 24;
    print {$s->{index}} pack('d3', $offset, $length, $term) or die "Temporary index: $!\n";
    return $id;
}
sub record {
    my ($s, $id) = @_;
    _seek($s->{index}, $id * 24);
    read($s->{index}, my $record, 24) == 24 or die "Temporary index read failed\n";
    return unpack('d3', $record);
}
sub id {
    my ($s, $line) = @_;
    die "Line out of range\n" if $line < 0 || $line >= $s->{count};
    my ($lo, $hi) = (0, $#{$s->{pieces}});
    while ($lo <= $hi) {
        my $mid = int(($lo + $hi) / 2);
        my $p = $s->{pieces}[$mid];
        if ($line < $p->[2]) { $hi = $mid - 1 }
        elsif ($line >= $p->[2] + $p->[1]) { $lo = $mid + 1 }
        else { return $p->[0] + $line - $p->[2] }
    }
    die "Corrupt piece index\n";
}
sub line {
    my ($s, $line) = @_;
    my $id = $s->id($line);
    return $s->{cache}{$id} if exists $s->{cache}{$id};
    my ($offset, $length) = $s->record($id);
    _seek($s->{data}, $offset);
    my $text = '';
    while (length($text) < $length) {
        my $got = read($s->{data}, my $chunk, $length - length($text));
        die "Temporary data read failed\n" unless $got;
        $text .= $chunk;
    }
    if (length($text) <= 65536) {
        $s->{cache}{$id} = $text; push @{$s->{cache_order}}, $id;
        delete $s->{cache}{shift @{$s->{cache_order}}} if @{$s->{cache_order}} > 128;
    }
    return $text;
}
sub term { my ($s, $line) = @_; my @r = $s->record($s->id($line)); return $r[2] }
sub append {
    my ($s, $text, $term) = @_;
    die "Internal newline in line\n" if $text =~ /\n/;
    seek($s->{data}, 0, 2) or die "Temporary data seek: $!\n";
    my $off = tell($s->{data});
    $term = length($s->{eol}) unless defined $term;
    print {$s->{data}} $text, ($term == 2 ? "\r\n" : $term == 1 ? "\n" : '') or die "Temporary data write: $!\n";
    return $s->_record($off, length($text), $term);
}
sub reindex {
    my ($s) = @_;
    my (@out, $n);
    $n = 0;
    for my $p (@{$s->{pieces}}) {
        next unless $p->[1];
        if (@out && $out[-1][0] + $out[-1][1] == $p->[0] && ($s->record($p->[0]-1))[2]) { $out[-1][1] += $p->[1] }
        else { push @out, [$p->[0], $p->[1], $n] }
        $n += $p->[1];
    }
    $s->{pieces} = \@out; $s->{count} = $n;
}
sub slice {
    my ($s, $start, $length) = @_;
    my @out;
    for my $p (@{$s->{pieces}}) {
        my $a = $start > $p->[2] ? $start : $p->[2];
        my $b = $start + $length < $p->[2] + $p->[1] ? $start + $length : $p->[2] + $p->[1];
        push @out, [$p->[0] + $a - $p->[2], $b - $a] if $b > $a;
    }
    return @out;
}
sub splice_lines {
    my ($s, $start, $length, @ids) = @_;
    die "Invalid splice\n" if $start < 0 || $length < 0 || $start + $length > $s->{count};
    my @new = ($s->slice(0, $start), (map { [$_, 1] } @ids), $s->slice($start + $length, $s->{count} - $start - $length));
    $s->{pieces} = \@new;
    $s->reindex;
    unless ($s->{count}) { $s->{pieces} = [[$s->append('', 0), 1]]; $s->reindex }
}
sub set_line {
    my ($s, $n, $text) = @_;
    $s->splice_lines($n, 1, $s->append($text, $s->term($n)));
}
sub snapshot { my ($s) = @_; return { pieces => [map { [@$_] } @{$s->{pieces}}], state => $s->{state}, final => $s->{final}, cursor => [@{$s->{cursor} || [0,0]}] } }
sub restore { my ($s, $v) = @_; $s->{pieces} = [map { [@$_] } @{$v->{pieces}}]; $s->{state} = $v->{state}; $s->{final} = $v->{final}; $s->{cursor} = [@{$v->{cursor}}]; $s->reindex }
sub begin { my ($s) = @_; $s->{before} = $s->snapshot unless $s->{before} }
sub commit {
    my ($s) = @_;
    my $before = delete $s->{before} or return;
    my $old = join(';', map { join(',', @$_[0,1]) } @{$before->{pieces}});
    my $now = join(';', map { join(',', @$_[0,1]) } @{$s->{pieces}});
    return if $old eq $now && $before->{final} == $s->{final};
    push @{$s->{undo}}, $before;
    $s->{redo} = []; $s->{state} = ++$s->{serial};
}
sub rollback { my ($s) = @_; my $v = delete $s->{before}; $s->restore($v) if $v }
sub undo {
    my ($s, $redo) = @_;
    $s->commit;
    my ($from, $to) = $redo ? ('redo','undo') : ('undo','redo');
    return 0 unless @{$s->{$from}};
    push @{$s->{$to}}, $s->snapshot;
    $s->restore(pop @{$s->{$from}}); return 1;
}
sub dirty { my ($s) = @_; return $s->{state} != $s->{saved} || !!$s->{before} }
sub fingerprint {
    my ($path) = @_;
    return '' unless -e $path;
    open my $fh, '<', $path or die "Read $path: $!\n"; binmode $fh;
    my $digest = Digest::SHA->new(256); $digest->addfile($fh);
    close $fh or die "Close $path: $!\n";
    return $digest->hexdigest;
}
sub load {
    my ($class, $path, $input) = @_;
    my $s = $class->new;
    $s->{path} = $path if defined($path) && length($path);
    unless ($input || (defined($path) && length($path) && -e $path)) {
        die "Refusing dangling symlink\n" if defined($path) && -l $path;
        $s->splice_lines(0, 0, $s->append('', 0)); $s->{fingerprint} = ''; return $s;
    }
    die "Not a regular file: $path\n" unless $input || -f $path;
    my $fh = $input;
    unless ($fh) { open $fh, '<', $path or die "Read $path: $!\n" }
    binmode $fh;
    my $label = $input ? 'standard input' : $path;
    my $digest = Digest::SHA->new(256);
    my ($offset, $start, $prev, $first, $last_term) = (0, 0, '', 1, 0);
    while (1) {
        my $got = read($fh, my $chunk, 65536);
        die "Read $label: $!\n" unless defined $got;
        last unless $got;
        $digest->add($chunk);
        print {$s->{data}} $chunk or die "Temporary data: $!\n";
        while ($chunk =~ /\n/g) {
            my $end = $offset + pos($chunk) - 1;
            my $cr = pos($chunk) > 1 ? substr($chunk, pos($chunk) - 2, 1) eq "\r" : $prev eq "\r";
            my $term = $cr ? 2 : 1;
            $s->_record($start, $end - $start - ($cr ? 1 : 0), $term);
            if ($first) { $s->{eol} = $cr ? "\r\n" : "\n"; $first = 0 }
            $start = $end + 1; $last_term = $term;
        }
        $offset += $got; $prev = substr($chunk, -1);
    }
    unless ($input) { close $fh or die "Close $path: $!\n" }
    if ($start < $offset || !$offset) { $s->_record($start, $offset - $start, 0); $last_term = 0 }
    $s->{final} = $last_term ? 1 : 0;
    $s->{fingerprint} = $digest->hexdigest;
    $s->{pieces} = [[0, $s->{next}]]; $s->reindex;
    if ($input) { $s->{state} = ++$s->{serial}; $s->{fingerprint} = '' }
    return $s;
}
sub write_to {
    my ($s, $out) = @_;
    # Every run has physical newlines internally; its boundary may need a newline.
    for my $p (@{$s->{pieces}}) {
        my ($offset) = $s->record($p->[0]);
        my ($end, $body, $term) = $s->record($p->[0]+$p->[1]-1);
        my $len = $end + $body - $offset;
        _seek($s->{data}, $offset);
        while ($len) {
            my $got = read($s->{data}, my $chunk, $len > 65536 ? 65536 : $len);
            die "Temporary data read failed\n" unless $got;
            print {$out} $chunk or die "Write: $!\n"; $len -= $got;
        }
        my $last = $p->[2] + $p->[1] == $s->{count};
        my $eol = $term == 2 ? "\r\n" : $term == 1 ? "\n" : $s->{eol};
        print {$out} $eol or die "Write: $!\n" if !$last || $s->{final};
    }
}
sub save {
    my ($s, $path, $force) = @_;
    $s->commit;
    $path = $s->{path} unless defined($path) && length($path);
    die "No filename; use :w filename\n" unless defined($path) && length($path);
    die "Refusing to replace a symlink\n" if -l $path;
    die "Not a regular file: $path\n" if -e $path && !-f $path;
    my $same = defined($s->{path}) && File::Spec->rel2abs($path) eq File::Spec->rel2abs($s->{path});
    my $expected = $same ? $s->{fingerprint} : '';
    my $current = fingerprint($path);
    die "File exists or changed on disk; use :w! to overwrite\n" if !$force && $current ne $expected;
    my @stat = stat($path);
    die "File has multiple hard links; refusing atomic replacement\n" if @stat && $stat[3] > 1;
    die "File is read-only\n" if @stat && !($stat[2] & 0222);
    my ($fh, $tmp) = tempfile('.pvim-save-XXXXXX', DIR => dirname(File::Spec->rel2abs($path)), UNLINK => 0);
    binmode $fh;
    my $ok = eval {
        $s->write_to($fh); close($fh) or die "Close output: $!\n";
        my $mode = @stat ? $stat[2] & 0777 : 0666 & ~umask;
        chmod($mode, $tmp) or die "chmod: $!\n";
        die "Target changed during save\n" if -l $path || fingerprint($path) ne $current;
        rename($tmp, $path) or die "Rename: $!\n";
        1;
    };
    my $error = $@;
    unless ($ok) { close $fh; unlink $tmp; die $error }
    $s->{path} = $path; $s->{fingerprint} = fingerprint($path); $s->{saved} = $s->{state};
    return $path;
}

package PVim::Editor;
sub new {
    my ($class, $store) = @_;
    return bless { b => $store, row => 0, col => 0, mode => 'normal', number => 0,
        tabstop => 8, message => '', pending => '', count => '', register => [], page => 20 }, $class;
}
sub clamp {
    my ($e) = @_;
    $e->{row} = 0 if $e->{row} < 0;
    $e->{row} = $e->{b}{count} - 1 if $e->{row} >= $e->{b}{count};
    my $max = length($e->{b}->line($e->{row})) - ($e->{mode} eq 'normal' ? 1 : 0);
    $max = 0 if $max < 0;
    $e->{col} = 0 if $e->{col} < 0; $e->{col} = $max if $e->{col} > $max;
}
sub edit {
    my ($e, $cb) = @_;
    my $b = $e->{b}; $b->{cursor} = [@{$e}{qw(row col)}]; $b->begin;
    my $ok = eval { $cb->(); 1 };
    unless ($ok) { my $err = $@; $b->rollback; die $err }
    $b->commit; $e->clamp;
}
sub insert_mode { my ($e, $mode) = @_; $e->{b}{cursor} = [@{$e}{qw(row col)}]; $e->{b}->begin; $e->{mode} = $mode || 'insert' }
sub undo {
    my ($e,$redo) = @_; my $b = $e->{b}; $b->{cursor} = [@{$e}{qw(row col)}];
    return 0 unless $b->undo($redo); @{$e}{qw(row col)} = @{$b->{cursor}}; $e->clamp; return 1;
}
sub word {
    my ($e, $key, $count) = @_;
    for (1 .. $count) {
        my $line = $e->{b}->line($e->{row}); my $c = $e->{col};
        if ($key eq 'b') {
            if (!$c && $e->{row}) { --$e->{row}; $line = $e->{b}->line($e->{row}); $c = length($line) }
            $c-- if $c; $c-- while $c && substr($line,$c,1) =~ /\s/;
            my $type = substr($line,$c,1) =~ /\w/ ? qr/\w/ : qr/[^\w\s]/;
            $c-- while $c && substr($line,$c-1,1) =~ $type;
        } elsif ($key eq 'w') {
            my $tail = substr($line,$c); $tail =~ /^(?:\w+|[^\w\s]+)?\s*/; $c += length($&);
            if ($c >= length($line) && $e->{row} < $e->{b}{count}-1) {
                ++$e->{row}; $line = $e->{b}->line($e->{row}); $line =~ /^\s*/; $c = length($&);
            }
        } else {
            $c++ if $c < length($line)-1;
            if ($c >= length($line) && $e->{row} < $e->{b}{count}-1) { ++$e->{row}; $line = $e->{b}->line($e->{row}); $c = 0 }
            $c++ while $c < length($line)-1 && substr($line,$c,1) =~ /\s/;
            my $type = substr($line,$c,1) =~ /\w/ ? qr/\w/ : qr/[^\w\s]/;
            $c++ while $c < length($line)-1 && substr($line,$c+1,1) =~ $type;
        }
        $e->{col} = $c;
    }
    $e->clamp;
}
sub search {
    my ($e, $pattern, $dir) = @_;
    $pattern = $e->{search} unless length $pattern;
    die "No previous search\n" unless defined $pattern;
    my $rx = eval { qr/$pattern/ }; die "Invalid regex: $@" if $@;
    $e->{search} = $pattern; $e->{direction} = $dir;
    my $n = $e->{b}{count};
    for my $step (0 .. $n) {
        my $r = ($e->{row} + $dir * $step) % $n;
        my $text = $e->{b}->line($r); my @positions;
        while ($text =~ /$rx/g) { push @positions, $-[0] }
        @positions = reverse @positions if $dir < 0;
        for my $c (@positions) {
            # Zero-width EOF matches occupy the final displayed character cell.
            $c = length($text)-1 if $c >= length($text);
            $c = 0 if $c < 0;
            next if !$step && ($dir > 0 ? $c <= $e->{col} : $c >= $e->{col});
            next if $step == $n && ($dir > 0 ? $c > $e->{col} : $c < $e->{col});
            ($e->{row}, $e->{col}) = ($r, $c); $e->clamp; return;
        }
    }
    die "Pattern not found: $pattern\n";
}
sub replacement {
    my ($template, $text, $starts, $ends) = @_;
    my $out = '';
    while (length $template) {
        my $c = substr($template,0,1,'');
        if ($c eq '&') { $out .= substr($text,$starts->[0],$ends->[0]-$starts->[0]) }
        elsif ($c eq '\\' && length $template) {
            my $n = substr($template,0,1,'');
            if ($n =~ /[0-9]/) { $out .= substr($text,$starts->[$n],$ends->[$n]-$starts->[$n]) if defined($starts->[$n]) && $starts->[$n] >= 0 }
            elsif ($n eq 't') { $out .= "\t" }
            else { $out .= $n }
        } else { $out .= $c }
    }
    return $out;
}
sub substitute {
    my ($e, $lo, $hi, $spec) = @_;
    my $delimiter = substr($spec,0,1,'');
    die "Use s/pattern/replacement/[gi]\n" unless $delimiter =~ m{[^\w\s\\]};
    my @parts;
    for my $part_number (1 .. 2) {
        my $part = ''; my $done = 0;
        while (length $spec) {
            my $c = substr($spec,0,1,'');
            if ($c eq $delimiter) { $done = 1; last }
            if ($c eq '\\' && length($spec)) {
                my $next = substr($spec,0,1,'');
                $part .= $next eq $delimiter && $part_number == 1 ? quotemeta($next) : '\\' . $next;
            } else { $part .= $c }
        }
        die "Missing substitute delimiter\n" unless $done;
        push @parts, $part;
    }
    die "Supported flags: g i\n" unless $spec =~ /^[gi]*$/;
    my ($pattern,$replacement) = @parts;
    $pattern = $e->{search} unless length $pattern;
    die "No previous search\n" unless defined $pattern;
    my $rx = eval { $spec =~ /i/ ? qr/$pattern/i : qr/$pattern/ }; die "Invalid regex: $@" if $@;
    my $changed = 0;
    $e->edit(sub {
        my $b = $e->{b};
        my @pieces = $b->slice(0,$lo);
        for my $r ($lo .. $hi) {
            my $old = $b->line($r); my ($out,$end,$hits) = ('',0,0);
            while ($old =~ /$rx/g) {
                my @starts = @-; my @ends = @+;
                $out .= substr($old,$end,$starts[0]-$end) . replacement($replacement,$old,\@starts,\@ends);
                $end = $ends[0]; ++$hits;
                last unless $spec =~ /g/;
            }
            $out .= substr($old,$end) if $hits;
            my $id = $hits && $out ne $old ? $b->append($out,$b->term($r)) : $b->id($r);
            if (@pieces && $pieces[-1][0]+$pieces[-1][1] == $id && ($b->record($id-1))[2]) { ++$pieces[-1][1] }
            else { push @pieces, [$id,1] }
            $changed += $hits;
        }
        push @pieces, $b->slice($hi+1,$b->{count}-$hi-1);
        $b->{pieces} = \@pieces; $b->reindex;
    });
    $e->{search} = $pattern;
    die "Pattern not found\n" unless $changed;
    $e->{message} = "$changed substitutions";
}
sub tidy {
    my ($e) = @_;
    eval { require Perl::Tidy; 1 } or die "Perl::Tidy is unavailable; install perltidy to use :pt\n";
    die "Perltidy limited to 8 MiB; format a smaller file\n" if $e->{b}{count} > 200000;
    my $source = '';
    for my $r (0 .. $e->{b}{count}-1) {
        $source .= $e->{b}->line($r) . "\n";
        die "Perltidy limited to 8 MiB\n" if length($source) > 8*1024*1024;
    }
    my ($dest,$err) = ('','');
    my $rc = Perl::Tidy::perltidy(source => \$source, destination => \$dest, stderr => \$err, argv => ['-npro','-l=500']);
    die "Perltidy failed: $err\n" if $rc;
    my @lines = split /\n/, $dest, -1; pop @lines if @lines && $lines[-1] eq '';
    @lines = ('') unless @lines;
    $e->edit(sub { $e->{b}->splice_lines(0,$e->{b}{count}, map { $e->{b}->append($_) } @lines) });
    $e->{message} = 'Formatted with perltidy -l 500';
}
sub shell_status {
    my ($command) = @_;
    local $SIG{TSTP} = 'DEFAULT' unless $^O eq 'MSWin32';
    my $status = $^O eq 'MSWin32'
        ? system($ENV{COMSPEC} || 'cmd.exe','/d','/s','/c',$command)
        : system('/bin/sh','-c',$command);
    die "Cannot execute command: $!\n" if $status == -1;
    return $status;
}
sub shell {
    my ($e,$command) = @_;
    die "Shell command required\n" unless length $command;
    my ($status,$suspended);
    my $ok = eval {
        if ($e->{before_filter}) { $e->{before_filter}->(); $suspended = 1 }
        local $SIG{TSTP} = 'DEFAULT' unless $^O eq 'MSWin32';
        $status = shell_status($command);
        $e->{shell_wait}->() if $suspended && $e->{shell_wait};
        1;
    };
    my $failure = $@;
    $e->{after_filter}->() if $suspended && $e->{after_filter};
    die $failure unless $ok;
    my $reason = $status & 127 ? 'signal '.($status & 127) : 'exit '.($status >> 8);
    $e->{message} = $status ? "Shell command failed ($reason); buffer unchanged" : 'Shell command completed';
    die "$e->{message}\n" if $status;
}
sub filter {
    my ($e,$lo,$hi,$command,$insert) = @_;
    die "Filter command required\n" unless length $command;
    my $input = File::Temp->new(UNLINK => 1);
    my $output = File::Temp->new(UNLINK => 1);
    my $output_path = $output->filename;
    my $errors = File::Temp->new(UNLINK => 1);
    binmode $input; binmode $output; binmode $errors;
    my $b = $e->{b};
    for my $r ($lo..$hi) {
        my $term = $b->term($r);
        my $ending = $term == 2 ? "\r\n" : $term == 1 ? "\n" : $b->{eol};
        $ending = '' if $r == $b->{count}-1 && !$b->{final};
        print {$input} $b->line($r),$ending or die "Filter input: $!\n";
    }
    seek($input,0,0) or die "Filter input seek: $!\n";
    my ($saved_in,$saved_out,$saved_err);
    open $saved_in,'<&',\*STDIN or die "Save stdin: $!\n";
    open $saved_out,'>&',\*STDOUT or die "Save stdout: $!\n";
    open $saved_err,'>&',\*STDERR or die "Save stderr: $!\n";
    my ($status,$suspended);
    my $ok = eval {
        if ($e->{before_filter}) { $e->{before_filter}->(); $suspended = 1 }
        open STDIN,'<&',$input or die "Filter stdin: $!\n";
        open STDOUT,'>&',$output or die "Filter stdout: $!\n";
        open STDERR,'>&',$errors or die "Filter stderr: $!\n";
        # Shell execution is explicit and only reached by a user-issued ! filter.
        # Temp filenames and buffer contents are never interpolated into commands.
        $status = shell_status($command);
        1;
    };
    my $failure = $@;
    my $restored = 1;
    $restored = 0 unless open STDIN,'<&',$saved_in;
    $restored = 0 unless open STDOUT,'>&',$saved_out;
    $restored = 0 unless open STDERR,'>&',$saved_err;
    if ($suspended) { $e->{after_filter}->() if $e->{after_filter} }
    die "Cannot restore filter IO\n" unless $restored;
    die $failure unless $ok;
    seek($errors,0,0) or die "Filter error seek: $!\n";
    read($errors,my $diagnostic,4096);
    if ($status) {
        my $reason = $status & 127 ? 'signal '.($status & 127) : 'exit '.($status >> 8);
        die "Filter failed ($reason); buffer unchanged: $diagnostic\n";
    }
    # Close the capture handle before reopening on Windows. The file remains
    # owned by its File::Temp object until this command returns.
    close $output or die "Close filter output: $!\n";
    my $result = PVim::Store->load($output_path);
    my $empty = !-s $output_path;
    if ($insert && $empty) { $e->{message} = 'Read 0 lines'; return }
    $e->edit(sub {
        my @pieces = $b->slice(0,$lo);
        unless ($empty) {
            my $first;
            for my $r (0..$result->{count}-1) {
                my $id = $b->append($result->line($r),$result->term($r));
                $first = $id unless defined $first;
            }
