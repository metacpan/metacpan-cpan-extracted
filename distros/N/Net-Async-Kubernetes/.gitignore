# Build artifacts
Net-Async-Kubernetes-*/
Net-Async-Kubernetes-*.tar.gz
.build/

# Test coverage
cover_db/

# Carton / local libs
cpanfile.snapshot
local/
dzil-local/

# Editor backups
*~
*.swp
*.bak

# Claude Code — commit: skills/, agents/, rules/, hooks/, settings.json
# Ignore: local overrides, credentials, session data
!/.claude/
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/agents/**
!.claude/skills/
!.claude/skills/**
!.claude/rules/
!.claude/rules/**
!.claude/hooks/
!.claude/hooks/**
# Local overrides (machine-specific)
.claude/*.local.*
.claude/local/
# Credentials & session state (never track)
.claude/.credentials.json
.claude/statsig/
.claude/todos/
.claude/projects/

# Local planning artifacts
docs/superpowers/

# karr materialized task view -- never commit
tasks/
config.yml

# karr-foundation per-repo state — local machine only, never commit
.karr.state
