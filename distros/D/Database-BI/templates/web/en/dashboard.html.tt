<script>
// ---------------------------------------------------------------------------
// Pivot table panel
// ---------------------------------------------------------------------------
(function () {
  var btnOpen   = document.getElementById('btn-pivot');
  var panel     = document.getElementById('pivot-panel');
  if (!btnOpen || !panel) return;

  var btnCancel = document.getElementById('btn-cancel-pivot');
  var btnDo     = document.getElementById('btn-do-pivot');
  var pivotForm = document.getElementById('pivot-form');
  var rowDimList    = document.getElementById('pivot-row-dims');
  var colDimList    = document.getElementById('pivot-col-dims');
  var measureList   = document.getElementById('pivot-measures');
  var chkTotals     = document.getElementById('pivot-totals');

  var otherPanels = ['join-panel', 'combine-panel', 'export-panel', 'graph-panel', 'pie-panel', 'heatmap-panel', 'bar-panel', 'stacked-panel', 'scatter-panel', 'combo-panel', 'treemap-panel', 'histogram-panel', 'folder-panel', 'calc-panel', 'groups-panel', 'dates-panel', 'save-analysis-panel', 'map-panel'].map(function (id) {
    return document.getElementById(id);
  }).filter(Boolean);

  // Collect column names from the rendered table header.
  function getColumns() {
    var tbl = document.querySelector('table[data-table]') || document.querySelector('table');
    if (!tbl || !tbl.tHead) return [];
    return Array.from(tbl.tHead.rows[0].cells)
      .map(function (th) { return th.textContent.trim(); })
      .filter(function (s) { return s.length > 0; });
  }

  function colOption(col) {
    var opt = document.createElement('option');
    opt.value = col; opt.textContent = col;
    return opt;
  }

  function makeColSelect(placeholder) {
    var sel = document.createElement('select');
    var ph = document.createElement('option');
    ph.value = ''; ph.textContent = placeholder;
    sel.appendChild(ph);
    getColumns().forEach(function (c) { sel.appendChild(colOption(c)); });
    sel.addEventListener('change', checkPivot);
    return sel;
  }

  function addDimRow(container, label) {
    var row = document.createElement('div');
    row.className = 'pivot-dim-row';
    var sel = makeColSelect(label || '\u2014 column \u2014');
    var rm  = document.createElement('button');
    rm.type = 'button'; rm.className = 'btn-remove-pivot'; rm.textContent = '\u00d7';
    rm.addEventListener('click', function () { row.remove(); checkPivot(); });
    row.appendChild(sel); row.appendChild(rm);
    container.appendChild(row);
    checkPivot();
    return sel;
  }

  function autoAlias(col, fn) {
    if (!col) return '';
    if (fn === 'count' || fn === 'count_distinct') return fn === 'count' ? 'count' : col + '_distinct';
    return col + '_' + fn;
  }

  function addMeasureRow() {
    var row = document.createElement('div');
    row.className = 'pivot-measure-row';

    var colSel = document.createElement('select');
    var ph = document.createElement('option'); ph.value = ''; ph.textContent = '\u2014 column \u2014';
    colSel.appendChild(ph);
    getColumns().forEach(function (c) { colSel.appendChild(colOption(c)); });

    var fnSel = document.createElement('select');
    [['sum','Sum'], ['count','Count'], ['avg','Average'], ['min','Min'],
     ['max','Max'], ['count_distinct','Count distinct']].forEach(function (p) {
      var opt = document.createElement('option');
      opt.value = p[0]; opt.textContent = p[1];
      fnSel.appendChild(opt);
    });

    var aliasInp = document.createElement('input');
    aliasInp.type = 'text'; aliasInp.placeholder = 'alias';

    var aliasLabel = document.createElement('span');
    aliasLabel.className = 'pivot-alias-label';
    aliasLabel.textContent = 'as';

    function refreshAlias() {
      if (!aliasInp.dataset.userEdited) {
        aliasInp.value = autoAlias(colSel.value, fnSel.value);
      }
      checkPivot();
    }
    colSel.addEventListener('change', refreshAlias);
    fnSel.addEventListener('change',  refreshAlias);
    aliasInp.addEventListener('input', function () {
      aliasInp.dataset.userEdited = aliasInp.value ? '1' : '';
      checkPivot();
    });

    var rm = document.createElement('button');
    rm.type = 'button'; rm.className = 'btn-remove-pivot'; rm.textContent = '\u00d7';
    rm.addEventListener('click', function () { row.remove(); checkPivot(); });

    row.appendChild(colSel); row.appendChild(fnSel);
    row.appendChild(aliasLabel); row.appendChild(aliasInp);
    row.appendChild(rm);
    measureList.appendChild(row);
    checkPivot();
  }

  function checkPivot() {
    var rowSelects = Array.from(rowDimList.querySelectorAll('select'));
    var hasRow = rowSelects.some(function (s) { return s.value; });
    var measures = Array.from(measureList.querySelectorAll('.pivot-measure-row'));
    var hasM = measures.some(function (row) {
      var fn    = row.querySelectorAll('select')[1].value;
      var alias = row.querySelector('input[type="text"]').value.trim();
      return alias.length > 0 && (fn === 'count' || row.querySelectorAll('select')[0].value);
    });
    btnDo.disabled = !(hasRow && hasM);
  }

  pivotForm.addEventListener('submit', function () {
    // Remove previously-generated dynamic pivot params.
    Array.from(pivotForm.querySelectorAll('[data-pivot-dyn]')).forEach(function (i) { i.remove(); });

    // Inject back= so pivot page can render a breadcrumb back to this view.
    (function () {
      var inp = document.createElement('input');
      inp.type = 'hidden'; inp.name = 'back'; inp.value = window.location.href;
      inp.setAttribute('data-pivot-dyn', '1');
      pivotForm.appendChild(inp);
      var lbl = document.createElement('input');
      lbl.type = 'hidden'; lbl.name = 'back_label'; lbl.value = 'Back to table';
      lbl.setAttribute('data-pivot-dyn', '1');
      pivotForm.appendChild(lbl);
    }());

    function addHidden(name, val) {
      var inp = document.createElement('input');
      inp.type = 'hidden'; inp.name = name; inp.value = val;
      inp.setAttribute('data-pivot-dyn', '1');
      pivotForm.appendChild(inp);
    }

    // rows= (comma-joined)
    var rowVals = Array.from(rowDimList.querySelectorAll('select'))
      .map(function (s) { return s.value; }).filter(Boolean);
    if (rowVals.length) addHidden('rows', rowVals.join(','));

    // cols= (comma-joined, optional)
    var colVals = Array.from(colDimList.querySelectorAll('select'))
      .map(function (s) { return s.value; }).filter(Boolean);
    if (colVals.length) addHidden('cols', colVals.join(','));

    // m=col:fn:alias (one per measure)
    Array.from(measureList.querySelectorAll('.pivot-measure-row')).forEach(function (row) {
      var sels  = row.querySelectorAll('select');
      var col   = sels[0].value;
      var fn    = sels[1].value;
      var alias = row.querySelector('input[type="text"]').value.trim();
      if (!alias) return;
      if (fn !== 'count' && !col) return;
      addHidden('m', col + ':' + fn + ':' + alias);
    });

    // totals=1
    if (chkTotals && chkTotals.checked) addHidden('totals', '1');
  });

  document.getElementById('btn-add-pivot-row').addEventListener('click', function () {
    addDimRow(rowDimList, '\u2014 row \u2014');
  });
  document.getElementById('btn-add-pivot-col').addEventListener('click', function () {
    addDimRow(colDimList, '\u2014 column \u2014');
  });
  document.getElementById('btn-add-pivot-measure').addEventListener('click', addMeasureRow);

  btnOpen.addEventListener('click', function () {
    otherPanels.forEach(function (p) { p.hidden = true; });
    panel.hidden = !panel.hidden;
    if (!panel.hidden && rowDimList.childElementCount === 0) {
      addDimRow(rowDimList, '\u2014 row \u2014');
      addMeasureRow();
    }
  });

  btnCancel && btnCancel.addEventListener('click', function () {
    panel.hidden = true;
  });
}());
</script>

<script>
// ---------------------------------------------------------------------------
// Calculated columns panel
// ---------------------------------------------------------------------------
(function () {
  var btnOpen   = document.getElementById('btn-calc');
  var panel     = document.getElementById('calc-panel');
  if (!btnOpen || !panel) return;

  var nameInp   = document.getElementById('calc-name-inp');
  var exprInp   = document.getElementById('calc-expr-inp');
  var btnSave   = document.getElementById('btn-save-calc');
  var btnClose  = document.getElementById('btn-cancel-calc');
  var listEl    = document.getElementById('calc-field-list');

  var lspec     = '[% left_spec | html %]';

  var otherPanels = ['join-panel','combine-panel','export-panel','graph-panel',
    'pie-panel','heatmap-panel','bar-panel','stacked-panel','scatter-panel',
    'combo-panel','treemap-panel','histogram-panel','folder-panel','pivot-panel',
    'groups-panel','dates-panel','save-analysis-panel','map-panel'].map(function(id){
      return document.getElementById(id);
    }).filter(Boolean);

  var NAME_RE = /^[A-Za-z_][A-Za-z0-9_]*$/;

  function checkSaveEnabled() {
    btnSave.disabled = !(NAME_RE.test(nameInp.value.trim()) && exprInp.value.trim().length > 0);
  }
  nameInp.addEventListener('input', checkSaveEnabled);
  exprInp.addEventListener('input', checkSaveEnabled);

  function renderList(fields) {
    listEl.innerHTML = '';
    if (!fields || !Object.keys(fields).length) {
      listEl.innerHTML = '<p class="graph-panel-desc" style="margin:0 0 0.4rem">No saved fields yet.</p>';
      return;
    }
    Object.keys(fields).sort().forEach(function(n) {
      var row = document.createElement('div');
      row.style.cssText = 'display:flex;align-items:center;gap:0.5rem;margin-bottom:0.3rem;font-size:0.87rem';
      var badge = document.createElement('code');
      badge.style.cssText = 'flex:0 0 auto;background:var(--badge-bg,#e8eef5);padding:0.1rem 0.4rem;border-radius:3px';
      badge.textContent = n + ' = ' + fields[n];
      var del = document.createElement('button');
      del.type = 'button'; del.className = 'btn-secondary'; del.textContent = '\u00d7';
      del.style.cssText = 'flex:0 0 auto;padding:0.1rem 0.5rem;font-size:0.8rem';
      del.title = 'Delete ' + n;
      del.addEventListener('click', function() {
        fetch('/calc/delete', {
          method:'POST',
          headers:{'Content-Type':'application/x-www-form-urlencoded'},
          body:'l=' + encodeURIComponent(lspec) + '&name=' + encodeURIComponent(n)
        }).then(function(r){ return r.json(); }).then(function(j){
          if (j.ok) { loadList(); location.reload(); }
          else alert('Error: ' + (j.error||'unknown'));
        });
      });
      row.appendChild(badge); row.appendChild(del);
      listEl.appendChild(row);
    });
  }

  function loadList() {
    if (!lspec) return;
    fetch('/calc/list?l=' + encodeURIComponent(lspec))
      .then(function(r){ return r.json(); })
      .then(function(j){ renderList(j.fields || {}); })
      .catch(function(){ renderList({}); });
  }

  btnSave.addEventListener('click', function() {
    var n = nameInp.value.trim();
    var e = exprInp.value.trim();
    if (!NAME_RE.test(n) || !e) return;
    fetch('/calc/save', {
      method:'POST',
      headers:{'Content-Type':'application/x-www-form-urlencoded'},
      body:'l=' + encodeURIComponent(lspec) + '&name=' + encodeURIComponent(n) + '&expr=' + encodeURIComponent(e)
    }).then(function(r){ return r.json(); }).then(function(j){
      if (j.ok) { nameInp.value = ''; exprInp.value = ''; checkSaveEnabled(); loadList(); location.reload(); }
      else alert('Error: ' + (j.error||'unknown'));
    });
  });

  btnOpen.addEventListener('click', function() {
    otherPanels.forEach(function(p){ p.hidden = true; });
    panel.hidden = !panel.hidden;
    if (!panel.hidden) loadList();
  });

  btnClose && btnClose.addEventListener('click', function(){ panel.hidden = true; });
}());
</script>

<script>
// ---------------------------------------------------------------------------
// Group values panel
// ---------------------------------------------------------------------------
(function () {
  var btnOpen   = document.getElementById('btn-groups');
  var panel     = document.getElementById('groups-panel');
  if (!btnOpen || !panel) return;

  var colSel      = document.getElementById('groups-col-sel');
  var existingEl  = document.getElementById('groups-existing');
  var addRow      = document.getElementById('groups-add-row');
  var addBtnRow   = document.getElementById('groups-add-btn-row');
  var nameInp     = document.getElementById('groups-name-inp');
  var valsInp     = document.getElementById('groups-vals-inp');
  var btnSaveGrp  = document.getElementById('btn-save-group');
  var btnAddGrp   = document.getElementById('btn-add-group');
  var btnClose    = document.getElementById('btn-cancel-groups');

  var lspec = '[% left_spec | html %]';

  var otherPanels = ['join-panel','combine-panel','export-panel','graph-panel',
    'pie-panel','heatmap-panel','bar-panel','stacked-panel','scatter-panel',
    'combo-panel','treemap-panel','histogram-panel','folder-panel','pivot-panel',
    'calc-panel','dates-panel','save-analysis-panel','map-panel'].map(function(id){
      return document.getElementById(id);
    }).filter(Boolean);

  function getUniqueVals(col) {
    var tbl = document.querySelector('table[data-table]') || document.querySelector('table');
    if (!tbl || !col) return [];
    var hdrs = Array.from(tbl.tHead.rows[0].cells).map(function(th){ return th.textContent.trim(); });
    var idx  = hdrs.indexOf(col);
    if (idx < 0) return [];
    var seen = {};
    Array.from(tbl.tBodies[0].rows).forEach(function(r){
      var v = (r.cells[idx] || {}).textContent;
      if (v && v.trim()) seen[v.trim()] = 1;
    });
    return Object.keys(seen).sort();
  }

  function renderExisting(groups, col) {
    existingEl.innerHTML = '';
    if (!groups || !Object.keys(groups).length) {
      existingEl.innerHTML = '<p class="graph-panel-desc" style="margin:0 0 0.4rem">No groups defined for this column yet.</p>';
      return;
    }
    Object.keys(groups).sort().forEach(function(gname) {
      var row = document.createElement('div');
      row.style.cssText = 'display:flex;align-items:flex-start;gap:0.5rem;margin-bottom:0.4rem;font-size:0.87rem';
      var badge = document.createElement('span');
      badge.style.cssText = 'flex:1 1 auto';
      badge.innerHTML = '<strong>' + gname.replace(/&/g,'&amp;').replace(/</g,'&lt;') + '</strong>: '
        + (groups[gname]||[]).map(function(v){
            return '<code style="background:var(--badge-bg,#e8eef5);padding:0.05rem 0.3rem;border-radius:2px">'
              + v.replace(/&/g,'&amp;').replace(/</g,'&lt;') + '</code>';
          }).join(' ');
      var del = document.createElement('button');
      del.type = 'button'; del.className = 'btn-secondary'; del.textContent = '\u00d7';
      del.style.cssText = 'flex:0 0 auto;padding:0.1rem 0.5rem;font-size:0.8rem';
      del.title = 'Delete group ' + gname;
      del.addEventListener('click', function() {
        fetch('/groups/delete', {
          method:'POST',
          headers:{'Content-Type':'application/x-www-form-urlencoded'},
          body:'l=' + encodeURIComponent(lspec) + '&col=' + encodeURIComponent(col) + '&group=' + encodeURIComponent(gname)
        }).then(function(r){ return r.json(); }).then(function(j){
          if (j.ok) loadForCol(col);
          else alert('Error: ' + (j.error||'unknown'));
        });
      });
      row.appendChild(badge); row.appendChild(del);
      existingEl.appendChild(row);
    });
  }

  function loadForCol(col) {
    existingEl.innerHTML = '';
    addRow.hidden = true;
    addBtnRow.hidden = true;
    if (!col || !lspec) return;
    fetch('/groups/list?l=' + encodeURIComponent(lspec) + '&col=' + encodeURIComponent(col))
      .then(function(r){ return r.json(); })
      .then(function(j){
        renderExisting(j.groups || {}, col);
        addBtnRow.hidden = false;
      })
      .catch(function(){ renderExisting({}, col); addBtnRow.hidden = false; });
  }

  colSel.addEventListener('change', function(){ loadForCol(colSel.value); });

  btnAddGrp && btnAddGrp.addEventListener('click', function(){
    nameInp.value = ''; valsInp.value = '';
    // Suggest unique values
    var uniq = getUniqueVals(colSel.value);
    if (uniq.length && uniq.length <= 30) {
      valsInp.placeholder = uniq.slice(0,10).join('\n') + (uniq.length > 10 ? '\n...' : '');
    }
    addRow.hidden = false;
    nameInp.focus();
  });

  btnSaveGrp && btnSaveGrp.addEventListener('click', function(){
    var col   = colSel.value;
    var gname = nameInp.value.trim();
    var vals  = valsInp.value.split('\n').map(function(v){ return v.trim(); }).filter(Boolean);
    if (!col || !gname || !vals.length) return;
    fetch('/groups/save', {
      method:'POST',
      headers:{'Content-Type':'application/x-www-form-urlencoded'},
      body:'l=' + encodeURIComponent(lspec)
        + '&col='   + encodeURIComponent(col)
        + '&group=' + encodeURIComponent(gname)
        + '&values='+ encodeURIComponent(vals.join('\n'))
    }).then(function(r){ return r.json(); }).then(function(j){
      if (j.ok) { addRow.hidden = true; loadForCol(col); }
      else alert('Error: ' + (j.error||'unknown'));
    });
  });

  btnOpen.addEventListener('click', function() {
    otherPanels.forEach(function(p){ p.hidden = true; });
    panel.hidden = !panel.hidden;
  });

  btnClose && btnClose.addEventListener('click', function(){ panel.hidden = true; });
}());
</script>

<script>
// ---------------------------------------------------------------------------
// Date format panel
// ---------------------------------------------------------------------------
(function () {
  var btnOpen   = document.getElementById('btn-dates');
  var panel     = document.getElementById('dates-panel');
  if (!btnOpen || !panel) return;

  var colSel   = document.getElementById('dates-col-sel');
  var patSel   = document.getElementById('dates-pat-sel');
  var btnSave  = document.getElementById('btn-save-date');
  var btnClose = document.getElementById('btn-cancel-dates');
  var listEl   = document.getElementById('dates-list');
  var btnYtd   = document.getElementById('btn-dates-ytd');
  var btnQtd   = document.getElementById('btn-dates-qtd');
  var btnMtd   = document.getElementById('btn-dates-mtd');

  var lspec = '[% left_spec | html %]';

  var otherPanels = ['join-panel','combine-panel','export-panel','graph-panel',
    'pie-panel','heatmap-panel','bar-panel','stacked-panel','scatter-panel',
    'combo-panel','treemap-panel','histogram-panel','folder-panel','pivot-panel',
    'calc-panel','groups-panel','save-analysis-panel','map-panel'].map(function(id){
      return document.getElementById(id);
    }).filter(Boolean);

  function pad2(n) { return n < 10 ? '0' + n : '' + n; }

  function isoDate(y, m, d) {
    return y + '-' + pad2(m) + '-' + pad2(d);
  }

  function lastDayOfMonth(y, m) {
    return new Date(y, m, 0).getDate(); // day 0 of next month = last day of this month
  }

  function applyPeriodFilter(ge, le) {
    var col = colSel.value;
    if (!col) return;
    // Build a new URL from the current page, appending the two f= filters.
    var url = new URL(window.location.href);
    url.searchParams.append('f', col + ':ge:' + ge);
    url.searchParams.append('f', col + ':le:' + le);
    window.location.href = url.toString();
  }

  function checkSaveEnabled() {
    var hasCol = !!colSel.value;
    btnSave.disabled = !hasCol;
    if (btnYtd) { btnYtd.disabled = !hasCol; btnQtd.disabled = !hasCol; btnMtd.disabled = !hasCol; }
  }
  colSel.addEventListener('change', checkSaveEnabled);

  if (btnYtd) {
    btnYtd.addEventListener('click', function() {
      var now = new Date();
      var y = now.getFullYear();
      applyPeriodFilter(isoDate(y, 1, 1), isoDate(y, now.getMonth() + 1, now.getDate()));
    });
    btnQtd.addEventListener('click', function() {
      var now = new Date();
      var y = now.getFullYear(), m = now.getMonth() + 1; // 1-12
      var qstart = [1, 1, 1, 4, 4, 4, 7, 7, 7, 10, 10, 10][m - 1];
      applyPeriodFilter(isoDate(y, qstart, 1), isoDate(y, m, now.getDate()));
    });
    btnMtd.addEventListener('click', function() {
      var now = new Date();
      var y = now.getFullYear(), m = now.getMonth() + 1;
      applyPeriodFilter(isoDate(y, m, 1), isoDate(y, m, now.getDate()));
    });
  }

  function renderList(dates) {
    listEl.innerHTML = '';
    if (!dates || !Object.keys(dates).length) {
      listEl.innerHTML = '<p class="graph-panel-desc" style="margin:0 0 0.4rem">No date formats saved yet.</p>';
      return;
    }
    Object.keys(dates).sort().forEach(function(col) {
      var row = document.createElement('div');
      row.style.cssText = 'display:flex;align-items:center;gap:0.5rem;margin-bottom:0.3rem;font-size:0.87rem';
      var badge = document.createElement('code');
      badge.style.cssText = 'flex:0 0 auto;background:var(--badge-bg,#e8eef5);padding:0.1rem 0.4rem;border-radius:3px';
      badge.textContent = col + ' \u2192 ' + dates[col];
      var del = document.createElement('button');
      del.type = 'button'; del.className = 'btn-secondary'; del.textContent = '\u00d7';
      del.style.cssText = 'flex:0 0 auto;padding:0.1rem 0.5rem;font-size:0.8rem';
      del.title = 'Remove format for ' + col;
      del.addEventListener('click', function() {
        fetch('/dates/delete', {
          method:'POST',
          headers:{'Content-Type':'application/x-www-form-urlencoded'},
          body:'l=' + encodeURIComponent(lspec) + '&col=' + encodeURIComponent(col)
        }).then(function(r){ return r.json(); }).then(function(j){
          if (j.ok) { loadList(); location.reload(); }
          else alert('Error: ' + (j.error||'unknown'));
        });
      });
      row.appendChild(badge); row.appendChild(del);
      listEl.appendChild(row);
    });
  }

  function loadList() {
    if (!lspec) return;
    fetch('/dates/list?l=' + encodeURIComponent(lspec))
      .then(function(r){ return r.json(); })
      .then(function(j){ renderList(j.dates || {}); })
      .catch(function(){ renderList({}); });
  }

  btnSave.addEventListener('click', function() {
    var col = colSel.value;
    var pat = patSel.value;
    if (!col || !pat) return;
    fetch('/dates/save', {
      method:'POST',
      headers:{'Content-Type':'application/x-www-form-urlencoded'},
      body:'l=' + encodeURIComponent(lspec) + '&col=' + encodeURIComponent(col) + '&pattern=' + encodeURIComponent(pat)
    }).then(function(r){ return r.json(); }).then(function(j){
      if (j.ok) { loadList(); location.reload(); }
      else alert('Error: ' + (j.error||'unknown'));
    });
  });

  btnOpen.addEventListener('click', function() {
    otherPanels.forEach(function(p){ p.hidden = true; });
    panel.hidden = !panel.hidden;
    if (!panel.hidden) loadList();
  });

  btnClose && btnClose.addEventListener('click', function(){ panel.hidden = true; });
}());
</script>

<script>
// ---------------------------------------------------------------------------
// Save-analysis panel -- POST /api/analyses and redirect to /a/:id
// ---------------------------------------------------------------------------
(function () {
  var btnOpen   = document.getElementById('btn-save-analysis');
  var panel     = document.getElementById('save-analysis-panel');
  if (!btnOpen || !panel) return;

  var nameInp   = document.getElementById('save-analysis-name-inp');
  var btnSave   = document.getElementById('btn-do-save-analysis');
  var btnCancel = document.getElementById('btn-cancel-save-analysis');
  var linkEl    = document.getElementById('save-analysis-link');
  var msgEl     = document.getElementById('save-analysis-msg');

  var otherPanels = ['join-panel','combine-panel','export-panel','graph-panel',
    'pie-panel','heatmap-panel','bar-panel','stacked-panel','scatter-panel',
    'combo-panel','treemap-panel','histogram-panel','folder-panel','pivot-panel',
    'calc-panel','groups-panel','dates-panel','map-panel'].map(function(id){
      return document.getElementById(id);
    }).filter(Boolean);

  // The table on this page is the first card of the new canvas.  Read its
  // headers so the card shows the columns the reader is looking at, not every
  // column the source happens to contain.  A chart page has no table; there
  // the empty column list means "all columns".
  function currentTable() {
    var table = document.querySelector('table[data-table]');
    if (!table) return { columns: [], title: 'Table' };

    var columns = Array.prototype.map.call(
      table.querySelectorAll('thead th'),
      function (th) { return (th.textContent || '').trim(); }
    ).filter(Boolean);

    var name = table.getAttribute('data-table') || 'Table';
    var title = name.charAt(0).toUpperCase() + name.slice(1);
    return { columns: columns, title: title };
  }

  // Build an analysis spec from the current page URL and table.
  function buildSpec(name) {
    var params = new URLSearchParams(location.search);
    var l = params.get('l') || panel.getAttribute('data-left-spec') || '';
    if (!l) return null;
    var datasets = [{ spec: l, alias: 'left', filters: params.getAll('f') }];
    var joins = [];
    params.getAll('j').forEach(function(jspec) {
      var parts = jspec.split('|');
      if (parts.length >= 3) {
        datasets.push({ spec: parts[0], alias: 'right' + joins.length });
        joins.push({ left: 'left', right: 'right' + (joins.length), left_key: parts[1], right_key: parts[2] });
      }
    });

    var table = currentTable();
    var encode = table.columns.length ? { columns: table.columns } : {};
    var visuals = [{ kind: 'table', encode: encode, title: table.title }];

    return { name: name, datasets: datasets, joins: joins, visuals: visuals };
  }

  nameInp.addEventListener('input', function() {
    btnSave.disabled = !nameInp.value.trim();
  });

  btnOpen.addEventListener('click', function() {
    otherPanels.forEach(function(p) { p.hidden = true; });
    panel.hidden = !panel.hidden;
    if (!panel.hidden) {
      nameInp.focus();
      linkEl.hidden = true;
      msgEl.hidden  = true;
    }
  });

  btnCancel.addEventListener('click', function() { panel.hidden = true; });

  btnSave.addEventListener('click', function() {
    var name = nameInp.value.trim();
    if (!name) return;
    var spec = buildSpec(name);
    if (!spec) {
      msgEl.textContent = 'Cannot save: no data source in the current URL.';
      msgEl.className   = 'export-result error';
      msgEl.hidden      = false;
      return;
    }
    btnSave.disabled = true;
    fetch('/api/analyses', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(spec),
    })
    .then(function(r) { return r.json().then(function(j) { return { ok: r.ok, j: j }; }); })
    .then(function(res) {
      if (res.ok && res.j.id) {
        var href = '/a/' + res.j.id;
        linkEl.href    = href;
        linkEl.hidden  = false;
        msgEl.textContent = 'Saved. Share the link to let others reopen this view.';
        msgEl.className   = 'export-result';
        msgEl.hidden      = false;
        try {
          var saved = JSON.parse(localStorage.getItem('bi:saved') || '[]');
          var entry = { name: name, path: href, href: '/open?path=' + encodeURIComponent(href), lastSaved: new Date().toISOString() };
          saved = saved.filter(function(s) { return s.href !== entry.href; });
          saved.unshift(entry);
          if (saved.length > 5) saved.length = 5;
          localStorage.setItem('bi:saved', JSON.stringify(saved));
        } catch(eS) {}
      } else {
        msgEl.textContent = 'Error: ' + ((res.j && res.j.error) || 'unknown error');
        msgEl.className   = 'export-result error';
        msgEl.hidden      = false;
        btnSave.disabled  = false;
      }
    })
    .catch(function() {
      msgEl.textContent = 'Could not save analysis -- check the server log.';
      msgEl.className   = 'export-result error';
      msgEl.hidden      = false;
      btnSave.disabled  = false;
    });
  });
}());
</script>

<script>
// ---------------------------------------------------------------------------
// Export panel -- save to a user-chosen directory on the server filesystem
// ---------------------------------------------------------------------------
(function () {
  var btnOpen    = document.getElementById('btn-export-open');
  var panel      = document.getElementById('export-panel');
  if (!btnOpen || !panel) return;

  var dirInp     = document.getElementById('export-dir-inp');
  var dirBrowser = document.getElementById('export-dir-browser');
  var dirUp      = document.getElementById('export-dir-up');
  var fnInp      = document.getElementById('export-filename-inp');
  var fmtBadge   = document.getElementById('export-format-badge');
  var btnCancel  = document.getElementById('btn-cancel-export');
  var btnSave    = document.getElementById('btn-do-export');
  var resultEl   = document.getElementById('export-result');

  var currentParent = null;
  var dirTimer;

  // Derive a safe default filename from the left-table spec.
  var leftSpec = panel.dataset.leftSpec || '';
  var baseName = leftSpec
    .replace(/^table:/, '')
    .replace(/^path:.*[\/\\]/, '')
    .replace(/\.[^.]+$/, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '_') || 'export';

  function getFormat(name) {
    if (/\.csv$/i.test(name))  return 'csv';
    if (/\.sql$/i.test(name))  return 'sqlite';
    if (/\.json$/i.test(name)) return 'json';
    return null;
  }

  function updateFormatBadge() {
    var fmt = getFormat(fnInp.value.trim());
    if (fmt === 'csv') {
      fmtBadge.textContent = 'CSV';
      fmtBadge.className   = 'export-format-badge csv';
    } else if (fmt === 'sqlite') {
      fmtBadge.textContent = 'SQLite';
      fmtBadge.className   = 'export-format-badge sqlite';
    } else if (fmt === 'json') {
      fmtBadge.textContent = 'JSON';
      fmtBadge.className   = 'export-format-badge csv';
    } else {
      fmtBadge.textContent = 'unknown -- add .csv, .sql or .json';
      fmtBadge.className   = 'export-format-badge unknown';
    }
    btnSave.disabled = !fmt;
  }

  function loadDir(path) {
    dirInp.value           = path;
    dirBrowser.innerHTML   = '<span class="export-dir-msg">Loading...</span>';
    dirUp.disabled         = true;

    fetch('/api/dirs?path=' + encodeURIComponent(path))
      .then(function (r) { return r.json(); })
      .then(function (data) {
        dirInp.value    = data.path;
        currentParent   = data.parent || null;
        dirUp.disabled  = !currentParent;

        if (!data.dirs || data.dirs.length === 0) {
          dirBrowser.innerHTML = '<span class="export-dir-msg">No subdirectories</span>';
          return;
        }
        dirBrowser.innerHTML = '';
        data.dirs.forEach(function (d) {
          var btn = document.createElement('button');
          btn.type      = 'button';
          btn.className = 'export-dir-entry';
          btn.dataset.path = d.path;
          btn.innerHTML = '&#x1F4C1; ' + d.name.replace(/[<>&"]/g, function(c) {
            return { '<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;' }[c];
          });
          btn.addEventListener('click', function () { loadDir(d.path); });
          dirBrowser.appendChild(btn);
        });
      })
      .catch(function () {
        dirBrowser.innerHTML = '<span class="export-dir-msg">Could not read directory</span>';
        dirUp.disabled = false;
      });
  }

  // Navigate up.
  dirUp.addEventListener('click', function () {
    if (currentParent) loadDir(currentParent);
  });

  // Typing in the directory input -- debounced fetch.
  dirInp.addEventListener('input', function () {
    clearTimeout(dirTimer);
    var val = dirInp.value.trim();
    dirTimer = setTimeout(function () { loadDir(val); }, 600);
  });

  fnInp.addEventListener('input', updateFormatBadge);

  // Open panel.
  btnOpen.addEventListener('click', function () {
    panel.hidden     = false;
    btnOpen.disabled = true;
    resultEl.hidden  = true;
    fnInp.value      = baseName + '.csv';
    updateFormatBadge();
    loadDir(panel.dataset.defaultDir || dirInp.value);
  });

  // Close panel.
  btnCancel.addEventListener('click', function () {
    panel.hidden     = false;
    panel.hidden     = true;
    btnOpen.disabled = false;
    resultEl.hidden  = true;
  });

  // Save.
  btnSave.addEventListener('click', function () {
    var dir      = dirInp.value.trim();
    var filename = fnInp.value.trim();
    if (!dir || !filename || !getFormat(filename)) return;

    btnSave.disabled    = true;
    btnSave.textContent = 'Saving...';
    resultEl.hidden     = true;

    // Collect the current view's l=, j=, f= params.
    var params = new URLSearchParams();
    params.set('dir',      dir);
    params.set('filename', filename);

    // l= comes from the join-form hidden input (not always in the URL).
    var lInp = document.querySelector('#join-form input[name="l"]');
    if (lInp) params.set('l', lInp.value);

    // j=, c=, f=, and d= reflect the already-rendered view, so read from the URL.
    var urlP = new URLSearchParams(location.search);
    urlP.getAll('j').forEach(function (v) { params.append('j', v); });
    urlP.getAll('c').forEach(function (v) { params.append('c', v); });
    urlP.getAll('f').forEach(function (v) { params.append('f', v); });
    if (urlP.get('d')) params.set('d', '1');

    fetch('/export', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: params.toString(),
    })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        btnSave.disabled    = false;
        btnSave.textContent = 'Save';
        if (data.saved) {
          resultEl.textContent = 'Saved: ' + data.saved;
          resultEl.className   = 'export-result success';
          try {
            var savedName  = data.saved.replace(/.*[\/\\]/, '');
            var savedEntry = {
              name:      savedName,
              path:      data.saved,
              href:      '/open?path=' + encodeURIComponent(data.saved),
              lastSaved: new Date().toISOString(),
            };
            var savedList = JSON.parse(localStorage.getItem('bi:saved') || '[]');
            savedList = savedList.filter(function (s) { return s.path !== data.saved; });
            savedList.unshift(savedEntry);
            if (savedList.length > 5) savedList.length = 5;
            localStorage.setItem('bi:saved', JSON.stringify(savedList));
          } catch (eS) {}
        } else {
          resultEl.textContent = data.error || 'Unknown error';
          resultEl.className   = 'export-result error';
        }
        resultEl.hidden = false;
      })
      .catch(function () {
        btnSave.disabled    = false;
        btnSave.textContent = 'Save';
        resultEl.textContent = 'Save failed -- check the server log';
        resultEl.className   = 'export-result error';
        resultEl.hidden      = false;
      });
  });
}());
</script>

<script>
// Drag-and-drop integration with the shared overlay (default.html.tt)
(function () {
  var panel        = document.getElementById('join-panel');
  var rightPathInp = document.getElementById('right-path-inp');
  var rightTblSel  = document.getElementById('right-table-sel');

  // Tell the overlay what label to show based on current UI state.
  window.__biDropLabel = function () {
    return (panel && !panel.hidden)
      ? 'Drop to set as join database'
      : 'Drop to open database';
  };

  // Called by the overlay after a successful upload.
  window.__biDropCallback = function (data) {
    if (panel && !panel.hidden && data.path && rightPathInp) {
      // Join panel is open: populate the path field and trigger column fetch.
      rightPathInp.value = data.path;
      if (rightTblSel) rightTblSel.value = '';
      rightPathInp.dispatchEvent(new Event('input', { bubbles: true }));
    } else if (data.url) {
      // Panel is closed (or no path returned): navigate to the opened file.
      window.location = data.url;
    }
  };
}());
</script>

[%- IF file_path -%]
<div id="bi-open-meta"
     data-name="[% title | html %]"
     data-path="[% file_path | html %]"
     hidden></div>
<script>
(function () {
  try {
    var u      = new URL(location.href);
    var fromSaved = u.searchParams.get('from') === 'saved';
    // Remove the from= marker from the address bar so the URL stays clean.
    if (fromSaved) {
      u.searchParams.delete('from');
      history.replaceState(null, '', u.toString());
    }
    // Files opened from the "recently saved" list are not also tracked as
    // "recently opened" -- they already have their own section on the home page.
    if (!fromSaved) {
      var el       = document.getElementById('bi-open-meta');
      // For drag-and-drop uploads the server stores the file under a random
      // .uploads/<tempdir>/ path.  Prefer the original local path stashed by
      // the drop handler in sessionStorage (from text/uri-list).  Fall back to
      // the upload path when the browser does not supply a file:// URI -- an
      // imperfect but functional link is better than a missing entry.
      var filePath = el.dataset.path;
      var fileHref = '/open?path=' + encodeURIComponent(filePath);
      if (/[/\\]\.uploads[/\\]/.test(filePath)) {
        // Drag-and-drop uploads land under a random .uploads/ temp path.
        // Only add to recently opened when the drop handler stashed the
        // original file:// URI in sessionStorage (from text/uri-list).
        // If that stash is absent (Firefox, email attachment, etc.) there
        // is no stable path to record, so skip the entry entirely rather
        // than adding a useless .uploads/ link.
        var origPath = null;
        try {
          origPath = sessionStorage.getItem('bi:pending-original-path');
          sessionStorage.removeItem('bi:pending-original-path');
        } catch (ex) {}
        if (!origPath) { return; }
        filePath = origPath;
        fileHref = '/open?path=' + encodeURIComponent(origPath);
      }
      var entry = {
        name:       el.dataset.name,
        href:       fileHref,
        path:       filePath,
        lastOpened: new Date().toISOString(),
      };
      var recent = JSON.parse(localStorage.getItem('bi:recent') || '[]');
      recent = recent.filter(function (r) { return r.href !== fileHref; });
      recent.unshift(entry);
      if (recent.length > 5) recent.length = 5;
      localStorage.setItem('bi:recent', JSON.stringify(recent));
    }
  } catch (e) {}
}());
</script>
[%- ELSIF source_url -%]
<div id="bi-open-meta"
     data-name="[% title | html %]"
     data-url="[% source_url | html %]"
     hidden></div>
<script>
(function () {
  try {
    var u      = new URL(location.href);
    var fromSaved = u.searchParams.get('from') === 'saved';
    if (fromSaved) {
      u.searchParams.delete('from');
      history.replaceState(null, '', u.toString());
    }
    if (!fromSaved) {
      var el    = document.getElementById('bi-open-meta');
      var href  = '/import?url=' + encodeURIComponent(el.dataset.url);
      var entry = {
        name:       el.dataset.name,
        href:       href,
        url:        el.dataset.url,
        lastOpened: new Date().toISOString(),
      };
      var recent = JSON.parse(localStorage.getItem('bi:recent') || '[]');
      recent = recent.filter(function (r) { return r.href !== href; });
      recent.unshift(entry);
      if (recent.length > 5) recent.length = 5;
      localStorage.setItem('bi:recent', JSON.stringify(recent));
    }
  } catch (e) {}
}());
</script>
[%- END -%]

[%- END -%]
