use strict;
use warnings;
use Test::More;

# -----------------------------------------------------------------------------
# Unit test for the RKE2/K3s containerd NVIDIA-runtime wiring decision.
#
# Regression guard for karr #9: configure_containerd used to write a FULL
# config.toml.tmpl (version=2, io.containerd.grpc.v1.cri) that REPLACED the
# config RKE2/K3s generate. On modern RKE2 (containerd 2.x / config v3,
# verified live on otho-lab v1.36.3) that clobbered SystemdCgroup, the pinned
# sandbox image, snapshotter opts and the certs.d config_path.
#
# The fix is version-aware and additive. _containerd_nvidia_action() is the
# pure decision (regex + booleans, no run/file) so it is unit-testable offline;
# _nvidia_containerd_dropin_v3 / _nvidia_containerd_tmpl_v2 return the exact
# content emitted. The live containerd behaviour (RKE2 rendering the template /
# importing the drop-in, node health after restart) is NOT exercised here — a
# maintainer must run it on a real RKE2 node; a green prove is not evidence it
# works. See the t/10-detect.t header for the wider "what prove cannot see".
#
# CLAIM asserted by these tests:
#   * an effective config that already carries an nvidia runtime block  => no-op
#   * a modern (config v3) target with no nvidia yet  => additive v3 drop-in
#   * a legacy (config v2) target with no nvidia yet  => base-EXTENDING tmpl,
#     never a bare full-config template that replaces the base.
# -----------------------------------------------------------------------------

use Rex::GPU::NVIDIA;

sub action { Rex::GPU::NVIDIA->_containerd_nvidia_action(@_) }

# The real generated config.toml from otho-lab (RKE2 v1.36.3+rke2r1, config v3):
# version 3, config-v3.toml.d import, and RKE2's own auto-wired nvidia runtime.
my $otho_v3_config = <<'TOML';
# File generated by rke2. DO NOT EDIT. Use config-v3.toml.tmpl instead.
version = 3
imports = ["/var/lib/rancher/rke2/agent/etc/containerd/config-v3.toml.d/*.toml"]

[plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.runc.options]
  SystemdCgroup = true

[plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.'nvidia']
  runtime_type = "io.containerd.runc.v2"

[plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.'nvidia'.options]
  BinaryName = "/usr/bin/nvidia-container-runtime"
  SystemdCgroup = true
TOML

# A modern config v3 WITHOUT an nvidia runtime (auto-detect did not fire, e.g.
# nvidia-container-runtime installed after the distro's last startup).
my $v3_no_nvidia = <<'TOML';
# File generated by rke2. DO NOT EDIT. Use config-v3.toml.tmpl instead.
version = 3
imports = ["/var/lib/rancher/rke2/agent/etc/containerd/config-v3.toml.d/*.toml"]

[plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.runc.options]
  SystemdCgroup = true
TOML

# A legacy containerd 1.x / config v2 generated config, no nvidia runtime.
my $v2_no_nvidia = <<'TOML';
version = 2

[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.runc]
  runtime_type = "io.containerd.runc.v2"
TOML

subtest 'already-wired => no-op (present)' => sub {
  is(action(config => $otho_v3_config), 'present',
    'otho-lab live v3 config with native nvidia => present (no-op)');

  # Legacy v2 form of the nvidia key (unquoted) must also short-circuit.
  my $v2_with_nvidia = $v2_no_nvidia
    . qq{\n[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.nvidia]\n}
    . qq{  runtime_type = "io.containerd.runc.v2"\n};
  is(action(config => $v2_with_nvidia), 'present',
    'v2 config with unquoted runtimes.nvidia => present (no-op)');
};

subtest 'modern config v3 without nvidia => additive drop-in' => sub {
  is(action(config => $v3_no_nvidia), 'v3',
    'version=3 + config-v3.toml.d import, no nvidia => v3');
  is(action(config => '', has_v3_dir => 1), 'v3',
    'no config yet but config-v3.toml.d/ present => v3');
  is(action(config => '', has_v3_tmpl => 1), 'v3',
    'no config yet but config-v3.toml.tmpl present => v3');
};

subtest 'legacy config v2 without nvidia => base-extending tmpl' => sub {
  is(action(config => $v2_no_nvidia), 'v2',
    'version=2 + io.containerd.grpc.v1.cri, no nvidia => v2');
};

subtest 'no config, no markers => modern v3 default' => sub {
  is(action(config => undef), 'v3', 'undef config, no markers => v3 default');
  is(action(config => ''),    'v3', 'empty config, no markers => v3 default');
};

subtest '_rke2_base_dir' => sub {
  is(Rex::GPU::NVIDIA->_rke2_base_dir('rke2'),
    '/var/lib/rancher/rke2/agent/etc/containerd', 'rke2 base dir');
  is(Rex::GPU::NVIDIA->_rke2_base_dir('k3s'),
    '/var/lib/rancher/k3s/agent/etc/containerd', 'k3s base dir');
  is(Rex::GPU::NVIDIA->_rke2_base_dir(),
    '/var/lib/rancher/rke2/agent/etc/containerd', 'defaults to rke2');
};

subtest 'v3 drop-in content is additive and uses the v3 CRI plugin path' => sub {
  my $c = Rex::GPU::NVIDIA->_nvidia_containerd_dropin_v3();
  like($c, qr/io\.containerd\.cri\.v1\.runtime/,
    'uses the modern io.containerd.cri.v1.runtime plugin path');
  unlike($c, qr/io\.containerd\.grpc\.v1\.cri/,
    'does NOT use the deprecated v2 grpc.v1.cri path');
  like($c, qr{BinaryName = "/usr/bin/nvidia-container-runtime"},
    'registers the nvidia-container-runtime binary');
  like($c, qr/SystemdCgroup = true/,
    'SystemdCgroup=true keeps the cgroup driver aligned with kubelet');
  # Additive: no root-level base keys that would define a full replacement
  # config (pinned image / snapshotter / registry certs live in the base).
  unlike($c, qr/pinned_images|snapshotter|certs\.d/,
    'does not restate base-config keys (purely additive)');
};

subtest 'v2 tmpl EXTENDS the base — never replaces it' => sub {
  my $c = Rex::GPU::NVIDIA->_nvidia_containerd_tmpl_v2();
  like($c, qr/\{\{\s*template "base" \.\s*\}\}/,
    'begins by rendering the distribution base template (no clobber)');
  like($c, qr/io\.containerd\.grpc\.v1\.cri/,
    'adds nvidia under the v2 grpc.v1.cri plugin path');
  like($c, qr{BinaryName = "/usr/bin/nvidia-container-runtime"},
    'registers the nvidia-container-runtime binary');
  # The karr #9 clobber signature: a bare "imports=..." + "version=2" template
  # with no base include. Assert we are NOT emitting that.
  unlike($c, qr/^\s*imports\s*=/m,
    'does not emit the bare imports= full-config template (the karr #9 clobber)');
};

done_testing;
