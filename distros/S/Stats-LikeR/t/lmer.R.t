sub read_csv {
	my $f = File::Spec->catfile('t', shift);
	my %d;
	open my $fh, '<', $f or die "cannot open $f: $!";
	my $h = <$fh>; $h =~ s/[\r\n"]+//g;
	my @c = split /,/, $h;
	while (my $l = <$fh>) {
		$l =~ s/[\r\n]+//; $l =~ s/"//g;
		my @v = split /,/, $l;
		push @{ $d{ $c[$_] } }, $v[$_] for 0 .. $#c;
	}
	return \%d;
}

my (%worst, %worst_at);
sub close_to {
	my ($got, $want, $tol, $class, $name, $abs) = @_;
	my $r = !defined $got ? 9**9**9 : $got == $want ? 0
	      : defined $abs && abs($got - $want) <= $abs ? 0 : abs($got - $want) / (abs($want) || 1);
	($worst{$class}, $worst_at{$class}) = ($r, $name) if $r > ($worst{$class} // 0) && $r < 9**9**9;
	ok($r <= $tol, $name) or diag('got ' . ($got // 'undef') . ", want $want, relative $r > $tol");
}
sub check {
	my ($key, $fit) = @_;
	my $e = $EXPECT{$key};
	ok($fit->{converged}, "$key: converged");
	for my $j (0 .. $#{ $e->{names} }) {
		my $nm = $e->{names}[$j];
		my $s = $fit->{summary}{$nm};
		# a fixed effect moves with theta, so its disagreement is measured
		# in its own standard errors
		{
			my $r = abs($fit->{coefficients}{$nm} - $e->{coef}[$j]) / $e->{se}[$j];
			($worst{'coef (SE units)'}, $worst_at{'coef (SE units)'}) = ($r, "$key: coef $nm")
				if $r > ($worst{'coef (SE units)'} // 0);
			ok($r <= 1e-6, "$key: coef $nm") or diag("got $fit->{coefficients}{$nm}, want $e->{coef}[$j]: $r SE");
		}
		close_to($s->{'Std. Error'}, $e->{se}[$j], 1e-5, 'theta-dependent', "$key: se $nm");
		close_to($s->{'t value'}, $e->{t}[$j], 1e-5, 'theta-dependent', "$key: t $nm");
		close_to($s->{df}, $e->{df}[$j], 1e-4, 'df', "$key: Satterthwaite df $nm");
		close_to(log($s->{'Pr(>|t|)'}), log($e->{p}[$j]), 1e-4, 'df', "$key: p $nm (log scale)");
		close_to($s->{'Std. Error'}, $e->{pkg_se}[$j], 1e-4, 'lme4 default', "$key: se $nm against lme4's default fit")
			unless $e->{pkg_crit} > $e->{crit} + 1e-6;
		ok(abs($fit->{coefficients}{$nm} - $e->{pkg_coef}[$j]) <= 1e-3 * $e->{se}[$j] || $e->{pkg_crit} > $e->{crit} + 1e-6,
		   "$key: coef $nm within 1e-3 SE of lme4's default fit (unless that stopped at a worse optimum)");
	}
	for my $j (0 .. $#{ $e->{theta} }) {
		close_to($fit->{theta}[$j], $e->{theta}[$j], 1e-5, 'theta-dependent', "$key: theta $j", 1e-6);
		close_to($fit->{theta}[$j], $e->{pkg_theta}[$j], 1e-3, 'lme4 default', "$key: theta $j against lme4's default fit", 1e-4)
			unless $e->{pkg_crit} > $e->{crit} + 1e-6;
	}
	my $crit = $fit->{reml} ? $fit->{REML} : $fit->{deviance};
	close_to($crit, $e->{crit}, 1e-12, 'criterion', "$key: criterion");
	close_to($fit->{loglik}, $e->{loglik}, 1e-12, 'criterion', "$key: logLik");
	ok($crit <= $e->{pkg_crit} + 1e-9 * abs($e->{pkg_crit}), "$key: at or below lme4's default optimum");
	close_to($fit->{sigma}, $e->{sigma}, 1e-5, 'theta-dependent', "$key: sigma");
	# VarCorr: match R's rows to the terms by group and column
	for my $r (0 .. $#{ $e->{vc_grp} }) {
		my ($g, $v1, $v2, $sd) = ($e->{vc_grp}[$r], $e->{vc_var1}[$r], $e->{vc_var2}[$r], $e->{vc_sdcor}[$r]);
		if ($g eq 'Residual') { close_to($fit->{sigma}, $sd, 1e-5, 'theta-dependent', "$key: residual sd"); next; }
		(my $gb = $g) =~ s/\.\d+$//;
		$_ = ($_ eq '(Intercept)') ? 'Intercept' : $_ for $v1, $v2;
		# lme4 names (1 | batch/cask)'s inner factor cask:batch
		my $norm = sub { join ':', sort split /:/, shift };
		my ($term) = grep { $norm->($_->{group}) eq $norm->($gb) && grep({ $_ eq $v1 } @{ $_->{names} }) }
		             @{ $fit->{varcor} };
		if (!$term) { fail("$key: no term for $g $v1"); next; }
		if ($v2 eq '') {
			# a component on its boundary is zero to the optimiser's resolution,
			# which is absolute: 1e-5 of the residual sd
			close_to($term->{sd}{$v1}, $sd, 1e-5, 'theta-dependent', "$key: sd $g $v1", 1e-5 * $e->{sigma});
		} else {
			my @n = @{ $term->{names} };
			my ($a) = grep { $n[$_] eq $v1 } 0 .. $#n;
			my ($b) = grep { $n[$_] eq $v2 } 0 .. $#n;
			close_to($term->{corr}[$a][$b], $sd, 1e-5, 'theta-dependent', "$key: corr $g $v1 $v2", 1e-7);
		}
	}
}

my $S = read_csv('sleepstudy.csv');
check('sleep_slope',     lmer(formula => 'Reaction ~ Days + (Days | Subject)', data => $S));
check('sleep_slope_ml',  lmer(formula => 'Reaction ~ Days + (Days | Subject)', data => $S, REML => 0));
check('sleep_uncorr',    lmer(formula => 'Reaction ~ Days + (1 | Subject) + (0 + Days | Subject)', data => $S));
check('sleep_uncorr',    lmer(formula => 'Reaction ~ Days + (Days || Subject)', data => $S));
check('sleep_intercept', lmer(formula => 'Reaction ~ Days + (1 | Subject)', data => $S));
check('penicillin',      lmer(formula => 'diameter ~ 1 + (1 | plate) + (1 | sample)', data => read_csv('Penicillin.csv')));
{
	my $pa = read_csv('Pastes.csv');
	check('pastes', lmer(formula => 'strength ~ 1 + (1 | batch/cask)', data => $pa));
	check('pastes', lmer(formula => 'strength ~ 1 + (1 | batch) + (1 | batch:cask)', data => $pa));
}
for my $k (0 .. 11) {
	my $d = read_csv(sprintf('lme%02d.csv', $k));
	$d->{groups} = [ map { "g$_" } @{ $d->{groups} } ];
	my @fe = sort grep { /^exog_fe/ } keys %$d;
	my @re = sort grep { /^exog_re/ } keys %$d;
	my $fx = 'endog ~ 0 + ' . join(' + ', @fe);
	for my $reml (0, 1) {
		my $m = $reml ? 'reml' : 'ml';
		my $key = sprintf('lme%02d_%s_drf', $k, $m);
		check($key, lmer(formula => "$fx + (0 + " . join(' + ', @re) . ' | groups)', data => $d, REML => $reml))
			if $EXPECT{$key};
		$key = sprintf('lme%02d_%s_irf', $k, $m);
		check($key, lmer(formula => "$fx + " . join(' + ', map { "(0 + $_ | groups)" } @re), data => $d, REML => $reml))
			if $EXPECT{$key};
	}
}
{
	my $f = lmer(formula => 'Reaction ~ Days + (Days | Subject)', data => $S);
	is($f->{varcor}[0]{levels}, 18, '18 subjects');
	is($f->{nobs}, 180, '180 observations');
	ok(!$f->{singular}, 'sleepstudy is not a singular fit');
	my $sum = 0;
	$sum += $f->{'fitted.values'}{$_} for keys %{ $f->{'fitted.values'} };
	my $ysum = 0;
	$ysum += $_ for @{ $S->{Reaction} };
	# the conditional modes shrink toward the fixed effects, and with an
	# intercept per subject the fitted values sum to nearly the data's total
	cmp_ok(abs($sum - $ysum) / $ysum, '<', 1e-2, 'fitted values: X beta + Z b');
}
# ------------------------------------------------------------ errors
{
	eval { lmer(formula => 'Reaction ~ Days', data => $S) };
	like($@, qr/no random-effects terms/, 'no random effects: use lm()');
	eval { lmer(formula => 'Reaction ~ Days + (Days | )', data => $S) };
	like($@, qr/needs a grouping factor/, 'empty grouping factor');
	eval { lmer(formula => 'Reaction ~ Days + (1 | Subject)', data => $S, method => 'ML') };
	like($@, qr/unknown argument 'method'/, 'unknown argument');
}
SKIP: {
	skip 'Test::LeakTrace not installed', 2 unless eval { require Test::LeakTrace; 1 };
	Test::LeakTrace::no_leaks_ok(sub { lmer(formula => 'Reaction ~ Days + (Days | Subject)', data => $S) }, 'no leaks');
	Test::LeakTrace::no_leaks_ok(sub { eval { lmer(formula => 'Reaction ~ Days', data => $S) } }, 'no leaks: croak');
}
diag(sprintf('worst relative disagreement, %s: %.3g (%s)', $_, $worst{$_}, $worst_at{$_})) for sort keys %worst;
done_testing();
