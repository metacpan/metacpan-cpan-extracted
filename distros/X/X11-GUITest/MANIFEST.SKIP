#!include_default

# autoconf/autoreconf cache dir regenerated by recorder/autogen.sh -
# not part of past release tarballs and shouldn't ship.
\bautom4te\.cache\b

# Compiled/generated build byproducts that should never ship - none of
# these are covered by the #!include_default list above, and all of them
# can end up sitting in the tree if `make manifest` is ever run outside
# of release.sh's clean export (e.g. directly in a working copy that's
# already been built).
\.o$
\.so$
^GUITest\.c$
^GUITest\.bs$
^recorder/config\.h$
^recorder/config\.log$
^recorder/config\.status$
\bstamp-h1$
\B\.deps\b
^recorder/src/x11guirecord$
