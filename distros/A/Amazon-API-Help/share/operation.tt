[%- WRAPPER pod_wrapper.tt -%]
=head1 NAME

[% method %]

=head1 SYNOPSIS

 my $service = [% package_name %]->new;
 my $rsp     = $service->[% method %]($parameters);

=head1 DESCRIPTION

[% documentation | html2pod %]

=head1 INPUT

[% INCLUDE members.tt members = input_members %]

=head1 OUTPUT

[% INCLUDE members.tt members = output_members %]

=head1 ERRORS

[% IF errors.size -%]
=over 5

[% FOREACH err IN errors -%]
=item C<[% err.name %]>

[% IF err.documentation -%]
[% err.documentation | html2pod %]

[% END -%]
[% IF err.detail.size -%]
=over 4

[% FOREACH d IN err.detail -%]
=item [% d.key %]: [% d.value %]

[% END -%]
=back

[% END -%]
[% END -%]
=back

[% ELSE -%]
=over 5

=item NONE

=back

[% END -%]
[% IF http_method OR request_uri -%]
=head1 NOTES

=over 5

[% IF http_method -%]
=item Method: [% http_method %]

[% END -%]
[% IF request_uri -%]
=item Request URI: [% request_uri %]

[% END -%]
=back

[% END -%]
[% IF see_also.size -%]
=head1 SEE ALSO

Look these up with C<amzn-api-help [% service %] E<lt>shapeE<gt>>:

=over 5

[% FOREACH s IN see_also -%]
=item C<[% s %]>

[% END -%]
=back

[% END -%]
=head1 AUTHOR

Autogenerated from Botocore version [% provenance.version %] (commit [% provenance.commit %])
[% END -%]
