// The screenshots of the documentation.
//
// Every "screenshot" node runs one program in a terminal of the given
// size, gives it the input of its steps, and writes what the terminal
// then shows to screenshots/NAME.svg. The POD shows the images with
// <img src="/screenshots/NAME.svg">.
//
//     make docs          # take the screenshots again, after changing a program
//     make docs-check    # fails when a screenshot or a code block is out of date
//
// Time is virtual: the steps start 0.5 seconds after the program started
// its event loop, every input is followed by 0.1 seconds, and the screen
// is captured 0.5 seconds after the last step. "wait N" lets N seconds of
// timers and animation pass. The clock starts at the time below, in UTC.
// The syntax of all settings and steps is described in
// tools/lib/Term/Fabulous/Screenshot/Scenario.pm.

defaults {
	size 80 24
	clock "2026-06-01T09:41:00Z"
}

// --- The overview at the top of Term::Fabulous and README.md -------------

screenshot "overview" {
	script "examples/showcase.pl"
	size 110 32
	steps {
		type "Ada Lovelace"
		key "Tab"
		type "ada@example.com"
		wait 7
		key "Tab" "Tab" "Tab" "Tab" "Tab" "Enter"
		wait 1
	}
}

