# -*-n3-*-

@prefix :			<http://usefulinc.com/ns/doap#> .
@prefix dc:			<http://purl.org/dc/terms/> .
@prefix dcs:		<http://ontologi.es/doap-changeset#> .
@prefix foaf:		<http://xmlns.com/foaf/0.1/> .
@prefix rdfs:		<http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:		<http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:	<http://purl.org/dc/terms/> .
@prefix doap:		<http://usefulinc.com/ns/doap#> .
@prefix my:			<http://purl.org/NET/cpan-uri/dist/AtteanX-Store-DBI/> .

<>
	dc:title			"Changes for AtteanX::Store::DBI" ;
	dc:subject			my:project ;
	dc:creator			my:developer ;
	dc:description		"Changes for AtteanX::Store::DBI" ;
	.

my:project
	a 						:Project ;
	:name					"AtteanX::Store::DBI" ;
	:shortdesc				"A DBI-backed quadstore for Attean" ;
	:programming-language	"Perl" ;
	:created				"2016-03-14"^^xsd:date ;
	:maintainer				my:developer ;
	:homepage				<https://metacpan.org/release/AtteanX-Store-DBI/> ;
	:bug-database			<https://github.com/kasei/atteanx-store-dbi/issues> ;
	doap:download-page		<https://metacpan.org/release/AtteanX-Store-DBI/> ;
	doap:download-mirror	<http://kasei.us/code/files/> ;
	:release				my:v_0-001 , my:v_0-002 , my:v_0-003 , my:v_0-004 ;
	.

my:v_0-004
	a					:Version ;
	dc:issued			"2026-11-XX"^^xsd:date ;
	:revision			"0.004" ;
	dcterms:replaces	my:v_0-003 ;
	dcs:changeset [
		dcs:item
			[ a dcs:Addition ; rdfs:label "Add support for RDF 1.2 triple terms." ],
			[ a dcs:Addition ; rdfs:label "Add support for init-on-construct." ],
			[ a dcs:Addition ; rdfs:label "Add load and dump commands to attean_dbi tool." ],
			[ a dcs:Update ; rdfs:label "Skip mysql and postgres tests if the DBD modules or environment variables are not available." ],
			[ a dcs:Update ; rdfs:label "Improvements to path discovery logic in create_schema_file()." ],
			[ a dcs:Update ; rdfs:label "Fix unicode configuration of the sqlite-based temporary_store()." ],
			[ a dcs:Update ; rdfs:label "Fix unicode configuration of the MySQL store." ],
			[ a dcs:Update ; rdfs:label "Update dbi_connect_args() to handle both ($type, %args) and (%args) calling variants." ],
			[ a dcs:Update ; rdfs:label "Update add_iter to load all quads in a single transaction." ],
			[ a dcs:Update ; rdfs:label "Fix SQL-generation bug in handling queries where the requested graph does not exist in the database." ],
			[ a dcs:Update ; rdfs:label "Update required version of Attean to 0.041." ],
			[ a dcs:Update ; rdfs:label "Remove dependency on List::MoreUtils." ],
			[ a dcs:Update ; rdfs:label "Improve developer tests." ]
	]
	.

my:v_0-003
	a					:Version ;
	dc:issued			"2025-03-11"^^xsd:date ;
	:revision			"0.003" ;
	dcterms:replaces	my:v_0-002 ;
	dcs:changeset [
		dcs:item
			[ a dcs:Update ; rdfs:label "Fix developer tests to silence warnings." ]
	]
	.

my:v_0-002
	a					:Version ;
	dc:issued			"2020-12-12"^^xsd:date ;
	:revision			"0.002" ;
	dcterms:replaces	my:v_0-001 ;
	dcs:changeset [
		dcs:item
			[ a dcs:Update ; rdfs:label "Add DBD::SQLite as a test prereq (#6)." ] ,
			[ a dcs:Update ; rdfs:label "Remove mistakenly added LICENSE file (#5)." ] ,
			[ a dcs:Update ; rdfs:label "Remove Math::Cartesian::Product from prereq list (#4)." ] ,
			[ a dcs:Update ; rdfs:label "Update copyright years (#3)." ]
	]
	.

my:v_0-001
	a					:Version ;
	dc:issued			"2020-12-02"^^xsd:date ;
	:revision			"0.001" ;
	dcs:changeset [
		dcs:item
			[ a dcs:Addition ; rdfs:label "Initial release." ]
	]
	.
