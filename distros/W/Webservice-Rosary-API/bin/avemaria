#!/usr/bin/env perl

package local::bin::avemaria;

use v5.10;
use strict;
use warnings;
use Webservice::Rosary::API qw//;
use Webservice::Rosary::Stream qw//;
use Webservice::Rosary::Tradition qw/opening_intention/;
use Util::H2O::More qw/ddd Getopt2h2o h2o o2d tr4h2o/;
use Dispatch::Fu;
use Text::Fold qw/fold_text/;

binmode(STDOUT, ":utf8");

$|++; # autoflush

our $VERSION = $Webservice::Rosary::API::VERSION;

use constant {
  EXIT_SUCCESS => 0,
  EXIT_ERROR   => 1,
};

sub _mystery_heading {
  my ($day, $group) = @_;
  return uc sprintf q{%s - The %s Mysteries}, ucfirst($day), $group;
}

sub _today_day {
  my @days_of_week = qw(Sunday Monday Tuesday Wednesday Thursday Friday Saturday);
  return lc $days_of_week[(localtime())[6]];
}

sub _next_cycle_day {
  my ($follow_calendar, $current_day, $today) = @_;
  $today = _today_day() if not defined $today;
  return $follow_calendar ? $today : $current_day;
}

sub _prayer_role {
  my $prayer = shift // q{};
  return q{hail_mary}   if $prayer =~ m/^hail__mary/;
  return q{our_father}  if $prayer =~ m/^our__father/;
  return q{glory_be}    if $prayer =~ m/^glory_be/;
  return q{fatima}      if $prayer =~ m/^oh_my_jesus/;
  return q{major_prayer} if $prayer =~ m/^(?:i_believe|holy_queen|final_prayer)$/;
  return q{neutral};
}

sub _hail_mary_role {
  my $ordinal = shift // 1;
  return $ordinal % 2 ? q{hail_mary} : q{hail_mary_alt};
}

sub _format_prayer_text {
  my ($prayer, $text) = @_;
  $prayer //= q{};
  $text //= q{};
  $text =~ s/\\r\\n|\\n/\n/g;
  $text =~ s/Lead/\nLead/; # us to Heaven

  # The API closing prayer may arrive as one long physical line. Keep it
  # readable in the same 72-column terminal presentation as meditations.
  $text = fold_text($text, 72) if $prayer eq q{final_prayer};

  return $text;
}
sub _mystery_role {
  my ($group, $bold) = @_;
  $group = lc($group // q{});
  return q{mystery_title} if $bold and $group !~ m/^(?:joyful|sorrowful|glorious|luminous)$/;
  return q{mystery}       if not $bold and $group !~ m/^(?:joyful|sorrowful|glorious|luminous)$/;
  return sprintf q{mystery_%s%s}, $group, ($bold ? q{_title} : q{});
}

sub _color_palette {
  my $profile = shift // q{dark};

  # 256-color values are deliberately muted. The dark profile uses soft
  # pastels; the light profile uses deeper versions of the same color families.
  my %dark = (
    reset                   => "\e[0m",
    mystery                 => "\e[38;5;153m",     # fallback pale blue-white
    mystery_title           => "\e[1;38;5;153m",   # fallback bold heading
    mystery_joyful          => "\e[38;5;117m",     # light Marian blue
    mystery_joyful_title    => "\e[1;38;5;117m",   # bold light Marian blue
    mystery_sorrowful       => "\e[38;5;167m",     # muted dark red / maroon
    mystery_sorrowful_title => "\e[1;38;5;167m",   # bold muted dark red
    mystery_glorious        => "\e[38;5;180m",     # soft gold / yellow
    mystery_glorious_title  => "\e[1;38;5;180m",   # bold soft gold
    mystery_luminous        => "\e[38;5;183m",     # tranquil lavender-violet
    mystery_luminous_title  => "\e[1;38;5;183m",   # bold lavender-violet
    hail_mary               => "\e[38;5;117m",     # Marian blue
    hail_mary_alt           => "\e[38;5;255m",     # soft white alternate
    our_father              => "\e[38;5;114m",     # soft green
    major_prayer            => "\e[1;38;5;255m",   # bold white: Creed and major closing prayers
    glory_be                => "\e[38;5;180m",     # warm muted gold
    fatima                  => "\e[38;5;183m",     # gentle lavender
    fruit                   => "\e[38;5;151m",     # pale teal-green
    intention               => "\e[38;5;250m",     # soft gray
    meditation              => "\e[38;5;252m",     # quiet near-white
    separator               => "\e[38;5;242m",     # unobtrusive gray
    neutral                 => "\e[38;5;252m",
  );

  my %light = (
    reset                   => "\e[0m",
    mystery                 => "\e[38;5;24m",      # fallback deep calm blue
    mystery_title           => "\e[1;38;5;24m",    # fallback bold heading
    mystery_joyful          => "\e[38;5;31m",      # deeper Marian blue
    mystery_joyful_title    => "\e[1;38;5;31m",    # bold deeper Marian blue
    mystery_sorrowful       => "\e[38;5;88m",      # deep maroon
    mystery_sorrowful_title => "\e[1;38;5;88m",    # bold deep maroon
    mystery_glorious        => "\e[38;5;136m",     # subdued gold
    mystery_glorious_title  => "\e[1;38;5;136m",   # bold subdued gold
    mystery_luminous        => "\e[38;5;97m",      # muted violet
    mystery_luminous_title  => "\e[1;38;5;97m",    # bold muted violet
    hail_mary               => "\e[38;5;31m",      # Marian blue
    hail_mary_alt           => "\e[38;5;236m",     # charcoal alternate
    our_father              => "\e[38;5;65m",      # muted green
    major_prayer            => "\e[1;38;5;232m",   # bold near-black for a light background
    glory_be                => "\e[38;5;136m",     # subdued gold
    fatima                  => "\e[38;5;97m",      # muted violet
    fruit                   => "\e[38;5;30m",      # restrained teal
    intention               => "\e[38;5;240m",     # dark soft gray
    meditation              => "\e[38;5;238m",     # charcoal
    separator               => "\e[38;5;250m",     # pale gray
    neutral                 => "\e[38;5;236m",
  );

  return $profile eq q{light} ? \%light : \%dark;
}

sub _color_enabled {
  my $o = shift;
  return 0 if not $o->color;
  return 0 if exists $ENV{NO_COLOR};
  return 0 if defined $ENV{TERM} and $ENV{TERM} eq q{dumb};
  return 0 if not -t STDOUT;
  return 1;
}

sub _styled {
  my ($text, $role, $Palette) = @_;
  return $text if not $Palette;
  my $start = $Palette->{$role} // $Palette->{neutral};
  return $start . $text . $Palette->{reset};
}

sub _say_styled {
  my ($text, $role, $Palette) = @_;
  say _styled($text, $role, $Palette);
  return;
}

sub _stream_styled {
  my ($text, $role, $Stream, $Palette) = @_;
  print $Palette->{$role} // $Palette->{neutral} if $Palette;
  $Stream->stream($text);
  print $Palette->{reset} if $Palette;
  return;
}

sub _separator {
  my $Palette = shift;
  print _styled(q{-} x 72, q{separator}, $Palette), "\n";
  return;
}

sub _split_command_line {
  my @argv = @_;

  # No arguments means "pray today's Rosary".
  return (q{}, \@argv, 1) if not @argv;

  my $first = $argv[0];

  # These are genuine top-level switches rather than prayer options.
  if ($first =~ m/^(?:-h|--help|-a|--about)$/) {
    my $subcommand = shift @argv;
    return ($subcommand, \@argv, 0);
  }

  # Any other leading option belongs to the prayer command.  Leave it in
  # @argv for Getopt2h2o and implicitly select today's Mystery.
  if ($first =~ m/^-/) {
    return (q{}, \@argv, 1);
  }

  # Otherwise the first argument is an explicit command/day/Mystery.
  my $subcommand = shift @argv;
  return ($subcommand, \@argv, 0);
}

sub main {
  my ($subcommand, $ARGV, $implicit_today) = _split_command_line(@_);

  # Bare `avemaria`, or prayer options without an explicit day/Mystery,
  # remain the convenient guided-prayer shortcut for today's Rosary.
  push @$ARGV, q{--pray} if $implicit_today;

  my $Rosary = Webservice::Rosary::API->new;
  my $ok = eval {
    #>>>
    dispatch { # Dispatch::Fu
      my ($Rosary, $subcommand, $ARGV) = xshift_and_deref @_;
      my @mp3     = qw/today yesterday tomorrow random/;
      my @day     = qw/sunday monday tuesday wednesday thursday friday saturday/;
      my @mystery = qw/joyful glorious sorrowful luminous/;
      return "day"     if not $subcommand;
      return "mp3"     if grep { m/^\Q$subcommand\E$/i } @mp3;
      return "day"     if grep { m/^\Q$subcommand\E$/i } @day;
      return "mystery" if grep { m/^\Q$subcommand\E$/i } @mystery;
      return "about"   if grep { m/^\Q$subcommand\E$/i } qw/about -a --about/;
      return "help"    if grep { m/^\Q$subcommand\E$/i } qw/-h --help help mystery/
                           or $subcommand =~ m/^-/;
      return "help";
    } [ $Rosary, lc($subcommand), $ARGV ],
      day     => \&PrayTheRosary,
      mp3     => \&do_mp3,
      about   => \&do_about,
      help    => \&do_help,
      mystery => \&mystery,
    ;
    #<<<
    1;
  };

  if (not $ok) {
    my $error = $@ || q{unknown error};
    chomp $error;
    warn "avemaria: $error\n";
    return EXIT_ERROR;
  }

  return EXIT_SUCCESS;
}

exit main(@ARGV) unless caller;

sub do_mp3 {
  my ($Rosary, $subcommand, $ARGV) = xshift_and_deref @_;
  say $Rosary->mp3Link($subcommand, $ARGV);
  exit EXIT_SUCCESS;
}

sub do_about() {
  return print <<EOF;
# BACKGROUND ON THE ROSARY

The Rosary is a traditional Catholic prayer devotion that involves the
repetition of prayers and meditation on key events from the lives of Jesus
Christ and the Virgin Mary. The prayer is structured around a set of beads,
each representing a specific prayer. These include the Our Father, Hail Mary,
and Glory Be, which are recited while reflecting on the Mysteries-twenty
key moments in the lives of Jesus and Mary, grouped into four categories:
the Joyful, Sorrowful, Glorious, and Luminous Mysteries. The Rosary is both
a contemplative prayer and a way to focus on the essential aspects of the
Catholic faith, helping the faithful deepen their relationship with God.

The history of the Rosary dates back to the Middle Ages, with its roots often
linked to St. Dominic, who is traditionally credited with receiving the Rosary
from the Virgin Mary in the 13th century. The Rosary evolved over several
centuries. One of its early forms was connected to the Psalter of Our Lady,
where the faithful would pray 150 Hail Marys, reflecting the 150 Psalms of
the Old Testament. This practice was common among laypeople who could not
read the Psalms themselves but still wanted to engage in a structured form
of prayer. Over time, the Rosary's prayers and structure were refined, and
by the 16th century, it became formally established by the Catholic Church
as a central devotion, with the mysteries of the Rosary added to provide a
scriptural basis for the prayers.

## Biblical Foundations of the Hail Mary

For Catholics, the Rosary is a deeply meaningful prayer practice that helps
them draw closer to God by reflecting on the pivotal moments of salvation
history. Its biblical foundations are grounded in scripture, with the Hail Mary
drawn from the Angel Gabriel's greeting to Mary in Luke 1:28 and Elizabeth's
words in Luke 1:42.

The first part of the Hail Mary comes from Luke 1:28 and Luke 1:42 in the
Douay-Rheims translation:

> And the angel being come in, said unto her: Hail, full of grace, the Lord
> is with thee: blessed art thou among women.

https://drbo.org/cgi-bin/d?b=drb&bk=49&ch=1&l=28-#x

and:

> And she cried out with a loud voice, and said: Blessed art thou among women,
> and blessed is the fruit of thy womb.

https://drbo.org/cgi-bin/d?b=drb&bk=49&ch=1&l=43-#x

These biblical words form the Angelic Salutation, which Catholics begin the
Hail Mary with:

> Hail Mary, full of grace, the Lord is with thee: blessed art thou
> among women, and blessed is the fruit of thy womb, Jesus.

## The Second Part of the Hail Mary

The second part of the Hail Mary, which was added later to the prayer,
invokes Mary's intercession. This part is drawn from the Catholic tradition
and reflects the Church's desire for Mary's prayers to be a source of strength
and protection for all the faithful. The second part reads:

> Holy Mary, Mother of God, pray for us sinners, now and at the hour
> of our death. Amen.

This petition is based on Mary's role as Mother of God (as declared in Luke
1:43, when Elizabeth calls her the "Mother of my Lord") and her ongoing role
as intercessor for the Church. It is the second part of the Hail Mary that
Catholics use to seek her intercession, especially in times of trial.

https://drbo.org/cgi-bin/d?b=drb&bk=49&ch=1&l=43-#x

## The Our Father

The Our Father comes directly from Jesus' teaching in the Gospel of Matthew
6:9-13:

> Thus therefore shall you pray: Our Father who art in heaven, hallowed be Thy
> name. Thy kingdom come. Thy will be done, on earth as it is in heaven. Give
> us this day our daily bread. And forgive us our trespasses, as we forgive
> those who trespass against us. And lead us not into temptation, but deliver
> us from evil.  Matthew 6:9-13.

https://drbo.org/cgi-bin/d?b=drb&bk=47&ch=6&l=9-13#x

By meditating on the Mysteries of the Rosary, Catholics invite the presence
of Jesus into their lives, contemplating His birth, death, resurrection, and
the role of Mary in His story. These meditations, grouped into the Joyful,
Sorrowful, Glorious, and Luminous Mysteries, help to guide the faithful
through the essential moments of Christ's life and His salvation work.

## The Rosary as a Communal Devotion

The Rosary is seen not just as a personal prayer, but as a communal devotion
that fosters a deeper understanding of God's love and a powerful means of
seeking His intercession. It is often prayed in groups, in parishes, or even
in families, helping to build unity within the faith community. Through its
rich combination of prayer and meditation, the Rosary has become a beloved
devotion for Catholics around the world, encouraging spiritual growth and
reflection on the central mysteries of the Christian faith.

The importance of daily prayer of the Rosary was emphasized by Our Lady
during the Apparitions at Fatima in 1917, where she specifically urged the
children to "pray the Rosary every day" for peace in the world and for the
salvation of souls, making it a call for all the faithful to embrace this
prayer as a tool for spiritual strength and intercession. For more information
on Fatima, look up, "the Miracle of the Sun."

+Deo Gratias+

EOF
  exit EXIT_SUCCESS;
}

sub do_help() {
  return print <<EOF;
avemaria - commandline Rosary client for DailyRosary.cf and TheRosaryAPI.cf

VERSION $Webservice::Rosary::API::VERSION

Note: Commandline options may change to accomodate feedback. This note will
be removed once the cli UX settles.

Quick Start

  > avemaria                         # no arguments
  > ... runs through the recitation of the Rosary for today, equivalent,
    to,

  > avemaria \$(date "+%A") --pray    # `date` prints today's day of week

Getting Help

  > avemaria help
  > ... prints help section

Learning More

  > avemaria about
  > ... prints an "about" section

Functional Commands

There are 2 types of commands. One set of commands returns a URL for an MP3,
which may then be piped into another program to download it. The other set
of commands displays the specified Mystery (by day of the week or actual
name of the Mystery), so that the user may be guided through the specified
Mystery of the Rosary - from start to finish.

Usage - to print MP3 URL to STDOUT:

  avemaria today | yesterday | tomorrow | random

Example 1,

  > avemaria today
  > https://dailyrosary.cf/audio-rosary-sorrowful-mysteries.mp3

Example 2,

  > curl -O \$(avemaria random) -w "\\nDownloaded file: %{filename_effective}\\n"
    % Total    % Received % Xferd  Average Speed   Time    Time     Time  Current
                                   Dload  Upload   Total   Spent    Left  Speed
  100 31.5M  100 31.5M    0     0  2374k      0  0:00:13  0:00:13 --:--:-- 5043k

  Downloaded file: audio-rosary-sorrowful-mysteries.mp3
  >

Note, MP3 Sources are as follows:

  + https://www.discerninghearts.com/Devotionals/Rosary-Joyful-Mysteries.mp3

  + https://www.discerninghearts.com/Devotionals/Rosary-Luminous-Mysteries.mp3

  + https://www.discerninghearts.com/Devotionals/Rosary-Sorrowful-Mysteries.mp3

  + https://www.discerninghearts.com/Devotionals/Rosary-Glorious-Mysteries.mp3

Usage - to Pray the Rosary in the commandline:

  avemaria DAY_OR_MYSTERY [--pray] [--unceasingly]
                           [--scroll] [--fully] [-i] [-t]
                           [--sleep=0.N] [--speed=N] [--between=N]
                           [--nocontrols]
                           [--color [--dark | --light]]

  Valid DAY_OR_MYSTERY values:

    Joyful, Sorrowful, Luminous, Glorious, Sunday, Monday, Tuesday, Wednesday, Thursday, Friday, or Saturday

  Prayer mode:

  --pray          : stream the selected Rosary prayer by prayer.
  --unceasingly   : continuously pray until stopped; implies --pray. With no
                    explicit day/Mystery, the calendar day is re-evaluated at
                    each Rosary boundary. An explicit day/Mystery stays fixed.

  Presentation:

  --scroll        : keep prior prayers visible instead of clearing the terminal.
  --fully         : include the full decade meditation in addition to its title
                    and Fruit of the Mystery.
   -i             : require <RETURN> after each prayer (and each description
                    when used with --fully).
   -t             : require <RETURN> after each decade description; requires
                    --fully.

  Timing and interaction:

  --sleep=0.N     : base delay before each character. Default is 0.04 seconds.
  --speed=N       : initial text speed multiplier. Default is 1.0.
  --between=N     : pause between prayers. Default is 0.75 seconds.
  --nocontrols    : disable live single-key controls. -i/-t <RETURN> prompts
                    still work. With --unceasingly, use Ctrl-C to stop when
                    live controls are disabled.

  Color:

  --color         : enable the tranquil color palette on an interactive terminal.
  --dark          : select the dark-background profile; this is the --color default.
  --light         : select the light-background profile.
                    --dark and --light require --color and are mutually exclusive.

  Color is never emitted unless --color is requested. NO_COLOR and non-terminal
  output remain uncolored. --color by itself uses the --dark profile. Hail Marys
  alternate light Marian blue and a neutral foreground (soft white on dark,
  charcoal on light), starting with blue for the introductory Hail Marys and
  again at each decade. Our Fathers are soft green. Joyful Mystery headings are
  light blue, Sorrowful dark red/maroon, Glorious soft yellow/gold, and Luminous
  gentle violet. Each individual Mystery title is bold in its family's color.
  Other prayers and supporting text use coordinated tranquil accents.

  While --pray is streaming in an interactive terminal:

    SPACE/p : pause or resume
    + or =  : speed up immediately
    - or _  : slow down immediately
    0       : reset to the initial --speed value
    q       : ask "Quit y/N?"; a confirmed quit exits cleanly

Example 3,

  Used without additional options, it just prints the name of the Mystery

  > avemaria Monday
  > Monday - The Joyful Mysteries
  >

  > avemaria Sorrowful
  > Friday - The Sorrowful Mysteries
  >

Example 4,

  > avemaria Friday --pray -t --fully
  > .. clears screen, then prays the specified Mystery (Sorrowful in this case),
    while pausing only at the beginning of each Mystery after the description has
    been printed ...

Example 5,

  Run with absolutely no subcommands or flags, runs "--pray" for Today's Mystery,

  > avemaria
  > .. clears screen, then prays the specified Mystery for Today ...

Example 6,

  Pray continuously until q (with confirmation) or Ctrl-C is used to stop:

  > avemaria --unceasingly --scroll --color

  --unceasingly composes with the ordinary prayer options. It implies --pray
  and retains live speed changes between cycles. With no explicit day/Mystery,
  the day is checked again at each complete-Rosary boundary so a prayer running
  across midnight moves to the new day's Mysteries. An explicitly selected day
  or Mystery remains fixed. In --scroll mode the overall heading is shown again
  at the beginning of each new Rosary, while ordinary prayer lines remain
  uncluttered.

Feedback is Requested.

The timing and presentation controls are intentionally small so that --pray can
remain useful in ordinary terminals without turning the client into a full-screen
application. In --scroll mode, the overall heading is shown once per Rosary and
decade headings are shown only when a new decade begins, keeping repeated
prayer text uncluttered. Mystery headings are displayed in uppercase. Normal prayer mode
shows each decade title and Fruit of the Mystery; --fully additionally presents
the longer meditation text. The introductory Our Father is offered for the
intentions and well-being of Pope Leo XIV, followed by Hail Marys for an
increase in Faith, Hope, and Charity.

+Deo Gratias+

VERSION $Webservice::Rosary::API::VERSION

avemaria - commandline Rosary client for DailyRosary.cf and TheRosaryAPI.cf

EOF

  exit EXIT_SUCCESS;
}

sub mystery {
  my ($Rosary, $subcommand, $ARGV ) = xshift_and_deref @_;
  my $Convert = h2o {
    luminous  => "thursday",
    sorrowful => "friday",
    joyful    => "saturday",
    glorious  => "sunday",
  };
  $subcommand = $Convert->$subcommand;
  return PrayTheRosary([$Rosary, $subcommand, $ARGV]);
}

sub _print {
  my ($Text, $Stream) = @_;
  return $Stream->stream($Text);
}

sub _prompt_continue {
  my $Stream = shift;
  $Stream->restore_terminal;
  print "\n\n<RETURN> to continue ... ";
  my $next = <STDIN>;
  $Stream->resume_terminal;
  return $next;
}

sub _load_rosary_data {
  my ($Rosary, $day) = @_;

  my $Mystery = $Rosary->day($day);
  die "Rosary API returned no Mystery for $day\n" if not $Mystery;

  # Detailed Mystery data supplies each decade title and Fruit of the Mystery.
  # If that secondary endpoint is temporarily unavailable, retain the basic
  # recitation rather than making the whole Rosary unusable.
  my $Details = eval { $Rosary->details(lc $Mystery->group_by) };
  if ($@) {
    my $error = $@;
    chomp $error;
    warn "avemaria: could not load Mystery details: $error\n";
    $Details = undef;
  }

  my $Name = _mystery_heading($day, $Mystery->group_by);
  my $MysteryRole = _mystery_role($Mystery->group_by, 0);
  my $MysteryTitleRole = _mystery_role($Mystery->group_by, 1);

  # Add the local response/closing presentation fields used by the CLI.
  $Mystery = tr4h2o o2d $Mystery;
  $Mystery->{pray_for_us_most_holy_mother_of_god} = <<'EOF';
V. Pray for us, Oh Holy Mother of God
R. That we may be made worth of the promises of Christ.
EOF
  $Mystery->{oremus} = "V. Let us Pray.";
  $Mystery->{most_holy_rosary} = "";
  $Mystery->{in_the_name_2} = sprintf "The Most Holy Rosary.\n%s", $Mystery->{in_the_name_2};
  h2o $Mystery;

  return ($Mystery, $Details, $Name, $MysteryRole, $MysteryTitleRole);
}

sub PrayTheRosary {
  my ($Rosary, $subcommand, $ARGV) = xshift_and_deref @_;
  my $follow_calendar = ! defined($subcommand) || ! length($subcommand);
  $subcommand = _today_day() if $follow_calendar;

  my $o = Getopt2h2o $ARGV,
    {
      sleep    => 0.04,
      speed    => 1.0,
      between  => 0.75,
      controls => 1,
      scroll   => 0,
      color    => 0,
      dark     => 0,
      light       => 0,
      unceasingly => 0,
    },
    qw/pray unceasingly i t fully without scroll|no-clear controls! sleep=f speed=f between=f color dark light/;

  die "--sleep must be zero or greater\n" if $o->sleep < 0;
  die "--speed must be greater than zero\n" if $o->speed <= 0;
  die "--between must be zero or greater\n" if $o->between < 0;
  die "-t requires --fully\n" if $o->t and not $o->fully;
  die "--dark and --light cannot be used together\n" if $o->dark and $o->light;
  die "--dark and --light require --color\n" if not $o->color and ($o->dark or $o->light);

  # --unceasingly is itself a prayer mode rather than a presentation modifier,
  # so it naturally implies --pray even with an explicit day or Mystery.
  my $praying = $o->pray || $o->unceasingly;

  my ($Mystery, $Details, $Name, $MysteryRole, $MysteryTitleRole) =
    _load_rosary_data($Rosary, $subcommand);

  unless ($praying) {
    say $Name;
    exit EXIT_SUCCESS;
  }

  my $Stream = Webservice::Rosary::Stream->new(
    delay    => $o->sleep,
    speed    => $o->speed,
    controls => $o->controls,
    on_quit  => sub {
      print "\nPray the Rosary every day, +JMJ+\n";
      exit EXIT_SUCCESS;
    },
  );

  # --color defaults to the dark-background profile unless --light is explicit.
  my $profile = $o->light ? q{light} : q{dark};
  my $Palette = _color_enabled($o) ? _color_palette($profile) : undef;

  # Do not leave an interactive terminal in cbreak mode if prayer is stopped
  # with Ctrl-C or terminated by the shell.
  local $SIG{INT} = sub {
    $Stream->restore_terminal;
    print STDERR "\n";
    exit 130;
  };
  local $SIG{TERM} = sub {
    $Stream->restore_terminal;
    exit 143;
  };

  # Iterate over the entire Rosary, in Perl
  my @Prayers       = qw/In_The_Name_1 I_Believe Our__Father_1 Hail__Mary_1 Hail__Mary_2 Hail__Mary_3 Glory_Be_1 Oh_My_Jesus_1/;
  my $Decade        = 0;
  my $Announce      = 0;
  my $Pater_Noster  = 1; # "Our Father, who art in Heaven ..."
  my $Ave_Maria     = 3; # "Hail Mary, full of Grace ..."
  my $Gloria_Patria = 1; # "Glory be to the Father, to the Son, and to the Holy Ghost ..."
  my $O_Mi_Jesu     = 1; # "O My Jesus, forgive us our sins ..." (aka, "The Fatima Prayer")
  foreach my $D (1..5) {
    push @Prayers, sprintf "Announce_%d", ++$Announce;
    push @Prayers, sprintf "Our__Father_%d", ++$Pater_Noster;
    foreach my $I (1..10) {
      push @Prayers, sprintf "Hail__Mary_%d_%d", ++$Ave_Maria, $I;
    }
    push @Prayers, sprintf "Glory_Be_%d", ++$Gloria_Patria;
    push @Prayers, sprintf "Oh_My_Jesus_%d", ++$O_Mi_Jesu;
  }
  push @Prayers, qw/Holy_Queen Pray_For_Us_Most_Holy_Mother_of_God Oremus Final_Prayer Most_Holy_Rosary In_The_Name_2/;

  my $total = scalar @Prayers;
  my $cycle = 0;

  ROSARY: while (1) {
    # When no day or Mystery was supplied explicitly, --unceasingly follows
    # the calendar. Re-evaluate the day only between complete Rosaries; an
    # explicit day/Mystery remains fixed until the process exits.
    my $cycle_day = _next_cycle_day($follow_calendar, $subcommand);
    if ($cycle_day ne $subcommand) {
      $subcommand = $cycle_day;
      ($Mystery, $Details, $Name, $MysteryRole, $MysteryTitleRole) =
        _load_rosary_data($Rosary, $subcommand);
    }

    $Stream->wait($o->between) if $cycle;
    print "\n\n" if $cycle and $o->scroll;
    ++$cycle;

    my $count  = 0;
    my $decade = 0;
    my $hail_mary_ordinal = 0;

    if ($o->scroll) {
      _say_styled($Name, $MysteryRole, $Palette);
      if ($Stream->interactive) {
        _say_styled('[' . $Stream->controls_help . ']', q{intention}, $Palette);
      }
      _separator($Palette);
      print "\n";
    }

    foreach my $Prayer (map { lc } @Prayers) {
      my $Text = _format_prayer_text($Prayer, $Mystery->$Prayer);

      my $is_decade = $Prayer =~ m/^announce_(\d+)$/ ? 1 : 0;
      $hail_mary_ordinal = 0 if $is_decade;
      my $detail = $is_decade && ref($Details) eq q{ARRAY}
        ? $Details->[$decade]
        : undef;

      $Stream->wait($o->between) if $count;

      if ($o->scroll) {
        # Ordinary prayers simply continue down the terminal. A visible section
        # break is reserved for the start of each new decade.
        print "\n\n" if $count;
      }
      else {
        print "\033[2J\033[H"; # clear terminal
      }

      ++$count;

      if (not $o->scroll) {
        _say_styled($Name, $MysteryRole, $Palette);
        printf "Prayer %d of %d", $count, $total;
        printf "  [%s]", $Stream->controls_help if $Stream->interactive;
        print "\n";
        _separator($Palette);
        print "\n";
      }

      if ($is_decade) {
        my $title = $detail ? ($detail->title // q{}) : q{};
        my $fruit = $detail ? ($detail->fruit // q{}) : q{};

        if (length $title) {
          _separator($Palette) if $o->scroll;
          _say_styled(uc($title), $MysteryTitleRole, $Palette);
          if (length $fruit) {
            $fruit = "Fruit of the Mystery: $fruit" if $fruit !~ m/fruit/i;
            _say_styled($fruit, q{fruit}, $Palette);
          }
          _separator($Palette) if $o->scroll;
          print "\n";
        }

        if ($o->fully and $detail) {
          my $meditation = $detail->text // q{};
          if (length $meditation) {
            _stream_styled(fold_text($meditation, 72), q{meditation}, $Stream, $Palette);
            print "\n\n";
          }
          _prompt_continue($Stream) if $o->i or $o->t;
        }

        # The day response normally contains an announcement duplicating the
        # detailed title. Prefer the richer title/fruit presentation when it is
        # available; retain the API announcement as a fallback.
        $Text = q{} if $detail and length $title;
        ++$decade;
      }

      my $intention = opening_intention($Prayer);
      if (length $intention) {
        _say_styled($intention, q{intention}, $Palette);
        print "\n";
      }

      if (length $Text) {
        my $role = _prayer_role($Prayer);
        if ($role eq q{hail_mary}) {
          $role = _hail_mary_role(++$hail_mary_ordinal);
        }
        _stream_styled($Text, $role, $Stream, $Palette);
      }
      _prompt_continue($Stream) if $o->i and length $Text;
    }

    last ROSARY if not $o->unceasingly;
  }

  $Stream->restore_terminal;
  print "\n";
  exit EXIT_SUCCESS;
}

1;

__END__
