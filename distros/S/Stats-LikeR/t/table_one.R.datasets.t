#!/usr/bin/env perl
# table_one(), against what base R computes for the same data.
#
# Provenance:
#   The R tableone package is not installed and no suite exists for table_one
#   itself, so no case is a tableone output.  Each case is the statistic the
#   README says table_one reports, computed by base R 4.6.2 on R's own
#   datasets (mtcars, sleep, iris, ToothGrowth, airquality) in
#   t/table_one.R.datasets.R, which also prints the data frames below:
#     mean (sd) and n (percent) cells   mean(), sd(), table() of each group
#     2 groups, continuous              t.test(x ~ g)       (Welch)
#     2 groups, nonparametric           wilcox.test(x ~ g)
#     3+ groups, continuous             summary(aov(x ~ factor(g)))  (F test)
#     3+ groups, nonparametric          kruskal.test(x ~ g)
#     categorical                       chisq.test(table(level, g))
#   The R functions behind these have their own references (R's t.test.Rd,
#   wilcox.test.Rd, kruskal.test.Rd, chisq.test.Rd examples; sleep is the
#   classic Student 1908 data), so the p-values are R's, not a transcription.
# Re-run:  Rscript t/table_one.R.datasets.R
# This test never runs R.
#
# Tolerance: p-values 1e-8 relative.  The worst disagreement on this (double)
# build was 1.1e-13 (iris Petal.Length ANOVA, p = 2.9e-91, a far tail of the F
# distribution), so 1e-8 leaves 1e5x for long double and quadmath builds.
# Strings must be equal exactly.
#
# Deliberate differences (table_one is not tableone):
#   - tableone prints p-values formatted and tests non-normal variables by
#     name; here the test is chosen by nonparametric => 1 only.
#   - the continuous summary is "mean (sd)" with digits => 2, not tableone's
#     "mean (SD)" column with header rows.

require 5.010;
