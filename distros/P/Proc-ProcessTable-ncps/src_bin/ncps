if ( defined( $ENV{NCPS_cminflt} ) && ( $ENV{NCPS_cminflt} eq '1' ) ) {
	$cminor_faults = $cminor_faults ^ 1;
}
if ( defined( $ENV{NCPS_minflt} ) && ( $ENV{NCPS_minflt} eq '1' ) ) {
	$minor_faults = $minor_faults ^ 1;
