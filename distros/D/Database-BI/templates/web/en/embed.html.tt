<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>[% title | html %]</title>
<script src="[% d3_url | html %]"></script>
[% card_head %]
<style>
*, *::before, *::after { box-sizing: border-box; }
body {
	margin: 0;
	padding: 0.5rem;
	font-family: system-ui, sans-serif;
	font-size: 14px;
	background: #fff;
	color: #212529;
}
.embed-title {
	font-size: 1rem;
	font-weight: 600;
	margin: 0 0 0.5rem;
}
.embed-grid {
	display: grid;
	grid-template-columns: repeat(12, 1fr);
	grid-auto-rows: auto;
	gap: 0.75rem;
}
/* The height is on the card rather than the row, so a row of text is as tall as
 * its text.  Nothing on this page spans rows. */
.visual-card {
	min-height: 15rem;
	background: #fff;
	border: 1px solid #dee2e6;
	border-radius: 4px;
	overflow: hidden;
	display: flex;
	flex-direction: column;
	grid-column: span 6;
}
.text-card { min-height: 0; grid-column: 1 / -1; }
.text-card-plain { border-color: transparent; background: transparent; }
.text-card .visual-card-body { display: flex; padding: 0; }
.text-card-text { flex: 1; min-width: 0; padding: 0.5rem 0.75rem; line-height: 1.3; overflow-wrap: anywhere; }
.visual-card-title {
	font-weight: 600;
	font-size: 0.85rem;
	padding: 0.3rem 0.5rem;
	background: #f8f9fa;
	border-bottom: 1px solid #dee2e6;
}
.visual-card-body {
	flex: 1;
	overflow: auto;
	padding: 0.4rem;
}
.visual-card-body svg { max-width: 100%; height: auto; }
.visual-error { color: #dc3545; padding: 0.5rem; font-size: 0.82rem; }
/* A map marker's rows (_map_popup): the box scrolls, set inline. */
.bi-map-popup-rows { margin-top: 0.3em; }
.bi-map-popup-rows table { border-collapse: collapse; font-size: 90%; }
.bi-map-popup-rows th, .bi-map-popup-rows td { padding: 0.1em 0.6em 0.1em 0; text-align: left; vertical-align: top; white-space: nowrap; }
</style>
</head>
<body>
<p class="embed-title">[% canvas_name | html %]</p>
[% IF visuals.size %]
<div class="embed-grid" id="embed-grid">
[% FOREACH v IN visuals %]
	<div class="visual-card[% v.kind == 'text' ? ' text-card' : '' %][% v.plain ? ' text-card-plain' : '' %]"
	     id="visual-[% v.id %]"
	     [% IF v.style.length %]style="[% v.style | html %]"[% END %]>
		[% IF v.title.length && v.kind != 'text' %]
		<div class="visual-card-title">[% v.title | html %]</div>
		[% END %]
		<div class="visual-card-body">
			[% IF v.error.length %]
			<p class="visual-error">[% v.error | html %]</p>
			[% ELSIF v.html.length %]
			[% v.html %]
			[% END %]
		</div>
	</div>
[% END %]
</div>
[% ELSE %]
<p>No visuals to display.</p>
[% END %]
</body>
</html>
