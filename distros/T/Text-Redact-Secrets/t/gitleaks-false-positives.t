for my $rule (sort keys %$false_positives) {
    subtest $rule => sub {
        my $n = 0;
        for my $text (@{ $false_positives->{$rule} }) {
            $n++;
            is [grep { $_->{rule} eq $rule } find($text)], [],
                "false positive $n";
        }
    };
}

