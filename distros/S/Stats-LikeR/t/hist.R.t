#!/usr/bin/env perl
# hist() against R 4.6.1's graphics::hist.default().
#
# Provenance: t/hist.R.R (committed next to this file) generated every literal
# in @R_ROWS under R 4.6.1 (2026-06-24) at options(digits = 17).  Re-run it with
#     Rscript t/hist.R.R
# This test never invokes R; it reads the frozen literals.
#
# What it pins.  R does not cut the range into `breaks` equal pieces.  It takes
# that number as a suggestion and asks pretty() for round numbers:
#
#     breaks <- pretty(range(x), n = breaks, min.n = 1)
#
# so the interval count that comes back need not be the one asked for, and the
# ends of the axis are rounded outwards past the data.  Through 0.311 this
# module stepped (max - min) / n from min instead, which puts the breaks
# wherever the sample happens to start and stop: for
# c(1,2,2,3,4,7,9,10,11,15) it gave
#
#     1  5.75  10.5  15.25  20        R: 0  5  10  15  20
#
# and mids, density and the counts followed the breaks.  0.312 ports R_pretty()
# (src/appl/pretty.c) with pretty.default()'s parameters -- high.u.bias 1.5,
# u5.bias 0.5 + 1.5*1.5, f.min 2^-20, shrink.sml 0.75, eps.correct 0 -- and
# hist.default()'s min.n = 1.
#
# The default bin count is R's nclass.Sturges(), ceiling(log2(n) + 1).  The
# ceiling is part of it: log2(13) + 1 is 4.70, which R turns into 5 and a
# truncating cast turned into 4.  @R_ROWS has n = 8 and n = 13 for that.
#
# Coverage: seventeen datasets crossed with breaks in {default, 1, 2, 3, 5, 8,
# 12, 20} -- 136 rows, four vectors each.  Among them a single point, a
# constant column (zero-width range), a two-point column, data spanning zero,
# data of order 1e-3 and of order 1e6, and negative-only data, since pretty()
# branches on the sign of the bounds and on whether the range is negligible
# beside its own magnitude.  The four ovf.* sets, added in 0.3217, have a range
# wider than the largest double: the breaks used to be filled with an infinite
# step, so hist([1.7e308, -1.7e308], breaks => 4) gave 0, Inf, 0.  Three of
# them are the pretty() overflow data of R's tests/reg-tests-1d.R,
# c(f*1e308, 2^1023.9).  R's own mids overflow to -Inf or Inf on some of them,
# because 0.5 * (a + b) does; hist() deliberately gives the finite midpoint,
# and those mids are checked against R's breaks halved and added.  The ovf.*
# rows run only where an NV is a double, from exact bit patterns; see below.
#
# Tolerance.  1e-14 relative, against a worst observed disagreement over the
# 544 vectors of 0 on the double build.  Counts are integers and are
# compared exactly.  Most of the arithmetic is exact -- pretty()'s breaks are
# small multiples of a power of ten -- so what the tolerance covers is density,
# which divides by n and by a width.

require 5.010;
use strict;
use warnings FATAL => 'all';
use Config;
use Test::More;
use lib 'blib/lib', 'blib/arch';
use Stats::LikeR qw(hist);

my $TOL = 1e-14;   # justified in the header

my $worst = 0;
sub vec_ok {
	my ($got, $want, $name) = @_;
	my @w = split /,/, $want;
	if (@$got != @w) {
		fail($name);
		diag("got " . scalar(@$got) . " values, expected " . scalar(@w)
		     . ": [@$got] vs [@w]");
		return;
	}
	for my $i (0 .. $#w) {
		if ($w[$i] =~ /^(-?)Inf$/) {	# R's own mids overflow to -Inf/Inf on these ranges
			my $inf = ($1 ? -1 : 1) * 9**9**9;
			next if $got->[$i] == $inf;
			fail($name);
			diag("element $i: got $got->[$i], expected $w[$i]");
			return;
		}
		my $err = abs($w[$i]) > 1e-300 ? abs($got->[$i] - $w[$i]) / abs($w[$i])
		                               : abs($got->[$i] - $w[$i]);
		$worst = $err if $err > $worst;
		if ($err > $TOL) {
			fail($name);
			diag("element $i: got $got->[$i], expected $w[$i], rel $err");
			return;
		}
	}
	pass($name);
}

