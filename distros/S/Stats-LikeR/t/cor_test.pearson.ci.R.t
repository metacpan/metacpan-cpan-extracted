#!/usr/bin/env perl
# cor_test(method => 'pearson')'s confidence interval, against R 4.6.1.
#
# Provenance: t/cor_test.pearson.ci.R.R (committed next to this file)
# generated every literal in @R_ROWS under R 4.6.1 (2026-06-24) at
# options(digits = 17).  Re-run it with
#     Rscript t/cor_test.pearson.ci.R.R
# This test never invokes R; it reads the frozen literals.
#
# What it pins.  Through 0.311 the interval was the two-sided Fisher-z
# interval whatever `alternative` said:
#
#     cor_test(1..10, (2,1,4,3,7,5,9,6,10,8), alternative => 'greater')
#         gave  [0.521743144851243, 0.968050771383804]
#         R:    [0.602990132384267, 1]
#
# R switches on the alternative (src/library/stats/R/cor.test.R, the `cint`
# switch): `less` is (-Inf, z + sigma*qnorm(conf.level)] and `greater` is
# [z - sigma*qnorm(conf.level), Inf), both then passed through tanh -- so the
# open end comes back as exactly -1 or 1.  The p-value was never wrong; only
# the interval was, which is the kind of error that reads as an answer.
#
# Three confidence levels are crossed with the three alternatives so that the
# quantile the one-sided branches use -- qnorm(conf.level), not
# qnorm((1+conf.level)/2) -- is pinned rather than coincidentally right at 0.95.
#
# It also pins that no interval is offered below n = 4: Fisher's z has
# 1/sqrt(n-3) for its standard error, so R guards the whole block with
# `if(n > 3)` and leaves conf.int out of the htest.  0.311 returned
# [-1, 1] there, which is tanh(+-Inf) and says nothing.
#
# Tolerance.  1e-13 relative, against a worst observed disagreement over the
# 54 rows of 8.47e-15 on the double build -- 12x headroom.  The interval is
# tanh(atanh(r) +- q/sqrt(n-3)), so it carries one qnorm, one atanh and one
# tanh; each is correctly rounded here and in R, and the residue is the last
# bit or two of r itself.  Exact +-1 endpoints are compared exactly, since
# that is what tanh(+-Inf) gives on both sides.

require 5.010;
use strict;
use warnings FATAL => 'all';
use Test::More;
use lib 'blib/lib', 'blib/arch';
use Stats::LikeR qw(cor_test);

my $TOL = 1e-13;   # justified in the header

my $worst = 0;
sub rel_ok {
	my ($got, $want, $name) = @_;
	if ($want == 1 || $want == -1) {   # the open end of a one-sided interval
		is($got, $want, $name);
		return;
	}
	my $err = abs($want) > 1e-300 ? abs($got - $want) / abs($want)
	                              : abs($got - $want);
	$worst = $err if $err > $worst;
	ok($err <= $TOL, $name) or diag("got $got, expected $want, rel $err");
}

