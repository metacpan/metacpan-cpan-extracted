use strict;
use warnings;
use Test::More;

# -----------------------------------------------------------------------------
# A node set up with Rex::GPU 0.001 has a config.toml.tmpl that replaced
# rke2's containerd config; Rex::GPU 0.002 removes it but restarts nothing,
# and rke2 is only started (a no-op while it runs). start_verb restarts a
# running rke2 exactly when config.toml is still that template's output and
# the template is gone, or replaced by another one since (k72: install_server
# and install_agent remove the bare one first, t/containerd-bare-template.t);
# otherwise rke2 keeps `start` and k3s keeps `restart`. The bare template
# still in place (start_verb asked on its own) gets a warning with what to
# do, no restart.
#
# run is faked; this proves the decision and the command order, not that a
# real rke2 regenerates its config.
# -----------------------------------------------------------------------------

use Rex::Rancher::Server;
use Rex::Rancher::Agent;
use Rex::Rancher::Distribution;

my $D = 'Rex::Rancher::Distribution';

my @perl_warnings;
$SIG{__WARN__} = sub { push @perl_warnings, @_ };

my $CLOBBER = qq{imports = ["/etc/containerd/conf.d/*.toml"]\nversion = 2\n};
my $BASE    = qq{{{ template "base" . }}\n\n[plugins."io.containerd.grpc.v1.cri".registry]\n  config_path = "/etc/containerd/certs.d"\n};
my $NATIVE  = <<'TOML';
# File generated by rke2. DO NOT EDIT. Use config-v3.toml.tmpl instead.
version = 3
root = "/var/lib/rancher/rke2/agent/containerd"

[plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.runc.options]
  SystemdCgroup = true
TOML

subtest 'is_bare_template_output' => sub {
  my $is = sub { $D->is_bare_template_output(@_) };
  ok( $is->($CLOBBER), 'Rex::GPU 0.001 output' );
  ok( $is->("# c\n\nversion = 2\nimports = []\n"), 'order, comments and blank lines do not matter' );
  ok( !$is->($NATIVE),  'rke2 native config' );
  ok( !$is->(undef),    'no config.toml' );
  ok( !$is->(''),       'empty' );
  ok( !$is->("version = 2\n"), 'version alone' );
  ok( !$is->("imports = []\n"), 'imports alone' );
  ok( !$is->($CLOBBER."[plugins.x]\n"), 'with a plugins section' );
  ok( !$is->(qq{{{ template "base" . }}\nimports = []\nversion = 2\n}), 'base-extending template output' );
};

my ( @log, @warn, %host );
{
  no warnings 'redefine';
  my $run = sub {
    my ( $cmd ) = @_;
    push @log, $cmd;
    $? = 0;
    if ( $cmd =~ m{^cat (\S+)/config\.toml } ) { return $host{config} // '' }
    if ( $cmd =~ m{^cat (\S+)/config\.toml\.tmpl } ) {
      return $host{tmpl} if defined $host{tmpl};
      $? = 256;
      return '';
    }
    if ( $cmd =~ m{^rm -f .*config\.toml\.tmpl} ) { delete $host{tmpl}; return '' }
    if ( $cmd =~ m{^systemctl is-active --quiet} ) { $? = $host{active} ? 0 : 768; return '' }
    if ( $cmd =~ m{^systemctl is-active } ) { return "active\n" }
    if ( $cmd =~ m{^command -v rke2} ) { return "/usr/local/bin/rke2\n" }
    if ( $cmd =~ m{^test -f} ) { return "yes\n" }
    return '';
  };
  *Rex::Commands::Run::run    = $run;
  *Rex::Rancher::Server::run  = $run;
  *Rex::Rancher::Agent::run   = $run;
  *Rex::Commands::File::file  = sub { push @log, 'file '.$_[0] };
  *Rex::Rancher::Server::file = sub { push @log, 'file '.$_[0] };
  *Rex::Logger::info = sub { push @warn, $_[0] if ( $_[1] // '' ) eq 'warn' };
}

# ( host state, rke2 verb, k3s verb, warning like )
my @case = (
  [ 'no config.toml yet',                     {},                                              'start',   'restart', undef ],
  [ 'native config, running',                 { config => $NATIVE, active => 1 },              'start',   'restart', undef ],
  [ 'stale, template gone, running',          { config => $CLOBBER, active => 1 },             'restart', 'restart', qr/rendered from a config\.toml\.tmpl that is gone.*restarting/ ],
  [ 'stale, template gone, not running',      { config => $CLOBBER, active => 0 },             'start',   'restart', undef ],
  [ 'stale, template still there, running',   { config => $CLOBBER, active => 1, tmpl => $CLOBBER }, 'start', 'restart', qr/replaces (?:rke2|k3s)'s own containerd config.*Remove it \(remove_bare_containerd_template.* systemctl restart / ],
  [ 'stale, another template now, running',   { config => $CLOBBER, active => 1, tmpl => $BASE }, 'restart', 'restart', qr/bare config\.toml\.tmpl, which another template has replaced since; restarting \S+ so it renders that one/ ],
  [ 'stale, another template now, not running', { config => $CLOBBER, active => 0, tmpl => $BASE }, 'start', 'restart', undef ],
);

for my $c (@case) {
  my ( $name, $state, $rke2, $k3s, $warn ) = @$c;
  for my $dist (qw( rke2 k3s )) {
    %host = %$state;
    ( @log, @warn ) = ();
    my $d = $D->new_for($dist);
    is( $d->start_verb, $dist eq 'rke2' ? $rke2 : $k3s,
      $dist.', '.$name.': verb' );
    if ($warn) {
      is( scalar @warn, 1, $dist.', '.$name.': one warning' );
      like( $warn[0], $warn, $dist.', '.$name.': warning says what happens' );
      like( $warn[0], qr/\Q${\ $d->service }\E/, $dist.', '.$name.': names the service' );
    }
    else {
      is_deeply( \@warn, [], $dist.', '.$name.': no warning' );
    }
    like( ( grep { !/^systemctl show -p MainPID / } @log )[0],
      qr{^cat /var/lib/rancher/\Q$dist\E/agent/etc/containerd/config\.toml },
      $dist.', '.$name.': reads its own containerd dir' );
  }
}

# Wired into the start steps: server and agent, rke2 restarts once stale.
%host = ( config => $CLOBBER, active => 1 );
@log = ();
Rex::Rancher::Server::_install( $D->new_for('rke2'), undef, undef, 'script' );
is_deeply( [ grep { /^systemctl (?:start|restart)/ } @log ], [ 'systemctl restart --no-block rke2-server' ],
  'rke2 server, stale: restart --no-block' );

@log = ();
Rex::Rancher::Agent::_enable_service( $D->new_for( 'rke2', role => 'agent' ), 'https://cp:9345' );
is_deeply( [ grep { /^systemctl (?:start|restart)/ } @log ], [ 'systemctl restart --no-block rke2-agent.service' ],
  'rke2 agent, stale: restart --no-block' );

%host = ( config => $NATIVE, active => 1 );
@log = ();
Rex::Rancher::Agent::_enable_service( $D->new_for( 'rke2', role => 'agent' ), 'https://cp:9345' );
is_deeply( [ grep { /^systemctl (?:start|restart)/ } @log ], [ 'systemctl start --no-block rke2-agent.service' ],
  'rke2 agent, native config: start, a running agent is left alone' );

is_deeply( \@perl_warnings, [], 'no Perl warnings' );

done_testing;
