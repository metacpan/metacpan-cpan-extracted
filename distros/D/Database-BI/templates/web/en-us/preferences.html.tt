[%- WRAPPER 'web/en/layouts/default.html.tt' -%]
<style>
  .pref-section { max-width: 40rem; }
  .pref-section + .pref-section { margin-top: 2.5rem; }
  .pref-section h2 {
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
    color: var(--accent-text, #2c3e7a);
  }
  .pref-choices { border: 0; }
  .pref-choices legend { font-weight: 600; margin-bottom: 0.5rem; }
  .pref-choice {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.6rem 0.75rem;
    margin-bottom: 0.4rem;
    border: 1px solid var(--border, #dee2e6);
    border-radius: 6px;
    cursor: pointer;
  }
  .pref-choice:hover { background: var(--hover-bg, #eef1fb); }
  .pref-choice:has(input:checked) { border-color: var(--accent-border, #2c3e7a); }
  .pref-choice-hint {
    display: block;
    font-size: 0.82rem;
    color: var(--muted, #666);
  }
  .pref-note {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    color: var(--muted, #666);
  }
  .pref-status {
    margin-top: 0.75rem;
    min-height: 1.3em;
    font-size: 0.85rem;
    color: var(--danger-fg, #c0392b);
  }
</style>

<nav class="back-link" aria-label="Breadcrumb">[% PROCESS "web/en/layouts/breadcrumb.html.tt" %]</nav>

<section class="pref-section" aria-labelledby="pref-appearance">
  <h2 id="pref-appearance">Appearance</h2>
  <noscript><p class="hint">Changing the theme needs JavaScript, which is turned off in this browser.</p></noscript>
  <fieldset class="pref-choices">
    <legend>Theme</legend>
    <label class="pref-choice">
      <input type="radio" name="theme" value="system">
      <span>Same as this device
        <span class="pref-choice-hint">Light or dark, following the setting on your computer or phone.</span>
      </span>
    </label>
    <label class="pref-choice">
      <input type="radio" name="theme" value="light">
      <span>Light
        <span class="pref-choice-hint">Dark text on a pale background.</span>
      </span>
    </label>
    <label class="pref-choice">
      <input type="radio" name="theme" value="dark">
      <span>Dark
        <span class="pref-choice-hint">Pale text on a dark background.</span>
      </span>
    </label>
  </fieldset>
  <p class="pref-status" id="pref-status" role="status"></p>
  <p class="pref-note">Your choice is saved in this browser, and takes effect straight away.  Another
  browser or computer keeps its own.  Saved charts and printed pages always use the light colors,
  so that they look the same to whoever receives them.</p>
</section>

<section class="pref-section" aria-labelledby="pref-tables">
  <h2 id="pref-tables">Tables</h2>
  <noscript><p class="hint">Changing the number of rows needs JavaScript, which is turned off in this browser.</p></noscript>
  <p>[% PROCESS "web/en/layouts/page_size.html.tt" ps_id = 'pref-page-size' ps_mode = 'pref' %]</p>
  <p class="pref-status" id="pref-page-size-status" role="status"></p>
  <p class="pref-note">How many rows a table shows on each page, and how many rows a pivot shows.
  All puts every row on one page, which can be slow for a big file.  The Rows per page list under
  a table changes that page only.  Your choice is saved in this browser, in a cookie, from the next
  page you open.</p>
</section>

<script nonce="[% csp_nonce | html %]">
(function () {
  var COOKIE = '[% page_size_cookie | html %]';
  var sel    = document.getElementById('pref-page-size');
  var status = document.getElementById('pref-page-size-status');
  if (!sel) { return; }

  /* A year; Lax, so a link from another site still sends it; Secure over https. */
  function save(value) {
    document.cookie = COOKIE + '=' + encodeURIComponent(value) + '; path=/; max-age=31536000; SameSite=Lax'
      + (window.location.protocol === 'https:' ? '; Secure' : '');
    return document.cookie.split(/;\s*/).indexOf(COOKIE + '=' + value) >= 0;
  }

  sel.addEventListener('change', function () {
    status.textContent = save(sel.value)
      ? ''
      : 'This browser would not save your choice.';
  });
}());
</script>

<script nonce="[% csp_nonce | html %]">
(function () {
  var status = document.getElementById('pref-status');
  var radios = document.querySelectorAll('input[name="theme"]');

  function showCurrent() {
    var current = window.biTheme.get();
    radios.forEach(function (radio) { radio.checked = radio.value === current; });
  }

  radios.forEach(function (radio) {
    radio.addEventListener('change', function () {
      status.textContent = window.biTheme.set(radio.value)
        ? ''
        : 'This browser would not save your choice, so it applies to this page only.';
    });
  });

  showCurrent();

  /* Changed in another tab: show what is now in force. */
  window.addEventListener('storage', showCurrent);
}());
</script>
[%- END -%]
