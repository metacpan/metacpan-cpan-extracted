#!/usr/bin/env node
// Record what node's own built-ins do for the parts of them the loaders rely
// on, into t/data/node-builtins.json, which t/10-lib.t replays against the Lib
// seams (k19, ADR 0018):
//
//   path    -- path.resolve(...args), path.normalize(p), path.dirname(p), the
//              posix flavour (src/loader.js resolve, src/node-loaders.js
//              FileSystemLoader) -> Lib node_path_resolve / _normalize / _dirname
//   pathArgs -- the same three called with arguments that are no string, which
//              node's validateString refuses with ERR_INVALID_ARG_TYPE, a
//              TypeError whose message shows the value -> Lib
//              _node_validate_string / _node_determine_specific_type
//   utf8    -- fs.readFileSync(p, 'utf-8') of a byte string (FileSystemLoader
//              getSource) -> Lib _node_utf8_decode
//
//   maint/node-builtins-fixtures        # writes t/data/node-builtins.json
//
// It runs with the node it runs under and refuses any node but the pinned one,
// the oracle's: another node may resolve or decode differently, and the
// fixture would then pin the wrong platform. Bumping PINNED_NODE is a porting
// decision, like the upstream tag.
//
// Deterministic: a fixed-seed PRNG builds every input, and every input is
// stored. Path cases run with process.cwd() === '/' (t/10-lib.t replays them
// there), so a relative resolve() is anchored the same on both sides. A utf8
// case stores its bytes as hex and the decoded string as its code points. A
// pathArgs argument is JSON where JSON has the value (null, a number, a
// boolean, an array, an object) and a {"$": kind} tag where it has not:
// undefined, -0, NaN, Infinity, -Infinity, an anonymous function, and
// upstream's own SafeString, RegExp and keyword-arguments objects (from the
// pinned upstream's runtime); t/10-lib.t builds the port's value for each.
'use strict';

const fs = require('fs');
const os = require('os');
const path = require('path');

const PINNED_NODE = 'v24.19.0';

const root = path.join(__dirname, '..');
const outFile = path.join(root, 't', 'data', 'node-builtins.json');
const nunjucks = require(path.join(root, 'upstream', 'nunjucks', 'nunjucks', 'index.js'));

if (process.version !== PINNED_NODE) {
  process.stderr.write('node is ' + process.version + ', the fixtures pin ' + PINNED_NODE + '\n');
  process.exit(1);
}

// mulberry32, the input generator's PRNG (inputs are stored, so Perl never
// needs it).
function prng(seed) {
  let a = seed >>> 0;
  return function () {
    a = (a + 0x6D2B79F5) >>> 0;
    let t = a;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = prng(19);
const pick = (xs) => xs[Math.floor(rand() * xs.length)];

// Path strings: segments that exercise normalizeString's dot counting and its
// segment-length bookkeeping (non-ASCII and astral names, a backslash, which
// posix keeps as an ordinary character), joined by runs of separators.
const SEGMENTS = ['', '.', '..', '...', 'a', 'bc', 'def', '.a', 'a.', '..a', 'a..', '.a.', '...a',
  'é', '😀', '😀.', '.😀', 'a\\b', ' ', 'views', 'views2'];
const SEPARATORS = ['/', '/', '/', '//', '///'];

function randomPath() {
  let p = rand() < 0.4 ? pick(SEPARATORS) : '';
  const n = Math.floor(rand() * 6);
  for (let i = 0; i < n; i++) {
    p += pick(SEGMENTS);
    if (i < n - 1 || rand() < 0.3) {
      p += pick(SEPARATORS);
    }
  }
  return p;
}

const FIXED_PATHS = ['', '.', '..', '/', '//', '///', './', '../', '/..', '/../..', 'a/..', 'a/../..',
  '../a', './a/', 'a//b', '/a/b/', 'a/b/../../..', '..a/..', 'a../..', '😀/..', '😀😀/../x', 'é/./..',
  't/data/loader/views', './t/data//loader/./views2/../views/', 'views/sub/../d.njk'];

function pathCases() {
  const cases = [];
  const inputs = FIXED_PATHS.slice();
  for (let i = 0; i < 600; i++) {
    inputs.push(randomPath());
  }
  process.chdir('/');
  for (const p of inputs) {
    cases.push({fn: 'normalize', args: [p], result: path.normalize(p)});
    cases.push({fn: 'dirname', args: [p], result: path.dirname(p)});
  }
  const resolveInputs = [[], [''], ['.'], ['', ''], ['.', ''], ['/'], ['a', '/b', 'c'], ['/a', ''],
    ['/a/b/c', '../d.njk'], ['/views', '../views2/x.njk'], ['/a/b', '/']];
  for (let i = 0; i < 600; i++) {
    const n = 1 + Math.floor(rand() * 3);
    const args = [];
    for (let j = 0; j < n; j++) {
      args.push(randomPath());
    }
    resolveInputs.push(args);
  }
  for (const args of resolveInputs) {
    cases.push({fn: 'resolve', args: args, result: path.resolve(...args)});
  }
  return cases;
}

// Arguments that are no string, one of each kind the port models, and the
// objects whose own 'constructor' member determineSpecificType reads. An
// anonymous function held as an object member takes the member's name in JS
// ({'constructor': function () {}} -> 'an instance of constructor'); a Perl
// coderef has no name (k88), so that one is not pinned.
const TYPED_ARGS = [
  {$: 'undefined'}, null, 5, 1.5, 0, {$: '-0'}, {$: 'NaN'}, {$: 'Infinity'}, {$: '-Infinity'},
  1e21, true, false, [], [['x']], {}, {a: 1},
  {constructor: 0}, {constructor: null}, {constructor: ''}, {constructor: 1}, {constructor: 'x'},
  {constructor: true}, {constructor: {}}, {constructor: {name: 5}}, {constructor: {name: 'Foo'}},
  {constructor: {name: {}}}, {constructor: []},
  {$: 'function'}, {$: 'SafeString', value: 'views'}, {$: 'RegExp', source: 'a'},
  {$: 'KeywordArgs', value: {a: 1}},
];

function jsValue(arg) {
  if (arg === null || typeof arg !== 'object' || Array.isArray(arg) || arg.$ === undefined) {
    return arg;
  }
  switch (arg.$) {
    case 'undefined': return undefined;
    case '-0': return -0;
    case 'NaN': return NaN;
    case 'Infinity': return Infinity;
    case '-Infinity': return -Infinity;
    case 'function': return (() => function () {})();
    case 'SafeString': return new nunjucks.runtime.SafeString(arg.value);
    case 'RegExp': return new RegExp(arg.source);
    case 'KeywordArgs': return nunjucks.runtime.makeKeywordArgs(Object.assign({}, arg.value));
    default: throw new Error('unknown tag ' + arg.$);
  }
}

function pathArgCases() {
  const cases = [];
  const calls = (v) => [
    ['normalize', [v]], ['dirname', [v]], ['resolve', [v]], ['resolve', ['a', v]], ['resolve', [v, 'a']],
    ['resolve', [v, '/abs']],
  ];
  process.chdir('/');
  for (const arg of TYPED_ARGS) {
    for (const [fn, args] of calls(arg)) {
      const c = {fn: fn, args: args};
      try {
        c.result = path[fn](...args.map(jsValue));
      } catch (e) {
        c.error = {name: e.name, message: e.message};
      }
      cases.push(c);
    }
  }
  return cases;
}

// Byte strings: well-formed sequences of every length, their truncations, and
// the bytes the decoder must refuse (C0, C1, F5-FF, lone continuations, the
// E0 / ED / F0 / F4 second-byte boundaries).
const BYTE_PIECES = [
  [0x61], [0x7F], [0x00], [0xC2, 0xA9], [0xDF, 0xBF], [0xE2, 0x82, 0xAC], [0xE0, 0xA0, 0x80],
  [0xED, 0x9F, 0xBF], [0xEF, 0xBF, 0xBF], [0xF0, 0x90, 0x80, 0x80], [0xF0, 0x9F, 0x98, 0x80],
  [0xF4, 0x8F, 0xBF, 0xBF], [0xEF, 0xBB, 0xBF],
  [0x80], [0xBF], [0xC0], [0xC1], [0xC2], [0xE0], [0xE0, 0x80], [0xE0, 0x9F], [0xE0, 0xA0],
  [0xE2, 0x82], [0xED], [0xED, 0xA0], [0xED, 0xA0, 0x80], [0xED, 0xBF, 0xBF], [0xF0], [0xF0, 0x8F],
  [0xF0, 0x90], [0xF0, 0x9F, 0x98], [0xF4], [0xF4, 0x90], [0xF4, 0x8F, 0xBF], [0xF5], [0xF8], [0xFE],
  [0xFF], [0xC0, 0x80], [0xC1, 0xBF], [0xE0, 0x80, 0x80], [0xF0, 0x80, 0x80, 0x80],
  [0xF4, 0x90, 0x80, 0x80],
];

function utf8Cases() {
  const cases = [];
  const inputs = BYTE_PIECES.map((b) => b.slice());
  for (let i = 0; i < 800; i++) {
    const n = 1 + Math.floor(rand() * 6);
    let bytes = [];
    for (let j = 0; j < n; j++) {
      bytes = bytes.concat(pick(BYTE_PIECES));
    }
    inputs.push(bytes);
  }
  // Through readFileSync itself, the call FileSystemLoader makes.
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'node-builtins-fixtures-'));
  const file = path.join(dir, 'bytes');
  try {
    for (const bytes of inputs) {
      fs.writeFileSync(file, Buffer.from(bytes));
      const s = fs.readFileSync(file, 'utf-8');
      cases.push({hex: Buffer.from(bytes).toString('hex'), codepoints: Array.from(s, (c) => c.codePointAt(0))});
    }
  } finally {
    fs.rmSync(dir, {recursive: true, force: true});
  }
  return cases;
}

function main() {
  const out = {
    generator: 'maint/node-builtins-fixtures',
    node: process.version,
    path: pathCases(),
    pathArgs: pathArgCases(),
    utf8: utf8Cases(),
  };
  // One case per line: a regen diff stays readable.
  const lines = ['{"generator":' + JSON.stringify(out.generator) + ',"node":' + JSON.stringify(out.node) + ',"path":['];
  lines.push(out.path.map((c) => JSON.stringify(c)).join(',\n'));
  lines.push('],"pathArgs":[');
  lines.push(out.pathArgs.map((c) => JSON.stringify(c)).join(',\n'));
  lines.push('],"utf8":[');
  lines.push(out.utf8.map((c) => JSON.stringify(c)).join(',\n'));
  lines.push(']}');
  fs.writeFileSync(outFile, lines.join('\n') + '\n');
  process.stderr.write('wrote ' + path.relative(root, outFile) + ' (' + out.path.length + ' path, ' +
    out.pathArgs.length + ' pathArgs, ' + out.utf8.length + ' utf8 cases)\n');
}

main();
