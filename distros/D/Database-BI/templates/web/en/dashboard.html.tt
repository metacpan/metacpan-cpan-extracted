<script>
// ---------------------------------------------------------------------------
// Histogram panel
// ---------------------------------------------------------------------------
(function () {
  var btnOpen   = document.getElementById('btn-histogram');
  var panel     = document.getElementById('histogram-panel');
  if (!btnOpen || !panel) return;

  var btnCancel     = document.getElementById('btn-cancel-histogram');
  var btnDo         = document.getElementById('btn-do-histogram');
  var colSel        = document.getElementById('histogram-col-sel');
  var backInp       = document.getElementById('histogram-back-inp');
  var back2Inp      = document.getElementById('histogram-back2-inp');
  var back2LabelInp = document.getElementById('histogram-back2-label-inp');
  var histogramForm = document.getElementById('histogram-form');

  var otherPanels = ['join-panel', 'combine-panel', 'export-panel', 'graph-panel', 'pie-panel', 'heatmap-panel', 'bar-panel', 'stacked-panel', 'scatter-panel', 'combo-panel', 'treemap-panel', 'folder-panel', 'pivot-panel', 'calc-panel', 'groups-panel', 'dates-panel', 'save-analysis-panel', 'map-panel'].map(function (id) {
    return document.getElementById(id);
  }).filter(Boolean);

  function checkHistogram() {
    btnDo.disabled = !colSel.value;
  }

  // Populate col select with numeric-only columns.
  function buildHistogramColSelect() {
    var tbl = document.querySelector('table[data-table]') || document.querySelector('table');
    if (!tbl || !tbl.tHead || !tbl.tBodies[0]) return;
    var headers = Array.from(tbl.tHead.rows[0].cells);
    var rows    = Array.from(tbl.tBodies[0].rows);
    var prev    = colSel.value;
    while (colSel.options.length > 1) colSel.remove(1);
    headers.forEach(function (th, idx) {
      var name = th.textContent.trim();
      var vals = rows.map(function (r) {
        return r.cells[idx] ? r.cells[idx].textContent.trim() : '';
      }).filter(function (v) { return v !== ''; });
      if (vals.length === 0) return;
      if (vals.every(function (v) {
        return /^\d{4}-\d{2}-\d{2}$/.test(v) || /^\d{1,2}\/\d{1,2}\/\d{4}$/.test(v);
      })) return;
      if (!vals.every(function (v) { return v === '' || !isNaN(parseAccounting(v)); })) return;
      var opt = document.createElement('option');
      opt.value = name; opt.textContent = name;
      if (name === prev) opt.selected = true;
      colSel.appendChild(opt);
    });
    var n = colSel.options.length - 1;
    if (n === 0) {
      btnOpen.disabled = true;
      btnOpen.title    = 'Histogram needs a numeric column';
    }
    return n;
  }

  (function initHistogramBtn() {
    var n = buildHistogramColSelect();
    if (!n) {
      btnOpen.disabled = true;
      btnOpen.title    = 'Histogram needs a numeric column';
    }
  }());

  btnOpen.addEventListener('click', function () {
    otherPanels.forEach(function (p) { p.hidden = true; });
    backInp.value = window.location.href;
    if (back2Inp && histogramForm) {
      var pb = histogramForm.getAttribute('data-parent-back') || '';
      back2Inp.value = pb;
      if (back2LabelInp) back2LabelInp.value = pb ? (histogramForm.getAttribute('data-parent-back-label') || '') : '';
    }
    buildHistogramColSelect();
    panel.hidden = !panel.hidden;
    checkHistogram();
  });

  btnCancel && btnCancel.addEventListener('click', function () {
    panel.hidden = true;
  });

  colSel.addEventListener('change', checkHistogram);
}());
</script>

<script>
// ---------------------------------------------------------------------------
// Map panel
// ---------------------------------------------------------------------------
(function () {
  var btnOpen   = document.getElementById('btn-map');
  var panel     = document.getElementById('map-panel');
  if (!btnOpen || !panel) return;

  var btnCancel     = document.getElementById('btn-cancel-map');
  var btnDo         = document.getElementById('btn-do-map');
  var modeSel       = document.getElementById('map-mode-sel');
  var latSel        = document.getElementById('map-lat-sel');
  var lonSel        = document.getElementById('map-lon-sel');
  var locSel        = document.getElementById('map-loc-sel');
  var latField      = document.getElementById('map-lat-field');
  var lonField      = document.getElementById('map-lon-field');
  var locField      = document.getElementById('map-loc-field');
  var backInp       = document.getElementById('map-back-inp');
  var back2Inp      = document.getElementById('map-back2-inp');
  var back2LabelInp = document.getElementById('map-back2-label-inp');
  var mapForm       = document.getElementById('map-form');

  var otherPanels = ['join-panel', 'combine-panel', 'export-panel', 'graph-panel', 'pie-panel', 'heatmap-panel', 'bar-panel', 'stacked-panel', 'scatter-panel', 'combo-panel', 'treemap-panel', 'histogram-panel', 'folder-panel', 'pivot-panel', 'calc-panel', 'groups-panel', 'dates-panel', 'save-analysis-panel'].map(function (id) {
    return document.getElementById(id);
  }).filter(Boolean);

  function byLocation() {
    return modeSel.value === 'loc';
  }

  function checkMap() {
    if (byLocation()) {
      btnDo.disabled = !locSel.value;
    } else {
      btnDo.disabled = !(latSel.value && lonSel.value && latSel.value !== lonSel.value);
    }
  }

  // A disabled control is not submitted, so switching mode sends only the
  // column that the chosen way of placing a row uses.
  function syncMode() {
    var loc = byLocation();
    latField.hidden = loc;
    lonField.hidden = loc;
    locField.hidden = !loc;
    latSel.disabled = loc;
    lonSel.disabled = loc;
    locSel.disabled = !loc;
    latSel.required = !loc;
    lonSel.required = !loc;
    locSel.required = loc;
    checkMap();
  }

  function guess(sel, patterns) {
    var names = Array.from(sel.options).map(function (o) { return o.value; }).filter(Boolean);
    for (var i = 0; i < patterns.length; i++) {
      for (var j = 0; j < names.length; j++) {
        if (patterns[i].test(names[j])) return names[j];
      }
    }
    return '';
  }

  // Pick the obvious columns when the table has them, and leave the choice
  // alone once the user has made it.
  function guessColumns() {
    if (!latSel.value) latSel.value = guess(latSel, [/^(lat|latitude)$/i, /lat/i]);
    if (!lonSel.value) lonSel.value = guess(lonSel, [/^(lon|lng|long|longitude)$/i, /(lon|lng|longitude)/i]);
    if (!locSel.value) locSel.value = guess(locSel, [/^(loc|location|place|city|town|address)$/i, /(place|location|city|address)/i]);
    if (!latSel.value || !lonSel.value) {
      if (locSel.value) modeSel.value = 'loc';
    }
  }

  btnOpen.addEventListener('click', function () {
    otherPanels.forEach(function (p) { p.hidden = true; });
    backInp.value = window.location.href;
    if (back2Inp && mapForm) {
      var pb = mapForm.getAttribute('data-parent-back') || '';
      back2Inp.value = pb;
      if (back2LabelInp) back2LabelInp.value = pb ? (mapForm.getAttribute('data-parent-back-label') || '') : '';
    }
    guessColumns();
    buildColorSelect();
    panel.hidden = !panel.hidden;
    syncMode();
    if (!panel.hidden) modeSel.focus();
  });

  btnCancel && btnCancel.addEventListener('click', function () {
    panel.hidden = true;
  });

  modeSel.addEventListener('change', syncMode);
  latSel.addEventListener('change', checkMap);
  lonSel.addEventListener('change', checkMap);
  locSel.addEventListener('change', checkMap);

  // --- Colour-coding controls ---
  function isMapDateVal(v) {
    return /^\d{4}-\d{2}-\d{2}$/.test(v) || /^\d{1,2}\/\d{1,2}\/\d{4}$/.test(v);
  }

  function buildColorSelect() {
    if (!colorSel) return;
    var tbl  = document.querySelector('table[data-table]') || document.querySelector('table');
    if (!tbl || !tbl.tHead || !tbl.tBodies[0]) return;
    var headers = Array.from(tbl.tHead.rows[0].cells);
    var rows    = Array.from(tbl.tBodies[0].rows);
    var prev    = colorSel.value;
    while (colorSel.options.length > 1) colorSel.remove(1);
    headers.forEach(function (th, idx) {
      var name = th.textContent.trim();
      if (!name) return;
      var vals = rows.map(function (r) {
        return r.cells[idx] ? r.cells[idx].textContent.trim() : '';
      }).filter(function (v) { return v !== ''; });
      if (vals.length === 0) return;
      if (vals.every(isMapDateVal)) return;
      if (!vals.every(function (v) { return !isNaN(parseAccounting(v)); })) return;
      var opt = document.createElement('option');
      opt.value = name; opt.textContent = name;
      if (name === prev) opt.selected = true;
      colorSel.appendChild(opt);
    });
    colorSel.style.width = 'auto';
  }

  var colorSel          = document.getElementById('map-color-sel');
  var colorDefaultInp   = document.getElementById('map-color-default-inp');
  var colorDefaultField = document.getElementById('map-color-default-field');
  var colorRulesDiv     = document.getElementById('map-color-rules');
  var colorRuleRows     = document.getElementById('map-rule-rows');
  var btnAddRule        = document.getElementById('btn-add-map-rule');

  var COLOR_OPS = [
    ['gt', '> greater than'],
    ['ge', '>= at least'],
    ['lt', '< less than'],
    ['le', '<= at most'],
    ['eq', '= equals'],
    ['ne', '!= not equals']
  ];

  function toggleColorSection() {
    var active = colorSel.value !== '';
    colorDefaultField.hidden = !active;
    colorRulesDiv.hidden = !active;
  }

  function addColorRule() {
    var row = document.createElement('div');
    row.className = 'filter-row';

    var opSel = document.createElement('select');
    opSel.className = 'filter-op-sel';
    COLOR_OPS.forEach(function (pair) {
      var opt = document.createElement('option');
      opt.value = pair[0]; opt.textContent = pair[1];
      opSel.appendChild(opt);
    });

    var threshInp = document.createElement('input');
    threshInp.type = 'text';
    threshInp.className = 'filter-val-inp';
    threshInp.placeholder = 'threshold';

    var colorInp = document.createElement('input');
    colorInp.type = 'text';
    colorInp.className = 'filter-val-inp';
    colorInp.placeholder = 'colour (e.g. red, #ff0000)';
    colorInp.style.width = '12em';

    var rmBtn = document.createElement('button');
    rmBtn.type = 'button';
    rmBtn.className = 'btn-remove-filter';
    rmBtn.textContent = 'x';
    rmBtn.addEventListener('click', function () { row.remove(); });

    row.appendChild(opSel);
    row.appendChild(threshInp);
    row.appendChild(colorInp);
    row.appendChild(rmBtn);
    colorRuleRows.appendChild(row);
  }

  btnAddRule && btnAddRule.addEventListener('click', addColorRule);
  colorSel && colorSel.addEventListener('change', toggleColorSection);

  mapForm.addEventListener('submit', function () {
    var col = colorSel ? colorSel.value : '';
    if (!col) return;
    function addHidden(nm, val) {
      var inp = document.createElement('input');
      inp.type = 'hidden'; inp.name = nm; inp.value = val;
      mapForm.appendChild(inp);
    }
    addHidden('color', col);
    var def = colorDefaultInp ? colorDefaultInp.value.trim() : '';
    if (def) addHidden('color_default', def);
    if (colorRuleRows) {
      colorRuleRows.querySelectorAll('.filter-row').forEach(function (row) {
        var sels = row.querySelectorAll('select');
        var inps = row.querySelectorAll('input');
        var op     = sels[0] ? sels[0].value : 'gt';
        var thresh = inps[0] ? inps[0].value.trim() : '';
        var clr    = inps[1] ? inps[1].value.trim() : '';
        if (thresh && clr) addHidden('color_rule', op + ':' + thresh + ':' + clr);
      });
    }
  });

  syncMode();
}());
</script>

<script>
