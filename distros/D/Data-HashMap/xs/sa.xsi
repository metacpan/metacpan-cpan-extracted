MODULE = Data::HashMap    PACKAGE = Data::HashMap::SA
PROTOTYPES: DISABLE

SV*
new(char* class, ...)
    CODE:
        EXTRACT_NEW_ARGS_SV(_max_size, _ttl, _lru_skip);
        HashMapSA* map = hashmap_sa_create(_max_size, _ttl, _lru_skip);
        if (!map) croak("Failed to create HashMap::SA");
        map->free_value_fn = hm_sv_free;
        map->free_value_now_fn = hm_sv_free_now;
        map->copy_values = items > 4 && SvTRUE(ST(4));
        RETVAL = sv_setref_pv(newSV(0), class, (void*)map);
    OUTPUT:
        RETVAL

void
DESTROY(SV* self_sv)
    CODE:
        HM_DESTROY(HashMapSA, hashmap_sa_destroy, self_sv);

bool
put(SV* self_sv, SV* key_sv, SV* value)
    CODE:
        EXTRACT_MAP(HashMapSA, stash_sa, "Data::HashMap::SA", self_sv);
        SvGETMAGIC(value);
        EXTRACT_STR_KEY(key_sv);
        value = HM_STORE_SV(self, value, hm_copy_nomg(aTHX_ value));
        RETVAL = hashmap_sa_put(self, _kstr, (uint32_t)_klen, _khash, _kutf8, (void*)value, 0);
        if (!RETVAL) SvREFCNT_dec(value);
    OUTPUT:
        RETVAL

