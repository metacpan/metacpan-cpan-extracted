#!/usr/bin/env perl

# Thin wrapper: everything, including error reporting and the exit code,
# lives in App::FileSync::CLI so it can be tested without a subprocess.

use strict;
use warnings;
use autodie qw(:all);

use FindBin qw($Bin);

# A checkout's lib/ first, so bin/ runs the code beside it; an installed
# copy finds the modules on @INC as usual.
use lib "$Bin/../lib";

use App::FileSync::Platform;
use App::FileSync::CLI;

exit App::FileSync::CLI::run_server(@ARGV);

__END__

=head1 NAME

filesync-server - serve one sync session (the forced command in authorized_keys)

=head1 SYNOPSIS

	command="filesync-server --repo docs --client laptop --role client" ssh-ed25519 AAAA...

It is not run by hand: sshd starts it with the arguments pinned in F<authorized_keys>.

=head1 DESCRIPTION

See L<App::FileSync::CLI> and L<App::FileSync>.

