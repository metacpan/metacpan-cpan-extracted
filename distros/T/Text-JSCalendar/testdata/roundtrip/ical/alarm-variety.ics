BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Example//Roundtrip fixtures//EN
BEGIN:VEVENT
UID:alarm-variety@example.com
DTSTAMP:20250101T000000Z
DTSTART:20250310T090000Z
DTEND:20250310T100000Z
SUMMARY:Alarms of every kind
ORGANIZER;CN=Boss:mailto:boss@example.com
ATTENDEE;CN=Boss;PARTSTAT=ACCEPTED:mailto:boss@example.com
BEGIN:VALARM
UID:audio
ACTION:AUDIO
TRIGGER:-PT5M
END:VALARM
BEGIN:VALARM
UID:email
ACTION:EMAIL
SUMMARY:Reminder
DESCRIPTION:Reminder
ATTENDEE:mailto:boss@example.com
TRIGGER:-P1DT2H
END:VALARM
BEGIN:VALARM
X-WR-ALARMUID:legacy-uid
ACTION:DISPLAY
DESCRIPTION:After the end
TRIGGER;RELATED=END:PT30M
END:VALARM
BEGIN:VALARM
UID:absolute-acked
ACTION:DISPLAY
DESCRIPTION:Absolute
TRIGGER;VALUE=DATE-TIME:20250309T180000Z
ACKNOWLEDGED:20250309T180100Z
END:VALARM
BEGIN:VALARM
UID:no-uid-fallback-is-hashed
ACTION:DISPLAY
DESCRIPTION:Plain
TRIGGER;RELATED=START:PT0S
END:VALARM
END:VEVENT
BEGIN:VTODO
UID:todo-alarm@example.com
DTSTAMP:20250101T000000Z
DTSTART;TZID=Europe/Berlin:20250301T090000
DUE;TZID=Europe/Berlin:20250305T170000
SUMMARY:Task with alarms
STATUS:IN-PROCESS
PERCENT-COMPLETE:50
BEGIN:VALARM
UID:todo-due
ACTION:DISPLAY
DESCRIPTION:Due in an hour
TRIGGER;RELATED=END:-PT1H
END:VALARM
END:VTODO
END:VCALENDAR
