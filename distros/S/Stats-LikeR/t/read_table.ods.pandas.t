#!/usr/bin/env perl

# read_table() of an OpenDocument spreadsheet (.ods), from pandas' own tests
# of its odf reader.
#
# Provenance: pandas 3.0.4, installed at
# /home/con/.pyenv/versions/3.14.2/lib/python3.14/site-packages/pandas; the
# reader is pandas/io/excel/_odfreader.py, the tests:
#   tests/io/excel/test_odf.py
#     test_read_invalid_types_raises       invalid_value_type.ods
#     test_read_newlines_between_xml_elements_table (GH#45598)  test_newlines.ods
#     test_read_unempty_cells              test_unempty_cells.ods
#     test_read_cell_annotation            test_cell_annotation.ods
#   tests/io/excel/test_readers.py, run there for .ods with engine="odf"
#     test_excel_stop_iterator             test2.ods
#     test_excel_cell_error_na             test3.ods
#     test_reader_special_dtypes           test_types.ods
#     test_reader_dtype (GH 8212), test_reader_dtype_str (gh-20377)  testdtype.ods
#     test_reader_spaces (gh-32207)        test_spaces.ods
#     test_read_excel_ods_nested_xml (gh-35802, gh-36122)  gh-35802.ods, gh-36122.ods
#     test_reading_all_sheets (PR #9450), test_reading_multiple_specific_sheets
#                                          test_multisheet.ods
#     test_reading_all_sheets_with_blank (#11711), test_read_excel_blank (GH6403),
#     test_read_excel_blank_with_header, test_bad_sheetname_raises
#                                          blank.ods, blank_with_header.ods
#     test_trailing_blanks                 trailing_blanks.ods
#     test_one_col_noskip_blank_line (GH 39808)  one_col_blank_line.ods
#     test_reader_seconds (GH5945, GH 55045)  times_1900.ods, times_1904.ods
# test1.ods, testskiprows.ods and test_decimal.ods are read in
# t/read_table.skiprows.pandas.t.
#
# The workbooks are pandas' own (pandas/tests/io/data/excel/ at the git tag
# v3.0.4), which pandas' wheel does not ship.  Their content.xml, the only part
# read_table reads, less its styles, is in __DATA__ byte for byte, written by
# t/read_table.pandas.fixtures.pl, which says how to re-run it; this test never
# runs it.  Its file list for this test:
#   test_spaces.ods gh-35802.ods gh-36122.ods test_newlines.ods
#   test_unempty_cells.ods test_cell_annotation.ods test2.ods test3.ods
#   test_types.ods testdtype.ods blank.ods blank_with_header.ods
#   trailing_blanks.ods one_col_blank_line.ods times_1900.ods times_1904.ods
#   invalid_value_type.ods test_multisheet.ods
#
# What pandas returns as a Timestamp, a time, a bool or a float is compared as
# read_table returns it: a date is its office:date-value text, a time the text
# the cell shows (as pandas reads a time: LibreOffice's office:time-value drops
# the fraction, PT2H45M56S for 02:45:56.100), a boolean 1 or 0, as an .xlsx's
# boolean cell reads, and a number the text office:value holds.  A float is
# compared numerically, within 2**-52 relative: LibreOffice writes a double's
# 17-digit rendering (5.0000000000000003E-10 for 5e-10), which a long-double or
# quadmath perl reads as a number that close to the literal and no closer.
#
# Where read_table() is not pandas, on purpose:
#   - an error value (#N/A) is the cell's text, as an .xlsx's error cell is;
#     pandas returns NaN for #N/A, and na_strings => '#N/A' gives the same;
#   - text such as "001" stays text where pandas' type inference makes it 1
#     (S_text_is_iv() in LikeR.xs: an integer is stored as a number only when
#     its text is the number's own spelling);
#   - colClasses 'integer' takes an empty cell as undef, as R's NA, where
#     pandas raises "Unable to convert column d to type int64";
#   - pandas' header is a frame's columns, so a header-only sheet is an empty
#     frame with columns; read_table's aoa keeps the header row, and an aoh is [];
#   - a workbook of several sheets comes back as a hash, without pandas'
#     sheet order, and 'sheet' takes one name or a 1-based position, so
#     pandas' sheet_name=[2, "Charlie", "Charlie"] is read one sheet at a time;
#   - writertable.odt (test_read_writer_table) is a text document, which
#     read_table does not read.

require 5.010;
use strict;
use warnings FATAL => 'all';
use File::Temp 'tempdir';
use Test::More;
use Stats::LikeR 'read_table';

no warnings 'once';	# $IO::Compress::Zip::ZipError is read, never assigned
plan skip_all => 'IO::Compress::Zip (core) is not installed'
	unless eval { require IO::Compress::Zip; 1 };
my $dir = tempdir(CLEANUP => 1);

my %fixture;	# file => content.xml
{
	local $/;
	binmode DATA;
	my @chunk = split /^=== (\S+) ([^\n]*)\n/m, <DATA>;
	shift @chunk;
	while (my ($file, $part, $bytes) = splice @chunk, 0, 3) {
		$bytes =~ s/\n\z//;
		die "$file: unexpected part $part" unless $part eq 'content.xml';
		$fixture{$file} = $bytes;
	}
}

sub ods {	# the workbook, rebuilt: its mimetype first, as OpenDocument 1.2 part 3, 3.3 asks
	my ($name) = @_;
	my $path = "$dir/$name";
	return $path if -e $path;
	my $z = IO::Compress::Zip->new($path, Name => 'mimetype')
		or die "cannot create $path: $IO::Compress::Zip::ZipError";
	$z->print('application/vnd.oasis.opendocument.spreadsheet');
	$z->newStream(Name => 'content.xml') or die "newStream failed: $IO::Compress::Zip::ZipError";
	$z->print($fixture{$name} // die "no fixture $name");
	$z->close;
	return $path;
}
sub aoa { read_table(ods(shift), output_type => 'aoa', @_) }
sub close_to {	# within 2**-52 relative: see the header
	my ($got, $want, $name) = @_;
	my @bad = grep { !(defined $got->[$_] && abs($got->[$_] - $want->[$_]) <= 2**-52 * abs($want->[$_])) }
		0 .. $#$want;
	ok(@$got == @$want && !@bad, $name)
		or diag "got (@{[ map { $_ // 'undef' } @$got ]}), want (@$want)";
}
sub col {	# column $c of an aoa, without its header
	my ($aoa, $c) = @_;
	return [ map { $_->[$c] } @$aoa[1 .. $#$aoa] ];
}

# test_odf.py
ok(!eval { aoa('invalid_value_type.ods'); 1 } && $@ =~ /value-type 'awesome_new_type'/,
	'test_read_invalid_types_raises: an unknown office:value-type dies naming it') or diag $@;
is_deeply(aoa('test_newlines.ods'),
	[['Column 1', 'Column 2', 'Column 3'], [1, 4, 7], [undef, undef, 8], [3, 6, 9]],
	'test_read_newlines_between_xml_elements_table: the white space between elements is no text');
is_deeply(aoa('test_unempty_cells.ods'), [['Column 1'], [1], [undef], [3], [undef], [5]],
	'test_read_unempty_cells: a number is office:value, with no text in the cell');
{
	my $want = [['Column 1'], ['test'], [undef], ['test 3']];
	is_deeply(aoa('test_cell_annotation.ods'), $want,
		'test_read_cell_annotation: a comment on a cell is not its text');
	is_deeply(aoa('test_cell_annotation.ods', sheet => "\x{41b}\x{438}\x{441}\x{442}1"), $want,
		'... and the sheet is found by its name, Cyrillic characters');
}

# test_readers.py
is_deeply(read_table(ods('test2.ods'), sheet => 'Sheet1'), [{ Test => 'aaaa', Test1 => 'bbbbb' }],
	'test_excel_stop_iterator');
is_deeply(aoa('test3.ods', sheet => 'Sheet1'), [['Test'], ['#N/A']],
	'test_excel_cell_error_na: a formula\'s error is its text');
is_deeply(aoa('test3.ods', sheet => 'Sheet1', na_strings => '#N/A'), [['Test'], [undef]],
	'... which na_strings makes the NaN pandas returns');

{
	my $t = aoa('test_types.ods', sheet => 'Sheet1');
	is_deeply($t->[0], [qw(IntCol FloatCol BoolCol StrCol Str2Col DateCol)], 'test_reader_special_dtypes: header');
	is_deeply(col($t, 0), [1, 2, -3, 4, 0], '... IntCol');
	close_to(col($t, 1), [1.25, 2.25, 1.83, 1.92, 0.0000000005], '... FloatCol');
	is_deeply(col($t, 2), [1, 0, 1, 1, 0], '... BoolCol, True and False as 1 and 0');
	is_deeply(col($t, 3), [1, 2, 3, 4, 5], '... StrCol');
	is_deeply(col($t, 4), ['a', 3, 'c', 'd', 'e'], '... Str2Col');
	is_deeply(col($t, 5), [map { "${_}T00:00:00" } qw(2013-10-30 2013-10-31 1905-01-01 2013-12-14 2015-03-14)],
		'... DateCol, as office:date-value');
	my $h = read_table(ods('test_types.ods'), sheet => 'Sheet1', output_type => 'hoh', row_names => 'IntCol');
	is_deeply([ sort { $a <=> $b } keys %$h ], [-3, 0, 1, 2, 4], '... index_col=IntCol as a hoh');
	is($h->{-3}{Str2Col}, 'c', '... whose rows are the right ones');
	is_deeply(col(aoa('test_types.ods', sheet => 'Sheet1', colClasses => { StrCol => 'character' }), 3),
		[1 .. 5], '... converters={"StrCol": str} as colClasses character');
}

{
	my $want = [[qw(a b c d)], [1, '2.5', '001', 1], [2, '3.5', '002', 2], [3, '4.5', '003', undef],
		[4, '5.5', '004', 4]];
	is_deeply(aoa('testdtype.ods'), $want, 'test_reader_dtype: no dtype ("001" stays text; see the header)');
	my $c = aoa('testdtype.ods', colClasses => { a => 'numeric', b => 'numeric', c => 'character', d => 'character' });
	is_deeply(col($c, 2), [qw(001 002 003 004)], '... dtype c=str, as colClasses character');
	is_deeply(col($c, 3), [1, 2, undef, 4], '... dtype d=str keeps the empty cell empty');
	close_to(col($c, 1), [2.5, 3.5, 4.5, 5.5], '... dtype b=float32, as colClasses numeric');
	is_deeply(col(aoa('testdtype.ods', colClasses => { d => 'integer' }), 3), [1, 2, undef, 4],
		'... dtype d=int64 with an empty cell is an undef, not pandas\' ValueError');
}

is_deeply(aoa('test_spaces.ods'),
	[['testcol'], ['this is great'], ['4    spaces'], ['1 trailing '], [' 1 leading'],
	 ['2  spaces  multiple  times']],
	'test_reader_spaces: <text:s>, and the white-space rule');
is_deeply(aoa('gh-35802.ods'), [['COLUMN'], ['Test (1)']],
	'test_read_excel_ods_nested_xml, gh-35802: text after a <text:span>');
is_deeply(aoa('gh-36122.ods'), [['got 2nd sa']],
	'... gh-36122: a <text:span> inside a word, in a header with no rows');
is_deeply(read_table(ods('gh-36122.ods')), [], '... which as an aoh is []');

{
	my $book = read_table(ods('test_multisheet.ods'));
	is_deeply([ sort keys %$book ], [qw(Alpha Beta Charlie)], 'test_reading_all_sheets: every sheet, by name');
	is_deeply(aoa('test_multisheet.ods', sheet => 1), aoa('test_multisheet.ods', sheet => 'Charlie'),
		'... the first sheet in the file is Charlie (pandas checks the order)');
	is_deeply(aoa('test_multisheet.ods', sheet => 3), aoa('test_multisheet.ods', sheet => 'Beta'),
		'test_reading_multiple_specific_sheets: pandas\' sheet 2 is the 1-based 3, Beta');
	is_deeply($book->{Charlie}[0], { date => '2014-03-15T00:00:00', H1 => 10, H2 => 11, H3 => 12 },
		'... Charlie\'s first row: a date and three formula results, as office:value');
	is_deeply([ map { $_->{date} } @{ $book->{Alpha} } ], [ map { "2014-01-0${_}T00:00:00" } 1 .. 6 ],
		'... Alpha\'s dates');
}

is_deeply([ sort keys %{ read_table(ods('blank_with_header.ods')) } ], [qw(Sheet1 Sheet2 Sheet3)],
	'test_reading_all_sheets_with_blank');
is_deeply(aoa('blank.ods', sheet => 'Sheet1'), [], 'test_read_excel_blank: a blank sheet is empty');
is_deeply(aoa('blank_with_header.ods', sheet => 'Sheet1'), [[qw(col_1 col_2)]],
	'test_read_excel_blank_with_header: the header and no rows');
ok(!eval { aoa('blank.ods', sheet => 'asdf'); 1 } && $@ =~ /sheet 'asdf' not found/,
	'test_bad_sheetname_raises: a name no sheet has') or diag $@;
ok(!eval { aoa('blank.ods', sheet => 4); 1 } && $@ =~ /sheet index 4 is out of range \(1\.\.3\)/,
	'test_bad_sheetname_raises: pandas\' index 3, the 1-based 4') or diag $@;
{
	my $t = aoa('trailing_blanks.ods');
	is_deeply([ scalar(@$t) - 1, scalar @{ $t->[0] } ], [3, 3],
		'test_trailing_blanks: shape (3, 3), whatever the empty cells and rows past it');
}
is_deeply(aoa('one_col_blank_line.ods'), [['numbers'], ['0.5'], [undef], [1], [2]],
	'test_one_col_noskip_blank_line: the blank row is a row of undef');
for my $f ('times_1900.ods', 'times_1904.ods') {
	is_deeply(aoa($f, sheet => 'Sheet1'),
		[['Time'], map { [$_] } qw(01:02:03.000 02:45:56.100 04:29:49.200 06:13:42.300 07:57:35.400
			09:41:28.500 11:25:21.600 13:09:14.700 14:53:07.800 16:37:00.900 18:20:54.000)],
		"test_reader_seconds, $f: each time as its text, fraction and all");
}

done_testing;

