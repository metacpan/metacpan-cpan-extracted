<?xml version="1.0" encoding="UTF-8"?>
<!-- The demo identity provider in ../IdP, saved, so this application
     can boot with nothing else running. Identical to what
     http://127.0.0.1:5001/idp/metadata serves. -->
<md:EntityDescriptor xmlns:md="urn:oasis:names:tc:SAML:2.0:metadata"
    xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
    entityID="http://127.0.0.1:5001/idp/metadata">
  <md:IDPSSODescriptor protocolSupportEnumeration="urn:oasis:names:tc:SAML:2.0:protocol">
    <md:KeyDescriptor use="signing"><ds:KeyInfo><ds:X509Data>
      <ds:X509Certificate></ds:X509Certificate>
    </ds:X509Data></ds:KeyInfo></md:KeyDescriptor>
    <md:NameIDFormat>urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress</md:NameIDFormat>
    <md:SingleSignOnService
        Binding="urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Redirect"
        Location="http://127.0.0.1:5001/idp/sso"/>
  </md:IDPSSODescriptor>
</md:EntityDescriptor>
