#!perl
use 5.010;
use strict;
use warnings;
use File::Find ();
use Test::More;

# WRITTEN WITHOUT Test::CheckManifest ON PURPOSE.
#
# The stock Module::Starter version of this file is guarded twice, once on
# RELEASE_TESTING and once on whether Test::CheckManifest is installed, and the
# second guard is the problem: on a machine without that module the file plans
# skip_all and reports PASS. It is not that the check is skipped loudly; it is
# that a green suite looks IDENTICAL whether the check ran or not.
#
# Game-Dominoes shipped exactly this file and it had never once executed. It was
# only found when a module was left out of MANIFEST and `make disttest`, not the
# suite, caught it. Game-Gin carried the same dead file for three phases.

unless ($ENV{RELEASE_TESTING}) {
	plan(skip_all => 'Author tests not required for installation');
}

my @SKIP_DIRS  = qw(blib _build .git cover_db);
# META.json and META.yml are generated by `make distmeta`, which also ADDS them
# to MANIFEST. So they have to be skipped on BOTH sides: skipping them only on
# the tree side made `make disttest` fail while `prove` passed, which is the
# most confusing shape a manifest failure can have.
my @SKIP_FILES = qw(MYMETA.json MYMETA.yml META.json META.yml Makefile
                    Makefile.old pm_to_blib README.bak);

my %skip_file = map { $_ => 1 } @SKIP_FILES;

my @tree;
File::Find::find({
	no_chdir => 1,
	preprocess => sub {
		my %skip = map { $_ => 1 } @SKIP_DIRS;
		return grep { !$skip{$_} } @_;
	},
	wanted => sub {
		return if -d $File::Find::name;
		my $path = $File::Find::name;
		$path =~ s{\A\./}{};
		return if $skip_file{$path};
		return if $path =~ m{\AGame-Oware-};
		return if $path =~ m{\.tar\.gz\z};
		push @tree, $path;
	},
}, '.');

open my $fh, '<', 'MANIFEST' or BAIL_OUT('no MANIFEST');
my @manifest;
while (my $line = <$fh>) {
	chomp $line;
	next unless length $line;
	next if $line =~ /\A\s*#/;
	# MakeMaker writes a trailing comment after the filename, and s/\s.*\z//
	# will not strip it while the newline is still attached. Hence the chomp
	# above coming first.
	$line =~ s/\s.*\z//;
	next if $skip_file{$line};
	push @manifest, $line;
}
close $fh;

my %in_manifest = map { $_ => 1 } @manifest;
my %in_tree     = map { $_ => 1 } @tree;

plan tests => 3;

subtest 'everything in the tree is in MANIFEST' => sub {
	my @missing = sort grep { !$in_manifest{$_} } @tree;
	is_deeply(\@missing, [], 'nothing unshipped')
		or diag "not in MANIFEST:\n" . join "\n", @missing;
};

subtest 'everything in MANIFEST is in the tree' => sub {
	my @gone = sort grep { !$in_tree{$_} } @manifest;
	is_deeply(\@gone, [], 'nothing listed that is not there')
		or diag "in MANIFEST but not on disk:\n" . join "\n", @gone;
};

# The narrower check, because the two above can both pass while the thing that
# actually matters is wrong: it is a module or a test going missing that breaks
# a release, and those are worth naming separately.
subtest 'no module, test or program is unshipped' => sub {
	my @important = sort grep {
		m{\Alib/.*\.pm\z} || m{\At/.*\.t\z} || m{\Axt/.*\.t\z} || m{\Abin/}
	} @tree;

	my @missing = grep { !$in_manifest{$_} } @important;

	cmp_ok(scalar @important, '>=', 25, 'there are modules, tests and a program');
	is_deeply(\@missing, [], 'and every one of them ships')
		or diag "unshipped:\n" . join "\n", @missing;
};
