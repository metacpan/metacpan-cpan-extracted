  "visibility": {
    "why": "A private family is one built for a single customer. It must be ABSENT from a listing for an org that does not license it, not present with standing 'unlicensed' - the standing field is the discovery surface for public datasets only. The server enforces this; an SDK must not reconstruct a catalog from any other source and must not assume the listing is the same for every key. The private ids are deliberately NOT named here: this corpus is committed into twelve PUBLIC repositories, so naming them would publish the customer relationship the rule exists to keep private.",
    "clientRules": [
      "listing-is-returned-as-served",
      "no-catalog-is-compiled-into-the-client",
      "a-listing-is-never-reused-across-clients"
    ]
  },
  "oauth": {
    "why": "The public OAuth accessor. Arguments use the canonical parameter names; form fields and response members are WIRE names, mapped by each SDK exactly as it maps any other response. mslm:apikey_id and mslm:apikey surface as apikey_id and apikey.",
    "endpoints": {
      "metadata": {
        "method": "GET",
        "path": "/.well-known/oauth-authorization-server"
      },
      "deviceAuthorization": {
        "method": "POST",
        "path": "/oauth/device_authorization"
      },
      "token": {
        "method": "POST",
        "path": "/oauth/token"
      },
      "revoke": {
        "method": "POST",
        "path": "/oauth/revoke"
      }
    },
    "noCredential": {
      "why": "Build the client WITH this key, call every OAuth operation, and assert none of it leaves: no Authorization or X-Api-Key header, no apikey query parameter, and the key string nowhere in the URL, a header or the body.",
      "apiKey": "id_test_SECRET_must_not_leave",
      "forbiddenHeaders": [
        "authorization",
        "x-api-key"
      ],
      "forbiddenQuery": [
        "apikey"
      ]
    },
    "forms": {
      "why": "Decode the received body as application/x-www-form-urlencoded (+ is a space) and compare the field map EXACTLY: same keys, no extras, same values. Values carrying + & = % / space and non-ASCII catch an encoder that leaves any of them raw. Field order is not significant.",
      "contentType": "application/x-www-form-urlencoded",
