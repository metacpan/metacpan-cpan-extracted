{
  "schemaVersion": 1,
  "perlLibrary": "lib",
  "providers": {
    "cloudflare": {
      "module": "./cloudflare",
      "factory": "createWebDyneCloudflareExtension",
      "variants": [
        {
          "whenOption": "hyperdriveBindings",
          "module": "./hyperdrive",
          "factory": "createWebDyneHyperdriveExtension",
          "compatibilityFlags": ["nodejs_compat"]
        }
      ]
    }
  }
}
