[%- WRAPPER 'web/en/layouts/default.html.tt' -%]

<nav class="back-link" aria-label="Breadcrumb">[% PROCESS "web/en/layouts/breadcrumb.html.tt" %]</nav>

<h2 class="tables-heading">Tables in [% db_label | html %]</h2>

[%- IF tables.size %]
<div class="table-card-grid">
  [%- FOREACH t IN tables %]
  <a class="table-card" href="[% t.href | html %]">
    <div class="table-card-name">&#x1F4CB; [% t.name | html %]</div>
    <ul class="table-card-cols">
      [%- FOREACH col IN t.columns %]
      <li>[% col | html %]</li>
      [%- END %]
    </ul>
    <div class="table-card-open">Open table &rarr;</div>
  </a>
  [%- END %]
</div>
[%- ELSE %]
<p class="empty-state">No tables found in this database.</p>
[%- END %]

<style>
  .tables-heading {
    font-size: 1.25rem;
    font-weight: 600;
    color: #2c3e7a;
    margin-bottom: 1.25rem;
  }
  .table-card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
  }
  .table-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid #dce3f0;
    border-radius: 8px;
    padding: 1rem;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.15s, border-color 0.15s;
  }
  .table-card:hover {
    box-shadow: 0 4px 12px rgba(44,62,122,.15);
    border-color: #2c3e7a;
  }
  .table-card-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: #2c3e7a;
    margin-bottom: 0.6rem;
  }
  .table-card-cols {
    flex: 1;
    list-style: none;
    margin: 0 0 0.75rem 0;
    padding: 0;
    font-size: 0.82rem;
    color: #555;
  }
  .table-card-cols li {
    padding: 0.18rem 0;
    border-bottom: 1px solid #f0f0f0;
  }
  .table-card-cols li:last-child { border-bottom: none; }
  .table-card-open {
    font-size: 0.8rem;
    color: #2c3e7a;
    font-weight: 600;
    text-align: right;
    margin-top: auto;
  }
</style>

[%- END -%]
