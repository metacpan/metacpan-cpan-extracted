+// Shrinks the children in the buffer, the largest first, until sizeToDistribute (negative: the
+// overflow) is taken up or every child is at its minimum: minDimensions, or cutMinWidth with
+// toCutMinimum. Removes the children that reach their minimum from the buffer and returns what is
+// left of sizeToDistribute.
+float Clay__CompressContainersAlongAxis(Clay__int32_tArray *buffer, float sizeToDistribute, bool xAxis, bool toCutMinimum) {
+    Clay_Context* context = Clay_GetCurrentContext();
+    while (sizeToDistribute < -CLAY__EPSILON && buffer->length > 0) {
+        // Stops when a round changes nothing: at large sizes a float cannot take a small step.
+        float sizeBeforeRound = sizeToDistribute;
+        int32_t containersBeforeRound = buffer->length;
+        float largest = 0;
+        float secondLargest = 0;
+        float widthToAdd = sizeToDistribute;
+        for (int childIndex = 0; childIndex < buffer->length; childIndex++) {
+            Clay_LayoutElement *child = Clay_LayoutElementArray_Get(&context->layoutElements, Clay__int32_tArray_GetValue(buffer, childIndex));
+            float childSize = xAxis ? child->dimensions.width : child->dimensions.height;
+            if (Clay__FloatEqual(childSize, largest)) { continue; }
+            if (childSize > largest) {
+                secondLargest = largest;
+                largest = childSize;
+            }
+            if (childSize < largest) {
+                secondLargest = CLAY__MAX(secondLargest, childSize);
+                widthToAdd = secondLargest - largest;
+            }
+        }
+
+        widthToAdd = CLAY__MAX(widthToAdd, sizeToDistribute / buffer->length);
+
+        for (int childIndex = 0; childIndex < buffer->length; childIndex++) {
+            Clay_LayoutElement *child = Clay_LayoutElementArray_Get(&context->layoutElements, Clay__int32_tArray_GetValue(buffer, childIndex));
+            float *childSize = xAxis ? &child->dimensions.width : &child->dimensions.height;
+            float minSize = toCutMinimum ? child->cutMinWidth : xAxis ? child->minDimensions.width : child->minDimensions.height;
+            float previousWidth = *childSize;
+            if (Clay__FloatEqual(*childSize, largest)) {
+                *childSize += widthToAdd;
+                if (*childSize <= minSize) {
+                    *childSize = minSize;
+                    Clay__int32_tArray_RemoveSwapback(buffer, childIndex--);
+                }
+                sizeToDistribute -= (*childSize - previousWidth);
+            }
+        }
+        if (sizeToDistribute == sizeBeforeRound && buffer->length == containersBeforeRound) {
+            break;
+        }
+    }
+    return sizeToDistribute;
+}
