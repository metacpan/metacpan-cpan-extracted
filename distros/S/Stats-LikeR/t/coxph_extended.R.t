sub read_csv {
	my ($name, $sep) = @_;
	my $f = File::Spec->catfile('t', $name);
	my (%d, @c);
	open my $fh, '<', $f or die "cannot open $f: $!";
	if (defined $sep) {
		while (my $l = <$fh>) {
			$l =~ s/^\s+|\s+$//g;
			next unless length $l;
			my @v = split /\s+/, $l;
			@c = map { $_ < 3 ? (qw(time status entry))[$_] : 'x' . ($_ - 2) } 0 .. $#v unless @c;
			push @{ $d{ $c[$_] } }, $v[$_] + 0 for 0 .. $#v;
		}
	} else {
		my $h = <$fh>; $h =~ s/[\r\n"]+//g;
		@c = split /,/, $h;
		while (my $l = <$fh>) {
			$l =~ s/[\r\n]+//; $l =~ s/"//g;
			my @v = split /,/, $l;
			push @{ $d{ $c[$_] } }, ($v[$_] eq 'NA' ? undef : $v[$_]) for 0 .. $#c;
		}
	}
	return \%d;
}

