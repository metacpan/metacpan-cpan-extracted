#!perl
use 5.010;
use strict;
use warnings;
use ExtUtils::Manifest ();
use File::Find ();
use Test::More;

# WRITTEN WITHOUT Test::CheckManifest ON PURPOSE.
#
# The stock Module::Starter version of this file is guarded twice, once on
# RELEASE_TESTING and once on whether Test::CheckManifest is installed, and the
# second guard is the problem: on a machine without that module the file plans
# skip_all and reports PASS. A green suite looks IDENTICAL whether the check
# ran or not. Game-Dominoes shipped exactly that file and it had never once
# executed.

unless ($ENV{RELEASE_TESTING}) {
	plan(skip_all => 'Author tests not required for installation');
}

# WHAT IS NOT SHIPPED IS MANIFEST.SKIP'S TO SAY, AND ONLY ITS.
#
# This file used to carry its own @SKIP_FILES beside it, and the two drifted:
# MANIFEST.SKIP had ^MANIFEST\.bak$ and the list here did not, so the suite
# went red over a file the distribution had already declared unshipped. Two
# lists of the same thing is one list too many, and the one that is wrong is
# always the one nobody is looking at.
#
# ExtUtils::Manifest::maniskip compiles MANIFEST.SKIP into a predicate, which
# is what `make dist` itself uses, so this test and the tarball now agree by
# construction rather than by somebody remembering.
my @SKIP_DIRS = qw(blib _build .git cover_db Install);

# META.json and META.yml are generated by `make distmeta`, which also ADDS
# them to MANIFEST, so they are skipped on BOTH sides and are the only names
# this test still knows by heart.
my %skip_file = map { $_ => 1 } qw(META.json META.yml);

my $skip = ExtUtils::Manifest::maniskip();

my @tree;
File::Find::find({
	no_chdir => 1,
	preprocess => sub {
		my %skip_dir = map { $_ => 1 } @SKIP_DIRS;
		return grep { !$skip_dir{$_} } @_;
	},
	wanted => sub {
		return if -d $File::Find::name;
		my $path = $File::Find::name;
		$path =~ s{\A\./}{};
		return if $skip_file{$path};
		return if $skip->($path);
		push @tree, $path;
	},
}, '.');

open my $fh, '<', 'MANIFEST' or BAIL_OUT('no MANIFEST');
my @manifest;
while (my $line = <$fh>) {
	chomp $line;
	next unless length $line;
	next if $line =~ /\A\s*#/;
	$line =~ s/\s.*\z//;
	next if $skip_file{$line};
	next if $skip->($line);
	push @manifest, $line;
}
close $fh;

my %in_manifest = map { $_ => 1 } @manifest;
my %in_tree     = map { $_ => 1 } @tree;

plan tests => 3;

subtest 'everything in the tree is in MANIFEST' => sub {
	my @missing = sort grep { !$in_manifest{$_} } @tree;
	is_deeply(\@missing, [], 'nothing unshipped')
		or diag "not in MANIFEST:\n" . join "\n", @missing;
};

subtest 'everything in MANIFEST is in the tree' => sub {
	my @gone = sort grep { !$in_tree{$_} } @manifest;
	is_deeply(\@gone, [], 'nothing listed that is not there')
		or diag "in MANIFEST but not on disk:\n" . join "\n", @gone;
};

subtest 'no module, test, source or header is unshipped' => sub {
	my @important = sort grep {
		m{\Alib/.*\.pm\z} || m{\At/.*\.t\z} || m{\Axt/.*\.t\z} || m{\Abin/}
		|| m{\.(?:c|h|xs)\z}
	} @tree;

	my @missing = grep { !$in_manifest{$_} } @important;

	cmp_ok(scalar @important, '>=', 12, 'there are modules, tests and sources');
	is_deeply(\@missing, [], 'and every one of them ships')
		or diag "unshipped:\n" . join "\n", @missing;
};
