<?xml version="1.0"?>
<config>
	<pages>index, meta_data</pages>
	<memory_cache>
		<driver>Null</driver>
	</memory_cache>
	<SiteTitle>
		<English>Test</English>
		<Default>Test</Default>
	</SiteTitle>
	<twitter>yourtwitterhandle</twitter>
	<contact>
		<name>Your Name Goes Here</name>
		<email>you@example.com</email>
	</contact>
	<!--
	<disc_cache>
		<driver>DBI</driver>
		<connect>dbi:SQLite:dbname=/tmp/cache/genealogy.sqlite</connect>
	-->
	<disc_cache>
		<driver>File</driver>
		<root_dir>/var/tmp/cache</root_dir>
	</disc_cache>
	<!--
		Get keys from https://www.google.com/recaptcha/admin
	-->
	<recaptcha>
		<site_key>YOUR_SITE_KEY_HERE</site_key>
		<secret_key>YOUR_SECRET_KEY_HERE</secret_key>
		<enabled>1</enabled>
	</recaptcha>

	<!--
		DKIM signing for the mail the contact page sends.  That mail goes out as
		webmaster@<domain>, so the key must be published for the same domain:
		openssl genrsa -out 202611.private 2048, then the public half at
		202611._domainkey.<domain>.  Without both settings the mail is sent
		unsigned, which is what happened before signing was supported.
	-->
	<!--
	<DKIMSelector>202611</DKIMSelector>
	<DKIMKey>/home/site/dkim/202611.private</DKIMKey>
	-->

	<security>
		<rate_limiting>
			<!--  Hard limit - block completely -->
			<max_requests_hard>150</max_requests_hard>
			<!-- Soft limit - show CAPTCHA -->
			<max_requests>100</max_requests>
			<time_window>60s</time_window>
			<!-- 5 minutes after successful CAPTCHA -->
			<captcha_bypass_duration>300s</captcha_bypass_duration>
		</rate_limiting>
		<!-- CGI::IDS threshold -->
		<ids_threshold>50</ids_threshold>
		<csrf>
			<!-- Generate CSRF token for forms -->
			<enable>1</enable>
			<secret>default_secret</secret>
		</csrf>
	</security>
</config>
