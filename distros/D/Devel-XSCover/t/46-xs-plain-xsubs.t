my $xs = Devel::XSCover::XS->new(dir => "$dir");
my %by = map { $_->{c_name} => $_ } $xs->xsubs('Shape.c');
is_deeply($by{XS_Shape_plain}, { c_name => 'XS_Shape_plain', c_line => 25 }, 'an XSUB without a CODE section has no #line in its wrapper, so no file and no body line');
is_deeply($by{XS_Shape_fragged}, { c_name => 'XS_Shape_fragged', c_line => 112 }, 'nor does one in an INCLUDEd file');
is_deeply($by{XS_Shape_braced}, { c_name => 'XS_Shape_braced', c_line => 45, file => 'Shape.xs', body_line => 20 }, 'a PPCODE body opening with a brace has that brace as its body line');

my $map = $xs->map('Shape.c');
is_deeply($map->{files}, ['Shape.xs', 'frag.xs'], 'the xs and the fragment it INCLUDEs');
is_deeply($map->{xsubs}{XS_Shape_plain}, { c_name => 'XS_Shape_plain', c_line => 25, file => 'Shape.xs', body_line => undef, names => ['Shape::plain'], line => 13 },
    'the fallback by name finds the declaration and sets the file, with no body line to show for it');
is_deeply($map->{xsubs}{XS_Shape_oneline}, { c_name => 'XS_Shape_oneline', c_line => 67, file => 'Shape.xs', body_line => 27, names => ['Shape::oneline'], line => undef },
    'a declaration with its type on the same line is passed over, up through the braced body above it to another name, and the search by name misses it too');
is_deeply($map->{xsubs}{XS_Shape_topless}, { c_name => 'XS_Shape_topless', c_line => 91, file => 'frag.xs', body_line => 4, names => ['Shape::topless'], line => undef },
    'the scan off the top of a fragment with no MODULE line finds nothing');
is_deeply([ $xs->subroutines($map) ], [
    { c_name => 'XS_Shape_braced',  file => 'Shape.xs', line => 17, names => ['Shape::braced'] },
    { c_name => 'XS_Shape_fragged', file => 'frag.xs',  line => 9,  names => ['Shape::fragged'] },
    { c_name => 'XS_Shape_plain',   file => 'Shape.xs', line => 13, names => ['Shape::plain'] },
], 'three XSUBs are subroutines, two found by name, and the two without a line are left out');

is($xs->declaration_line('Shape.xs', 20), 17, 'without a name the nearest declaration above the body is taken');
is($xs->declaration_line('Shape.xs', 27, 'oneline'), undef, 'the scan past a one-line declaration stops at the declaration above it, which is another name');
is($xs->declaration_line('frag.xs', 4, 'topless'), undef, 'a scan that runs off the top of the file finds nothing');

is_deeply([ $xs->find_declaration(['Shape.xs', 'frag.xs'], 'Shape::fragged') ], ['frag.xs', 9], 'a fragment with no MODULE line answers for any package');
is_deeply([ $xs->find_declaration(['Shape.xs', 'frag.xs'], 'Other::braced') ], [], 'the same name under another PACKAGE is not it');
is_deeply([ $xs->find_declaration(['Shape.xs', 'frag.xs'], 'braced') ], [], 'a bare name is not found where a PACKAGE is in force');
is_deeply([ $xs->find_declaration(['frag.xs'], 'fragged') ], ['frag.xs', 9], 'but is where none is');

done_testing;
