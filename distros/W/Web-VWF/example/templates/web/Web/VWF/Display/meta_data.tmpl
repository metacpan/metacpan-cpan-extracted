<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Meta Data</title>
	<script src="https://d3js.org/d3.v7.min.js"></script>
	<style>
		body { margin: 2%; font-family: sans-serif; }
		h1 { text-align: center; }
		/* Two columns, so that the page needs less scrolling: the small panels
		   and the pies on the left, the time series on the right.  Each column is
		   a flex column of its own, so that the panels stack without leaving gaps
		   when one is taller than its neighbour.  The charts are SVGs with a
		   viewBox and a width of 100%, which is what lets them shrink to fit. */
		.columns { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; align-items: start; }
		.column { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
		/* One column on a phone or a narrow window */
		@media (max-width: 800px) { .columns { grid-template-columns: minmax(0, 1fr); } }
		.panel { padding: 10px; border: 1px solid #ccc; border-radius: 6px; background: #f9f9f9; }
		.panel h2 { margin: 0 0 8px; }
		.panel p { margin: 2px 0; }
		.panel svg { max-width: 100%; height: auto; }
	</style>
</head>
<body>
	<h1>Meta Data</h1>

	<div class="columns">
		<div class="column">
			[% IF info %]
			<div class="panel">
				<h2>Info</h2>
				<p>Domain name: [% info.domain_name() | html %]</p>
				<p>Browser type: [% info.browser_type() | html %]</p>
			</div>
			[% END %]

			[% IF lingua %]
			<div class="panel">
				<h2>Lingua</h2>
				<p>Country: [% lingua.country() | html %]</p>
				<p>Requested language: [% lingua.requested_language() | html %]</p>
				<p>Language code: [% lingua.language_code_alpha2() | html %]</p>
			</div>
			[% END %]

			<div class="panel">
				<h2>Server Metrics</h2>
				<p>CPUs: [% server.cpu_count %] [% server.cpu_type %]</p>
				<p>Disk used: [% server.disk_used_pct %]%</p>
				<p>Memory used: [% server.memory_used_pct %]%</p>
			</div>

			<div class="panel">
				<h2>Traffic From The Access Log (last hour)</h2>
				<p>Requests: [% traffic.requests_per_hour %]</p>
				<p>Active users: [% traffic.active_users %]</p>
				<p>Errors: [% traffic.errors_last_hour %]</p>
			</div>

			<div class="panel">
				<h2>Browser Breakdown</h2>
				[% browser_chart %]
			</div>

			<div class="panel">
				<h2>HTTP Status Breakdown</h2>
				[% status_chart %]
			</div>
		</div>

		<div class="column">
			<div class="panel">
				<h2>Requests and Errors (last 24 hours)</h2>
				[% rate_chart %]
			</div>

			<div class="panel">
				<h2>Latency (last 24 hours)</h2>
				[% latency_chart %]
			</div>

			<div class="panel">
				<h2>Slowest Endpoints</h2>
				[% slow_chart %]
			</div>
		</div>
	</div>
</body>
</html>
