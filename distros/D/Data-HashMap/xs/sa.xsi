freeze(SV* self_sv)
    CODE:
        PERL_UNUSED_VAR(self_sv);
        croak("freeze not supported for SV* variants; use to_hash + Storable");
        RETVAL = &PL_sv_undef;
    OUTPUT:
        RETVAL


