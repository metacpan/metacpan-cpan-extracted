#No NaN, finite, and monotone in t, over a sweep that runs through both
#dispatch sides (x0 below and above 0.29, 0.1) for a large and a small shape.
{
	my $bad = 0;
	for my $df (1000, 1500, 2508.3, 5000, 14327.789749923935, 1e5) {
		my $prev;
		for my $k (-80 .. 80) {
			my $t = $k * 0.75 * sqrt($df) / 4;
			my $v = pt($t, $df, log => 1);
			$bad++ if $v != $v || $v > 0;
			$bad++ if defined $prev && $v < $prev - 1e-9 * abs($prev);
			$prev = $v;
			for my $lt (0, 1) {
				for my $f (1e-3, 0.3, 1, 3, 1e3) {
					for my $pair ([$df, 0.5], [$df, 1], [0.5, $df], [2, $df]) {
						my $w = pf($f, @$pair, lower_tail => $lt, log => 1);
						$bad++ if $w != $w || $w > 0;
					}
				}
			}
		}
	}
	is($bad, 0, 'pt/pf log sweep: no NaN, no positive log p, pt monotone');
}
