# Operations from openapi.json{% if tagged %}, tagged {% group_label %}{% end %}. Each sub is named after its
# operationId - that is the whole binding, so renaming one here without
# renaming it in the spec breaks the mount at boot rather than at runtime.
#
# By the time a method runs, the request has already been routed and
# validated against the spec: $c->openapi holds the typed parameters
# ({ path, query, header, cookie, body }) and $c->param reads them first.
{% for op in ops %}
sub {% op.id %} {
    my ($c) = @_;

    # {% op.method %} {% op.path %}{% if op.summary %} - {% op.summary %}{% end %}
    return $c->status(501)->json({
        errors => [ { message => "{% op.id %} is not implemented yet" } ],
    });
}
{% end %}
1;

