use strict;
use warnings;
use Test::More;
use FindBin;
use File::Temp qw(tempdir);
use JSON::PP ();
my $root="$FindBin::RealBin/..";
my $temp=tempdir(CLEANUP=>1);
my $cli="$root/bin/perl-codemap";
my $html="$temp/demo.html";my $json="$temp/demo.json";
my $status=system($^X,$cli,'--root',"$root/examples/sample",'--parser','lite','--output',$html,'--json',$json);
is($status,0,'fresh scan CLI exits successfully');
ok(-s $html && -s $json,'CLI output present');
open my $fh,'<:raw',$json or die $!;
my $data=JSON::PP->new->utf8(1)->decode(do{local $/;<$fh>});close $fh;
ok(@{$data->{pkgs}} >= 12,'sample program analyzed');
ok(scalar(keys %{$data->{sources}}) >= 10,'sample source embedded');
my $rerender="$temp/rerender.html";
$status=system($^X,$cli,'--from-json',$json,'--output',$rerender,'--no-embed-source');
is($status,0,'existing JSON rerender CLI');
ok(-s $rerender,'rerender output exists');
my $help=`$^X $cli --help`;
like($help,qr/--from-json/,'help describes JSON hydration');
my $version=`$^X $cli --version`;
like($version,qr/Perl CodeMap \d+\.\d+\.\d+/,'version works');
done_testing;
