# ---------------------------------------------------------------------------
# 8. Identities that need no reference values at all.
#
# These are the checks a corpus cannot make: they hold for every input, so they
# catch a wrong answer that happens to be self-consistent with a wrong expected
# value.  All of them are properties of the exact discrete test, not of any
# particular implementation.
# ---------------------------------------------------------------------------

# P(X <= x) + P(X >= x) == 1 + P(X == x): the two one-sided p-values overlap in
# exactly the observed density.  dbinom is computed here in plain Perl, by
# ratios, so the identity is checked against arithmetic the XS shares nothing
# with.
sub perl_dbinom {
	my ($x, $n, $p) = @_;
	return (1 - $p) ** $n if $x == 0;
	return $p ** $n       if $x == $n;
	my $t = 0;                        # log C(n,x) by summed logs of ratios
	$t += log(($n - $_ + 1) / $_) for 1 .. $x;
	return exp($t + $x * log($p) + ($n - $x) * log(1 - $p));
}
for my $n (1, 2, 5, 10, 20, 37) {
	for my $p (0.5, 0.25, 0.7, 0.03) {
		for my $x (0 .. $n) {
			my $lo = binom_test($x, $n, p => $p, alternative => 'less')->{p_value};
			my $hi = binom_test($x, $n, p => $p, alternative => 'greater')->{p_value};
			close_to($lo + $hi, 1 + perl_dbinom($x, $n, $p),
			         "C8 x=$x n=$n p=$p  less + greater == 1 + dbinom", 1e-11);
		}
	}
}

# The one-sided p-values are monotone in x, and the two-sided one is a
# probability.  A sign slip or an off-by-one in the tail-counting loop breaks
# monotonicity even where it happens to land on a plausible number.
for my $n (11, 30, 101) {
	for my $p (0.5, 0.2, 0.85) {
		my ($prev_lo, $prev_hi) = (-1, 2);
		for my $x (0 .. $n) {
			my $lo = binom_test($x, $n, p => $p, alternative => 'less')->{p_value};
			my $hi = binom_test($x, $n, p => $p, alternative => 'greater')->{p_value};
			my $ts = binom_test($x, $n, p => $p)->{p_value};
			cmp_ok($lo, '>=', $prev_lo, "C8 x=$x n=$n p=$p 'less' nondecreasing in x");
			cmp_ok($hi, '<=', $prev_hi, "C8 x=$x n=$n p=$p 'greater' nonincreasing in x");
			ok($ts >= 0 && $ts <= 1,    "C8 x=$x n=$n p=$p two-sided in [0,1]");
			($prev_lo, $prev_hi) = ($lo, $hi);
		}
	}
}

# The interval brackets the estimate, nests as the level rises, and its
# one-sided forms are the two halves of the two-sided one at twice the alpha.
for my $n (7, 40, 500) {
	for my $x (0, 1, int($n / 3), $n - 1, $n) {
		my $two  = binom_test($x, $n, conf_level => 0.9)->{conf_int};
		my $wide = binom_test($x, $n, conf_level => 0.99)->{conf_int};
		my $up   = binom_test($x, $n, conf_level => 0.95, alternative => 'less')->{conf_int};
		my $down = binom_test($x, $n, conf_level => 0.95, alternative => 'greater')->{conf_int};
		my $lbl  = "C8 x=$x n=$n";
		cmp_ok($two->[0], '<=', $x / $n, "$lbl CI lower <= estimate");
		cmp_ok($two->[1], '>=', $x / $n, "$lbl estimate <= CI upper");
		cmp_ok($wide->[0], '<=', $two->[0], "$lbl 99% lower below 90% lower");
		cmp_ok($wide->[1], '>=', $two->[1], "$lbl 99% upper above 90% upper");
		# one-sided at 0.95 == two-sided at 0.90, since alpha is halved
		close_to($up->[1],   $two->[1], "$lbl one-sided upper == two-sided upper", $TOL_CI);
		close_to($down->[0], $two->[0], "$lbl one-sided lower == two-sided lower", $TOL_CI);
		is($up->[0],   0, "$lbl 'less' lower bound is exactly 0");
		is($down->[1], 1, "$lbl 'greater' upper bound is exactly 1");
	}
}

# ---------------------------------------------------------------------------
# 9. Recorded divergences from the references.
#
# Both are cases where binom_test() is deliberately not bug-compatible.  They
# are asserted, not merely commented, so that changing either is a decision
# somebody has to make on purpose.
# ---------------------------------------------------------------------------

# (a) n == 0.  R's length-2 branch never validates n, so binom.test(c(0, 0))
#     returns p.value = 1, conf.int = (0, 1) and estimate = NaN (0/0) rather
#     than an error -- its own n >= 1 check only guards the scalar form.
#     binom_test() applies the check to both forms and croaks, because a test on
#     zero trials has no estimate to report.
{
	my $ok = !eval { binom_test([0, 0]); 1 };
	ok($ok, 'C9 n == 0 via [successes, failures] croaks (R returns NaN estimate)');
	like($@, qr/positive integer/, 'C9 croak names the problem');
}

# (b) Underflow.  For x far from the mean at n = 1e6 the two-sided p-value is
#     around 1e-301030 and so is zero in any double.  R reports
#     2.9643938750474793e-323 -- exactly 6 denormal ULPs, and the *same* value
#     for x = 1, x = 5 and x = 999999, which is its own pbeta() underflow floor
#     rather than three different tiny numbers.  binom_test() returns a clean 0.
#
#     This one is a side effect rather than an original design choice: before
#     the front factor moved off differenced lgamma()s (see @BIG_CORPUS) the XS
#     produced R's denormal artefact too, because the old expression underflowed
#     the same way.  It is kept as the expected behaviour because 0 is the
#     faithful answer at ~1e-301030 and a denormal is not, but it is recorded
#     here rather than left as an accident nobody noticed.
for my $x (1, 5, 999999) {
	my $p = binom_test($x, 1000000, p => 0.5)->{p_value};
	is($p, 0, "C9 x=$x n=1e6 two-sided underflows to exactly 0 (R: 2.96e-323)");
}

done_testing();
