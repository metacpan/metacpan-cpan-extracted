require 5.010;
use strict;
use warnings FATAL => 'all';
use Test::More;
use Stats::LikeR qw(pf pt qf t_test);

# Both tails of pf() and pt(), and the far lower tail of qf(), against 80-digit
# truth -- and against R, which is not the authority here and loses to LikeR on
# one of the three.
#
# PROVENANCE
# ----------
# The __DATA__ block at the end of this file holds both tables, frozen.
# The mpmath half is  generated by t/pf_pt_tails.mpmath.py, mpmath 1.3.0
#                           at mp.dps = 80.  The regularized incomplete beta
#                           comes from the Numerical-Recipes continued fraction
#                           by Lentz's method, with x and y = 1-x passed as
#                           separate arguments so nothing cancels, and is
#                           cross-checked in that script against the
#                           independent 2F1 form wherever mpmath's hyp2f1
#                           converges (they agree to 75-80 digits; the script
#                           aborts if they do not).  Quantiles come from
#                           bisection on that, never from a library inverse.
# The R half is             generated by t/pf_pt_tails.R.R under
#                           R 4.6.1 (2026-06-24), on the same grid.  Neither
#                           generator is ever run by the test: the literals
#                           below are what it checks, so the distribution
#                           installs and tests with no R, no python and no
#                           mpmath present.
#
# WHAT THIS FILE PINS
# -------------------
# 1. Two precision bugs that were live before the incbeta_xy() split in
#    LikeR.xs, both from re-forming 1-x by subtraction inside incbeta() when
#    the caller already had the complement exactly:
#
#      pf(1e-12, 1, 1e6, lower_tail => 0)  returned 1        (truth 0.99999920211563864)
#      pt(1e-6, 1e6)                       returned 0.5      (truth 0.50000039894218068)
#
#    Both are now within 1 ulp.  The named cases below would catch either
#    regression on its own, without the table.
#
# 2. That LikeR's qf() is right and *R's is wrong* in the far lower tail.  R
#    bottoms out at a fixed resolution there: R gives 4.4408920985006262e-16
#    (which is 2^-51) for qf(1e-8, 1, 2) where the truth is
#    2.0000000000000003e-16, a relative error of 1.22 -- more than double the
#    correct answer.  Across this grid R is off by up to 1.22 and LikeR by at
#    most 7.6e-15.  The test asserts LikeR against mpmath and separately
#    asserts that R really is the worse of the two, so that "fixing" LikeR
#    towards R would fail loudly rather than pass quietly.
#
# TOLERANCES
# ----------
# Each is the worst disagreement actually measured against the mpmath table on
# a double build, rounded up for headroom on long-double and quadmath (whose
# wider arithmetic shifts where the continued fraction's fixed 3e-15 stopping
# rule lands).  Do not widen these to make a failure go away.
#
#   quantity      worst observed   limit    where the worst case sits
#   pf lower      2.455e-13        5e-12    pf(2, 5, 1e6)
#   pf upper      2.744e-11        5e-10    pf(100, 1, 1e6), a 1.5e-23 tail
#   pt both       4.473e-11        5e-10    pt(+-2, 1e6)
#   qf            7.593e-15        1e-12    qf(1e-8, 1, 1)
#
# The pf-upper and pt limits are set by the continued fraction's convergence at
# df = 1e6, not by any cancellation; R reaches 3e-14 on the same points, so
# there is real accuracy still on the table there if it is ever wanted.
#
# That diagnosis is confirmed by the wider NV builds, where the same code is
# three to four orders MORE accurate against the same frozen table:
#
#                    double     long double / __float128
#   pf lower         2.46e-13   2.4e-15
#   pf upper         2.74e-11   1.1e-15
#   pt both          4.47e-11   2.2e-15 / 4.4e-15
#   qf               7.59e-15   1.7e-15
#
# A cancellation would not improve with the working precision the way this
# does; a fixed-iteration-count continued fraction is exactly what does.  The
# limits above are therefore set by the narrowest width, which is the one that
# has to pass.

my %TOL = (
	'pf.lower' => 5e-12,
	'pf.upper' => 5e-10,
	'pt.lower' => 5e-10,
	'pt.upper' => 5e-10,
	'qf.lower' => 1e-12,
);

# Below this the value is not representable as a double at all, so a build
# returning a flat 0 is right rather than wrong.  DBL_MIN is 2.2e-308; 1e-300
# leaves room for the denormals without asking any build to produce them.
my $UNDERFLOW = 1e-300;

# The two tables arrive in one __DATA__ stream, separated by a %%R%% line:
# mpmath first, then R on the identical grid.
sub read_tables {
	my (%mp, %r, $cur);
	$cur = \%mp;
	while (my $line = <DATA>) {
		next if $line =~ /\A\s*#/ || $line !~ /\S/;
		chomp $line;
		if ($line eq '%%R%%') { $cur = \%r; next }
		my ($kind, $arg, $df1, $df2, $lower, $upper) = split /\t/, $line;
		$cur->{"$kind|$arg|$df1|$df2"} = { lower => $lower, upper => $upper };
	}
	return (\%mp, \%r);
}

my ($M, $R) = read_tables();
ok(scalar(keys %$M) > 300, 'mpmath table loaded');
is(scalar(keys %$M), scalar(keys %$R), 'the R table covers the same grid');

# Relative error of $got against the exact decimal $exp, or undef when $exp is
# below what a double can hold and $got has legitimately underflowed to 0.
sub rel_err {
	my ($got, $exp) = @_;
	return undef unless defined $got;
	return undef if abs($exp) < $UNDERFLOW && $got == 0;
	return abs($got - $exp) if $exp == 0;
	return abs($got - $exp) / abs($exp);
}

my (%worst, %worst_at, %count);

for my $key (sort keys %$M) {
	my ($kind, $arg, $df1, $df2) = split /\|/, $key;
	my $exp = $M->{$key};
	my %got;
	if ($kind eq 'pf') {
		$got{lower} = pf($arg, $df1, $df2);
		$got{upper} = pf($arg, $df1, $df2, 'lower_tail' => 0);
	}
	elsif ($kind eq 'pt') {
		$got{lower} = pt($arg, $df1);
		$got{upper} = pt($arg, $df1, 'lower_tail' => 0);
	}
	else {
		$got{lower} = qf($arg, $df1, $df2);
	}
	for my $tail (sort keys %got) {
		next if !defined $exp->{$tail} || $exp->{$tail} eq '-';
		my $which = "$kind.$tail";
		my $err = rel_err($got{$tail}, $exp->{$tail});
		$count{$which}++;
		next unless defined $err;      # legitimate underflow to 0
		if ($err > ($worst{$which} || 0)) {
			$worst{$which}    = $err;
			$worst_at{$which} = sprintf '%s(%s, %s, %s): mpmath %s, got %.17g',
				$kind, $arg, $df1, $df2, $exp->{$tail}, $got{$tail};
		}
	}
}

for my $which (sort keys %TOL) {
	cmp_ok($count{$which}, '>', 90, "$which: grid points checked ($count{$which})");
	my $w = $worst{$which} || 0;
	ok($w <= $TOL{$which},
		sprintf '%s: worst relative error %.4g <= %.4g', $which, $w, $TOL{$which})
		or diag("worst case: $worst_at{$which}");
}

#
# The two named regressions.  These are the exact calls that were wrong before
# the incbeta_xy() split, stated without reference to the table so that a
# missing or truncated .tsv cannot make them vanish.
#
{
	# mpmath: 1 - pf(1e-12, 1, 1e6) = 0.999999202115638638...  The old code
	# returned exactly 1, because incbeta() formed 1.0 - x with 1-x = 1e-18.
	my $up = pf(1e-12, 1, 1e6, 'lower_tail' => 0);
	ok($up < 1, 'pf upper tail near 1 is not flattened to exactly 1');
	cmp_ok(abs($up - 0.99999920211563864) / 0.99999920211563864, '<', 1e-12,
		'pf(1e-12, 1, 1e6, lower_tail => 0) matches mpmath');

	# The two tails must also still add to 1 to within rounding.  Before the
	# fix they summed to 1 + 7.98e-7 here, which is what first showed the bug.
	my $lo = pf(1e-12, 1, 1e6);
	cmp_ok(abs($lo + $up - 1), '<', 1e-15, 'pf: the two tails sum to 1');
}
{
	# mpmath: pt(1e-6, 1e6) = 0.500000398942180682...  The old code returned
	# exactly 0.5, for the same reason.
	my $p = pt(1e-6, 1e6);
	isnt($p, 0.5, 'pt near zero is not flattened to exactly 0.5');
	cmp_ok(abs($p - 0.50000039894218068) / 0.50000039894218068, '<', 1e-12,
		'pt(1e-6, 1e6) matches mpmath');

	# pt(-1e-8, 1) was 0.5 too; mpmath and R agree on 0.49999999681690110.
	cmp_ok(abs(pt(-1e-8, 1) - 0.4999999968169011) / 0.4999999968169011, '<', 1e-12,
		'pt(-1e-8, 1) matches mpmath');
	cmp_ok(abs(pt(1e-8, 1) + pt(-1e-8, 1) - 1), '<', 1e-15,
		'pt: symmetric tails sum to 1');
}
{
	# The same defect reached t_test, whose p-value is 1 - (the tail above).
	# A statistic this small on this many df had its p-value pinned at exactly
	# 1; it should be 1 - 4e-7.  Two samples differing by 1e-6 in one element
	# out of 2001 make such a statistic without needing a contrived df.
	my @x = (0) x 2001;
	my @y = (0) x 2001;
	$y[0] = 1e-6;
	my $r = t_test(\@x, \@y, var_equal => 1);
	ok($r->{'p_value'} < 1,
		'a t_test p-value just below 1 is not rounded up to exactly 1');
}

#
# qf(): LikeR against mpmath, and the recorded fact that R is the worse of the
# two.  If R's qf() is ever fixed upstream this test still passes -- it only
# asserts that LikeR is the accurate one, not that R stays broken by any
# particular amount.
#
{
	my ($worst_liker, $worst_r, $n) = (0, 0, 0);
	my ($liker_wins, $r_wins) = (0, 0);
	for my $key (sort keys %$M) {
		next unless $key =~ /\Aqf\|/;
		my ($kind, $arg, $df1, $df2) = split /\|/, $key;
		my $exp = $M->{$key}{lower};
		next if abs($exp) < $UNDERFLOW;
		my $el = rel_err(qf($arg, $df1, $df2), $exp);
		my $er = rel_err($R->{$key}{lower}, $exp);
		next unless defined $el && defined $er;
		$n++;
		$worst_liker = $el if $el > $worst_liker;
		$worst_r     = $er if $er > $worst_r;
		$el <= $er ? $liker_wins++ : $r_wins++;
	}
	cmp_ok($n, '>', 90, "qf: grid points compared against R ($n)");
	ok($worst_liker <= 1e-12,
		sprintf 'qf: LikeR worst relative error %.4g', $worst_liker);
	ok($worst_r > $worst_liker,
		sprintf "qf: R's worst error %.4g is the larger of the two", $worst_r);
	cmp_ok($liker_wins, '>', $r_wins,
		"qf: LikeR is at least as close as R on most points ($liker_wins vs $r_wins)");

	# The single worst point, stated outright: R returns 2^-51 where the
	# answer is 2e-16.
	my $r_bad = $R->{'qf|1e-08|1|2'}{lower};
	my $l_ok  = qf(1e-8, 1, 2);
	cmp_ok(abs($l_ok - 2.0000000000000003e-16) / 2.0000000000000003e-16, '<', 1e-12,
		'qf(1e-8, 1, 2) matches mpmath');
	cmp_ok(abs($r_bad - 2.0000000000000003e-16) / 2.0000000000000003e-16, '>', 1,
		"qf(1e-8, 1, 2): R's own answer is off by more than 100%");
}

diag(sprintf 'worst observed: %s',
	join ', ', map { sprintf '%s %.3g', $_, ($worst{$_} || 0) } sort keys %TOL);

done_testing();
