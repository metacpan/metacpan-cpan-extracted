    {
      "name": "unattributed-range-keeps-empty-provider",
      "why": "A populated object always carries every key. An unattributed range has an empty provider string, never a missing one.",
      "status": 200,
      "body": {
        "ip": "185.199.1.1",
        "is_vpn": true,
        "vpn": {
          "provider": "",
          "last_seen": "2026-08-30"
        }
      },
      "expect": {
        "ip": "185.199.1.1",
        "isBogon": false,
        "present": {
          "is_vpn": true
        },
        "vpn": {
          "provider": "",
          "last_seen": "2026-08-30"
        }
      }
    },
    {
      "name": "max-nothing-found",
      "why": "A served all-negative Max answer. This is the only case that pins EVERY tier-gated flag as present-and-false, so a per-field slip that maps on truthiness rather than presence cannot hide behind the members other cases happen to set true.",
