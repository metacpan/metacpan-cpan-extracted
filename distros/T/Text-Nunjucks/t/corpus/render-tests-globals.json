  {
    "name": "tests: lower: number -> TypeError",
    "template": "{{ 5 is lower }}",
    "expected": {
      "ok": false,
      "error": {
        "name": "Template render error",
        "message": "(unknown path)\n  TypeError: value.toLowerCase is not a function"
