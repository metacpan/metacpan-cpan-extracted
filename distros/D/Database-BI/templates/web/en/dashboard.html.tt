<script>
// ---------------------------------------------------------------------------
// Scatter plot panel
// ---------------------------------------------------------------------------
(function () {
  var btnOpen   = document.getElementById('btn-scatter');
  var panel     = document.getElementById('scatter-panel');
  if (!btnOpen || !panel) return;

  var btnCancel     = document.getElementById('btn-cancel-scatter');
  var btnDo         = document.getElementById('btn-do-scatter');
  var xSel          = document.getElementById('scatter-x-sel');
  var ySel          = document.getElementById('scatter-y-sel');
  var yTextInput    = document.getElementById('scatter-y-text');
  var yLabel        = document.getElementById('scatter-y-label');
  var seriesSel     = document.getElementById('scatter-series-sel');
  var sizeSel       = document.getElementById('scatter-size-sel');
  var schemeSel     = document.getElementById('scatter-scheme-sel');
  var minRInp       = document.getElementById('scatter-min-r');
  var maxRInp       = document.getElementById('scatter-max-r');
  var backInp       = document.getElementById('scatter-back-inp');
  var back2Inp      = document.getElementById('scatter-back2-inp');
  var back2LabelInp = document.getElementById('scatter-back2-label-inp');
  var scatterForm   = document.getElementById('scatter-form');

  var otherPanels = ['join-panel', 'combine-panel', 'export-panel', 'graph-panel', 'pie-panel', 'heatmap-panel', 'bar-panel', 'stacked-panel', 'combo-panel', 'treemap-panel', 'histogram-panel', 'folder-panel', 'pivot-panel', 'calc-panel', 'groups-panel', 'dates-panel', 'save-analysis-panel', 'map-panel'].map(function (id) {
    return document.getElementById(id);
  }).filter(Boolean);

  function checkScatter() {
    btnDo.disabled = !(xSel.value && ySel.value);
  }

  function updateScatterState() {
    if (schemeSel) schemeSel.disabled = !(seriesSel && seriesSel.value);
    var hasSize = sizeSel && sizeSel.value;
    if (minRInp) minRInp.disabled = !hasSize;
    if (maxRInp) maxRInp.disabled = !hasSize;
  }

  // Populate X, Y, and size selects with numeric-only columns.
  function buildScatterSelects() {
    var tbl = document.querySelector('table[data-table]') || document.querySelector('table');
    if (!tbl || !tbl.tHead || !tbl.tBodies[0]) return;
    var headers  = Array.from(tbl.tHead.rows[0].cells);
    var rows     = Array.from(tbl.tBodies[0].rows);
    var prevX    = xSel.value;
    var prevY    = ySel.value;
    var prevSize = sizeSel ? sizeSel.value : '';
    [xSel, ySel].forEach(function (sel) {
      while (sel.options.length > 1) sel.remove(1);
    });
    if (sizeSel) { while (sizeSel.options.length > 1) sizeSel.remove(1); }
    headers.forEach(function (th, idx) {
      var name = th.textContent.trim();
      var vals = rows.map(function (r) {
        return r.cells[idx] ? r.cells[idx].textContent.trim() : '';
      }).filter(function (v) { return v !== ''; });
      if (vals.length === 0) return;
      if (vals.every(function (v) {
        return /^\d{4}-\d{2}-\d{2}$/.test(v) || /^\d{1,2}\/\d{1,2}\/\d{4}$/.test(v);
      })) return;
      if (!vals.every(function (v) { return v === '' || !isNaN(parseAccounting(v)); })) return;
      var optX = document.createElement('option');
      optX.value = name; optX.textContent = name;
      if (name === prevX) optX.selected = true;
      xSel.appendChild(optX);
      var optY = document.createElement('option');
      optY.value = name; optY.textContent = name;
      if (name === prevY) optY.selected = true;
      ySel.appendChild(optY);
      if (sizeSel) {
        var optS = document.createElement('option');
        optS.value = name; optS.textContent = name;
        if (name === prevSize) optS.selected = true;
        sizeSel.appendChild(optS);
      }
    });
    var n = ySel.options.length - 1;
    if (n === 1 && yTextInput && yLabel) {
      ySel.options[1].selected = true;
      ySel.hidden = true;
      yTextInput.value = ySel.options[1].value; yTextInput.hidden = false;
      yLabel.textContent = 'Y axis (auto-selected)';
    } else {
      ySel.hidden = false;
      if (yTextInput) yTextInput.hidden = true;
      if (yLabel) yLabel.textContent = 'Y axis (vertical, numeric)';
    }
    if (n === 0) {
      btnOpen.disabled = true;
      btnOpen.title    = 'Scatter plots need at least one numeric column';
    }
    updateScatterState();
    return n;
  }

  (function initScatterBtn() {
    var n = buildScatterSelects();
    if (!n) {
      btnOpen.disabled = true;
      btnOpen.title    = 'Scatter plots need numeric columns';
    }
  }());

  btnOpen.addEventListener('click', function () {
    otherPanels.forEach(function (p) { p.hidden = true; });
    backInp.value = window.location.href;
    if (back2Inp && scatterForm) {
      var pb = scatterForm.getAttribute('data-parent-back') || '';
      back2Inp.value = pb;
      if (back2LabelInp) back2LabelInp.value = pb ? (scatterForm.getAttribute('data-parent-back-label') || '') : '';
    }
    buildScatterSelects();
    panel.hidden = !panel.hidden;
    checkScatter();
  });

  btnCancel && btnCancel.addEventListener('click', function () {
    panel.hidden = true;
  });

  xSel.addEventListener('change', checkScatter);
  ySel.addEventListener('change', checkScatter);
  seriesSel && seriesSel.addEventListener('change', updateScatterState);
  sizeSel   && sizeSel.addEventListener('change', updateScatterState);
}());
</script>

<script>
// ---------------------------------------------------------------------------
// Combo bar+line chart panel
// ---------------------------------------------------------------------------
(function () {
  var btnOpen   = document.getElementById('btn-combo');
  var panel     = document.getElementById('combo-panel');
  if (!btnOpen || !panel) return;

  var btnCancel     = document.getElementById('btn-cancel-combo');
  var btnDo         = document.getElementById('btn-do-combo');
  var xSel          = document.getElementById('combo-x-sel');
  var barSel        = document.getElementById('combo-bar-sel');
  var lineSel       = document.getElementById('combo-line-sel');
  var backInp       = document.getElementById('combo-back-inp');
  var back2Inp      = document.getElementById('combo-back2-inp');
  var back2LabelInp = document.getElementById('combo-back2-label-inp');
  var comboForm     = document.getElementById('combo-form');

  var otherPanels = ['join-panel', 'combine-panel', 'export-panel', 'graph-panel', 'pie-panel', 'heatmap-panel', 'bar-panel', 'stacked-panel', 'scatter-panel', 'treemap-panel', 'histogram-panel', 'folder-panel', 'pivot-panel', 'calc-panel', 'groups-panel', 'dates-panel', 'save-analysis-panel', 'map-panel'].map(function (id) {
    return document.getElementById(id);
  }).filter(Boolean);

  function checkCombo() {
    btnDo.disabled = !(xSel.value && barSel.value && lineSel.value);
  }

  function buildComboNumericSelects() {
    var tbl = document.querySelector('table[data-table]') || document.querySelector('table');
    if (!tbl || !tbl.tHead || !tbl.tBodies[0]) return;
    var headers = Array.from(tbl.tHead.rows[0].cells);
    var rows    = Array.from(tbl.tBodies[0].rows);
    var prevBar  = barSel.value;
    var prevLine = lineSel.value;
    [barSel, lineSel].forEach(function (sel) {
      while (sel.options.length > 1) sel.remove(1);
    });
    headers.forEach(function (th, idx) {
      var name = th.textContent.trim();
      var vals = rows.map(function (r) {
        return r.cells[idx] ? r.cells[idx].textContent.trim() : '';
      }).filter(function (v) { return v !== ''; });
      if (vals.length === 0) return;
      if (vals.every(function (v) {
        return /^\d{4}-\d{2}-\d{2}$/.test(v) || /^\d{1,2}\/\d{1,2}\/\d{4}$/.test(v);
      })) return;
      if (!vals.every(function (v) { return v === '' || !isNaN(parseAccounting(v)); })) return;
      var optBar = document.createElement('option');
      optBar.value = name; optBar.textContent = name;
      if (name === prevBar) optBar.selected = true;
      barSel.appendChild(optBar);
      var optLine = document.createElement('option');
      optLine.value = name; optLine.textContent = name;
      if (name === prevLine) optLine.selected = true;
      lineSel.appendChild(optLine);
    });
  }

  btnOpen.addEventListener('click', function () {
    otherPanels.forEach(function (p) { p.hidden = true; });
    backInp.value = window.location.href;
    if (back2Inp && comboForm) {
      var pb = comboForm.getAttribute('data-parent-back') || '';
      back2Inp.value = pb;
      if (back2LabelInp) back2LabelInp.value = pb ? (comboForm.getAttribute('data-parent-back-label') || '') : '';
    }
    buildComboNumericSelects();
    panel.hidden = !panel.hidden;
    checkCombo();
  });

  btnCancel && btnCancel.addEventListener('click', function () {
    panel.hidden = true;
  });

  xSel.addEventListener('change', checkCombo);
  barSel.addEventListener('change', checkCombo);
  lineSel.addEventListener('change', checkCombo);
}());
</script>

