	[ 'logrank_test: NaN time',    sub { logrank_test([1, $nan, 3, 4], [1, 1, 1, 1], [1, 1, 2, 2]) }, qr/^logrank_test: time at index 1 is NaN/ ],
	[ 'logrank_test: undef group', sub { logrank_test([1 .. 4], [1, 1, 1, 1], [1, undef, 2, 2]) }, qr/^logrank_test: group at index 1 is undef/ ],
	[ 'logrank_test: group hole',  sub { logrank_test([1 .. 4], [1, 1, 1, 1], \@hole_g) },  qr/^logrank_test: group at index 1 is undef/ ],
	[ 'logrank_test: unknown option', sub { logrank_test([1 .. 4], [1, 1, 1, 1], [1, 1, 2, 2], rh => 1) }, qr/logrank_test: error: unknown argument 'rh'/ ],
	[ 'logrank_test: lone option key', sub { logrank_test([1 .. 4], [1, 1, 1, 1], [1, 1, 2, 2], 'rho') }, qr/logrank_test: error: options must be name => value pairs/ ],
	[ 'logrank_test: infinite rho', sub { logrank_test([1 .. 4], [1, 1, 1, 1], [1, 1, 2, 2], rho => $inf) }, qr/logrank_test: error: rho must be a finite number/ ],
	[ 'logrank_test: NaN rho',     sub { logrank_test([1 .. 4], [1, 1, 1, 1], [1, 1, 2, 2], rho => $nan) }, qr/logrank_test: error: rho must be a finite number/ ],
	[ 'coxph: 0 in a 1/2 column',  sub { coxph([1 .. 4], [1, 0, 1, 2], [1, 2, 3, 4]) },      qr/^coxph: status at index 1 is 0, but status must be 0\/1/ ],
	[ 'coxph: NaN status',         sub { coxph([1 .. 4], [1, $nan, 1, 0], [1, 2, 3, 4]) },   qr/^coxph: status at index 1 is NaN/ ],
	[ 'coxph formula: status 3',   sub { coxph(formula => 'Surv(t, s) ~ x', data => { t => [1 .. 4], s => [1, 3, 1, 0], x => [1, 2, 3, 4] }) },
	                                                                                          qr/^coxph: status 3 in a complete row, but status must be 0\/1/ ],
);
for my $c (@croaks) {
	my ($name, $code, $re) = @$c;
	ok(!eval { $code->(); 1 }, "$name: croaks");
	like($@, $re, "$name: says why");
	no_leaks_ok { eval { $code->() } } "$name: no SV leak on the croak path";
}

no_leaks_ok { survfit(@{ $DATA{ovarian} }{qw(time status)}, group => $DATA{ovarian}{group}) } 'survfit: no SV leak';
no_leaks_ok { logrank_test(@{ $DATA{ovarian} }{qw(time status group)}, rho => 1) } 'logrank_test: no SV leak';

diag(sprintf 'worst relative disagreement with R: %.3g (limit %g)', $worst, $TOL)
	if $ENV{AUTHOR_TESTING};
done_testing();
