# Claude Code — commit: skills/, agents/, rules/, hooks/, settings.json
# Ignore: local overrides, credentials, session data

# Tracked: shared config & extensibility
!/.claude/
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/agents/**
!.claude/skills/
!.claude/skills/**
!.claude/rules/
!.claude/rules/**
!.claude/hooks/
!.claude/hooks/**

# Local overrides (machine-specific)
.claude/*.local.*
.claude/local/

# Credentials & session state (never track)
.claude/.credentials.json
.claude/statsig/
.claude/todos/
.claude/projects/

# Build artifacts (Dist::Zilla)
Crypt-Age-*/
Crypt-Age-*.tar.gz
.build/
blib/
MANIFEST
MANIFEST.bak
META.*
MYMETA.*
Makefile
Makefile.old
pm_to_blib

# Test coverage
cover_db/

# Carton / local libs
cpanfile.snapshot
local/

# karr (git-native kanban — board lives in refs/karr/*, these are local logs)
.karr.log
.karr.state

# Editor backups
*~
*.swp
*.bak

# karr materialized task view -- never commit
tasks/
config.yml
