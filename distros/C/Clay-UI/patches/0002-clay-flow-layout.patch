+// ---------------------------------------------------------------------------
+// Flow layout (CLAY_LEFT_TO_RIGHT_WRAP). The X sizing pass breaks the
+// children of a wrap container into lines greedily, using their preferred
+// widths, and records the first child of every line in context->flowLines;
+// the Y sizing pass records each line's height there, and every later pass
+// walks the same lines. Within a line, SIZING_GROW children share the
+// line's free width and stretch to the line's height. Exiting children
+// never start a line and take no space, as in the other layout directions.
+// ---------------------------------------------------------------------------
+
+// The size and minimum size of an element's content along one axis, padding included.
+typedef struct {
+    float size;
+    float minSize;
+} Clay__AxisExtent;
+
+// True if a parent may shrink this child below its preferred size along the axis when content
+// overflows (see the compression in Clay__SizeContainersAlongAxis).
+bool Clay__IsCompressible(Clay_LayoutElement *child, bool xAxis) {
+    Clay__SizingType sizingType = Clay__GetElementSizing(child, xAxis).type;
+    if (sizingType == CLAY__SIZING_TYPE_PERCENT || sizingType == CLAY__SIZING_TYPE_FIXED) return false;
+    return !child->isTextElement || child->textConfig.wrapMode == CLAY_TEXT_WRAP_WORDS;
+}
+
+// The offset of the first child at or after fromOffset that starts a line, or the child count if
+// no later line exists.
+int32_t Clay__FlowNextLineStart(Clay_LayoutElement *parent, int32_t fromOffset) {
+    Clay_Context* context = Clay_GetCurrentContext();
+    for (int32_t childOffset = fromOffset; childOffset < parent->children.length; ++childOffset) {
+        if (context->flowLines.internalArray[parent->children.elements[childOffset]].startsLine) return childOffset;
+    }
+    return parent->children.length;
+}
+
+// The width (children plus the gaps between them) and height of the line made of the children
+// [firstOffset, endOffset).
+Clay_Dimensions Clay__FlowLineSize(Clay_LayoutElement *parent, int32_t firstOffset, int32_t endOffset) {
+    Clay_Context* context = Clay_GetCurrentContext();
+    Clay_Dimensions lineSize = CLAY__DEFAULT_STRUCT;
+    int32_t placedChildren = 0;
+    for (int32_t childOffset = firstOffset; childOffset < endOffset; ++childOffset) {
+        Clay_LayoutElement *child = Clay_LayoutElementArray_Get(&context->layoutElements, parent->children.elements[childOffset]);
+        if (child->exiting) continue;
+        lineSize.width += child->dimensions.width;
+        lineSize.height = CLAY__MAX(lineSize.height, child->dimensions.height);
+        placedChildren++;
+    }
+    lineSize.width += (float)(CLAY__MAX(placedChildren - 1, 0) * parent->config.layout.childGap);
+    return lineSize;
+}
+
+// The size of all lines of a wrap container together, padding excluded.
+Clay_Dimensions Clay__FlowContentSize(Clay_LayoutElement *parent) {
+    Clay_Dimensions contentSize = CLAY__DEFAULT_STRUCT;
+    int32_t lineCount = 0;
+    for (int32_t lineStart = Clay__FlowNextLineStart(parent, 0), lineEnd; lineStart < parent->children.length; lineStart = lineEnd) {
+        lineEnd = Clay__FlowNextLineStart(parent, lineStart + 1);
+        Clay_Dimensions lineSize = Clay__FlowLineSize(parent, lineStart, lineEnd);
+        contentSize.width = CLAY__MAX(contentSize.width, lineSize.width);
+        contentSize.height += lineSize.height;
+        lineCount++;
+    }
+    contentSize.height += (float)(CLAY__MAX(lineCount - 1, 0) * parent->config.layout.lineGap);
+    return contentSize;
+}
+
+// The extent of a wrap container along one axis. Along X it prefers a single line and can wrap
+// down to its widest child; along Y it spans the lines the X sizing pass broke it into, so it
+// must only be asked for Y after that pass.
+Clay__AxisExtent Clay__FlowExtentAlongAxis(Clay_LayoutElement *parent, bool xAxis) {
+    Clay_Context* context = Clay_GetCurrentContext();
+    Clay_LayoutConfig *layoutConfig = &parent->config.layout;
+    if (!xAxis) {
+        float padding = (float)(layoutConfig->padding.top + layoutConfig->padding.bottom);
+        float size = padding + Clay__FlowContentSize(parent).height;
+        return CLAY__INIT(Clay__AxisExtent) { .size = size, .minSize = parent->config.clip.vertical ? padding : size };
+    }
+    float padding = (float)(layoutConfig->padding.left + layoutConfig->padding.right);
+    Clay__AxisExtent extent = { .size = padding, .minSize = padding };
+    for (int32_t childOffset = 0; childOffset < parent->children.length; ++childOffset) {
+        Clay_LayoutElement *child = Clay_LayoutElementArray_Get(&context->layoutElements, parent->children.elements[childOffset]);
+        extent.size += child->dimensions.width;
+        if (!parent->config.clip.horizontal) {
+            extent.minSize = CLAY__MAX(extent.minSize, child->minDimensions.width + padding);
+        }
+    }
+    extent.size += (float)(CLAY__MAX(parent->children.length - 1, 0) * layoutConfig->childGap);
+    return extent;
+}
+
+// Shares freeWidth between the SIZING_GROW children of the line [firstOffset, endOffset).
+void Clay__GrowFlowLine(Clay_LayoutElement *parent, int32_t firstOffset, int32_t endOffset, float freeWidth, Clay__int32_tArray *growBuffer) {
+    Clay_Context* context = Clay_GetCurrentContext();
+    if (freeWidth <= CLAY__EPSILON) return;
+    growBuffer->length = 0;
+    for (int32_t childOffset = firstOffset; childOffset < endOffset; ++childOffset) {
+        int32_t childIndex = parent->children.elements[childOffset];
+        Clay_LayoutElement *child = Clay_LayoutElementArray_Get(&context->layoutElements, childIndex);
+        if (child->exiting || Clay__GetElementSizing(child, true).type != CLAY__SIZING_TYPE_GROW) continue;
+        Clay__int32_tArray_Add(growBuffer, childIndex);
+    }
+    Clay__GrowContainersAlongAxis(growBuffer, freeWidth, true);
+}
+
+// Breaks the children of a wrap container into lines that fit its inner width, records where
+// each line starts and grows each line's SIZING_GROW children into its free width. A child wider
+// than the container is compressed like any overflowing child, unless the container clips
+// horizontally; it then sits alone on its line.
+void Clay__SizeFlowChildrenX(Clay_LayoutElement *parent, Clay__int32_tArray *growBuffer) {
+    Clay_Context* context = Clay_GetCurrentContext();
+    Clay_LayoutConfig *layoutConfig = &parent->config.layout;
+    float innerWidth = parent->dimensions.width - (float)(layoutConfig->padding.left + layoutConfig->padding.right);
+    float childGap = (float)layoutConfig->childGap;
+    int32_t lineStart = -1;
+    float lineWidth = 0;
+    for (int32_t childOffset = 0; childOffset < parent->children.length; ++childOffset) {
+        int32_t childIndex = parent->children.elements[childOffset];
+        Clay_LayoutElement *child = Clay_LayoutElementArray_Get(&context->layoutElements, childIndex);
+        context->flowLines.internalArray[childIndex].startsLine = false;
+        if (child->exiting) continue;
+        if (!parent->config.clip.horizontal && child->dimensions.width > innerWidth && Clay__IsCompressible(child, true)) {
+            child->dimensions.width = CLAY__MAX(child->minDimensions.width, innerWidth);
+        }
+        bool fitsOnLine = lineStart >= 0 && lineWidth + childGap + child->dimensions.width <= innerWidth + CLAY__EPSILON;
+        if (fitsOnLine) {
+            lineWidth += childGap + child->dimensions.width;
+            continue;
+        }
+        if (lineStart >= 0) {
+            Clay__GrowFlowLine(parent, lineStart, childOffset, innerWidth - lineWidth, growBuffer);
+        }
+        context->flowLines.internalArray[childIndex].startsLine = true;
+        lineStart = childOffset;
+        lineWidth = child->dimensions.width;
+    }
+    if (lineStart >= 0) {
+        Clay__GrowFlowLine(parent, lineStart, parent->children.length, innerWidth - lineWidth, growBuffer);
+    }
+}
+
+// The number of lines the X sizing pass broke a wrap container into.
+int32_t Clay__FlowLineCount(Clay_LayoutElement *parent) {
+    int32_t lineCount = 0;
+    for (int32_t lineStart = Clay__FlowNextLineStart(parent, 0); lineStart < parent->children.length; lineStart = Clay__FlowNextLineStart(parent, lineStart + 1)) {
+        lineCount++;
+    }
+    return lineCount;
+}
+
+// The height every line of a wrap container gains on top of its tallest child: an equal share of
+// the container's leftover height with CLAY_LINE_SIZING_GROW, nothing with CLAY_LINE_SIZING_FIT.
+float Clay__FlowExtraHeightPerLine(Clay_LayoutElement *parent) {
+    Clay_LayoutConfig *layoutConfig = &parent->config.layout;
+    if (layoutConfig->lineSizing != CLAY_LINE_SIZING_GROW) return 0;
+    int32_t lineCount = Clay__FlowLineCount(parent);
+    if (lineCount == 0) return 0;
+    float innerHeight = parent->dimensions.height - (float)(layoutConfig->padding.top + layoutConfig->padding.bottom);
+    float leftoverHeight = innerHeight - Clay__FlowContentSize(parent).height;
+    return CLAY__MAX(0, leftoverHeight) / (float)lineCount;
+}
+
+// Records the height of every line of a wrap container and stretches the line's SIZING_GROW
+// children to it.
+void Clay__SizeFlowChildrenY(Clay_LayoutElement *parent) {
+    Clay_Context* context = Clay_GetCurrentContext();
+    float extraHeightPerLine = Clay__FlowExtraHeightPerLine(parent);
+    for (int32_t lineStart = Clay__FlowNextLineStart(parent, 0), lineEnd; lineStart < parent->children.length; lineStart = lineEnd) {
+        lineEnd = Clay__FlowNextLineStart(parent, lineStart + 1);
+        float lineHeight = Clay__FlowLineSize(parent, lineStart, lineEnd).height + extraHeightPerLine;
+        context->flowLines.internalArray[parent->children.elements[lineStart]].height = lineHeight;
+        for (int32_t childOffset = lineStart; childOffset < lineEnd; ++childOffset) {
+            Clay_LayoutElement *child = Clay_LayoutElementArray_Get(&context->layoutElements, parent->children.elements[childOffset]);
+            Clay_SizingAxis sizing = Clay__GetElementSizing(child, false);
+            if (child->exiting || sizing.type != CLAY__SIZING_TYPE_GROW) continue;
+            child->dimensions.height = CLAY__MAX(child->minDimensions.height, CLAY__MIN(lineHeight, sizing.size.minMax.max));
+        }
+    }
+}
+
+// The size of all lines of a wrap container with the heights the Y sizing pass recorded,
+// padding excluded.
+Clay_Dimensions Clay__FlowLaidOutContentSize(Clay_LayoutElement *parent) {
+    Clay_Context* context = Clay_GetCurrentContext();
+    Clay_Dimensions contentSize = CLAY__DEFAULT_STRUCT;
+    int32_t lineCount = 0;
+    for (int32_t lineStart = Clay__FlowNextLineStart(parent, 0), lineEnd; lineStart < parent->children.length; lineStart = lineEnd) {
+        lineEnd = Clay__FlowNextLineStart(parent, lineStart + 1);
+        contentSize.width = CLAY__MAX(contentSize.width, Clay__FlowLineSize(parent, lineStart, lineEnd).width);
+        contentSize.height += context->flowLines.internalArray[parent->children.elements[lineStart]].height;
+        lineCount++;
+    }
+    contentSize.height += (float)(CLAY__MAX(lineCount - 1, 0) * parent->config.layout.lineGap);
+    return contentSize;
+}
+
+// Where the next child of a wrap container goes while its children are positioned.
+typedef struct {
+    float nextX;
+    float lineTop;
+    float lineHeight;
+    bool hasLine;
+} Clay__FlowCursor;
+
+// The cursor before the first child of a wrap container. childAlignment.y places the block of
+// lines when they do not fill the container.
+Clay__FlowCursor Clay__FlowBeginPlacement(Clay_LayoutElement *parent) {
+    Clay_LayoutConfig *layoutConfig = &parent->config.layout;
+    float extraSpace = parent->dimensions.height - (float)(layoutConfig->padding.top + layoutConfig->padding.bottom) - Clay__FlowLaidOutContentSize(parent).height;
+    switch (layoutConfig->childAlignment.y) {
+        case CLAY_ALIGN_Y_TOP: extraSpace = 0; break;
+        case CLAY_ALIGN_Y_CENTER: extraSpace /= 2; break;
+        default: break;
+    }
+    return CLAY__INIT(Clay__FlowCursor) { .nextX = (float)layoutConfig->padding.left, .lineTop = (float)layoutConfig->padding.top + CLAY__MAX(0, extraSpace) };
+}
+
+// Returns the position of the child at childOffset relative to its wrap container and moves the
+// cursor past it. childAlignment.x aligns every line on its own, childAlignment.y aligns each
+// child within its line.
+Clay_Vector2 Clay__FlowPlaceChild(Clay_LayoutElement *parent, int32_t childOffset, Clay__FlowCursor *cursor) {
+    Clay_Context* context = Clay_GetCurrentContext();
+    Clay_LayoutConfig *layoutConfig = &parent->config.layout;
+    int32_t childIndex = parent->children.elements[childOffset];
+    Clay_LayoutElement *child = Clay_LayoutElementArray_Get(&context->layoutElements, childIndex);
+    if (context->flowLines.internalArray[childIndex].startsLine) {
+        if (cursor->hasLine) {
+            cursor->lineTop += cursor->lineHeight + (float)layoutConfig->lineGap;
+        }
+        cursor->hasLine = true;
+        float lineWidth = Clay__FlowLineSize(parent, childOffset, Clay__FlowNextLineStart(parent, childOffset + 1)).width;
+        cursor->lineHeight = context->flowLines.internalArray[childIndex].height;
+        float extraSpace = parent->dimensions.width - (float)(layoutConfig->padding.left + layoutConfig->padding.right) - lineWidth;
+        switch (layoutConfig->childAlignment.x) {
+            case CLAY_ALIGN_X_LEFT: extraSpace = 0; break;
+            case CLAY_ALIGN_X_CENTER: extraSpace /= 2; break;
+            default: break;
+        }
+        cursor->nextX = (float)layoutConfig->padding.left + CLAY__MAX(0, extraSpace);
+    }
+    Clay_Vector2 position = { cursor->nextX, cursor->lineTop };
+    // An exiting child placed before the first line (exiting children go first unless their exit ordering says
+    // otherwise) aligns within that line, so it never moves above it. Without any line, the empty block of lines
+    // already sits where childAlignment.y puts it, and the child aligns around that point.
+    float lineHeight = cursor->lineHeight;
+    if (!cursor->hasLine) {
+        int32_t firstLineStart = Clay__FlowNextLineStart(parent, childOffset);
+        lineHeight = firstLineStart < parent->children.length
+            ? context->flowLines.internalArray[parent->children.elements[firstLineStart]].height
+            : 0;
+    }
+    float spaceAroundChild = lineHeight - child->dimensions.height;
+    switch (layoutConfig->childAlignment.y) {
+        case CLAY_ALIGN_Y_TOP: break;
+        case CLAY_ALIGN_Y_CENTER: position.y += spaceAroundChild / 2; break;
+        case CLAY_ALIGN_Y_BOTTOM: position.y += spaceAroundChild; break;
+    }
+    if (!child->exiting) {
+        cursor->nextX += child->dimensions.width + (float)layoutConfig->childGap;
+    }
+    return position;
+}
