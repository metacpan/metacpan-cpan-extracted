class Mojo::Connection::Stream extends Mojo::Connection {
  version_from Mojolicious;
  
  # Class Methods
  static method new : Mojo::Connection::Stream () {
    
    my $self = new Mojo::Connection::Stream;
    
    return $self;
  }
  
  method write : int ($context : Go::Context, $chunk : string) {
    
    my $handle = $self->{handle};
    
    my $write_length = $handle->syswrite($context, $chunk);
    
    return $write_length;
  }
  
  method read : int ($context : Go::Context, $buffer : mutable string) {
    
    my $handle = $self->{handle};
    
    my $read_length = $handle->sysread($context, $buffer);
    
    return $read_length;
  }
  
}
