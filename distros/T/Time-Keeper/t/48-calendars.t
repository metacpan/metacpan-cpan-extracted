#!perl
use 5.010;
use strict;
use warnings;
use Test::More;

use Time::Keeper;

my $K = 'Time::Keeper';
my $C = 'Time::Keeper::Calendar';
sub dies_like { my ($code, $re, $name) = @_; ok(!eval { $code->(); 1 }, $name) or return; like($@, $re, "$name: the message") }

my @ids = $C->ids;
is(scalar(@ids), 17, 'seventeen calendars');
is($ids[0], 'gregory', 'the Gregorian first');
is($C->name('hebrew'), 'Hebrew', 'name');
is($C->name('roc'), 'Minguo', 'the ROC calendar is Minguo');
is($C->kind('hebrew'), 'arithmetic', 'kind');
is($C->kind('islamic-umalqura'), 'tabular', 'Umm al-Qura is tabular');
is($C->kind('chinese'), 'astronomical', 'Chinese is astronomical');
is($C->canonical('gregorian'), 'gregory', 'gregorian is an alias');
is($C->canonical('ISO8601'), 'gregory', 'iso8601 too, in any case');
is($C->canonical('ethiopic-amete-alem'), 'ethioaa', 'ethiopic-amete-alem');
is($C->canonical('islamicc'), 'islamic-civil', 'islamicc');
dies_like(sub { $C->name('mayan') }, qr/'mayan' is not a calendar: gregory, buddhist/, 'an unknown id names the ids');
is(join(' ', $C->eras('gregory')), 'bce ce', 'Gregorian eras');
is(join(' ', $C->eras('roc')), 'broc roc', 'ROC eras');
is(join(' ', $C->eras('islamic-civil')), 'ah', 'one Hijri era, as ICU reads it');
is(join(' ', $C->eras('coptic')), 'before-am am', 'Coptic eras');
is(join(' ', $C->eras('ethiopic')), 'aa am', 'Ethiopic eras');
is(join(' ', $C->eras('ethioaa')), 'aa', 'Amete Alem alone');
is(scalar(my @je = $C->eras('japanese')), 237, '237 Japanese eras');
is($je[-1], 'reiwa', 'the last is Reiwa');
is($je[232], 'meiji', 'Meiji is 232');
is($je[0], 'era0', 'the unnamed ones are numbered');
is($C->months_in_year('hebrew', 5784), 13, 'a Hebrew leap year has 13 months');
is($C->months_in_year('hebrew', 5785), 12, 'a common one 12');
is($C->months_in_year('coptic', 1740), 13, 'Coptic has 13');
is($C->days_in_month('coptic', 1739, 13), 6, 'Coptic month 13 has 6 days when the year leaves 3 by 4');
is($C->days_in_month('coptic', 1740, 13), 5, 'and 5 otherwise');
is($C->days_in_month('hebrew', 5784, 'M05L'), 30, 'Adar I by its code');
is($C->days_in_month('hebrew', 5784, 6), 30, 'and by its ordinal');
is($C->days_in_month('hebrew', 5784, 'M06'), 29, 'Adar II');
dies_like(sub { $C->days_in_month('hebrew', 5785, 'M05L') }, qr/has no month M05L/, 'no Adar I in a common year');
is($C->days_in_year('islamic-civil', 1445), 355, 'a Hijri leap year');
is($C->days_in_year('islamic-civil', 1446), 354, 'a common one');
is($C->days_in_year('islamic-civil', 1437), 354, '1437 AH (remainder 11 by the rule) is common: 14 October 2015 to 2 October 2016');
is($C->days_in_year('islamic-civil', 1436), 355, 'and 1436 is leap');
is($C->is_leap_year('islamic-civil', 1437), 0, 'is_leap_year agrees for 1437');
is($C->days_in_month('islamic-civil', 1437, 12), 29, 'so Dhu al-Hijjah 1437 has 29 days');
is($C->days_in_month('islamic-civil', 1436, 12), 30, 'and 1436 has 30');
is($C->days_in_year('persian', 2059), 365, '2059 AP is common where the 33-year rule alone would make it leap: ICU moves the leap year');
is($C->days_in_year('persian', 2060), 366, 'to 2060');
is($C->days_in_month('persian', 2060, 12), 30, 'so Esfand 2060 has 30 days');
is($C->days_in_month('persian', 2059, 12), 29, 'and Esfand 2059 29');
is($C->days_in_year('hebrew', 5784), 383, '5784 is a leap year of 383 days (16 September 2023 to 3 October 2024)');
is($C->days_in_year('persian', 1403), 366, '1403 AP is leap');
is($C->is_leap_year('persian', 1403), 1, 'is_leap_year');
is($C->is_leap_year('indian', 1946), 1, 'Saka 1946 is leap: it begins in Gregorian 2024');
is($C->month_code('hebrew', 5784, 6), 'M05L', 'month_code of Adar I');
is($C->month_code('hebrew', 5784, 7), 'M06', 'Adar II');
is($C->month_code('hebrew', 5785, 6), 'M06', 'Adar in a common year');
is($C->month_code('hebrew', 5784, 8), 'M07', 'Nisan is M07 either way');
is($C->month_code('gregory', 2026, 10), 'M10', 'Gregorian');
is($C->months_in_year('chinese', 2026), 12, 'the Chinese calendar is tabled (Phase 21)');

my $t = $K->new(year => 2026, month => 10, day => 15, hour => 12, zone => 'UTC');
is($t->calendar, 'gregory', 'a value is Gregorian by default');
my $h = $t->in_calendar('hebrew');
isa_ok($h, $K, 'in_calendar');
is($h->calendar, 'hebrew', 'the calendar');
is($h->epoch, $t->epoch, 'the same instant');
is($h->zone_name, 'UTC', 'the same zone');
is($h->iso8601, '2026-10-15T12:00:00Z', 'ISO 8601 is Gregorian by definition');
is($h->year, 5787, 'the Hebrew year');
is($h->month, 2, 'Heshvan is the second month');
is($h->day, 4, 'the day');
is($h->era, 'am', 'the era');
is($h->era_year, 5787, 'the year of the era');
is($h->month_code, 'M02', 'the month code');
is($h->is_leap_month, 0, 'not a leap month');
is($h->months_in_year, 13, '5787 is the 11th year of its cycle, so it has 13 months');
is($h->is_leap_year, 1, 'a leap year');
is($h->days_in_month, 30, 'Heshvan has 30 days in 5787');
is($h->days_in_year, 385, '5787 has 385 days');
is($h->day_of_year, 34, 'day of the year');
is($h->quarter, 1, 'quarter 1');
is($h->day_of_quarter, 34, 'day of the quarter');
is($h->days_in_quarter, 90, 'the days of the first three months');
is($h->related_year, 2026, 'related Gregorian year');
my $pagumen = $K->new(year => 1739, month => 13, day => 6, calendar => 'coptic');
is($pagumen->quarter, 5, 'a thirteenth month is quarter 5');
is($pagumen->day_of_quarter, 6, 'and its day of the quarter counts from its first');
is($pagumen->days_in_quarter, 6, 'the quarter is the month alone');
is($pagumen->iso8601, '2023-09-11T00:00:00Z', 'the sixth day of Pi Kogi Enavot 1739 is 11 September 2023');
is($h->cyclic_year, undef, 'no cyclic year outside the Chinese calendars');
is($h->in_calendar('chinese')->cyclic_year, 43, 'and 43 in them for 2026');
is($h->week, $t->week, 'the ISO week is Gregorian, always');
is($h->week_year, 2026, 'and its year');
is($h->day_of_week, 4, 'Thursday');
is($h->hour, 12, 'the clock is the clock');
is($h->in_calendar('gregory')->year, 2026, 'back to Gregorian');
is($h->in_calendar('iso8601')->calendar, 'gregory', 'through an alias');
is($h->in_zone('Asia/Tokyo')->calendar, 'hebrew', 'in_zone keeps the calendar');
is($h->in_locale('he')->calendar, 'hebrew', 'in_locale keeps the calendar');
is($t->in_calendar('hebrew') == $t, 1, 'equal as instants');
is($K->compare($h, $t), 0, 'compare is calendar blind');

my $leap = $K->new(year => 5784, month => 6, day => 30, calendar => 'hebrew');
is($leap->iso8601, '2024-03-10T00:00:00Z', 'new in a calendar: 30 Adar I 5784');
is($leap->month_code, 'M05L', 'a leap month');
is($leap->is_leap_month, 1, 'is_leap_month');
is($leap->months_in_year, 13, '13 months');
is($leap->quarter, 2, 'the sixth month is in quarter 2');
is($K->new(year => 5784, month_code => 'M05L', day => 30, calendar => 'hebrew')->iso8601, $leap->iso8601, 'by month code');
is($K->new(year => 5784, month_code => 'M06', day => 1, calendar => 'hebrew')->month, 7, 'M06 in a leap year is the seventh month');
is($K->new(year => 5785, month_code => 'M06', day => 1, calendar => 'hebrew')->month, 6, 'and the sixth in a common one');
dies_like(sub { $K->new(year => 5785, month_code => 'M05L', day => 1, calendar => 'hebrew') }, qr/has no month M05L/, 'no Adar I in 5785');
dies_like(sub { $K->new(year => 5785, month => 13, day => 1, calendar => 'hebrew') }, qr/has 12 months, not 13/, 'no 13th month in 5785');
dies_like(sub { $K->new(year => 5787, month => 2, day => 31, calendar => 'hebrew') }, qr/has 30 days, not 31/, 'Heshvan 5787 has 30 days');
dies_like(sub { $K->new(year => 2026, month => 10, day => 15, calendar => 'mayan') }, qr/is not a calendar/, 'an unknown calendar');
is($K->new(year => 2026, month => 10, day => 15, calendar => 'chinese')->iso8601, '2026-11-23T00:00:00Z', 'the 15th of the 10th month of 2026 is 23 November');
is($K->new(era => 'reiwa', era_year => 8, month => 10, day => 15, calendar => 'japanese')->iso8601, '2026-10-15T00:00:00Z', 'era and era_year');
is($K->new(era => 'bce', era_year => 44, month => 3, day => 15)->year, -43, 'bce in the Gregorian');
is($K->new(era => 'broc', era_year => 1, month => 1, day => 1, calendar => 'roc')->iso8601, '1911-01-01T00:00:00Z', 'the year before the republic');
dies_like(sub { $K->new(era => 'reiwa', month => 1, day => 1, calendar => 'japanese') }, qr/era and era_year go together/, 'era alone');
dies_like(sub { $K->new(era => 'reiwa', era_year => 1, year => 2019, month => 5, day => 1, calendar => 'japanese') }, qr/year cannot be given with era/, 'not with year');
dies_like(sub { $K->new(era => 'edo', era_year => 1, month => 1, day => 1, calendar => 'japanese') }, qr/has no era 'edo'/, 'an unknown era');
is($K->last_day_of_month(year => 5784, month => 6, calendar => 'hebrew')->day, 30, 'last_day_of_month in a calendar');
is($K->from_day_of_year(year => 5784, day_of_year => 383, calendar => 'hebrew')->iso8601, '2024-10-02T00:00:00Z', 'from_day_of_year: the last day of 5784');
dies_like(sub { $K->from_day_of_year(year => 5785, day_of_year => 356, calendar => 'hebrew') }, qr/has 355 days, not 356/, 'past the year');
is($K->from_iso_week(year => 2026, week => 42, day => 4, calendar => 'hebrew')->iso8601, '2026-10-15T00:00:00Z', 'from_iso_week is Gregorian with the calendar applied after');
is($K->from_iso_week(year => 2026, week => 42, day => 4, calendar => 'hebrew')->year, 5787, 'so the value reads in Hebrew');
is($K->now(calendar => 'persian')->calendar, 'persian', 'now takes a calendar');
is($K->today(calendar => 'coptic')->calendar, 'coptic', 'today too');
is($K->from_epoch(0, calendar => 'buddhist')->year, 2513, 'from_epoch: 1970 is 2513 BE');
is($K->from_epoch_millis(0, calendar => 'roc')->year, 59, 'from_epoch_millis: 1970 is Minguo 59');
is($K->parse('2026-10-15T00:00:00Z', calendar => 'islamic-civil')->year, 1448, 'parse reads ISO text and sets the calendar');
is($K->parse('2026-10-15T00:00:00Z', calendar => 'islamic-civil')->iso8601, '2026-10-15T00:00:00Z', 'the text was Gregorian');
is($K->strptime('23/07/1405', '%d/%m/%Y', calendar => 'persian')->iso8601, '2026-10-15T00:00:00Z', 'strptime reads the calendar\'s own fields (Phase 22)');

is($h->with(month => 1, day => 1)->iso8601, '2026-09-12T12:00:00Z', 'with in a calendar: 1 Tishri 5787 is 12 September 2026, the clock kept');
is($h->with(day => 'last')->day, 30, 'with day => last in the calendar');
is($h->with(year => 5784, month_code => 'M05L', day => 1)->month, 6, 'with month_code');
is($h->with(era => 'am', era_year => 5700)->year, 5700, 'with era and era_year');
is($h->with(day_of_year => 1)->iso8601, '2026-09-12T12:00:00Z', 'with day_of_year, the time kept');
is($h->with(day_of_week => 1)->iso8601, '2026-10-12T12:00:00Z', 'with day_of_week within the ISO week');
dies_like(sub { $h->with(week => 1) }, qr/week is the ISO week/, 'with week is refused on a non-Gregorian value');
dies_like(sub { $h->with(day => 31) }, qr/has 30 days, not 31/, 'the day is checked in the calendar');
is($t->with(era => 'bce', era_year => 1)->year, 0, 'era on a Gregorian value: 1 BCE is year 0');
is($t->with(month_code => 'M02')->month, 2, 'month_code on a Gregorian value');

for my $m (qw(to_date to_year_month format_relative)) {
    dies_like(sub { $h->$m() }, qr/in the hebrew calendar, comes in a later release/, "$m waits for a later release on a Hebrew value");
}
is($h->format('y'), '5787', 'format works in a calendar (Phase 22)');
is($h->ymd, '5787-02-04', 'ymd too');
is($h->plus(days => 1)->day, 5, 'arithmetic works in a calendar (Phase 20)');
is($h->rfc3339, '2026-10-15T12:00:00Z', 'rfc3339 is Gregorian and works');
is($h->epoch_millis, $t->epoch_millis, 'epoch works');
is(join(',', ($h->to_list)[3, 4, 5]), '15,9,126', 'to_list is localtime shaped, Gregorian');
is($h->minus_absolute($t)->total_seconds, 0, 'minus_absolute is elapsed time and works');

my $frozen = $h->FREEZE('any');
like($frozen, qr/^tk1 \d+ 0 UTC en hebrew$/, 'FREEZE names the calendar after the locale');
my $back = $K->THAW('any', $frozen);
is($back->calendar, 'hebrew', 'THAW restores it');
is($back->epoch, $h->epoch, 'and the instant');
is($K->THAW('any', $t->FREEZE('any'))->calendar, 'gregory', 'a Gregorian value freezes as before');
unlike($t->FREEZE('any'), qr/gregory/, 'with no calendar token');
is($K->THAW('any', 'tk1 1792022400 0 UTC')->calendar, 'gregory', 'a 0.01 string thaws Gregorian');
is($K->THAW('any', 'tk1 1792022400 0 UTC fr')->locale, 'fr', 'a 0.02 string with a locale thaws');
dies_like(sub { $K->THAW('any', 'tk1 1792022400 0 UTC en mayan') }, qr/unknown calendar/, 'an unknown calendar does not thaw');
require Storable;
is(Storable::thaw(Storable::freeze($h))->calendar, 'hebrew', 'Storable keeps the calendar');
is(Storable::thaw(Storable::freeze($h->in_locale('he')))->locale, 'he', 'and the locale');

{
    my $forged = bless \(my $bytes = ${ $t }), 'Time::Keeper';
    substr($bytes, (Time::Keeper::_value_layout())[3] + 1, 1) = chr(200);
    ok(!eval { $forged->year; 1 }, 'a calendar byte out of range is refused');
    like($@, qr/damaged/, 'as damaged');
}

done_testing;
