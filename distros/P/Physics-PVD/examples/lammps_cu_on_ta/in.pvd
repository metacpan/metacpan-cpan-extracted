# LAMMPS PVD Deposition Script — Generated by Physics::PVD
# Substrate: Ta (BCC), Deposit: Cu, T=300 K
# Uses fix deposit for proper atom insertion

units           metal
atom_style      atomic
boundary        p p f

# Create Ta substrate (BCC, a=3.3 Å)
lattice         bcc 3.3
region          box block 0 8 0 8 0 14
create_box      2 box
region          substrate_region block 0 8 0 8 0 4
create_atoms    1 region substrate_region

# Interatomic potential (file has elements: Cu Ta)
pair_style      eam/alloy
pair_coeff      * * /usr/share/lammps/potentials/CuTa.eam.alloy Ta Cu

# Define groups
group           substrate type 1
group           deposited type 2

# Fix bottom 2 layers of substrate (frozen)
region          bottom block INF INF INF INF INF 1.5
group           frozen region bottom
group           thermo_sub subtract substrate frozen

# Substrate thermalization (not frozen layer)
velocity        thermo_sub create 300 12345 dist gaussian
fix             thermostat thermo_sub nvt temp 300 300 0.1
fix             freeze frozen setforce 0.0 0.0 0.0

# Reflecting wall at top boundary
fix             wall all wall/reflect zhi EDGE

# Time integration for deposited atoms
timestep        0.002
fix             integrate deposited nve

# Deposition: insert Cu atoms from above with ~3 eV kinetic energy
# Rate: 1 atom every 100 steps, 50 atoms total
region          insert_region block 0 8 0 8 12 13.5 units lattice
fix             depo deposited deposit 50 2 100 12345 &
                region insert_region near 1.5 &
                vz -25.0 -25.0 vx 0.0 0.0 vy 0.0 0.0 &
                units lattice

# Output
thermo          500
thermo_style    custom step temp pe ke etotal press atoms
dump            film all atom 1000 dump.pvd.lammpstrj
dump_modify     film sort id

# Run deposition phase (50 atoms × 100 steps = 5000 steps + buffer)
run             7000

# Remove deposition fix, relax the film
unfix           depo
run             5000

# Final output
write_data      final.data
print           "PVD deposition complete: 50 Cu atoms on Ta substrate"
