# Claude Code — commit: skills/, agents/, hooks/, settings.json
# Ignore: local overrides, credentials, session data

# Tracked: shared config & extensibility
!/.claude/
.claude/*
!.claude/settings.json
!.claude/settings.local.json
!.claude/agents/
!.claude/agents/**
!.claude/rules/
!.claude/rules/**
!.claude/skills/
!.claude/skills/**
!.claude/hooks/
!.claude/hooks/**

# Local overrides (machine-specific)
.claude/*.local.*
.claude/local/

# Credentials & session state (never track)
.claude/.credentials.json
.claude/statsig/
.claude/todos/
.claude/projects/

# Perl / Dist::Zilla distribution

# Build artifacts
.build/
_build/
blib/
/Build
/Makefile
/pm_to_blib
/MANIFEST
/MANIFEST.bak
/MYMETA.*
*.o
*.bs

# Generated metadata
/META.json
/META.yml

# Coverage
/cover_db/

# Release artifacts (Dist-Name-X.Y.Z)
[Dd]ist-*/
Langertha-Knarr-*/
*.tar.gz

# Carton / Dependency Manager
/local/
/.carmel/
/cpanfile.snapshot

# Editor & IDE
*.swp
*.swo
*.bak
*.old
*~
.vscode/
.idea/
.history/
*.code-workspace

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.*
.envrc
!.env.example

# Local/test configs
knarr.yaml

# Docker
docker-compose.override.yml
docker-compose.override.yaml

# Devcontainer
.devcontainer.json

# karr materialized task view -- never commit
tasks/
config.yml
