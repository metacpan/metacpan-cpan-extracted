+    // nesting, so rounds are bounded by the number of groups.
+    int32_t maxRounds = context->sizingGroups.length + 2;
+    for (int32_t round = 0; round < maxRounds; ++round) {
+        if (!Clay__EqualizeSizingGroups(xAxis)) return;
+        Clay__PropagateSizesUp(xAxis);
+    }
+    context->errorHandler.errorHandlerFunction(CLAY__INIT(Clay_ErrorData) {
+        .errorType = CLAY_ERROR_TYPE_SIZING_GROUP_CYCLE,
+        .errorText = CLAY_STRING("Clay sizing groups did not converge: a member of one sizing group contains a member of another group whose other member contains a member of the first (cyclic sizing-group nesting)."),
+        .userData = context->errorHandler.userData });
+}
