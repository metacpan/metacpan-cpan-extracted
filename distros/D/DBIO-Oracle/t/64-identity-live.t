use strict;
use warnings;

use Test::More;
use Test::Exception;
use DBI;
use Scalar::Util ();
use DBIO::Optional::Dependencies ();

# LIVE (karr k41). A GENERATED ... AS IDENTITY column has no BEFORE INSERT
# trigger. create() on such a table gets its key from INSERT ... RETURNING;
# with _use_insert_returning(0) the storage has to read it back from a
# sequence, and the only sequence there is is the one Oracle keeps for the
# column (all_tab_identity_cols). The claim of this file: that path returns
# the key the server gave the row -- it neither dies with "No suitable
# BEFORE INSERT triggers found ... specify the correct sequence", which is
# a message about a trigger that cannot exist, nor returns a plausible key.

my ($dsn, $user, $pass) = @ENV{map { "DBIO_TEST_ORA_${_}" } qw/DSN USER PASS/};

plan skip_all => 'Set $ENV{DBIO_TEST_ORA_DSN}, _USER and _PASS to run this test'
  unless $dsn && defined $user && defined $pass;

plan skip_all => 'Test needs '
  . DBIO::Optional::Dependencies->req_missing_for('test_rdbms_oracle')
  unless DBIO::Optional::Dependencies->req_ok_for('test_rdbms_oracle');

alarm 300;

{
  package T::K41::Schema;
  use base 'DBIO::Schema';
  __PACKAGE__->load_components('Oracle');
  __PACKAGE__->storage_type('+DBIO::Oracle::Storage');
}
{
  package T::K41::Result::Ident;
  use base 'DBIO::Core';
  __PACKAGE__->table('k41_live_ident');
  __PACKAGE__->add_columns(
    id   => { data_type => 'integer', is_auto_increment => 1 },
    name => { data_type => 'varchar', size => 20, is_nullable => 1 },
  );
  __PACKAGE__->set_primary_key('id');
}
T::K41::Schema->register_class(Ident => 'T::K41::Result::Ident');

my $admin = DBI->connect($dsn, $user, $pass, { RaiseError => 1, PrintError => 0, AutoCommit => 1 });

plan skip_all => 'This test needs Oracle 12c or later: it creates an IDENTITY column'
  unless $admin->func('ora_server_version')->[0] >= 12;

sub wipe {
  eval { $admin->do('DROP TABLE "k41_live_ident" PURGE'); 1 }
    or $@ =~ /ORA-00942/ or die $@;
}
END { eval { wipe() } if $admin }

wipe();
$admin->do('CREATE TABLE "k41_live_ident" ('
  . ' "id" NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,'
  . ' "name" VARCHAR2(20))');

my $schema = T::K41::Schema->connect($dsn, $user, $pass);
my $rs     = $schema->resultset('Ident');

$schema->storage->_use_insert_returning(0);

my @rows = map { my $r = eval { $rs->create({ name => "row $_" }) }; $@ ? $@ : $r } 1, 2;

is_deeply [ map { Scalar::Util::blessed($_) && $_->isa("DBIO::Row") ? $_->id : "died: $_" } @rows ], [ 1, 2 ],
  'without RETURNING, create() on an IDENTITY table returns the key of the row';

is_deeply
  $admin->selectall_arrayref('SELECT "id", "name" FROM "k41_live_ident" ORDER BY "id"'),
  [ [ 1, 'row 1' ], [ 2, 'row 2' ] ],
  '... and those are the keys the server gave the rows';

$schema->storage->_use_insert_returning(1);
is $rs->create({ name => 'returning' })->id, 3,
  'with RETURNING it is unchanged';

# The table is dropped and created again in the same process: Oracle makes a new
# sequence (ISEQ$$_n) for the IDENTITY column. What the first connection found
# must not outlive it on the result class (karr k46, ORA-02289).
wipe();
$admin->do('CREATE TABLE "k41_live_ident" ('
  . ' "id" NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,'
  . ' "name" VARCHAR2(20))');

my $again = T::K41::Schema->connect($dsn, $user, $pass);
$again->storage->_use_insert_returning(0);
my $row = eval { $again->resultset('Ident')->create({ name => 'new table' }) };
is $row ? $row->id : "died: $@", 1,
  'without RETURNING, a table created again in the same process gets its new sequence read, not the first one (karr k46)';

done_testing;
