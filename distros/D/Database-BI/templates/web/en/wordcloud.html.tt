[%- WRAPPER 'web/en/layouts/default.html.tt' -%]

<style>
  /* HTML::TagCloud sets the font size of each word through its own tagcloudN
     classes; this page only supplies the frame, the spacing and the colours.
     The rules are scoped through #wordcloud because the module's own style
     block travels inside cloud_html, so it arrives after this one and would
     win a tie on #htmltagcloud alone. */
  #wordcloud #htmltagcloud {
    text-align: center;
    line-height: 2.1;
    padding: 1.5rem 1rem;
  }
  #wordcloud #htmltagcloud a { color: #2c3e7a; text-decoration: none; }
  #wordcloud #htmltagcloud a:hover,
  #wordcloud #htmltagcloud a:focus-visible { text-decoration: underline; }
  .wordcloud-help { color: #666; font-size: 0.9rem; }
  .wordcloud-counts { margin: 1.5rem 0; }
  .wordcloud-counts summary { cursor: pointer; color: #2c3e7a; }
  .wordcloud-counts table { border-collapse: collapse; margin-top: 0.5rem; }
  .wordcloud-counts th, .wordcloud-counts td {
    text-align: left;
    padding: 0.2rem 0.9rem 0.2rem 0;
    border-bottom: 1px solid #eee;
  }
  .wordcloud-empty { color: #666; }
  .chart-source {
    margin: 0.25rem 0 0;
    font-size: 0.82rem;
    color: #666;
    word-break: break-all;
  }
  .chart-source a { color: inherit; }
</style>

<nav class="back-link" aria-label="Breadcrumb">[% PROCESS "web/en/layouts/breadcrumb.html.tt" %]</nav>
[% PROCESS "web/en/layouts/view_context.html.tt" %]

<h2 class="graph-title">[% title | html %]</h2>

<div class="graph-export-bar">
  <button class="btn-graph-export" id="btn-copy-chart-link" onclick="navigator.clipboard.writeText(window.location.href).then(function(){var b=document.getElementById('btn-copy-chart-link');var t=b.textContent;b.textContent='Copied!';setTimeout(function(){b.textContent=t;},1500)}).catch(function(){})">&#x1F517; Copy link</button>
  <span class="graph-point-count">[% words.size %] of [% distinct_words %] different word[% IF distinct_words != 1 %]s[% END %] &middot; [% word_total %] word[% IF word_total != 1 %]s[% END %] in [% row_count %] row[% IF row_count != 1 %]s[% END %]</span>
</div>

[%- IF words.size -%]
<div id="wordcloud" class="wordcloud-container">
  [% cloud_html %]
</div>

<p class="wordcloud-help">The bigger a word, the more rows contain it.[% IF drill %] Click a word to open the rows that contain it.[% END %]</p>

<details class="wordcloud-counts">
  <summary>Word counts</summary>
  <table>
    <thead>
      <tr><th scope="col">Word</th><th scope="col">Rows</th></tr>
    </thead>
    <tbody>
      [%- FOREACH w IN words -%]
      <tr>
        <td>[% IF w.href %]<a href="[% w.href | html %]">[% w.word | html %]</a>[% ELSE %][% w.word | html %][% END %]</td>
        <td>[% w.count %]</td>
      </tr>
      [%- END -%]
    </tbody>
  </table>
</details>
[%- ELSE -%]
<p class="wordcloud-empty">No words: no row in this view has text in [% col | html %] at least [% minlen %] characters long. Choose another column, or set Shortest word to a smaller number.</p>
[%- END -%]

[% IF source_url %]
<p class="chart-source">Source: <a href="[% source_url | html %]" rel="noopener noreferrer">[% source_url | html %]</a></p>
<p class="chart-source">Accessed on [% source_accessed %]</p>
[% END %]

[%- END -%]
