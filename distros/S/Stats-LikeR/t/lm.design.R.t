#!/usr/bin/env perl
#
# lm()'s design matrix against R 4.6.1: which factor is coded in full without an
# intercept, a single-level factor, a factor crossed with itself, levels that
# only dropped rows hold, predict() of a function of a numeric crossed with a
# factor, a ':' inside a level, names that are characters, and a design too
# wide to fit.
#
# Provenance: every expected value is R 4.6.1 output (options(digits=17)) of
# lm()/predict() on the data below, generated by t/lm.design.R.R (run it with
# Rscript to regenerate the literals; this test never calls it).  The rules
# under test are those of R's src/library/stats/src/model.c: TermCode() and
# the no-intercept loop in modelmatrix() ("adjust the code for the first factor
# found so that it will be coded by dummy variables"), and the
# "contrasts can be applied only to factors with 2 or more levels" error of
# `contrasts<-`.  The NA-level case is the maintainer's audit repro; R's
# model.frame() is called with drop.unused.levels = TRUE by lm().
#
# Tolerance: 1e-9 relative.  The worst disagreement seen was 4e-15 on a double
# build; the headroom is for the near-collinear x:bu / x:bv columns, whose
# aliased member is decided by the rank test, not by the value.
require 5.010; use strict; use warnings FATAL => 'all';
use utf8;
use Test::More;
use Stats::LikeR;

sub near {
	my ($g, $w, $name) = @_;
	if ($w eq 'NaN') { ok($g != $g, "$name is NaN") or diag("got $g"); return }
	cmp_ok(abs($g - $w), '<=', 1e-9 * (abs($w) > 1 ? abs($w) : 1), $name) or diag("got $g want $w");
}

my %d = (
	y => [1.2,2.9,3.1,4.8,5.2,6.9,7.1,8.4,9.9,10.3,11.8,12.1],
	x => [1,2.5,3,4.5,5,6.5,7,8.5,9,10.5,11,12.5],
	z => [2,3,5,4,6,8,7,9,12,11,13,15.5],
	a => [('p','q','r') x 4],
	b => [('u') x 6, ('v') x 6],
	one => [('s') x 12],
);

# [ formula, R's coefficient names, R's coefficients (NA as 'NaN'), rank, df.residual ]
my @cases = (
	[ 'y~x+b:x-1', ['x', 'x:bu', 'x:bv'], [1.016362865621026, 0.045805809077769287, 'NaN'], 2, 10 ],
	[ 'y~x/a-1', ['x', 'x:ap', 'x:aq', 'x:ar'], [1.0207972270363954, -0.019966202105647202, 0.023523485658482418, 'NaN'], 3, 9 ],
	[ 'y~x+z+b:x-1', ['x', 'z', 'x:bu', 'x:bv'], [0.88063986935107808, 0.11672276638746155, 0.041461485682763324, 'NaN'], 3, 9 ],
	[ 'y~x+a:b-1', ['x', 'ap:bu', 'aq:bu', 'ar:bu', 'ap:bv', 'aq:bv', 'ar:bv'], [0.96016260162601619, 0.3595528455284579, 0.44939024390243953, 0.4392276422764238, 0.29857723577235973, 0.73841463414634434, 0.6782520325203274], 7, 5 ],
	[ 'y~a:b+x-1', ['x', 'ap:bu', 'aq:bu', 'ar:bu', 'ap:bv', 'aq:bv', 'ar:bv'], [0.96016260162601619, 0.3595528455284579, 0.44939024390243953, 0.4392276422764238, 0.29857723577235973, 0.73841463414634434, 0.6782520325203274], 7, 5 ],
	[ 'y~a+b-1', ['ap', 'aq', 'ar', 'bv'], [2.8916666666666666, 4.1166666666666654, 5.041666666666667, 5.9166666666666661], 4, 8 ],
	[ 'y~a*a', ['Intercept', 'aq', 'ar'], [5.8500000000000014, 1.2249999999999981, 2.1499999999999986], 3, 9 ],
	[ 'y~a:a', ['Intercept', 'aq', 'ar'], [5.8500000000000014, 1.2249999999999981, 2.1499999999999986], 3, 9 ],
	[ 'y~b+b*b', ['Intercept', 'bv'], [4.0166666666666666, 5.916666666666667], 2, 10 ],
	[ 'y~(a+b)^3', ['Intercept', 'aq', 'ar', 'bv', 'aq:bv', 'ar:bv'], [2.9999999999999996, 1.0499999999999989, 1.9999999999999998, 5.7000000000000002, 0.35000000000000114, 0.30000000000000004], 6, 6 ],
	[ 'y~a+a:a+x', ['Intercept', 'aq', 'ar', 'x'], [0.21292792792792409, 0.2446396396396408, 0.18927927927927984, 0.98036036036036067], 4, 8 ],
);
for my $c (@cases) {
	my ($f, $names, $coef, $rank, $df) = @$c;
	my $r = eval { lm(formula => $f, data => \%d) };
	ok($r, "$f: fits") or do { diag($@); next };
	is_deeply($r->{terms}, $names, "$f: coefficient names, in R's order");
	is($r->{rank}, $rank, "$f: rank");
	is($r->{df_residual}, $df, "$f: df_residual");
	near($r->{coefficients}{ $names->[$_] }, $coef->[$_], "$f: $names->[$_]") for 0 .. $#$names;
}

# a factor of one level is refused wherever it appears, as R does
for my $f ('y~one', 'y~one-1', 'y~a:one', 'y~x+one') {
	ok(!eval { lm(formula => $f, data => \%d); 1 }
	   && $@ =~ /contrasts can be applied only to factors with 2 or more levels/, "$f: refused");
}

# a level held only by rows dropped for an NA is no level (drop.unused.levels)
{
	my @want = (0.6604300598536933, -0.087696741299046949, 0.94081135003325167);
	for my $case (['NA in x', [1,2,undef,4,5,6.5,7,9,8,3]],
	              ['NA in y', [1,2,3,4,5,6.5,7,9,8,3]]) {
		my %data = (y => [1.1,3.2,2.1,5.3,4.4,7.2,6.1,9.5,8.3,3.3], a => [qw(q q p q r r q r q r)], x => $case->[1]);
		$data{y}[2] = undef if $case->[0] eq 'NA in y';
		for my $fn (['lm', sub { lm(formula => 'y~a+x', data => $_[0]) }],
		            ['glm', sub { glm(formula => 'y~a+x', data => $_[0]) }]) {
			my $r = $fn->[1]->(\%data);
			is_deeply($r->{terms}, ['Intercept', 'ar', 'x'], "$case->[0] $fn->[0]: no column for the level p");
			is_deeply($r->{xlevels}{a}, ['q', 'r'], "$case->[0] $fn->[0]: xlevels drops p");
			near($r->{coefficients}{Intercept}, $want[0], "$case->[0] $fn->[0]: Intercept");
			near($r->{coefficients}{ar}, $want[1], "$case->[0] $fn->[0]: ar");
			near($r->{coefficients}{x}, $want[2], "$case->[0] $fn->[0]: x");
		}
	}
}

# predict(): a function of a numeric crossed with a factor, and a ':' in a level
{
	my %nd = (x => [2.5,6.5,9.5], a => [qw(q p r)], z => [3.5,6,10]);
	my @want = (
		[ 'y~a*log(x)',    [2.2362318530315939, 7.3575294802755424, 10.074136032318178] ],
		[ 'y~exp(x/10):a', [3.3449601562398383, 6.0749061297064646, 9.166355855277649] ],
		[ 'y~sqrt(z):a',   [3.0502871510737819, 6.2967935473076082, 8.3011751469490491] ],
	);
	for my $w (@want) {
		my $m = lm(formula => $w->[0], data => \%d);
		my $p = eval { predict($m, \%nd) };
		ok($p, "predict $w->[0]") or do { diag($@); next };
		near($p->{ $_ + 1 }, $w->[1][$_], "predict $w->[0] row " . ($_ + 1)) for 0 .. 2;
	}
	my %dc = (%d, g => [('p', 'q:r', 's') x 4]);
	my $m = lm(formula => 'y~g*x', data => \%dc);
	my $p = predict($m, { x => [2.5,6.5,9.5], g => ['q:r', 'p', 's'] });
	near($p->{ $_ + 1 }, [2.7068047337278087, 6.5665803108808269, 9.6865284974093253]->[$_], 'predict, level "q:r": row ' . ($_ + 1)) for 0 .. 2;
}

# names are characters when the source is: a column and a level of Cyrillic and Latin-1 letters
{
	my %u = (y => [1,3,2,5,4,7,6,9,8,10], g => [('ж', 'я') x 5], "café" => [1,2,3,5,4,6.5,7,9,8,3]);
	my $r = lm(formula => 'y~g+café', data => \%u);
	is_deeply($r->{terms}, ['Intercept', 'gя', 'café'], 'characters: coefficient names');
	ok(exists $r->{coefficients}{'gя'} && exists $r->{coefficients}{'café'}, 'characters: found by their characters');
	is_deeply($r->{xlevels}{g}, ['ж', 'я'], 'characters: xlevels');
	ok(exists $r->{xlevels}{g} && !exists $r->{coefficients}{"g\xd1\x8f"}, 'characters: not their UTF-8 bytes');
	my $p = predict($r, { g => ['я'], 'café' => [2] });
	ok($p->{1} == $p->{1}, 'characters: predict finds both');
}

# a design too wide for X'X is refused before it is allocated: 15000 levels is
# 14999 columns, past the 13377 a double build allows (9459 for long double).
# The refusal is by column count, not by what the machine would grant.
{
	my $n = 15000;
	my %w = (y => [map { $_ % 7 } 1 .. $n], f => [map { "L$_" } 1 .. $n]);
	ok(!eval { lm(formula => 'y~f', data => \%w); 1 } && $@ =~ /design too wide/, 'lm: a design of 15000 columns is refused');
}
done_testing;
