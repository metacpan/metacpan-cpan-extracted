+// ---------------------------------------------------------------------------
+// Sizing groups. Elements that share a non-zero group id on an axis are
+// equalized to the largest member's size before that axis is distributed,
+// so a group behaves like one column (or row) of a table. FIXED and PERCENT
+// elements do not take part: their size does not depend on content.
+//
+// Equalization and upward propagation alternate until nothing changes,
+// because a group member can contain members of other groups (a grid in a
+// grid cell): equalizing the inner group widens the outer member's content.
+// Every step only raises sizes, and every member stays within its own max.
+// ---------------------------------------------------------------------------
+
+// True if the element takes part in a sizing group on this axis.
+bool Clay__IsSizingGroupMember(Clay_LayoutElement* element, bool xAxis) {
+    if (element->isTextElement) return false;
+    uint32_t groupId = xAxis ? element->config.sizingGroup.width : element->config.sizingGroup.height;
+    if (groupId == 0) return false;
+    Clay__SizingType sizingType = xAxis ? element->config.layout.sizing.width.type
+                                        : element->config.layout.sizing.height.type;
+    return sizingType != CLAY__SIZING_TYPE_FIXED && sizingType != CLAY__SIZING_TYPE_PERCENT;
+}
+
+// Finds or creates the entry for a group id (open addressing, linear probing).
+int32_t Clay__SizingGroupEntryIndex(uint32_t groupId) {
+    Clay_Context* context = Clay_GetCurrentContext();
+    uint32_t mask = (uint32_t)context->sizingGroupSlots.capacity - 1;
+    uint32_t slot = (groupId * 2654435761u) & mask;
+    while (true) {
+        int32_t entryIndex = context->sizingGroupSlots.internalArray[slot];
+        if (entryIndex == -1) {
+            entryIndex = context->sizingGroups.length;
+            Clay__SizingGroupEntryArray_Add(&context->sizingGroups, CLAY__INIT(Clay__SizingGroupEntry) { .id = groupId, .maxSize = 0 });
+            context->sizingGroupSlots.internalArray[slot] = entryIndex;
+            return entryIndex;
+        }
+        if (context->sizingGroups.internalArray[entryIndex].id == groupId) return entryIndex;
+        slot = (slot + 1) & mask;
+    }
+}
+
+// Records the group entry of every member on this axis: of the elements
+// declared this frame, not of the exiting copies after them. Returns false
+// when no element belongs to a group; the slot table is cleared only when
+// one does.
+bool Clay__CollectSizingGroups(bool xAxis) {
+    Clay_Context* context = Clay_GetCurrentContext();
+    context->sizingGroups.length = 0;
+    bool anyMember = false;
+    for (int32_t i = 0; i < context->layoutElements.length; ++i) {
+        context->sizingGroupOfElement.internalArray[i] = -1;
+        anyMember = anyMember || (i < context->declaredElementsLength
+            && Clay__IsSizingGroupMember(Clay_LayoutElementArray_Get(&context->layoutElements, i), xAxis));
+    }
+    if (!anyMember) return false;
+    for (int32_t i = 0; i < context->sizingGroupSlots.capacity; ++i) {
+        context->sizingGroupSlots.internalArray[i] = -1;
+    }
+    for (int32_t i = 0; i < context->declaredElementsLength; ++i) {
+        Clay_LayoutElement* element = Clay_LayoutElementArray_Get(&context->layoutElements, i);
+        if (!Clay__IsSizingGroupMember(element, xAxis)) continue;
+        uint32_t groupId = xAxis ? element->config.sizingGroup.width : element->config.sizingGroup.height;
+        context->sizingGroupOfElement.internalArray[i] = Clay__SizingGroupEntryIndex(groupId);
+    }
+    return true;
+}
+
+// Raises every member to its group's largest size, capped at the member's
+// own max (Clay__CloseElement has turned "no max" into CLAY__MAXFLOAT), and
+// its minimum to the group's largest minimum: when a parent is too small,
+// Clay compresses the members like any other children, and equal minimums
+// keep the members of one group aligned as long as their parents compress
+// alike (the rows of a grid do). Members with wrapping text therefore wrap
+// instead of pushing their parents wide. Returns true if any size or
+// minimum changed.
+bool Clay__EqualizeSizingGroups(bool xAxis) {
+    Clay_Context* context = Clay_GetCurrentContext();
+    for (int32_t g = 0; g < context->sizingGroups.length; ++g) {
+        context->sizingGroups.internalArray[g].maxSize = 0;
+        context->sizingGroups.internalArray[g].maxMinSize = 0;
+    }
+    for (int32_t i = 0; i < context->layoutElements.length; ++i) {
+        int32_t entryIndex = context->sizingGroupOfElement.internalArray[i];
+        if (entryIndex < 0) continue;
+        Clay_LayoutElement* element = Clay_LayoutElementArray_Get(&context->layoutElements, i);
+        Clay__SizingGroupEntry* entry = &context->sizingGroups.internalArray[entryIndex];
+        float size = xAxis ? element->dimensions.width : element->dimensions.height;
+        float minSize = xAxis ? element->minDimensions.width : element->minDimensions.height;
+        if (size > entry->maxSize) entry->maxSize = size;
+        if (minSize > entry->maxMinSize) entry->maxMinSize = minSize;
+    }
+
+    bool changed = false;
+    for (int32_t i = 0; i < context->layoutElements.length; ++i) {
+        int32_t entryIndex = context->sizingGroupOfElement.internalArray[i];
+        if (entryIndex < 0) continue;
+        Clay_LayoutElement* element = Clay_LayoutElementArray_Get(&context->layoutElements, i);
+        Clay__SizingGroupEntry* entry = &context->sizingGroups.internalArray[entryIndex];
+        float memberMax = xAxis ? element->config.layout.sizing.width.size.minMax.max
+                                : element->config.layout.sizing.height.size.minMax.max;
+        float target = CLAY__MIN(entry->maxSize, memberMax);
+        float minTarget = CLAY__MIN(entry->maxMinSize, memberMax);
+        float* dim    = xAxis ? &element->dimensions.width    : &element->dimensions.height;
+        float* minDim = xAxis ? &element->minDimensions.width : &element->minDimensions.height;
+        float* equalized = xAxis ? &context->sizingGroupSizeOfElement.internalArray[i].width
+                                 : &context->sizingGroupSizeOfElement.internalArray[i].height;
+        if (*dim < target) {
+            *dim = target;
+            changed = true;
+        }
+        if (*minDim < minTarget) {
+            *minDim = minTarget;
+            changed = true;
+        }
+        *equalized = *dim;
+    }
+    return changed;
+}
+
+// Re-aggregates the size and minimum size of every FIT or GROW container
+// on this axis from its children, exactly as Clay__CloseElement does, and
+// raises the container to the result (never lowers it). Walks elements in
+// reverse declaration order: children are declared after their parents,
+// so one sweep carries a change all the way up. Aspect-ratio elements are
+// left out on the Y axis, where their height is derived from their width.
+// Returns true if anything changed.
+bool Clay__PropagateSizesUp(bool xAxis) {
+    Clay_Context* context = Clay_GetCurrentContext();
+    bool changed = false;
+    for (int32_t i = context->layoutElements.length - 1; i >= 0; --i) {
+        Clay_LayoutElement* element = Clay_LayoutElementArray_Get(&context->layoutElements, i);
+        if (element->isTextElement || element->children.length == 0) continue;
+        Clay_SizingAxis sizing = xAxis ? element->config.layout.sizing.width
+                                       : element->config.layout.sizing.height;
+        if (sizing.type == CLAY__SIZING_TYPE_FIXED || sizing.type == CLAY__SIZING_TYPE_PERCENT) continue;
+        if (!xAxis && element->config.aspectRatio.aspectRatio != 0) continue;
+
+        Clay_LayoutConfig* layoutConfig = &element->config.layout;
+        bool alongAxis = (xAxis && layoutConfig->layoutDirection == CLAY_LEFT_TO_RIGHT)
+                      || (!xAxis && layoutConfig->layoutDirection == CLAY_TOP_TO_BOTTOM);
+        bool clipped = xAxis ? element->config.clip.horizontal : element->config.clip.vertical;
+        float padding = xAxis ? (float)(layoutConfig->padding.left + layoutConfig->padding.right)
+                              : (float)(layoutConfig->padding.top + layoutConfig->padding.bottom);
+        float content = alongAxis ? padding : 0;
+        float minContent = alongAxis ? padding : 0;
+        // Exiting copies take no space, as in Clay__SizeContainersAlongAxis: they keep the size of their last frame.
+        int32_t laidOutChildren = 0;
+        for (int32_t j = 0; j < element->children.length; ++j) {
+            Clay_LayoutElement* child = Clay_LayoutElementArray_Get(&context->layoutElements, element->children.elements[j]);
+            if (child->exiting) continue;
+            laidOutChildren++;
+            float childSize = xAxis ? child->dimensions.width : child->dimensions.height;
+            float childMin = xAxis ? child->minDimensions.width : child->minDimensions.height;
+            if (alongAxis) {
+                content += childSize;
+                if (!clipped) minContent += childMin;
+            } else {
+                content = CLAY__MAX(content, childSize + padding);
+                if (!clipped) minContent = CLAY__MAX(minContent, childMin + padding);
+            }
+        }
+        if (alongAxis) {
+            float childGaps = (float)(CLAY__MAX(laidOutChildren - 1, 0) * layoutConfig->childGap);
+            content += childGaps;
+            if (!clipped) minContent += childGaps;
+        }
+
+        float* dim    = xAxis ? &element->dimensions.width    : &element->dimensions.height;
+        float* minDim = xAxis ? &element->minDimensions.width : &element->minDimensions.height;
+        float newDim = CLAY__MIN(CLAY__MAX(content, sizing.size.minMax.min), sizing.size.minMax.max);
+        float newMin = CLAY__MIN(CLAY__MAX(minContent, sizing.size.minMax.min), sizing.size.minMax.max);
+        if (newDim > *dim) {
+            *dim = newDim;
+            changed = true;
+        }
+        if (newMin > *minDim) {
+            *minDim = newMin;
+            changed = true;
+        }
+    }
+    return changed;
+}
+
+// Restores every member (declared this frame) to at least the size it was
+// equalized to. Used by the second Clay__CalculateFinalLayout pass of a
+// frame: its height pass recomputes container heights from children and can
+// drop a member below the group size it received in the first pass.
+bool Clay__RestoreSizingGroupFloors(bool xAxis) {
+    Clay_Context* context = Clay_GetCurrentContext();
+    bool changed = false;
+    for (int32_t i = 0; i < context->declaredElementsLength; ++i) {
+        Clay_LayoutElement* element = Clay_LayoutElementArray_Get(&context->layoutElements, i);
+        if (!Clay__IsSizingGroupMember(element, xAxis)) continue;
+        float* dim  = xAxis ? &element->dimensions.width : &element->dimensions.height;
+        Clay_Dimensions equalized = context->sizingGroupSizeOfElement.internalArray[i];
+        float floor = xAxis ? equalized.width : equalized.height;
+        if (*dim < floor) {
+            *dim = floor;
+            changed = true;
+        }
+    }
+    return changed;
+}
+
+// Equalizes the sizing groups of one axis. Runs once per frame and axis:
+// Clay_EndLayout lays out twice when transitions exist, and the second
+// pass starts from the first pass's distributed sizes, where GROW members
+// have already grown - equalizing those again would make the result depend
+// on unrelated transitions. The second pass only restores members to the
+// group sizes of the first pass (recorded in sizingGroupSizeOfElement).
+void Clay__ApplySizingGroups(bool xAxis) {
+    Clay_Context* context = Clay_GetCurrentContext();
+    uint32_t* equalizedGeneration = xAxis ? &context->sizingGroupsGenerationX : &context->sizingGroupsGenerationY;
+    if (*equalizedGeneration == context->generation) {
+        if (Clay__RestoreSizingGroupFloors(xAxis)) {
+            Clay__PropagateSizesUp(xAxis);
+        }
+        return;
+    }
+    *equalizedGeneration = context->generation;
+    if (!Clay__CollectSizingGroups(xAxis)) return;
+
