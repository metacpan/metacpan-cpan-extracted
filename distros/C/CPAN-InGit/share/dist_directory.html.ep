<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= $title %></title>
</head>
<body>
  <main>
    <h1><%= $title %></h1>
% if ($parent) {
    <p><a href="<%= $parent %>">Parent directory</a></p>
% }
% if (@$views) {
    <p class="dist-views">
%   for my $view (@$views) {
      <a href="<%= $view->{url} %>"><%= $view->{name} %></a>
%   }
    </p>
% }
% if (@$links) {
    <ul>
%   for my $link (@$links) {
      <li><a href="<%= $link->{url} %>"><%= $link->{name} %></a></li>
%   }
    </ul>
% } else {
    <p>This directory is empty.</p>
% }
  </main>
</body>
</html>
