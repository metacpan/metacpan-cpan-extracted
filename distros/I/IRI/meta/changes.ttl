my:v_0-05
	a					doap:Version ;
	dcterms:isVersionOf my:project ;
	dcterms:replaces    my:v_0-04 ;
	doap:revision	"0.005" ;
	dc:issued	"2016-04-04"^^xsd:date ;
	dcs:changeset [
		dcs:item
			[ a dcs:Addition ; rdfs:label "Add ability to lazily parse IRI components." ],
			[ a dcs:Addition ; rdfs:label "Add cpanfile, with Module::Install deps (#5 from Alberto Simões)." ],
			[ a dcs:Addition ; rdfs:label "Added Try::Tiny to list of build requirements (github issue #3)." ],
			[ a dcs:Update ; rdfs:label "Improve performance of IRI component parsing." ],
			[ a dcs:Update ; rdfs:label "Updated required version of Type::Tiny to 0.008 to support use of InstanceOf (#7 from Alexandr Ciornii)." ],
			[ a dcs:Update ; rdfs:label "Update POD coverage test to ignore private attributes (#6 from Alberto Simões)." ]
	] ;
	.


