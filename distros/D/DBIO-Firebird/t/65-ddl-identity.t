use strict;
use warnings;
use Test::More;

# Offline: an is_auto_increment column is an IDENTITY column (karr k46).
#
# install_ddl used to ignore is_auto_increment, so a table deployed by this
# driver had no way to produce its own key. Firebird 3 (the driver's minimum
# since k36) has `GENERATED BY DEFAULT AS IDENTITY`; there is no trigger or
# generator form. Identity and DEFAULT exclude each other, and only an exact
# number type with scale 0 can carry it (SMALLINT, INTEGER, BIGINT, and
# NUMERIC / DECIMAL with scale 0 -- measured on Firebird 5.0.4, t/27): the
# other cases are refused, never simplified.

use DBIO::Core;
use DBIO::Schema;
use DBIO::Firebird::DDL;

sub ddl_for {
  my (%cols) = @_;
  my $pk = delete $cols{_pk};
  {
    no strict "refs";
    our $n; $n++;
    my $rc = "DBIO::Firebird::Test::K46::Result::T$n";
    my $sc = "DBIO::Firebird::Test::K46::S$n";
    @{"${rc}::ISA"} = ('DBIO::Core');
    @{"${sc}::ISA"} = ('DBIO::Schema');
    $rc->table("t$n");
    $rc->add_columns(map { ($_ => $cols{$_}) } sort keys %cols);
    $rc->set_primary_key(@$pk) if $pk;
    $sc->register_class(T => $rc);
    return DBIO::Firebird::DDL->install_ddl($sc);
  }
}

like ddl_for(id => { data_type => 'integer', is_auto_increment => 1 }, _pk => ['id']),
  qr/^  "id" INTEGER GENERATED BY DEFAULT AS IDENTITY NOT NULL,$/m,
  'integer auto_increment: IDENTITY, then NOT NULL';

like ddl_for(id => { data_type => 'bigint', is_auto_increment => 1 }, _pk => ['id']),
  qr/^  "id" BIGINT GENERATED BY DEFAULT AS IDENTITY NOT NULL,$/m,
  'bigint auto_increment';

like ddl_for(id => { data_type => 'smallint', is_auto_increment => 1 }, _pk => ['id']),
  qr/^  "id" SMALLINT GENERATED BY DEFAULT AS IDENTITY NOT NULL,$/m,
  'smallint auto_increment';

my $pk = ddl_for(id => { data_type => 'integer', is_auto_increment => 1 },
  name => { data_type => 'varchar', size => 10, is_nullable => 1 }, _pk => ['id']);
like $pk, qr/^  PRIMARY KEY \("id"\)$/m, 'PRIMARY KEY clause stays';
unlike $pk, qr/"name"[^\n]*IDENTITY/, 'other columns are untouched';

like ddl_for(id => { data_type => 'numeric', size => [9, 0], is_auto_increment => 1 }, _pk => ['id']),
  qr/^  "id" DECIMAL\(9,0\) GENERATED BY DEFAULT AS IDENTITY NOT NULL,$/m,
  'numeric(9,0) auto_increment';
like ddl_for(id => { data_type => 'decimal', size => [18, 0], is_auto_increment => 1 }, _pk => ['id']),
  qr/^  "id" DECIMAL\(18,0\) GENERATED BY DEFAULT AS IDENTITY NOT NULL,$/m,
  'decimal(18,0) auto_increment';
like ddl_for(id => { data_type => 'numeric', size => 9, is_auto_increment => 1 }, _pk => ['id']),
  qr/^  "id" DECIMAL\(9\) GENERATED BY DEFAULT AS IDENTITY NOT NULL,$/m,
  'numeric with a scalar size has scale 0';
for my $bad ([ numeric => [9, 2] ], [ decimal => undef ]) {
  eval { ddl_for(id => { data_type => $bad->[0], size => $bad->[1], is_auto_increment => 1 }, _pk => ['id']) };
  like $@, qr/IDENTITY.*scale 0/is,
    "$bad->[0] with a scale (or the default 18,6) is refused";
}

unlike ddl_for(id => { data_type => 'integer', is_auto_increment => 0 }, _pk => ['id']),
  qr/IDENTITY/, 'is_auto_increment => 0 is a plain column';

eval { ddl_for(id => { data_type => 'varchar', size => 10, is_auto_increment => 1 }, _pk => ['id']) };
like $@, qr/IDENTITY.*varchar|auto.increment.*integer/is, 'non-integer type refused';
isa_ok $@, 'DBIO::Exception';

eval { ddl_for(id => { data_type => 'integer', is_auto_increment => 1, default_value => 5 }, _pk => ['id']) };
like $@, qr/IDENTITY.*DEFAULT|DEFAULT.*IDENTITY/is, 'auto_increment with default_value refused';
isa_ok $@, 'DBIO::Exception';

done_testing;
