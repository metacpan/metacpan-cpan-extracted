#!/usr/bin/env bash
# vim: filetype=bash :  -*- mode: sh; sh-shell: bash; -*-

set -euo pipefail

define() { IFS= read -rd '' "$1" || : ; }

myname="${0##*/}"

define pod <<"=cut"

=encoding utf-8

=head1 NAME

nup - n-up, multi-column paged output for commands and files

=head1 SYNOPSIS

    nup [ options ] file ...
    nup -e [ options ] command ...

     -h  --help             show help
         --version          show version
     -d  --debug            debug mode
     -n  --dryrun           dry-run mode
     -e  --exec             execute command mode
         --alias=CMD=OPTS   set command alias
     -V  --parallel         parallel view mode
     -D  --document         document mode (default: on)
     -F  --no-paginate      disable page mode
     -A  --auto-paginate    auto disable page mode for single column
     -L  --lateral          pages or files in one row, scrolled sideways
     -H  --filename         show filename headers (default: on)
     -C  --pane=#[,#]       number of columns, and rows (e.g., 2,2)
     -P  --page=#           page height in lines
     -S  --pane-width=#     pane width (default: 85)
    --bs --border-style=#   border style (default: heavy-box)
    --ls --line-style=#     line style (none/truncate/wrap/wordwrap)
         --runin=#          run-in width for line breaking
         --runout=#         run-out width for line breaking
         --runlen=#         set both run-in and run-out
         --boundary=#       fold boundary: word, space or none
    --cm --colormap=#       color mapping (LABEL=COLOR)
         --[no-]page-number page number on border (default: on)
         --textconv[=EXT]   textconv for non-text files
    --hi --highlight[=#]    syntax highlight of files (default: on)
         --no-highlight     disable syntax highlight (--no-hi)
         --pager=#          pager command (empty to disable)
         --no-pager         disable pager
     -T  --device=#         output device: tty, pdf, or a paper for PDF
                            (e.g., a4, a4p, a3l)
     -o  --output=FILE      output file (PDF when it ends with .pdf)
         --pdf-opts=#       options for ansi2pdf (e.g., "-l 80")
         --geometry         print the size and the kind of the device
         --white-board      black on white board
         --black-board      white on black board
         --green-board      white on green board
         --slate-board      white on dark slate board

=head1 VERSION

Version 1.21

=cut

[[ $pod =~ Version\ +([0-9.]+) ]] && my_version=${BASH_REMATCH[1]}

##############################################################################
# Utility functions
##############################################################################

debug() {
    [[ ${debug:-} ]] && echo "debug: $*" >&2 || true
}

die() {
    echo "$myname: $*" >&2
    exit 1
}

# Check bash version (4.3+ required for getoptlong.sh)
if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 3))); then
    die "bash 4.3+ required (found $BASH_VERSION)"
fi

##############################################################################
# Option definitions
##############################################################################

define USAGE <<END
nup - n-up, multi-column paged output for commands and files

Usage: $myname [ options ] file ...
       $myname -e [ options ] command ...
END

declare -a up_opts=(--filename)  # up.pm options

# Default command aliases (command and options)
declare -A alias=(
    [bat]="bat --style=plain --color=always"
    [batcat]="batcat --style=plain --color=always"
    [mdcat]="mdcat --ansi"
    [rg]="rg --color=always"
    [tree]="tree -C"
)

# Highlighters (--highlight=NAME): the highlighter of
# Text::ANSI::Highlight, with its short name, and the command it runs
declare -A highlighter=(
    [pandoc]=pandoc
    [sourcehighlight]=source-highlight  [gnu]=source-highlight
    [skylighting]=skylighting           [sky]=skylighting
)

declare -A OPTS=(
    [&REQUIRE]=1.3.0 [&USAGE]="$USAGE" [&PERMUTE]= [&DELIM]=
    [         help | h   !        # show help         ]=
    [      version |     !        # show version      ]=
    [        debug | d            # debug mode        ]=
    [       dryrun | n            # dry-run mode      ]=
    [         exec | e            # execute command   ]=
    [        alias | %            # command aliases   ]=
    [     textconv |    :         # textconv          ]=pdf,docx,docm,pptx,pptm,xlsx,xlsm,jpg,jpeg
    [    highlight | hi ?         # syntax highlight  ]=pandoc
    [        pager |    :!        # pager command     ]=
    [       device | T  :>up_opts # output device     ]=
    [       output | o  :>up_opts # output file       ]=
    [     pdf-opts |    :>up_opts # ansi2pdf options  ]=
    [     geometry |     >up_opts # size of the device]=
    [     parallel | V            # parallel view     ]=
    [     document | D   >up_opts # document mode     ]=
    [     paginate |              # paginate mode     ]=1
    [         fold | F   !        # no paginate       ]=
    [auto-paginate | A   >up_opts # auto paginate     ]=
    [      lateral | L   >up_opts # pages in one row  ]=
    [     filename | H   >up_opts # show file headers ]=
    [         grid | G  :>up_opts # grid layout       ]=
    [         pane | C  :>up_opts # number of columns ]=
    [          row | R  :>up_opts # number of rows    ]=
    [         page | P  :>up_opts # page height       ]=
    [   pane-width | S  :>up_opts # pane width        ]=
    [ border-style | bs :>up_opts # border style      ]=
    [   line-style | ls :>up_opts # line style        ]=
    [        runin |    :>up_opts # run-in width      ]=
    [       runout |    :>up_opts # run-out width     ]=
    [       runlen |    :>up_opts # run-in and run-out]=
    [     boundary |    :>up_opts # fold boundary     ]=
    [     colormap | cm :>up_opts # color mapping     ]=
    [  page-number |              # page number       ]=1
    [  white-board |     >up_opts # black on white    ]=
    [  black-board |     >up_opts # white on black    ]=
    [  green-board |     >up_opts # white on green    ]=
    [  slate-board |     >up_opts # white on slate    ]=
)

##############################################################################
# Option callbacks
##############################################################################

# -h callback: show help from POD
help() {
    sed -E \
        -e '/^$/N' \
        -e 's/^(\n*)=head[0-9]* */\1/' \
        -e '/^\n*[#=]/d' \
        -e '/Version/q' \
        <<< "$pod"
    exit 0
}

# --version callback: show version
version() {
    echo "$my_version"
    exit 0
}

# --fold/-F callback: disable paginate; --no-fold re-enables
fold() {
    [[ ${fold:-} ]] && paginate= || paginate=1
}

# --pager callback: handle pager option
pager() {
    if [[ -z $2 ]]; then
        up_opts+=("--no-pager")
    else
        up_opts+=("--pager=$2")
    fi
}

##############################################################################
# Parse options
##############################################################################

# NUP_OPTS goes before the options on the command line, split on
# spaces (read does not expand file names), so that they win
if [[ ${NUP_OPTS:-} ]]; then
    read -ra nup_opts <<< "$NUP_OPTS"
    (( ${#nup_opts[@]} )) && set -- "${nup_opts[@]}" "$@"
fi

. getoptlong.sh OPTS "$@"

##############################################################################
# Main
##############################################################################

# --lateral puts on the right what does not fit the screen: the pages
# of one input, or the files side by side (the option only goes to
# up_opts, so look for it there, as for --geometry below)
lateral=
[[ " ${up_opts[*]} " =~ " "(-L|--lateral)" " ]] && lateral=1

# --parallel/-V: forward to ansicolumn via up.pm passthrough
[[ ${parallel:-} ]] && up_opts+=(-V)

# --page-number: show page number on border
[[ ${page_number:-} ]] && up_opts+=(--label S=" %n/%N ")

# Set defaults for less environment
export LESS="${LESS:--R}"
export LESSANSIENDCHARS="${LESSANSIENDCHARS:-mK}"

# --geometry: up.pm prints the size of the device and exits.  Nothing
# is read or run; the arguments are taken as those of file view mode,
# so that the options for ansicolumn count (nup --geometry - -w 100).
if [[ " ${up_opts[*]} " == *" --geometry "* ]]; then
    declare -a cmd=(optex -Mup "${up_opts[@]}" -- ansicolumn "$@")
    debug "command: ${cmd[*]}"
    [[ ${dryrun:-} ]] && { echo "${cmd[@]}"; exit; }
    exec "${cmd[@]}"
fi

# Show help if no arguments and stdin is a terminal
if (( $# == 0 )) && [[ -t 0 ]]; then
    help
fi

# Determine mode: command or file view
# Command mode if: -e specified, OR ($1 is not a file AND $1 is a command)
is_command_mode() {
    [[ ${exec:-} ]] && return 0
    [[ -f ${1:-} ]] && return 1
    command -v "${1:-}" >/dev/null 2>&1
}

# Expand command alias (command name + options)
expand_alias() {
    local cmd_name="${1##*/}"  # basename
    if [[ -v alias[$cmd_name] ]]; then
        echo "${alias[$cmd_name]}"
    else
        echo "$1"
    fi
}

# Check if any file matches comma-separated extension list
# Usage: match_ext "pdf,docx,xlsx" file1.pdf file2.txt
match_ext() {
    local ext_list="$1"; shift
    local ext
    for f in "$@"; do
        ext="${f##*.}"
        ext="${ext,,}"  # lowercase
        [[ ",$ext_list," == *,"$ext",* ]] && return 0
    done
    return 1
}

# Additional optex modules
declare -a optex_mod=()
if [[ -n $textconv && $textconv != none ]] && match_ext "$textconv" "$@"; then
    optex_mod+=(-Mtextconv)
fi

side_by_side=${parallel:-}
if is_command_mode "$@"; then
    # Command mode: use optex -Mup
    local_cmd="$1"; shift
    declare -a expanded_cmd
    read -ra expanded_cmd <<< "$(expand_alias "$local_cmd")"
    declare -a target=("${expanded_cmd[@]}" "$@")
else
    # File view mode: use ansicolumn via optex -Mup.  Only the
    # arguments before the first option are files; the options after
    # them are for ansicolumn (nup FILE -w 100).
    nfiles=0
    for arg; do [[ $arg == -?* ]] && break; (( ++nfiles )); done
    (( nfiles > 1 )) && side_by_side=1
    declare -a target=(ansicolumn "$@")
    # Syntax highlight, when the command of the highlighter is there:
    # up.pm gives the name to ansicolumn, which reads the files
    # in its colors (Text::ANSI::Highlight::IO).
    # $highlight has the name, pandoc when the option is not given
    # (the initial value); it is empty by --highlight without a name,
    # and unset by --no-highlight.
    if [[ -v highlight ]]; then
        : ${highlight:=pandoc}
        # a style of the highlighter can be after its name: NAME:STYLE
        [[ -v highlighter[${highlight%%:*}] ]] \
            || { echo "$myname: $highlight: unknown highlighter" >&2; exit 2; }
        if command -v "${highlighter[${highlight%%:*}]}" >/dev/null 2>&1; then
            up_opts+=("--highlight=$highlight")
        fi
    fi
fi

# The files side by side (-V or more than one file) have no pages
[[ $side_by_side ]] && paginate=

# They can be long, and the bottom border far below: the number is
# shown at the top as well, at the left, under the file name
[[ $side_by_side && ${page_number:-} ]] && up_opts+=(--label NW=" %n @1")

# One input without pages (-F) fills the columns of the screen, and
# there is nothing to put on the right: --lateral is turned off
[[ $lateral && -z ${paginate:-} && -z $side_by_side ]] && up_opts+=(--no-lateral)

# --lateral: the row goes on out of the screen, so the number has a
# mark on each side: a filled triangle where there is a pane in that
# direction (%L, %R), and an open one at the end of the row
if [[ $lateral ]]; then
    if [[ $side_by_side ]]; then
        up_opts+=(--label NW=" %L${page_number:+%n}%R @1")
    elif [[ ${paginate:-} ]]; then
        up_opts+=(--label S=" %L${page_number:+%n/%N}%R ")
    fi
    if [[ $side_by_side || ${paginate:-} ]]; then
        up_opts+=(--mark "LEFT=◂ " --mark "LEFT_END=◃ ")
        up_opts+=(--mark "RIGHT= ▸" --mark "RIGHT_END= ▹")
    fi
fi

# Disable page mode for --no-paginate/-F, or for parallel layout
# (-V or multiple files) which has no page structure
[[ -z ${paginate:-} ]] && up_opts+=(--no-paginate)

declare -a cmd=(optex "${optex_mod[@]}" -Mup "${up_opts[@]}" -- "${target[@]}")

debug "command: ${cmd[*]}"

[[ ${dryrun:-} ]] && { echo "${cmd[@]}"; exit; }

exec "${cmd[@]}"

: <<'=cut'

=head1 DESCRIPTION

B<N-up> (command: C<nup>) is a multi-column paged output tool.
It provides a convenient way to view files or run commands in
n-up layout using the L<App::optex::up> module through C<optex>.

=begin html

<p><img width="750" src="https://raw.githubusercontent.com/tecolicom/App-nup/main/images/nup.png"></p>

=end html

C<nup> automatically detects the mode based on the first argument:
if it is an existing file, n-up file view mode is used; if it is an
executable command, n-up command mode is used.  Use C<-e> option to
force command mode when needed.

In file view mode, C<nup> stops parsing its own options at the first
file name and hands the file names and everything after them to
L<ansicolumn> unchanged.  Options of C<ansicolumn> that C<nup> does
not provide can therefore be given after the file names:

    nup -C2 file1.txt file2.txt -w 170

Here C<-w 170> sets the output width for C<ansicolumn>.  To set the
width when no terminal is available, the C<COLUMNS> environment
variable works in both modes; see L</Terminal Size>.

=head1 OPTIONS

=head2 General Options

=over 4

=item B<-h>, B<--help>

Show help message.

=item B<--version>

Show version.

=item B<-d>, B<--debug>

Enable debug mode.

=item B<-n>, B<--dryrun>

Dry-run mode. Show the command without executing.

=item B<-e>, B<--exec>

Force command execution mode. Normally the mode is auto-detected,
but use this option when you want to execute a file as a command.

=item B<--alias>=I<NAME>=I<CMD> I<OPTS>...

Define command alias. When a command matches I<NAME>, it is replaced
by I<CMD> with specified I<OPTS>.  This can be used to add default
options or to substitute a different command.
Multiple C<--alias> options can be specified.

Default aliases:

    bat     bat --style=plain --color=always
    batcat  batcat --style=plain --color=always
    mdcat   mdcat --ansi
    rg      rg --color=always
    tree    tree -C

Example:

    nup --alias='grep=ggrep --color=always' grep pattern file

=item B<-V>, B<--parallel>

Enable parallel view mode for ansicolumn.  In this mode, each file
is displayed in its own column without pagination, similar to
C<--no-paginate>.  Automatically enabled when multiple files are
specified.  Single file or stdin input results in single column
output.

=item B<-D>, B<--document>

Enable document mode for ansicolumn.  This mode is optimized for
viewing documents with n-up page-based layout.  Enabled by default.
Use C<--no-document> to disable.

=for comment
--fold is accepted as an undocumented alias for backward compatibility

=item B<-F>, B<--no-paginate>

Disable page mode.  Without pagination, the entire content is
split evenly across columns.  Page mode is the default; use
B<--paginate> to re-enable if needed.

=item B<-A>, B<--auto-paginate>

Automatically disable page mode when only one column fits the
terminal.  This is useful when using C<nup> as C<MANPAGER>,
where single-column page splitting wastes space.

=item B<-L>, B<--lateral>

Put all the pages in one row, however wide it becomes, instead of
filling the screen with as many panes as fit and going on below.
The row is as high as the screen, and it is seen by scrolling
sideways in the pager.

The screen shows the same number of panes as without this option:
as many as fit, or the number given by C<-C>.  With C<-C4>, four
pages are on the screen at a time, each a quarter of it wide.

The page number has a triangle on each side, as C<◂ 2/12 ▸>, which
tells that the row can be scrolled in that direction: the triangle is
filled when there is a page there, and open at the end of the row
(C<◃ 1/12 ▸>).  They are the C<%L> and C<%R> of the C<--label> option
of C<ansicolumn>; give other marks by C<--mark>, after the file names
(C<--mark RIGHT=E<gt>E<gt> --mark RIGHT_END=>).

When the pager is C<less>, C<nup> adds
C<< -S --shift=I<N> --rscroll=- >> to it, where I<N> is the width of
a pane: the lines are not wrapped, and the right and left arrow keys
move by one page.

C<nup> also puts the following keys in the C<LESSKEY_CONTENT>
environment variable, which C<less> 661 or later reads.  With three panes on the
screen and a C<less> older than 710, they are:

    h , left      left-scroll         one page to the left
    l . right     right-scroll        one page to the right
    H g < K       no-scroll           the left end of the row
    L G > J       end-scroll          the right end of the row
    space j down  noaction ESC-) x 3  the panes on the screen to the right
    d ^D return
    b k up u ^U   noaction ESC-( x 3  the panes on the screen to the left

The pages have the height of the screen, and there is nothing to
scroll down to: C<j> and C<k>, the down and up arrows, C<d> and C<u>,
C<^D> and C<^U>, and the return key go on to the
next and the previous screen, as space and C<b> do.
C<noaction> does nothing and then types the keys after it, here
ESC-) three times.  It cannot type the arrow keys, so ESC-) and
ESC-( are given the same actions as the right and left arrow.  In
C<LESSKEY_CONTENT>, they are in one line, joined by C<;>, as
C<h left-scroll;l right-scroll;...>, and space is written C<\ >, a
backslash and a space.
With C<less> 710 or later, C<l>, C<.>, the right arrow and ESC-) are
C<right-limit-scroll>, which stops at the right end.  A count before
C<.> is taken for a decimal point of the number by C<less>; give it
to the right arrow instead, as C<3> and the right arrow.

The help of C<less> on C<h> and C<H> is then on no key, and C<g> and
C<G> no longer go to the first and the last line, which are on the
screen all the time anyway.

When C<LESSKEY_CONTENT> is set, the keys are added after it, in a
C<#command> section, so that they win over the same keys there and
in F<~/.lesskey>; the other keys stay as they are.

C<NUP_LESSKEY> gives the keys in place of those of C<nup>, in the
same way, and they do not change with the panes or the C<less>.  Set
it empty not to add any keys, and C<LESSKEY_CONTENT> is left as it
is:

    export NUP_LESSKEY=

The options are added to C<NUP_PAGER>, C<NUP_PAGE_PAGER> and
C<--pager> as well when the command is C<less>; another pager is used
as it is, and has to be told not to wrap the lines.

See L</"LESS INTEGRATION"> for what works with the versions of
C<less>, and for the build of C<less> in tecolicom/tap, with which
the screens are the same as without C<-L>.

    nup -L man perlfunc
    nup -L -C4 README.md

With more than one file, or C<-V>, the files side by side go on to
the right in the same way, instead of going on below: each file is a
column of its own, without pages, and as many columns as without this
option are on the screen.  The lines move up and down as usual, and
only C<h>, C<l>, C<,>, C<.>, the arrow keys, ESC-( and ESC-), C<H>,
C<L>, C<E<lt>> and C<E<gt>> are put in C<LESSKEY_CONTENT>, to move by one column and to
the ends; C<g> and C<G> go to the first and the last line.

    nup -L *.txt

With C<--no-paginate> and one input, which has nothing to put on the
right, this option is ignored.  It cannot be used with rows (C<-R>,
C<-C2,2>, C<-G>) or PDF output (C<-T>, C<-o> with C<.pdf>).
C<--auto-paginate> is ignored.  The pages are laid out once, for the
height of the terminal at that time.

=item B<-H>, B<--filename>

Show filename headers in file view mode. Enabled by default.
Use C<--no-filename> to disable.

=back

=head2 Layout Options

=over 4

=item B<-C> I<C>[,I<R>], B<--pane>=I<C>[,I<R>]

Set the number of columns (panes), and the number of rows when it is
given after a comma.  For example, C<-C2> creates 2 columns, and
C<-C2,3> creates 2 columns and 3 rows.

=item B<-R> I<N>, B<--row>=I<N>

Set the number of rows.
This option is kept for compatibility and may be removed in the
future.

=item B<-G> I<CxR>, B<--grid>=I<CxR>

Set grid layout.  C<-G2x3> is equivalent to C<-C2,3>.
This option is kept for compatibility and may be removed in the
future.

=item B<-P> I<N>, B<--page>=I<N>

Set the page height in lines.

=item B<-S> I<N>, B<--pane-width>=I<N>

Set the pane width in characters. Default is 85.

=back

=head2 Style Options

=over 4

=item B<--bs>=I<STYLE>, B<--border-style>=I<STYLE>

Set the border style. Default is C<heavy-box>.

=item B<--ls>=I<STYLE>, B<--line-style>=I<STYLE>

Set the line style. Available: C<none>, C<truncate>, C<wrap>, C<wordwrap>.

=item B<--runin>=I<N>, B<--runout>=I<N>, B<--runlen>=I<N>

Set the run-in and run-out widths that L<ansicolumn> uses for line
breaking (kinsoku) when it folds long lines.  C<--runlen> sets both.
They are given to ansicolumn after the values in F<~/.ansicolumnrc>,
so they take precedence.  Without them, ansicolumn uses the values in
F<~/.ansicolumnrc>, or 2.

=item B<--boundary>=C<word>|C<space>|C<none>

Set where L<ansicolumn> may break a line when it folds long lines, as
its C<--boundary> option: C<word> does not break inside an
alphanumeric word, C<space> not inside a sequence of non-space
characters, and C<none> breaks anywhere.  Like C<--runin>, it is
given to ansicolumn after F<~/.ansicolumnrc>.  Without it, ansicolumn
uses the value in the rc file, or C<word> in document mode.

=item B<--cm>=I<SPEC>, B<--colormap>=I<SPEC>

Set color mapping. Specify as C<LABEL=COLOR> (e.g., C<--cm=BORDER=R>).
Available labels: C<TEXT>, C<BORDER>.

=item B<-->[B<no->]B<page-number>

Show page number on the bottom border of each column, with the number
of all the pages, as C<3/12>.  With the
files side by side (more than one file, or C<-V>), which can be long,
it is shown on the top border as well, at the left, under the file
name.  Enabled by default.  Use
C<--no-page-number> to disable.

=item B<--white-board>, B<--black-board>, B<--green-board>, B<--slate-board>

Predefined color schemes for board-style display.

=back

=head2 Text Conversion

=over 4

=item B<--textconv>[=I<EXT,...>]

Enable text conversion for non-text files using
L<App::optex::textconv>.  When any of the specified file extensions
are found in the arguments, the C<textconv> module is loaded to
convert them to text before display.

Default extensions:
C<pdf,docx,docm,pptx,pptm,xlsx,xlsm,jpg,jpeg>.

Use C<--textconv=none> to disable.

=item B<--hi>, B<--highlight>[=I<NAME>], B<--no-highlight>

Color the source files by their syntax in file view mode.  Enabled
by default, and done when the command of the highlighter and
L<Text::ANSI::Highlight::IO> are installed; nothing changes without
them.
C<ansicolumn> reads each file through the highlighter, with the language
told from the name of the file, or from the first line of a script.
In a Markdown file, the code in a fence is colored by the language of
the fence.
A file whose language is not known is shown as it is, and so is a
file which has ANSI sequences already.  The file names in the headers
are not changed.

I<NAME> is the highlighter:

    pandoc                 pandoc, by its ansi writer (default)
    sourcehighlight, gnu   source-highlight of GNU Source-highlight,
                           the colors of less
    skylighting, sky       the skylighting command

    brew install pandoc
    brew install source-highlight
    brew install skylighting

A style of the highlighter can be given after the name and a colon,
a name of its own or a file: C<--highlight=pandoc:breezedark> for a
dark screen, C<--hi=gnu:esc256>.  See L<Text::ANSI::Highlight/STYLES>.

Set the one to use in C<NUP_OPTS>:

    export NUP_OPTS=--highlight=sourcehighlight

Use C<--no-highlight> to disable.  C<--hi> is the short name of the
option, and C<sky> and C<gnu> are those of the highlighters:
C<--hi=gnu>, C<--no-hi>.

=back

=head2 Pager Options

=over 4

=item B<--pager>=I<COMMAND>

Set the pager command. Default is C<NUP_PAGER> or C<less -F +Gg>.
When page mode is active, C<NUP_PAGE_PAGER> takes precedence over
C<NUP_PAGER>.
Viewing multiple files (or C<-V> parallel view) produces parallel
layout which has no page structure, so C<nup> disables page mode
and C<NUP_PAGE_PAGER> is not used there.
The C<PAGER> variable is not used to avoid an infinite loop when
C<PAGER> is set to C<nup>.
C<+Gg> makes C<less> read all input before displaying, so that C<-F>
and the percentage work; see L</"LESS INTEGRATION"> for the settings
of C<less>.

Use C<--pager=> (empty) or C<--no-pager> to disable pager.

=item B<--no-pager>

Disable pager.

=back

=head2 PDF Output

=over 4

=item B<-T> I<DEVICE>, B<--device>=I<DEVICE>

Set the device to show the output on.  The default is C<tty>, the
terminal.  Any other device is a paper, and the output is printed to
PDF by C<ansi2pdf>, instead of being shown on the terminal.

The name of a paper is the one for the C<-p> option of C<ansi2pdf>,
such as C<a4>, C<a3>, C<b5> or C<letter>.  A paper is used in
landscape orientation.  The letter C<p> or C<l> after the name gives
the orientation: C<a4p> is A4 in portrait, and C<a4l> is A4 in
landscape.  The device C<pdf> is the default paper of C<ansi2pdf>, A4.

    nup -T a4 man nup > nup.pdf     # A4, landscape
    nup -T a4p -C1 man nup | lpr    # A4, portrait

A sheet of paper takes the place of the terminal, and C<ansi2pdf>
takes the place of the pager.  The size of a sheet in columns and
lines is asked to C<ansi2pdf>, the output is formatted for that size
in the same way as for a terminal, and each screen is printed on a
sheet as it is.  The default is a landscape A4 sheet of 60 lines,
which has room for two panes of the default width.

=item B<-o> I<FILE>, B<--output>=I<FILE>

Write the output to I<FILE>.  When the name ends with C<.pdf>, the
output is PDF without C<-T> as well.

    nup -o nup.pdf man nup          # A4, landscape
    nup -T a3 -o nup.pdf man nup    # A3, landscape

Otherwise, what is shown on the terminal is written to the file as it
is, with the ANSI sequences and in the size of the terminal, and the
pager is not used.  C<-T tty> does so for a name ending with C<.pdf>
as well.

    nup -o nup.txt man nup          # the same as --no-pager > nup.txt

=item B<--geometry>

Print the size of the device in columns and lines and its kind,
C<tty> or C<pdf>, and exit.  No file is read and no command is run.

    $ nup -T a4p --geometry
    100 60 pdf
    $ nup -o nup.pdf -P 80 --geometry
    275 80 pdf

For a paper, the size is that of a sheet, which follows C<-T>, C<-o>,
C<-P>, the number of rows, C<--pdf-opts> and C<-w> of C<ansicolumn>
given after the file names.  For the terminal, it is the size of the
terminal.  This is for a program that formats text before giving it
to C<nup>, as L<mdee(1)|App::mdee> does.

=item B<--pdf-opts>=I<OPTIONS>

Give other options to C<ansi2pdf>, such as the number of lines on a
sheet, the margin and the fonts.  They are given after the paper, so
they take precedence.

    nup -o nup.pdf --pdf-opts='-l 80 -m 15' man nup

=back

The C<-P> option sets the number of lines of a page for PDF as well:
a sheet has that many lines for each row.  The C<-w> option of
C<ansicolumn>, given after the files or the command, sets the number
of columns of a sheet.  The font size follows them, and the one that
is not given is decided to fill the sheet.  With neither of them, a
sheet has 60 lines.

    nup -o nup.pdf -P 80 man nup         # 80 lines on a sheet
    nup -o nup.pdf -C2,2 -P 40 man nup   # 2x2 pages of 40 lines
    nup -o nup.pdf -C3 file -w 300       # 300 columns on a sheet

=head2 Terminal Size

The terminal size is taken from the controlling terminal
(C</dev/tty>).  When it is not available, as when C<nup> is run
without a terminal, the C<COLUMNS> environment variable gives the
width (default 80), and C<LINES> gives the height (default 24) used
to split the screen when the number of rows is set, as in C<-C2,2>:

    COLUMNS=170 nup -C2 file1.txt file2.txt

=head1 LESS INTEGRATION

C<nup> is made to be used with C<less>.  It sets environment
variables for C<less> (see L</ENVIRONMENT>), and adds options to it
for C<-L>.  Some of them need a recent version, and a patched build
of C<less> does more for the pages of C<nup>.

The pages fill the screen and go on below, and a line down would show
them cut in the middle.  So C<j> and C<k>, the down and up arrows,
C<d> and C<u>, C<^D> and C<^U>, and the return key
move by the screen, as space and C<b> do, when the output has pages
and the pager is C<less> 661 or later, and C<J> and C<K> go to the
last and the first page, as C<G> and C<g>.  The keys are put in
C<LESSKEY_CONTENT>, in the way C<-L> does, and not when C<NUP_LESSKEY>
is set.  Without pages (C<-F>, or the files side by side), they move
by the line as usual.  C<e> and C<y> are left to move by the line.

=head2 Versions

=over 4

=item C<less> 590

C<--file-size> makes C<less> read all input before displaying, as
C<+Gg> of the default pager does.  The C<less> 581 of macOS does not
have it, so C<+Gg> is the default.  Set C<NUP_PAGER> to use it:

    export NUP_PAGER="less --file-size"

=item C<less> 661

C<LESSKEY_CONTENT> is read, which C<-L> uses to put its keys:
C<h>, C<l>, C<,>, C<.>, the arrow keys, ESC-( and ESC-), C<H>, C<L>, C<g>, C<G>,
C<E<lt>>, C<E<gt>>, space, C<b>, C<j>, C<k>, C<d>, C<u>, C<^D>, C<^U>,
the return key, C<J> and C<K>.
Without C<-L>, the keys are C<j>, C<k>, the down and up arrows, C<d>,
C<u>, C<^D>, C<^U>, the return key, C<J> and C<K>.
An older C<less> ignores it.

=item C<less> 710

C<right-limit-scroll> stops at the right end of the lines.  C<-L>
puts it on C<l>, C<.>, the right arrow and ESC-), in place of C<right-scroll>,
which goes on past the end.

=back

C<-L> runs C<less --align-shift --version> to see the version of
C<less>, and whether it has the option below.

=head2 The Build in tecolicom/tap

L<tecolicom/tap|https://github.com/tecolicom/homebrew-tap> has a build
of C<less> with patches for the pages of C<nup>
(L<kaz-utashiro/less|https://github.com/kaz-utashiro/less>).  It adds
two options:

=over 4

=item B<--align-record>=I<N>

A search shows the whole record (page) that has the match from the
top of the screen, instead of the matching line, so that the pages
stay in place.  I<N> is the lines of a record; C<-1> is the height
of the screen less the prompt line, which is the height of the pages
of C<nup>.  A repeated search goes on from the next record.

=item B<--align-shift>

The horizontal shift stays at a multiple of the C<--shift> amount, the
width of a pane with C<-L>, so that the panes are always at the edge
of the screen.  C<-L> adds this option when the C<less> has it, and
the screens are then the same as without C<-L>: space, C<b>, C<G> and
C<E<gt>> move by the screens, the last screen shows the last pages
and the rest of it is blank, and C<n> and C<N> skip the matches on
the screen and move by the screens to the next page that has one.
C<l>, C<.> and the right arrow go on until the last page is at the left
edge.  For this, the keys of C<-L> are given a count instead of being repeated:
with three panes, space and C<b>, and the keys which do the same, are
C<3> ESC-) and C<3> ESC-(, and
C<G> and C<E<gt>> are C<3L>, while C<L> shows the end of the row at
the right edge of the screen.

=back

C<app-nup> of the tap has it inside, and C<nup> of C<app-nup> runs it.
It is put apart from the commands of Homebrew, so the C<less> of
Homebrew itself stays as it is.  To use it as C<less> outside of
C<nup>, install it on its own; it cannot be installed together with
the C<less> of Homebrew, which has the same command name:

    brew install tecolicom/tap/less

With either, use C<--align-record> for the pages:

    export NUP_PAGER="less --file-size"
    export NUP_PAGE_PAGER="less --file-size --align-record=-1"

=head1 ENVIRONMENT

=head2 Read by C<nup>

=over 4

=item C<NUP_OPTS>

Options given before those on the command line, separated by spaces,
so that the options on the command line take precedence.  This is
useful when C<nup> is called by another command, as C<MANPAGER>:

    NUP_OPTS=-L man perlfunc

=item C<NUP_PAGER>

The pager command, used when C<--pager> is not given.  Default:
C<less -F +Gg>.  See C<--pager> in L</"Pager Options">.

=item C<NUP_PAGE_PAGER>

The pager command in page mode, used in place of C<NUP_PAGER>.  See
C<--pager> in L</"Pager Options">.

=item C<NUP_LESSKEY>

The keys that C<-L> gives to C<less>, in place of those of C<nup>.
Empty for no keys.  See C<-L> in L</"General Options">.  When it is
set, the keys of the pages without C<-L> are not added either.

=item C<COLUMNS>, C<LINES>

The width and the height of the terminal when C</dev/tty> is not
available.  See L</Terminal Size>.

=back

C<PAGER> is not read, so that it can be set to C<nup>.

=head2 Set by C<nup>

These are set for C<less>, when they are not set already:

=over 4

=item C<LESS>

Default: C<-R>.  Required for ANSI color sequences.

=item C<LESSANSIENDCHARS>

Default: C<mK>.  Recognizes SGR (C<m>) and erase line (C<K>)
sequences.

=back

C<-L> adds its keys to C<LESSKEY_CONTENT>, after those already in
it.  See C<-L> in L</"General Options">.

=head1 EXAMPLES

Typical n-up usage:

    nup man nup                # view manual in n-up layout
    nup -C2 man perl           # 2 columns
    nup -C2,2 man perl         # 2x2 grid (4-up layout)
    nup -F man perl            # no pagination
    nup -L man perl            # one row of pages, scrolled sideways
    nup -L -C4 man perl        # four pages on the screen at a time
    nup -L *.txt               # files side by side, scrolled sideways
    nup file1.txt file2.txt    # view files side by side
    nup -C2 a.txt b.txt -w 170 # 2 columns, width 170 (ansicolumn -w)
    nup -e ./script.sh         # force command mode for a file
    nup -o nup.pdf man nup     # print to PDF (requires ansi2pdf)
    nup -T a4p -C1 file | lpr  # print on A4 in portrait

Using C<nup> as a C<MANPAGER>:

    export MANPAGER="nup -A"

=head1 INSTALLATION

=head2 Homebrew

Use L<tecolicom/tap|https://github.com/tecolicom/homebrew-tap>:

    brew tap tecolicom/tap
    brew install app-nup

It comes with the build of C<less> in the same tap, which C<nup> runs;
see L</"LESS INTEGRATION">.

=head2 CPAN

Using L<cpanminus|https://metacpan.org/pod/App::cpanminus>:

    cpanm -n App::nup

=head1 DIAGNOSTICS

Both stdout and stderr of the command are merged and passed through
the n-up output filter.  Error messages will appear in the paged output.

=head1 EXIT STATUS

The exit status of the executed command is not preserved because
the output is passed through a filter pipeline.

