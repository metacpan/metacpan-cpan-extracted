my %COX = (coef => 0.018720179204551463, loglik => -747.78935220773405);

# ---- logrank_test() against survdiff() ----
for my $name (sort keys %LR) {
	my $c = $LR{$name};
	my $d = $DATA{ $c->{data} };
	my $r = logrank_test($d->{time}, $d->{status}, $d->{group}, rho => $c->{rho});
	near($r->{statistic}, $c->{statistic}, "$name: statistic");
	is($r->{parameter}, $c->{parameter}, "$name: df");
	near($r->{p_value}, $c->{p}, "$name: p-value");
	is($r->{rho}, $c->{rho}, "$name: rho is reported");
	like($r->{method}, $c->{rho} == 0 ? qr/^Log-rank/ : qr/^G-rho/, "$name: method");
	# R orders the groups by sorted level, logrank_test() by first appearance
	my %at = map { ($r->{groups}[$_] => $_) } 0 .. $#{ $r->{groups} };
	is_deeply([ sort keys %at ], [ sort @{ $c->{levels} } ], "$name: the same groups");
	for my $i (0 .. $#{ $c->{levels} }) {
		my $k = $at{ $c->{levels}[$i] };
		near($r->{observed}[$k], $c->{observed}[$i], "$name: observed, group $c->{levels}[$i]");
		near($r->{expected}[$k], $c->{expected}[$i], "$name: expected, group $c->{levels}[$i]");
	}
}

# ---- survfit() against survfit(), 1/2-coded ----
{
	my $d = $DATA{lung_ecog};
	my $f = survfit($d->{time}, $d->{status}, group => $d->{group});
	is_deeply([ sort @{ $f->{groups} } ], [ sort keys %KM ], 'lung by ph.ecog: the same strata');
	for my $g (sort keys %KM) {
		my ($got, $want) = ($f->{strata}{$g}, $KM{$g});
		for my $k (qw(time n_risk n_event n_censor)) {
			is_deeply($got->{$k}, $want->{$k}, "ph.ecog $g: $k");
		}
		for my $k (qw(surv std_err lower upper)) {
			is(scalar @{ $got->{$k} }, scalar @{ $want->{$k} }, "ph.ecog $g: $k has R's length");
			near($got->{$k}[$_], $want->{$k}[$_], "ph.ecog $g: $k\[$_]") for 0 .. $#{ $want->{$k} };
		}
		near($got->{median}, $want->{median}, "ph.ecog $g: median");
		my $ev = 0; $ev += $_ for @{ $want->{n_event} };
		is($got->{events}, $ev, "ph.ecog $g: events");
	}
}

# ---- one group per row, and interleaved groups at tied times ----
# survfit() walks all strata in one pass since 0.331; each stratum must still be
# the curve its rows give on their own.
{
	my $d = $DATA{lung_ecog};
	my $all = survfit($d->{time}, $d->{status}, group => $d->{group});
	for my $g (sort keys %KM) {
		my @i = grep { $d->{group}[$_] eq $g } 0 .. $#{ $d->{time} };
		my $one = survfit([ @{ $d->{time} }[@i] ], [ @{ $d->{status} }[@i] ]);
		is_deeply($all->{strata}{$g}, $one->{strata}{''}, "ph.ecog $g: the same curve fitted alone");
	}
	my $each = survfit([ 3, 1, 2, 2, 1 ], [ 1, 0, 1, 1, 1 ], group => [qw(a b c d e)]);
	is_deeply([ map { $each->{strata}{$_}{surv}[0] } qw(a b c d e) ], [ 0, 1, 0, 0, 0 ],
		'one row per group: each curve is that row alone');
}

# ---- 0/1 and perl's booleans read as 1/2 does ----
{
	my $d = $DATA{lung_inst};
	my $r12 = logrank_test($d->{time}, $d->{status}, $d->{group});
	my $r01 = logrank_test($d->{time}, [ map { $_ - 1 } @{ $d->{status} } ], $d->{group});
	my $rtf = logrank_test($d->{time}, [ map { $_ == 2 } @{ $d->{status} } ], $d->{group});
	is($r01->{statistic}, $r12->{statistic}, 'lung: status 0/1 gives what 1/2 gives');
	is($rtf->{statistic}, $r12->{statistic}, "lung: perl's true and false give what 1/2 gives");
	my $f = survfit($d->{time}, [ map { $_ == 2 } @{ $d->{status} } ]);
	my $g = survfit($d->{time}, $d->{status});
	is_deeply($f, $g, "survfit: perl's true and false give what 1/2 gives");
	my $a = $DATA{lung_age};
	my $c12 = coxph($a->{time}, $a->{status}, $a->{age});
	my $ctf = coxph($a->{time}, [ map { $_ == 2 } @{ $a->{status} } ], $a->{age});
	is($ctf->{coef}[0], $c12->{coef}[0], "coxph: perl's true and false give what 1/2 gives");
}

# ---- a tied group column is read through FETCH ----
{
	package CountFetch;
	require Tie::Array;
	our @ISA = ('Tie::StdArray');
	our $fetches = 0;
	sub FETCH { $fetches++; my ($s, $i) = @_; $s->[$i] }
	package main;
	my $d = $DATA{ovarian};
	tie my @g, 'CountFetch';
	@g = @{ $d->{group} };
	$CountFetch::fetches = 0;
	my $r = logrank_test($d->{time}, $d->{status}, \@g);
	is($r->{statistic}, logrank_test(@{$d}{qw(time status group)})->{statistic}, 'tied group: the same test');
	is($CountFetch::fetches, scalar @g, 'tied group: each label fetched once');
}

# ---- coxph(): maxit past 65535 ----
{
	my $a = $DATA{lung_age};
	for my $opt (qw(maxit iter_max)) {
		my $c = coxph($a->{time}, $a->{status}, $a->{age}, $opt => 65536);
		near($c->{coef}[0], $COX{coef}, "$opt => 65536: coefficient");
		near($c->{loglik}, $COX{loglik}, "$opt => 65536: log-likelihood");
		ok($c->{iterations} > 0, "$opt => 65536: it iterated");
	}
}

