plan tests => 4 * scalar(@R_ROWS) + 3;

# The ovf.* rows' x, exactly: big-endian IEEE double bit patterns, printed by
# t/hist.R.R's last block.  perl 5.10's atof() reads a 17-digit decimal near
# 1e308 up to 5 ulp off, and pretty() turns that into an error of 1.5e-14 in a
# break near zero, so these x are not read from their decimals.
my %OVF_XBITS = (
	'ovf.todo'  => '7fee42d130773b76,ffee42d130773b76',
	'ovf.f1797' => 'ffeffcd7672f2096,7feddb680117aa8e',
	'ovf.f15'   => 'ffeab36d48e1acf0,7feddb680117aa8e',
	'ovf.f1'    => 'ffe1ccf385ebc8a0,7feddb680117aa8e',
);
# The ovf.* rows overflow only where an NV is a double.  A long-double or
# __float128 NV holds their range, so pretty() rightly answers something else
# there, and R has no wider build to say what.
my $NV_IS_DOUBLE = $Config{nvsize} == 8;

for my $r (@R_ROWS) {
	my ($nm, $nb, $xs, $breaks, $counts, $mids, $density) = @$r;
	my @x = split /,/, $xs;
	if ($nm =~ /^ovf\./) {
		SKIP: {
			skip "$nm: an NV wider than a double does not overflow on it", 4 unless $NV_IS_DOUBLE;
			@x = map { unpack 'd>', pack 'H16', $_ } split /,/, $OVF_XBITS{$nm};
			my $h = $nb ? hist(\@x, breaks => $nb) : hist(\@x);
			my $id = "$nm breaks=" . ($nb || 'default');
			vec_ok($h->{breaks},  $breaks,  "$id: breaks");
			is(join(',', @{$h->{counts}}), $counts, "$id: counts");
			# R's mids are 0.5 * (a + b), which overflows to -Inf or Inf on
			# some of these; hist() halves each break first instead (see
			# compute_hist_logic()), so the expected mids are built that way
			# from R's own breaks wherever R's overflowed.
			my @b = split /,/, $breaks;
			my @m = split /,/, $mids;
			for my $i (0 .. $#m) {
				$m[$i] = $b[$i] / 2 + $b[$i + 1] / 2 if $m[$i] =~ /Inf/;
			}
			vec_ok($h->{mids},    join(',', @m), "$id: mids");
			vec_ok($h->{density}, $density, "$id: density");
		}
		next;
	}
	my $h = $nb ? hist(\@x, breaks => $nb) : hist(\@x);
	my $id = "$nm breaks=" . ($nb || 'default');
	vec_ok($h->{breaks},  $breaks,  "$id: breaks");
	is(join(',', @{$h->{counts}}), $counts, "$id: counts");
	vec_ok($h->{mids},    $mids,    "$id: mids");
	vec_ok($h->{density}, $density, "$id: density");
}

# Structural invariants that hold whatever pretty() decides
{
	my $h = hist([1,2,2,3,4,7,9,10,11,15]);
	is(scalar @{$h->{breaks}}, scalar @{$h->{counts}} + 1,
	   'one more break than there are bins');
	is(scalar @{$h->{mids}}, scalar @{$h->{counts}},
	   'one midpoint per bin');
	my $total = 0;
	$total += $_ for @{$h->{counts}};
	is($total, 10, 'every observation lands in exactly one bin');
}

diag(sprintf('worst relative error: %.3g (limit %.3g)', $worst, $TOL));
