	[ 'cat', 7, 2.7445887445887447, 2, 0.2535246119016169, 4 ],
	[ 'cat', 8, 0.91992869875222816, 1, 0.3374936943411031, 3 ],
	[ 'cat', 10, 0.91992869875222816, 1, 0.3374936943411031, 3 ],
	[ 'two', 4, 0.26666666666666666, 0, 0, 2 ],
	[ 'two', 6, 0.26666666666666666, 0, 0, 2 ],
	[ 'two', 8, 0.26666666666666666, 0, 0, 2 ],
	[ 'two', 10, 0.26666666666666666, 0, 0, 2 ],
);

# [ set, g, statistic, df, p, G ]: hl.dropped(), where hoslem.test() is NaN or
# leaves a row out.  See WHERE IT DEPARTS above.
my @DIVERGE = (
	[ 'doc', 49, 52.401590927500187, 47, 0.27248613241380965, 49 ],
	[ 'cat', 9, 0.91992869875222816, 1, 0.33749369434110305, 3 ],
	[ 'zero', 5, 0.33333333333333337, 3, 0.95364217309625521, 5 ],
);

my %WORST = (stat => [ 0, '' ], p => [ 0, '' ]);
for my $r (@R_ROWS, @DIVERGE) {
	my ($set, $g, $stat, $df, $p, $G) = @$r;
	my ($h, $warn) = run_hl($set, g => $g);
	my $what = "$set, g = $g";
	rel_ok($h->{statistic}, $stat, $TOL_STAT, "$what: statistic");
	rel_ok($h->{'p_value'}, $p, $TOL_P, "$what: p-value");
	is($h->{parameter}, $df, "$what: df = G - 2 = $df");
	is($h->{groups}, $G, "$what: $G groups hold a row");
	is(scalar @{ $h->{table} }, $G, "$what: one table row per group");
	my $n = 0; $n += $_->{n} for @{ $h->{table} };
	is($n, scalar @{ $SETS{$set}[0] }, "$what: every row is binned");
	if ($G < $g) {
		is_deeply($warn, [ "hosmer_lemeshow: the data allowed $G of the $g groups requested\n" ],
			"$what: warns, as R does, that only $G of $g groups were possible");
	} else {
		is_deeply($warn, [], "$what: no warning");
	}
	for ([ stat => $h->{statistic}, $stat ], [ p => $h->{'p_value'}, $p ]) {
		my ($k, $got, $want) = @$_;
		next unless $want;
		my $e = abs($got - $want) / abs($want);
		$WORST{$k} = [ $e, $what ] if $e > $WORST{$k}[0];
	}
}
diag(sprintf 'worst relative error vs R: statistic %.2g (%s), p-value %.2g (%s)',
	map { @{ $WORST{$_} } } qw(stat p));

# hoslem.test()'s observed and expected table at the default g = 10, as
# [ rows, observed events, expected events ].
my @DOC_TABLE = (
	[ 50, 15, 12.61132554112562 ],
	[ 50, 12, 16.827260780780325 ],
	[ 50, 21, 19.650398443530371 ],
	[ 50, 21, 21.42059079664708 ],
	[ 50, 22, 23.30536115798348 ],
	[ 50, 28, 25.178121960563985 ],
	[ 50, 25, 27.130443750146352 ],
	[ 50, 32, 29.507379478210773 ],
	[ 50, 32, 32.33086450688301 ],
	[ 50, 37, 37.038253584130445 ],
);
{
	my ($h) = run_hl('doc');
	is($h->{groups}, 10, 'g defaults to 10');
	is(scalar @{ $h->{table} }, scalar @DOC_TABLE, 'default g: ten table rows');
	for my $i (0 .. $#DOC_TABLE) {
		my ($n, $o, $e) = @{ $DOC_TABLE[$i] };
		is($h->{table}[$i]{n}, $n, "group $i: $n rows");
		is($h->{table}[$i]{observed}, $o, "group $i: $o events observed");
		rel_ok($h->{table}[$i]{expected}, $e, $TOL_STAT, "group $i: expected events");
	}
}

# Where hoslem.test() stops: one bin holds every row.
for my $g (5, 7, 9) {
	throws_ok { run_hl('two', g => $g) } qr/^hosmer_lemeshow: the predictions allow only one group$/m,
		"two distinct predictions at g = $g: one group, an error as in R";
}
throws_ok { hosmer_lemeshow([0, 1, 1, 0], [(0.5) x 4], g => 3) }
	qr/^hosmer_lemeshow: every prediction is 0\.5, so there is only one group$/m,
	'identical predictions: one break, an error';

# An event where the prediction is exactly 0: R's (1 - 0)^2 / 0 is Inf, and so
# is this.
{
	my ($y, $p) = @{ $SETS{zero} };
	my @y = @$y; $y[0] = 1;
	my $h = hosmer_lemeshow(\@y, $p, g => 5);
	is($h->{statistic}, $INF, 'an event predicted at probability 0: the statistic is Inf');
	is($h->{'p_value'}, 0, '...and the p-value 0');
}

# Pairwise-complete rows: an undef or non-numeric outcome or prediction drops
# that row, which then matches the call without it.
{
	my ($y, $p) = @{ $SETS{tie} };
	local $SIG{__WARN__} = sub {};    # 4 of the 5 groups: tested above
	my $clean = hosmer_lemeshow($y, $p, g => 5);
	my $dirty = hosmer_lemeshow([ @$y, undef, 1, 'yes', 0 ], [ @$p, 0.5, undef, 0.25, 'NA' ], g => 5);
	is_deeply($dirty, $clean, 'undef and non-numeric cells drop their row');
}

# Argument validation.
throws_ok { hosmer_lemeshow([1, 0], [0.5]) } qr/same length/, 'length mismatch';
throws_ok { hosmer_lemeshow({}, [0.5]) } qr/array references/, 'observed is not an array';
throws_ok { hosmer_lemeshow([1], 'x') } qr/array references/, 'predicted is not an array';
for my $g (2, 3.5, 'ten', -4) {
	throws_ok { run_hl('doc', g => $g) } qr/g must be an integer of at least 3/,
		"g => '$g' is refused";
}
throws_ok { run_hl('two', g => 21) } qr/not enough complete observations for g=21/,
	'more groups than rows';

# Devel::Cover's own per-line counters are allocated inside whatever block is
# running and are reported as leaks, so the check is skipped under it.  The
# 'doc' set at g = 10 gives no warning and no croak.
no_leaks_ok {
	hosmer_lemeshow(@{ $SETS{doc} });
	eval { hosmer_lemeshow([0, 1, 1, 0], [(0.5) x 4], g => 3) };
} 'hosmer_lemeshow does not leak' unless $INC{'Devel/Cover.pm'};

done_testing();

