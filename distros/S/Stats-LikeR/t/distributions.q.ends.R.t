#!/usr/bin/env perl
# qnorm(), qt(), qchisq() and qf() at the ends of the probability range -- a p
# of 0 or 1, a log p of -Inf or 0 -- when a distribution parameter is invalid,
# degenerate or NaN, cross-validated against R.
#
# WHAT IS PINNED
#
# R answers the ends of the range before it validates the parameter in three of
# the four, and after it in the fourth. R 4.6.1, src/nmath:
#
#   qnorm.c   R_Q_P01_boundaries(p, ML_NEGINF, ML_POSINF), then sigma < 0
#   qt.c      R_Q_P01_boundaries(p, ML_NEGINF, ML_POSINF), then ndf <= 0
#   qgamma.c  R_Q_P01_boundaries(p, 0., ML_POSINF), then alpha < 0; qchisq.c
#             is qgamma(p, 0.5 * df, 2.0, ...)
#   qf.c      df1 <= 0 || df2 <= 0 first, then R_Q_P01_boundaries(p, 0, ML_POSINF)
#
# so qnorm(0, 0, -1) is -Inf, qt(1, 0) is Inf and qchisq(0, -1) is 0, where
# qf(0, -1, 2) is NaN. All four test ISNAN() on every argument before either
# check, so a NaN parameter is NaN even at an end. Up to 0.342 this module
# validated the parameter first in all four and returned NaN for every row of
# the first three: 104 of the rows below (48 of qnorm, 32 of qt and 24 of
# qchisq) fail against 0.342, counted by running this file against a build of
# it.
#
# An interior p (0.5, or a log p of -1) is crossed in beside the ends, to pin
# that the parameter check still fires there: NaN, except where the parameter
# is degenerate rather than invalid (sd = 0 is a step at the mean, a chi-square
# on df = 0 has all its mass at 0).
#
# PROVENANCE
#
# __DATA__ is a frozen table of R 4.6.2 (2026-10-29) results, generated by
# t/distributions.q.ends.R.R, committed beside this file, which says at its top
# how to re-run it. The order of checks above was read from the R 4.6.1 source
# tree; 4.6.2 is the R that was installed to run the generator. Each row is
# fn, the arguments (p, the parameters, then lower.tail and log.p as 1/0), and
# R's value.
#
# R's own suite does not pin these: tests/d-p-q-r-tst*.R and
# tests/reg-tests-*.R have qgamma(0.95, -2) (reg-tests-1a.R, an interior p) and
# the ends at valid parameters, and nothing at an end with an invalid one.
# SciPy is not a second reference here, because it disagrees with R on purpose:
# SciPy 1.18.1 validates the parameters first and returns nan for
# norm.ppf(0, 0, -1), t.ppf(0, -1), chi2.ppf(0, -1) and chi2.ppf(1, -1) alike.
# This module copies R.
#
# TOLERANCE
#
# None. Every value in the table is -Inf, Inf, NaN, 0 or the mean handed in
# (3), none of them computed, so each is compared with == (or, for NaN, with
# itself). Every finite argument is a short dyadic decimal -- 0, 0.5, 1, -1,
# -0.5, 2, 3, 5 -- which perl 5.10.1's atof reads exactly, so the table needs
# no "M/2^K" encoding as t/distributions.limits.R.t's does. Inf and NaN are
# built arithmetically by tok() rather than parsed from the string, which not
# every perl or libc numifies.

require 5.010;
use strict;
use warnings FATAL => 'all';
use Test::More;
use Stats::LikeR qw(qnorm qt qchisq qf);

my $INF = 9**9**9;
my $NAN = $INF - $INF;

sub tok {
	my ($t) = @_;
	return  $INF if $t eq 'Inf';
	return -$INF if $t eq '-Inf';
	return  $NAN if $t eq 'NaN';
	return $t + 0;
}

sub show { my ($v) = @_; return $v != $v ? 'NaN' : $v == $INF ? 'Inf' : $v == -$INF ? '-Inf' : "$v" }

sub same {
	my ($got, $want, $name) = @_;
	my $pass = ok(defined $got && ($want != $want ? $got != $got : $got == $want), $name);
	diag('got ' . (defined $got ? show($got) : 'undef') . ', R has ' . show($want)) unless $pass;
	return $pass;
}

# The arguments of a row are p, the parameters, lower.tail, log.p.  %POSITIONAL
# is the call as README writes it; %NAMED gives every parameter by name, out of
# order, with the long spelling of each flag.
my %POSITIONAL = (
	qnorm  => sub { qnorm($_[0], $_[1], $_[2], lower => $_[3], log => $_[4]) },
	qt     => sub { qt($_[0], $_[1], lower => $_[2], log => $_[3]) },
	qchisq => sub { qchisq($_[0], $_[1], lower => $_[2], log => $_[3]) },
	qf     => sub { qf($_[0], $_[1], $_[2], lower => $_[3], log => $_[4]) },
);
my %NAMED = (
	qnorm  => sub { qnorm($_[0], log_p => $_[4], sd => $_[2], lower_tail => $_[3], mean => $_[1]) },
	qt     => sub { qt($_[0], log_p => $_[3], lower_tail => $_[2], df => $_[1]) },
	qchisq => sub { qchisq($_[0], log_p => $_[3], lower_tail => $_[2], df => $_[1]) },
	qf     => sub { qf($_[0], df2 => $_[2], log_p => $_[4], df1 => $_[1], lower_tail => $_[3]) },
);

my (@rows, %group, @group_order);
while (my $line = <DATA>) {
	chomp $line;
	next unless length $line;
	my ($fn, $args, $value) = split /\t/, $line;
	my @tok = split /,/, $args;
	push @rows, [ $fn, \@tok, $value ];
	# everything but p: the rows of one group differ only in p, and go to the
	# function together as an array reference further down
	my $key = join ',', $fn, @tok[1 .. $#tok];
	push @group_order, $key unless $group{$key};
	push @{ $group{$key} }, [ $tok[0], $value ];
}

# The generator's own count, so a truncated __DATA__ cannot pass.
is(scalar @rows, 388, 'the table has all 388 rows the generator writes');

for my $r (@rows) {
	my ($fn, $tok, $value) = @$r;
	my @a = map { tok($_) } @$tok;
	my $label = "$fn(" . join(', ', @$tok) . ')';
	same($POSITIONAL{$fn}->(@a), tok($value), $label);
	same($NAMED{$fn}->(@a), tok($value), "$label, by name");
}

# The same rows through the array-reference form: the ends and the interior p
# of one parameter set in a single call, which must answer each element as the
# scalar call did.
for my $key (@group_order) {
	my ($fn, @rest) = split /,/, $key;
	my @ps = map { tok($_->[0]) } @{ $group{$key} };
	my $got = $POSITIONAL{$fn}->(\@ps, map { tok($_) } @rest);
	my $label = "$fn([" . join(', ', map { $_->[0] } @{ $group{$key} }) . '], ' . join(', ', @rest) . ')';
	if (ref $got ne 'ARRAY' || @$got != @ps) {
		fail("$label returns one value per p");
		next;
	}
	my @bad = grep { my $w = tok($group{$key}[$_][1]); !($w != $w ? $got->[$_] != $got->[$_] : $got->[$_] == $w) } 0 .. $#ps;
	ok(!@bad, $label) or diag("element(s) @bad: got " . join(', ', map { show($_) } @$got));
}

# With no flag given at all, which is the default path through dist_parse():
# the values are the lower = 1, log = 0 rows of the table.
{
	same(qnorm(0, 0, -1),      -$INF, 'qnorm(0, 0, -1) is -Inf');
	same(qnorm(1, 0, -1),       $INF, 'qnorm(1, 0, -1) is Inf');
	same(qnorm(0, sd => -1),   -$INF, 'qnorm(0, sd => -1) is -Inf');
	same(qnorm(0.5, sd => -1),  $NAN, 'qnorm(0.5, sd => -1) is still NaN');
	same(qt(0, -1),            -$INF, 'qt(0, -1) is -Inf');
	same(qt(1, 0),              $INF, 'qt(1, 0) is Inf');
	same(qt(0.5, 0),            $NAN, 'qt(0.5, 0) is still NaN');
	same(qchisq(0, -1),         0,    'qchisq(0, -1) is 0');
	same(qchisq(1, -1),         $INF, 'qchisq(1, -1) is Inf');
	same(qchisq(0.5, -1),       $NAN, 'qchisq(0.5, -1) is still NaN');
	same(qf(0, -1, 2),          $NAN, 'qf(0, -1, 2) is NaN: qf.c checks df first');
	same(qf(1, 2, -1),          $NAN, 'qf(1, 2, -1) is NaN');
	same(qf(0, 2, 5),           0,    'qf(0, 2, 5) is 0');
	same(qf(1, 2, 5),           $INF, 'qf(1, 2, 5) is Inf');
}

done_testing();

