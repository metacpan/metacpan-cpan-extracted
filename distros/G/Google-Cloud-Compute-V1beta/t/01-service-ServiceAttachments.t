subtest 'aggregated_list method' => sub {
    $client->transport->{mock_call} = sub {
        my ($args) = @_;
        is($args->{service}, 'google.cloud.compute.v1beta.ServiceAttachments', 'Correct service path');
        is($args->{method}, 'AggregatedList', 'Correct RPC method');
        isa_ok($args->{request}, 'Google::Cloud::Compute::V1beta::Compute::AggregatedListServiceAttachmentsRequest', 'Request object');
        
        my $response = 'Google::Cloud::Compute::V1beta::Compute::ServiceAttachmentAggregatedList'->new();
        return $response;
    };
    
    my $res = $client->aggregated_list();
    ok($res, 'Method returned a response');
    isa_ok($res, 'Google::Cloud::Compute::V1beta::Compute::ServiceAttachmentAggregatedList', 'Response object class');
    done_testing();
};

