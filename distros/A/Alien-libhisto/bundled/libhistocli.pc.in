prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: libhistocli
Description: Modular CLI and terminal formatting library for libhisto
Version: @PROJECT_VERSION@
URL: https://github.com/tsee/libhisto
Requires: libhisto
Libs: -L${libdir} -lhistocli
Cflags: -I${includedir}
