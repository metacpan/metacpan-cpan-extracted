[%- WRAPPER 'web/en/layouts/default.html.tt' -%]

<style>
  /* Quick-filter bar below the toolbar */
  .dash-add-filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin: 0.4rem 0 0.6rem;
  }
  .dash-add-filter select,
  .dash-add-filter input[type="text"] {
    padding: 0.25rem 0.45rem;
    border: 1px solid #bbb;
    border-radius: 4px;
    font-size: 0.82rem;
  }
  .btn-dash-filter-apply {
    padding: 0.28rem 0.75rem;
    border: 1px solid #888;
    border-radius: 6px;
    background: transparent;
    color: #444;
    font-size: 0.82rem;
    cursor: pointer;
    transition: background 0.12s;
  }
  .btn-dash-filter-apply:hover { background: #f0f0f0; }
  /* x-button inside active filter chips */
  .chip-remove {
    background: none;
    border: none;
    cursor: pointer;
    color: #7a5800;
    font-size: 0.75rem;
    padding: 0 0 0 0.3em;
    line-height: 1;
    vertical-align: middle;
  }
  .chip-remove:hover { color: #c00; }
  /* Schema-type-mismatch warnings from Database::Join */
  .schema-warnings {
    list-style: none;
    margin: 0.4rem 0 0.6rem;
    padding: 0.5rem 0.8rem;
    background: #fffbe6;
    border-left: 3px solid #f0a000;
    border-radius: 4px;
    font-size: 0.85rem;
    color: #5a4000;
  }
  .schema-warnings li + li { margin-top: 0.25rem; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .schema-warnings {
      background: #3a2e00;
      border-left-color: #f0c040;
      color: #f0d890;
    }
  }
  :root[data-theme="dark"] .schema-warnings {
    background: #3a2e00;
    border-left-color: #f0c040;
    color: #f0d890;
  }
  /* Pagination bar */
  .pagination {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem;
    margin: 0.8rem 0;
  }
  .page-btn {
    display: inline-block;
    padding: 0.3rem 0.65rem;
    border: 1px solid #bbb;
    border-radius: 4px;
    font-size: 0.85rem;
    color: #333;
    background: #fff;
    text-decoration: none;
    cursor: pointer;
  }
  a.page-btn:hover { background: #f0f0f0; border-color: #888; }
  .page-btn-cur {
    background: #0066cc;
    color: #fff;
    border-color: #0055aa;
    font-weight: 600;
    cursor: default;
  }
  .page-btn-dis { color: #aaa; background: #f8f8f8; cursor: default; }
  .page-info { font-size: 0.82rem; color: #555; margin-left: 0.5rem; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .page-btn {
      background: #1e1e1e; color: #ccc; border-color: #555;
    }
    :root:not([data-theme="light"]) a.page-btn:hover { background: #2a2a2a; }
    :root:not([data-theme="light"]) .page-btn-cur { background: #1a6bbf; color: #fff; }
    :root:not([data-theme="light"]) .page-btn-dis { background: #1a1a1a; color: #666; }
    :root:not([data-theme="light"]) .page-info { color: #999; }
  }
  :root[data-theme="dark"] .page-btn { background: #1e1e1e; color: #ccc; border-color: #555; }
  :root[data-theme="dark"] a.page-btn:hover { background: #2a2a2a; }
  :root[data-theme="dark"] .page-btn-cur { background: #1a6bbf; color: #fff; }
  :root[data-theme="dark"] .page-btn-dis { background: #1a1a1a; color: #666; }
  :root[data-theme="dark"] .page-info { color: #999; }
  /* Pivot table panel */
  .pivot-config {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.2rem;
    margin-bottom: 0.75rem;
  }
  .pivot-config-col {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 160px;
  }
  .pivot-config-wide { flex: 1 1 260px; }
  .pivot-config-col .btn-add-filter { align-self: flex-start; }
  .pivot-section-head {
    font-size: 0.8rem;
    font-weight: 600;
    color: #555;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.1rem;
  }
  .pivot-req { color: #c00; font-weight: 700; text-transform: none; letter-spacing: 0; }
  .pivot-opt { color: #888; font-weight: 400; text-transform: none; letter-spacing: 0; }
  .pivot-dim-row, .pivot-measure-row {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    flex-wrap: wrap;
  }
  .pivot-dim-row select,
  .pivot-measure-row select,
  .pivot-measure-row input[type="text"] {
    padding: 0.28rem 0.45rem;
    border: 1px solid #bbb;
    border-radius: 4px;
    font-size: 0.83rem;
  }
  .pivot-measure-row input[type="text"] { width: 80px; }
  .pivot-dim-list, .pivot-measure-list { display: flex; flex-direction: column; gap: 0.3rem; }
  .pivot-options-row {
    margin: 0.1rem 0 0.75rem;
    font-size: 0.88rem;
  }
  .btn-remove-pivot {
    background: none;
    border: 1px solid #bbb;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.75rem;
    padding: 0.2rem 0.45rem;
    color: #666;
    line-height: 1;
  }
  .btn-remove-pivot:hover { border-color: #c00; color: #c00; }
  .pivot-alias-label { font-size: 0.75rem; color: #888; white-space: nowrap; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .pivot-section-head { color: #999; }
    :root:not([data-theme="light"]) .pivot-dim-row select,
    :root:not([data-theme="light"]) .pivot-measure-row select,
    :root:not([data-theme="light"]) .pivot-measure-row input[type="text"] {
      background: #222; color: #ddd; border-color: #555;
    }
    :root:not([data-theme="light"]) .btn-remove-pivot { border-color: #555; color: #aaa; }
    :root:not([data-theme="light"]) .pivot-alias-label { color: #888; }
  }
  :root[data-theme="dark"] .pivot-section-head { color: #999; }
  :root[data-theme="dark"] .pivot-dim-row select,
  :root[data-theme="dark"] .pivot-measure-row select,
  :root[data-theme="dark"] .pivot-measure-row input[type="text"] {
    background: #222; color: #ddd; border-color: #555;
  }
  :root[data-theme="dark"] .btn-remove-pivot { border-color: #555; color: #aaa; }
  :root[data-theme="dark"] .pivot-alias-label { color: #888; }
</style>

[%- IF back_url -%]
<p class="back-link"><span><a href="/">&larr; Home</a> &rsaquo; <a href="[% back_url | html %]">[% back_label || 'Back' | html %]</a>[%- IF back2_url -%] &rsaquo; <a href="[% back2_url | html %]">[% back2_label || 'Back' | html %]</a>[%- END -%]</span>[%- IF left_spec -%]<span class="record-count">[% records.size %] record[% records.size != 1 ? 's' : '' %][%- IF join_summaries.size -%]&ensp;[%- FOREACH s IN join_summaries -%]<span class="join-chip">&#x2b; [% s.label | html %][% IF s.left_key %] <span class="join-chip-key">(on [% s.left_key | html %] = [% s.right_key | html %])</span>[% END %]</span>[%- END -%][%- END -%]</span>[%- END -%]</p>
[%- ELSE -%]
<p class="back-link"><span><a href="/">&larr; Choose another database</a></span>[%- IF left_spec -%]<span class="record-count">[% records.size %] record[% records.size != 1 ? 's' : '' %][%- IF join_summaries.size -%]&ensp;[%- FOREACH s IN join_summaries -%]<span class="join-chip">&#x2b; [% s.label | html %][% IF s.left_key %] <span class="join-chip-key">(on [% s.left_key | html %] = [% s.right_key | html %])</span>[% END %]</span>[%- END -%][%- END -%]</span>[%- END -%]</p>
[%- END -%]
[%- IF schema_warnings.size -%]
<ul class="schema-warnings" role="alert">
  [%- FOREACH w IN schema_warnings -%]
  <li>&#9888; [% w | html %]</li>
  [%- END -%]
</ul>
[%- END -%]

[%- IF left_spec -%]
<div class="toolbar">
  [%- IF filter_specs.size -%]
  <span class="filter-chips" id="filter-chip-row">
    [%- FOREACH fs IN filter_specs -%]
    <span class="filter-chip" data-spec="[% fs | html %]">[% fs | html %]<button class="chip-remove" title="Remove this filter" aria-label="Remove filter">&#x2715;</button></span>
    [%- END -%]
  </span>
  <a class="btn-clear-filters" id="btn-clear-filters" href="#">&#x2715; Clear filters</a>
  <button class="btn-copy-link" id="btn-copy-link" type="button"
          title="Copy the current URL to the clipboard so you can bookmark or share this filtered view">&#x1F517; Copy link</button>
  [%- END -%]
  [%- IF left_spec -%]
  <button class="btn-export-open" id="btn-export-open" type="button">&#x2193; Export&hellip;</button>
  <button class="btn-refresh" id="btn-refresh" type="button"
          title="Reload the data from disc - use this after the source file has changed">&#x21BB; Refresh</button>
  <button class="btn-delete-sel" id="btn-delete-sel" type="button" hidden
          title="Remove the selected rows and/or columns from this view">&#x1F5D1; Delete selected</button>
  <span class="toolbar-sep" role="separator" aria-hidden="true"></span>
  <button class="btn-graph" id="btn-graph" type="button"
          title="Plot the current data as a line chart - choose the X and Y axes">&#x1F4C8; Line graph&hellip;</button>
  <button class="btn-pie" id="btn-pie" type="button"
          title="Plot the current data as a pie chart - choose the category and value columns">&#x25D4; Pie chart&hellip;</button>
  <button class="btn-heatmap" id="btn-heatmap" type="button"
          title="Plot the current data as a heatmap - choose two categorical columns and an optional value column">&#x229F; Heatmap&hellip;</button>
  <button class="btn-bar" id="btn-bar" type="button"
          title="Plot the current data as a bar chart - choose a category column and an optional value column">&#x1F4CA; Bar chart&hellip;</button>
  <button class="btn-stacked" id="btn-stacked" type="button"
          title="Plot the current data as a stacked bar chart - choose category, segment, and optional value columns">&#x1F4CA; Stacked bar&hellip;</button>
  <button class="btn-scatter" id="btn-scatter" type="button"
          title="Plot two numeric columns as a scatter plot - both axes must be numeric">&#x2B1C; Scatter&hellip;</button>
  <button class="btn-combo" id="btn-combo" type="button"
          title="Plot two numeric series as a combo bar+line chart - choose the X axis and two numeric columns">&#x1F4C9; Combo chart&hellip;</button>
  <button class="btn-treemap" id="btn-treemap" type="button"
          title="Plot the current data as a treemap - choose a category column and an optional value column">&#x25A0; Treemap&hellip;</button>
  <button class="btn-histogram" id="btn-histogram" type="button"
          title="Plot the distribution of a numeric column as a histogram">&#x1F4CA; Histogram&hellip;</button>
  <button class="btn-map" id="btn-map" type="button"
          title="Plot the current rows on a map - use latitude and longitude columns, or geocode a place-name column">&#x1F5FA; Map&hellip;</button>
  <span class="toolbar-sep" role="separator" aria-hidden="true"></span>
  <button class="btn-folder" id="btn-folder" type="button"
          title="Browse records grouped by the letter prefix of a code column (e.g. Order # A10, B3, CT4)">&#x1F4C1; Folder view&hellip;</button>
  <button class="btn-pivot" id="btn-pivot" type="button"
          title="Summarise the data as a pivot table - group by row and column dimensions and compute aggregates">&#x25A6; Pivot table&hellip;</button>
  <button class="btn-stats" id="btn-stats" type="button"
          title="Show column statistics: row count, nulls, distinct values, numeric min, max, mean and median">&#x03A3; Column stats</button>
  <span class="toolbar-sep" role="separator" aria-hidden="true"></span>
  <button class="btn-calc" id="btn-calc" type="button"
          title="Add virtual columns computed from expressions (e.g. revenue-cost). Saved fields are applied automatically whenever this data source is opened.">&fnof;(x) Calc fields&hellip;</button>
  <button class="btn-groups" id="btn-groups" type="button"
          title="Map column values to group labels (e.g. North+East = Northern). The virtual col_group column can then be used in charts and pivots.">&#x25BC; Group values&hellip;</button>
  <button class="btn-dates" id="btn-dates" type="button"
          title="Tell the app how date columns are formatted so YEAR(), MONTH() and date sorting work correctly. Saved patterns apply automatically.">&#x1F4C5; Date format&hellip;</button>
  <span class="toolbar-sep" role="separator" aria-hidden="true"></span>
  <button class="btn-save-analysis" id="btn-save-analysis" type="button"
          title="A canvas is a dashboard where you can arrange multiple charts and data views side by side. Click to create one and add the current view.">&#x1F4BE; New canvas&hellip;</button>
  [%- END -%]
  <span class="toolbar-sep" role="separator" aria-hidden="true"></span>
  <button class="btn-dedup[% IF dedup %] btn-dedup--active[% END %]" id="btn-dedup" type="button"
          title="Remove duplicate rows from the view and from any export">[% IF dedup %]Show duplicates[% ELSE %]Hide duplicates[% END %]</button>
  <label class="lbl-totals" id="lbl-totals" title="Show a totals row at the bottom of the table &mdash; sums any numeric column">
    <input type="checkbox" id="chk-totals"> Totals
  </label>
  <button class="btn-add-db" id="btn-add-db" type="button" title="Combine this table with another data file, or narrow down the rows you see by applying conditions">&#x2295; Merge / Filter&hellip;</button>
  <button class="btn-combine" id="btn-combine" type="button" title="Stack rows from another data file beneath these rows, using a unified set of columns and leaving blanks where a column does not exist in a given file">&#x229E; Combine data&hellip;</button>
</div>

[%- IF left_spec -%]
<div class="dash-add-filter" id="dash-add-filter">
  <select id="dash-f-col" aria-label="Column to filter">
    <option value="">&#x2014; filter column &#x2014;</option>
    [%- FOREACH col IN columns -%]
    <option value="[% col | html %]">[% col | html %]</option>
    [%- END -%]
  </select>
  <select id="dash-f-op" aria-label="Filter operator">
    <option value="eq">equals</option>
    <option value="ne">not equals</option>
    <option value="contains">contains</option>
    <option value="starts">starts with</option>
    <option value="lt">less than</option>
    <option value="le">less or equal</option>
    <option value="gt">greater than</option>
    <option value="ge">greater or equal</option>
    <option value="empty">is empty</option>
    <option value="notempty">is not empty</option>
  </select>
  <input type="text" id="dash-f-val" placeholder="value" aria-label="Filter value">
  <button id="dash-f-apply" class="btn-dash-filter-apply">Apply filter</button>
</div>
[%- END -%]

[%- IF left_spec -%]
<div class="export-panel" id="export-panel"
     data-left-spec="[% left_spec | html %]"
     data-default-dir="[% download_dir | html %]"
     hidden>
  <h3 class="export-panel-title">&#x2193; Save export</h3>

  <div class="export-dir-bar">
    <input type="text" id="export-dir-inp" autocomplete="off" spellcheck="false"
           value="[% download_dir | html %]" aria-label="Output directory">
    <button type="button" class="btn-dir-up" id="export-dir-up" disabled
            title="Go to parent directory">&#x2191; Up</button>
  </div>

  <div class="export-dir-browser" id="export-dir-browser">
    <span class="export-dir-msg">Loading&hellip;</span>
  </div>

  <div class="export-filename-row">
    <label for="export-filename-inp">Filename</label>
    <input type="text" id="export-filename-inp" autocomplete="off" spellcheck="false"
           placeholder="output.csv">
    <span class="export-format-badge unknown" id="export-format-badge">CSV</span>
  </div>

  <div class="join-actions">
    <button type="button" id="btn-cancel-export" class="btn-secondary">Cancel</button>
    <button type="button" id="btn-do-export" class="btn-primary" disabled>Save</button>
  </div>

  <p class="export-result" id="export-result" hidden></p>
</div>
[%- END -%]

[%- IF left_spec -%]
<div class="save-analysis-panel panel-section" id="save-analysis-panel"
     data-left-spec="[% left_spec | html %]" hidden>
  <h3 class="panel-title">&#x1F4BE; New canvas</h3>
  <div class="panel-row">
    <label for="save-analysis-name-inp">Canvas name</label>
    <input type="text" id="save-analysis-name-inp" class="panel-text-inp"
           placeholder="My analysis" autocomplete="off" maxlength="120">
  </div>
  <div class="panel-btn-row">
    <button type="button" id="btn-do-save-analysis" class="btn-primary" disabled>Save</button>
    <button type="button" id="btn-cancel-save-analysis" class="btn-secondary">Cancel</button>
    <a id="save-analysis-link" href="#" hidden style="margin-left:1em;font-size:0.9em">&#x1F517; Open canvas</a>
  </div>
  <p id="save-analysis-msg" class="export-result" hidden></p>
</div>
[%- END -%]

<div class="join-panel" id="join-panel"
     data-current-label="[% title | html %]"
     hidden>
  <script>window.__biFilters = [% filters_json %];</script>
  <form id="join-form" method="get" action="/join" novalidate>
    <input type="hidden" name="l" value="[% left_spec | html %]">
    [%- FOREACH jspec IN current_joins -%]
    <input type="hidden" name="j" value="[% jspec | html %]">
    [%- END -%]
    [%- FOREACH fs IN filter_specs -%]
    <input type="hidden" name="f" value="[% fs | html %]" class="f-preserved">
    [%- END -%]

    <h3 class="join-panel-title">Merge data / Filter results</h3>

    <div class="join-fields">
      <div class="join-field">
        <label for="right-table-sel">Table from the data directory</label>
        <select id="right-table-sel">
          <option value="">&mdash; select a table &mdash;</option>
          [%- FOREACH t IN available_tables -%]
          <option value="[% t.spec | html %]">[% t.name | html %]</option>
          [%- END -%]
        </select>
      </div>

      <div class="join-or">or</div>

      <div class="join-field">
        <label for="right-path-inp">File path <span style="font-weight:400;color:#999;font-size:.78rem;">(browser or drag &amp; drop)</span></label>
        <div class="with-tooltip">
          <input type="text" id="right-path-inp" placeholder="/path/to/file.csv"
                 autocomplete="off" spellcheck="false">
          <div class="tip-box" role="tooltip">
            Enter an absolute path to a local file, or use the remote
            syntax to open a file via SSH:<br><br>
            <code>/../hostname/dir/file.csv</code><br>
            <code>/../user@hostname/dir/file.csv</code><br><br>
            To join a Redis table (optional Redis module required):<br>
            <code>redis:tablename|redis://host:port</code><br>
            Or enter a bare URL to browse available keys:<br>
            <code>redis://host:port</code><br><br>
            Accepted: CSV, TSV, PSV, XLSX, SQLite (.sql / .sqlite /
            .sqlite3), Berkeley DB (.db), XML, Redis.
          </div>
        </div>
      </div>

      <div class="join-field">
        <label for="left-key-sel">Column in <strong>[% title | html %]</strong> to join on</label>
        <select id="left-key-sel">
          <option value="">&mdash; select a column &mdash;</option>
          [%- FOREACH col IN columns -%]
          <option value="[% col | html %]">[% col | html %]</option>
          [%- END -%]
        </select>
      </div>

      <div class="join-field">
        <label for="right-key-sel">Matching column in the new database</label>
        <select id="right-key-sel" disabled>
          <option value="">&mdash; select a database first &mdash;</option>
        </select>
      </div>

      <div class="join-field">
        <label for="join-type-sel">Which rows to include</label>
        <select id="join-type-sel" name="jtype">
          <option value="left" selected>Keep all rows from the left table</option>
          <option value="inner">Only rows that match in both tables</option>
          <option value="outer">All rows from either table</option>
        </select>
      </div>
    </div>

    <p class="join-desc" id="join-desc" hidden></p>

    <div class="filter-section">
      <div class="filter-section-header">
        <span class="filter-section-label">Filter results</span>
        <button type="button" id="btn-add-filter" class="btn-add-filter">&#x2b; Add condition</button>
      </div>
      <div id="filter-rows"></div>
    </div>

    <div class="join-actions">
      <button type="button" id="btn-cancel-join" class="btn-secondary">Cancel</button>
      <button type="submit" id="btn-do-join" class="btn-primary" disabled>Apply</button>
    </div>
  </form>
</div>

<div class="combine-panel" id="combine-panel" hidden>
  <form id="combine-form" method="get" action="/combine" novalidate>
    <input type="hidden" name="l" value="[% left_spec | html %]">
    [%- FOREACH cspec IN combine_specs -%]
    <input type="hidden" name="c" value="[% cspec | html %]">
    [%- END -%]
    [%- FOREACH jspec IN current_joins -%]
    <input type="hidden" name="j" value="[% jspec | html %]">
    [%- END -%]
    [%- FOREACH fs IN filter_specs -%]
    <input type="hidden" name="f" value="[% fs | html %]">
    [%- END -%]

    <h3 class="combine-panel-title">Combine data</h3>

    <p class="combine-desc-static">Stack rows from another file beneath the current data. All columns from both files will appear as headers; where a row has no value for a column it will be left blank.</p>

    <div class="join-fields">
      <div class="join-field">
        <label for="combine-table-sel">Table from the data directory</label>
        <select id="combine-table-sel">
          <option value="">&#x2014; select a table &#x2014;</option>
          [%- FOREACH t IN available_tables -%]
          <option value="[% t.spec | html %]">[% t.name | html %]</option>
          [%- END -%]
        </select>
      </div>

      <div class="join-or">or</div>

      <div class="join-field">
        <label for="combine-path-inp">File path <span style="font-weight:400;color:#999;font-size:.78rem;">(browse or drag &amp; drop)</span></label>
        <div class="with-tooltip">
          <input type="text" id="combine-path-inp" placeholder="/path/to/file.csv"
                 autocomplete="off" spellcheck="false">
          <div class="tip-box" role="tooltip">
            Enter an absolute path to a local file, or use the remote
            syntax to open a file via SSH:<br><br>
            <code>/../hostname/dir/file.csv</code><br>
            <code>/../user@hostname/dir/file.csv</code><br><br>
            To combine with a Redis table (optional Redis module required):<br>
            <code>redis:tablename|redis://host:port</code><br>
            Or enter a bare URL to browse available keys:<br>
            <code>redis://host:port</code><br><br>
            Accepted: CSV, TSV, PSV, XLSX, SQLite (.sql / .sqlite /
            .sqlite3), Berkeley DB (.db), XML, Redis.
          </div>
        </div>
      </div>
    </div>

    <div class="join-actions">
      <button type="button" id="btn-cancel-combine" class="btn-secondary">Cancel</button>
      <button type="submit" id="btn-do-combine" class="btn-primary" disabled>Combine</button>
    </div>
  </form>
</div>

<div class="graph-panel" id="graph-panel" hidden>
  <form id="graph-form" method="get" action="/graph"
        data-parent-back="[% back_url | html %]" data-parent-back-label="[% back_label | html %]">
    <input type="hidden" name="l" value="[% left_spec | html %]">
    [%- FOREACH jspec IN current_joins -%]
    <input type="hidden" name="j" value="[% jspec | html %]">
    [%- END -%]
    [%- FOREACH cspec IN combine_specs -%]
    <input type="hidden" name="c" value="[% cspec | html %]">
    [%- END -%]
    [%- FOREACH fs IN filter_specs -%]
    <input type="hidden" name="f" value="[% fs | html %]">
    [%- END -%]
    [%- IF dedup -%]
    <input type="hidden" name="d" value="1">
    [%- END -%]
    <input type="hidden" name="back" id="graph-back-inp" value="">
    <input type="hidden" name="back2" id="graph-back2-inp" value="">
    <input type="hidden" name="back2_label" id="graph-back2-label-inp" value="">

    <h3 class="graph-panel-title">&#x1F4C8; Line graph</h3>

    <p class="graph-panel-desc">Choose the columns to use as axes, then click Plot to open the chart.</p>

    <div class="graph-fields-row">
      <div class="join-field">
        <label for="graph-x-sel">X axis (horizontal)</label>
        <select id="graph-x-sel" name="x" required>
          <option value="">&#x2014; select column &#x2014;</option>
          [%- FOREACH col IN columns -%]
          <option value="[% col | html %]">[% col | html %]</option>
          [%- END -%]
        </select>
      </div>
      <div class="join-field" id="graph-y-field">
        <label for="graph-y-sel" id="graph-y-label">Y axis (vertical, must be numeric)</label>
        <select id="graph-y-sel" name="y" required>
          <option value="">&#x2014; select column &#x2014;</option>
          [%- FOREACH col IN columns -%]
          <option value="[% col | html %]">[% col | html %]</option>
          [%- END -%]
        </select>
        <input type="text" id="graph-y-text" readonly hidden tabindex="-1">
      </div>
      <div class="graph-btn-col">
        <span class="graph-btn-spacer"></span>
        <div class="graph-btn-row">
          <button type="submit" id="btn-do-graph" class="btn-primary" disabled>Plot</button>
          <button type="button" id="btn-cancel-graph" class="btn-secondary">Cancel</button>
        </div>
      </div>
    </div>
  </form>
</div>

<div class="graph-panel" id="pie-panel" hidden>
  <form id="pie-form" method="get" action="/pie"
        data-parent-back="[% back_url | html %]" data-parent-back-label="[% back_label | html %]">
    <input type="hidden" name="l" value="[% left_spec | html %]">
    [%- FOREACH jspec IN current_joins -%]
    <input type="hidden" name="j" value="[% jspec | html %]">
    [%- END -%]
    [%- FOREACH fs IN filter_specs -%]
    <input type="hidden" name="f" value="[% fs | html %]">
    [%- END -%]
    [%- IF dedup -%]
    <input type="hidden" name="d" value="1">
    [%- END -%]
    <input type="hidden" name="back" id="pie-back-inp" value="">
    <input type="hidden" name="back2" id="pie-back2-inp" value="">
    <input type="hidden" name="back2_label" id="pie-back2-label-inp" value="">

    <h3 class="graph-panel-title">&#x25D4; Pie chart</h3>

    <p class="graph-panel-desc">Choose a category column, then either count rows per category or pick a numeric column to sum.</p>

    <div class="graph-fields-row">
      <div class="join-field">
        <label for="pie-cat-sel">Slice by</label>
        <select id="pie-cat-sel" name="cat" required>
          <option value="">&#x2014; select column &#x2014;</option>
          [%- FOREACH col IN columns -%]
          <option value="[% col | html %]">[% col | html %]</option>
          [%- END -%]
        </select>
      </div>
      <div class="join-field">
        <label for="pie-val-sel">Value</label>
        <select id="pie-val-sel" name="val" required>
          <option value="">&#x2014; select &#x2014;</option>
          <option value="__count__" style="font-weight:bold">Count (rows)</option>
          [%- FOREACH col IN columns -%]
          <option value="[% col | html %]">[% col | html %]</option>
          [%- END -%]
        </select>
      </div>
      <div class="join-field">
        <label for="pie-donut-chk" title="Show a hole in the centre of the pie">Donut style</label>
        <label style="display:flex;align-items:center;gap:0.4rem;padding-top:0.3rem;">
          <input type="checkbox" id="pie-donut-chk" name="donut" value="1"> Donut
        </label>
      </div>
      <div class="join-field">
        <label for="pie-topn-inp" title="Show only the top N slices; the rest are aggregated into an Other slice">Top N slices</label>
        <input type="number" id="pie-topn-inp" name="topn" min="1" placeholder="all"
               style="width:5rem" title="Show only the top N slices; the rest become Other">
      </div>
      <div class="graph-btn-col">
        <span class="graph-btn-spacer"></span>
        <div class="graph-btn-row">
          <button type="submit" id="btn-do-pie" class="btn-primary" disabled>Plot</button>
          <button type="button" id="btn-cancel-pie" class="btn-secondary">Cancel</button>
        </div>
      </div>
    </div>
  </form>
</div>

<div class="graph-panel" id="heatmap-panel" hidden>
  <form id="heatmap-form" method="get" action="/heatmap"
        data-parent-back="[% back_url | html %]" data-parent-back-label="[% back_label | html %]">
    <input type="hidden" name="l" value="[% left_spec | html %]">
    [%- FOREACH jspec IN current_joins -%]
    <input type="hidden" name="j" value="[% jspec | html %]">
    [%- END -%]
    [%- FOREACH fs IN filter_specs -%]
    <input type="hidden" name="f" value="[% fs | html %]">
    [%- END -%]
    [%- IF dedup -%]
    <input type="hidden" name="d" value="1">
    [%- END -%]
    <input type="hidden" name="back" id="heatmap-back-inp" value="">
    <input type="hidden" name="back2" id="heatmap-back2-inp" value="">
    <input type="hidden" name="back2_label" id="heatmap-back2-label-inp" value="">

    <h3 class="graph-panel-title">&#x229F; Heatmap</h3>

    <p class="graph-panel-desc">Choose two categorical columns for the axes. Optionally pick a numeric column to sum per cell; leave it on "Count rows" to show how many rows fall in each cell.</p>

    <div class="graph-fields-row">
      <div class="join-field">
        <label for="heatmap-x-sel">X axis (columns)</label>
        <select id="heatmap-x-sel" name="x" required>
          <option value="">&#x2014; select column &#x2014;</option>
          [%- FOREACH col IN columns -%]
          <option value="[% col | html %]">[% col | html %]</option>
          [%- END -%]
        </select>
      </div>
      <div class="join-field">
        <label for="heatmap-y-sel">Y axis (rows)</label>
        <select id="heatmap-y-sel" name="y" required>
          <option value="">&#x2014; select column &#x2014;</option>
          [%- FOREACH col IN columns -%]
          <option value="[% col | html %]">[% col | html %]</option>
          [%- END -%]
        </select>
      </div>
      <div class="join-field">
        <label for="heatmap-val-sel">Value (cell colour)</label>
        <select id="heatmap-val-sel" name="val">
          <option value="" style="font-weight:bold">Count (rows)</option>
          [%- FOREACH col IN columns -%]
          <option value="[% col | html %]">[% col | html %]</option>
          [%- END -%]
        </select>
      </div>
      <div class="join-field">
        <label for="heatmap-scheme-sel">Colour scheme</label>
        <select id="heatmap-scheme-sel" name="scheme">
          <option value="YlOrRd">Yellow-Orange-Red</option>
          <option value="Blues">Blues</option>
          <option value="Greens">Greens</option>
          <option value="Purples">Purples</option>
          <option value="RdPu">Red-Purple</option>
          <option value="YlGnBu">Yellow-Green-Blue</option>
        </select>
      </div>
      <div class="graph-btn-col">
        <span class="graph-btn-spacer"></span>
        <div class="graph-btn-row">
          <button type="submit" id="btn-do-heatmap" class="btn-primary" disabled>Plot</button>
          <button type="button" id="btn-cancel-heatmap" class="btn-secondary">Cancel</button>
        </div>
      </div>
    </div>
  </form>
</div>

<div class="graph-panel" id="bar-panel" hidden>
  <form id="bar-form" method="get" action="/bar"
        data-parent-back="[% back_url | html %]" data-parent-back-label="[% back_label | html %]">
    <input type="hidden" name="l" value="[% left_spec | html %]">
    [%- FOREACH jspec IN current_joins -%]
    <input type="hidden" name="j" value="[% jspec | html %]">
    [%- END -%]
    [%- FOREACH fs IN filter_specs -%]
    <input type="hidden" name="f" value="[% fs | html %]">
    [%- END -%]
    [%- IF dedup -%]
    <input type="hidden" name="d" value="1">
    [%- END -%]
    <input type="hidden" name="back" id="bar-back-inp" value="">
    <input type="hidden" name="back2" id="bar-back2-inp" value="">
    <input type="hidden" name="back2_label" id="bar-back2-label-inp" value="">

    <h3 class="graph-panel-title">&#x1F4CA; Bar chart</h3>

    <p class="graph-panel-desc">Choose a category column. Optionally pick a numeric column to sum per category; leave it on "Count rows" to show how many rows fall in each category.</p>

    <div class="graph-fields-row">
      <div class="join-field">
        <label for="bar-cat-sel">Category (bars)</label>
        <select id="bar-cat-sel" name="cat" required>
          <option value="">&#x2014; select column &#x2014;</option>
          [%- FOREACH col IN columns -%]
          <option value="[% col | html %]">[% col | html %]</option>
          [%- END -%]
        </select>
      </div>
      <div class="join-field">
        <label for="bar-val-sel">Value (bar height)</label>
        <select id="bar-val-sel" name="val">
          <option value="" style="font-weight:bold">Count (rows)</option>
          [%- FOREACH col IN columns -%]
          <option value="[% col | html %]">[% col | html %]</option>
          [%- END -%]
        </select>
      </div>
      <div class="join-field">
        <label for="bar-sort-sel">Sort bars</label>
        <select id="bar-sort-sel" name="sort">
          <option value="none">Original order</option>
          <option value="value">By value (desc)</option>
          <option value="label">By label (A-Z)</option>
        </select>
      </div>
      <div class="join-field">
        <label for="bar-orient-sel">Orientation</label>
        <select id="bar-orient-sel" name="orient">
          <option value="vertical">Vertical</option>
          <option value="h">Horizontal</option>
        </select>
      </div>
      <div class="join-field">
        <label for="bar-topn-inp" title="Show only the top N categories by value; remaining categories are aggregated into an Other bar">Top N</label>
        <input type="number" id="bar-topn-inp" name="topn" min="1" placeholder="all"
               style="width:5rem" title="Show only the top N categories; the rest become Other">
      </div>
      <div class="graph-btn-col">
        <span class="graph-btn-spacer"></span>
        <div class="graph-btn-row">
          <button type="submit" id="btn-do-bar" class="btn-primary" disabled>Plot</button>
          <button type="button" id="btn-cancel-bar" class="btn-secondary">Cancel</button>
        </div>
      </div>
