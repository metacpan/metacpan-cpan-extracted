# Sample FuguVM global configuration
#
# Copy this file to ~/.fuguvmrc
#
# This file contains user-wide settings that apply to all FuguVM projects

# SSH public key for VM authentication
#
# fuguvm installs this key in the VM's /root/.ssh/authorized_keys during
# the initial installation. After the installation, all SSH connections
# use SSH agent authentication through SSH_AUTH_SOCK.
#
# To get your public key, run: cat ~/.ssh/id_ed25519.pub
# or: ssh-add -L
#
ssh_pubkey ssh-ed25519 AAAA... user@host

# Optional: shared cache directory for downloaded OpenBSD images and
# cached installed-image bases
# cache_dir ~/.cache/fuguvm

# Optional: reuse the cached installed images. Then fuguvm does not
# reinstall OpenBSD on every fresh disk. The default is yes. See
# fuguvm(1).
# image_cache yes

# Optional: the default VM name when you do not specify one
# default_vm default

# Optional: pin the version of the QEMU system binary. With the
# directive, 'fuguvm up' and 'fuguvm start' refuse an other version
# with exit code 3. Without it, fuguvm checks nothing. See fuguvm(1).
# qemu_version 9.0

# Optional: verify each mirror download under the OpenBSD release
# key with signify(1). The default is yes. See fuguvm(1).
# verify yes

# Optional: the directory of the signify public keys. Without the
# directive, fuguvm reads /etc/signify/ and then the shipped
# share/fuguvm/signify/ tree. See fuguvm(1).
# signify_dir ~/keys

# Optional: cache OpenBSD distfiles in the mirror proxy, under this
# size cap. The value is a byte count, or a number with a K, M or G
# suffix (1024-based). The default is 0, which turns the distfile
# cache off. See fuguvm(1).
# distfile_cache 4G

# VM definitions
#
# You can define VMs in blocks here or in project .fuguvmrc files.
# The project config overrides the global config.
#
# ssh_port and console_port take a number or the word 'auto', which
# takes a free host port and records it. bind_address names the host
# address of the forwarded ports; the default is 127.0.0.1.
#
# vm "default" {
#     arch         arm64
#     version      7.8
#     memory       2048
#     disk_size    8G
#     ssh_port     2222
#     console_port 4444
#     bind_address 127.0.0.1
#
#     # Optional: install from an autoinstall(8) response file, or
#     # overlay an existing image instead of an installation. The two
#     # directives contradict each other. See fuguvm(1).
#     # autoinstall  install.conf
#     # base_disk    ~/images/openbsd-78-amd64.qcow2
#
#     # Optional: the file whose first line is the root password of
#     # the image, for the SSH key setup outside the default install.
#     # root_password_file ~/images/openbsd-78.pass
# }
