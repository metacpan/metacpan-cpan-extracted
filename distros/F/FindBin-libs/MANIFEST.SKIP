# standard build artifacts
^blib/
^pm_to_blib$
^Makefile$
^Makefile\.old$
^MYMETA\.
^\.git/
^_build/
^Build$
^cover_db/
^\.prove$
^\.claude/

# VCS metadata -- not distributed
^\.gitignore$

# working copies generated by Makefile.PL dircopy from the selected
# version/ directory
^lib/
^t/
^example/

# developer tools, not distributed
^setup-dist$
^xt/

# t/12-Bin_l is a directory symlink, which "make dist" would store as
# a copy; Makefile.PL recreates it.
^version/v5\.40/t/12-Bin_l/
