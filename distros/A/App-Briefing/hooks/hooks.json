{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/briefing",
            "args": ["hook", "pre-tool-use"]
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/briefing",
            "args": ["hook", "subagent-start"],
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/briefing",
            "args": ["hook", "marketplace-notice"]
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/briefing",
            "args": ["hook", "session-start"],
            "timeout": 90
          }
        ]
      }
    ]
  }
}
