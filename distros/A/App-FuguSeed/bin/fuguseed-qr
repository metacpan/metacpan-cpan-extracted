# fuguseed-qr: print a Standard SeedQR as text, zone by zone.
#
# The program holds no logic: it calls App::FuguSeed::QR->run and it
# exits with the result (QR-PROGRAM-1).

use v5.34;
use warnings;
use experimental 'signatures';
no feature qw(indirect multidimensional bareword_filehandles);

use App::FuguSeed::QR ();

exit App::FuguSeed::QR->run(@ARGV);
