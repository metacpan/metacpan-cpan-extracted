plan tests => 3 * scalar(@R_ROWS) + 2 * scalar(@COV_ROWS) + 4;

for my $r (@R_ROWS) {
	my ($nm, $xs, $ys, $alt, $ex, $cc, $stat, $p, $est) = @$r;
	my @x = split /,/, $xs;
	my @y = split /,/, $ys;
	my %a = (method => 'kendall', alternative => $alt, continuity => $cc);
	$a{exact} = ($ex eq '1' ? 1 : 0) unless $ex eq 'd';
	my $got = cor_test(\@x, \@y, %a);
	my $id  = "$nm alt=$alt exact=$ex cc=$cc";
	# the exact branch is taken for exact => 1 and, at n = 10 with no ties,
	# for the default; exact => 0 is the approximation and agrees with R there
	my $want_p = ($nm eq 'perfect10' && $ex ne '0' && $PERFECT10_EXACT{$alt})
	           ? $PERFECT10_EXACT{$alt} : $p;
	rel_ok($got->{statistic},  $stat,   "$id: statistic");
	rel_ok($got->{'p_value'},  $want_p, "$id: p_value");
	rel_ok($got->{estimate},   $est,    "$id: estimate");
}

for my $r (@COV_ROWS) {
	my ($nm, $xs, $ys, $covk, $cork) = @$r;
	my @x = split /,/, $xs;
	my @y = split /,/, $ys;
	# an integer count, so it is equal, not approximately equal
	is(Stats::LikeR::cov(\@x, \@y, 'kendall') + 0, $covk,
	   "$nm: cov(kendall) == 2(C - D)");
	rel_ok(cor(\@x, \@y, 'kendall'), $cork, "$nm: cor(kendall) tau-b");
}

# The tau-b cor_test() reports and the one cor() reports come from the same
# counts, so they must agree to the last bit rather than to a tolerance.  That
# stopped being true while the two had separate implementations.
{
	my @x = (3,2,0,0,1,0,3,1,2,1,2,2,0,2,3);
	my @y = (0,1,1,3,1,3,1,0,3,1,1,0,3,2,0);
	is(cor_test(\@x, \@y, method => 'kendall')->{estimate},
	   cor(\@x, \@y, 'kendall'),
	   'cor_test and cor report the identical tau-b on tied data');
}

# @LARGE: n past what the old O(n^2) loop could do inside a test run.  The data
# is generated rather than frozen because what is asserted is an identity
# between two code paths in this module, not a reference value.
{
	srand(20260830);
	my @x = map { int(rand 1000) } 1 .. 20000;   # heavy ties in both vectors
	my @y = map { int(rand 1000) } 1 .. 20000;
	my $t0 = time;
	my $ct = cor_test(\@x, \@y, method => 'kendall');
	my $elapsed = time - $t0;
	is($ct->{estimate}, cor(\@x, \@y, 'kendall'),
	   'n = 20000 with ties: cor_test tau-b == cor tau-b');
	ok(defined $ct->{'p_value'} && $ct->{'p_value'} >= 0 && $ct->{'p_value'} <= 1,
	   'n = 20000 with ties: p-value is a probability');
	# The old double loop was 14.7 s at n = 64000, so about 1.4 s here and
	# rising as n^2; 20 s is a bound no O(n log n) run approaches and no
	# smoker trips.
	cmp_ok($elapsed, '<', 20, 'n = 20000 finishes in seconds, not quadratic time');
}

