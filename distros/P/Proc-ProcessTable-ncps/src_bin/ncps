	my @pids = split( /\,/, $pids_string );
	push(
		@filters,
		{
			type   => 'PID',
			invert => $pids_invert,
			args   => {
				pids => \@pids,
			},
		}
	);
} ## end if ( defined($pids_string) )

#
# handles the CPU search
#
if ( defined($cpu_string) ) {
	my @cpus = split( /\,/, $cpu_string );
	push(
		@filters,
		{
			type   => 'PctCPU',
			invert => $cpu_invert,
			args   => {
