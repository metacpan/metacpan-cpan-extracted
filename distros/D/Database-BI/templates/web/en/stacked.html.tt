[%- WRAPPER 'web/en/layouts/default.html.tt' -%]

<style>
  #stacked_bar { overflow: visible; }
  .stacked-container { padding-left: 3rem; }
  .chart-source {
    margin: 0.25rem 0 0;
    font-size: 0.82rem;
    color: #666;
    word-break: break-all;
  }
  .chart-source a { color: inherit; }
  /* A legend entry is a switch, not a caption.  A <g> has no box of its own,
     so the focus ring is drawn on the swatch it toggles. */
  #stacked_bar .sb-legend-item:focus-visible { outline: none; }
  #stacked_bar .sb-legend-item:focus-visible rect {
    stroke: #0d6efd;
    stroke-width: 2px;
  }
</style>

<p class="back-link"><a href="/">&larr; Home</a> &rsaquo; <a href="[% back_url | html %]">[% back_label || 'Back' | html %]</a>[%- IF back2_url -%] &rsaquo; <a href="[% back2_url | html %]">[% back2_label || 'Back' | html %]</a>[%- END -%]</p>

<h2 class="graph-title">[% title | html %]</h2>

<div class="graph-export-bar">
  <button class="btn-graph-export" onclick="biStackedExportSVG()">Export SVG</button>
  <button class="btn-graph-export" onclick="biStackedExportPNG()">Export PNG</button>
  <button class="btn-graph-export" id="btn-copy-chart-link" onclick="navigator.clipboard.writeText(window.location.href).then(function(){var b=document.getElementById('btn-copy-chart-link');var t=b.textContent;b.textContent='Copied!';setTimeout(function(){b.textContent=t;},1500)}).catch(function(){})">&#x1F517; Copy link</button>
  <span class="graph-point-count">[% bar_count %] categor[% IF bar_count == 1 %]y[% ELSE %]ies[% END %]</span>
</div>

<p class="sr-only" id="stacked-legend-help">Show or hide a series: press Tab until a legend
entry has focus, then press Enter or Space to toggle it.</p>
<p class="sr-only" id="stacked-live" role="status" aria-live="polite"></p>

<div class="stacked-container">
  <script src="https://d3js.org/d3.v7.min.js"></script>
  [% chart_html %]
</div>

<script>
// D3 draws a clickable legend: each entry hides or shows its series.  A click
// is not something a keyboard reader can make, so each entry is made a switch
// - in the tab order, named for the series it toggles, aria-pressed saying
// whether that series is drawn, and Enter or Space sending the same click the
// pointer sends.
(function () {
  var live = document.getElementById('stacked-live');

  // A button's pressed state is announced by a screen reader that is on it;
  // the series appearing or disappearing is not, so it is said here too.
  function say(name, pressed) {
    if (!live) return;
    live.textContent = '';
    setTimeout(function () {
      live.textContent = name + (pressed ? ' shown' : ' hidden');
    }, 30);
  }

  setTimeout(function () {
    document.querySelectorAll('#stacked_bar .sb-legend-item').forEach(function (item) {
      var textEl = item.querySelector('text');
      var name   = textEl ? textEl.textContent.trim() : '';
      if (!name) return;

      item.setAttribute('tabindex', '0');
      item.setAttribute('role', 'button');
      item.setAttribute('aria-label', 'Toggle ' + name);
      item.setAttribute('aria-pressed', 'true');
      item.setAttribute('aria-describedby', 'stacked-legend-help');

      item.addEventListener('click', function () {
        var pressed = item.getAttribute('aria-pressed') !== 'true';
        item.setAttribute('aria-pressed', pressed ? 'true' : 'false');
        say(name, pressed);
      });
      item.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          item.dispatchEvent(new MouseEvent('click', { bubbles: true }));
        }
      });
    });
  }, 50);
}());
</script>

<script>
(function () {
  function _getAttribution() {
    var el = document.getElementById('chart-attribution');
    return el ? { url: el.dataset.url, date: el.dataset.date } : null;
  }
  var ATTR_H = 38;
  function _addAttrToSVG(svgEl, attr) {
    if (!attr) return;
    var ns = 'http://www.w3.org/2000/svg';
    var h  = parseFloat(svgEl.getAttribute('height')) || 500;
    svgEl.setAttribute('height', h + ATTR_H);
    var vb = svgEl.getAttribute('viewBox');
    if (vb) {
      var p = vb.trim().split(/\s+/);
      if (p.length === 4) { p[3] = parseFloat(p[3]) + ATTR_H; svgEl.setAttribute('viewBox', p.join(' ')); }
    }
    var maxLen = 90;
    var urlText = attr.url.length > maxLen ? attr.url.slice(0, maxLen - 3) + '...' : attr.url;
    var style = 'font-family:sans-serif;font-size:11px;fill:#666;';
    var t1 = document.createElementNS(ns, 'text');
    t1.setAttribute('x', 10); t1.setAttribute('y', h + 16); t1.setAttribute('style', style);
    t1.textContent = 'Source: ' + urlText;
    var t2 = document.createElementNS(ns, 'text');
    t2.setAttribute('x', 10); t2.setAttribute('y', h + 30); t2.setAttribute('style', style);
    t2.textContent = 'Accessed on ' + attr.date;
    svgEl.appendChild(t1);
    svgEl.appendChild(t2);
  }
  function biStackedExportSVG() {
    var svg = document.getElementById('stacked_bar');
    if (!svg) return;
    var clone = svg.cloneNode(true);
    _addAttrToSVG(clone, _getAttribution());
    var src = '<?xml version="1.0" encoding="UTF-8"?>\n'
            + new XMLSerializer().serializeToString(clone);
    var a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([src], { type: 'image/svg+xml;charset=utf-8' }));
    a.download = 'stacked_bar.svg';
    a.click();
    URL.revokeObjectURL(a.href);
  }
  function biStackedExportPNG() {
    var svg = document.getElementById('stacked_bar');
    if (!svg) return;
    var attr   = _getAttribution();
    var w      = parseInt(svg.getAttribute('width'),  10) || 900;
    var h      = parseInt(svg.getAttribute('height'), 10) || 500;
    var extraH = attr ? ATTR_H : 0;
    var canvas = document.createElement('canvas');
    canvas.width = w; canvas.height = h + extraH;
    var ctx = canvas.getContext('2d');
    var src = new XMLSerializer().serializeToString(svg);
    var url = URL.createObjectURL(new Blob([src], { type: 'image/svg+xml;charset=utf-8' }));
    var img = new Image();
    img.onload = function () {
      ctx.fillStyle = '#fff';
      ctx.fillRect(0, 0, w, h + extraH);
      ctx.drawImage(img, 0, 0);
      URL.revokeObjectURL(url);
      if (attr) {
        var maxLen  = 90;
        var urlText = attr.url.length > maxLen ? attr.url.slice(0, maxLen - 3) + '...' : attr.url;
        ctx.font         = '11px sans-serif';
        ctx.fillStyle    = '#666';
        ctx.textBaseline = 'alphabetic';
        ctx.fillText('Source: ' + urlText,       10, h + 16);
        ctx.fillText('Accessed on ' + attr.date,  10, h + 30);
      }
      var a = document.createElement('a');
      a.href = canvas.toDataURL('image/png');
      a.download = 'stacked_bar.png';
      a.click();
    };
    img.src = url;
  }
  window.biStackedExportSVG = biStackedExportSVG;
  window.biStackedExportPNG = biStackedExportPNG;
}());
</script>

[% IF source_url %]
<div id="chart-attribution" data-url="[% source_url | html %]" data-date="[% source_accessed | html %]" hidden></div>
<p class="chart-source">Source: <a href="[% source_url | html %]" rel="noopener noreferrer">[% source_url | html %]</a></p>
<p class="chart-source">Accessed on [% source_accessed %]</p>
[% END %]

[%- END -%]
