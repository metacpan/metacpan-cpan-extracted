  </form>
</div>

<div class="graph-panel" id="stacked-panel" hidden>
  <form id="stacked-form" method="get" action="/stacked"
        data-parent-back="[% back_url | html %]" data-parent-back-label="[% back_label | html %]">
    <input type="hidden" name="l" value="[% left_spec | html %]">
    [%- FOREACH jspec IN current_joins -%]
    <input type="hidden" name="j" value="[% jspec | html %]">
    [%- END -%]
    [%- FOREACH fs IN filter_specs -%]
    <input type="hidden" name="f" value="[% fs | html %]">
    [%- END -%]
    <input type="hidden" name="back" id="stacked-back-inp" value="">
    <input type="hidden" name="back2" id="stacked-back2-inp" value="">
    <input type="hidden" name="back2_label" id="stacked-back2-label-inp" value="">

    <h3 class="graph-panel-title">&#x1F4CA; Stacked bar chart</h3>
    <p class="graph-panel-desc">Choose a category column, a segment (series) column, and optionally a numeric value column to sum. Leave value on "Count rows" to count occurrences.</p>

    <div class="graph-fields-row">
      <div class="join-field">
        <label for="stacked-cat-sel">Category (X axis)</label>
        <select id="stacked-cat-sel" name="cat" required>
          <option value="">&#x2014; select column &#x2014;</option>
          [%- FOREACH col IN columns -%]
          <option value="[% col | html %]">[% col | html %]</option>
          [%- END -%]
        </select>
      </div>
      <div class="join-field">
        <label for="stacked-seg-sel">Segment (series)</label>
        <select id="stacked-seg-sel" name="seg" required>
          <option value="">&#x2014; select column &#x2014;</option>
          [%- FOREACH col IN columns -%]
          <option value="[% col | html %]">[% col | html %]</option>
          [%- END -%]
        </select>
      </div>
      <div class="join-field">
        <label for="stacked-val-sel">Value (height)</label>
        <select id="stacked-val-sel" name="val">
          <option value="" style="font-weight:bold">Count (rows)</option>
          [%- FOREACH col IN columns -%]
          <option value="[% col | html %]">[% col | html %]</option>
          [%- END -%]
        </select>
      </div>
      <div class="join-field">
        <label for="stacked-orient-sel">Orientation</label>
        <select id="stacked-orient-sel" name="orient">
          <option value="v">Vertical</option>
          <option value="h">Horizontal</option>
        </select>
      </div>
      <div class="graph-btn-col">
        <span class="graph-btn-spacer"></span>
        <div class="graph-btn-row">
          <button type="submit" id="btn-do-stacked" class="btn-primary" disabled>Plot</button>
          <button type="button" id="btn-cancel-stacked" class="btn-secondary">Cancel</button>
        </div>
      </div>
    </div>
  </form>
</div>

<div class="graph-panel" id="scatter-panel" hidden>
  <form id="scatter-form" method="get" action="/scatter"
        data-parent-back="[% back_url | html %]" data-parent-back-label="[% back_label | html %]">
    <input type="hidden" name="l" value="[% left_spec | html %]">
    [%- FOREACH jspec IN current_joins -%]
    <input type="hidden" name="j" value="[% jspec | html %]">
    [%- END -%]
    [%- FOREACH fs IN filter_specs -%]
    <input type="hidden" name="f" value="[% fs | html %]">
    [%- END -%]
    <input type="hidden" name="back" id="scatter-back-inp" value="">
    <input type="hidden" name="back2" id="scatter-back2-inp" value="">
    <input type="hidden" name="back2_label" id="scatter-back2-label-inp" value="">

    <h3 class="graph-panel-title">&#x2B1C; Scatter plot</h3>
    <p class="graph-panel-desc">Choose two numeric columns. Both axes must contain numeric values.</p>

    <div class="graph-fields-row">
      <div class="join-field">
        <label for="scatter-x-sel">X axis (horizontal, numeric)</label>
        <select id="scatter-x-sel" name="x" required>
          <option value="">&#x2014; select column &#x2014;</option>
        </select>
      </div>
      <div class="join-field">
        <label id="scatter-y-label" for="scatter-y-sel">Y axis (vertical, numeric)</label>
        <select id="scatter-y-sel" name="y" required>
          <option value="">&#x2014; select column &#x2014;</option>
        </select>
        <input type="text" id="scatter-y-text" readonly hidden tabindex="-1">
      </div>
      <div class="join-field">
        <label for="scatter-series-sel">Colour by (optional)</label>
        <select id="scatter-series-sel" name="series">
          <option value="">&#x2014; none &#x2014;</option>
          [%- FOREACH col IN columns -%]
          <option value="[% col | html %]">[% col | html %]</option>
          [%- END -%]
        </select>
      </div>
      <div class="join-field">
        <label for="scatter-size-sel">Bubble size (optional)</label>
        <select id="scatter-size-sel" name="size">
          <option value="">&#x2014; none &#x2014;</option>
        </select>
      </div>
      <div class="graph-btn-col">
        <span class="graph-btn-spacer"></span>
        <div class="graph-btn-row">
          <button type="submit" id="btn-do-scatter" class="btn-primary" disabled>Plot</button>
          <button type="button" id="btn-cancel-scatter" class="btn-secondary">Cancel</button>
        </div>
      </div>
    </div>
    <div class="graph-fields-row">
      <div class="join-field">
        <label for="scatter-scheme-sel">Colour scheme</label>
        <select id="scatter-scheme-sel" name="scheme" disabled>
          <option value="tableau10">Tableau 10</option>
          <option value="category10">Category 10</option>
          <option value="set2">Set 2</option>
          <option value="set3">Set 3</option>
          <option value="paired">Paired</option>
        </select>
      </div>
      <div class="join-field">
        <label for="scatter-min-r">Min radius (1&#x2013;40)</label>
        <input type="number" id="scatter-min-r" name="min_r" min="1" max="40" value="3" disabled>
      </div>
      <div class="join-field">
        <label for="scatter-max-r">Max radius (1&#x2013;40)</label>
        <input type="number" id="scatter-max-r" name="max_r" min="1" max="40" value="15" disabled>
      </div>
    </div>
  </form>
</div>

<div class="graph-panel" id="combo-panel" hidden>
