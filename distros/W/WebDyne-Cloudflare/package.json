{
  "name": "@webdyne/webdyne-cloudflare",
  "version": "1.7.1",
  "description": "Cloudflare service extensions for WebDyne running under WebAssembly",
  "type": "module",
  "files": [
    "TEST.md",
    "js",
    "lib",
    "webdyne-extension.json",
    "docs"
  ],
  "exports": {
    ".": "./js/cloudflare.js",
    "./cloudflare": "./js/cloudflare.js",
    "./d1-host": "./js/d1-host.js",
    "./kv-host": "./js/kv-host.js",
    "./r2-host": "./js/r2-host.js",
    "./webdyne-extension.json": "./webdyne-extension.json",
    "./hyperdrive": "./js/hyperdrive.js",
    "./hyperdrive-host": "./js/hyperdrive-host.js",
    "./secrets-store-host": "./js/secrets-store-host.js",
    "./durable-object": "./js/durable-object.js",
    "./durable-object-host": "./js/durable-object-host.js"
  },
  "scripts": {
    "test": "npm run test:perl && npm run test:js",
    "test:perl": "prove -Ilib t",
    "test:js": "node --test t.js/*.test.mjs",
    "pack:check": "node t.js/check-package.mjs",
    "smoke:d1": "node t.js/smoke-d1.mjs",
    "smoke:kv": "node t.js/smoke-kv.mjs",
    "smoke:r2": "node t.js/smoke-r2.mjs",
    "smoke:secrets-store": "node t.js/smoke-secrets-store.mjs"
  },
  "sideEffects": false,
  "keywords": [
    "webdyne",
    "cloudflare",
    "d1",
    "kv",
    "r2",
    "perl",
    "webassembly"
  ],
  "author": "Andrew Speer",
  "license": "Artistic-1.0-Perl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aspeer/pm-WebDyne-Cloudflare.git"
  },
  "homepage": "https://github.com/aspeer/pm-WebDyne-Cloudflare#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "wrangler": "4.131.1"
  },
  "dependencies": {
    "mysql2": "3.24.4",
    "pg": "8.16.3"
  }
}
