.Dd $Mdocdate: October 25 2026 $
.Dt FUGUWEB 1
.Os
.Sh NAME
.Nm fuguweb
.Nd build a documentation website for a Perl project
.Sh SYNOPSIS
.Nm fuguweb
.Op Fl hq
.Op Fl Fl project Ar dir
.Ar command
.Op Ar argument ...
.Nm fuguweb
.Cm init
.Op Ar dir
.Nm fuguweb
.Cm build
.Op Fl Fl out Ar dir
.Nm fuguweb
.Cm check
.Op Fl v
.Op Fl Fl out Ar dir
.Nm fuguweb
.Cm clean
.Op Fl Fl out Ar dir
.Nm fuguweb
.Cm mint-key
.Fl Fl purpose Ar word
.Op Fl Fl type Ar type
.Fl Fl secret Ar path
.Op Fl Fl signer Ar path
.Op Fl Fl bind Ar stem Ns = Ns Ar path
.Op Fl Fl email Ar address
.Op Fl Fl expires Ar date
.Op Fl Fl dir Ar name
.Op Fl Fl bootstrap Fl Fl org Ar word Op Fl Fl url Ar prefix
.Nm fuguweb
.Cm import-key
.Fl Fl purpose Ar word
.Op Fl Fl type Ar type
.Fl Fl file Ar path
.Fl Fl secret Ar path
.Op Fl Fl signer Ar path
.Op Fl Fl bind Ar stem Ns = Ns Ar path
.Op Fl Fl dir Ar name
.Op Fl Fl bootstrap Fl Fl org Ar word Op Fl Fl url Ar prefix
.Nm fuguweb
.Cm promote-key
.Fl Fl purpose Ar word
.Fl Fl retiring Ar path
.Op Fl Fl secret Ar path
.Op Fl Fl signer Ar path
.Op Fl Fl bind Ar stem Ns = Ns Ar path
.Op Fl Fl dir Ar name
.Nm fuguweb
.Cm status
.Nm fuguweb
.Cm translated
.Ar file ...
.Nm fuguweb
