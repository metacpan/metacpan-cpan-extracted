use warnings;
use strict;

use Test::More;
use Config;
use File::Spec;
use File::Find;
use File::Temp ();

# What this test protects, and why it is not the file DBIx::Class shipped.
#
# Every module DBIO ships must carry the standard @DBIO PodWeaver footer: an
# AUTHOR (or AUTHORS) section and exactly one COPYRIGHT AND LICENSE section --
# the ordinary CPAN/metacpan convention. That footer is *generated by PodWeaver
# at build time* (the [Authors]/[Legal] sections of the @DBIO bundle, plus the
# DBIx::Class attribution the Heritage variant adds); it is not present in the
# source .pm files. So this test checks the WOVEN output, never the raw repo.
#
# The inherited version asserted the *pre-PodWeaver* DBIx::Class footer instead:
# a literal "=head1 FURTHER QUESTIONS?" followed by a DBIx::Class-worded
# COPYRIGHT block, looked for in the *source* tree. Two things made that claim
# untestable here:
#
#   * "FURTHER QUESTIONS" appears nowhere in lib/ -- DBIO's footer is woven, not
#     hand-written, so no source module carries that (or any) footer.
#   * The "footer present" assertion sat behind an `if =head1 NAME` guard, and
#     =head1 NAME is itself woven in from `# ABSTRACT:` at build time, so no
#     source file satisfied the guard. The positive branch never ran: it was
#     green because it could not fire, not because the property held.
#
# This rewrite replaces that dead, DBIx::Class-shaped claim with the live one --
# the real @DBIO footer, asserted per module against the actual build product.
# It can genuinely fail: drop [Authors]/[Legal] from the bundle, disable
# PodWeaver, add a module weaving skips, or hand-write a COPYRIGHT that duplicates
# the generated one, and a module ends up without its single standard footer.

# COPYRIGHT AND LICENSE is emitted only by PodWeaver -- no source .pm carries it
# -- so its presence in DBIO.pm is a reliable "this lib/ tree is woven" signal.
sub is_woven_lib {
  my ($libdir) = @_;
  my $main = File::Spec->catfile($libdir, 'DBIO.pm');
  return 0 unless -f $main;
  my $data = do { local (@ARGV, $/) = $main; <> };
  return $data =~ /^=head1 COPYRIGHT AND LICENSE$/m ? 1 : 0;
}

sub find_dzil {
  for my $dir (split /\Q$Config{path_sep}\E/, ($ENV{PATH} // '')) {
    next unless length $dir;
    my $p = File::Spec->catfile($dir, 'dzil');
    return $p if -x $p;
  }
  return;
}

# Find a woven lib/ to check.
#   1. Under `dzil test`, cwd is the build tree and lib/ is already woven.
#   2. Via `prove` from the dist root, cwd/lib is raw source, but dist.ini + dzil
#      are here, so build the dist into a temp dir and read the woven copy.
#   3. Neither (an installed tarball, no dzil): nothing to check, skip.
my ($libdir, $keepalive);

if (is_woven_lib('lib')) {
  $libdir = 'lib';
}
elsif (-f 'dist.ini') {
  my $dzil = find_dzil()
    or plan skip_all => 'Dist::Zilla (dzil) not installed - cannot weave POD to check';

  $keepalive = File::Temp->newdir;          # removed when it goes out of scope
  my $dest   = "$keepalive";
  my $log    = `'$dzil' build --notgz --in '$dest' 2>&1`;
  die "dzil build failed - cannot check woven footers:\n$log" if $?;

  $libdir = File::Spec->catdir($dest, 'lib');
  is_woven_lib($libdir)
    or die "dzil build produced no woven lib/ at $libdir";
}
else {
  plan skip_all => 'no woven lib/ and no dist.ini - nothing to check here';
}

my @modules;
find({
  no_chdir => 1,
  wanted   => sub {
    return unless -f $_;
    return unless /\.(?:pm|pod)$/i;
    push @modules, $_;
  },
}, $libdir);

die "no modules found under $libdir - build looks wrong" unless @modules;

for my $fn (sort @modules) {
  my $rel  = File::Spec->abs2rel($fn, $libdir);
  my $data = do { local (@ARGV, $/) = $fn; <> };

  # Attribution: the woven AUTHOR section. "At least one" rather than "exactly
  # one" because DBIO.pm additionally carries its own hand-written AUTHORS list
  # of DBIx::Class contributors alongside the generated AUTHOR.
  like $data, qr/^=head1 (?:AUTHOR|AUTHORS)\b/m,
    "$rel carries a woven AUTHOR footer";

  # Licence: exactly one COPYRIGHT AND LICENSE. Zero means the footer is missing;
  # more than one means a hand-written block collided with the generated one.
  my $copyrights = () = $data =~ /^=head1 COPYRIGHT AND LICENSE$/mg;
  is $copyrights, 1,
    "$rel carries exactly one woven COPYRIGHT AND LICENSE footer";
}

done_testing;
