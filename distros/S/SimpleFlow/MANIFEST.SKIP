# Build artifacts
^backup.pm$
^md2pod.pl$

# Makemaker generated files
^Makefile$
^MYMETA\.

# Release archives
^SimpleFlow.*\.tar\.gz$

# Not part of the distribution
^CLAUDE\.md$

# Author-only helper, like md2pod.pl above: it hardcodes a perlbrew layout,
# uses modern perl, and tests lib/ rather than anything shipped.
^test\.all\.perls\.pl$

# The in-progress notes for the next release; not part of the distribution.
^TODO\.md$

# Devel::Cover output, regenerated by cover.sh. It is committed but stale by
# design (it predates t/02.fixes.t), and 39 files of HTML report were being
# swept into the distribution.
^cover_db

# Author-only scripts, like md2pod.pl above. cover.sh re-runs the suite under
# Devel::Cover into cover_db; dzil.sh drives the release. Nothing that ships
# refers to either.
^cover\.sh$
^dzil\.sh$
