#!/usr/bin/env perl
# The R distribution family at its limits -- an infinite df, a df in the
# billions, a log probability carried through either way, a log p near 0 or
# past a double's underflow, and a binomial size within R's integer fuzz --
# cross-validated against R 4.6.1, R's own regression tests, and mpmath.
#
# PROVENANCE
#
# __DATA__ is a frozen table of R 4.6.1 (2026-06-24) results, generated by
# t/distributions.limits.R.R, committed beside this file, which says at its top
# how to re-run it. Every argument is an exact dyadic ratio "M/2^K", rebuilt by
# dyad() below for t/distributions.R.scipy.t's reason (perl 5.10.1's atof); the
# values are R's %.17g, or a ratio where R's answer was itself dyadic.
#
# The second half ports R's own checks from tests/d-p-q-r-tst-2.R (R 4.6.1),
# each named by its line there: they are identities and pinned constants,
# needing no reference values beyond the ones R's file states. Where that file
# uses its All.eq() -- all.equal() at 64 * double.eps, scaled by the mean of the
# target -- all_eq() below is the same computation.
#
# WHERE R IS NOT THE ANSWER
#
# Nine rows are arbitrated by t/distributions.limits.mpmath.py (mpmath at
# mp.dps = 60, bisecting the defining incomplete-beta equation on log x) and
# asserted against its value, with R asserted to still be the wrong one; see
# %MPMATH. Seven are qf() on the log scale, where R's qbeta() returns 0 for a
# root it cannot reach (qf(-64, 1, 1, log.p = TRUE) is 6.3466722361887189e-56)
# or is off by up to 0.6%; two are qt(-700, 5, log.p = TRUE), where R is 1.8e-9
# off and this module 9e-15.
#
# TOLERANCES
#
# Per function, from the worst disagreement with R observed on perl-5.44.0
# (double), perl-5.12.5 (long double) and 5.44.0-quadmath, with headroom; the
# diagnostic at the end prints the worst of each block on the build running it.
#
#   function  worst seen  limit   where
#   pt        2.3e-13     1e-12   log of the tail near 1 at q = -2^30, df = 30;
#                                 mpmath puts this module 4.5e-14 off and R
#                                 1.8e-13 off there, so it is R's error
#   pf        1.3e-13     1e-12   log of the tail near 1, pf(2^20, 10, 100);
#                                 here R is the closer (4e-15 against 1.3e-13):
#                                 the tail is formed as exp() of a log of
#                                 -565, which costs 565 eps
#   pbinom    5.2e-14     5e-13   log upper tail at k = 3 of 1000
#   qchisq    7.2e-14     5e-13   the log scale on a long double / __float128
#                                 (2.9e-14 on a double)
#   pchisq    4.7e-14     5e-13   df = 2^50, eight sd out, on __float128
#                                 (1.3e-14 on a double)
#   qf        1.3e-14     5e-13
#   qnorm qt  <5e-15      5e-13
#
# A row R recorded as 0 because a double underflowed is accepted as anything
# below 1e-300 on a wider NV, as t/distributions.R.scipy.t accepts it.

require 5.010;
use strict;
use warnings FATAL => 'all';
use Test::More;
use Stats::LikeR qw(pchisq qchisq pt qt pf qf qnorm pnorm pbinom);

# dyad() also reads "M*2^K", which the generator writes for a dyadic value of
# 2^53 or more: the df = 2^333 rows below are 1.7e100, and as decimals a long
# double parses them to its own nearest value rather than the double's, which
# moved pchisq(r df, df, log = TRUE) at r = 1 - 2^-33 by 2.3e-8 relative.
sub dyad {
	my ($t) = @_;
	if ($t =~ m{\A(-?[0-9]+)\*2\^([0-9]+)\z}) {
		my ($m, $k) = ($1, $2);
		my $v = $m;
		while ($k > 500) { $v *= 2 ** 500; $k -= 500 }
		return $v * 2 ** $k;
	}
	return $t unless $t =~ m{\A(-?[0-9]+)/2\^([0-9]+)\z};
	my ($m, $k) = ($1, $2);
	my $v = $m;
	while ($k > 500) { $v /= 2 ** 500; $k -= 500 }
	return $v / 2 ** $k;
}

my %WORST;
my $INF = 9**9**9;

sub rel_ok {
	my ($got, $want, $tol, $block, $name) = @_;
	if ($want eq 'NaN' || $want != $want) {
		return ok($got != $got, "$name is NaN");
	}
	if ($want == 0 && $got != 0 && abs($got) < 1e-300) {
		my $double = (1 + 2**-53 == 1);   # 2^-53 is half an ulp of 1 on a double only
		return ok(!$double, "$name (R's 0 is a double underflow; this build has "
		                  . sprintf('%.17g', $got) . ')');
	}
	my $rel;
	if ($want == 0 || $got == 0 || abs($want) == $INF || abs($got) == $INF) {
		$rel = ($got == $want) ? 0 : 9e99;
	} else {
		$rel = abs($got - $want) / abs($want);
	}
	$WORST{$block} = $rel if $rel < 9e99 && (!defined $WORST{$block} || $rel > $WORST{$block});
	my $pass = ok($rel <= $tol, $name);
	diag(sprintf "got %.17g want %.17g rel %.3g (tol %.3g)", $got, $want, $rel, $tol) unless $pass;
	return $pass;
}

my %DISPATCH = (
	pchisq => sub { pchisq($_[0], $_[1], lower => $_[2], log => $_[3]) },
	qchisq => sub { qchisq($_[0], $_[1], lower => $_[2], log => $_[3]) },
	pt     => sub { pt($_[0], $_[1], lower => $_[2], log => $_[3]) },
	qt     => sub { qt($_[0], $_[1], lower => $_[2], log => $_[3]) },
	pf     => sub { pf($_[0], $_[1], $_[2], lower => $_[3], log => $_[4]) },
	qf     => sub { qf($_[0], $_[1], $_[2], lower => $_[3], log => $_[4]) },
	qnorm  => sub { qnorm($_[0], mean => $_[1], sd => $_[2], lower => $_[3], log => $_[4]) },
	pbinom => sub { pbinom($_[0], $_[1], $_[2], lower => $_[3], log => $_[4]) },
);
my %TOL = (pt => 1e-12, pf => 1e-12, pbinom => 5e-13, qchisq => 5e-13,
           pchisq => 5e-13, qf => 5e-13, qnorm => 5e-13, qt => 5e-13);

# key => [ mpmath's 60-digit value, R's value ]
my %MPMATH = (
	'qt(-700/2^0,5/2^0,1/2^0,1/2^0)'
		=> [ '-9.9238968077120403429e+60', '-9.9238968256179741e+60' ],
	'qt(-700/2^0,5/2^0,0/2^0,1/2^0)'
		=> [ '9.9238968077120403429e+60', '9.9238968256179741e+60' ],
	'qf(-1/2^66,1/2^0,1/2^0,0/2^0,1/2^0)'
		=> [ '4.5319000852856747301e-40', 0 ],
	'qf(-64/2^0,1/2^0,1/2^0,1/2^0,1/2^0)'
		=> [ '6.3466722361887188628e-56', 0 ],
	'qf(-64/2^0,3/2^0,5/2^0,1/2^0,1/2^0)'
		=> [ '2.1778683379713967853e-19', 0 ],
	'qf(-1/2^66,3/2^0,5/2^0,0/2^0,1/2^0)'
		=> [ '4.1938192273020016891e-14', '4.2188474935755949e-14' ],
	'qf(-64/2^0,10/2^0,100/2^0,1/2^0,1/2^0)'
		=> [ '1.3836453916868166121e-6', '1.3836453915949676e-06' ],
	'qf(-1/2^10,1/2^0,1/2^0,0/2^0,1/2^0)'
		=> [ '2.3508041039406987773e-6', '2.3508041040454231e-06' ],
	'qf(-1/2^66,10/2^0,100/2^0,0/2^0,1/2^0)'
		=> [ '5.3262172825662788922e-5', '5.326217282553003e-05' ],

);

my %COUNT;
while (my $line = <DATA>) {
	chomp $line;
	next unless length $line;
	my ($fn, $args, $want) = split /\t/, $line;
	my @a = map { dyad($_) } split /,/, $args;
	my $got = $DISPATCH{$fn}->(@a);
	my $key = "$fn($args)";
	$COUNT{$fn}++;
	if (my $m = $MPMATH{$key}) {
		my ($truth, $r) = @$m;
		# 1e-13: this module's worst against these nine is 1.1e-14
		rel_ok($got, $truth, 1e-13, 'mpmath-arbitrated', "$key: within 1e-13 of mpmath's $truth");
		my $r_err = $r == 0 ? 1 : abs($r - $truth) / abs($truth);
		# 1e-12 separates the sides: R's smallest error among these is 2.5e-12
		cmp_ok($r_err, '>', 1e-12, "$key: R's $r is still the wrong one");
		next;
	}
	rel_ok($got, dyad($want), $TOL{$fn}, $fn, "$key == $want");
}
is(scalar keys %COUNT, 8, 'the frozen table covered all eight functions');

# all_eq(\@target, \@current, $tol): R's all.equal.numeric with
# scale = mean(|target|), which is what d-p-q-r-tst-2.R's All.eq() asks for
sub all_eq {
	my ($x, $y, $tol) = @_;
	my ($d, $s) = (0, 0);
	for my $i (0 .. $#$x) { $d += abs($x->[$i] - $y->[$i]); $s += abs($x->[$i]) }
	return ($d / @$x) / ($s / @$x) <= $tol;
}
my $EPS64 = 64 * 2**-52;

# d-p-q-r-tst-2.R:50
ok(abs(pchisq(60, 200, lower => 0, log => 1) + 7.3384686328784e-24) < 1e-36,
	'pgamma(30, 100, lower = FALSE, log = TRUE) == -7.3384686328784e-24 to 1e-36');

# d-p-q-r-tst-2.R:79-81: the upper tail of a gamma far out is exp(-x) to the
# first order, at every shape, x = 10^(100..295)
for my $sh (1e-250, 1e-25, 0.9, 1.1, 101, 1e10, 1e100) {
	my (@x, @lp);
	for my $e (100 .. 295) {
		my $x = 10**$e;
		push @x, -$x;
		push @lp, pchisq(2 * $x, 2 * $sh, lower => 0, log => 1);
	}
	ok(all_eq(\@x, \@lp, $EPS64), "pgamma(x, $sh, lower = FALSE, log = TRUE) ~ -x");
}

# d-p-q-r-tst-2.R:84-87: the lower tail near 0 is x^a / gamma(a + 1)
#
# R checks these with all.equal(), whose tolerance bounds the mean relative
# difference over all 123 x, not the worst one, and so does this. Measured on
# 0.331, mean (worst): a = 10 is 4.5e-14 (6.5e-14) on a double perl, 4.6e-14
# (6.5e-14) on perl-5.44.0+x87 and 4.2e-14 (1.25e-13) on 5.44.0-i686; a = 0.1
# is 7.0e-16 (7.0e-16) on a double perl, R's own i386 figure, but 5.7e-14
# (2.84e-13) on +x87 and 7.2e-14 (2.86e-13) on i686. The x87 builds round the
# log probability, near -70, one ulp differently for some x, and one ulp there
# is 2.85e-13 relative to the 0.0499 left after the cancellation, so a check of
# the worst x against R's 1e-13 cannot pass on x87. The mean leaves 1.4x
# headroom on i686, the thinnest of the matrix.
{
	my (@t10, @c10, @t01, @c01);
	for my $e (-1022 .. -900) {
		my $x = 2**$e;
		push @t10, -15.104412573076;
		push @c10, pchisq(2 * $x, 20, log => 1) - 10 * log($x);
		push @t01, 0.0498724412598364;
		push @c01, pchisq(2 * $x, 0.2, log => 1) - 0.1 * log($x);
	}
	ok(all_eq(\@t10, \@c10, 1e-12), 'pgamma(x, 10, log = TRUE) - 10 log x, x = 2^(-1022:-900)');
	ok(all_eq(\@t01, \@c01, 1e-13), 'pgamma(x, 0.1, log = TRUE) - 0.1 log x');
}

# d-p-q-r-tst-2.R:114-117: qgamma at p = 0 and 1
for my $sh (1.1, 0.5, 0.2, 0.15, 1e-2, 1e-10) {
	ok(qchisq(1, 2 * $sh) == $INF && qchisq(0, 2 * $sh) == 0, "qgamma({0, 1}, $sh) is {0, Inf}");
}

# d-p-q-r-tst-2.R:120-128 (PR#11030), the extreme left tail of qgamma
{
	my @p  = map { $_ * 1e-12 } 10 .. 123;
	my @qg = map { qchisq($_, 38) / 2 } @p;
	my $w = 0;
	for my $i (0 .. $#p) {
		my $r = abs(1 - pchisq(2 * $qg[$i], 38) / $p[$i]);
		$w = $r if $r > $w;
	}
	cmp_ok($w, '<', 1e-13, "abs(1 - pgamma(qgamma(p, 19), 19)/p) < 1e-13 (worst $w)");
	ok(!grep({ $qg[$_ + 2] - 2 * $qg[$_ + 1] + $qg[$_] >= -6e-6 } 0 .. $#qg - 2),
		'diff(qgamma(p, 19), diff = 2) < -6e-6');
	my @qg2 = map { qchisq($_ * 1e-9, 22) / 2 } 1 .. 100;
	ok(!grep({ $qg2[$_ + 2] - 2 * $qg2[$_ + 1] + $qg2[$_] >= -6e-6 } 0 .. $#qg2 - 2),
		'diff(qgamma(1:100 * 1e-9, 11), diff = 2) < -6e-6');
	ok(all_eq([2.35047385139143], [$qg[0]], $EPS64), 'qgamma(1e-11, 19) == 2.35047385139143');
	ok(all_eq([1.11512318734547], [$qg2[29]], $EPS64), 'qgamma(3e-8, 11) == 1.11512318734547');
}

# d-p-q-r-tst-2.R:170-176: qt's far tail on df = 1
{
	my $w = 0;
	for my $k (10 .. 20) {
		my $p = 10**-$k;
		my $r = abs(1 - $p / pt(qt($p, 1), 1));
		$w = $r if $r > $w;
	}
	cmp_ok($w, '<', 1e-14, 'qt(10^(-10:-20), 1) inverts pt to 1e-14');
}

# d-p-q-r-tst-2.R:178-182: df = 2 at p ~ 0 (log) and p ~ 1/2
ok(all_eq([-exp(370) / sqrt(2)], [qt(-740, 2, log => 1)], $EPS64),
	'qt(-740, df = 2, log = TRUE) == -exp(370)/sqrt(2)');
ok(all_eq([8.429369702179e-08, 2.634178031931e-09, 8.231806349784e-11, 2.572439484308e-12],
          [map { qt(0.5 + 2**(-5 * $_), 2) } 5 .. 8], 1.5e-8),
	'qt(0.5 + 2^(-5*(5:8)), df = 2): R\'s pinned values (given to 13 digits)');

# d-p-q-r-tst-2.R:185-186
ok(abs(qt(-1000, 4, log => 1) / -4.930611e108 - 1) < 1e-6, 'qt(-1000, df = 4, log = TRUE) == -4.930611e108');

# d-p-q-r-tst-2.R:187-189: log qt is linear in log p with slope 5/6 at df = 1.2
{
	my @lq = map { log(qt(-$_, 1.2, log => 1, lower => 0)) } 20 .. 850;
	my @dev = sort { $a <=> $b } map { abs(5 / 6 - ($lq[$_ + 1] - $lq[$_])) } 0 .. $#lq - 1;
	cmp_ok($dev[int(0.995 * $#dev)], '<', 1e-11, 'diff(log(qt(-(20:850), 1.2, log, upper))) ~ 5/6');
}

# d-p-q-r-tst-2.R:191-198: near df = 1, where R needs its Taylor steps
ok(abs(pt(qt(-20, 1.02, log => 1), 1.02, log => 1) + 20) <= 20e-12,
	'pt(qt(-20, df = 1.02, log = TRUE), log = TRUE) == -20 to 1e-12');
{
	my @lq = map { log(qt(-2**-$_, 1.1, log => 1)) } 10 .. 600;
	ok(!grep({ $lq[$_ + 1] - $lq[$_] <= 0.6 } 0 .. $#lq - 1), 'diff(log(qt(-2^-(10:600), 1.1, log))) > 0.6');
	my ($s1, $s2) = (0, 0);
	my @l1 = map { log(qt(-2**-$_, 1, log => 1)) } 20 .. 600;
	my @l2 = map { log(qt(-2**-$_, 2, log => 1)) } 20 .. 600;
	$s1 += abs($l1[$_ + 1] - $l1[$_] - log(2)) for 0 .. $#l1 - 1;
	$s2 += abs($l2[$_ + 1] - $l2[$_] - log(sqrt(2))) for 0 .. $#l2 - 1;
	cmp_ok($s1 / $#l1, '<', 1e-8, 'df = 1: mean |diff(log qt) - log 2| < 1e-8');
	cmp_ok($s2 / $#l2, '<', 4e-8, 'df = 2: mean |diff(log qt) - log sqrt(2)| < 4e-8');
}

# d-p-q-r-tst-2.R:200-201: R asks 4e-16 of this round trip
{
	my (@lp, @back);
	for my $lp (40 .. 406) { push @lp, $lp; push @back, -pt(qt(exp(-$lp), 1.2), 1.2, log => 1) }
	ok(all_eq(\@lp, \@back, 4e-16), 'lp == -pt(qt(exp(-lp), 1.2), 1.2, log = TRUE), lp = 40:406');
}

# d-p-q-r-tst-2.R:203-212 (PR#18360). R asks 0.2 and notes it is "still
# inaccurate"; here the worst relative error is 8.6e-14 on a double, so the
# assertion is 1e-12.
{
	my $w = 0;
	for my $df (1.001, map { 1 + $_ / 100 } 1 .. 10) {
		for (my $l = 200; $l <= 500; $l += 0.5) {
			my $q = exp($l);
			my $r = abs(qt(pt($q, $df, log => 1), $df, log => 1) / $q - 1);
			$w = $r if $r > $w;
		}
	}
	cmp_ok($w, '<', 1e-12, "qt(pt(q, df, log = TRUE), df, log = TRUE) == q, q = exp(200..500) (worst $w)");
}

# d-p-q-r-tst-2.R:219-226: pt(-2^(0:1022), log = TRUE) stays finite
for my $nu (0.1, 0.2, 0.5, 1, 1.2, 2.2, 5, 10, 20, 50, 100, 500) {
	my @bad = grep { my $v = pt(-(2**$_), $nu, log => 1); !($v > -$INF && $v < $INF) } 0 .. 1022;
	is(scalar @bad, 0, "pt(-2^(0:1022), df = $nu, log = TRUE) is finite");
}

# d-p-q-r-tst-2.R:791-808: qnorm's extreme tails on the log scale
{
	my $w = 0;
	for (my $e = 0; $e <= 155; $e += 1 / 8) {
		my $qs = 2**$e;
		my $lp = pnorm($qs, log => 1, lower => 0);
		for my $r (abs(qnorm($lp, log => 1, lower => 0) / $qs - 1), abs(qnorm($lp, log => 1) / -$qs - 1)) {
			$w = $r if $r > $w;
		}
	}
	cmp_ok($w, '<', 1e-15, "qnorm(pnorm(qs, log, upper), log, upper) == qs, qs = 2^(0..155) (worst $w)");
}

# d-p-q-r-tst-2.R:102-109: pf(1, 1, nu) rises monotonically to pchisq(1, 1)
{
	my $target = pchisq(1, 1);
	my @y = map { pf(1, 1, 2**(25 + $_ / 2)) } 0 .. 18;
	is(pf(1, 1, $INF), $target, 'pf(1, 1, Inf) == pchisq(1, 1)');
	ok(!grep({ $y[$_] >= $y[$_ + 1] } 0 .. $#y - 1) && $y[-1] < $target, 'pf(1, 1, 2^(25:34 by .5)) is increasing');
	cmp_ok(abs($y[0] - ($target - 7.21129e-9)), '<', 1e-11, 'pf(1, 1, 2^25) == pchisq(1, 1) - 7.21129e-9');
}

# d-p-q-r-tst-2.R:258-261
is(qf(0.25, $INF, $INF), 1, 'qf(1/4, Inf, Inf) == 1');
cmp_ok(abs(1 - 1e-18 / pf(qf(1e-18, 12, 50), 12, 50)), '<', 1e-10, '1e-18 / pf(qf(1e-18, 12, 50), 12, 50) == 1');
cmp_ok(abs(0.01 - qf(pf(0.01, 1e60, 1e90, log => 1), 1e60, 1e90, log => 1)), '<', 1e-4,
	'qf(pf(0.01, 1e60, 1e90, log.p = TRUE), ..., log.p = TRUE) == 0.01');

# tests/d-p-q-r-tests.R:468-476 and its .Rout.save: pf with an infinite df
{
	my @x = (1 / 3.141592653589793, 1, 3.141592653589793);
	my @got3 = map { pf($_, 3, $INF) } @x;
	my @gotI = map { pf($_, $INF, 5) } @x;
	# the .Rout.save prints 8 significant digits
	ok(all_eq([0.18784423, 0.60837482, 0.97585479], \@got3, 1e-8), 'pf(c(1/pi, 1, pi), 3, Inf)');
	ok(all_eq([0.0077292503, 0.4158801870, 0.9022693759], \@gotI, 1e-8), 'pf(c(1/pi, 1, pi), Inf, 5)');
	is_deeply([map { pf($_, $INF, $INF) } @x], [0, 0.5, 1], 'pf(c(1/pi, 1, pi), Inf, Inf) == (0, 1/2, 1)');
}

diag('worst relative error by block:');
diag(sprintf '  %-20s %.3g', $_, $WORST{$_}) for sort keys %WORST;

done_testing();

