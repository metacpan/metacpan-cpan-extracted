my %TAB = (
	convictions => [2, 15, 10, 3], performance => [794, 150, 86, 570],
	tea => [3, 1, 1, 3], readme => [30, 70, 20, 80], rare => [3, 997, 1, 999],
	protective => [10, 90, 40, 60], smokers12 => [83, 3, 90, 3],
);
for my $row (@R) {
	my ($name, @e) = @$row;
	my $r = eval { epi_2x2(@{ $TAB{$name} }) };
	if (!$r) { fail("R $name: died: $@") for 1 .. 3; next }
	near($r->{odds_ratio},       $e[0], 1e-9, "R glm $name: odds_ratio");
	near($r->{odds_ratio_ci}[0], $e[1], 1e-9, "R glm $name: odds_ratio_ci lower");
	near($r->{odds_ratio_ci}[1], $e[2], 1e-9, "R glm $name: odds_ratio_ci upper");
}

# call forms agree
{
	my $a = epi_2x2(2, 15, 10, 3, conf_level => 0.9);
	my $b = epi_2x2([2, 15, 10, 3], conf_level => 0.9);
	my $c = epi_2x2([[2, 15], [10, 3]], conf_level => 0.9);
	is_deeply($b->{odds_ratio_ci}, $a->{odds_ratio_ci}, 'flat arrayref form = four scalars');
	is_deeply($c->{risk_ratio_ci}, $a->{risk_ratio_ci}, 'nested form = four scalars');
}

# nnt = 1 / |risk_diff|, risks; the README example
{
	my $r = epi_2x2(30, 70, 20, 80);
	near($r->{nnt}, 10, 1e-12, 'nnt is 1/|RD| (README table)');
	near($r->{risk_exposed}, 0.3, 1e-12, 'risk_exposed');
	near($r->{risk_unexposed}, 0.2, 1e-12, 'risk_unexposed');
	my $z = epi_2x2(2, 2, 2, 2);
	ok($z->{nnt} == 9**9**9, 'zero risk difference: nnt is Inf');
	is($z->{correction}, 0, 'no zero cell, no correction');
	is(epi_2x2(0, 10, 5, 10)->{correction}, 1, 'a zero cell forces the 0.5 correction');
}

throws_ok { epi_2x2(1, 2, 3) } qr/need 4 cell counts/, 'three cells die';
throws_ok { epi_2x2(1, 2, 3, -4) } qr/./, 'a negative cell dies';
throws_ok { epi_2x2(1, 2, 3, 4, conf_level => 1) } qr/conf_level/, 'conf_level 1 dies';
throws_ok { epi_2x2(1, 2, 3, 4, 'correct') } qr/key => value/, 'dangling option dies';

no_leaks_ok { epi_2x2(2, 15, 10, 3, conf_level => 0.9, correct => 1) } 'epi_2x2 does not leak'
	unless $INC{'Devel/Cover.pm'};

done_testing();
