<div class="graph-panel" id="histogram-panel" hidden>
  <form id="histogram-form" method="get" action="/histogram"
        data-parent-back="[% back_url | html %]" data-parent-back-label="[% back_label | html %]">
    <input type="hidden" name="l" value="[% left_spec | html %]">
    [%- FOREACH jspec IN current_joins -%]
    <input type="hidden" name="j" value="[% jspec | html %]">
    [%- END -%]
    [%- FOREACH fs IN filter_specs -%]
    <input type="hidden" name="f" value="[% fs | html %]">
    [%- END -%]
    <input type="hidden" name="back" id="histogram-back-inp" value="">
    <input type="hidden" name="back2" id="histogram-back2-inp" value="">
    <input type="hidden" name="back2_label" id="histogram-back2-label-inp" value="">

    <h3 class="graph-panel-title">&#x1F4CA; Histogram</h3>
    <p class="graph-panel-desc">Choose a numeric column to plot its distribution. Adjust the number of bins (1-200) to control the granularity.</p>

    <div class="graph-fields-row">
      <div class="join-field">
        <label for="histogram-col-sel">Numeric column</label>
        <select id="histogram-col-sel" name="col" required>
          <option value="">&#x2014; select column &#x2014;</option>
        </select>
      </div>
      <div class="join-field">
        <label for="histogram-bins-inp">Number of bins</label>
        <input type="number" id="histogram-bins-inp" name="bins" min="1" max="200" value="10"
               style="width:5rem">
      </div>
      <div class="graph-btn-col">
        <span class="graph-btn-spacer"></span>
        <div class="graph-btn-row">
          <button type="submit" id="btn-do-histogram" class="btn-primary" disabled>Plot</button>
          <button type="button" id="btn-cancel-histogram" class="btn-secondary">Cancel</button>
        </div>
      </div>
    </div>
  </form>
</div>

<div class="graph-panel" id="map-panel" hidden>
  <form id="map-form" method="get" action="/map"
        data-parent-back="[% back_url | html %]" data-parent-back-label="[% back_label | html %]">
    <input type="hidden" name="l" value="[% left_spec | html %]">
    [%- FOREACH jspec IN current_joins -%]
    <input type="hidden" name="j" value="[% jspec | html %]">
    [%- END -%]
    [%- FOREACH cspec IN combine_specs -%]
    <input type="hidden" name="c" value="[% cspec | html %]">
    [%- END -%]
    [%- FOREACH fs IN filter_specs -%]
    <input type="hidden" name="f" value="[% fs | html %]">
    [%- END -%]
    [%- IF dedup -%]
    <input type="hidden" name="d" value="1">
    [%- END -%]
    <input type="hidden" name="back" id="map-back-inp" value="">
    <input type="hidden" name="back2" id="map-back2-inp" value="">
    <input type="hidden" name="back2_label" id="map-back2-label-inp" value="">

    <h3 class="graph-panel-title">&#x1F5FA; Map</h3>
    <p class="graph-panel-desc">Plot the current rows on a map. Use latitude and longitude columns, or let the app geocode a place-name column. Filters, joins and calculated fields carry over.</p>

    <div class="graph-fields-row">
      <div class="join-field">
        <label for="map-mode-sel">Places are</label>
        <select id="map-mode-sel">
          <option value="coords">Coordinate columns</option>
          <option value="loc">Place-name column</option>
        </select>
      </div>
      <div class="join-field" id="map-lat-field">
        <label for="map-lat-sel">Latitude</label>
        <select id="map-lat-sel" name="lat" required>
          <option value="">&#x2014; select column &#x2014;</option>
          [%- FOREACH col IN columns -%]
          <option value="[% col | html %]">[% col | html %]</option>
          [%- END -%]
        </select>
      </div>
      <div class="join-field" id="map-lon-field">
        <label for="map-lon-sel">Longitude</label>
        <select id="map-lon-sel" name="lon" required>
          <option value="">&#x2014; select column &#x2014;</option>
          [%- FOREACH col IN columns -%]
          <option value="[% col | html %]">[% col | html %]</option>
          [%- END -%]
        </select>
      </div>
      <div class="join-field" id="map-loc-field" hidden>
        <label for="map-loc-sel">Place column</label>
        <select id="map-loc-sel" name="loc" disabled>
          <option value="">&#x2014; select column &#x2014;</option>
          [%- FOREACH col IN columns -%]
          <option value="[% col | html %]">[% col | html %]</option>
          [%- END -%]
        </select>
      </div>
      <div class="graph-btn-col">
        <span class="graph-btn-spacer"></span>
        <div class="graph-btn-row">
          <button type="submit" id="btn-do-map" class="btn-primary" disabled>Open map</button>
          <button type="button" id="btn-cancel-map" class="btn-secondary">Cancel</button>
        </div>
      </div>
    </div>

    <div class="graph-fields-row" id="map-color-row">
      <div class="join-field">
        <label for="map-color-sel">Colour by column</label>
        <select id="map-color-sel">
          <option value="">&#x2014; none &#x2014;</option>
        </select>
      </div>
      <div class="join-field" id="map-color-default-field" hidden>
        <label for="map-color-default-inp">Default colour</label>
        <input type="text" id="map-color-default-inp" placeholder="#3388ff" size="10">
      </div>
    </div>
    <div id="map-color-rules" hidden>
      <div class="filter-section-head" style="margin:0.4rem 0 0.2rem;font-size:0.85rem;font-weight:600;color:#555">Colour rules &mdash; first match wins</div>
      <div id="map-rule-rows"></div>
      <button type="button" id="btn-add-map-rule" class="btn-add-filter">&#x2b; Add rule</button>
    </div>
  </form>
</div>

<div class="graph-panel" id="folder-panel" hidden>
  <form id="folder-form" method="get" action="/folder">
    <input type="hidden" name="l" value="[% left_spec | html %]">
    <input type="hidden" name="back" id="folder-back-inp" value="">

    <h3 class="graph-panel-title">&#x1F4C1; Folder view</h3>

    <p class="graph-panel-desc">Choose the column whose values contain order codes (e.g. A10, CT4, B3). Records will be grouped by the letter prefix of that column.</p>

    <div class="graph-fields-row">
      <div class="join-field">
        <label for="folder-col-sel">Code column</label>
        <select id="folder-col-sel" name="col" required>
          <option value="">&#x2014; select column &#x2014;</option>
          [%- FOREACH col IN columns -%]
          <option value="[% col | html %]">[% col | html %]</option>
          [%- END -%]
        </select>
      </div>
      <div class="graph-btn-col">
        <span class="graph-btn-spacer"></span>
        <div class="graph-btn-row">
          <button type="submit" id="btn-do-folder" class="btn-primary" disabled>Open</button>
          <button type="button" id="btn-cancel-folder" class="btn-secondary">Cancel</button>
        </div>
      </div>
    </div>
  </form>
</div>

<div class="graph-panel" id="pivot-panel" hidden>
  <form id="pivot-form" method="get" action="/pivot">
    <input type="hidden" name="l" value="[% left_spec | html %]">
    [%- FOREACH jspec IN current_joins -%]
    <input type="hidden" name="j" value="[% jspec | html %]">
    [%- END -%]
    [%- FOREACH fs IN filter_specs -%]
    <input type="hidden" name="f" value="[% fs | html %]">
    [%- END -%]

    <h3 class="graph-panel-title">&#x25A6; Pivot table</h3>
    <p class="graph-panel-desc">Group and aggregate data into a crosstab. Dimensions become the row and column headers; measures compute a value for each cell.</p>

    <div class="pivot-config">
      <div class="pivot-config-col">
        <div class="pivot-section-head">Row dimensions <span class="pivot-req">* required</span></div>
        <div id="pivot-row-dims" class="pivot-dim-list"></div>
        <button type="button" id="btn-add-pivot-row" class="btn-add-filter">&#x2b; Add row</button>
      </div>

      <div class="pivot-config-col">
        <div class="pivot-section-head">Column dimensions <span class="pivot-opt">(optional)</span></div>
        <div id="pivot-col-dims" class="pivot-dim-list"></div>
        <button type="button" id="btn-add-pivot-col" class="btn-add-filter">&#x2b; Add column</button>
      </div>

      <div class="pivot-config-col pivot-config-wide">
        <div class="pivot-section-head">Measures <span class="pivot-req">* required</span></div>
        <div id="pivot-measures" class="pivot-measure-list"></div>
        <button type="button" id="btn-add-pivot-measure" class="btn-add-filter">&#x2b; Add measure</button>
      </div>
    </div>

    <div class="pivot-options-row">
      <label><input type="checkbox" id="pivot-totals"> Show subtotals and grand total</label>
      <span style="margin-left:1.5rem;white-space:nowrap" title="Show only the top N row groups; remaining rows are aggregated into an Other row">
        Limit to top
        <input type="number" id="pivot-topn-inp" name="topn" min="1" placeholder="all"
               style="width:4rem;margin:0 0.3rem">
        rows
      </span>
      <span style="margin-left:0.75rem;white-space:nowrap" title="Measure alias to rank rows by (leave blank to use the first measure)">
        ranked by
        <input type="text" id="pivot-topn-col-inp" name="topn_col" placeholder="measure alias"
               style="width:9rem;margin-left:0.3rem">
      </span>
    </div>

    <div class="join-actions">
      <button type="button" id="btn-cancel-pivot" class="btn-secondary">Cancel</button>
      <button type="submit" id="btn-do-pivot" class="btn-primary" disabled>Build pivot</button>
    </div>
  </form>
</div>

<div class="graph-panel" id="calc-panel" hidden>
  <h3 class="graph-panel-title">&fnof;(x) Calculated columns</h3>
  <p class="graph-panel-desc">Define virtual columns from expressions. Column names are variables; supports +, -, *, /, IF(), YEAR(), MONTH(), bin(), and more. Saved fields are applied automatically when this data source is opened.</p>
  <div id="calc-field-list" style="margin-bottom:0.5rem"></div>
  <div class="graph-fields-row" style="align-items:flex-end;gap:0.5rem;flex-wrap:wrap">
    <div class="join-field" style="flex:0 0 auto;min-width:8rem">
      <label for="calc-name-inp">Column name</label>
      <input type="text" id="calc-name-inp" placeholder="e.g. margin"
             title="Identifier: letters, digits, underscore; must start with a letter or _">
    </div>
    <div class="join-field" style="flex:1 1 12rem">
      <label for="calc-expr-inp">Expression</label>
      <input type="text" id="calc-expr-inp" placeholder="e.g. revenue - cost">
    </div>
    <div style="padding-bottom:0.2rem">
      <button type="button" id="btn-save-calc" class="btn-primary" disabled>Save &amp; apply</button>
    </div>
  </div>
  <div class="join-actions" style="margin-top:0.75rem">
    <button type="button" id="btn-cancel-calc" class="btn-secondary">Close</button>
  </div>
</div>

<div class="graph-panel" id="groups-panel" hidden>
  <h3 class="graph-panel-title">&#x25BC; Group values</h3>
  <p class="graph-panel-desc">Map values in a column to a label. A virtual <em>col_group</em> column is added: values in a group become the group label; unmatched values become <em>(other)</em>. Changes apply after reload.</p>
  <div class="graph-fields-row" style="align-items:flex-end;gap:0.5rem;margin-bottom:0.75rem">
    <div class="join-field" style="flex:0 0 auto;min-width:10rem">
      <label for="groups-col-sel">Source column</label>
      <select id="groups-col-sel">
        <option value="">&#x2014; select &#x2014;</option>
        [%- FOREACH col IN columns -%]
        <option value="[% col | html %]">[% col | html %]</option>
        [%- END -%]
      </select>
    </div>
  </div>
  <div id="groups-existing" style="margin-bottom:0.5rem"></div>
  <div id="groups-add-row" hidden>
    <div class="graph-fields-row" style="align-items:flex-end;gap:0.5rem;flex-wrap:wrap">
      <div class="join-field" style="flex:0 0 auto;min-width:8rem">
        <label for="groups-name-inp">Group label</label>
        <input type="text" id="groups-name-inp" placeholder="e.g. Northern">
      </div>
      <div class="join-field" style="flex:1 1 12rem">
        <label for="groups-vals-inp">Values (one per line)</label>
        <textarea id="groups-vals-inp" rows="3" placeholder="North&#10;Northeast"
                  style="width:100%;box-sizing:border-box;font-family:monospace;font-size:0.87rem"></textarea>
      </div>
      <div style="padding-bottom:0.2rem">
        <button type="button" id="btn-save-group" class="btn-primary">Save group</button>
      </div>
    </div>
  </div>
  <div id="groups-add-btn-row" hidden style="margin-top:0.25rem">
    <button type="button" id="btn-add-group" class="btn-add-filter">&#x2b; Add group</button>
  </div>
  <div class="join-actions" style="margin-top:0.75rem">
    <button type="button" id="btn-cancel-groups" class="btn-secondary">Close</button>
  </div>
</div>

<div class="graph-panel" id="dates-panel" hidden>
  <h3 class="graph-panel-title">&#x1F4C5; Date column formats</h3>
  <p class="graph-panel-desc">Tell the app how date columns are formatted so YEAR(), MONTH(), DAY(), QUARTER() and date sorting work correctly. Saved patterns are applied automatically when this data source is opened.</p>
  <div id="dates-list" style="margin-bottom:0.5rem"></div>
  <div class="graph-fields-row" style="align-items:flex-end;gap:0.5rem;flex-wrap:wrap">
    <div class="join-field" style="flex:0 0 auto;min-width:10rem">
      <label for="dates-col-sel">Column</label>
      <select id="dates-col-sel">
        <option value="">&#x2014; select &#x2014;</option>
        [%- FOREACH col IN columns -%]
        <option value="[% col | html %]">[% col | html %]</option>
        [%- END -%]
      </select>
    </div>
    <div class="join-field" style="flex:0 0 auto;min-width:14rem">
      <label for="dates-pat-sel">Format</label>
      <select id="dates-pat-sel">
        <option value="%m/%d/%Y">M/D/YYYY &mdash; US (12/31/2025)</option>
        <option value="%d/%m/%Y">D/M/YYYY &mdash; EU (31/12/2025)</option>
        <option value="%d-%b-%Y">D-Mon-YYYY (31-Dec-2025)</option>
      </select>
    </div>
    <div style="padding-bottom:0.2rem">
      <button type="button" id="btn-save-date" class="btn-primary" disabled>Save &amp; apply</button>
    </div>
  </div>
  <div style="margin-top:0.75rem;padding-top:0.75rem;border-top:1px solid #d0d8f0">
    <div class="filter-section-label" style="margin-bottom:0.45rem">Quick date filters (uses selected column)</div>
    <div style="display:flex;gap:0.5rem;flex-wrap:wrap">
      <button type="button" id="btn-dates-ytd"  class="btn-secondary" disabled>This year</button>
      <button type="button" id="btn-dates-qtd"  class="btn-secondary" disabled>This quarter</button>
      <button type="button" id="btn-dates-mtd"  class="btn-secondary" disabled>This month</button>
    </div>
  </div>
  <div class="join-actions" style="margin-top:0.75rem">
    <button type="button" id="btn-cancel-dates" class="btn-secondary">Close</button>
  </div>
</div>

<form id="stats-form" method="get" action="/stats" style="display:none">
  <input type="hidden" name="l" value="[% left_spec | html %]">
  [%- FOREACH fs IN filter_specs -%]
  <input type="hidden" name="f" value="[% fs | html %]">
  [%- END -%]
  <input type="hidden" name="back" id="stats-form-back" value="">
  <input type="hidden" name="back_label" value="Back to table">
</form>
[%- END -%]

[% IF records.size %]
<p class="sr-only" id="table-head-help">Sort a column: focus its header, then press Enter or
Space.  Select the column for deletion: Ctrl+Enter or Ctrl+Space.  Move the column one place left
or right: Shift+Left or Shift+Right.  Clicking a header sorts it, Ctrl+click selects it, and
dragging it moves it.</p>
<p class="sr-only" id="table-live" role="status"></p>
<div class="table-scroll">
<table id="bi-table" data-table="[% table | html %]">
  <thead>
    <tr>
      [% FOREACH col IN columns -%]
      <th draggable="true" aria-sort="none" tabindex="0"
          aria-describedby="table-head-help">[% col | html %]</th>
      [%- END %]
    </tr>
  </thead>
  <tbody>
    [% FOREACH row IN records -%]
    <tr>
      [% FOREACH col IN columns -%]
      <td>[% row.$col | html %]</td>
      [%- END %]
    </tr>
    [%- END %]
  </tbody>
</table>
</div>

[% SET pnum = page ? page : 0 %]
[% IF pnum > 1 OR has_next %]
[% SET sep = (page_base_url.search('\?') >= 0) ? '&amp;' : '?' %]
<nav class="pagination" aria-label="Page navigation">
  [% IF pnum > 1 %]
  <a class="page-btn" href="[% page_base_url | html %][% sep %]page=[% pnum - 1 %]&amp;per_page=[% per_page %]">&laquo; Prev</a>
  [% ELSE %]
  <span class="page-btn page-btn-dis">&laquo; Prev</span>
  [% END %]

  <span class="page-btn page-btn-cur">[% page %]</span>

  [% IF has_next %]
  <a class="page-btn" href="[% page_base_url | html %][% sep %]page=[% pnum + 1 %]&amp;per_page=[% per_page %]">Next &raquo;</a>
  [% ELSE %]
  <span class="page-btn page-btn-dis">Next &raquo;</span>
  [% END %]

  <span class="page-info">Page [% page %][% IF per_page %] &mdash; [% per_page %] rows/page[% END %]</span>
</nav>
[% END %]

[% ELSE %]
<p class="empty-state">No records found in <strong>[% table | html %]</strong>.</p>
[% END %]

<script>
// parseAccounting is defined at module scope (outside any IIFE) so it is
// accessible from all script blocks on this page -- the sort block uses it for
// numeric column detection, and the graph panel's isNumericVal delegates to it.
function parseAccounting(v) {
  if (v === '') return NaN;
  var s   = v.trim();
  var neg = /^\(.*\)$/.test(s);      // (value) means negative
  s = s.replace(/[^\d.\-]/g, '');    // strip $, commas, parens, spaces, etc.
  var n = parseFloat(s);
  return isNaN(n) ? NaN : (neg ? -Math.abs(n) : n);
}

(function () {
  var table     = document.getElementById('bi-table');
  if (!table) return;
  var chkTotals = document.getElementById('chk-totals');

  // SEL = 1: the checkbox column we inject is always cell 0 in each row, so
  // every data-column DOM cell index = headers-array index + SEL.
  var SEL = 1;

  // Inject the checkbox selector column into every existing row.
  (function injectSelCol() {
    var theadRow = table.querySelector('thead tr');
    var selTh = document.createElement('th');
    selTh.className = 'sel-th';
    theadRow.insertBefore(selTh, theadRow.firstChild);

    Array.from(table.querySelectorAll('tbody tr')).forEach(function (tr) {
      var selTd = document.createElement('td');
      selTd.className = 'sel-td';
      var chk = document.createElement('input');
      chk.type = 'checkbox';
      chk.className = 'row-chk';
      chk.title = 'Select this row';
      selTd.appendChild(chk);
      tr.insertBefore(selTd, tr.firstChild);
    });
  }());

  var headers    = Array.from(table.querySelectorAll('thead th:not(.sel-th)'));
  var dragSrcIdx = null;
  var sortColIdx = -1;
  var sortAsc    = true;
  var STORE_KEY  = 'bi:' + (table.dataset.table || '');

  // --- Selection state ---
  var selectedRows = new Set();  // Set of <tr> elements
  var selectedCols = new Set();  // Set of header indices (into headers[])
  var btnDel = document.getElementById('btn-delete-sel');

  // --- Persistence ---

  function loadState() {
    try { return JSON.parse(localStorage.getItem(STORE_KEY)) || {}; }
    catch (e) { return {}; }
  }

  function saveState() {
    try {
      localStorage.setItem(STORE_KEY, JSON.stringify({
        columns: headers.map(function (h) { return h.textContent.trim(); }),
        sortCol: sortColIdx >= 0 ? headers[sortColIdx].textContent.trim() : null,
        sortAsc: sortAsc,
        totals:  chkTotals ? chkTotals.checked : false
      }));
    } catch (e) {}
  }

  // --- Totals row ---

  // Builds (or rebuilds) a <tfoot> row with the sum of each all-numeric column.
  // Non-numeric columns are left blank; the first non-numeric cell shows "Total".
  // moveCol() operates on table.rows (which includes tfoot), so cell reordering
  // keeps the totals aligned automatically without requiring a rebuild on drag.
  function buildTotals() {
    var tbody  = table.tBodies[0];
    var rows   = Array.from(tbody.rows);
    var tfoot  = table.tFoot || table.createTFoot();
    while (tfoot.firstChild) tfoot.removeChild(tfoot.firstChild);
    var tr = tfoot.insertRow();
    // Placeholder cell for the selector column
    tr.insertCell().className = 'sel-td';
    headers.forEach(function (h, i) {
      var td   = tr.insertCell();
      var vals = rows.map(function (r) {
        return r.cells[i + SEL] ? r.cells[i + SEL].textContent.trim() : '';
      }).filter(function (v) { return v !== ''; });
      var isDate = vals.length > 0 && vals.every(function (v) {
        return /^\d{4}-\d{2}-\d{2}$/.test(v) || /^\d{1,2}\/\d{1,2}\/\d{4}$/.test(v);
      });
      var numeric = !isDate && vals.length > 0 && vals.every(function (v) {
        return !isNaN(parseAccounting(v));
      });
      if (numeric) {
        var sum    = vals.reduce(function (acc, v) { return acc + parseAccounting(v); }, 0);
        var hasDec = vals.some(function (v) { return /\.\d+/.test(v.replace(/[^0-9.]/g, '')); });
        td.textContent = hasDec ? sum.toFixed(2) : String(Math.round(sum));
        td.className   = 'totals-sum';
      }
      // Re-apply col-selected highlight to tfoot cells when totals are rebuilt
      if (selectedCols.has(i)) td.classList.add('col-selected');
    });
  }

  function removeTotals() {
    if (table.tFoot) table.deleteTFoot();
  }

  // --- Selection helpers ---

  function updateDeleteBtn() {
    if (!btnDel) return;
    var rCount = selectedRows.size;
    var cCount = selectedCols.size;
    if (rCount + cCount === 0) {
      btnDel.hidden = true;
      return;
    }
    btnDel.hidden = false;
    var parts = [];
    if (rCount) parts.push(rCount + ' row' + (rCount > 1 ? 's' : ''));
    if (cCount) parts.push(cCount + ' column' + (cCount > 1 ? 's' : ''));
    btnDel.title = 'Remove ' + parts.join(' and ') + ' from this view';
  }

  function setColHighlight(idx, on) {
    // Apply or remove col-selected class on body/foot cells only (not the header).
    Array.from(table.querySelectorAll('tbody tr, tfoot tr')).forEach(function (row) {
      var cell = row.cells[idx + SEL];
      if (cell) on ? cell.classList.add('col-selected') : cell.classList.remove('col-selected');
    });
  }

  function toggleColSel(idx) {
    if (selectedCols.has(idx)) {
      selectedCols.delete(idx);
      setColHighlight(idx, false);
    } else {
      selectedCols.add(idx);
      setColHighlight(idx, true);
    }
    updateDeleteBtn();
  }

  // The name a column is known by, for an announcement.
  function columnName(idx) {
    return headers[idx] ? headers[idx].textContent.trim() : '';
  }

  // A header is a control now, so what it does from the keyboard is said the
  // same way the canvas grips say what they did.  It is a live region rather
  // than a title: a title is read on hover, which a keyboard reader is not
  // doing.
  function announceTable(message) {
    var live = document.getElementById('table-live');
    if (live) live.textContent = message;
  }

  function sortColumn(th) {
    var idx = colIndex(th);
    if (sortColIdx === idx) { sortAsc = !sortAsc; }
    else { sortColIdx = idx; sortAsc = true; }
    sortByCol(sortColIdx, sortAsc);
    saveState();
    announceTable('Sorted by ' + columnName(idx) + (sortAsc ? ' ascending' : ' descending'));
  }

  function selectColumn(th) {
    var idx = colIndex(th);
    toggleColSel(idx);
    announceTable((selectedCols.has(idx) ? 'Selected column ' : 'Deselected column ')
      + columnName(idx));
  }

  function toggleRowSel(tr, checked) {
    var chk = tr.querySelector('.row-chk');
    if (chk) chk.checked = checked;
    if (checked) {
      selectedRows.add(tr);
      tr.classList.add('row-selected');
    } else {
      selectedRows.delete(tr);
      tr.classList.remove('row-selected');
    }
    updateDeleteBtn();
  }

  function deleteSelected() {
    // Delete rows first (simpler -- just remove the <tr> from the DOM).
    selectedRows.forEach(function (tr) { tr.parentNode.removeChild(tr); });
    selectedRows.clear();

    // Delete columns in descending index order so earlier indices stay valid.
    var colsDesc = Array.from(selectedCols).sort(function (a, b) { return b - a; });
    colsDesc.forEach(function (idx) {
      // Remove the <th> from thead.
      var th = headers[idx];
      if (th && th.parentNode) th.parentNode.removeChild(th);
      headers.splice(idx, 1);

      // Adjust the sorted column index.
      if      (sortColIdx === idx)   sortColIdx = -1;
      else if (sortColIdx > idx)     sortColIdx--;

      // Remove the corresponding <td> from every tbody row and the tfoot.
      Array.from(table.querySelectorAll('tbody tr, tfoot tr')).forEach(function (row) {
        var cell = row.cells[idx + SEL];
        if (cell) row.removeChild(cell);
      });
    });
    selectedCols.clear();

    // Reset aria-sort on remaining headers.
    headers.forEach(function (h, i) {
      h.setAttribute('aria-sort', i === sortColIdx ? (sortAsc ? 'ascending' : 'descending') : 'none');
    });

    // Update only the leading text node inside .record-count (join chips follow it).
    var countEl = document.querySelector('.record-count');
    if (countEl) {
      var remaining = table.querySelectorAll('tbody tr').length;
      // Walk child nodes to find the first Text node (the "N records" part).
      var textNode = null;
      countEl.childNodes.forEach(function (n) { if (!textNode && n.nodeType === Node.TEXT_NODE) textNode = n; });
      if (textNode) textNode.textContent = remaining + ' record' + (remaining !== 1 ? 's' : '');
    }

    if (chkTotals && chkTotals.checked) buildTotals();
    saveState();
    updateDeleteBtn();
  }

  // --- Column helpers ---

  function colIndex(th) { return headers.indexOf(th); }

  function moveCol(from, to) {
    // `from` and `to` are indices into headers[] (data columns only).
    // Each data column lives at DOM cell index + SEL to account for the
    // selector checkbox column at position 0.
    Array.from(table.rows).forEach(function (row) {
      var cells  = Array.from(row.children);
      var moving = cells[from + SEL];
      var target = cells[to   + SEL];
      if (!moving || !target) return;
      row.insertBefore(moving, from < to ? target.nextSibling : target);
    });
    var moved = headers.splice(from, 1)[0];
    headers.splice(to, 0, moved);
    if      (sortColIdx === from)                                  sortColIdx = to;
    else if (from < to && sortColIdx > from && sortColIdx <= to)   sortColIdx--;
    else if (from > to && sortColIdx >= to  && sortColIdx <  from) sortColIdx++;
    // Remap selectedCols indices after the move
    var newSel = new Set();
    selectedCols.forEach(function (idx) {
      if      (idx === from)                              newSel.add(to);
      else if (from < to && idx > from && idx <= to)     newSel.add(idx - 1);
      else if (from > to && idx >= to  && idx <  from)   newSel.add(idx + 1);
      else                                                newSel.add(idx);
    });
    selectedCols = newSel;
  }

  // --- Sort ---

  // Returns a YYYYMMDD integer sort key for recognised date strings, else null.
  // Handles YYYY-MM-DD (ISO) and M/D/YYYY or D/M/YYYY slash formats.
  // monthFirst: true = M/D/YYYY, false = D/M/YYYY.
  function biDateKey(s, monthFirst) {
    var m;
    m = s.match(/^(\d{4})-(\d{2})-(\d{2})$/);
    if (m) return +m[1] * 10000 + +m[2] * 100 + +m[3];
    m = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
    if (m) {
      var p1 = +m[1], p2 = +m[2], yr = +m[3];
      return monthFirst ? yr * 10000 + p1 * 100 + p2
                        : yr * 10000 + p2 * 100 + p1;
    }
    return null;
  }

  function sortByCol(idx, asc) {
    var tbody    = table.tBodies[0];
    var rows     = Array.from(tbody.rows);
    var nonEmpty = rows.map(function (r) {
      return r.cells[idx + SEL] ? r.cells[idx + SEL].textContent.trim() : '';
    }).filter(function (v) { return v !== ''; });

    // Detect date columns: every non-empty value must match a known date pattern.
    var isDate = nonEmpty.length > 0 && nonEmpty.every(function (v) {
      return /^\d{4}-\d{2}-\d{2}$/.test(v) || /^\d{1,2}\/\d{1,2}\/\d{4}$/.test(v);
    });
    var monthFirst = true;
    if (isDate) {
      // Auto-detect M/D/YYYY vs D/M/YYYY: scan for a value that disambiguates.
      for (var di = 0; di < nonEmpty.length; di++) {
        var dm = nonEmpty[di].match(/^(\d{1,2})\/(\d{1,2})\/\d{4}$/);
        if (!dm) continue;
        if (+dm[1] > 12) { monthFirst = false; break; }
        if (+dm[2] > 12) { monthFirst = true;  break; }
      }
    }

    var numeric = !isDate && nonEmpty.length > 0 && nonEmpty.every(function (v) {
      return !isNaN(parseAccounting(v));
    });

    rows.sort(function (a, b) {
      var av  = a.cells[idx + SEL] ? a.cells[idx + SEL].textContent.trim() : '';
      var bv  = b.cells[idx + SEL] ? b.cells[idx + SEL].textContent.trim() : '';
      var cmp;
      if (isDate) {
        var ak = biDateKey(av, monthFirst), bk = biDateKey(bv, monthFirst);
        cmp = (ak === null ? -Infinity : ak) - (bk === null ? -Infinity : bk);
      } else if (numeric) {
        var an = parseAccounting(av), bn = parseAccounting(bv);
        cmp = (isNaN(an) ? -Infinity : an) - (isNaN(bn) ? -Infinity : bn);
      } else {
        cmp = av.localeCompare(bv, undefined, { numeric: true, sensitivity: 'base' });
      }
      return asc ? cmp : -cmp;
    });
    rows.forEach(function (r) { tbody.appendChild(r); });
    headers.forEach(function (h, i) {
      h.setAttribute('aria-sort', i === idx ? (asc ? 'ascending' : 'descending') : 'none');
    });
  }

  // --- Restore saved state on load ---

  (function restore() {
    var state = loadState();

    if (state.columns && state.columns.length) {
      var currentNames = headers.map(function (h) { return h.textContent.trim(); });
      var inSaved = {};
      state.columns.forEach(function (n) { inSaved[n] = true; });
      var reconciled = state.columns.filter(function (n) {
        return currentNames.indexOf(n) !== -1;
      });
      currentNames.forEach(function (n) {
        if (!inSaved[n]) reconciled.push(n);
      });

      for (var i = 0; i < reconciled.length; i++) {
        var name = reconciled[i];
        var cur  = -1;
        headers.forEach(function (h, j) { if (h.textContent.trim() === name) cur = j; });
        if (cur !== -1 && cur !== i) moveCol(cur, i);
      }
    }

    if (state.sortCol) {
      var idx = -1;
      headers.forEach(function (h, i) {
        if (h.textContent.trim() === state.sortCol) idx = i;
      });
      if (idx !== -1) {
        sortColIdx = idx;
        sortAsc    = state.sortAsc !== false;
        sortByCol(sortColIdx, sortAsc);
      }
    }

    if (state.totals && chkTotals) {
      chkTotals.checked = true;
      buildTotals();
    }
  }());

  if (chkTotals) {
    chkTotals.addEventListener('change', function () {
      if (chkTotals.checked) buildTotals(); else removeTotals();
      saveState();
    });
  }

  // --- Event listeners ---

  // Column header: plain click = sort; Ctrl+click = toggle column selection.
  headers.forEach(function (th) {
    th.addEventListener('click', function (e) {
      if (dragSrcIdx !== null) return;
      if (e.ctrlKey || e.metaKey) {
        // Ctrl/Cmd+click: select/deselect the column (does not sort).
        selectColumn(th);
        return;
      }
      sortColumn(th);
    });

    // The same control from the keyboard.  A columnheader is not a button, so
    // the browser does not activate it by itself: Enter and Space are handled
    // here, Shift+Left/Right is the keyboard equivalent of the drag that moves
    // the column, and the live region says which of them happened.
    th.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        if (e.ctrlKey || e.metaKey) { selectColumn(th); } else { sortColumn(th); }
        return;
      }

      var delta = 0;
      if (e.shiftKey && e.key === 'ArrowLeft')  delta = -1;
      if (e.shiftKey && e.key === 'ArrowRight') delta =  1;
      if (!delta) return;

      e.preventDefault();
      var from = colIndex(th);
      var to   = from + delta;
      if (from < 0 || to < 0 || to >= headers.length) return;

      moveCol(from, to);
      saveState();
      announceTable('Moved ' + columnName(to) + ' to column ' + (to + 1)
        + ' of ' + headers.length);
    });

    th.addEventListener('dragstart', function (e) {
      dragSrcIdx = colIndex(th);
      e.dataTransfer.effectAllowed = 'move';
      setTimeout(function () { th.classList.add('dragging'); }, 0);
    });

    th.addEventListener('dragend', function () {
      th.classList.remove('dragging');
      headers.forEach(function (h) { h.classList.remove('drag-over'); });
      dragSrcIdx = null;
    });

    th.addEventListener('dragover', function (e) {
      e.preventDefault();
      e.dataTransfer.dropEffect = 'move';
      headers.forEach(function (h) { h.classList.remove('drag-over'); });
      if (colIndex(th) !== dragSrcIdx) th.classList.add('drag-over');
    });

    th.addEventListener('dragleave', function () {
      th.classList.remove('drag-over');
    });

    th.addEventListener('drop', function (e) {
      e.preventDefault();
      var toIdx = colIndex(th);
      if (dragSrcIdx !== null && dragSrcIdx !== toIdx) {
        moveCol(dragSrcIdx, toIdx);
        saveState();
      }
      headers.forEach(function (h) { h.classList.remove('drag-over'); });
    });
  });

  // Row checkboxes: toggle row selection.
  table.addEventListener('change', function (e) {
    var chk = e.target;
    if (!chk.classList.contains('row-chk')) return;
    var tr = chk.closest('tr');
    if (tr) toggleRowSel(tr, chk.checked);
  });

  // Delete button: remove selected rows and columns.
  if (btnDel) {
    btnDel.addEventListener('click', function () {
      if (selectedRows.size + selectedCols.size === 0) return;
      deleteSelected();
    });
  }

  // Delete key removes selected rows/columns without needing the button.
  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Delete') return;
    if (selectedRows.size + selectedCols.size === 0) return;
    // Suppress if focus is inside a text-editable element (but not a checkbox).
    var el  = document.activeElement;
    var tag = el && el.tagName;
    if (tag === 'TEXTAREA' || tag === 'SELECT') return;
    if (tag === 'INPUT' && el.type !== 'checkbox' && el.type !== 'radio') return;
    e.preventDefault();
    deleteSelected();
  });

  // Add a title hint to data column headers: what a pointer does, and what the
  // same control does from the keyboard.
  headers.forEach(function (th) {
    th.title = (th.title ? th.title + '\n' : '') +
               'Click to sort | Ctrl+click to select column | Shift+Left/Right to move column';
  });
}());

// ---------------------------------------------------------------------------
// Join / filter panel
// ---------------------------------------------------------------------------
(function () {
  var btnAdd      = document.getElementById('btn-add-db');
  var panel       = document.getElementById('join-panel');
  if (!btnAdd || !panel) return;

  var btnCancel    = document.getElementById('btn-cancel-join');
  var btnDo        = document.getElementById('btn-do-join');
  var rightTblSel  = document.getElementById('right-table-sel');
  var rightPathInp = document.getElementById('right-path-inp');
  var leftKeySel   = document.getElementById('left-key-sel');
  var rightKeySel  = document.getElementById('right-key-sel');
  var joinDesc     = document.getElementById('join-desc');
  var filterRows   = document.getElementById('filter-rows');
  var joinForm     = document.getElementById('join-form');
  var currentLabel = panel.dataset.currentLabel || 'current table';

  // Column tracking -- kept in sync as right-table columns load.
  var allColumns = Array.from(leftKeySel.options)
      .slice(1).map(function (o) { return o.value; });

  var rightSpec  = '';
  var rightLabel = '';
  var joinSpec   = '';

  // Operator definitions.
  var OPS = [
    ['eq',       'equals'],
    ['ne',       'not equals'],
    ['contains', 'contains'],
    ['starts',   'starts with'],
    ['lt',       '<'],
    ['le',       '<='],
    ['gt',       '>'],
    ['ge',       '>='],
    ['empty',    'is empty'],
    ['notempty', 'is not empty'],
  ];

  // --- Filter row management ---

  function populateColSelect(sel, current) {
    var prev = current !== undefined ? current : sel.value;
    sel.innerHTML = '<option value="">&mdash; column &mdash;</option>';
    allColumns.forEach(function (col) {
      var opt = document.createElement('option');
      opt.value = col; opt.textContent = col;
      sel.appendChild(opt);
    });
    sel.value = prev;
  }

  function updateFilterCols(additionalCols) {
    (additionalCols || []).forEach(function (col) {
      if (allColumns.indexOf(col) === -1) allColumns.push(col);
    });
    document.querySelectorAll('#filter-rows .filter-col-sel').forEach(function (sel) {
      populateColSelect(sel);
    });
  }

  function addFilterRow(prefill) {
    prefill = prefill || {};
    var row    = document.createElement('div');
    row.className = 'filter-row';

    var colSel = document.createElement('select');
    colSel.className = 'filter-col-sel';
    populateColSelect(colSel, prefill.col || '');
    colSel.addEventListener('change', checkApply);

    var opSel = document.createElement('select');
    opSel.className = 'filter-op-sel';
    OPS.forEach(function (pair) {
      var opt = document.createElement('option');
      opt.value = pair[0]; opt.textContent = pair[1];
      opSel.appendChild(opt);
    });
    opSel.value = prefill.op || 'eq';

    var valInp = document.createElement('input');
    valInp.type = 'text';
    valInp.className = 'filter-val-inp';
    valInp.placeholder = 'value';
    valInp.value = prefill.val !== undefined ? prefill.val : '';

    function toggleValInp() {
      var hide = opSel.value === 'empty' || opSel.value === 'notempty';
      valInp.style.display = hide ? 'none' : '';
      checkApply();
    }
    opSel.addEventListener('change', toggleValInp);
    toggleValInp();

    var rmBtn = document.createElement('button');
    rmBtn.type = 'button';
    rmBtn.className = 'btn-remove-filter';
    rmBtn.textContent = 'x';
    rmBtn.addEventListener('click', function () { row.remove(); checkApply(); });

    row.appendChild(colSel);
    row.appendChild(opSel);
    row.appendChild(valInp);
    row.appendChild(rmBtn);
    filterRows.appendChild(row);
    checkApply();
  }

  document.getElementById('btn-add-filter').addEventListener('click', function () {
    addFilterRow();
  });

  // --- Join config ---

  function loadRightColumns(spec, label) {
    var url;
    if (spec.indexOf('table:') === 0) {
      url = '/api/columns?table=' + encodeURIComponent(spec.slice(6));
    } else if (spec.indexOf('path:') === 0) {
      url = '/api/columns?path=' + encodeURIComponent(spec.slice(5));
    } else if (spec.indexOf('redis:') === 0) {
      url = '/api/columns?spec=' + encodeURIComponent(spec);
    } else { return; }

    rightSpec  = spec;
    rightLabel = label;
    rightKeySel.disabled  = true;
    rightKeySel.innerHTML = '<option value="">Loading...</option>';

    fetch(url)
      .then(function (r) { return r.json(); })
      .then(function (data) {
        var cols = data.columns || [];
        rightKeySel.innerHTML = '<option value="">&mdash; select a column &mdash;</option>';
        cols.forEach(function (col) {
          var opt = document.createElement('option');
          opt.value = col; opt.textContent = col;
          rightKeySel.appendChild(opt);
        });
        rightKeySel.disabled = cols.length === 0;
        updateFilterCols(cols);
        updateJoinDesc();
      })
      .catch(function () {
        rightKeySel.innerHTML = '<option value="">Could not load columns</option>';
      });
  }

  rightTblSel.addEventListener('change', function () {
    if (!this.value) return;
    rightPathInp.value = '';
    loadRightColumns(this.value, this.options[this.selectedIndex].textContent.trim());
  });

  var pathTimer;
  rightPathInp.addEventListener('input', function () {
    var val = this.value.trim();
    rightTblSel.value = '';
    clearTimeout(pathTimer);
    if (!val) { rightSpec = ''; rightLabel = ''; updateJoinDesc(); return; }
    pathTimer = setTimeout(function () {
      var isRedis = val.indexOf('redis:') === 0;
      var spec  = isRedis ? val : 'path:' + val;
      var fname = isRedis
        ? val.replace(/\|.*/, '').replace(/^redis:/, '')
        : (val.replace(/.*[/\\]/, '').replace(/\.[^.]+$/, '') || val);
      loadRightColumns(spec, fname);
    }, 500);
  });

  function updateJoinDesc() {
    var lk = leftKeySel.value;
    var rk = rightKeySel.value;
    if (rightSpec && lk && rk) {
      joinDesc.textContent =
        'Add columns from "' + rightLabel + '" to "' + currentLabel +
        '" by matching ' + currentLabel + '.' + lk + ' with ' + rightLabel + '.' + rk +
        '. Every row in "' + currentLabel + '" is kept; rows with no match in "' +
        rightLabel + '" will have empty values for the new columns.';
      joinDesc.hidden = false;
      joinSpec = rightSpec + '|' + lk + '|' + rk;
    } else {
      joinDesc.hidden = true;
      joinSpec = '';
    }
    checkApply();
  }

  leftKeySel.addEventListener('change',  updateJoinDesc);
  rightKeySel.addEventListener('change', updateJoinDesc);

  // --- Apply button gate ---

  function checkApply() {
    var hasJoin   = !!joinSpec;
    var hasFilter = Array.from(
      document.querySelectorAll('#filter-rows .filter-col-sel')
    ).some(function (sel) { return sel.value; });
    btnDo.disabled = !(hasJoin || hasFilter);
  }

  // --- Form submission ---

  joinForm.addEventListener('submit', function (e) {
    // Remove previously-generated dynamic inputs.
    Array.from(joinForm.querySelectorAll('[data-dyn]')).forEach(function (i) { i.remove(); });
    // Remove the preserved f inputs -- we'll re-add from filter rows below.
    Array.from(joinForm.querySelectorAll('.f-preserved')).forEach(function (i) { i.remove(); });

    // Add new join spec if valid.
    if (joinSpec) {
      var jInp = document.createElement('input');
      jInp.type = 'hidden'; jInp.name = 'j';
      jInp.setAttribute('data-dyn', '1');
      jInp.value = joinSpec;
      joinForm.appendChild(jInp);
    }

    // Collect filter rows and add f inputs.
    var hasFilter = false;
    document.querySelectorAll('#filter-rows .filter-row').forEach(function (row) {
      var col = row.querySelector('.filter-col-sel').value;
      var op  = row.querySelector('.filter-op-sel').value;
      var valEl = row.querySelector('.filter-val-inp');
      var val = (valEl && valEl.style.display !== 'none') ? valEl.value : '';
      if (!col || !op) return;
      var fInp = document.createElement('input');
      fInp.type = 'hidden'; fInp.name = 'f';
      fInp.setAttribute('data-dyn', '1');
      fInp.value = col + ':' + op + ':' + val;
      joinForm.appendChild(fInp);
      hasFilter = true;
    });

    if (!joinSpec && !hasFilter) {
      e.preventDefault();
    }
  });

  // --- Open/close ---

  btnAdd.addEventListener('click', function () {
    // Close combine panel if open.
    var combinePanel = document.getElementById('combine-panel');
    var btnCombine   = document.getElementById('btn-combine');
    if (combinePanel && !combinePanel.hidden) {
      combinePanel.hidden      = true;
      if (btnCombine) btnCombine.disabled = false;
    }
    panel.hidden    = false;
    btnAdd.disabled = true;
    // Pre-populate filter rows from server-rendered filter state.
    if (filterRows.childElementCount === 0) {
      try {
        var saved = window.__biFilters || [];
        saved.forEach(function (f) { addFilterRow(f); });
      } catch (ex) {}
    }
  });

  btnCancel.addEventListener('click', function () {
    panel.hidden    = true;
    btnAdd.disabled = false;
    resetPanel();
  });

  function resetPanel() {
    rightTblSel.value     = '';
    rightPathInp.value    = '';
    rightKeySel.innerHTML = '<option value="">&mdash; select a database first &mdash;</option>';
    rightKeySel.disabled  = true;
    leftKeySel.value      = '';
    joinDesc.hidden       = true;
    joinSpec = ''; rightSpec = ''; rightLabel = '';
    filterRows.innerHTML  = '';
    checkApply();
  }

  // --- Clear filters link ---

  var btnClear = document.getElementById('btn-clear-filters');
  if (btnClear) {
    btnClear.addEventListener('click', function (e) {
      e.preventDefault();
      var u = new URL(location.href);
      u.searchParams.delete('f');
      location.href = u.toString();
    });
  }
}());
</script>

<script>
// ---------------------------------------------------------------------------
// Refresh button -- reload the page so the server re-reads the source file(s)
// ---------------------------------------------------------------------------
(function () {
  var btn = document.getElementById('btn-refresh');
  if (!btn) return;
  btn.addEventListener('click', function () { location.reload(); });
}());

// Copy-link button -- copies the current URL (including all ?f= params) to the clipboard
// ---------------------------------------------------------------------------
(function () {
  var btn = document.getElementById('btn-copy-link');
  if (!btn) return;
  btn.addEventListener('click', function () {
    var url = location.href;
    // navigator.clipboard is available only in secure contexts (HTTPS or localhost).
    // Fall back to the legacy execCommand path for plain HTTP deployments.
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(url).then(function () { showCopied(); }, function () { fallbackCopy(url); });
    } else {
      fallbackCopy(url);
    }
    function fallbackCopy(text) {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.style.cssText = 'position:fixed;top:-9999px;left:-9999px;opacity:0';
      document.body.appendChild(ta);
      ta.focus();
      ta.select();
      try { document.execCommand('copy'); } catch (e) { /* ignore */ }
      document.body.removeChild(ta);
      showCopied();
    }
    function showCopied() {
      var orig = btn.innerHTML;
      btn.innerHTML = '&#x2714; Copied!';
      btn.classList.add('btn-copy-link--copied');
      setTimeout(function () {
        btn.innerHTML = orig;
        btn.classList.remove('btn-copy-link--copied');
      }, 2000);
    }
  });
}());

// Filter bar - per-chip remove and apply-new-filter
// ---------------------------------------------------------------------------
(function () {
  // Remove one active filter chip.
  document.querySelectorAll('.chip-remove').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var chip = btn.closest('[data-spec]');
      var spec = chip ? chip.getAttribute('data-spec') : '';
      if (!spec) return;
      var u = new URL(location.href);
      var kept = u.searchParams.getAll('f').filter(function (v) { return v !== spec; });
      u.searchParams.delete('f');
      kept.forEach(function (v) { u.searchParams.append('f', v); });
      location.href = u.toString();
    });
  });

  // Apply a new filter condition from the quick-filter bar.
  var applyBtn = document.getElementById('dash-f-apply');
  if (applyBtn) {
    applyBtn.addEventListener('click', function () {
      var col = document.getElementById('dash-f-col').value;
      var op  = document.getElementById('dash-f-op').value;
      var val = document.getElementById('dash-f-val').value;
      if (!col || !op) return;
      var u = new URL(location.href);
      u.searchParams.append('f', col + ':' + op + ':' + val);
      location.href = u.toString();
    });
    document.getElementById('dash-f-val').addEventListener('keydown', function (e) {
      if (e.key === 'Enter') applyBtn.click();
    });
  }
}());

// Dedup button -- toggle d=1 in the URL and reload
// ---------------------------------------------------------------------------
(function () {
  var btn = document.getElementById('btn-dedup');
  if (!btn) return;
  btn.addEventListener('click', function () {
    var u = new URL(location.href);
    if (u.searchParams.get('d')) { u.searchParams.delete('d'); }
    else                         { u.searchParams.set('d', '1'); }
    location.href = u.toString();
  });
}());
</script>

<script>
// ---------------------------------------------------------------------------
// Combine panel -- stack rows from another file beneath the current view
// ---------------------------------------------------------------------------
(function () {
  var btnCombine  = document.getElementById('btn-combine');
  var panel       = document.getElementById('combine-panel');
  if (!btnCombine || !panel) return;

  var btnCancel   = document.getElementById('btn-cancel-combine');
  var btnDo       = document.getElementById('btn-do-combine');
  var tblSel      = document.getElementById('combine-table-sel');
  var pathInp     = document.getElementById('combine-path-inp');
  var combineForm = document.getElementById('combine-form');
  var joinPanel   = document.getElementById('join-panel');
  var btnMerge    = document.getElementById('btn-add-db');

  var combineSpec = '';
  var pathTimer;

  function checkApply() {
    btnDo.disabled = !combineSpec;
  }

  // Set the path input and combineSpec from an uploaded file path.
  function applyPath(path) {
    tblSel.value  = '';
    pathInp.value = path;
    combineSpec   = 'path:' + path;
    checkApply();
  }

  // Register global drop hooks so the existing overlay uploads to /upload and
  // then populates the path input instead of navigating away.
  function registerDropHooks() {
    window.__biDropLabel    = function () { return 'Drop to add to Combine'; };
    window.__biDropCallback = function (data) {
      if (!data || !data.url) return;
      var path = '';
      try { path = new URL(data.url, location.origin).searchParams.get('path') || ''; }
      catch (e) {}
      if (path) { applyPath(path); btnDo.click(); }
    };
  }

  function clearDropHooks() {
    window.__biDropLabel    = null;
    window.__biDropCallback = null;
  }

  tblSel.addEventListener('change', function () {
    combineSpec   = this.value ? this.value : '';
    pathInp.value = '';
    checkApply();
  });

  pathInp.addEventListener('input', function () {
    var val = this.value.trim();
    tblSel.value = '';
    clearTimeout(pathTimer);
    if (!val) { combineSpec = ''; checkApply(); return; }
    pathTimer = setTimeout(function () {
      combineSpec = 'path:' + val;
      checkApply();
    }, 300);
  });

  combineForm.addEventListener('submit', function (e) {
    Array.from(combineForm.querySelectorAll('[data-dyn]')).forEach(function (i) { i.remove(); });
    if (!combineSpec) { e.preventDefault(); return; }
    var cInp = document.createElement('input');
    cInp.type = 'hidden'; cInp.name = 'c';
    cInp.setAttribute('data-dyn', '1');
    cInp.value = combineSpec;
    combineForm.appendChild(cInp);
  });

  btnCombine.addEventListener('click', function () {
    // Close merge panel if open.
    if (joinPanel && !joinPanel.hidden) {
      joinPanel.hidden    = true;
      if (btnMerge) btnMerge.disabled = false;
    }
    panel.hidden        = false;
    btnCombine.disabled = true;
    registerDropHooks();
  });

  btnCancel.addEventListener('click', function () {
    panel.hidden        = true;
    btnCombine.disabled = false;
    tblSel.value        = '';
    pathInp.value       = '';
    combineSpec         = '';
    checkApply();
    clearDropHooks();
  });
}());
</script>

<script>
// ---------------------------------------------------------------------------
// Graph panel -- line chart of X vs Y using HTML::D3 / D3.js
// ---------------------------------------------------------------------------
(function () {
  var btnOpen   = document.getElementById('btn-graph');
  var panel     = document.getElementById('graph-panel');
  if (!btnOpen || !panel) return;

  var btnCancel = document.getElementById('btn-cancel-graph');
  var btnDo     = document.getElementById('btn-do-graph');
  var xSel      = document.getElementById('graph-x-sel');
  var ySel      = document.getElementById('graph-y-sel');
  var backInp       = document.getElementById('graph-back-inp');
  var back2Inp      = document.getElementById('graph-back2-inp');
  var back2LabelInp = document.getElementById('graph-back2-label-inp');
  var graphForm     = document.getElementById('graph-form');

  var otherPanels = ['join-panel', 'combine-panel', 'export-panel', 'pie-panel', 'heatmap-panel', 'bar-panel', 'stacked-panel', 'scatter-panel', 'combo-panel', 'treemap-panel', 'histogram-panel', 'folder-panel', 'pivot-panel', 'calc-panel', 'groups-panel', 'dates-panel', 'save-analysis-panel', 'map-panel'].map(function (id) {
    return document.getElementById(id);
  }).filter(Boolean);

  function checkPlot() {
    btnDo.disabled = !(xSel.value && ySel.value);
  }

  // Returns true if v looks like a date (excluded from numeric Y axis).
  function isDateVal(v) {
    return /^\d{4}-\d{2}-\d{2}$/.test(v) || /^\d{1,2}\/\d{1,2}\/\d{4}$/.test(v);
  }

  // Returns true if v is plottable as a number (mirrors the server's strip logic).
  // Recognises accounting negatives: (1,234.56) counts as a valid number.
  function isNumericVal(v) {
    if (v === '') return true;
    return !isNaN(parseAccounting(v));
  }

  var yTextInput = document.getElementById('graph-y-text');
  var yLabel     = document.getElementById('graph-y-label');

  // Rebuild the Y-axis select to show only columns whose non-empty values are
  // all numeric (after stripping currency symbols etc.) and not date-shaped.
  // Returns the number of numeric options added (excluding the placeholder).
  function buildYSelect() {
    var tbl = document.querySelector('table[data-table]') || document.querySelector('table');
    if (!tbl || !tbl.tHead || !tbl.tBodies[0]) return 0;
    var headers = Array.from(tbl.tHead.rows[0].cells);
    var rows    = Array.from(tbl.tBodies[0].rows);
    var prev    = ySel.value;
    while (ySel.options.length > 1) ySel.remove(1);
    headers.forEach(function (th, idx) {
      var name  = th.textContent.trim();
      var vals  = rows.map(function (r) {
        return r.cells[idx] ? r.cells[idx].textContent.trim() : '';
      }).filter(function (v) { return v !== ''; });
      if (vals.length === 0) return;
      if (vals.every(isDateVal)) return;
      if (!vals.every(isNumericVal)) return;
      var opt = document.createElement('option');
      opt.value = name; opt.textContent = name;
      if (name === prev) opt.selected = true;
      ySel.appendChild(opt);
    });
    return ySel.options.length - 1;  // subtract placeholder
  }

  // Apply the single-column shortcut: hide the dropdown and show a read-only
  // label when exactly one numeric column exists, so the user only picks X.
  function applyYAutoSelect(numericCount) {
    if (numericCount === 1) {
      ySel.options[1].selected = true;
      ySel.hidden              = true;
      if (yTextInput) { yTextInput.value = ySel.options[1].value; yTextInput.hidden = false; }
      if (yLabel)     { yLabel.textContent = 'Y axis (auto-selected)'; }
    } else {
      ySel.hidden = false;
      if (yTextInput) yTextInput.hidden = true;
      if (yLabel)     yLabel.textContent = 'Y axis (vertical, must be numeric)';
    }
  }

  // Check for numeric columns once on page load; grey out the button when
  // none exist so the user knows immediately without opening the panel.
  (function initGraphBtn() {
    var n = buildYSelect();
    applyYAutoSelect(n);
    if (n === 0) {
      btnOpen.disabled = true;
      btnOpen.title    = 'Line graphs need a numeric column';
    }
  }());

  btnOpen.addEventListener('click', function () {
    otherPanels.forEach(function (p) { p.hidden = true; });
    backInp.value = window.location.href;
    // Propagate this page's back-link as back2 so the chart page can build a
    // three-level breadcrumb (e.g. Home > Store schema > Table view > Graph).
    if (back2Inp && graphForm) {
      var pb = graphForm.getAttribute('data-parent-back') || '';
      back2Inp.value = pb;
      if (back2LabelInp) back2LabelInp.value = pb ? (graphForm.getAttribute('data-parent-back-label') || '') : '';
    }
    var n = buildYSelect();
    applyYAutoSelect(n);
    panel.hidden  = !panel.hidden;
    checkPlot();
  });

  btnCancel && btnCancel.addEventListener('click', function () {
    panel.hidden = true;
  });

  xSel.addEventListener('change', checkPlot);
  ySel.addEventListener('change', checkPlot);
}());
</script>

<script>
// ---------------------------------------------------------------------------
// Pie chart panel
// ---------------------------------------------------------------------------
(function () {
  var btnOpen   = document.getElementById('btn-pie');
  var panel     = document.getElementById('pie-panel');
  if (!btnOpen || !panel) return;

  var btnCancel = document.getElementById('btn-cancel-pie');
  var btnDo     = document.getElementById('btn-do-pie');
  var catSel    = document.getElementById('pie-cat-sel');
  var valSel    = document.getElementById('pie-val-sel');
  var backInp       = document.getElementById('pie-back-inp');
  var back2Inp      = document.getElementById('pie-back2-inp');
  var back2LabelInp = document.getElementById('pie-back2-label-inp');
  var pieForm       = document.getElementById('pie-form');

  var otherPanels = ['join-panel', 'combine-panel', 'export-panel', 'graph-panel', 'heatmap-panel', 'bar-panel', 'stacked-panel', 'scatter-panel', 'combo-panel', 'treemap-panel', 'histogram-panel', 'folder-panel', 'pivot-panel', 'calc-panel', 'groups-panel', 'dates-panel', 'save-analysis-panel', 'map-panel'].map(function (id) {
    return document.getElementById(id);
  }).filter(Boolean);

  function checkPie() {
    btnDo.disabled = !(catSel.value && valSel.value);
  }

  // Rebuild the value select: Count option first (always), then numeric columns.
  function buildPieValSelect() {
    var tbl = document.querySelector('table[data-table]') || document.querySelector('table');
    if (!tbl || !tbl.tHead || !tbl.tBodies[0]) return;
    var headers = Array.from(tbl.tHead.rows[0].cells);
    var rows    = Array.from(tbl.tBodies[0].rows);
    var prev    = valSel.value;
    while (valSel.options.length > 1) valSel.remove(1);
    // Count option always appears first, bold to distinguish it from column names.
    var countOpt = document.createElement('option');
    countOpt.value = '__count__';
    countOpt.textContent = 'Count (rows)';
    countOpt.style.fontWeight = 'bold';
    if (prev === '__count__') countOpt.selected = true;
    valSel.appendChild(countOpt);
    headers.forEach(function (th, idx) {
      var name  = th.textContent.trim();
      var vals  = rows.map(function (r) {
        return r.cells[idx] ? r.cells[idx].textContent.trim() : '';
      }).filter(function (v) { return v !== ''; });
      if (vals.length === 0) return;
      // Exclude date-shaped columns.
      if (vals.every(function (v) {
        return /^\d{4}-\d{2}-\d{2}$/.test(v) || /^\d{1,2}\/\d{1,2}\/\d{4}$/.test(v);
      })) return;
      // Only show columns whose non-empty values are all numeric.
      if (!vals.every(function (v) {
        if (v === '') return true;
        return !isNaN(parseAccounting(v));
      })) return;
      var opt = document.createElement('option');
      opt.value = name; opt.textContent = name;
      if (name === prev) opt.selected = true;
      valSel.appendChild(opt);
    });
  }

  btnOpen.addEventListener('click', function () {
    otherPanels.forEach(function (p) { p.hidden = true; });
    backInp.value = window.location.href;
    if (back2Inp && pieForm) {
      var pb = pieForm.getAttribute('data-parent-back') || '';
      back2Inp.value = pb;
      if (back2LabelInp) back2LabelInp.value = pb ? (pieForm.getAttribute('data-parent-back-label') || '') : '';
    }
    buildPieValSelect();
    panel.hidden = !panel.hidden;
    checkPie();
  });

  btnCancel && btnCancel.addEventListener('click', function () {
    panel.hidden = true;
  });

  catSel.addEventListener('change', checkPie);
  valSel.addEventListener('change', checkPie);
}());
</script>

