#!/usr/bin/env perl

use strict;
use warnings;

use FindBin ();
use Mojo::Home ();

use lib "$FindBin::Bin/../lib";		# GroupedSections
use lib "$FindBin::Bin/../../../lib";	# Mojolicious::Plugin::Buffer, when run from the distribution

require GroupedSections;

my $app = GroupedSections->new;
$app->home(Mojo::Home->new("$FindBin::Bin/.."));
$app->start;
