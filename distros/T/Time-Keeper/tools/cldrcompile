}
$p->('};');
$p->('#define TK_IANA_ZONES ', scalar keys %cldr_of);
$p->('');
my %zeros;
for my $s (values %$numsys) {
    next unless ($s->{_type} // '') eq 'numeric';
    my @d = split //, $s->{_digits};
