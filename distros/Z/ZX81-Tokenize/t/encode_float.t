use Modern::Perl;
use Test::More;
use Test::HexDifferences; 

BEGIN { use_ok 'ZX81::Tokenize', 'encode_float' }

eq_or_dump_diff(encode_float(0),       pack("C5", 0x00, 0x00, 0x00, 0x00, 0x00));
eq_or_dump_diff(encode_float(1),       pack("C5", 0x81, 0x00, 0x00, 0x00, 0x00));
eq_or_dump_diff(encode_float(-1),      pack("C5", 0x81, 0x80, 0x00, 0x00, 0x00));
eq_or_dump_diff(encode_float(2),       pack("C5", 0x82, 0x00, 0x00, 0x00, 0x00));
eq_or_dump_diff(encode_float(-2),      pack("C5", 0x82, 0x80, 0x00, 0x00, 0x00));
eq_or_dump_diff(encode_float(4),       pack("C5", 0x83, 0x00, 0x00, 0x00, 0x00));
eq_or_dump_diff(encode_float(-4),      pack("C5", 0x83, 0x80, 0x00, 0x00, 0x00));
eq_or_dump_diff(encode_float(1.5),     pack("C5", 0x81, 0x40, 0x00, 0x00, 0x00));
eq_or_dump_diff(encode_float(-1.5),    pack("C5", 0x81, 0xC0, 0x00, 0x00, 0x00));
eq_or_dump_diff(encode_float(1.25),    pack("C5", 0x81, 0x20, 0x00, 0x00, 0x00));
eq_or_dump_diff(encode_float(-1.25),   pack("C5", 0x81, 0xA0, 0x00, 0x00, 0x00));
eq_or_dump_diff(encode_float(1.75),    pack("C5", 0x81, 0x60, 0x00, 0x00, 0x00));
eq_or_dump_diff(encode_float(-1.75),   pack("C5", 0x81, 0xE0, 0x00, 0x00, 0x00));
eq_or_dump_diff(encode_float(3),       pack("C5", 0x82, 0x40, 0x00, 0x00, 0x00));
eq_or_dump_diff(encode_float(-3),      pack("C5", 0x82, 0xC0, 0x00, 0x00, 0x00));
eq_or_dump_diff(encode_float(6),       pack("C5", 0x83, 0x40, 0x00, 0x00, 0x00));
eq_or_dump_diff(encode_float(-6),      pack("C5", 0x83, 0xC0, 0x00, 0x00, 0x00));
eq_or_dump_diff(encode_float(2**-129), pack("C5", 0x00, 0x00, 0x00, 0x00, 0x00));
eq_or_dump_diff(encode_float(2**126),  pack("C5", 0xFF, 0x00, 0x00, 0x00, 0x00));
eq_or_dump_diff(encode_float(-2**126), pack("C5", 0xFF, 0x80, 0x00, 0x00, 0x00));

done_testing;
