# Perl 5.44 syntax:
#   use feature 'enhanced_xx' (codepoint class of /xx with comments and
#   vertical space), named parameters in signatures, multi-variable foreach
#   with reference aliases, and use VERSION

use strict;
use FindBin;
use lib "$FindBin::Bin/../lib";
use mb;
mb::set_script_encoding('sjis');
use vars qw(@test);

BEGIN {
    $SIG{__WARN__} = sub {
        local($_) = @_;
        m{\AHaving more than one /x regexp modifier is deprecated at } ? return :
        m{is more clearly written simply as} ? return :
        warn $_[0];
    };
}

# transpile and eval; "use feature 'enhanced_xx';" and
# "no feature 'enhanced_xx';" are replaced by "1;" in the transpiled script on
# perl older than 5.44, because mb removes comments and vertical space of
# the codepoint class by itself, and so the result does not depend on it
sub xeval {
    my($script) = @_;

    # a transpile error is reported as "not ok" of the test, and does not
    # stop the rest of the tests
    my $parsed = quiet_parse($script);
    if (not defined($parsed)) {
        my $error = $@;
        $error =~ s/\n.*//s;
        print "# mb::parse died: $error\n";
        return '';
    }
    if ($] < 5.044) {
        $parsed =~ s{(?:use|no) \s+ (?:feature|experimental) \s+ 'enhanced_xx' \s* ;}{1;}xmsg;
    }
    my $result = CORE::eval($parsed);
    return defined($result) ? $result : '';
}

# mb::parse() in CORE::eval {}; the comment warnings of enhanced_xx that
# mb gives at transpile time are expected here (some test scripts have a
# comment such as "# see ]" on purpose, and they are checked by
# parse_warnings()), so they are not printed even under -w; any other
# warning goes to the handler of BEGIN block above
sub quiet_parse {
    my($script) = @_;
    my $outer = $SIG{__WARN__};
    local $SIG{__WARN__} = sub {
        return if $_[0] =~ /\(found by mb at transpile time, /;
        if (ref($outer) eq 'CODE') {
            $outer->(@_);
        }
        else {
            warn $_[0];
        }
    };
    return CORE::eval { mb::parse($script) };
}

# returns 1 if the codepoint class generated by mb::_cc has no literal
# "#" or white space in it
sub cc_is_safe {
    my($classmate) = @_;
    my $cc = mb::_cc($classmate);
    while ($cc =~ /\G (?: \\. | \[ ((?:\\.|[^\]\\])*) \] | . ) /xmsgc) {
        if (defined($1)) {
            my $inner = $1;
            $inner =~ s/\\.//gs;
            if ($inner =~ /[#\t\n\x0B\f\r\x20]/) {
                return 0;
            }
        }
    }
    return 1;
}

