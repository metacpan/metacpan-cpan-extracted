#--------
# frame shape helpers
#--------
sub row_key { sprintf 'r%03d', $_[0] }
sub nrows_of { my ($f) = @_; my $n = 0; for my $c (@{ $f->{cols} }) { my $l = scalar @{ $f->{data}{$c} }; $n = $l if $l > $n } $n }
sub pos_of { my ($f, $name) = @_; for my $i (0 .. $#{ $f->{cols} }) { return $i if $f->{cols}[$i] eq $name } die "no column $name" }
# rows picks a subset of rows (a list of 0-based indices); undef means all.
sub build {
	my ($f, $shape, $rows) = @_;
	my $n = nrows_of($f);
	$rows = [ 0 .. $n - 1 ] unless defined $rows;
	my @c = @{ $f->{cols} };
	if ($shape eq 'HoA') {
		return { map { my $c = $_; ($c => [ map { $f->{data}{$c}[$_] } @$rows ]) } @c };
	}
	if ($shape eq 'AoH') {
		return [ map { my $i = $_; +{ map { ($_ => $f->{data}{$_}[$i]) } @c } } @$rows ];
	}
	if ($shape eq 'AoHmiss') { # an undef cell is a missing key
		return [ map { my $i = $_; +{ map { ($_ => $f->{data}{$_}[$i]) } grep { defined $f->{data}{$_}[$i] } @c } } @$rows ];
	}
	if ($shape eq 'AoA') {
		return [ map { my $i = $_; [ map { $f->{data}{$_}[$i] } @c ] } @$rows ];
	}
	if ($shape eq 'HoH') {
		return { map { my $i = $_; (row_key($i) => +{ map { ($_ => $f->{data}{$_}[$i]) } @c }) } @$rows };
	}
	die "shape $shape";
}
# to_hoa turns a result back into { col => [..] } in row order.
sub to_hoa {
	my ($r, $shape, $f) = @_;
	my @c = @{ $f->{cols} };
	if ($shape eq 'HoA') { return { map { ($_ => [ @{ $r->{$_} || [] } ]) } @c } }
	if ($shape eq 'AoH' || $shape eq 'AoHmiss') { return { map { my $c = $_; ($c => [ map { $_->{$c} } @$r ]) } @c } }
	if ($shape eq 'AoA') { return { map { my $j = pos_of($f, $_); ($_ => [ map { $_->[$j] } @$r ]) } @c } }
	if ($shape eq 'HoH') { my @k = sort keys %$r; return { map { my $c = $_; ($c => [ map { $r->{$_}{$c} } @k ]) } @c } }
	die "shape $shape";
}
# col maps a column name to what the shape calls it (a position for AoA).
sub col_for { my ($f, $shape, $c) = @_; $shape eq 'AoA' ? pos_of($f, $c) : $c }
sub slice_expected { my ($f, $idx) = @_; return { map { my $c = $_; ($c => [ map { $f->{data}{$c}[$_] } @$idx ]) } @{ $f->{cols} } } }
sub show { my ($d) = @_; join ' | ', map { "$_=" . join(',', map { defined $_ ? $_ : 'NA' } @{ $d->{$_} }) } sort keys %$d }
sub frame_from_cols { my ($names, $data) = @_; return { cols => $names, data => $data } }

#--------
# drop_duplicates: pandas test_drop_duplicates*.py, R duplicated.Rd
#--------
sub dd_check {
	my ($label, $f, $subset, $keep, $idx, $shape) = @_;
	my $in = build($f, $shape);
	my @args = ($in);
	if (defined $subset) {
		my @s = ref $subset ? @$subset : ($subset);
		@s = map { col_for($f, $shape, $_) } @s;
		push @args, subset => (ref $subset ? \@s : $s[0]);
	}
	push @args, keep => ($keep eq 'none' && $shape eq 'AoA' ? 0 : $keep);
	my $got = eval { drop_duplicates(@args) };
	if ($@) { fail("$label [$shape]: died: " . substr($@, 0, 120)); return }
	is_deeply(to_hoa($got, $shape, $f), slice_expected($f, $idx), "$label [$shape]")
		or diag('got ' . show(to_hoa($got, $shape, $f)));
}
