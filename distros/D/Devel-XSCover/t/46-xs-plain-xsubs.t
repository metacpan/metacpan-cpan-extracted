use 5.020;
use strict;
use warnings;
use Test::More;
use File::Spec ();
use File::Temp ();
use Devel::XSCover::XS ();

my $dir = File::Temp->newdir;

sub put {
    my ($name, $text) = @_;
    my $path = File::Spec->catfile($dir, $name);
    open my $fh, '>', $path or die "$path: $!";
    print $fh $text;
    close $fh;
}

