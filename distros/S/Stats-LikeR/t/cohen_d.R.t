	'a dangling option name is refused';
throws_ok { cohen_d([1, 1, 1], [2, 2, 2]) }
	qr/^cohen_d: pooled standard deviation is zero$/m, 'constant groups are refused';
throws_ok { cohen_d([1], [2, 3]) }
	qr/^cohen_d: each group needs at least two numeric observations$/m, 'a group of one is refused';

# Devel::Cover's own per-line counters are allocated inside whatever block is
# running and are reported as leaks, so the check is skipped under it.
no_leaks_ok {
	cohen_d(@{ $DATA{mtcars} }{qw(x y)});
	cohen_d(@{ $DATA{mtcars} }{qw(x y)}, ci_method => 'normal', conf_level => 0.9);
	eval { cohen_d([1, 1, 1], [2, 2, 2]) };
} 'cohen_d does not leak' unless $INC{'Devel/Cover.pm'};

