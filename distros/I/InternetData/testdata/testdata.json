          "expect": "https://internetdata.io/oauth/authorize?response_type=code&client_id=example-client&redirect_uri=http%3A%2F%2F127.0.0.1%3A8765%2Fcallback&code_challenge=E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM&code_challenge_method=S256"
        },
        {
          "name": "every-option-reserved-characters-trailing-slash",
          "why": "One trailing slash on the base URL is dropped. Only A-Z a-z 0-9 - . _ ~ stay literal: a space is %20 never +, a literal + is %2B, and encodeURIComponent alone leaves ! * ' ( ) unencoded, which this pins.",
          "baseUrl": "https://internetdata.io/",
          "clientId": "https://client.example/oauth/metadata.json",
          "redirectUri": "https://app.example/cb?next=/a b&x=1+2#frag",
          "codeChallenge": "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM",
          "scope": "account.read apikeys.read",
          "state": "s/t+a=t&e~!*'()é",
          "resource": "https://internetdata.io/",
          "expect": "https://internetdata.io/oauth/authorize?response_type=code&client_id=https%3A%2F%2Fclient.example%2Foauth%2Fmetadata.json&redirect_uri=https%3A%2F%2Fapp.example%2Fcb%3Fnext%3D%2Fa%20b%26x%3D1%2B2%23frag&code_challenge=E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM&code_challenge_method=S256&scope=account.read%20apikeys.read&state=s%2Ft%2Ba%3Dt%26e~%21%2A%27%28%29%C3%A9&resource=https%3A%2F%2Finternetdata.io%2F"
