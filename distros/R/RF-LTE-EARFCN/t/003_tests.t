use strict;
use warnings;

use Test::More tests => 302;
BEGIN { use_ok('RF::LTE::EARFCN') };

my $rf = RF::LTE::EARFCN->new;
isa_ok($rf, 'RF::LTE::EARFCN');

my @tests = map {[split]} <DATA>;

foreach my $test (@tests) {
  my $channel = $test->[0];
  my $freq    = $test->[1];
  $rf->channel($channel);
  if ($rf->channel_type eq 'dl') {
    is($freq, $rf->fdl, "Channel: $channel (downlink), Freq: $freq");
  } elsif ($rf->channel_type eq 'ul') {
    is($freq, $rf->ful, "Channel: $channel (uplink), Freq: $freq");
  } else {
    ok(0, $rf->channel_type);
  }
}

