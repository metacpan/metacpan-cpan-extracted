# log-gamma for the pbinom identity above.  Lanczos, good to ~1e-14 over the
# range this test uses (n <= 201), which is well inside the 1e-11 the identity
# is checked at.  Taken from the standard Lanczos g=7, n=9 coefficient set
# (Press et al., Numerical Recipes 3rd ed., section 6.1).
sub lgamma_ {
	my ($x) = @_;
	my @c = ( 0.99999999999980993, 676.5203681218851, -1259.1392167224028,
	          771.32342877765313, -176.61502916214059, 12.507343278686905,
	          -0.13857109526572012, 9.9843695780195716e-6,
	          1.5056327351493116e-7 );
	return log(3.14159265358979323846 / sin(3.14159265358979323846 * $x))
	     - lgamma_(1 - $x) if $x < 0.5;
	$x -= 1;
	my $a = $c[0];
	my $t = $x + 7.5;
	$a += $c[$_] / ( $x + $_ ) for 1 .. 8;
	return 0.5 * log(2 * 3.14159265358979323846)
	     + ( $x + 0.5 ) * log($t) - $t + log($a);
}

