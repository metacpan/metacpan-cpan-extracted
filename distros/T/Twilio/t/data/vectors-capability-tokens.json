    "policies": [
        {
            "description": "empty filters",
            "url": "https://a.test",
            "method": "GET",
            "query": {},
            "post": {},
            "allow": true,
            "expected": {
                "url": "https://a.test",
                "method": "GET",
                "allow": true,
                "query_filter": {},
                "post_filter": {}
            }
        },
        {
            "description": "no filters",
            "url": "https://a.test",
            "method": "GET",
            "query": null,
            "post": null,
            "allow": false,
            "expected": {
                "url": "https://a.test",
                "method": "GET",
                "allow": false
            }
        },
        {
            "description": "filters",
            "url": "https://a.test",
            "method": "POST",
            "query": {
                "a": {
                    "required": true
                }
            },
            "post": {
                "b": {
                    "required": false
                }
            },
            "allow": true,
            "expected": {
                "url": "https://a.test",
                "method": "POST",
                "allow": true,
                "query_filter": {
                    "a": {
                        "required": true
                    }
                },
                "post_filter": {
                    "b": {
                        "required": false
                    }
                }
            }
        },
        {
            "description": "a filter added to an empty one",
            "url": "https://a.test",
            "method": "GET",
            "query": {},
            "post": {},
            "allow": true,
            "add_query": {
                "x": 1
            },
            "add_post": {
                "y": 2
            },
            "expected": {
                "url": "https://a.test",
                "method": "GET",
                "allow": true,
                "query_filter": [
                    {
                        "x": 1
                    }
                ],
                "post_filter": [
                    {
                        "y": 2
                    }
                ]
            }
        },
        {
            "description": "a filter added to a named one",
            "url": "https://a.test",
            "method": "GET",
            "query": {
                "a": 1
            },
            "post": {
                "a": 1
            },
            "allow": true,
            "add_query": {
                "x": 1
            },
            "expected": {
                "url": "https://a.test",
                "method": "GET",
                "allow": true,
                "query_filter": {
                    "a": 1,
                    "0": {
                        "x": 1
                    }
                },
                "post_filter": {
                    "a": 1
                }
            }
        }
    ]
}
