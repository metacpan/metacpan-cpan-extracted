#!/usr/bin/env perl
# Cross-validation of dunn_test()'s p-value adjustments against statsmodels.
#
# t/dunn_test.t pins the Z statistics and the holm, bh and bonferroni columns to
# six decimals of base R.  Nothing ran the sidak, hs (Holm-Sidak) or by methods
# at all, and up to 0.3415 sidak and hs computed 1 - (1 - p)^m literally, which
# is exactly 0 once p is below about 1e-16: the 'four disjoint groups of 200'
# case below came back as 0 for every pair under both methods, where Bonferroni
# gives 2.96e-17.  This file covers all seven methods, with raw p-values from
# 0.83 down to 1.2e-148.
#
# PROVENANCE
# ----------
# The expected values in cases() were generated by t/dunn_test.statsmodels.py
# under Python 3.14.2, SciPy 1.18.0 and statsmodels 0.14.6, and are frozen
# here; the test never runs Python.  Re-run that script and paste its output
# over the body of cases() to regenerate them.
#
#   Z, p_value   Dunn's (1964) z with the Kruskal-Wallis tie correction, the
#                formula of R's dunn.test package (and of t/dunn_test.t's
#                base-R values), from scipy.stats.rankdata() midranks; the
#                two-sided p is 2 * scipy.stats.norm.sf(|z|).
#   bonferroni, sidak, holm, hs, bh, by
#                statsmodels.stats.multitest.multipletests() on those raw
#                p-values, with methods 'bonferroni', 'sidak', 'holm',
#                'holm-sidak', 'fdr_bh' and 'fdr_by'.  Its Sidak forms are
#                -expm1(m * log1p(-p)), which stay exact in the far tail.
#
# The first case is t/dunn_test.t's data, so the two files share an anchor.
#
# TOLERANCE
# ---------
# Relative 1e-12 on every quantity.  The worst observed disagreement on
# perl-5.44.0 (double) is 1.1e-14, in both the raw p and the adjusted p, which
# is the normal tail's own rounding carried through; Z agrees exactly.  A long
# double or quadmath build is closer to the exact value than the double
# reference, so the disagreement there is bounded by the reference's error
# rather than the build's, and 1e-12 leaves about 90x headroom over it.
require 5.010;
use strict;
use warnings FATAL => 'all';
use Stats::LikeR;
use Test::More;

my $TOL = 1e-12;	# relative; see TOLERANCE above

sub rel_ok {
	my ($got, $want, $name) = @_;
	if (!defined $got) { fail("$name (got undef)"); return }
	my $err = $want == 0 ? abs($got) : abs($got - $want) / abs($want);
	ok($err <= $TOL, $name)
		or diag(sprintf("     got: %.17g\nexpected: %.17g\n rel err: %.3g", $got, $want, $err));
}

for my $c (cases()) {
	for my $m (qw(none bonferroni sidak holm hs bh by)) {
		my $r = dunn_test($c->{values}, $c->{groups}, method => $m);
		is(scalar @$r, scalar keys %{ $c->{pairs} }, "$c->{name}, $m: one row per pair");
		for my $row (@$r) {
			my $want = $c->{pairs}{ $row->{comparison} };
			if (!$want) { fail("$c->{name}, $m: unexpected comparison '$row->{comparison}'"); next }
			my $tag = "$c->{name}, $m, $row->{comparison}";
			if ($m eq 'none') {
				rel_ok($row->{Z},        $want->{Z},       "$tag: Z");
				rel_ok($row->{p_value},  $want->{p_value}, "$tag: raw p");
				rel_ok($row->{p_adjust}, $want->{p_value}, "$tag: p_adjust is the raw p");
			} else {
				rel_ok($row->{p_adjust}, $want->{$m}, "$tag: p_adjust");
			}
		}
	}
}

done_testing();

