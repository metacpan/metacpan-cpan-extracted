my @TINY = (
	[ 'tiny_plain_10', '4634991266889728:-55 4634991266889735:-55 4634991266889728:-55 4634991266889735:-55 4634991266889743:-55 4634991266889794:-55' ],
);
for my $c (@EXACT, @TINY) {
	my ($label, $want) = @$c;
	my ($pat, $n) = $label =~ /^(?:tiny_)?([a-z]+)_(\d+)$/;
	my @want  = map { dy($_) } split / /, $want;
	my @probs = $label =~ /^tiny_/ ? @TINY_P : map { $_ / 997 } 0 .. 997;
	my $x = $PATTERN{$pat}->($n);
	my @s = sort { $a <=> $b } @$x;
	my $range = $s[-1] - $s[0];
	my ($bad, $first) = (0, -1);
	for my $i (0 .. $#probs) {
		my $got = (values %{ quantile(x => $x, probs => [ $probs[$i] ]) })[0];
		next if same($got, $want[$i], $n, $range);
		$bad++;
		$first = $i if $first < 0;
	}
	is($bad, 0, sprintf('G %s: %d quantiles are R\'s %s', $label, scalar @probs,
		$NV_IS_DOUBLE ? 'to the bit' : 'to the index rounding')
		. ($bad ? " -- first wrong at $first" : ''));
}

