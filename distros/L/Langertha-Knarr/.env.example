# Knarr — API Keys
# Copy this to .env and fill in your keys:
#   cp .env.example .env
#
# Knarr auto-detects which providers are available.
# Only set the ones you want to use.
# Each provider also has a LANGERTHA_<NAME>_API_KEY variant
# (LANGERTHA_OPENAI_API_KEY), which wins over the bare name.

# LLM Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
#GROQ_API_KEY=
#MISTRAL_API_KEY=
#DEEPSEEK_API_KEY=
#MINIMAX_API_KEY=
#CEREBRAS_API_KEY=
#OPENROUTER_API_KEY=
#PERPLEXITY_API_KEY=
#GEMINI_API_KEY=
#XAI_API_KEY=
#MOONSHOT_API_KEY=
#NOUSRESEARCH_API_KEY=
#AKI_API_KEY=
#SCALEWAY_API_KEY=
#TSYSTEMS_API_KEY=
# Hetzner only with the prefix (bare HETZNER_API_KEY is the Cloud API key)
#LANGERTHA_HETZNER_API_KEY=
# Replicate and HuggingFace have no default model: configure one in a
# config file (knarr init writes an entry without model:)
#REPLICATE_API_TOKEN=
#HUGGINGFACE_API_KEY=

# Langfuse Tracing (optional — enables automatic observability)
# Against Langfuse Cloud or your own server: the project's keys.
# With docker compose: choose any pair yourself (pk-lf-/sk-lf- prefix is the
# Langfuse convention, e.g. pk-lf-$(openssl rand -hex 16)); the bundled
# Langfuse registers exactly these keys for its project at startup.
#LANGFUSE_PUBLIC_KEY=pk-lf-...
#LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_URL is set to http://langfuse:3000 in docker-compose.yml
#LANGFUSE_URL=https://cloud.langfuse.com
#KNARR_TRACE_NAME=knarr-proxy
# ingestion (default) or otel — OTLP/HTTP spans to Langfuse's OpenTelemetry
# endpoint; needs Langfuse Cloud or self-hosted v3.22+ (the compose file runs v2)
#KNARR_LANGFUSE_TRANSPORT=ingestion
# Seconds a trace post may take before it is logged as failed (0: no limit)
#KNARR_LANGFUSE_TIMEOUT=15

# Bundled Langfuse (docker compose only)
# The knarr service never receives these: docker-compose.yml passes it only
# the variables Knarr reads.
# Required by docker-compose.yml, no defaults — generate each with
#   openssl rand -base64 32
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
# Postgres password, also required. It goes into a URL, so use hex:
#   openssl rand -hex 16
# An existing pgdata volume keeps its old password: set "langfuse" here
# (the earlier fixed value) or start over with docker compose down -v.
LANGFUSE_DB_PASSWORD=
# Published ports (docker compose only). Knarr's 8080/11434 listen on all
# interfaces unless KNARR_BIND names one; Langfuse's 3000 on 127.0.0.1
# unless LANGFUSE_BIND says otherwise.
#KNARR_BIND=127.0.0.1
#LANGFUSE_BIND=0.0.0.0
# Login for http://localhost:3000; without a password no user is created
# (you can still sign up in the UI). Defaults shown.
#LANGFUSE_INIT_USER_EMAIL=admin@knarr.local
#LANGFUSE_INIT_USER_NAME=Knarr Admin
#LANGFUSE_INIT_USER_PASSWORD=
# Org and project created at startup (defaults shown)
#LANGFUSE_INIT_ORG_ID=knarr
#LANGFUSE_INIT_ORG_NAME=Knarr
#LANGFUSE_INIT_PROJECT_ID=knarr
#LANGFUSE_INIT_PROJECT_NAME=Knarr

# Proxy Authentication (optional — protects your proxy)
#KNARR_API_KEY=

# Request logging (optional)
#KNARR_LOG_FILE=/tmp/knarr-requests.jsonl
#KNARR_LOG_DIR=/tmp/knarr-requests

# Public base URL for /.well-known/langertha.json (optional)
#KNARR_PUBLIC_URL=https://knarr.example

# Upstream timeouts in seconds, 0 disables (defaults shown)
#KNARR_UPSTREAM_TIMEOUT=300
#KNARR_UPSTREAM_STALL_TIMEOUT=120

# Startup capability probe of gateway / self-hosted engines (defaults shown)
#KNARR_PROBE_CAPABILITIES=1
#KNARR_PROBE_TIMEOUT=10

# Worker processes on the same listen sockets; knarr start -w wins (default shown)
#KNARR_WORKERS=1

# A2A agent card at /.well-known/agent.json (defaults shown)
#KNARR_A2A_NAME="Langertha Knarr Agent"
#KNARR_A2A_DESCRIPTION="LLM agent served through Langertha Knarr"

# Ollama version reported at GET /api/version (x.y.z only)
#KNARR_OLLAMA_COMPAT_VERSION=0.34.4

# Verbose logging to stderr
#KNARR_DEBUG=1
