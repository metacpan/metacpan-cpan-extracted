{
  "name": "webdyne-durable-objects-example",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "webdyne-cloudflare build",
    "check": "webdyne-cloudflare check",
    "dev": "webdyne-cloudflare dev"
  },
  "dependencies": {
    "@webdyne/webdyne-zeroperl": "^1.0.14",
    "@webdyne/webdyne-cloudflare": "^1.7.1"
  },
  "webdyne": {
    "entry": "app.psp",
    "static": false,
    "extensions": {
      "@webdyne/webdyne-cloudflare": {}
    },
    "cloudflare": {
      "name": "webdyne-durable-objects-example",
      "durableObjects": [
        {
          "binding": "COUNTERS",
          "className": "Counter",
          "perlPackage": "Example::Counter",
          "methods": [
            "increment",
            "read"
          ],
          "initialize": true
        }
      ]
    },
    "perlLibrary": [
      "lib"
    ]
  }
}
