sub fmt   { Stats::LikeR::_view_size_fmt($_[0]) }
sub bytes { Stats::LikeR::_view_size($_[0]) }

# the format, against pandas
for my $row (@FMT) {
	my ($m, $k, $want) = @$row;
	my $n = $m;
	$n *= 2 for 1 .. $k;	# exact: a product of powers of two
	is(fmt($n), $want, "$m * 2**$k bytes is '$want'");
}
throws_ok { fmt(-1) }  qr/whole number/, 'a negative count is refused';
throws_ok { fmt(1.5) } qr/whole number/, 'a fractional count is refused';
throws_ok { Stats::LikeR::_view_size(5) } qr/not a reference/, '_view_size wants a reference';

# the first line carries the size, and it is the count in that format
my %frame = (
	AoH => [ { id => 1, name => 'Alice', score => 9.5 }, { id => 2, name => 'Bob', score => 12.25 } ],
	AoA => [ [ 1, 'Alice', 9.5 ], [ 2, 'Bob', 12.25 ] ],
	HoA => { id => [ 1, 2 ], name => [ 'Alice', 'Bob' ], score => [ 9.5, 12.25 ] },
	HoH => { r1 => { id => 1, name => 'Alice', score => 9.5 }, r2 => { id => 2, name => 'Bob', score => 12.25 } },
	Hash => { id => 1, name => 'Alice', score => 9.5 },
);
my %dim = (AoH => '2 rows x 3 cols', AoA => '2 rows x 3 cols', HoA => '2 rows x 3 cols',
           HoH => '2 rows x 3 cols', Hash => '1 row x 3 cols');
for my $kind (sort keys %frame) {
	my $d = $frame{$kind};
	my $shown = $kind eq 'Hash' ? 1 : 2;
	my $want = fmt(bytes($d));
	my ($first) = split /\n/, view($d, return_only => 1, color => 0);
	is($first, "# $kind: $dim{$kind}, $want\t(showing $shown row" . ($shown == 1 ? "" : "s") . ")", "$kind: the first line carries the size");
	like($want, qr/\A\d+\.\d (?:bytes|KB)\z/, "$kind: a small frame is in bytes or KB");
	my ($on) = split /\n/, view($d, return_only => 1, color => 0, size => 1);
	is($on, $first, "$kind: size => 1 is the default");
	for my $off (0, '', undef) {
		my ($line) = split /\n/, view($d, return_only => 1, color => 0, size => $off);
		is($line, "# $kind: $dim{$kind}\t(showing $shown row" . ($shown == 1 ? "" : "s") . ")",
			"$kind: size => " . (defined $off ? "'$off'" : 'undef') . ' leaves the size out');
	}
	# the table between the first line and its repeat as the last is the same either way
	my @with    = split /\n/, view($d, return_only => 1, color => 0);
	my @without = split /\n/, view($d, return_only => 1, color => 0, size => 0);
	is($with[-1], $with[0], "$kind: the last line repeats the first, size and all");
	is($without[-1], $without[0], "$kind: and does without the size too");
	shift @with; shift @without; pop @with; pop @without;
	is_deeply(\@with, \@without, "$kind: the size changes the first and last lines and nothing else");
	# painted with the rest of the line
	my ($col) = split /\n/, view($d, return_only => 1, color => 1);
	is($col, "\e[96m$first\e[0m", "$kind: the size is inside the painted first line");
}
is((split /\n/, view({}, return_only => 1, color => 0))[0],
	'# Hash: 0 rows x 0 cols, ' . fmt(bytes({})) . "\t(showing 0 rows)", 'an empty hash has a size too');
is((split /\n/, view([], return_only => 1, color => 0))[0],
	'# AoH: 0 rows x 0 cols, ' . fmt(bytes([])) . "\t(showing 0 rows)", 'and so has an empty array');
unlike(summary([ 1, 2, 3 ], return_only => 1, color => 0), qr/bytes|KB/, 'summary() reports no size');
throws_ok { summary([ 1, 2, 3 ], return_only => 1, size => 0) } qr/unknown argument\(s\): size/,
	'and does not take the option';

# the count: the same structure is the same size
sub aoh { my ($n, $key) = @_; [ map { { $key => $_, v => "s$_" } } 1 .. $n ] }
cmp_ok(bytes([ 1 .. 100 ]), '>', 0, 'a count is positive');
is(bytes([ 1 .. 100 ]), bytes([ 1 .. 100 ]), 'two arrays built alike are the same size');
is(bytes(aoh(50, 'k')), bytes(aoh(50, 'k')), 'and two AoH');
cmp_ok(bytes([ 1 .. 200 ]), '>', bytes([ 1 .. 100 ]), 'more elements are more bytes');
cmp_ok(bytes({ a => [ 1 .. 10 ], b => [ 1 .. 10 ] }), '>', bytes({ a => [ 1 .. 10 ] }), 'and so is another column');
# a string's buffer is counted. Not "990 more characters are 990 more bytes":
# perl gives a short string a buffer of at least 16 bytes (PERL_STRLEN_NEW_MIN,
# since 5.28) and rounds a long one up by less, so on perl 5.38.2 the ten
# characters take 16 and the thousand 1002, a difference of 986. Nine tenths
# of the 990 is asked for, which no rounding of either buffer can take away.
cmp_ok(bytes([ 'x' x 1000 ]) - bytes([ 'x' x 10 ]), '>=', 891, 'a longer string is that much larger');

# a thing reached twice is counted once
{
	my $col = [ 1 .. 1000 ];
	my $one = bytes({ a => $col });
	my $two = bytes({ a => $col, b => $col });
	# the second key costs an entry, a key and a reference, not a second column
	cmp_ok($two - $one, '<', bytes($col) / 2, 'a column under two names is counted once');
	my @rows = ({ x => 1 }) x 3;	# one row, three times
	cmp_ok(bytes(\@rows), '<', 2 * bytes([ { x => 1 } ]), 'a row in three slots is counted once');
}
# every row of an AoH has the same keys, and perl keeps one copy of a key
{
	my $long  = bytes(aoh(1000, 'k' x 200));
	my $short = bytes(aoh(1000, 'k'));
	# 199 more characters, once; a copy for each of 1000 rows would be 199000
	cmp_ok($long - $short, '<', 1000, 'a key shared by 1000 rows is counted once');
	cmp_ok($long - $short, '>=', 199, 'but it is counted');
}
# a cycle ends
{
	my $c = { name => 'c' };
	my $plain = bytes($c);
	$c->{self} = $c;
	my $n = bytes($c);
	cmp_ok($n, '>', $plain, 'a hash that holds itself has a size');
	cmp_ok($n - $plain, '<', $plain, 'and is not counted again through itself');
	my ($x, $y) = ([], []);
	push @$x, $y; push @$y, $x;
	cmp_ok(bytes($x), '>', 0, 'two arrays that hold each other end too');
	like((split /\n/, view($c, return_only => 1, color => 0))[0], qr/\A# HoH: 2 rows x 2 cols, /,
		'view() of the cyclic hash returns');
	delete $c->{self}; @$x = ();	# so that nothing is left for the leak tests' process to hold
}
# a weak reference is counted, and what it points at is not
{
	my $big = [ 1 .. 10_000 ];
	my $h = { big => $big };
	my $strong = bytes($h);
	weaken($h->{big});
	my $weak = bytes($h);
	cmp_ok($strong, '>', bytes($big), 'a strong reference is followed');
	cmp_ok($weak, '<', bytes($big) / 10, 'a weak one is not');
}
# a code reference is not entered: its closure is not the frame's data
{
	my @captured = (1 .. 10_000);
	my $f = sub { scalar @captured };
	cmp_ok(bytes([ $f ]), '<', bytes(\@captured) / 10, 'what a closure captures is not counted');
	cmp_ok(bytes([ \*STDOUT, qr/x/ ]), '>', 0, 'a glob and a regexp have a size');
}
# nesting deeper than the walk recurses (DS_MAX_DEPTH is 64) is queued, and
# each level is the same array of one reference, so the count is linear in it
{
	my $nest = sub { my $d = []; my $p = $d; for (1 .. $_[0]) { my $n = []; push @$p, $n; $p = $n } $d };
	my ($d0, $d1, $d2) = map { bytes($nest->($_)) } 0, 2000, 4000;
	is($d2 - $d1, $d1 - $d0, 'a structure 4000 references deep is counted level by level');
	cmp_ok($d1, '>', $d0, 'and each level adds to it');
}
# a tied container is the tie: nothing is fetched to size it
{
	package Counting;
	require Tie::Hash;
	our @ISA = ('Tie::StdHash');
	our $fetches = 0;
	sub FETCH    { $fetches++; $_[0]->SUPER::FETCH($_[1]) }
	sub FIRSTKEY { $fetches++; $_[0]->SUPER::FIRSTKEY }
	sub NEXTKEY  { $fetches++; $_[0]->SUPER::NEXTKEY($_[1]) }
	package main;
	tie my %t, 'Counting';
	$t{$_} = [ 1 .. 100 ] for 'a' .. 'e';
	$Counting::fetches = 0;
	my $n = bytes(\%t);
	is($Counting::fetches, 0, 'sizing a tied hash calls none of its methods');
	cmp_ok($n, '>', 0, 'and it has a size');
	# view() does read it, to show it
	my @l = split /\n/, view(\%t, return_only => 1, color => 0);
	like($l[0], qr/\A# HoA: 100 rows x 5 cols, /, 'view() shows a tied HoA');
	cmp_ok($Counting::fetches, '>', 0, 'by fetching from it');
}

# view() leaves the frame the size it found it: no number is given a string,
# and no row an iterator, for showing it. The Perl's keys() left an iterator
# on every row it read the columns off, 120 bytes each on perl-5.44.0.
{
	my $n = 300;
	my %big = (
		AoH => [ map { { i => $_, x => $_ / 7, s => "s$_" } } 1 .. $n ],
		AoA => [ map { [ $_, $_ / 7, "s$_" ] } 1 .. $n ],
		HoA => { i => [ 1 .. $n ], x => [ map { $_ / 7 } 1 .. $n ], s => [ map { "s$_" } 1 .. $n ] },
		HoH => { map { ("r$_" => { i => $_, x => $_ / 7, s => "s$_" }) } 1 .. $n },
	);
	for my $kind (sort keys %big) {
		my $before = bytes($big{$kind});
		my $out = view($big{$kind}, n => $n, return_only => 1, color => 1);
		is(bytes($big{$kind}), $before, "$kind: showing all $n rows leaves the frame's size alone");
		is(scalar(() = $out =~ /\n/g), $n + 3, "$kind: and all $n rows were shown"); # the first line, the header, the rows and the first line again
		my ($l1) = split /\n/, view($big{$kind}, return_only => 1, color => 0);
		my ($l2) = split /\n/, view($big{$kind}, return_only => 1, color => 0);
		is($l2, $l1, "$kind: a second view() reports the same size");
	}
}

# memory
unless ($INC{'Devel/Cover.pm'}) {
	for my $kind (sort keys %frame) {
		my $d = $frame{$kind};
		view($d, return_only => 1, color => 0);	# warm up
		no_leaks_ok { my $s = view($d, return_only => 1, color => 0) } "$kind: no leak with the size";
		no_leaks_ok { my $s = view($d, return_only => 1, color => 0, size => 0) } "$kind: no leak without it";
		no_leaks_ok { my $b = Stats::LikeR::_view_size($d) } "$kind: no leak sizing it";
	}
	# the "already counted" set is built, grown and freed
	my $col = [ 1 .. 2000 ];
	my $shared = { a => $col, b => $col, c => [ ($col) x 50 ] };
	no_leaks_ok { my $b = Stats::LikeR::_view_size($shared) } 'no leak sizing shared data';
	# and so is the queue for deep nesting
	my $deep = []; { my $p = $deep; for (1 .. 500) { my $n = []; push @$p, $n; $p = $n } }
	no_leaks_ok { my $b = Stats::LikeR::_view_size($deep) } 'no leak sizing deep data';
	no_leaks_ok { my $t = Stats::LikeR::_view_size_fmt(23028) } 'no leak formatting a size';
}

done_testing;
