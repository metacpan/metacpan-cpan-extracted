# ------------------------------------------------------------ counting.R
for my $tie (qw(efron breslow)) {
	my $a = coxph(formula => 'Surv(time, status) ~ x', data => $DATA{test1}, ties => $tie);
	my $b = coxph(formula => 'Surv(start, stop, status) ~ x', data => $DATA{test1b}, ties => $tie);
	check_fit("test1, $tie", $a, $EXPECT{"test1_$tie"});
	check_fit("test1b (start, stop], $tie", $b, $EXPECT{"test1b_$tie"});
	close_to($b->{coef}[0], $a->{coef}[0], 1e-10, "counting.R: split intervals reproduce the fit, $tie");
	check_fit("test1b clustered, $tie",
	          coxph(formula => 'Surv(start, stop, status) ~ x', data => $DATA{test1b}, ties => $tie, cluster => 'id'),
	          $EXPECT{"test1b_${tie}_cluster"});
	my %c = map { my $k = $_; ($k => [ grep { 1 } @{ $DATA{test1b}{$k} }[0 .. 12] ]) } keys %{ $DATA{test1b} };
	check_fit("test1b positional, $tie",
	          coxph($c{stop}, $c{status}, $c{x}, start => $c{start}, ties => $tie), $EXPECT{"test1b_$tie"});
}

# ------------------------------------------------------------ bladder.R
{
	my $B = read_csv('bladder.csv');
	$B->{enumf} = [ map { "e$_" } @{ $B->{enum} } ];
	# (rx + size + number) * strata(enum): the covariate-by-stratum columns
	# are rx:enumf, coded by contrasts exactly as survival codes them
	my $w = coxph(formula => 'Surv(stop, event) ~ rx + size + number + rx:enumf + size:enumf + number:enumf + strata(enum)',
	              data => $B, cluster => 'id', ties => 'breslow');
	check_fit('bladder WLW', $w, $EXPECT{bladder_wlw});
	is_deeply($w->{strata}, [qw(1 2 3 4)], 'bladder WLW: the strata');
	is($w->{'n.clusters'}, 85, 'bladder WLW: 85 patients');
	my $B2 = read_csv('bladder2.csv');
	check_fit('bladder2 Andersen-Gill', coxph(formula => 'Surv(start, stop, event) ~ rx + size + number', data => $B2,
	                                         cluster => 'id', ties => 'breslow'), $EXPECT{bladder2_ag});
	check_fit('bladder2 Andersen-Gill, Efron', coxph(formula => 'Surv(start, stop, event) ~ rx + size + number', data => $B2,
	                                                cluster => 'id'), $EXPECT{bladder2_ag_efron});
	check_fit('bladder2 Andersen-Gill, strata', coxph(formula => 'Surv(start, stop, event) ~ rx + size + number + strata(enum)',
	                                                 data => $B2, cluster => 'id'), $EXPECT{bladder2_ag_strata});
	check_fit('bladder2 Andersen-Gill, positional', coxph($B2->{stop}, $B2->{event}, [ @$B2{qw(rx size number)} ],
	                                                     start => $B2->{start}, cluster => $B2->{id}, ties => 'breslow'),
	          $EXPECT{bladder2_ag});
	for my $k (1 .. 3) {
		my %s;
		for my $i (0 .. $#{ $B2->{enum} }) {
			next unless $B2->{enum}[$i] == $k;
			push @{ $s{$_} }, $B2->{$_}[$i] for keys %$B2;
		}
		check_fit("bladder2 Prentice, recurrence $k", coxph(formula => 'Surv(stop, event) ~ rx + size + number',
		                                                   data => \%s, ties => 'breslow'), $EXPECT{"bladder2_prentice$k"});
		if ($k == 2) {
			$s{gap} = [ map { $s{stop}[$_] - $s{start}[$_] } 0 .. $#{ $s{stop} } ];
			check_fit('bladder2 Prentice gap time', coxph(formula => 'Surv(gap, event) ~ rx + size + number', data => \%s,
			                                             ties => 'breslow'), $EXPECT{bladder2_prentice2b});
		}
	}
	$B2->{hrx} = [ map { 0.5 * $_ } @{ $B2->{rx} } ];
	check_fit('bladder2 offset()', coxph(formula => 'Surv(start, stop, event) ~ size + number + offset(hrx)', data => $B2,
	                                    cluster => 'id'), $EXPECT{bladder2_offset});
	check_fit('bladder2 offset =>', coxph(formula => 'Surv(start, stop, event) ~ size + number', offset => 'hrx', data => $B2,
	                                     cluster => 'id'), $EXPECT{bladder2_offset});
}

# ------------------------------------------------------------ statsmodels
for my $f (qw(20_1 50_2 100_5 1000_10)) {
	my $D = read_csv("phreg_$f.csv", ' ');
	my $n = @{ $D->{time} };
	$D->{strata} = [ map { int($_ / ($n / 5)) } 0 .. $n - 1 ];
	my $xs = join ' + ', sort { substr($a, 1) <=> substr($b, 1) } grep { /^x\d/ } keys %$D;
	for my $tie (qw(breslow efron)) {
		my $k = "phreg_${f}_" . substr($tie, 0, 3);
		my %fits = (
			''       => coxph(formula => "Surv(time, status) ~ $xs", data => $D, ties => $tie),
			'_et'    => coxph(formula => "Surv(entry, time, status) ~ $xs", data => $D, ties => $tie),
			'_st'    => coxph(formula => "Surv(time, status) ~ $xs + strata(strata)", data => $D, ties => $tie),
			'_et_st' => coxph(formula => "Surv(entry, time, status) ~ $xs + strata(strata)", data => $D, ties => $tie),
		);
		for my $v (sort keys %fits) {
			check_fit("statsmodels $f$v, $tie", $fits{$v}, $EXPECT{"$k$v"});
			my $s = $STATSMODELS{"$k$v"} or next;
			for my $j (0 .. $#{ $s->{coef} }) {
				sig7_ok($fits{$v}{coef}[$j], $s->{coef}[$j], "statsmodels survival_r_results $f$v $tie: coef $j");
				sig7_ok($fits{$v}{se}[$j], $s->{se}[$j], "statsmodels survival_r_results $f$v $tie: se $j");
			}
		}
	}
}

# ------------------------------------------------------------ errors
{
	my %d = (t0 => [0, 1, 2, 0], t1 => [1, 2, 2, 3], e => [1, 0, 1, 1], x => [1, 2, 3, 4], id => [1, 1, 2, 3]);
	eval { coxph(formula => 'Surv(t0, t1, e) ~ x', data => \%d) };
	like($@, qr/stop time must be > start time/, 'start >= stop croaks');
	eval { coxph(formula => 'y ~ x', data => \%d) };
	like($@, qr/response must be Surv\(/, 'the response must be Surv()');
	eval { coxph(formula => 'Surv(t1) ~ x', data => \%d) };
	like($@, qr/Surv\(\) takes two or three arguments/, 'Surv() with one argument');
	eval { coxph(formula => 'Surv(t1, e) ~ x', data => \%d, start => [0, 0, 0, 0]) };
	like($@, qr/give start in Surv\(\)/, 'start => with a formula');
	eval { coxph(formula => 'Surv(t1, e) ~ x + cluster(id)', data => \%d, cluster => 'id') };
	like($@, qr/either as cluster\(\) or as cluster =>/, 'two clusters');
	eval { coxph([1, 2, 3], [1, 1, 0], [1, 2, 3], start => [0, 0, 0], robust => 1) };
	like($@, qr/robust = TRUE with \(start, stop\] data needs a cluster/, 'robust counting process needs a cluster');
	eval { coxph([1, 2, 3], [1, 1, 0], [1, 2, 3], weights => [1, -1, 1]) };
	like($@, qr/weights must be non-negative/, 'negative weight');
	eval { coxph([1, 2, 3], [1, 1, 0], [1, 2, 3], ties => 'exact') };
	like($@, qr/ties must be 'efron' or 'breslow'/, 'unknown ties');
	eval { coxph([1, 2, 3], [1, 1, 0], [1, 2, 3], strata => 'g') };
	like($@, qr/must be array refs/, 'positional options must be arrays');
	my @w;
	{
		local $SIG{__WARN__} = sub { push @w, $_[0] };
		coxph(formula => 'Surv(t1, e) ~ x', data => \%d, cluster => 'id', robust => 0);
	}
	like($w[0] // '', qr/cluster specified with robust = FALSE, cluster ignored/, 'robust = 0 drops the cluster, with survival\'s warning');
	my $one = coxph(formula => 'Surv(t1, e) ~ x + cluster(id)', data => \%d);
	is($one->{'n.clusters'}, 3, 'cluster() in the formula');
	my $s = coxph([1, 2, 3, 4, 5, 6], [2, 1, 2, 2, 1, 2], [1, 3, 2, 5, 4, 6]);
	is($s->{nevent}, 4, 'a 1/2 status is Surv()\'s 1 = censored, 2 = event');
}

