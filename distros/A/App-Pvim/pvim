        my $line = substr(safe($text[$i]),0,$t->{cols}-2);
        my $left = int(($t->{cols}-length($line))/2)+1;
        print sprintf("\e[%d;%dH%s",$top+$i,$left,$line);
    }
}
sub splash {
    my ($t) = @_;
    local $t->{in_splash} = 1;
    $t->splash_frame;
    while (1) {
        my $k = $t->read_key;
        if (defined($k) && $k eq "\x1a") { $t->suspend; next }
        last;
    }
    print "\e[2J\e[H"; $t->{previous} = [];
}

package main;
use Getopt::Long qw(GetOptionsFromArray);
use Pod::Usage;
our $VERSION = '0.1.13';
sub run {
    my (@args) = @_;
    my ($help,$manual,$version,$batch,$no_splash); my @commands;
    Getopt::Long::Configure('no_auto_abbrev','no_ignore_case');
    GetOptionsFromArray(\@args,'help|h'=>\$help,'manual'=>\$manual,'version|v'=>\$version,'batch'=>\$batch,
        'no-splash'=>\$no_splash,'command|c=s@'=>\@commands) or return 2;
    if ($help) { Pod::Usage::pod2usage(-exitval=>'NOEXIT',-verbose=>0); return 0 }
    if ($manual) { Pod::Usage::pod2usage(-exitval=>'NOEXIT',-verbose=>2,-noperldoc=>1); return 0 }
    if ($version) { print "pvim $VERSION (Perl $])\n"; return 0 }
    die "One file at a time; tabs are planned\n" if @args > 1;
    my $from_stdin = (@args && $args[0] eq '-') || (!$batch && !@args && !-t STDIN);
    my $keyboard;
    if ($from_stdin && !$batch) {
        die "Interactive stdin import requires a POSIX terminal; use --batch otherwise\n"
            if $^O eq 'MSWin32' || !-t STDOUT;
        open $keyboard, '<', '/dev/tty'
            or die "No controlling terminal for stdin import; use --batch with explicit '-' otherwise: $!\n";
    }
    my $e = PVim::Editor->new($from_stdin
        ? PVim::Store->load(undef, \*STDIN) : PVim::Store->load($args[0]));
    # Rebind descriptor 0 as well as Perl's handle so external shell commands
    # inherit the keyboard terminal rather than the exhausted producer pipe.
    if ($keyboard) { open STDIN, '<&', $keyboard or die "Attach keyboard terminal: $!\n" }
    for my $cmd (@commands) { $e->ex($cmd); last if $e->{quit} }
    return 0 if $batch || $e->{quit};
    my $t = PVim::Terminal->new;
    local $SIG{TERM} = sub { die "Terminated; unsaved changes were not written\n" };
    local $SIG{HUP} = sub { die "Terminal disconnected; unsaved changes were not written\n" };
    local $SIG{INT} = sub { die "Interrupted; unsaved changes were not written\n" };
    local $SIG{WINCH} = sub {
        $e->{redraw} = 1;
        $t->splash_frame if $t->{in_splash} && $t->{old};
    };
    $e->{before_filter} = sub { $t->stop };
    $e->{shell_wait} = sub {
        print "\nPress ENTER to return to pvim: ";
        while (sysread(STDIN,my $answer,1)) { last if $answer eq "\n" || $answer eq "\r" }
    };
    $e->{after_filter} = sub { $t->start; $t->{previous} = []; $e->{redraw} = 1 };
    $t->{on_resume} = sub { $e->{redraw} = 1; $t->{in_splash} ? $t->splash_frame : $t->draw($e) };
    local $SIG{TSTP} = sub { $t->suspend };
    my $ok = eval {
        $t->start; $t->splash unless @args || $no_splash || $from_stdin;
        my $pasting = 0;
        while (!$e->{quit}) {
            $t->draw($e) unless $pasting;
            my $k = $t->{queued} && @{$t->{queued}} ? shift @{$t->{queued}} : $t->read_key;
            last unless defined $k;
            if ($k eq "\x1a" && !$pasting) { $t->suspend; next }
            if ($k eq 'PASTE_START') {
                $pasting = 1; $e->insert_mode if $e->{mode} eq 'normal' || $e->{mode} eq 'prompt'; next;
            }
            if ($k eq 'PASTE_END') { $pasting = 0; next }
            # During bracketed paste, ESC/colon/control bytes must never execute commands.
            next if $pasting && (length($k) != 1 || (ord($k) < 32 && $k !~ /^[\t\r\n]$/));
            my $worked = eval { $e->key($k); 1 };
            unless ($worked) { $e->{message} = $@; $e->{pending} = ''; $e->{count} = '' }
        }
        $e->{b}->commit;
        1;
    };
    my $error = $@; $t->stop; die $error unless $ok; return 0;
}
unless (caller) {
    my $status = eval { run(@ARGV) };
    if ($@) { print STDERR "pvim: $@"; exit 1 }
    exit($status || 0);
}
1;
__END__

=head1 NAME

pvim - Vim-style editing for restricted environments

=head1 SYNOPSIS

  pvim [--no-splash] [file]
  printf 'hi\n' | pvim
  printf 'hi\n' | pvim -
  pvim --help
  pvim --manual
  pvim -v
  pvim --version
  pvim --batch -c '%s/old/new/g' -c w file

=head1 DESCRIPTION

pvim is for those accounts where Perl is there and Vim isn't. You have a shell,
files to edit, and no install privileges. Maybe it's cheap shared web hosting.
Maybe it's a minimal Unix install without gcc, make, or a way to add OS packages.
I'd still like to have a capable editor there.

The goal is a highly capable, Perl-centric Vim replacement that you can copy
into your own account and use. One Perl file, core modules, Perl 5.10 and up.
No root, no compiler, and no CPAN dependency hunt to get the editor running.
The standalone download includes the editor and this manual.

The basics are here: normal/insert/replace modes, familiar motions, search,
substitution, undo/redo, shell commands and filters, and optional perltidy.
Large files use temporary disk storage so opening a big file doesn't require
putting the whole thing in RAM. Vim is the reference for command behavior;
search and substitution use Perl regular expressions.

This is still an early release. Visual selection, tabs, splits, dot-repeat,
Vimscript and plugin support aren't here yet. Text editing is byte oriented,
and there is no crash recovery. The goal is a useful Vim replacement for these
systems; the supported commands and present limits are spelled out below.

=head1 REQUIREMENTS

You need Perl 5.10+ with its standard library, a POSIX shell account with an
ANSI/VT100 terminal, and writable space for temporary files and your edits.
A hosting account that only runs CGI scripts, without an interactive shell,
won't provide the terminal needed for full-screen editing. Local scripts must
be allowed to run under your account's existing restrictions.

The standalone file includes pvim, not Perl itself or missing core libraries.
Some distributions split the standard library into separate OS packages.
Perl::Tidy is optional; everything else the editor needs comes with a full Perl.

Interactive tests cover Linux and macOS. Native Windows supports the editing
engine and batch commands; its console UI isn't implemented. Other Unix systems,
32-bit builds and vintage machines still need testing. See
L<https://github.com/oodler577/pvim/blob/master/docs/PORTABILITY.md> for the record.
The earliest tested Perl is 5.10.1; 5.10.0 is the compatibility target.

=head1 OPTIONS

=over 4

=item B<--help>, B<-h>

Print a short usage reminder. B<--manual> prints the full manual, even if
perldoc is missing.

=item B<--version>, B<-v>

Print the pvim and Perl versions. Both flags do the same thing here. Vim uses
C<-v> for Vi mode; in pvim it's a version shortcut.

=item B<--batch>

Execute B<-c> commands in order without opening a terminal. Changes are saved
only by an explicit write command. Errors produce exit status 1; option errors
produce status 2. This mode uses the same editor engine as interactive use.

=item B<--command>, B<-c> I<command>

Execute an ex command. Repeat for multiple commands. Quote shell metacharacters.
Paths passed inside ex commands are literal, including spaces; no shell expansion
or command execution is performed. Use C<--> before filenames beginning with C<->.

=item B<--no-splash>

Suppress the initial unnamed-buffer splash. Opening splash text is centered
horizontally and vertically, and recenters when the terminal is resized.

=back

=head1 STANDARD INPUT

C<pvim -> imports standard input into an unnamed, modified buffer, as in Vim.
Interactive C<pvim> with no filename also imports redirected or piped stdin
when stdin is not a terminal. You can use C<echo hi | pvim> directly; Vim asks
for the explicit C<->. Use C<pvim ./-> for a file named C<->.
With a named file, stdin is not imported; interactive use requires terminal stdin.

  printf 'hi\n' | pvim
  cat source.pl | pvim -
  pvim < source.pl
  printf 'old\n' | pvim --batch -c 's/old/new/' -c 'w result.txt' -

Input is streamed to the disk-backed store until EOF, preserving bytes and line
endings. Empty input is also marked unsaved. C<:w filename> saves it; C<:q> refuses
to discard it, and C<:q!> explicitly discards it. No startup splash is shown.
pvim waits for EOF before editing begins. A command that keeps writing forever
needs to finish or be terminated first. Temporary-disk and giant-line limits still apply.

Interactive keystrokes are read separately from the POSIX controlling terminal
(C</dev/tty>); input text is never executed as editor commands. Terminal stdout
is required. Without a controlling terminal, startup fails before consuming the
input. Redirecting screen output into another pipeline is not supported.
C<--batch> imports stdin only with explicit C<-> and requires no terminal.
It never writes the imported buffer unless a write command is supplied.

=head1 NORMAL MODE

Escape returns to normal mode and cancels pending operators. Most movement and
edit commands accept a numeric count. Counts on both sides of an operator multiply.

  h j k l / arrows     left, down, up, right
  0 ^ $ / Home End     line start, first nonblank, line end
  w b e                word forward, backward, end (ASCII word classes)
  gg G                 first / last line; 20G or 20gg jumps to line 20
  Ctrl-F Ctrl-B        page forward / backward; PageDown / PageUp also work
  Ctrl-D Ctrl-U        half-page forward / backward
  Ctrl-L or L          redraw
  Ctrl-Z               suspend to shell; fg resumes with a full redraw
  i a I A              insert before/after cursor, first nonblank/end of line
  o O                  open line below/above and insert
  R                    overwrite mode; Backspace moves left
  rX                   replace character with X; 3rX replaces three
  x / Delete           delete character(s)
  dd yy cc             delete / yank / change line(s)
  d c y + w e b h l 0 $ same-line characterwise operators
  D C                  delete / change through end of line
  p P                  put register after/before cursor or below/above line
  J                    join next line with whitespace handling
  u Ctrl-R             undo / redo; one insert session is one undo unit
  /pattern ?pattern    forward / backward regex search, wrapping
  n N                  repeat search in same / opposite direction
  :                    ex prompt
  ZZ                   write and quit
  \t                   format Perl (backslash, then t); same as :pt

Insert accepts ASCII, Tab, newline, Backspace (including joining lines), and
arrows. Escape exits insert. Bracketed paste enters insert mode and treats pasted
printable text, tabs and newlines as data; other controls are discarded. Normal mode C<g> waits for another C<g>, as in Vim. C<^> means first nonblank, while C<0> means absolute line start. C<cw> on a word
leaves trailing whitespace, as in Vim. Registers clear when opening a new buffer.

=head1 EX COMMANDS

  :w [file]            write; :w! permits replacing existing/changed contents
  :wq [file]           write and quit; :x also writes and quits
  :q / :q!             quit with unsaved guard / discard changes
  :e [file]            open or reload; :e! discards unsaved changes
  :enew / :enew!       new unnamed buffer, with unsaved guard / discard
  :set number          show yellow line numbers; :set nonumber hides (default)
  :undo / :redo        undo / redo
  :123                 go to line 123; :$ goes to last line
  :s/foo/bar/          replace first occurrence on current line
  :%s/foo/bar/g        replace all occurrences throughout file
  :2,10s/foo/bar/gi    range, global, case insensitive
  :.,$s#old#new#g      current line through EOF, alternate delimiter
  :pt / :perltidy      format buffer if Perl::Tidy is installed
  :! command           run a shell command and display output; no buffer edit
  :.! command          filter the current line; !! opens this prompt
  :r !command          insert command output below the current line
  :0r !command         insert command output at the top of the file
  :2,10! command       filter a line range; :.,$! command also works
  :%! command          filter the whole buffer
  :help                short controls reminder

Patterns are Perl regular expressions, not Vim regular expressions. Replacement
supports C<&> for the whole match, C<\1> through C<\9> for captures, C<\t>, and
escaped delimiters/backslashes/ampersands. Replacement is never evaluated as Perl.
Only C<g> and C<i> flags are accepted. Multiline substitutions, confirmation,
Vim expression replacement, named registers, macros, dot-repeat,
splits, tabs, and visual selection are not implemented.

Perltidy uses the installed C<Perl::Tidy> module with C<-npro -l=500>, ignores
project/user tidy profiles, and never invokes a shell. Formatting is undoable
and does not save. Formatting is capped at 8 MiB and 200,000 lines because
Perl::Tidy materializes the whole source. Failure leaves the buffer unchanged.

=head1 PERL FEATURES

Perl is the focus, but you can edit other text too. Search and substitution use
Perl regexes, and C<\t>, C<:pt> and C<:perltidy> can format code if Perl::Tidy is
installed for the Perl running pvim. The formatter is optional.

Syntax highlighting can wait; file text is plain for now. Yellow line numbers
and status colors are available. There is no completion, language server,
buffer-aware C<perl -c>, debugger or integrated test runner yet.

Batch commands use the same editing engine, so you can use it in scripts too.
External commands and filters let you use whatever tools the host already has.
See L</SHELL FILTERS> before using a command that doesn't produce replacement text.

=head1 SHELL FILTERS

C<:! command> runs a shell command and displays output without altering the
buffer. Interactive use waits for Enter before returning to the editing screen.
C<:.! command> sends the current line to the command's stdin and replaces it with
stdout. Normal-mode C<!!> opens the current-line filter prompt. C<:2,10! command>,
C<:.,$! command> and C<:%! command> filter ranges or the entire file. Output can
grow, shrink or delete the selected lines. A replacement is one undo unit and
never saves automatically.

C<:r !command> inserts stdout below the current line; C<:0r !command> inserts it
at the top. An explicit read address inserts below that line. Read commands do
not send the existing buffer as stdin. Empty read output leaves the buffer alone.

  :! ls
  :.! tr '[:lower:]' '[:upper:]'
  :2,10! sort
  :%! perl -pe 's/old/new/g'
  :%! perltidy -st -npro -l=500
  :r !date

This follows Vim's separation of execution, filtering and reading command output.
Command-history C<:!!>, filename C<%>/C<#> expansion inside shell commands, general
C<!motion> filters, and ordinary C<:r file> are not implemented yet. Only explicitly
typed shell/read/filter commands execute programs.

POSIX uses C</bin/sh -c>; native Windows batch uses COMSPEC/cmd.exe. Commands must
read stdin and write replacement text to stdout; pipelines/redirection follow
the shell's semantics. A nonzero command status, output-read error or edit failure
leaves the buffer unchanged. Up to 4096 stderr bytes become a status diagnostic.
Successful empty stdout deletes the selected lines. A filter is not a syntax-check
command: C<perl -c> normally emits no replacement source and would erase its range
on success. Use C<:! perl -c path/to/saved.pl> or Ctrl-Z / C<fg> for checks.
These check the saved file, not unsaved buffer text.

Capture files prevent stdout/stderr pipe deadlocks and bound capture RAM. Input,
output and the replacement line index use temporary disk; the external command
has its own resource requirements. Commands are synchronous. Interactive tty state
and the main screen are restored while a filter runs, then editing resumes.
Shell commands can modify external files; undo reverses only the buffer edit.

=head1 LARGE FILES AND PERFORMANCE

Large files shouldn't need file-sized amounts of RAM. pvim streams input into
private temporary files and builds a disk index using 24 bytes per line. Opening
still means reading the input once. Allow roughly the file size plus the line
index on temporary disk, with more room for edits and saving. Set C<TMPDIR> to a
private, writable location with enough space if the host's default is too small.

Undo keeps references to edited pieces instead of copying the whole buffer.
RAM use grows with edits and fragmentation, rather than the initial file size.
Saving streams the text back out. The terminal driver redraws changed rows.

There are practical limits. Editing, searching or displaying an individual line
loads that line into RAM, so a huge single line can be slow and expensive.
Searches, whole-file substitutions, formatting and saves are synchronous; they
can pause editing. A bad regex can take a long time. Temporary edit storage and
undo history aren't compacted until the buffer closes. Use a 64-bit Perl for
files beyond 2 GiB. Benchmarks live in C<tools/benchmark.pl> and the portability
notes; they describe tested workloads, not a speed guarantee for every file.

=head1 FILE SAFETY AND ENCODING

The editor is byte oriented. Printable ASCII and tabs display normally; other
bytes display as C<< <HH> >>, preserving their bytes. It does not provide Unicode
character/grapheme editing. No language lexer runs during display.
Long lines pan horizontally; they do not wrap.

Untouched LF/CRLF line endings, mixed endings, and a missing final newline survive
round trips. New lines use the first observed newline style. A new unnamed/file
buffer uses LF and a final newline. Files save via a same-directory temporary
file and rename; ordinary permission bits are preserved. Symlink and hard-linked
save targets are refused. Read-only targets are refused even with C<!>. Ownership,
ACLs, xattrs, sparse layout and durability across power failure are not preserved
or guaranteed. No fsync, locking, swap recovery, autosave, or crash journal yet.
External-content changes are detected by SHA-256 before saving. This is a guard,
not an atomic compare-and-swap against concurrent writers. Avoid concurrent edits.

On normal exit and handled terminal errors the tty is restored. SIGKILL, power
failure and terminal loss can lose unsaved edits; this release has no recovery.
All handled interactive exits restore the main screen and emit a newline.
Ctrl-Z restores terminal settings and suspends the editor from normal, insert,
replace, command-prompt or splash mode. Resume the shell job with C<fg> to restore
the editing screen and mode, retaining unsaved changes. External SIGTSTP follows
the same path. Bracketed-paste control bytes do not trigger suspension.

Line numbers are off by default. C<:set number> uses a right-aligned three-column
number field in ANSI yellow, followed by one separating space. The field widens
for four or more digits without truncating numbers. The number color is terminal
UI styling, independent of the deferred syntax-highlighting feature.

Ctrl-C is a normal input byte in raw mode; use Escape then C<:q> to quit. Terminal
resize is handled at the next keypress. Native Windows interactive UI is pending.

=head1 INSTALLATION

If you don't have install privileges, use the standalone file. Download C<pvim>
or C<pvim-standalone.pl> from L<https://github.com/oodler577/pvim/releases>, save
it as C<pvim>, and make it executable:

  chmod +x pvim
  ./pvim file.pl

That's the editor. There is nothing to compile or unpack at startup. It uses
the Perl interpreter on PATH and needs no make, gcc, module installation or
separate fat-packing step. The two standalone release assets have identical bytes.

To keep it in your account:

  mkdir -p "$HOME/.local/bin"
  cp pvim "$HOME/.local/bin/pvim"
  "$HOME/.local/bin/pvim" -v

Add that directory to PATH if needed, then call C<pvim file.pl> from anywhere.
You can transfer the file from another machine if the host has no download tool.

The C<App-Pvim-VERSION.tar.gz> release asset is a normal Perl distribution.
You can point C<cpanm> at its URL and install it under your account. That route
needs the usual Perl build tools, including make; pvim itself has no C code to
compile. Choose the standalone file if make is missing too. Consumers don't need
Dist::Zilla or Moose. C<App::Pvim> supplies the CPAN namespace and version; the
installed C<pvim> command contains the editor; its POD supplies C<man pvim>.

Use C<pvim --help> for the short version and C<pvim --manual> for this manual.
Both work offline. The wiki is at L<https://github.com/oodler577/pvim/wiki>.

=head1 BUGS AND SUPPORT

Please try it on copies of your files first. There is no crash recovery yet.
If something breaks, report it at L<https://github.com/oodler577/pvim/issues>.
Include C<pvim -v>, the OS and terminal, what you typed, and the smallest example
that shows the problem. Leave private file contents out of the report.

