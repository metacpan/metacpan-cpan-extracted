	# PR#17369: unique(d22) keeps both rows in R, whose doubles differ in the
	# 17th digit; drop_duplicates compares stringified cells (README), which
	# print alike at 15 digits.  Asserted as the documented difference.
	my $d22 = frame_from_cols([qw(x y)], { x => $R{'d22$x'}, y => $R{'d22$y'} });
	my $got = eval { drop_duplicates(build($d22, 'HoA')) };
	# As many rows as this perl prints differently: one on a double NV (15
	# digits), two on a long-double or __float128 NV, whose extra digits tell
	# the doubles apart as R does.
	my $want22 = do {
		my %s;
		$s{ "$R{'d22$x'}[$_]\0$R{'d22$y'}[$_]" } = 1 for 0 .. $#{ $R{'d22$x'} };
		scalar keys %s;
	};
	is_deeply($got ? scalar @{ $got->{x} } : -1, $want22,
		'R PR#17369: 0.3 + 0.6 and 0.9 are as many rows as they print apart (R keeps 2): stringified comparison, documented');
	is($want22, 1, 'R PR#17369: on a double NV they print alike, one row') if $Config{nvsize} == 8;
}
