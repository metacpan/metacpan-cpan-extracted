#!/usr/bin/env perl
# TukeyHSD() on a two-factor model, and on every data-frame shape.
#
# t/tukey.t and t/tukey_aov_prcomp.R.t fit one factor only, and pass the data
# as a HoA, so nothing ran TukeyHSD() on a model with a second factor or read
# its data from an AoH or a HoH.  This file uses TukeyHSD.Rd's own example,
# aov(breaks ~ wool + tension, warpbreaks), balanced and with six rows dropped,
# and gives the same data as a HoA, an AoH and a HoH.
#
# PROVENANCE
# ----------
# warpbreaks is R 4.6.1's datasets::warpbreaks, transcribed in warpbreaks()
# below.  The expected values in reference() were generated by
# t/TukeyHSD.twoway.R.R under R 4.6.1 and are frozen here; the test never runs
# R.  Re-run that script and paste its output over the body of reference() to
# regenerate them.  The factors are character vectors on the R side, so R
# orders tension's levels H, L, M as this module does, not L, M, H as the stored
# factor does.  For the balanced fit with ordered = TRUE, the tension rows are
# also the ones R 4.6.1's tests/Examples/stats-Ex.Rout.save pins for
# TukeyHSD(fm1, "tension", ordered = TRUE), to its seven printed digits:
#   M-H  4.722222 -4.6311985 14.07564 0.4474210
#   L-H 14.722222  5.3688015 24.07564 0.0011218
#   L-M 10.000000  0.6465793 19.35342 0.0336262
#
# KNOWN DIVERGENCE
# ----------------
# TukeyHSD() compares observed marginal means.  R's TukeyHSD.aov() compares the
# means of model.tables(), which for a factor after the first in an unbalanced
# design are adjusted for the factors before it.  The two agree for the first
# factor and for a balanced design, and differ otherwise: on the unbalanced fit
# below, tension's M-L difference is -10.083 here and -11.003 in R.  Those rows
# run in a TODO block holding R's values, so they report the divergence without
# failing, and making TukeyHSD() follow R is a deliberate change to that block.
#
# TOLERANCE
# ---------
# Relative 1e-10 on diff, lwr, upr and 'p adj'.  The worst observed
# disagreement on perl-5.44.0 (double) is 3.8e-13, on the unbalanced fit's wool
# B-A upr: 1.107 is -5.659 plus a half-width of 6.766, so the cancellation
# magnifies qtukey()'s error about tenfold.  t/tukey_aov_prcomp.R.t sees 4.7e-13
# on its TukeyHSD columns.  1e-10 leaves about 260x headroom for the wider NV
# builds, whose qtukey() search stops at a different point.
require 5.010;
use strict;
use warnings FATAL => 'all';
use Stats::LikeR qw(aov TukeyHSD);
use Test::More;

my $TOL = 1e-10;	# relative; see TOLERANCE above
my $worst = 0;
our $TODO;	# Test::More reads it; set only for the KNOWN DIVERGENCE rows

sub rel_ok {
	my ($got, $want, $name) = @_;
	if (!defined $got) { fail("$name (got undef)"); return }
	my $err = $want == 0 ? abs($got) : abs($got - $want) / abs($want);
	$worst = $err if $err > $worst && !defined $TODO;	# R agreement only
	ok($err <= $TOL, $name)
		or diag(sprintf("     got: %.17g\nexpected: %.17g\n rel err: %.3g", $got, $want, $err));
}

#One factor's rows of a TukeyHSD() result against R's, in R's row order.
#A defined $todo marks the numbers, not the labels, as a TODO: see KNOWN
#DIVERGENCE.
sub rows_ok {
	my ($got, $want, $tag, $todo) = @_;
	is_deeply([ map { $_->{comparison} } @$got ], [ map { $_->[0] } @$want ],
		"$tag: comparisons, in R's order");
	local $TODO = $todo;	# the numbers only: the labels and their order agree with R
	for my $i (0 .. $#$want) {
		my ($lab, @v) = @{ $want->[$i] };
		my $g = $got->[$i] or next;
		rel_ok($g->{diff},    $v[0], "$tag $lab: diff");
		rel_ok($g->{lwr},     $v[1], "$tag $lab: lwr");
		rel_ok($g->{upr},     $v[2], "$tag $lab: upr");
		rel_ok($g->{'p adj'}, $v[3], "$tag $lab: p adj");
	}
}

my %wb = warpbreaks();
my %ref = reference();
my %drop = map { $_ - 1 => 1 } (1, 2, 3, 20, 40, 41);	# R's 1-based rows
my %unb;
for my $col (keys %wb) {
	$unb{$col} = [ map { $wb{$col}[$_] } grep { !$drop{$_} } 0 .. $#{ $wb{$col} } ];
}

for my $design ([balanced => \%wb], [unbalanced => \%unb]) {
	my ($name, $hoa) = @$design;
	my $n = scalar @{ $hoa->{breaks} };
	my @aoh = map { my $i = $_; +{ map { $_ => $hoa->{$_}[$i] } keys %$hoa } } 0 .. $n - 1;
	#Row names that sort as strings in a different order from the rows: the
	#HoH's row order must not matter, since a mean does not depend on it.
	my %hoh = map { my $i = $_; ($i + 1 => $aoh[$i]) } 0 .. $n - 1;
	my $fit = aov($hoa, 'breaks ~ wool + tension');
	for my $shape ([HoA => $hoa], [AoH => \@aoh], [HoH => \%hoh]) {
		for my $ord (0, 1) {
			my $want = $ref{"$name, ordered => $ord"};
			my $h = TukeyHSD($fit, data => $shape->[1], response => 'breaks', ordered => $ord);
			my $tag = "$name $shape->[0] ordered=$ord";
			is($h->{ordered}, $ord, "$tag: 'ordered' attribute");
			rows_ok($h->{wool}, $want->{wool}, "$tag wool");
			if ($name eq 'balanced') {
				rows_ok($h->{tension}, $want->{tension}, "$tag tension");
			} else {
				rows_ok($h->{tension}, $want->{tension}, "$tag tension",
					'TukeyHSD() compares marginal means; R adjusts a later factor in an unbalanced design (see KNOWN DIVERGENCE)');
			}
		}
	}
}

#The one-factor form of the same call: 'which' limits the result to tension,
#as TukeyHSD(fm1, "tension", ordered = TRUE) does in the R example.
{
	my $h = TukeyHSD(aov(\%wb, 'breaks ~ wool + tension'),
		data => \%wb, formula => 'breaks ~ wool + tension', which => 'tension', ordered => 1);
	ok(!exists $h->{wool}, "which => 'tension' leaves wool out");
	rows_ok($h->{tension}, $ref{'balanced, ordered => 1'}{tension}, 'R example, which => tension');
}

diag(sprintf('worst relative disagreement with R: %.3g (limit %g)', $worst, $TOL));
done_testing();

