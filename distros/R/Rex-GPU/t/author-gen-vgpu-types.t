
BEGIN {
  unless ($ENV{AUTHOR_TESTING}) {
    print qq{1..0 # SKIP these tests are for testing by the author\n};
    exit
  }
}

use strict;
use warnings;
use Test::More;

# -----------------------------------------------------------------------------
# maint/gen-vgpu-types.pl against a small fixture checkout (karr #64).
#
# An author test: the script is a maint tool, not installed, and needs
# Path::Tiny (a develop prerequisite) -- nothing an installing user runs.
#
# CLAIMS:
#   * happy path: exit 0; only the region between "# BEGIN GENERATED" and
#     "# END GENERATED" of --output is replaced -- the text before and after
#     is byte for byte what it was; the region carries tag, date, count, the
#     MIT notice, and the pairs lowercase and sorted;
#   * a duplicate pair, a subsystem vendor other than 0x10de, a quote in a
#     name, and an output without the region each die (exit != 0) naming the
#     problem, and leave --output untouched.
#
# NOT covered: the real open-gpu-kernel-modules header (its format is what
# the fixture copies from 615.71.09, by hand).
# -----------------------------------------------------------------------------

use FindBin qw( $Bin );
use IPC::Open3 qw( open3 );
use Path::Tiny qw( path tempdir );

# xt/author/ in the repo, t/ once dzil's ExtraTests has moved it into the build
my ($SCRIPT) = grep { -f $_ }
  map { path($Bin)->parent($_)->child('maint/gen-vgpu-types.pl')->stringify } 1, 2;
BAIL_OUT('maint/gen-vgpu-types.pl not found above '.$Bin) unless $SCRIPT;
my $BEGIN  = '# BEGIN GENERATED by maint/gen-vgpu-types.pl -- do not edit by hand, rerun it';
my $END    = '# END GENERATED';

my $HEAD = "package Fake::VGPU;\n\n# hand-written above\nsub type_for { 1 }\n\n";
my $TAIL = "\n1;\n\n=head1 NAME\n\nFake::VGPU - hand-written below\n\n=cut\n";
my $OLD_REGION = "$BEGIN\nsub types { () }\n$END\n";

my $COPYING = <<'EOT';
Copyright (c) 2026 NVIDIA fixture

This project is licensed as MIT:

  Permission is hereby granted, free of charge.

  THE SOFTWARE IS PROVIDED "AS IS".

However, the Linux kernel modules are dual licensed.
EOT

# A checkout with these sVgpuUsmTypes[] lines, and an output module.
sub fixture {
  my ( @entries ) = @_;
  my $dir = tempdir();
  my $inc = $dir->child('src/common/shared/inc');
  $inc->mkpath;
  $inc->child('g_vgpu_chip_flags.h')->spew_utf8(
    "/* fixture */\n#ifndef G_VGPU_CHIP_FLAGS_H\n"
    ."static const VGPU_USM_TYPES sVgpuUsmTypes[] = {\n"
    .join('', map { "$_\n" } @entries)
    ."};\n#endif\n");
  $dir->child('COPYING')->spew_utf8($COPYING);
  my $out = $dir->child('VGPU.pm');
  $out->spew_utf8($HEAD.$OLD_REGION.$TAIL);
  return ( $dir, $out );
}

sub gen {
  my ( $dir, $out ) = @_;
  my $pid = open3(my $in, my $fh, undef, $^X, $SCRIPT, '--source', "$dir", '--tag', '615.71.09',
    '--date', '2026-09-24', '--output', "$out");
  close $in;
  my $text = do { local $/; <$fh> } // '';
  waitpid $pid, 0;
  return ( $? >> 8, $text );
}

my $A = 'ENTRY(0x2236, 0x14B9, 0x10DE, "NVIDIA A10-2Q"),';
my $B = 'ENTRY(0x20B0, 0x146F, 0x10DE, "GRID A100X-1-5C"),';

subtest 'happy path: only the GENERATED region is replaced' => sub {
  my ( $dir, $out ) = fixture($A, '', $B);
  my ( $exit, $text ) = gen($dir, $out);
  is($exit, 0, 'exit 0') or diag($text);
  like($text, qr/^2 vGPU types from .* \(615\.71\.09\) written to /m, 'reports the count');
  my $got = $out->slurp_utf8;
  is(substr($got, 0, length $HEAD), $HEAD, 'text before the region unchanged');
  is(substr($got, -length $TAIL), $TAIL, 'text after the region unchanged');
  my ( $region ) = $got =~ /^(\Q$BEGIN\E\n.*?^\Q$END\E\n)/ms;
  ok(defined $region, 'one region, BEGIN .. END');
  is(length($HEAD) + length($region) + length($TAIL), length($got), '... and nothing else');
  unlike($region, qr/sub types \{ \(\) \}/, '... the old region is gone');
  like($region, qr/^# Source: src\/common\/shared\/inc\/g_vgpu_chip_flags\.h, sVgpuUsmTypes\[\]$/m, 'provenance: file');
  like($region, qr/^# Generated 2026-09-24, 2 pairs /m, 'provenance: date and count');
  like($region, qr/^#   Permission is hereby granted, free of charge\.\n#\n#   THE SOFTWARE IS PROVIDED "AS IS"\.$/m, 'MIT notice');
  like($region, qr/tag       => '615\.71\.09',\n    generated => '2026-09-24',\n    entries   => 2\n/, 'source()');
  like($region, qr/  return \(\n    '20b0:146f' => 'GRID A100X-1-5C',\n    '2236:14b9' => 'NVIDIA A10-2Q'\n  \);/,
    'types(): lowercase, sorted, no trailing comma');
};

for my $case (
  [ 'duplicate pair',  [ $A, $B, 'ENTRY(0x2236, 0x14b9, 0x10DE, "NVIDIA A10-2Q again"),' ], qr/pair 2236:14b9 listed twice/ ],
  [ 'foreign vendor',  [ $A, 'ENTRY(0x2236, 0x14BA, 0x1028, "Dell A10"),' ], qr/subsystem vendor 0x1028 is not 0x10de/ ],
  [ "single quote in a name", [ $A, q{ENTRY(0x2236, 0x14BA, 0x10DE, "NVIDIA A10's"),} ], qr/unexpected line in sVgpuUsmTypes\[\]/ ],
  [ 'escaped double quote',   [ $A, q{ENTRY(0x2236, 0x14BA, 0x10DE, "NVIDIA \"A10\""),} ], qr/unexpected line in sVgpuUsmTypes\[\]/ ],
) {
  my ( $name, $entries, $re ) = @$case;
  my ( $dir, $out ) = fixture(@$entries);
  my ( $exit, $text ) = gen($dir, $out);
  isnt($exit, 0, "$name: dies");
  like($text, $re, '... naming the problem');
  is($out->slurp_utf8, $HEAD.$OLD_REGION.$TAIL, '... output untouched');
}

{
  my ( $dir, $out ) = fixture($A);
  $out->spew_utf8($HEAD.$TAIL);
  my ( $exit, $text ) = gen($dir, $out);
  isnt($exit, 0, 'no GENERATED region: dies');
  like($text, qr/no '\Q$BEGIN\E' \.\.\. '\Q$END\E' region to replace/, '... naming it');
  is($out->slurp_utf8, $HEAD.$TAIL, '... output untouched');
}

done_testing;
