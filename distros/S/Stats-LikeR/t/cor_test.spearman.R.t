#!/usr/bin/env perl
# cor_test(method => 'spearman') against R 4.6.1's cor.test().
#
# Provenance: t/cor_test.spearman.R.R (committed next to this file) generated
# every value in @R_ROWS under R 4.6.1 (2026-06-24) at options(digits = 17).
# Re-run it with
#     Rscript t/cor_test.spearman.R.R
# This test never invokes R; it reads the frozen literals.  Data are small
# integers throughout, so the ranks -- and so the tie structure the exact
# branch turns on -- are identical at every NV width.
#
# What it pins.  Through 0.31 this function did three things R does not.
#
# 1. exact => 1 ran an unbounded n! permutation walk.  R has never enumerated
#    past n = 9 (prho()'s n_small, src/library/stats/src/prho.c), whatever
#    `exact` says; here the caller's flag was taken literally, so n = 12 took
#    5 seconds, n = 13 over a minute and n = 24 asked for 6.2e23 permutations
#    and never returned.  The @HANG cases below are the pin: each must finish,
#    and each must agree with R.
#
# 2. `exact` defaulted to (n < 10) rather than to TRUE.  R hands every n up to
#    1290 to prho() -- exact below 10, AS 89 above it -- and only past 1290
#    falls back to the asymptotic t.  Defaulting to (n < 10) put every sample
#    of 10 or more on R's exact = FALSE branch, and the p-values were wrong by
#    tens of percent to many orders of magnitude:
#        n = 32   gave 1.7639963277557958e-07   R: 1.1513643381176551e-06
#        n = 16   gave 5.0655870675677e-17      R: 5.7949654941386787e-06
#    @R_ROWS crosses n, all three alternatives and exact in
#    {default, 1, 0}, so the default and the two forced settings are each
#    pinned separately.
#
# 3. `statistic` was S from the exact branch and the t statistic from the
#    other, so the field changed meaning at n = 10.  It is now S on every
#    path, as in R (STATISTIC <- c(S = q), set once before the p-value
#    switch).  README.md's note that "statistic is the z of the approximation"
#    described the old behaviour and has been updated.
#
# 4. That S was sum((rank(x) - rank(y))^2), which is R's S only when there are
#    no ties -- R computes q <- (n^3 - n) * (1 - r) / 6 and says so in the
#    comment above the line.  On tied data the two are simply different
#    numbers: 2.5 against R's 2.5192319072807861 for @TIES's n = 10 case.
#    0.312 forms S from the identity, so @TIES now asserts R's values.
#
# RECORDED DIVERGENCE.  One family, where R carries floating-point noise that
# Stats::LikeR does not, so R's literal is quoted here as provenance while the
# assertion is against the exact value.  It is not a disagreement about the
# mathematics.
#
# (a) Perfect correlation (@PERFECT).  Both projects form S as
#     (n^3-n)(1-rho)/6.  R's cor() returns a rho 2.2e-16 short of 1, so at
#     n = 10 R reports S = 3.6637359812630166e-14 for an exact 0, and
#     329.99999999999994 for an exact 330 (n = 24: 2.55351295663786e-13 for 0).
#     cor_test()'s Welford accumulation returns exactly +/-1, so the identity
#     gives the integers.  The same shortfall makes R's exact = 0 branch report
#     a finite t and p = 1.0635035875251001e-62 at n = 10 where rho is exactly
#     1 and the p-value is 0.
#
#     Fixed in 0.312: S is now formed the way R forms it, so what remains is
#     only the shortfall in R's rho.  The Welford accumulation in cor_test()
#     returns exactly 1 for a perfect correlation, so the same identity gives
#     exactly 0 and 330 where R's noisy rho gives 3.66e-14 and
#     329.99999999999994.  @PERFECT asserts the exact values and quotes R's.
#
# Tolerance.  1e-10 relative on both fields, against a worst observed
# disagreement over the 333 clean rows of 1.123e-12 for p_value (n = 9,
# two.sided) and 4.530e-14 for statistic (n = 24) on the double build.  That
# is ~90x headroom, which the wider NV builds need: the AS 89 branch is a
# degree-6 polynomial in x^2 plus approx_pnorm(), and its last bits move with
# NV width.

require 5.010;
use strict;
use warnings FATAL => 'all';
use Test::More;
use lib 'blib/lib', 'blib/arch';
use Stats::LikeR qw(cor_test);

my $TOL = 1e-10;   # justified in the header

sub call {
	my ($n, $y, $alt, $ex) = @_;
	my %a = (method => 'spearman', alternative => $alt);
	$a{exact} = $ex unless $ex eq 'd';
	return cor_test([1 .. $n], $y, %a);
}

sub rel_ok {
	my ($got, $exp, $name) = @_;
	my $rel = $exp == 0 ? abs($got) : abs($got - $exp) / abs($exp);
	ok($rel <= $TOL, $name)
		or diag(sprintf "got %.17g, expected %.17g, rel %.3e", $got, $exp, $rel);
}

