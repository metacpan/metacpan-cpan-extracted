<!DOCTYPE html>
<html lang="[% language | html %]">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>[% title | html %] — Database::BI</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: system-ui, -apple-system, sans-serif;
      background: #f4f6f9;
      color: #1a1a2e;
      padding: 2rem;
    }

    header {
      margin-bottom: 1.5rem;
    }

    header h1 {
      font-size: 1.75rem;
      font-weight: 600;
      color: #2c3e7a;
    }

    main {
      background: #ffffff;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,.08);
      padding: 1.5rem;
      overflow-x: auto;
    }

    .table-scroll {
      overflow-x: auto;
      width: 100%;
    }

    table {
      width: max-content;
      min-width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
    }

    thead tr {
      background: #2c3e7a;
      color: #ffffff;
    }

    thead th {
      padding: 0.75rem 1rem;
      text-align: left;
      font-weight: 600;
      letter-spacing: 0.03em;
      white-space: nowrap;
      cursor: grab;
      user-select: none;
    }

    thead th.dragging {
      opacity: 0.4;
    }

    thead th.drag-over {
      background: #1a2558;
      box-shadow: inset 3px 0 0 #fff;
    }

    thead th[aria-sort]::after {
      content: '';
      display: inline-block;
      width: 0.9em;
      margin-left: 0.35em;
      vertical-align: middle;
      opacity: 0.4;
    }
    thead th[aria-sort="ascending"]::after  { content: '▲'; opacity: 1; }
    thead th[aria-sort="descending"]::after { content: '▼'; opacity: 1; }

    tbody tr:nth-child(even) { background: #f8f9fc; }
    tbody tr:hover           { background: #eef1fb; }

    tbody td {
      padding: 0.6rem 1rem;
      border-bottom: 1px solid #e4e8f0;
    }

    tfoot tr {
      background: #1e3060;
      color: #fff;
    }
    tfoot td {
      padding: 0.6rem 1rem;
      font-weight: 600;
      font-variant-numeric: tabular-nums;
    }
    .totals-sum { font-variant-numeric: tabular-nums; }

    .lbl-totals {
      flex-shrink: 0;
      align-self: center;
      display: inline-flex;
      align-items: center;
      gap: 0.4em;
      padding: 0.3rem 0.9rem;
      border: 1px solid #888;
      border-radius: 6px;
      background: transparent;
      color: #444;
      font-size: 0.85rem;
      cursor: pointer;
      transition: background 0.15s;
      user-select: none;
    }
    .lbl-totals:hover { background: #f0f0f0; }
    .lbl-totals input[type="checkbox"] { cursor: pointer; accent-color: #2c3e7a; }

    .empty-state {
      text-align: center;
      color: #888;
      padding: 3rem 1rem;
      font-style: italic;
    }

    .error {
      background: #fdecea;
      border-left: 4px solid #c0392b;
      color: #922b21;
      padding: 0.75rem 1rem;
      border-radius: 4px;
      margin-bottom: 1.25rem;
    }
    .hint {
      background: #eaf4fb;
      border-left: 4px solid #2980b9;
      color: #1a5276;
      padding: 0.75rem 1rem;
      border-radius: 4px;
      margin-top: -0.75rem;
      margin-bottom: 1.25rem;
      font-size: 0.93em;
    }

    .back-link {
      margin-bottom: 1rem;
      font-size: 0.875rem;
    }
    .back-link a { color: #2c3e7a; text-decoration: none; }
    .back-link a:hover { text-decoration: underline; }

    /* Toolbar row: record count + "Add database" button */
    .toolbar {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      margin-bottom: 0.75rem;
      flex-wrap: wrap;
    }

    .record-count {
      font-size: 0.8rem;
      color: #666;
      flex: 1;
    }

    /* Chips that summarise active joins */
    .join-chip {
      display: inline-block;
      background: #e8edf8;
      border-radius: 10px;
      padding: 0.15em 0.55em;
      font-size: 0.75rem;
      color: #2c3e7a;
      margin-left: 0.35em;
    }
    .join-chip-key { color: #888; font-size: 0.7rem; }

    /* "Merge data" button */
    .btn-add-db {
      flex-shrink: 0;
      padding: 0.3rem 0.9rem;
      border: 1px solid #2c3e7a;
      border-radius: 6px;
      background: transparent;
      color: #2c3e7a;
      font-size: 0.85rem;
      cursor: pointer;
      transition: background 0.15s;
    }
    .btn-add-db:hover:not(:disabled) { background: #eef1fb; }
    .btn-add-db:disabled { opacity: 0.4; cursor: default; }

    /* "Hide / Show duplicates" toggle button */
    .btn-dedup {
      flex-shrink: 0;
      padding: 0.3rem 0.9rem;
      border: 1px solid #888;
      border-radius: 6px;
      background: transparent;
      color: #444;
      font-size: 0.85rem;
      cursor: pointer;
      transition: background 0.15s;
    }
    .btn-dedup:hover { background: #f0f0f0; }
    .btn-dedup--active {
      background: #2c3e7a;
      border-color: #2c3e7a;
      color: #fff;
    }
    .btn-dedup--active:hover { background: #3a50a0; }

    /* Row/column selection checkbox column */
    .sel-th, .sel-td {
      width: 2.2rem;
      min-width: 2.2rem;
      padding: 0.4rem 0.5rem;
      text-align: center;
      cursor: default;
      user-select: none;
    }
    .sel-th { background: #2c3e7a; }
    .sel-td { border-bottom: 1px solid #e4e8f0; }
    .sel-th input[type="checkbox"],
    .sel-td input[type="checkbox"] {
      cursor: pointer;
      accent-color: #c0392b;
      width: 1rem;
      height: 1rem;
      vertical-align: middle;
    }

    /* Selected row highlight */
    tbody tr.row-selected > td,
    tbody tr.row-selected > .sel-td {
      background: #fdf0f0 !important;
      outline: 1px solid #e07070;
      outline-offset: -1px;
    }

    /* Selected column highlight — body cells */
    tbody td.col-selected,
    tfoot td.col-selected {
      background: rgba(192, 57, 43, 0.08) !important;
      outline: 1px solid #e07070;
      outline-offset: -1px;
    }

    /* Delete-selected toolbar button — destructive red accent */
    .btn-delete-sel {
      flex-shrink: 0;
      padding: 0.3rem 0.9rem;
      border: 1px solid #c0392b;
      border-radius: 6px;
      background: transparent;
      color: #c0392b;
      font-size: 0.85rem;
      cursor: pointer;
      transition: background 0.15s;
    }
    .btn-delete-sel:hover { background: #fdecea; }

    /* "Combine data" button — same shape as Merge, teal accent */
    .btn-combine {
      flex-shrink: 0;
      padding: 0.3rem 0.9rem;
      border: 1px solid #2a6a5a;
      border-radius: 6px;
      background: transparent;
      color: #1a4a3a;
      font-size: 0.85rem;
      cursor: pointer;
      transition: background 0.15s;
    }
    .btn-combine:hover:not(:disabled) { background: #e6f4f0; }
    .btn-combine:disabled { opacity: 0.4; cursor: default; }

    /* Combine-data panel — teal-tinted background to distinguish from merge */
    .combine-panel {
      background: #f0f8f5;
      border: 1px solid #a8d0c0;
      border-radius: 8px;
      padding: 1.25rem;
      margin-bottom: 1rem;
    }

    .combine-panel-title {
      font-size: 1rem;
      font-weight: 600;
      color: #1a4a3a;
      margin-bottom: 0.6rem;
    }

    .combine-desc-static {
      font-size: 0.85rem;
      color: #2a4a3a;
      margin-bottom: 1rem;
      line-height: 1.45;
    }

    /* Join configuration panel */
    .join-panel {
      background: #f0f3fb;
      border: 1px solid #c8d0e8;
      border-radius: 8px;
      padding: 1.25rem;
      margin-bottom: 1rem;
    }

    .join-panel-title {
      font-size: 1rem;
      font-weight: 600;
      color: #2c3e7a;
      margin-bottom: 1rem;
    }

    .join-fields {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: 0.75rem 1rem;
      align-items: end;
      margin-bottom: 1rem;
    }

    @media (max-width: 680px) {
      .join-fields { grid-template-columns: 1fr; }
      .join-or { display: none; }
    }

    .join-field {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
    }

    .join-field label {
      font-size: 0.8rem;
      font-weight: 600;
      color: #444;
    }

    .join-field select,
    .join-field input[type="text"] {
      padding: 0.4rem 0.6rem;
      border: 1px solid #c0c8e0;
      border-radius: 5px;
      font-size: 0.875rem;
      background: #fff;
      width: 100%;
    }

    .join-or {
      font-size: 0.8rem;
      color: #888;
      text-align: center;
      padding-bottom: 0.4rem;
    }

    .join-desc {
      font-size: 0.85rem;
      color: #1a3a2a;
      background: #e8f5e9;
      border-left: 3px solid #4caf50;
      padding: 0.6rem 0.9rem;
      border-radius: 4px;
      margin-bottom: 1rem;
    }

    .join-actions {
      display: flex;
      gap: 0.75rem;
      justify-content: flex-end;
    }

    .btn-primary, .btn-secondary {
      padding: 0.4rem 1.1rem;
      border-radius: 6px;
      font-size: 0.875rem;
      cursor: pointer;
      border: 1px solid transparent;
      transition: background 0.15s;
    }
    .btn-primary {
      background: #2c3e7a;
      color: #fff;
      border-color: #2c3e7a;
    }
    .btn-primary:hover:not(:disabled) { background: #1a2558; }
    .btn-primary:disabled { opacity: 0.4; cursor: default; }
    .btn-secondary {
      background: transparent;
      color: #555;
      border-color: #bbb;
    }
    .btn-secondary:hover { background: #eee; }

    /* Path-field tooltip
       Usage: wrap <input> in <div class="with-tooltip"> and add a sibling
       <div class="tip-box" role="tooltip"> with the help text inside it.
       Pure CSS -- no JavaScript required. */
    .with-tooltip { position: relative; }
    .tip-box {
      position: absolute;
      top: calc(100% + 7px);
      left: 0;
      right: 0;
      z-index: 200;
      background: #1a2040;
      color: #e8ecf8;
      border: 1px solid #3a50a0;
      border-radius: 6px;
      padding: 0.65rem 0.85rem;
      font-size: 0.78rem;
      line-height: 1.55;
      box-shadow: 0 4px 14px rgba(0,0,0,.28);
      pointer-events: none;
      opacity: 0;
      transform: translateY(-3px);
      transition: opacity 0.13s, transform 0.13s;
      white-space: normal;
    }
    /* Arrow pointing up to the input */
    .tip-box::before {
      content: '';
      position: absolute;
      top: -6px;
      left: 1rem;
      width: 10px;
      height: 10px;
      background: #1a2040;
      border-left: 1px solid #3a50a0;
      border-top: 1px solid #3a50a0;
      transform: rotate(45deg);
    }
    .tip-box code {
      font-family: ui-monospace, 'Cascadia Code', monospace;
      color: #7dd3fc;
      background: rgba(255,255,255,.08);
      padding: .05em .3em;
      border-radius: 3px;
      font-size: .9em;
    }
    .with-tooltip:hover .tip-box,
    .with-tooltip:focus-within .tip-box {
      opacity: 1;
      transform: translateY(0);
    }

    /* Database picker */
    .db-list {
      list-style: none;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 1rem;
    }

    .db-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.4rem;
      padding: 1.25rem 1rem;
      border: 1px solid #dde2f0;
      border-radius: 8px;
      text-decoration: none;
      color: #1a1a2e;
      transition: background 0.15s, box-shadow 0.15s;
    }
    .db-card:hover {
      background: #eef1fb;
      box-shadow: 0 2px 6px rgba(44,62,122,.12);
    }
    .db-card--missing {
      opacity: 0.45;
      filter: grayscale(1);
      cursor: not-allowed;
    }
    .db-card--missing:hover {
      background: transparent;
      box-shadow: none;
    }

    .db-icon { font-size: 2rem; }

    .db-name {
      font-weight: 600;
      font-size: 1rem;
      color: #2c3e7a;
    }

    .db-file {
      font-size: 0.75rem;
      color: #888;
    }

    footer {
      margin-top: 1.5rem;
      font-size: 0.75rem;
      color: #999;
      text-align: right;
    }

    /* Section headings (recently opened, etc.) */
    .recent-section {
      margin-top: 2rem;
    }

    .section-heading {
      font-size: 0.8rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: #888;
      margin-bottom: 0.75rem;
    }

    /* Per-card remove button (trash can) in recent sections */
    .recent-remove {
      position: absolute;
      top: 0.3rem;
      right: 0.3rem;
      background: none;
      border: none;
      cursor: pointer;
      font-size: 0.8rem;
      color: #888;
      opacity: 0;
      padding: 0.15rem 0.3rem;
      border-radius: 4px;
      line-height: 1;
      z-index: 2;
      transition: opacity 0.1s, background 0.1s, color 0.1s;
    }
    .db-list li:hover .recent-remove {
      opacity: 0.5;
    }
    .recent-remove:hover {
      opacity: 1 !important;
      background: rgba(192, 57, 43, 0.12);
      color: #c0392b;
    }

    /* Export button in the toolbar */
    .btn-export-open {
      flex-shrink: 0;
      padding: 0.28rem 0.75rem;
      border: 1px solid #5a7a3a;
      border-radius: 6px;
      background: transparent;
      color: #3a5a1a;
      font-size: 0.82rem;
      white-space: nowrap;
      cursor: pointer;
      transition: background 0.12s;
    }
    .btn-export-open:hover:not(:disabled) { background: #eef5e8; }
    .btn-export-open:disabled { opacity: 0.4; cursor: default; }

    /* Refresh button in the toolbar */
    .btn-refresh {
      flex-shrink: 0;
      padding: 0.28rem 0.75rem;
      border: 1px solid #888;
      border-radius: 6px;
      background: transparent;
      color: #444;
      font-size: 0.82rem;
      white-space: nowrap;
      cursor: pointer;
      transition: background 0.12s;
    }
    .btn-refresh:hover { background: #f0f0f0; }

    /* Graph page layout */
    .graph-title {
      font-size: 1.2rem;
      font-weight: 600;
      color: #1a2a5a;
      margin: 0.75rem 0 0.5rem;
    }
    .graph-export-bar {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.75rem;
    }
    .btn-graph-export {
      padding: 0.28rem 0.75rem;
      border: 1px solid #888;
      border-radius: 6px;
      background: transparent;
      color: #444;
      font-size: 0.82rem;
      cursor: pointer;
      transition: background 0.12s;
    }
    .btn-graph-export:hover { background: #f0f0f0; }
    .graph-container {
      overflow-x: auto;
      text-align: center;
    }
    .graph-container svg { display: block; margin: 0 auto; }

    /* Line-graph button in the toolbar */
    .btn-graph,
    .btn-pie,
    .btn-heatmap,
    .btn-bar {
      flex-shrink: 0;
      padding: 0.28rem 0.75rem;
      border: 1px solid #888;
      border-radius: 6px;
      background: transparent;
      color: #444;
      font-size: 0.82rem;
      white-space: nowrap;
      cursor: pointer;
      transition: background 0.12s;
    }
    .btn-graph:hover,
    .btn-pie:hover,
    .btn-heatmap:hover,
    .btn-bar:hover { background: #f0f0f0; }
    .btn-graph:disabled,
    .btn-pie:disabled,
    .btn-heatmap:disabled,
    .btn-bar:disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }


    /* Graph panel: selects + buttons on one row */
    .graph-fields-row {
      display: flex;
      gap: 0.75rem 1rem;
      align-items: flex-end;
      flex-wrap: wrap;
      margin-bottom: 0.5rem;
    }
    .graph-fields-row .join-field {
      flex: 1;
      min-width: 160px;
    }
    .graph-btn-col {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      flex-shrink: 0;
    }
    .graph-btn-spacer {
      font-size: 0.8rem;
      line-height: 1;
      visibility: hidden;
      display: block;
    }
    .graph-btn-row {
      display: flex;
      gap: 0.5rem;
    }

    /* Export save-to-disc panel */
    .export-panel {
      background: #f5f8f0;
      border: 1px solid #b8d0a0;
      border-radius: 8px;
      padding: 1.25rem;
      margin-bottom: 1rem;
    }

    .export-panel-title {
      font-size: 1rem;
      font-weight: 600;
      color: #2a4a1a;
      margin-bottom: 1rem;
    }

    .export-dir-bar {
      display: flex;
      gap: 0.5rem;
      align-items: center;
      margin-bottom: 0.5rem;
    }

    .export-dir-bar input[type="text"] {
      flex: 1;
      padding: 0.4rem 0.6rem;
      border: 1px solid #b0c8a0;
      border-radius: 5px;
      font-size: 0.875rem;
      background: #fff;
      font-family: monospace;
    }

    .btn-dir-up {
      padding: 0.35rem 0.7rem;
      border: 1px solid #b0c8a0;
      border-radius: 5px;
      background: transparent;
      color: #3a5a1a;
      font-size: 0.82rem;
      cursor: pointer;
      white-space: nowrap;
    }
    .btn-dir-up:hover:not(:disabled) { background: #e4f0d8; }
    .btn-dir-up:disabled { opacity: 0.35; cursor: default; }

    .export-dir-browser {
      max-height: 9rem;
      overflow-y: auto;
      border: 1px solid #c8dab8;
      border-radius: 5px;
      background: #fff;
      padding: 0.35rem;
      margin-bottom: 0.9rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.3rem;
      align-content: flex-start;
    }

    .export-dir-entry {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      padding: 0.25rem 0.6rem;
      border: 1px solid #c8dab8;
      border-radius: 5px;
      background: transparent;
      font-size: 0.8rem;
      color: #2a4a1a;
      cursor: pointer;
      white-space: nowrap;
    }
    .export-dir-entry:hover { background: #e4f0d8; border-color: #8ab87a; }

    .export-dir-msg {
      font-size: 0.8rem;
      color: #888;
      padding: 0.3rem;
    }

    .export-filename-row {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin-bottom: 0.75rem;
      flex-wrap: wrap;
    }

    .export-filename-row label {
      font-size: 0.8rem;
      font-weight: 600;
      color: #444;
      white-space: nowrap;
    }

    .export-filename-row input[type="text"] {
      flex: 1;
      min-width: 12rem;
      padding: 0.4rem 0.6rem;
      border: 1px solid #b0c8a0;
      border-radius: 5px;
      font-size: 0.875rem;
      background: #fff;
      font-family: monospace;
    }

    .export-format-badge {
      font-size: 0.75rem;
      font-weight: 600;
      padding: 0.15em 0.5em;
      border-radius: 4px;
      white-space: nowrap;
    }
    .export-format-badge.csv     { background: #dff5d0; color: #2a5a10; }
    .export-format-badge.sqlite  { background: #d0e8f5; color: #103a5a; }
    .export-format-badge.unknown { background: #f0e8d0; color: #6a4a10; }

    .export-result {
      margin-top: 0.75rem;
      padding: 0.5rem 0.8rem;
      border-radius: 5px;
      font-size: 0.85rem;
      font-family: monospace;
      word-break: break-all;
    }
    .export-result.success {
      background: #e4f5d8;
      border-left: 3px solid #5a9a2a;
      color: #2a5a0a;
    }
    .export-result.error {
      background: #fdecea;
      border-left: 3px solid #c0392b;
      color: #922b21;
    }

    /* Filter section inside the join panel */
    .filter-section {
      margin-top: 1rem;
      padding-top: 0.9rem;
      border-top: 1px solid #d0d8f0;
    }

    .filter-section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.5rem;
    }

    .filter-section-label {
      font-size: 0.78rem;
      font-weight: 600;
      color: #555;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .btn-add-filter {
      padding: 0.18rem 0.65rem;
      border: 1px dashed #2c3e7a;
      border-radius: 5px;
      background: transparent;
      color: #2c3e7a;
      font-size: 0.8rem;
      cursor: pointer;
    }
    .btn-add-filter:hover { background: #eef1fb; }

    .filter-row {
      display: flex;
      gap: 0.45rem;
      align-items: center;
      margin-bottom: 0.4rem;
      flex-wrap: wrap;
    }

    .filter-col-sel  { min-width: 9rem; }
    .filter-op-sel   { min-width: 8rem; }
    .filter-val-inp  { min-width: 9rem; }

    .filter-row select,
    .filter-row input[type="text"] {
      padding: 0.35rem 0.5rem;
      border: 1px solid #c0c8e0;
      border-radius: 5px;
      font-size: 0.85rem;
      background: #fff;
    }

    .btn-remove-filter {
      background: none;
      border: none;
      color: #aaa;
      cursor: pointer;
      font-size: 1rem;
      line-height: 1;
      padding: 0.2rem 0.4rem;
      border-radius: 3px;
    }
    .btn-remove-filter:hover { background: #fde8e8; color: #c00; }

    /* Filter chips in the toolbar */
    .filter-chips {
      display: inline-flex;
      flex-wrap: wrap;
      gap: 0.3rem;
      align-items: center;
    }

    .filter-chip {
      display: inline-block;
      background: #fff8e1;
      border: 1px solid #f0c040;
      border-radius: 10px;
      padding: 0.1em 0.55em;
      font-size: 0.75rem;
      color: #7a5800;
      font-family: monospace;
    }

    .btn-clear-filters {
      font-size: 0.75rem;
      color: #888;
      text-decoration: none;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .btn-clear-filters:hover { color: #c00; text-decoration: underline; }

    .btn-copy-link {
      flex-shrink: 0;
      padding: 0.28rem 0.75rem;
      border: 1px solid #aac;
      border-radius: 6px;
      background: transparent;
      color: #446;
      font-size: 0.82rem;
      white-space: nowrap;
      cursor: pointer;
      transition: background 0.12s, color 0.12s;
    }
    .btn-copy-link:hover { background: #eef; }
    .btn-copy-link--copied { background: #d4edda; color: #155724; border-color: #6aaf80; }

    /* Recently-opened file tooltip */
    .file-tooltip {
      position: absolute;
      bottom: calc(100% + 7px);
      left: 50%;
      transform: translateX(-50%);
      background: #1a1a2e;
      color: #e4e4f0;
      border-radius: 7px;
      padding: 0.65rem 0.8rem;
      font-size: 0.78rem;
      min-width: 230px;
      max-width: min(380px, calc(100vw - 2rem));
      z-index: 200;
      box-shadow: 0 4px 14px rgba(0,0,0,.28);
      pointer-events: none;
      white-space: nowrap;
      line-height: 1.55;
    }
    .file-tooltip::after {
      content: '';
      position: absolute;
      top: 100%;
      left: 50%;
      transform: translateX(-50%);
      border: 6px solid transparent;
      border-top-color: #1a1a2e;
    }
    .file-tooltip.tip-below {
      bottom: auto;
      top: calc(100% + 7px);
    }
    .file-tooltip.tip-below::after {
      top: auto;
      bottom: 100%;
      border-top-color: transparent;
      border-bottom-color: #1a1a2e;
    }
    .tip-name {
      font-weight: 600;
      font-size: 0.85rem;
      border-bottom: 1px solid #3a3a5e;
      margin-bottom: 0.35rem;
      padding-bottom: 0.3rem;
    }
    .tip-path {
      color: #9a9ab8;
      font-family: monospace;
      font-size: 0.75rem;
      white-space: normal;
      word-break: break-all;
      max-width: 340px;
    }
    .tip-muted { color: #6a6a88; font-size: 0.74rem; }

    /* Full-window drop overlay */
    #drop-overlay {
      position: fixed;
      inset: 0;
      z-index: 1000;
      background: rgba(44, 62, 122, .88);
      display: flex;
      align-items: center;
      justify-content: center;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.12s;
    }
    #drop-overlay.active {
      pointer-events: auto;
      opacity: 1;
    }
    #drop-overlay.loading .drop-overlay-box {
      border-style: solid;
      opacity: .7;
    }
    .drop-overlay-box {
      border: 3px dashed rgba(255,255,255,.7);
      border-radius: 16px;
      padding: 3rem 5rem;
      text-align: center;
      color: #fff;
    }
    .drop-overlay-icon { font-size: 3rem; margin-bottom: .5rem; }
    .drop-overlay-text { font-size: 1.5rem; font-weight: 600; }
    .drop-overlay-hint { font-size: .85rem; opacity: .65; margin-top: .4rem; }

    /* Visible drop-zone on the home page */
    .home-drop-zone {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: .75rem;
      border: 2px dashed #d0d8f0;
      border-radius: 8px;
      padding: 1.25rem 1.5rem;
      margin: 1.5rem 0 .5rem;
      color: #aab;
      font-size: .9rem;
      background: #fafbfd;
      transition: border-color .12s, background .12s, color .12s;
      user-select: none;
    }
    .home-drop-zone.drag-active {
      border-color: #2c3e7a;
      background: #eef1fb;
      color: #2c3e7a;
    }
    .home-drop-zone-icon { font-size: 1.4rem; flex-shrink: 0; }
    .home-drop-hint { font-size: .78rem; color: #bbc; }
    .home-drop-zone.drag-active .home-drop-hint { color: #5a7ab8; }

    /* Home-page action cards: Browse + URL import */
    .home-action-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1rem;
      margin-top: 1.5rem;
    }

    .action-card {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      padding: 1.25rem 1.4rem;
      border: 1px solid #d6daf0;
      border-radius: 10px;
      background: #fafbfd;
    }

    .action-card-icon {
      font-size: 1.5rem;
      line-height: 1;
    }

    .action-card-title {
      margin: 0;
      font-size: 1rem;
      font-weight: 600;
      color: #1a2550;
    }

    .action-card-desc {
      margin: 0;
      font-size: 0.85rem;
      color: #666;
      line-height: 1.45;
      flex: 1;
    }

    .btn-action {
      display: inline-block;
      align-self: flex-start;
      margin-top: 0.25rem;
      padding: 0.45rem 1.1rem;
      border: 1px solid #2c3e7a;
      border-radius: 6px;
      color: #2c3e7a;
      text-decoration: none;
      font-size: 0.88rem;
      cursor: pointer;
      background: transparent;
      transition: background 0.15s;
      white-space: nowrap;
    }
    .btn-action:hover { background: #eef1fb; }

    /* URL import form inside card */
    .action-url-form {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      margin-top: 0.25rem;
    }
    .action-url-input {
      width: 100%;
      box-sizing: border-box;
      padding: 0.45rem 0.6rem;
      border: 1px solid #ccc;
      border-radius: 5px;
      font-size: 0.88rem;
    }
    .action-url-row {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }
    /* Cancel the card-level flex-start/margin-top when the button sits in the row */
    .action-url-row .btn-action {
      align-self: auto;
      margin-top: 0;
      box-sizing: border-box;
    }
    .action-idx-label {
      font-size: 0.82rem;
      color: #666;
      white-space: nowrap;
    }
    .action-idx-input {
      width: 3.5rem;
      padding: 0.45rem 0.4rem;
      border: 1px solid #ccc;
      border-radius: 5px;
      font-size: 0.88rem;
      text-align: center;
      box-sizing: border-box;
    }

    /* Filesystem browser */
    .breadcrumb {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.2rem;
      margin-bottom: 1rem;
      font-size: 0.85rem;
      color: #555;
      overflow-x: auto;
    }

    .breadcrumb-link {
      color: #2c3e7a;
      text-decoration: none;
      white-space: nowrap;
    }
    .breadcrumb-link:hover { text-decoration: underline; }

    .breadcrumb-sep { color: #999; }

    .breadcrumb-current {
      font-weight: 600;
      color: #1a1a2e;
      white-space: nowrap;
    }

    .browser-list {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .browser-entry {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.55rem 0.75rem;
      border-radius: 6px;
      text-decoration: none;
      color: #1a1a2e;
      transition: background 0.12s;
    }
    .browser-entry:hover { background: #eef1fb; }

    .browser-dir  { color: #2c3e7a; }
    .browser-file { color: #1a3a2a; }

    .browser-icon { font-size: 1.1rem; flex-shrink: 0; }

    .browser-name {
      font-size: 0.9rem;
      word-break: break-all;
    }
  </style>
</head>
<body>
  <header>
    <h1>[% title | html %]</h1>
  </header>
  <main>
    [% content %]
  </main>
  <footer><a href="https://github.com/nigelhorne/Database-BI" target="_blank">Database::BI</a></footer>

  <!-- Full-window drop overlay: shown whenever files are dragged over the page -->
  <div id="drop-overlay" aria-live="polite">
    <div class="drop-overlay-box">
      <div class="drop-overlay-icon" aria-hidden="true">&#x1F4C2;</div>
      <div class="drop-overlay-text" id="drop-overlay-text">Drop to open database</div>
      <div class="drop-overlay-hint">CSV &middot; TSV &middot; PSV &middot; XML &middot; SQLite</div>
    </div>
  </div>

  <script>
  (function () {
    var overlay   = document.getElementById('drop-overlay');
    var overlayTxt = document.getElementById('drop-overlay-text');
    var homeZone  = document.getElementById('home-drop-zone');
    var dragDepth = 0;
    var errorTimer = null;

    // Max upload size in bytes -- must match $MAX_UPLOAD_MIB in Dashboard.pm
    var MAX_UPLOAD_BYTES = 50 * 1024 * 1024;

    function hasFiles(dt) {
      if (!dt || !dt.types) return false;
      return dt.types.includes
        ? dt.types.includes('Files')
        : Array.prototype.indexOf.call(dt.types, 'Files') !== -1;
    }

    function showOverlay() {
      var label = (typeof window.__biDropLabel === 'function')
        ? window.__biDropLabel() : 'Drop to open database';
      overlayTxt.textContent = label;
      overlay.classList.add('active');
      if (homeZone) homeZone.classList.add('drag-active');
    }

    function hideOverlay() {
      clearTimeout(errorTimer);
      errorTimer = null;
      overlay.classList.remove('active', 'loading');
      if (homeZone) homeZone.classList.remove('drag-active');
    }

    // Show an error in the overlay for 3 seconds, then hide it.
    // Uses a cancellable timer so stale dragleave events cannot dismiss it early.
    function showError(msg) {
      clearTimeout(errorTimer);
      overlay.classList.remove('loading');
      overlayTxt.textContent = msg;
      overlay.classList.add('active');
      errorTimer = setTimeout(hideOverlay, 3000);
    }

    document.addEventListener('dragenter', function (e) {
      if (!hasFiles(e.dataTransfer)) return;
      if (++dragDepth === 1) showOverlay();
    });

    document.addEventListener('dragleave', function (e) {
      if (!hasFiles(e.dataTransfer)) return;
      // Ignore stale dragleave events that fire after a drop while an
      // error message is being displayed (errorTimer is set in that case).
      if (errorTimer) return;
      if (--dragDepth <= 0) { dragDepth = 0; hideOverlay(); }
    });

    document.addEventListener('drop', function () {
      dragDepth = 0;
    });

    overlay.addEventListener('dragover', function (e) {
      e.preventDefault();
      e.dataTransfer.dropEffect = 'copy';
    });

    overlay.addEventListener('drop', function (e) {
      e.preventDefault();
      dragDepth = 0;
      var file = e.dataTransfer.files[0];
      if (!file) { hideOverlay(); return; }

      // When the file comes from a local file manager (Nautilus, Finder, etc.)
      // the DataTransfer includes a file:// URI in text/uri-list.  Stash the
      // decoded local path so the dashboard page can record the original
      // location in bi:recent instead of the temporary .uploads/ copy.
      try {
        var uriList = (e.dataTransfer.getData('text/uri-list') || '').trim();
        var fileUri = uriList.split(/\r?\n/).filter(function (l) {
          return l && l[0] !== '#' && l.indexOf('file://') === 0;
        })[0];
        if (fileUri) {
          sessionStorage.setItem('bi:pending-original-path',
            decodeURIComponent(fileUri.replace(/^file:\/\//, '')));
        } else {
          sessionStorage.removeItem('bi:pending-original-path');
        }
      } catch (ex) {
        try { sessionStorage.removeItem('bi:pending-original-path'); } catch (ex2) {}
      }

      overlay.classList.add('loading');
      overlayTxt.textContent = 'Opening…';

      var fd = new FormData();
      fd.append('file', file);
      // Capture size before fetch so the catch handler can use it even when
      // the server closes the connection before sending a response (TypeError).
      var fileSize = file.size;

      fetch('/upload', { method: 'POST', body: fd })
        .then(function (r) {
          if (!r.ok) {
            // Try to extract the server's JSON error message.  If the response
            // is not JSON (e.g. a proxy returned an HTML 413 page), the parse
            // fails -- fall back to a human-readable message based on the HTTP
            // status so the user sees something more useful than "Could not
            // open file."
            return r.json().then(function (d) {
              return Promise.reject(d.error || ('HTTP ' + r.status));
            }, function () {
              var msg = r.status === 413
                ? 'File too large to upload (limit: 50 MB)'
                : 'Upload failed (HTTP ' + r.status + ')';
              return Promise.reject(msg);
            });
          }
          return r.json();
        })
        .then(function (data) {
          hideOverlay();
          if (typeof window.__biDropCallback === 'function') {
            window.__biDropCallback(data);
          } else if (data.url) {
            window.location = data.url;
          }
        })
        .catch(function (err) {
          // err is a string when we rejected with a message above.
          // When fetch itself fails (e.g. the server closed the TCP connection
          // mid-upload because the body was too large), err is a TypeError and
          // r.status is never available.  Detect that case via the captured
          // fileSize and show a useful message instead of the generic fallback.
          var msg;
          if (typeof err === 'string') {
            msg = err;
          } else if (fileSize > MAX_UPLOAD_BYTES) {
            msg = 'File too large to upload (limit: 50 MB)';
          } else {
            msg = 'Could not open file.';
          }
          showError(msg);
        });
    });
  }());
  </script>
</body>
</html>
