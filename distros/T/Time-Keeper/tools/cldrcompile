#!/usr/bin/env perl
use 5.014;
use strict;
use warnings;

# cldrcompile - compile CLDR's Gregorian calendar data, zone names, locale
# names, relative-time and duration words, list patterns, interval formats,
# weekend days and plural rules for every locale into what Time::Keeper ships:
#
#   share/locales.tkd               one archive, a section per locale, read on demand
#   include/tk/tk_locale_en.h       English's section as bytes, compiled in
#   include/tk/tk_locale_table.h    the codes, aliases, names, and the zone and
#                                   metazone tables every locale shares
#   include/tk/tk_plural.h          the plural rules, one C function a rule set
#
#   tools/cldrcompile --cldr DIR --tzdata tzdata.tar.gz --cldr-version 48.2.3
#
# DIR holds the unpacked cldr-json packages cldr-core, cldr-dates-full,
# cldr-localenames-full, cldr-numbers-full, cldr-units-full, cldr-misc-full
# and cldr-bcp47. cldr-json's data
# is already resolved (each locale has what it inherits); a section is
# written as its differences from its parent only to keep the file small.
#
# Author side only: the three outputs are committed to the dist.
#
# The archive: "TKD1", the number of sections, a stamp the build checks,
# the CLDR version in 16 bytes, 4 spare, then each section's offset and
# length, then the sections. A section holds only what differs from its CLDR
# parent (fr-CA from fr), which is read first; one with no parent holds all.
# All integers are little-endian u16, strings are offsets into the pool at
# its end in units of two bytes (each pool string is NUL-terminated and padded
# to an even length, so the pool may reach 128 KB; ff-Adlm passed 64 KB with
# the weekday words); a string offset 0xFFFF means "the parent's", 0xFFFE "none":
#
#   "TKL4" parent nfixed nskel nzone nmeta nterr nrule first_day min_days hc24 ascii
#          nwords nival weekend_start weekend_end plural
#   fixed[nfixed]                      the slots of tk_locale_strings, in order; nfixed
#                                      0xFFFF is all the parent's, with no table
#   skel[nskel]   key pattern          sorted by key; no pattern removes the parent's
#   zone[nzone]   index s[7]           index into tk_cldr_zones; sorted
#   meta[nmeta]   index s[6]           index into tk_metazones; sorted
#   terr[nterr]   index name           index into tk_territories; sorted
#   rule[nrule]   period from before   minutes; from == before is "at"; nrule
#                                      0xFFFF is the parent's rules
#   words[nwords]                      the slots of tk_locale_words, in order: the
#                                      relative-time fields (the eight units, then the
#                                      seven weekdays, since TKL4), the duration units,
#                                      the list patterns, the interval fallback; nwords
#                                      0xFFFF is all the parent's, with no table
#   ival[nival]   key letter pattern   interval formats, sorted by key then letter;
#                                      no pattern removes the parent's
#   pool
#
# plural is an index into tk_plural_rules in tk_plural.h, the locale's
# cardinal rules for a whole number (the operands v, w, f, t, e and c are 0).

use Getopt::Long;
use JSON::PP;
use File::Temp qw(tempdir);

my %opt = (out => '.');
GetOptions(\%opt, 'cldr=s', 'tzdata=s', 'cldr-version=s', 'out=s') or die "bad options\n";
for (qw(cldr tzdata cldr-version)) { die "--$_ is required\n" unless $opt{$_} }
my $C = $opt{cldr};

my $json = JSON::PP->new->utf8;
sub slurp { my ($f) = @_; open my $fh, '<:raw', $f or die "$f: $!\n"; local $/; scalar <$fh> }
sub jfile { $json->decode(slurp($_[0])) }
sub jmaybe { -e $_[0] ? jfile($_[0]) : {} }

my $supp = "$C/cldr-core/supplemental";
my @full     = @{ jfile("$C/cldr-core/availableLocales.json")->{availableLocales}{full} };
my @default  = @{ jfile("$C/cldr-core/defaultContent.json")->{defaultContent} };
my $likely   = jfile("$supp/likelySubtags.json")->{supplemental}{likelySubtags};
my $week     = jfile("$supp/weekData.json")->{supplemental}{weekData};
my $rulesets = jfile("$supp/dayPeriods.json")->{supplemental}{dayPeriodRuleSet};
my $mzdata   = jfile("$supp/metaZones.json")->{supplemental}{metaZones};
my $numsys   = jfile("$supp/numberingSystems.json")->{supplemental}{numberingSystems};
my $aliases  = jfile("$supp/aliases.json")->{supplemental}{metadata}{alias}{languageAlias};
my $primary  = jfile("$supp/primaryZones.json")->{supplemental}{primaryZones};
my $bcp47    = jfile("$C/cldr-bcp47/bcp47/timezone.json")->{keyword}{u}{tz};
my $parents  = jfile("$supp/parentLocales.json")->{supplemental}{parentLocales}{parentLocale};
my $plurals  = jfile("$supp/plurals.json")->{supplemental}{'plurals-type-cardinal'};

my %full = map { $_ => 1 } @full;

# ---- the codes ------------------------------------------------------------
# Every locale cldr-json has, and every default-content code (fr-FR is fr's
# data under its own name), as DateTime::Locale lists them. English is id 0.

my %blob_of;
my @codes = ('en', sort grep { $_ ne 'en' } @full);
for my $d (@default) {
    next if $full{$d};
    my $parent = $d;
    $parent =~ s/-[^-]+\z// while $parent =~ /-/ && !$full{$parent};
    die "default content $d: no parent among the locales\n" unless $full{$parent} && $parent ne $d;
    $blob_of{$d} = $parent;
}
push @codes, sort keys %blob_of;
my %code_id;
$code_id{ $codes[$_] } = $_ for 0 .. $#codes;

# ---- zones -----------------------------------------------------------------
# IANA names (any that Zone may hand back) to CLDR's canonical name, its
# short BCP 47 id and its country.

my (%cldr_of, %short_of, %iana_of);
for my $k (sort keys %$bcp47) {
    next if $k =~ /^_/;
    my $e = $bcp47->{$k};
    next unless ref $e && $e->{_alias};
    my @names = split ' ', $e->{_alias};
    for my $n (@names, ($e->{_iana} // ())) {
        $cldr_of{$n} //= $names[0];
    }
    $short_of{ $names[0] } = $k;
    $iana_of{ $names[0] } = $e->{_iana} // $names[0];
}

my $tmp = tempdir(CLEANUP => 1);
system('tar', 'xzf', $opt{tzdata}, '-C', $tmp, 'zone.tab') == 0 or die "tar: zone.tab\n";
my (%zone_country, %zones_in);
open my $zt, '<', "$tmp/zone.tab" or die "zone.tab: $!\n";
while (<$zt>) {
    next if /^#/;
    chomp;
    my ($cc, undef, $tz) = split /\t/;
    next unless $tz;
    my $key = $cldr_of{$tz} // $tz;
    $zone_country{$key} = $cc;
    $zones_in{$cc}++;
}
close $zt;
my %primary_zone = map { ($cldr_of{ $primary->{$_} } // $primary->{$_}) => $_ } keys %$primary;

# Metazones over time: CLDR name to [metazone, from, to].
sub utc_of {
    my ($s) = @_;
    return undef unless defined $s;
    my ($y, $m, $d, $H, $M) = $s =~ /^(\d+)-(\d+)-(\d+) (\d+):(\d+)\z/ or die "metazone date '$s'\n";
    my $yy = $y - ($m <= 2);
    my $era = int(($yy >= 0 ? $yy : $yy - 399) / 400);
    my $yoe = $yy - $era * 400;
    my $doy = int((153 * ($m + ($m > 2 ? -3 : 9)) + 2) / 5) + $d - 1;
    my $doe = $yoe * 365 + int($yoe / 4) - int($yoe / 100) + $doy;
    return (($era * 146097 + $doe - 719468) * 86400) + $H * 3600 + $M * 60;
}
my (%mz_periods, %mz_seen);
my $walk;
$walk = sub {
    my ($h, $path) = @_;
    if (ref $h eq 'ARRAY') {
        for my $u (@$h) {
            my $m = $u->{usesMetazone} or next;
            push @{ $mz_periods{$path} }, [ $m->{_mzone}, utc_of($m->{_from}), utc_of($m->{_to}) ];
            $mz_seen{ $m->{_mzone} } = 1;
        }
        return;
    }
    $walk->($h->{$_}, $path eq '' ? $_ : "$path/$_") for sort keys %$h;
};
$walk->($mzdata->{metazoneInfo}{timezone}, '');

my @cldr_zones = do {
    my %k = map { $_ => 1 } values %cldr_of, keys %mz_periods, keys %zone_country;
    sort keys %k;
};
my %cldr_zone_id;
$cldr_zone_id{ $cldr_zones[$_] } = $_ for 0 .. $#cldr_zones;
my @metazones = sort keys %mz_seen;
my %mz_id;
$mz_id{ $metazones[$_] } = $_ for 0 .. $#metazones;
my @territories = do { my %t = map { $_ => 1 } values %zone_country; sort keys %t };
my %terr_id;
$terr_id{ $territories[$_] } = $_ for 0 .. $#territories;

# ---- one locale's section -------------------------------------------------

my @ctx = ('format', 'stand-alone');
my @wid = ('wide', 'abbreviated', 'narrow');
my @days = qw(mon tue wed thu fri sat sun);
my @periods = qw(am pm midnight noon morning1 morning2 afternoon1 afternoon2 evening1 evening2 night1 night2);
my %period_no = map { $periods[$_] => $_ } 0 .. $#periods;
my @zone_formats = qw(hourFormat gmtFormat gmtZeroFormat regionFormat regionFormat-type-daylight
                      regionFormat-type-standard fallbackFormat);
my %dayno = (mon => 1, tue => 2, wed => 3, thu => 4, fri => 5, sat => 6, sun => 7);
my $NONE = 0xFFFFFFFF;

sub territory_of {
    my ($code) = @_;
    my @t = split /-/, $code;
    for (@t[1 .. $#t]) { return $_ if /^(?:[A-Z]{2}|\d{3})\z/ }
    my $l = $likely->{$code} // $likely->{ $t[0] } // $likely->{und};
    my ($r) = grep { /^(?:[A-Z]{2}|\d{3})\z/ } split /-/, $l;
    return $r // '001';
}

sub rules_for {
    my ($code) = @_;
    my @t = split /-/, $code;
    while (@t) {
        my $k = join '-', @t;
        return $rulesets->{$k} if $rulesets->{$k};
        pop @t;
    }
    return undef;
}

sub minutes { my ($s) = @_; my ($h, $m) = split /:/, $s; $h * 60 + $m }

# ---- words: relative time, durations, lists, intervals, plurals -------------

my @rel_fields = qw(year quarter month week day hour minute second mon tue wed thu fri sat sun);
my @rel_widths = ('', '-short', '-narrow');
my @categories = qw(zero one two few many other);
my @dur_units = qw(year month week day hour minute second millisecond microsecond nanosecond);
my @list_types = qw(standard unit unit-short unit-narrow);
my @list_slots = qw(start middle end 2);

# The words of a locale, in the order of tk_locale_words: for each relative
# field (the eight units, then mon to sun, which have no display name and no
# -2 or 2) and width the display name, the five relative-type strings (-2 to 2),
# then the future and the past pattern for each plural category; for each
# duration unit and width the display name and the six count patterns; the
# three digital duration patterns; the four list patterns' four slots; the
# interval fallback. Then the interval formats by skeleton and letter.
sub words_of {
    my ($code, $g) = @_;
    my $df = jfile("$C/cldr-dates-full/main/$code/dateFields.json")->{main}{$code}{dates}{fields};
    my $un = jfile("$C/cldr-units-full/main/$code/units.json")->{main}{$code}{units};
    my $lp = jfile("$C/cldr-misc-full/main/$code/listPatterns.json")->{main}{$code}{listPatterns};
    my @w;
    for my $f (@rel_fields) {
        for my $wd (@rel_widths) {
            my $e = $df->{"$f$wd"} // {};
            push @w, $e->{displayName};
            push @w, map { $e->{"relative-type-$_"} } -2 .. 2;
            push @w, map { $e->{'relativeTime-type-future'}{"relativeTimePattern-count-$_"} } @categories;
            push @w, map { $e->{'relativeTime-type-past'}{"relativeTimePattern-count-$_"} } @categories;
        }
    }
    for my $u (@dur_units) {
        for my $wd (qw(long short narrow)) {
            my $e = $un->{$wd}{"duration-$u"} // {};
            push @w, $e->{displayName};
            push @w, map { $e->{"unitPattern-count-$_"} } @categories;
        }
    }
    push @w, map { $un->{"durationUnit-type-$_"}{durationUnitPattern} } qw(hm hms ms);
    for my $t (@list_types) {
        my $e = $lp->{"listPattern-type-$t"} // {};
        push @w, map { $e->{$_} } @list_slots;
    }
    my $iv = $g->{dateTimeFormats}{intervalFormats} // {};
    push @w, $iv->{intervalFormatFallback};
    my %ival;
    for my $k (keys %$iv) {
        next if $k eq 'intervalFormatFallback' || !ref $iv->{$k};
        for my $letter (keys %{ $iv->{$k} }) {
            next unless length($letter) == 1 && !ref $iv->{$k}{$letter};
            $ival{"$k\0$letter"} = $iv->{$k}{$letter};
        }
    }
    return (\@w, \%ival);
}

# The plural rule set of a locale: its own code, then shorter ones, then root.
sub plural_key_of {
    my ($code) = @_;
    my @t = split /-/, $code;
    while (@t) {
        my $k = join '-', @t;
        return $k if $plurals->{$k};
        pop @t;
    }
    return 'root';
}

# A rule set as C: the condition of each category in order, zero to many, for
# a whole number n: i is n, and v, w, f, t, e and c are 0.
sub plural_c {
    my ($set) = @_;
    my @lines;
    for my $ci (0 .. 4) {
        my $rule = $set->{"pluralRule-count-$categories[$ci]"} // next;
        $rule =~ s/\s*\@.*//s;
        $rule =~ s/^\s+|\s+$//g;
        next if $rule eq '';
        my @ors;
        for my $or (split /\s+or\s+/, $rule) {
            my @ands;
            for my $rel (split /\s+and\s+/, $or) {
                my ($lhs, $op, $rhs) = $rel =~ /^(.+?)\s*(!=|=)\s*(.+)$/ or die "plural relation '$rel'\n";
                my ($operand, $mod) = $lhs =~ /^([nivwftce])(?:\s*%\s*(\d+))?$/ or die "plural operand '$lhs'\n";
                my $expr = $operand =~ /^[ni]$/ ? (defined $mod ? "(n % $mod)" : "n") : "0";
                my @parts;
                for my $range (split /\s*,\s*/, $rhs) {
                    if ($range =~ /^(\d+)\.\.(\d+)$/) { push @parts, "($expr >= $1 && $expr <= $2)" }
                    elsif ($range =~ /^(\d+)$/) { push @parts, "$expr == $1" }
                    else { die "plural range '$range'\n" }
                }
                my $c = @parts > 1 ? '(' . join(' || ', @parts) . ')' : $parts[0];
                push @ands, $op eq '=' ? $c : "!($c)";
            }
            push @ors, @ands > 1 ? '(' . join(' && ', @ands) . ')' : $ands[0];
        }
        push @lines, "    if (" . join(' || ', @ors) . ") return $ci;";
    }
    return join("\n", @lines);
}

my (@plural_bodies, %plural_index);
sub plural_index_of {
    my ($code) = @_;
    my $key = plural_key_of($code);
    return $plural_index{$key} if exists $plural_index{$key};
    my $body = $key eq 'root' ? '' : plural_c($plurals->{$key});
    my ($i) = grep { $plural_bodies[$_] eq $body } 0 .. $#plural_bodies;
    unless (defined $i) { push @plural_bodies, $body; $i = $#plural_bodies }
    return $plural_index{$key} = $i;
}

sub record {
    my ($code) = @_;
    state %memo;
    return $memo{$code} if $memo{$code};
    my $g = jfile("$C/cldr-dates-full/main/$code/ca-gregorian.json")->{main}{$code}{dates}{calendars}{gregorian}
        or die "$code: no Gregorian calendar\n";
    my $tzn = jfile("$C/cldr-dates-full/main/$code/timeZoneNames.json")->{main}{$code}{dates}{timeZoneNames};
    my $num = jfile("$C/cldr-numbers-full/main/$code/numbers.json")->{main}{$code}{numbers};
    my $terr_names = jmaybe("$C/cldr-localenames-full/main/$code/territories.json")
        ->{main}{$code}{localeDisplayNames}{territories};
    my $need = sub { my ($v, $what) = @_; die "$code: no $what\n" unless defined $v; $v };
    my %r;

    my @fixed;
    for my $what (['months', [1 .. 12], \@wid], ['days', \@days, [@wid, 'short']], ['quarters', [1 .. 4], \@wid]) {
        my ($key, $order, $widths) = @$what;
        for my $c (@ctx) {
            for my $w (@$widths) {
                my $set = $need->($g->{$key}{$c}{$w}, "$key $c $w");
                push @fixed, map { $need->($set->{$_}, "$key $c $w $_") } @$order;
            }
        }
    }
    my %era_key = (wide => 'eraNames', abbreviated => 'eraAbbr', narrow => 'eraNarrow');
    for my $w (@wid) {
        my $e = $need->($g->{eras}{ $era_key{$w} }, "eras $w");
        push @fixed, $need->($e->{0}, 'era 0'), $need->($e->{1}, 'era 1');
    }
    for my $w (@wid) {
        my $d = $need->($g->{dayPeriods}{format}{$w}, "dayPeriods $w");
        push @fixed, map { $_ < 2 ? $need->($d->{ $periods[$_] }, $periods[$_]) : $d->{ $periods[$_] } } 0 .. $#periods;
    }
    for my $k (qw(dateFormats timeFormats dateTimeFormats)) {
        for my $len (qw(full long medium short)) {
            my $v = $g->{$k}{$len};
            $v = $v->{_value} // $v->{standard} if ref $v;
            push @fixed, $need->($v, "$k $len");
        }
    }
    push @fixed, map { $need->($tzn->{$_}, $_) } @zone_formats;
    my $ns = $num->{defaultNumberingSystem} // 'latn';
    my @d = split //, $need->($numsys->{$ns}{_digits}, "the digits of $ns");
    die "$code: $ns has ", scalar(@d), " digits\n" unless @d == 10;
    push @fixed, @d;
    $r{fixed} = \@fixed;

    my $avail = $need->($g->{dateTimeFormats}{availableFormats}, 'availableFormats');
    $r{skel} = { map { $_ => $avail->{$_} } grep { !ref $avail->{$_} } keys %$avail };

    my %zones;
    my $zw;
    $zw = sub {
        my ($h, $path) = @_;
        if (exists $h->{exemplarCity} || exists $h->{long} || exists $h->{short} || exists $h->{_type}) {
            my $id = $cldr_zone_id{$path};
            return unless defined $id;
            my @s = map { my $len = $_; map { $h->{$len}{$_} } qw(generic standard daylight) } qw(long short);
            (my $city = (split m{/}, $path)[-1]) =~ tr/_/ /;
            my $ex = $h->{exemplarCity};
            $ex = undef if defined $ex && $ex eq $city;
            return unless defined $ex || grep { defined } @s;
            $zones{$id} = [ @s, $ex ];
            return;
        }
        for my $k (sort keys %$h) {
            next unless ref $h->{$k} eq 'HASH';
            $zw->($h->{$k}, $path eq '' ? $k : "$path/$k");
        }
    };
    $zw->($tzn->{zone} // {}, '');
    $r{zone} = \%zones;

    my %metas;
    for my $m (keys %{ $tzn->{metazone} // {} }) {
        my $id = $mz_id{$m};
        next unless defined $id;
        my $h = $tzn->{metazone}{$m};
        my @s = map { my $len = $_; map { $h->{$len}{$_} } qw(generic standard daylight) } qw(long short);
        $metas{$id} = \@s if grep { defined } @s;
    }
    $r{meta} = \%metas;
    $r{terr} = { map { $terr_id{$_} => $terr_names->{$_} } grep { defined $terr_names->{$_} } @territories };

    my @rules;
    if (my $rs = rules_for($code)) {
        for my $p (sort keys %$rs) {
            next unless exists $period_no{$p};
            my $x = $rs->{$p};
            push @rules, defined $x->{_at}
                ? [ $period_no{$p}, minutes($x->{_at}), minutes($x->{_at}) ]
                : [ $period_no{$p}, minutes($x->{_from}), minutes($x->{_before}) ];
        }
        @rules = sort { $a->[1] <=> $b->[1] || $a->[0] <=> $b->[0] } @rules;
    }
    $r{rules} = \@rules;

    ($r{words}, $r{ival}) = words_of($code, $g);
    my $territory = territory_of($code);
    my $first = $week->{firstDay}{$territory} // $week->{firstDay}{'001'};
    my $min = $week->{minDays}{$territory} // $week->{minDays}{'001'};
    my $wstart = $week->{weekendStart}{$territory} // $week->{weekendStart}{'001'};
    my $wend = $week->{weekendEnd}{$territory} // $week->{weekendEnd}{'001'};
    my $short_time = $g->{timeFormats}{short};
    $short_time = $short_time->{_value} if ref $short_time;
    (my $letters = $short_time) =~ s/'[^']*'//g;
    $r{head} = [ $dayno{$first}, $min, ($letters =~ /[Hk]/ ? 1 : 0), ($ns eq 'latn' ? 1 : 0) ];
    $r{tail} = [ $dayno{$wstart}, $dayno{$wend}, plural_index_of($code) ];
    return $memo{$code} = \%r;
}

# The locale whose data a locale's section is written against, or undef.
sub parent_of {
    my ($code) = @_;
    my $p = $parents->{$code};
    unless ($p) {
        return undef unless $code =~ /-/;
        ($p = $code) =~ s/-[^-]+\z//;
    }
    return $full{$p} && $p ne 'root' ? $p : undef;
}

sub same { my ($x, $y) = @_; (defined $x ? $x : "\x{FFFF}") eq (defined $y ? $y : "\x{FFFF}") }
sub same_list { my ($x, $y) = @_; return 0 unless $y && @$x == @$y; same($x->[$_], $y->[$_]) || return 0 for 0 .. $#$x; 1 }

sub section {
    my ($code) = @_;
    my $r = record($code);
    my $pc = parent_of($code);
    my $p = $pc ? record($pc) : undef;
    my (@pool, %at);
    my $pool_len = 0;
    my $str = sub {
        my ($s) = @_;
        return 0xFFFE unless defined $s;
        my $b = $s;
        utf8::encode($b);
        unless (exists $at{$b}) {
            my $e = $b . "\0" . (length($b) % 2 ? '' : "\0");
            push @pool, $e;
            $at{$b} = $pool_len / 2;
            $pool_len += length $e;
        }
        die "$code: the pool is over 128 KB\n" if $at{$b} >= 0xFFFE;
        return $at{$b};
    };
    my @fixed = map { $p && same($r->{fixed}[$_], $p->{fixed}[$_]) ? 0xFFFF : $str->($r->{fixed}[$_]) } 0 .. $#{ $r->{fixed} };
    my (@skel, @zones, @metas, @terrs);
    for my $k (sort keys %{ { %{ $r->{skel} }, $p ? %{ $p->{skel} } : () } }) {
        next if $p && same($r->{skel}{$k}, $p->{skel}{$k});
        push @skel, [ $str->($k), $str->($r->{skel}{$k}) ];
    }
    for my $w ([ zone => \@zones, 7 ], [ meta => \@metas, 6 ]) {
        my ($what, $list, $n) = @$w;
        for my $k (sort { $a <=> $b } keys %{ { %{ $r->{$what} }, $p ? %{ $p->{$what} } : () } }) {
            my $mine = $r->{$what}{$k} // [ (undef) x $n ];
            next if $p && same_list($mine, $p->{$what}{$k} // [ (undef) x $n ]);
            push @$list, [ $k, map { $str->($_) } @$mine ];
        }
    }
    for my $k (sort { $a <=> $b } keys %{ { %{ $r->{terr} }, $p ? %{ $p->{terr} } : () } }) {
        next if $p && same($r->{terr}{$k}, $p->{terr}{$k});
        push @terrs, [ $k, $str->($r->{terr}{$k}) ];
    }
    my $inherit_rules = $p && join(',', map { @$_ } @{ $r->{rules} }) eq join(',', map { @$_ } @{ $p->{rules} });
    my @rules = $inherit_rules ? () : @{ $r->{rules} };
    my @words = map { $p && same($r->{words}[$_], $p->{words}[$_]) ? 0xFFFF : $str->($r->{words}[$_]) } 0 .. $#{ $r->{words} };
    my @ival;
    for my $k (sort keys %{ { %{ $r->{ival} }, $p ? %{ $p->{ival} } : () } }) {
        next if $p && same($r->{ival}{$k}, $p->{ival}{$k});
        my ($skel, $letter) = split /\0/, $k;
        push @ival, [ $str->($skel), ord($letter), $str->($r->{ival}{$k}) ];
    }
    my $inherit_fixed = $p && !grep { $_ != 0xFFFF } @fixed;
    my $inherit_words = $p && !grep { $_ != 0xFFFF } @words;
    @fixed = () if $inherit_fixed;
    @words = () if $inherit_words;
    my @head = (($pc ? $code_id{$pc} : 0xFFFF), ($inherit_fixed ? 0xFFFF : scalar(@fixed)), scalar(@skel), scalar(@zones), scalar(@metas),
                scalar(@terrs), ($inherit_rules ? 0xFFFF : scalar(@rules)), @{ $r->{head} },
                ($inherit_words ? 0xFFFF : scalar(@words)), scalar(@ival), @{ $r->{tail} });
    return 'TKL4' . pack('v*', @head, @fixed, map({ @$_ } @skel, @zones, @metas, @terrs, @rules), @words, map({ @$_ } @ival)) . join('', @pool);

}

# ---- names ----------------------------------------------------------------
# A locale's name in a locale, as CLDR's display pattern makes it: the
# language, then the script, territory and variants in brackets.

sub display_name {
    my ($code, $in) = @_;
    my $dir = "$C/cldr-localenames-full/main/$in";
    state %cache;
    my $n = $cache{$in} //= {
        map { $_ => (jmaybe("$dir/$_.json")->{main}{$in}{localeDisplayNames} // {}) }
            qw(languages scripts territories variants localeDisplayNames)
    };
    my $pat = $n->{localeDisplayNames}{localeDisplayPattern} // { localePattern => "{0} ({1})", localeSeparator => "{0}, {1}" };
    my @t = split /-/, $code;
    my $lang = $n->{languages}{languages}{ $t[0] } // $t[0];
    my @rest;
    for my $s (@t[1 .. $#t]) {
        if ($s =~ /^[A-Z][a-z]{3}\z/) { push @rest, $n->{scripts}{scripts}{$s} // $s }
        elsif ($s =~ /^(?:[A-Z]{2}|\d{3})\z/) { push @rest, $n->{territories}{territories}{$s} // $s }
        else { push @rest, $n->{variants}{variants}{ uc $s } // $s }
    }
    return $lang unless @rest;
    my $inner = shift @rest;
    for (@rest) { (my $j = $pat->{localeSeparator}) =~ s/\{0\}/$inner/; $j =~ s/\{1\}/$_/; $inner = $j }
    (my $out = $pat->{localePattern}) =~ s/\{0\}/$lang/;
    $out =~ s/\{1\}/$inner/;
    return $out;
}

# A code's subtags, and the name of each in a locale (undef where none).
sub parts {
    my ($code, $in) = @_;
    my $dir = "$C/cldr-localenames-full/main/$in";
    state %pc;
    my $nm = $pc{$in} //= {
        map { $_ => (jmaybe("$dir/$_.json")->{main}{$in}{localeDisplayNames} // {}) } qw(languages scripts territories variants)
    };
    my @t = split /-/, $code;
    my ($lang, $script, $terr, @var) = (shift @t);
    for (@t) {
        if (/^[A-Z][a-z]{3}\z/) { $script = $_ }
        elsif (/^(?:[A-Z]{2}|\d{3})\z/) { $terr = $_ }
        else { push @var, $_ }
    }
    my $var = @var ? join('-', @var) : undef;
    return ($lang, $script, $terr, $var,
            $nm->{languages}{languages}{$lang} // $lang,
            defined $script ? $nm->{scripts}{scripts}{$script} // $script : undef,
            defined $terr ? $nm->{territories}{territories}{$terr} // $terr : undef,
            defined $var ? $nm->{variants}{variants}{ uc $var } // $var : undef);
}

# ---- write ----------------------------------------------------------------

sub c_str {
    my ($s) = @_;
    return 'NULL' unless defined $s;
    my $bytes = $s;
    utf8::encode($bytes);
    $bytes =~ s/([\\"])/\\$1/g;
    $bytes =~ s/([^\x20-\x7e])/sprintf '\\%03o', ord $1/ge;
    $bytes =~ s/\?\?/?\\?/g;
    return qq{"$bytes"};
}

sub fnv { my $h = 0x811c9dc5; for (unpack 'C*', $_[0]) { $h ^= $_; $h = ($h * 0x01000193) & 0xFFFFFFFF } $h }

my (@blobs, %blob_no, @blob_index);
for my $code (@codes) {
    my $src = $blob_of{$code} // $code;
    unless (exists $blob_no{$src}) {
        my $b = section($src);
        $blob_no{$src} = scalar @blobs;
        push @blobs, $b;
    }
    push @blob_index, $blob_no{$src};
}

my $index_len = 32 + 8 * @blobs;
my ($at, $index, $body) = ($index_len, '', '');
for my $b (@blobs) {
    $index .= pack 'VV', $at, length $b;
    $at += length $b;
    $body .= $b;
}
my $stamp = fnv($index . $body);
my $vers = $opt{'cldr-version'};
die "the CLDR version is too long\n" if length $vers > 15;
my $archive = 'TKD1' . pack('VV', scalar(@blobs), $stamp) . pack('a16', $vers) . pack('V', 0) . $index . $body;

mkdir "$opt{out}/share";
open my $out, '>:raw', "$opt{out}/share/locales.tkd" or die "locales.tkd: $!\n";
print $out $archive;
close $out;

