# Copy to .env next to docker-compose.yml and fill in the secrets; .env is never committed.
#   PG_PASS:                      openssl rand -hex 24
#   AUTHENTIK_SECRET_KEY:         openssl rand -base64 60 | tr -d '\n'
#   AUTHENTIK_BOOTSTRAP_PASSWORD: openssl rand -hex 20
#   AUTHENTIK_BOOTSTRAP_TOKEN:    openssl rand -hex 32   (this is AUTHENTIK_TOKEN for the live tests)
AUTHENTIK_TAG=2026.8.3
AUTHENTIK_PORT=9000
PG_PASS=
AUTHENTIK_SECRET_KEY=
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_TOKEN=
AUTHENTIK_BOOTSTRAP_EMAIL=akadmin@example.org
