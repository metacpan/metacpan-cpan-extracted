+// Stops every exit transition, for a frame whose exiting elements cannot be kept: an exiting element disappears, and
+// the others no longer point at an element of this frame. Nothing is left in the clone region at the top of
+// layoutElements.
+void Clay__DropExitTransitions(void) {
+    Clay_Context* context = Clay_GetCurrentContext();
+    for (int32_t i = 0; i < context->transitionDatas.length; ++i) {
+        Clay__TransitionDataInternal *data = Clay__TransitionDataInternalArray_Get(&context->transitionDatas, i);
+        if (data->state == CLAY_TRANSITION_STATE_EXITING) {
+            Clay__TransitionDataInternalArray_RemoveSwapback(&context->transitionDatas, i);
+            i--;
+            continue;
+        }
+        data->transitionOut = false;
+    }
+    context->exitingElementsLength = 0;
+    context->exitingElementsChildrenLength = 0;
+}
+
+// Reports that the exiting elements and this frame's elements do not fit into the element count together, and
+// handles the frame like one over the cap.
+void Clay__ReportExitingElementsCapacityExceeded(void) {
+    Clay_Context* context = Clay_GetCurrentContext();
+    context->errorHandler.errorHandlerFunction(CLAY__INIT(Clay_ErrorData) {
+            .errorType = CLAY_ERROR_TYPE_ELEMENTS_CAPACITY_EXCEEDED,
+            .errorText = CLAY_STRING("Clay ran out of capacity while keeping elements with exit transitions; their exit transitions were dropped. Try using Clay_SetMaxElementCount() with a higher value."),
+            .userData = context->errorHandler.userData });
+    context->booleanWarnings.maxElementsExceeded = true;
+}
+
+// Clay_EndLayout copies the subtrees of the elements that exit this frame from the clone region (the top
+// exitingElementsLength slots of layoutElements and exitingElementsChildrenLength slots of layoutElementChildren, see
+// Clay__CloneElementsWithExitTransition) to the end of this frame's elements. At most every clone is copied, so when
+// an element exits, the copies fit below the clone region, and never overwrite a clone that is still to be read, if
+// this frame's elements and children leave room for all of them. Reattaching an exiting element to its parent copies the parent's children
+// once more; Clay_EndLayout checks that space before each reattachment (see Clay__ReattachFits).
+bool Clay__ExitingCopiesFit(void) {
+    Clay_Context* context = Clay_GetCurrentContext();
+    bool anyExiting = false;
+    for (int32_t i = 0; i < context->transitionDatas.length && !anyExiting; ++i) {
+        Clay__TransitionDataInternal *data = Clay__TransitionDataInternalArray_Get(&context->transitionDatas, i);
+        anyExiting = data->transitionOut && Clay__GetHashMapItem(data->elementId)->generation <= context->generation;
+    }
+    if (!anyExiting) {
+        return true;
+    }
+    return context->layoutElements.length + 2 * context->exitingElementsLength <= context->layoutElements.capacity
+        && context->layoutElementChildren.length + 2 * context->exitingElementsChildrenLength <= context->layoutElementChildren.capacity;
+}
+
+// True when a parent's children list, copied once more to reattach an exiting element, still fits below the clone
+// region with room left for every clone's children to be copied.
+bool Clay__ReattachFits(int32_t listLength) {
+    Clay_Context* context = Clay_GetCurrentContext();
+    return context->layoutElementChildren.length + listLength + context->exitingElementsChildrenLength
+        <= context->layoutElementChildren.capacity - context->exitingElementsChildrenLength;
+}
