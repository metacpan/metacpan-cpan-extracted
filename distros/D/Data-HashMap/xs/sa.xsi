get(SV* self_sv, SV* key_sv)
    CODE:
        EXTRACT_MAP(HashMapSA, stash_sa, "Data::HashMap::SA", self_sv);
        EXTRACT_STR_KEY(key_sv);
        void* val;
        if (!hashmap_sa_get(self, _kstr, (uint32_t)_klen, _khash, &val))
            XSRETURN_UNDEF;
        RETVAL = SvREFCNT_inc((SV*)val);
    OUTPUT:
        RETVAL

