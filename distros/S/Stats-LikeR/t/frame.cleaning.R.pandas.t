# dropna: pandas test_dropna.py, test_drop.py; R complete.cases / na.omit
#--------
sub dn_check {
	my ($label, $f, $cols, $how, $idx, $shape) = @_;
	my $in = build($f, $shape);
	my $got = eval { dropna($in, cols => $cols, how => $how) };
	if ($@) { fail("$label [$shape]: died: " . substr($@, 0, 100)); return }
	is_deeply(to_hoa($got, $shape, $f), slice_expected($f, $idx), "$label [$shape]")
		or diag('got ' . show(to_hoa($got, $shape, $f)));
}
for my $c (@DROP) {
	my ($name, $fr, $cols, $how, $idx) = @$c;
	for my $shape (qw(AoH AoHmiss HoA HoH)) {
		# a column absent from every row of an AoH is "not found" (README), so
		# AoHmiss is only meaningful when each named column has a value somewhere
		next if $shape eq 'AoHmiss' && grep { my $col = $_; !grep { defined } @{ $DN{$fr}{data}{$col} } } @$cols;
		dn_check("pandas $name cols=[" . join(',', @$cols) . "] how=$how", $DN{$fr}, $cols, $how, $idx, $shape);
	}
}
{ # R na.omit.Rd / complete.cases.Rd
	my @an = qw(Ozone Solar.R Wind Temp Month Day);
	my $aq = frame_from_cols(\@an, { map { ($_ => $R{"aq\$$_"}) } @an });
	my $DF = frame_from_cols([qw(x y)], { x => $R{'DF$x'}, y => $R{'DF$y'} });
	for my $shape (qw(AoH AoHmiss HoA HoH)) {
		dn_check('R na.fail.Rd: na.omit(DF)', $DF, [qw(x y)], 'any', $R{'DF keep'}, $shape);
		dn_check('R complete.cases.Rd: complete.cases(airquality)', $aq, \@an, 'any', $R{'aq keep all'}, $shape);
		dn_check('R complete.cases.Rd: complete.cases(airquality[, -1])', $aq, [@an[1 .. 5]], 'any', $R{'aq keep -Ozone'}, $shape);
		dn_check('R: complete.cases(airquality[, c(Ozone, Solar.R)])', $aq, [qw(Ozone Solar.R)], 'any', $R{'aq keep Ozone,Solar.R'}, $shape);
		dn_check('R: rowSums(!is.na(airquality[, c(Ozone, Solar.R)])) > 0 (how=all)', $aq, [qw(Ozone Solar.R)], 'all', $R{'aq keep any Ozone,Solar.R'}, $shape);
	}
	is(scalar @{ dropna(build($aq, 'AoH'), cols => \@an)->[0] ? dropna(build($aq, 'AoH'), cols => \@an) : [] }, 111,
		'R complete.cases.Rd: airquality has 111 complete rows');
}
# rows => : pandas DataFrame.drop(index=...)
for my $c (@ROWS) {
	my ($name, $fr, $rows, $idx) = @$c;
	for my $shape (qw(AoH HoA HoH)) {
		my $in = build(\%ROWF5, $shape);
		my @r = $shape eq 'HoH' ? map { row_key($_) } @$rows : @$rows;
		my $got = eval { dropna($in, rows => \@r) };
		if ($@) { fail("pandas $name [$shape]: died: " . substr($@, 0, 100)); next }
		is_deeply(to_hoa($got, $shape, \%ROWF5), slice_expected(\%ROWF5, $idx), "pandas $name [$shape]");
	}
}
# pandas test_dropna_corner and GH 8303
{
	my $df = { A => [1, 2], B => [3, 4] };
	throws_ok { dropna($df, cols => ['A'], how => 'foo') } qr/'how' must be 'any' or 'all'/, 'pandas test_dropna_corner: how="foo" dies';
	throws_ok { dropna($df, cols => ['A', 'X']) } qr/column 'X' not found/, 'pandas test_dropna_corner (GH 8303): subset with a missing column dies, HoA';
	throws_ok { dropna([ { A => 1 } ], cols => ['A', 'X']) } qr/column 'X' not found/, 'pandas test_dropna_corner (GH 8303): subset with a missing column dies, AoH';
	throws_ok { dropna($df, cols => 'A') } qr/'cols' must be an arrayref/, 'pandas test_set_single_column_subset: a scalar subset dies (README: arrayref only; pandas accepts "C")';
	throws_ok { dropna($df, cols => ['D']) } qr/column 'D' not found/, 'pandas test_single_column_not_present_in_axis (GH 41021): missing column dies';
	throws_ok { dropna($df) } qr/exactly one of 'cols' or 'rows'/, 'dropna with neither cols nor rows dies (pandas defaults to every column; README)';
	throws_ok { dropna($df, cols => ['A'], rows => [0]) } qr/exactly one of 'cols' or 'rows'/, 'dropna with both cols and rows dies (README)';
	my $copy = { A => [1, 2], B => [3, 4] };
	dropna($df, rows => [0]);
	is_deeply($df, $copy, 'pandas test_dropEmptyRows: the original frame is preserved');
}
lives_and { is_deeply(dropna([], cols => ['A']), []) } 'dropna of an empty AoH is empty (README: "An empty AoH or HoA returns empty rather than erroring")';
lives_and { is_deeply(dropna({}, cols => ['A']), {}) } 'dropna of an empty HoA ({}) is empty (README: "An empty AoH or HoA returns empty rather than erroring")';
lives_and { is_deeply(dropna({ A => [] }, cols => ['A']), { A => [] }) } 'dropna of a HoA with one empty column is empty (README)';
{
	my $f = $DN{dn_0};
	my $hoa = build($f, 'HoA');
	my @cols = @{ $f->{cols} };
	no_leaks_ok { my $x = dropna($hoa, cols => \@cols, how => 'all'); my $y = dropna($hoa, rows => [0]) }
		'dropna: no memory leaks (pandas test_dropEmptyRows frame)' unless $INC{'Devel/Cover.pm'};
}

#--------
# value_counts: pandas value_counts tests, R table.Rd
#--------
sub vc_check {
	my ($label, $vals, $exp) = @_;
	my @shapes = (
		[ 'list',      sub { value_counts(@$vals) } ],
		[ 'arrayref',  sub { value_counts([@$vals]) } ],
		[ 'AoH',       sub { value_counts([ map { +{ v => $_, o => 'z' } } @$vals ], 'v') } ],
		[ 'AoA',       sub { value_counts([ map { [ $_, 'z' ] } @$vals ], 0) } ],
		[ 'HoA key',   sub { value_counts({ v => [@$vals], o => [ map { 'z' } @$vals ] }, 'v') } ],
		[ 'HoH key',   sub { my $i = 0; value_counts({ map { (row_key($i++) => { v => $_ }) } @$vals }, 'v') } ],
		[ 'hash',      sub { my $i = 0; value_counts({ map { (row_key($i++) => $_) } @$vals }) } ],
	);
	for my $s (@shapes) {
		my $got = eval { $s->[1]->() };
		if ($@) {
			fail("$label [$s->[0]]: died: " . substr($@, 0, 100)); next;
		}
		is_deeply($got, $exp, "$label [$s->[0]]") or diag(join ',', map { "$_=$got->{$_}" } sort keys %$got);
	}
}
for my $c (@VC) {
	my ($name, $vals, $exp) = @$c;
	vc_check("pandas $name", $vals, $exp);
}
{ # HoA without a key counts every column (README); pandas Series.value_counts of the concatenation
	is_deeply(value_counts({ a => ['j', 't', 't'], b => ['j', 't', 'v'] }), { j => 2, t => 3, v => 1 },
		'pandas Series([j,t,t,j,t,v]).value_counts: HoA without a key counts all columns');
	is_deeply(value_counts({ a => ['j', 't', 't'], b => ['j', 't', 'v'] }, 'a'), { j => 1, t => 2 },
		'pandas df["a"].value_counts(): HoA with a key');
}
# R table.Rd
{
	# R names table(a)'s cells at 15 significant digits; value_counts() keys
	# them as this perl prints each value (README): Inf, but inf before 5.22,
	# and 1/3 to 33 digits on __float128. R's counts are kept, keyed by this
	# perl's print of the same values, and R's own names are checked where they
	# coincide (a double NV, perl 5.22 or later).
	my %TABLE_A = map { ("" . $_ => 10) } 9**9**9, 1, 0.5, 0.33333333333333331;
	is_deeply(\%TABLE_A, $R{'table a'}, 'R table.Rd: table(a) names its cells as this perl prints them')
		if $Config{nvsize} == 8 && "" . 9**9**9 eq 'Inf';
	my %want = (
		'table(warpbreaks$wool)'      => [ $R{'warpbreaks$wool'}, $R{'table warpbreaks$wool'} ],
		'table(warpbreaks$tension)'   => [ $R{'warpbreaks$tension'}, $R{'table warpbreaks$tension'} ],
		'table(state.division)'       => [ $R{'state.division'}, $R{'table state.division'} ],
		'table(state.region)'         => [ $R{'state.region'}, $R{'table state.region'} ],
		'table(a) with a <- rep(c(NA, 1/0:3), 10) (NA not counted)' => [ $R{'a'}, \%TABLE_A ],
		'table(airquality$Month)'     => [ $R{'aq$Month'}, $R{'table aq$Month'} ],
		'table(airquality$Ozone > 80) (NA not counted)' => [ $R{'aq$Ozone>80'}, $R{'table aq$Ozone>80'} ],
	);
	for my $n (sort keys %want) {
		my ($v, $e) = @{ $want{$n} };
		vc_check("R table.Rd: $n", $v, $e);
	}
}
# the README's own edge: a lone undef is fatal, undef elsewhere is skipped
throws_ok { value_counts(undef) } qr/first argument is undefined/, 'value_counts(undef) dies (README)';
is_deeply(value_counts(undef, 'a'), { a => 1 }, 'value_counts(undef, "a") skips the undef (README)');
{
	my $v = ['a', 'b', undef, 'b'];
	no_leaks_ok { my $x = value_counts($v); my $y = value_counts([ map { +{ k => $_ } } 'a', 'b' ], 'k') }
		'value_counts: no memory leaks' unless $INC{'Devel/Cover.pm'};
}

done_testing();
