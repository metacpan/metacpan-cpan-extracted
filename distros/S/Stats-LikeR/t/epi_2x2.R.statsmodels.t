for my $row (@SM) {
	my ($name, $t, $correct, $cl, @e) = @$row;
	my $tag = "$name cl=$cl" . ($correct ? ' correct' : '');
	my $r = eval { epi_2x2(@{ $t->[0] }, @{ $t->[1] }, conf_level => $cl, correct => $correct) };
	if (!$r) { fail("$tag: died: $@") for 1 .. 9; next }
	near($r->{odds_ratio},       $e[0], 1e-12, "$tag: odds_ratio");
	near($r->{odds_ratio_ci}[0], $e[1], 1e-12, "$tag: odds_ratio_ci lower");
	near($r->{odds_ratio_ci}[1], $e[2], 1e-12, "$tag: odds_ratio_ci upper");
	near($r->{risk_ratio},       $e[3], 1e-12, "$tag: risk_ratio");
	near($r->{risk_ratio_ci}[0], $e[4], 1e-12, "$tag: risk_ratio_ci lower");
	near($r->{risk_ratio_ci}[1], $e[5], 1e-12, "$tag: risk_ratio_ci upper");
	near($r->{risk_diff},        $e[6], 1e-12, "$tag: risk_diff");
	near($r->{risk_diff_ci}[0],  $e[7], 1e-12, "$tag: risk_diff_ci lower");
	near($r->{risk_diff_ci}[1],  $e[8], 1e-12, "$tag: risk_diff_ci upper");
}

