#!/usr/bin/env bash
#-*- mode: sh; -*-
# modulino invocation

MODULINO_WRAPPER=@ALIAS@
MODULINO_MODULE_NAME=@MODULE_NAME@
MODULE_PATH=$(
  MODULE_PATH="${MODULINO_MODULE_NAME//:://}.pm" \
    perl -M$MODULINO_MODULE_NAME -e 'print $INC{$ENV{MODULE_PATH}};'
)

MODULINO_WRAPPER=$MODULINO_WRAPPER perl $MODULE_PATH "$@"
