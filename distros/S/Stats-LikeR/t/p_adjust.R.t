		0.021150168138838837, 0.049227364030420349, 0.06053297750530709, 0.062622394673603865,
		0.073951528932168428, 0.082811032824038747, 0.086333312789586975, 0.11906543306177111,
		0.18907962539672907, 0.20584937780834683, 0.22092137198443099, 0.28560004255989702,
		0.30488948730835402, 0.46606820025984125, 0.48308093523371298, 0.4921754604884912,
		0.53194528606277292, 0.5751550464079549, 0.57831946234574394, 0.61858943409521261,
		0.63636200475135141, 0.64485872428665469, 0.65584143928443872, 0.68858840005799427,
		0.71898636230424384, 0.81795385305609414, 0.82744865669079792, 0.89712997590579502,
		0.91186795243409247, 0.94378902178378343
	],
	# SciPy 1.18.0 test_morestats.py TestFDRControl: test_against_TileStats's
	# vector, and test_against_R's loguniform draw with its forced tie.
	scipy_tile => [ 0.005, 0.009, 0.019, 0.022, 0.051, 0.101, 0.361, 0.387 ],
	scipy_r    => [ 0.22155324617906308, 0.0011400256607475624, 0.016956141450127922,
	                0.04105189560873919, 0.05592919759227762, 0.0036829815530863884,
	                0.1403262673826463, 0.04105189560873919, 0.03648130302125419,
	                0.254640823272164 ],
	# NaN is R's NA: left out of n and handed back in place (see the header).
	nan6     => [ 0.01, $NaN, 0.04, 0.03, $NaN, 0.02 ],
	nan_mix  => [ $NaN, 0.6, 0.02, 0.001, $NaN, 0.4, 0.31, 0.99, 0.05, 0.0001, 0.5, 0.12, $NaN ],
	nan_tied => [ 0.05, $NaN, 0.05, 0.05 ],
	nan_two  => [ 0.02, $NaN, 0.03 ],
	nan_one  => [ $NaN, 0.7 ],
	nan_all  => [ $NaN, $NaN ],
);

my ($rows, $values, $worst, $worst_at) = (0, 0, 0, '');
my %seen_method;

while (my $line = <DATA>) {
	next if $line =~ /\A\s*#/ || $line !~ /\S/;
	chomp $line;
	my ($label, $csv) = split /\t/, $line;
	my @exp = split /,/, $csv;

	# label is <set>.<method>, and a method name may itself contain no dot.
	my ($set, $method) = $label =~ /\A(.+)\.([^.]+)\z/
		or do { fail("unparseable label '$label'"); next };
	my $in = $SETS{$set} or do { fail("no input set '$set'"); next };
	$seen_method{$method} = 1;
	$rows++;

	my @got = eval { p_adjust($in, $method) };
	if ($@) { fail("$label: p_adjust died: $@"); next }
	is(scalar @got, scalar @exp, "$label: value count") or next;
	for my $i (0 .. $#exp) {
		$values++;
		my ($e, $g) = ($exp[$i], $got[$i]);
		if ($e eq 'NaN') {	# R's NA for a NaN p-value, in its own place
			ok($g != $g, "$label\[$i] is NaN") or diag("got $g, expected NaN");
			next;
		}
		my $err = $e == 0 ? abs($g) : abs($g - $e) / abs($e);
		if ($err > $worst) { $worst = $err; $worst_at = "$label\[$i]" }
		ok($err <= $TOL, "$label\[$i]")
			or diag(sprintf 'got %.17g, expected %s, rel err %.4g', $g, $e, $err);
	}
}

cmp_ok($rows,   '>', 50,  "reference vectors exercised ($rows)");
cmp_ok($values, '>', 200, "adjusted values compared ($values)");
is_deeply([ sort keys %seen_method ], [ sort @METHODS ],
	"every method in R's p.adjust.methods is covered");

#
# Properties the table cannot state, taken from the same R material.
#
{
	# Method names are case-insensitive here and the long spellings are
	# accepted, which R does not do -- R matches p.adjust.methods exactly.
	# That is a deliberate superset, so it is asserted rather than compared.
	my @bh   = p_adjust($SETS{mix10}, 'BH');
	my @bh_l = p_adjust($SETS{mix10}, 'bh');
	my @fdr  = p_adjust($SETS{mix10}, 'fdr');
	my @long = p_adjust($SETS{mix10}, 'Benjamini-Hochberg');
	is_deeply(\@bh_l, \@bh, "'bh' is the same method as 'BH'");
	is_deeply(\@fdr,  \@bh, "'fdr' is a synonym for 'BH', as in R");
	is_deeply(\@long, \@bh, "the full 'Benjamini-Hochberg' spelling is accepted");
	my @by      = p_adjust($SETS{mix10}, 'BY');
	my @by_long = p_adjust($SETS{mix10}, 'Benjamini-Yekutieli');
	is_deeply(\@by_long, \@by, "...and 'Benjamini-Yekutieli' likewise");
	# The fold is ASCII-only: a byte >= 0x80 is not folded (it was handed to
	# tolower() as a negative char up to 0.319), so the name is simply unknown.
	my $folded = eval { p_adjust($SETS{mix10}, "b\xc9"); 1 };
	ok(!$folded && $@ =~ /Unknown p-value adjustment method/,
		"a method name with a byte >= 0x80 is rejected, not folded");

	# 'none' must be the identity.  R's man-page example asserts exactly this:
	# stopifnot(identical(p.adj[,"none"], p)).
	my @none = p_adjust($SETS{mix10}, 'none');
	is_deeply(\@none, $SETS{mix10}, "'none' returns the family unchanged");

	# Every method is a p-value inflator: no adjusted value may fall below the
	# raw one, and none may exceed 1.  This holds for all of R's methods and is
	# the invariant that catches a sign or an off-by-one in the sorted walk.
	for my $m (@METHODS) {
		for my $set (sort keys %SETS) {
			my @adj = p_adjust($SETS{$set}, $m);
			my $bad = 0;
			for my $i (0 .. $#adj) {
				$bad++ if $adj[$i] < $SETS{$set}[$i] - 1e-15;
				$bad++ if $adj[$i] > 1 + 1e-15;
			}
			is($bad, 0, "$m on $set: adjusted values are in [raw, 1]");
		}
	}

	# PR#17136, from p.adjust.Rd's own comment: on that page's own p-vector
	# "The smallest 3 Bonferroni values are smaller than the 'BY' ones".  It
	# reads like a bug in one of the two and is not, so it is asserted outright
	# rather than left implicit in a table row.
	my @bonf = p_adjust($SETS{manpage}, 'bonferroni');
	my @by2  = p_adjust($SETS{manpage}, 'BY');
	# the vector is already sorted ascending, so the first three are the three
	# smallest, exactly as the man page indexes them
	cmp_ok($bonf[$_], '<', $by2[$_],
		sprintf 'PR#17136: Bonferroni[%d] < BY[%d] on p.adjust.Rd\'s own vector',
			$_ + 1, $_ + 1)
		for 0 .. 2;

	# ...and the same page's other printed fact: colSums(p.adj < 0.05) is
	#     holm hochberg hommel bonferroni BH BY none
	#       11       11     11         11 20 12   22
	my %REJECT = (holm => 11, hochberg => 11, hommel => 11, bonferroni => 11,
	              BH => 20, BY => 12, none => 22);
	for my $m (sort keys %REJECT) {
		my @adj = p_adjust($SETS{manpage}, $m);
		my $n = grep { $_ < 0.05 } @adj;
		is($n, $REJECT{$m},
			"p.adjust.Rd's own count of rejections at 0.05 for '$m'");
	}

	# holm and bonferroni must agree on the smallest p-value, since holm's
	# first step IS the Bonferroni bound; they part company from the second.
	my @holm = p_adjust($SETS{mix10}, 'holm');
	my ($imin) = sort { $SETS{mix10}[$a] <=> $SETS{mix10}[$b] } 0 .. $#{ $SETS{mix10} };
	my @bonf10 = p_adjust($SETS{mix10}, 'bonferroni');
	cmp_ok(abs($holm[$imin] - $bonf10[$imin]), '<', 1e-15,
		'holm and bonferroni agree on the smallest p-value');

	# hochberg is never more conservative than holm, and BH never more than
	# either; both are standard and both would break under an ordering bug.
	my @hoch = p_adjust($SETS{mix10}, 'hochberg');
	my $ok = 1;
	for my $i (0 .. $#holm) { $ok = 0 if $hoch[$i] > $holm[$i] + 1e-15 }
	ok($ok, 'hochberg is never more conservative than holm');
	$ok = 1;
	for my $i (0 .. $#holm) { $ok = 0 if $bh[$i] > $hoch[$i] + 1e-15 }
	ok($ok, 'BH is never more conservative than hochberg');
}

#
# The empty family -- reg-tests-1d.R:4339, PR#18002.  R returns a
# zero-length vector rather than erroring.
#
{
	for my $m (@METHODS) {
		my @e = eval { p_adjust([], $m) };
		ok(!$@ && @e == 0, "$m on an empty family returns nothing, as in R")
			or diag($@ || "got " . scalar(@e) . " values");
	}
}

#
# RECORDED DIVERGENCES FROM R
# ---------------------------
# R's p.adjust takes an n= argument, correcting a family as if it had n members
# ("p.adj.60" in the man-page example, which asserts p.adj <= p.adj.60).
# p_adjust() has no n=, so that half of the example cannot be reproduced.  This
# is a missing feature, not a wrong answer, and it is asserted here as a croak
# so that adding n= later has to come through this test.
{
	my @r = eval { p_adjust([0.01, 0.02], 'holm', n => 20) };
	ok($@, "p_adjust has no n= argument (R does); the call is a croak, not silent");
	like($@, qr/\bn\b/, '...and the message names the argument it rejected');
}

diag(sprintf 'worst relative error vs R: %.4g (%s)', $worst, $worst_at);

# A call of the wrong form prints p_adjust's help screen, then the error last.
like(do { local $@; eval { p_adjust([0.01, 0.5], 'nonesuch') }; $@ },
	qr/\Ausage: p_adjust\(.*^example:\n.*\n\np_adjust: error: \QUnknown p-value adjustment method: nonesuch\E\n\z/ms,
	'p_adjust: an unknown method prints the help screen, and the error last');

done_testing();

