#!/usr/bin/env perl
# cor_test(method => 'kendall') against R 4.6.1's cor.test().
#
# Provenance: t/cor_test.kendall.R.R (committed next to this file) generated
# every literal in @R_ROWS under R 4.6.1 (2026-06-24) at options(digits = 17).
# Re-run it with
#     Rscript t/cor_test.kendall.R.R
# This test never invokes R; it reads the frozen literals.  Data are small
# integers throughout, so the tie structure -- which is what picks R's branch --
# is the same at every NV width.
#
# What it pins.
#
# 1. The tie correction in var_S.  Through 0.311 the normal-approximation
#    branch divided the Kendall score by the no-tie variance
#
#        var_S = n(n-1)(2n+5)/18
#
#    alone.  That is the whole of R's var_S only when there are no ties, and
#    with no ties and n < 50 the branch is not reached at all -- so the
#    correction was missing in exactly the case that needs it.  R's is
#
#        var_S = (v0 - vt - vu)/18 + v1/(2n(n-1)) + v2/(9n(n-1)(n-2))
#
#    with vt, vu, v1 and v2 built from table(x[duplicated(x)]) + 1 on each
#    vector (src/library/stats/R/cor.test.R).  On "both15" -- 15 points of tied
#    integer data -- 0.311 reported
#
#        z = -1.8805123053604953   p = 0.060038290909579115
#
#    against R's -2.0721033457107345 and 0.038255804392841472: a factor of 1.57
#    on the p-value, across 0.05.  Every tied row here is that case.
#
# 2. The continuity correction at a score of zero.  R applies
#    S <- sign(S) * (abs(S) - 1), and sign(0) is 0, so S = 0 stays 0.  This
#    subtracted a signum that treated 0 as negative, moving it to +1: "heavy30"
#    with continuity => 1 reported z = 0.019410388389502, p = 0.98451372323408
#    where the answer is z = 0, p = 1.
#
# 3. The branch choice itself -- exact in {default, 1, 0} crossed with R's
#    n < 50 default and with tied data, which forces the approximation either
#    way -- and the exact branch's statistic T, which 0.312 forms as
#    (C + D + (C - D))/2 from the same counts rather than from tau, so a
#    rounding wobble in tau can no longer move an integer pair count.
#
# Speed, not correctness, is why those counts come from Knight's algorithm now:
# the branch used to walk every (i, j) pair, 14.7 s at n = 64000 against
# 0.0135 s for the O(n log n) counts cor() had been using since 0.31.  @LARGE
# below is the pin that the two agree, at a size the old loop could not have
# finished inside a test suite.
#
# RECORDED DIVERGENCE.  Perfect concordance at n = 10 ("perfect10", on the
# exact branch).  Only one permutation of ten items has all 45 pairs
# concordant, so the one-sided p-value is exactly 1/10! and the two-sided is
# exactly 2/10!:
#
#     1/10! = 2.755731922398589e-07     R: 2.7557319226545474e-07
#     2/10! = 5.511463844797178e-07     R: 5.5114638453090947e-07
#
# cor_test() returns the two exact doubles; R's C_pKendall builds the
# distribution of inversions by dynamic programming and its answer is 9.3e-11
# out.  The assertion here is against the combinatorics, with R's literal kept
# above as provenance -- the same shape of divergence t/cor_test.spearman.R.t
# records for R's rho.  The mirror case (perfect discordance, "reverse10") used
# to diverge the other way, by 1.3e-11, because the lower tail was summed from
# dp[max_inv] downwards; 0.312 sums both tails from dp[0] using the symmetry of
# the inversion distribution, and it is now exact too.
#
# Tolerance.  1e-11 relative, against a worst observed disagreement over the
# 396 rows of 1.59e-13 (p_value, n = 60, exact => 1) once that divergence is
# taken out -- 63x headroom.  The tie-corrected var_S is a sum of four terms of
# very different sizes and the exact branch is an O(n^3) DP, so the last bits
# of both move with NV width.  A p-value of exactly 0 or 1 is compared
# absolutely, since a relative error against 0 says nothing.

require 5.010;
use strict;
use warnings FATAL => 'all';
use Test::More;
use lib 'blib/lib', 'blib/arch';
use Stats::LikeR qw(cor_test cor);

my $TOL = 1e-11;   # justified in the header

my $worst = 0;
sub rel_ok {
	my ($got, $want, $name) = @_;
	my $err = abs($want) > 1e-300 ? abs($got - $want) / abs($want)
	                              : abs($got - $want);
	$worst = $err if $err > $worst;
	ok($err <= $TOL, $name) or diag("got $got, expected $want, rel $err");
}

# The recorded divergence: exact 1/10! and 2/10!, not R's DP values.
my %PERFECT10_EXACT = (
	'greater'   => 2.755731922398589e-07,
	'two.sided' => 5.511463844797178e-07,
);

