# What is not shipped. REGEXES, not globs - ExtUtils::Manifest matches these
# with m//, so `*.o` is not a pattern that means anything here.
^Makefile$
^Makefile\.old$
^blib/
^pm_to_blib$
^MYMETA\.
^Install/
\.o$
\.bs$
^Natural\.c$
^Time-Keeper-Natural-
\.tar\.gz$
^ignore\.txt$
^\.git
~$
^MANIFEST\.bak$
# The differential oracle's corpus: kept in the tree, 21 MB, not shipped.
^xt/oracle-corpus/
