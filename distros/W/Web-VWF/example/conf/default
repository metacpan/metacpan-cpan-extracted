<?xml version="1.0"?>
<config>
	<display>
		<!--
			Without any <page> elements, the page modules found in <directory>
			are the valid pages (default: ../lib/Web/VWF/Display beside cgi-bin).
			<directory>/path/to/Display</directory>
			A <directory> inside a <page> says where that page's module is, and
			beats this one.
		-->
		<page>
			<name>index</name>
			<description>The home page, with the contact form</description>
		</page>
		<page>
			<name>meta_data</name>
			<description>Charts of the server and of the traffic it has handled</description>
		</page>
		<page>
			<name>states</name>
			<description>Displays information about the U.S. states</description>
		</page>
	</display>
	<databases>
		<!--
			Each <database> names a Web::VWF::Data:: module (a name with :: in it
			is used as written).  A <directory> here, or inside a <database>, is
			where the module's .pm file is, instead of @INC; the files that hold
			the data are in database_dir.
		-->
		<database>
			<name>index</name>
			<description>The people who can be contacted from the index page (index.csv)</description>
		</database>
		<database>
			<name>states</name>
			<description>List of data about the U.S. states</description>
		</database>
	</databases>
	<memory_cache>
		<driver>Null</driver>
	</memory_cache>
	<SiteTitle>
		<English>Test</English>
		<Default>Test</Default>
	</SiteTitle>
	<twitter>yourtwitterhandle</twitter>
	<contact>
		<name>Your Name Goes Here</name>
		<email>you@example.com</email>
	</contact>
	<!--
	<disc_cache>
		<driver>DBI</driver>
		<connect>dbi:SQLite:dbname=/tmp/cache/genealogy.sqlite</connect>
	-->
	<disc_cache>
		<driver>File</driver>
		<root_dir>/var/tmp/cache</root_dir>
	</disc_cache>
	<!--
		Get keys from https://www.google.com/recaptcha/admin
	-->
	<recaptcha>
		<site_key>YOUR_SITE_KEY_HERE</site_key>
		<secret_key>YOUR_SECRET_KEY_HERE</secret_key>
		<enabled>1</enabled>
	</recaptcha>

	<!--
		DKIM signing for the mail the contact page sends.  That mail goes out as
		webmaster@<domain>, so the key must be published for the same domain:
		openssl genrsa -out 202611.private 2048, then the public half at
		202611._domainkey.<domain>.  Without both settings the mail is sent
		unsigned, which is what happened before signing was supported.
	-->
	<!--
	<DKIMSelector>202611</DKIMSelector>
	<DKIMKey>/home/site/dkim/202611.private</DKIMKey>
	-->

	<security>
		<rate_limiting>
			<!--  Hard limit - block completely -->
			<max_requests_hard>150</max_requests_hard>
			<!-- Soft limit - show CAPTCHA -->
			<max_requests>100</max_requests>
			<time_window>60s</time_window>
			<!-- 5 minutes after successful CAPTCHA -->
			<captcha_bypass_duration>300s</captcha_bypass_duration>
		</rate_limiting>
		<!-- CGI::IDS threshold -->
		<ids_threshold>50</ids_threshold>
		<csrf>
			<!-- Generate CSRF token for forms -->
			<enable>1</enable>
			<secret>default_secret</secret>
		</csrf>
	</security>
</config>
