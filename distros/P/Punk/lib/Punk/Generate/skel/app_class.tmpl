package {% name %};

use strict;
use warnings;
use Punk;

our $VERSION = '0.01';

# Configuration lives in config/punk.yml, applied at the point this keyword
# sits - so everything declared below can rely on the views, database and
# plugins it registered. Anything in the file that is not a Punk keyword is
# yours, reachable through $app->config.
config 'config/punk.yml';

# Routes. A target string names a controller relative to
# {% name %}::Controller - 'Web::Root#index' is
# {% name %}::Controller::Web::Root::index - or pass a coderef inline.
get '/' => 'Web::Root#index';

# Views and the /static mount come from config/punk.yml, so this file stays
# the routing table. Add a route with a coderef when it is not worth a
# controller method:
#
#   get '/health' => sub { $_[0]->json({ ok => 1 }) };
{% if api %}
# The OpenAPI mount: every operation dispatches to the controller method
# named after its operationId, with parameters and body validated against
# the spec before your code runs. Stubs are in lib/{% path %}/Controller/API.
{% if schemes %}#
# security maps each securityScheme the spec requires to the checker that
# authorises it. Punk compiles them into per-operation guards, so a request
# that fails one is answered 401 before its body is read. The generated
# checkers refuse everything until you fill them in.
my $api = under('/api')->api('openapi.json' => {
    security => {
{% for s in schemes %}        '{% s.name %}' => 'API::{% s.class %}#{% s.method %}',
{% end %}    },
});
{% else %}my $api = under('/api')->api('openapi.json');
{% end %}

# The documentation UI, if Open::API::UI is installed. Optional, so the
# application still boots without it.
docs '/docs' => $api if eval { require Open::API::UI; 1 };
{% end %}
1;

__END__

=head1 NAME

{% name %} - a Punk application

=head1 SYNOPSIS

    plackup app.psgi
    # or, for the event loop Punk is built for:
    hyperman app.psgi

=head1 DESCRIPTION

Generated by C<punk new>. The application class is the whole routing
table: L<Punk> exports the keywords, and C<to_app> resolves and freezes
routes, guards, views{% if api %}, the API mount{% end %} and models into one PSGI
coderef at boot.

=head1 SEE ALSO

L<Punk>, L<Punk::Context>, L<Punk::Controller>.

=cut
