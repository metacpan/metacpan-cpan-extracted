PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "@PROJECT_DESCRIPTION@"
OUTPUT_DIRECTORY       = "@CMAKE_CURRENT_SOURCE_DIR@/docs"
INPUT                  = "@CMAKE_CURRENT_SOURCE_DIR@/include/histo" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/docs/manual.md" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/docs/top_manual.md" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/docs/curve_fitting_guide.md" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/docs/histo2d_guide.md" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/docs/kde_guide.md"
USE_MDFILE_AS_MAINPAGE = "@CMAKE_CURRENT_SOURCE_DIR@/docs/manual.md"
RECURSIVE              = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = YES
USE_MATHJAX            = YES
