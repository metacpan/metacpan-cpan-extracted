^myldr/Makefile$
^myldr/Makefile\.old$
^myldr/main\.[^c].*$
^myldr/x?static(?:.[^c].*)?$
^myldr/my_.*$
^myldr/perlxsi.c$
^myldr/par(?:\.\w+)?$
^myldr/sha1.[co]$
^myldr/.*\.pdb$
^myldr/usernamefrompwuid\.h$
^package/parl-.*$
^script/parl(?:\.(?!pod).+)?$
^script/parldyn(?:\.(?!pod).+)?$
^MANIFEST\.bak$
^Makefile$
^Makefile\.old$
^blib/
^pm_to_blib
^blibdirs
\B\.svn\b
^debian/
~$    		# ignore emacs and vim backup files
\.bak$  		# ignore manual backups
\#  			# ignore CVS old revision files and emacs temp files
\.Dstore$		# .Dstore Osx
\.bzr*		# Bazaar CVS
\..*\.sw.$	# vim swap files
\.tar.gz$
# --- Integration and development paths, excluded from the oEdtk distribution --
# Read-only integration source trees and the companion distribution.
^oEUser-M/
^oEdtk-fork-M/
^oEdtk-T/
^oEUser/
^snap/
# Integration documentation and the development harness.
^docs/
^tracker/
^cover_db/
^app-test-fusion/
^tools/
# Integration test material, not shipped (the mainline suite only is shipped).
^t/int/
^t/data/
^t/golden/
^t/fixidx-samples/
^t/lib/(?!TestOEdtk\.pm$)
# Root files that are not part of the distribution.
^cpanfile$
^META\.
^MYMETA\.
^\.git
^\.claude
^\.env
^\.perl
^0-.*\.sh$
^find_accents\.sh$
# Local recette / development runner scripts (not part of the distribution).
^run_.*\.sh$
\.log$
# Repository-only operational helpers, kept in git but not shipped.
^lib/oEdtk/lib/backup_compo_lmndv\.sh$
^lib/oEdtk/lib/backup_editique\.sh$
^lib/oEdtk/lib/mep_compo\.sh$
^lib/oEdtk/lib/mep_editique\.sh$
^lib/oEdtk/lib/short_test\.sh$
^lib/oEdtk/lib/ged_process\.pl$
# Repository-only web front-ends and their static pages.
^lib/oEdtk/lib/cgi-bin/
^lib/oEdtk/lib/html/
# Root planning documents (the shipped README.md is kept).
^(?!README\.md$).*\.md$
# Runtime logs written under lib/ (also covered by .gitignore).
^lib/oEdtk/log/
