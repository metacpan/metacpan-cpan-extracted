#include "myxshead.h"

%module{Math::SZaru};

%name{Math::SZaru::UniqueEstimator}
class UniqueEstimator {

  // FIXME this order of type/keyword/decorator simply must be a bug in XS++
  static
  %name{new}
  UniqueEstimator*
  Create(const char *CLASS, SV *nElemes)
    %code{%
      check_szaru_constructor_param(nElemes, 10000000.0, "UniqueEstimator");
      RETVAL = UniqueEstimator::Create((int)SvNV(nElemes));
    %};

  // Redundant interface
  // %name{add_elem} virtual void AddElemInCIF(const char *data, size_t %length{data});

  %name{add_elem} virtual void AddElem(const std::string& elm);

  %name{estimate} virtual int64_t Estimate() const;
  %name{tot_elems} virtual uint64_t TotElems() const;
  ~UniqueEstimator();

// Pure XS implementation of multi-element add for performance
{%
void
add_elems(UniqueEstimator *THIS, ...)
  CODE:
    if (!THIS)
      croak("Math::SZaru::UniqueEstimator::add_elems() -- THIS is NULL / invalid");
    char *str;
    STRLEN len;
    for (unsigned int i = 1; i < items; ++i) {
      str = SvPV(ST(i), len);
      THIS->AddElem(std::string(str, len));
    }
%}

}; // End of UniqueEstimator



%name{Math::SZaru::TopEstimator}
class PTopEstimator {
  ~PTopEstimator();
  static
  %name{new}
  PTopEstimator*
  new(const char *CLASS, SV *numTops)
    %code{%
      check_szaru_constructor_param(numTops, 1000000.0, "TopEstimator");
      RETVAL = new PTopEstimator((uint32_t)SvNV(numTops));
    %};
  void add_elem(const std::string& elm);
  void add_weighted_elem(const std::string& elem, double weight);
  uint64_t tot_elems();

  SV *
  estimate()
    %code{%
      AV *av = newAV();
      std::vector< SZaru::TopEstimator<double>::Elem > v;
      THIS->estimate(v);
      if (!v.empty())
        av_extend(av, v.size()-1);
      for (unsigned int i = 0; i < v.size(); ++i) {
        AV *iav = newAV();
        const std::string &str = v[i].value;
        av_store(iav, 0, newSVpvn(str.c_str(), str.length()));
        av_store(iav, 1, newSVnv(v[i].weight));
        av_store(av, i, newRV_noinc((SV *)iav));
      }
      RETVAL = newRV_noinc((SV *)av);
    %};

// Pure XS implementation of multi-element add for performance
{%
void
add_elems(PTopEstimator *THIS, ...)
  CODE:
    if (!THIS)
      croak("Math::SZaru::TopEstimator::add_elems() -- THIS is NULL / invalid");
    char *str;
    STRLEN len;
    for (unsigned int i = 1; i < items; ++i) {
      str = SvPV(ST(i), len);
      THIS->add_elem(std::string(str, len));
    }

void
add_weighted_elems(PTopEstimator *THIS, ...)
  CODE:
    if (!THIS)
      croak("Math::SZaru::TopEstimator::add_weighted_elems() -- THIS is NULL / invalid");
    char *str;
    STRLEN len;
    if (items % 2 == 0) /* params PLUS invocant! */
      croak("Need an even number of arguments: (string, weight, string, weight, ...)");

    for (unsigned int i = 1; i < items; i += 2) {
      double w = SvNV(ST(i+1));
      if (!std::isfinite(w))
        croak("TopEstimator: weight must be a finite number (not NaN or Inf)");
      str = SvPV(ST(i), len);
      THIS->add_weighted_elem(std::string(str, len), w);
    }
%}
}; // End of TopEstimator


%name{Math::SZaru::QuantileEstimator}
class PQuantileEstimator {
  ~PQuantileEstimator();
  static
  %name{new}
  PQuantileEstimator*
  new(const char *CLASS, SV *numQuantiles)
    %code{%
      check_szaru_constructor_param(numQuantiles, 1000000.0, "QuantileEstimator");
      RETVAL = new PQuantileEstimator((uint32_t)SvNV(numQuantiles));
    %};
  void add_elem(const double elm);
  uint64_t tot_elems();

  std::vector<double>
  estimate()
    %code{% THIS->estimate(RETVAL); %};

// Pure XS implementation of multi-element add for performance
{%
void
add_elems(PQuantileEstimator *THIS, ...)
  CODE:
    if (!THIS)
      croak("Math::SZaru::QuantileEstimator::add_elems() -- THIS is NULL / invalid");
    for (unsigned int i = 1; i < items; ++i) {
      double val = SvNV(ST(i));
      if (!std::isfinite(val))
        croak("QuantileEstimator: element must be a finite number (not NaN or Inf)");
      THIS->add_elem(val);
    }
%}

}; // End of QuantileEstimator
