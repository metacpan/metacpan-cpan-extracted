for my $c (@PROBS) {
	my ($label, $want) = @$c;
	my ($pat, $n) = $label =~ /^probs_([a-z]+)_(\d+)$/;
	my $x = $PATTERN{$pat}->($n);
	my $worst = 0;
	for my $i (0 .. $#PR) {
		my $got = (values %{ quantile(x => $x, probs => [ $PR[$i] ]) })[0];
		my $e = rel($got, $want->[$i]);
		$worst = $e if $e > $worst;
	}
	ok($worst <= $TOL, sprintf('E %s: nine probs match R (worst rel %.2g)',
		$label, $worst));
}

# G. Added 0.331: R's values to the bit, and R's names.
#
# quantile() used to take h = (n-1)p as a 0-based index where R takes
# index = 1 + (n-1)p; the two are equal in exact arithmetic and not in double.
# Adding 1 rounds away the low bits of (n-1)p, so for a tiny p R returns x[1]
# exactly where the 0-based form interpolated, and on ordinary probs a few
# percent of quantiles came out an ulp or two from R's.  The tables below
# are R 4.6.1's values, from the "0.331" part of t/quantile.R.R, written m:e
# for m * 2**e so that every perl reads R's double back exactly.  On a double
# NV the comparison is exact equality: the same roundings happen in the same
# order on both sides (the XS rounds each step to the NV, so an x87 build
# matches too).  On a long-double or __float128 NV the index 1 + (n-1)p is
# formed at that width, while R's double index can be half an ulp of n, about
# n * 2**-53, from the exact one; an index that far off moves the quantile by
# at most that fraction of the largest gap between order statistics, so the
# bound there is 2 * n * 2**-53 * range.  Measured on perl-5.12.5 (long
# double): at most 0.28 of n * 2**-53 * range (reversed_7), and 4.8e-15 of the
# range at n = 1000.
my $NV_IS_DOUBLE = $Config{nvtype} eq 'double';
sub dy { my ($s) = @_; my ($m, $e) = split /:/, $s; return $m * 2 ** $e }
sub same {
	my ($got, $want, $n, $range) = @_;
	return $got == $want if $NV_IS_DOUBLE;
	return abs($got - $want) <= 2 * $n * 2 ** -53 * $range || rel($got, $want) <= $TOL;
}

