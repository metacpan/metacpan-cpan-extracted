            5.37267640274188, 19.0142449199291, 9.73332227003428, 8.31738638480493, 6.31037818332663,
            9.20418255643613, 2.60820035543772, 6.31711871125016, 4.46021041229229, 10.2888822765962,
            6.73818987720226, 9.52887757504549, 2.5392605263949, 0.220793376082986, 16.2144137537614,
            7.75967383732589, 12.9206437496152, 0.676126261775572, 3.08716735129802,
            3.99397143026379, 0.788672388604446, 17.7768629980417, 5.38600361561081,
            5.95503951542439, 3.37122797905803, 6.17296612672919, 17.1065657154689, 11.6474849166383,
            15.8580384137475, 4.78550989778788, 9.12753139415071, 6.36106708405187, 9.32307167360643,
            -2.26345465451006, -0.585113899207057],
		formula => 'y ~ x1 + x2',  df1 => 2, df2 => 47,
		expected_p => 1.4720960614153366e-21,
		r_stat => 157.441699185244, r_p => 1.47209606141526e-21,
	},
);

for my $c (@CASES) {
	my %d = map { $_ => $c->{$_} } grep { ref $c->{$_} eq 'ARRAY' && !/^formulas$/ }
		keys %$c;
	my $n = $c->{name};

	if ($c->{kind} eq 'aov1') {
		# aov and anova agree term-for-term on a single-factor model
		for my $fn (qw(aov anova)) {
			my $res = $fn eq 'aov' ? aov(\%d, $c->{formula}) : anova(\%d, $c->{formula});
			my $t = $res->{g};
			is $t->{Df},               $c->{df1}, "$n/$fn: term Df";
			is $res->{Residuals}{Df},  $c->{df2}, "$n/$fn: residual Df";
			undeflow_ok($t->{'Pr(>F)'}, $c->{expected_p}, "$n/$fn");
			rel_ok($t->{'Pr(>F)'}, $c->{expected_p}, "$n/$fn: p == f.sf(own F)",
				f_tail_tol($c->{df2}, $c->{cond}));
			rel_ok($t->{'F value'}, $c->{r_stat},    "$n/$fn: F vs R",
				1e-9 + stat_budget($c->{cond}));
			rel_ok($t->{'Pr(>F)'},  $c->{r_p},       "$n/$fn: p vs R",
				1e-7 + f_tail_tol($c->{df2}, $c->{cond}));
		}
	}
	elsif ($c->{kind} eq 'anova2') {
		my $res = anova(\%d, $c->{formula});
		for my $t (qw(x1 x2)) {
			my $e = $c->{"exp_$t"};
			is $res->{$t}{Df}, $e->{df1}, "$n/anova $t: Df";
			undeflow_ok($res->{$t}{'Pr(>F)'}, $e->{expected_p}, "$n/anova $t");
			rel_ok($res->{$t}{'Pr(>F)'},  $e->{expected_p}, "$n/anova $t: p == f.sf(own F)",
				f_tail_tol($e->{df2}, $c->{cond}));
			rel_ok($res->{$t}{'F value'}, $e->{r_stat},     "$n/anova $t: F vs R",
				1e-8 + stat_budget($c->{cond}));
			rel_ok($res->{$t}{'Pr(>F)'},  $e->{r_p},        "$n/anova $t: p vs R",
				1e-6 + f_tail_tol($e->{df2}, $c->{cond}));
		}
	}
	elsif ($c->{kind} eq 'anova_cmp') {
		my $tab = anova(\%d, @{ $c->{formulas} });
		is ref($tab), 'ARRAY', "$n/anova_cmp: model comparison returns a table";
		my $row = $tab->[1];
		is $row->{Df}, $c->{df1}, "$n/anova_cmp: Df";
		undeflow_ok($row->{'Pr(>F)'}, $c->{expected_p}, "$n/anova_cmp");
		rel_ok($row->{'Pr(>F)'}, $c->{expected_p}, "$n/anova_cmp: p == f.sf(own F)",
			f_tail_tol($c->{df2}, $c->{cond}));
		rel_ok($row->{F},        $c->{r_stat},     "$n/anova_cmp: F vs R",
			1e-9 + stat_budget($c->{cond}));
		rel_ok($row->{'Pr(>F)'}, $c->{r_p},        "$n/anova_cmp: p vs R",
			1e-8 + f_tail_tol($c->{df2}, $c->{cond}));
	}
	elsif ($c->{kind} eq 'lm') {
		my $res = lm(formula => $c->{formula}, data => \%d);
		undeflow_ok($res->{'f.pvalue'}, $c->{expected_p}, "$n/lm");
		rel_ok($res->{'f.pvalue'},     $c->{expected_p}, "$n/lm: f.pvalue == f.sf(own F)",
			f_tail_tol($c->{df2}, $c->{cond}));
		rel_ok($res->{fstatistic}[0],  $c->{r_stat},     "$n/lm: fstatistic vs R",
			1e-9 + stat_budget($c->{cond}));
		rel_ok($res->{'f.pvalue'},     $c->{r_p},        "$n/lm: f.pvalue vs R",
			1e-8 + f_tail_tol($c->{df2}, $c->{cond}));
	}
	elsif ($c->{kind} eq 'glm_bin') {
		my $res = glm(formula => $c->{formula}, data => \%d, family => $c->{family});
		my $x = $res->{summary}{x};
		undeflow_ok($x->{'Pr(>|z|)'}, $c->{expected_p}, "$n/glm");
		rel_ok($x->{'Pr(>|z|)'}, $c->{expected_p}, "$n/glm: p == 2*norm.sf(own |z|)",
			z_tail_tol($c->{r_stat}, $c->{cond}));
		rel_ok($x->{'z value'},  $c->{r_stat}, "$n/glm: z vs R", 1e-4);
		rel_ok($x->{'Pr(>|z|)'}, $c->{r_p},    "$n/glm: p vs R",
			$c->{r_p_tol} + z_tail_tol($c->{r_stat}, $c->{cond}));
	}
}

# ---------------------------------------------------------------------------
# The regression itself, stated plainly: a p-value this far out is a real
# number, not a 0.  Every one of these was 0 before pf_upper()/2*pnorm(-|z|).
# ---------------------------------------------------------------------------
{
	my @underflowed = grep { $_ > 0 && $_ < 1e-16 } map {
		my $c = $_;
		my %d = map { $_ => $c->{$_} }
			grep { ref $c->{$_} eq 'ARRAY' && $_ ne 'formulas' } keys %$c;
		  $c->{kind} eq 'lm'        ? lm(formula => $c->{formula}, data => \%d)->{'f.pvalue'}
		: $c->{kind} eq 'aov1'      ? aov(\%d, $c->{formula})->{g}{'Pr(>F)'}
		: $c->{kind} eq 'anova2'    ? anova(\%d, $c->{formula})->{x2}{'Pr(>F)'}
		: $c->{kind} eq 'anova_cmp' ? anova(\%d, @{ $c->{formulas} })->[1]{'Pr(>F)'}
		:                             glm(formula => $c->{formula}, data => \%d,
		                                  family => $c->{family})->{summary}{x}{'Pr(>|z|)'};
	} @CASES;
	cmp_ok scalar @underflowed, '>=', 17,
		'the suite really does exercise p-values below 1e-16';
}

done_testing;
