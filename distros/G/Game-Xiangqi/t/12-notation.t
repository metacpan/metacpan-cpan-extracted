use strict;
use warnings;
use Test::More;

use Game::Xiangqi::Engine ':all';
use Game::Xiangqi::Notation;
my $E = 'Game::Xiangqi::Engine';
my $N = 'Game::Xiangqi::Notation';

sub pt { $E->point_of(@_) }
sub mv { $E->move(pt($_[0], $_[1]), pt($_[2], $_[3])) }

# THE LOG STORES ICCS AND CARRIES WXF BESIDE IT. One is parsed, the other is
# only ever written, and the difference is the whole design of this module.

subtest 'ICCS round-trips, and it is what a replay walks' => sub {
    my @cases = (
        [ [7, 2, 4, 2], 'h2e2' ],
        [ [0, 0, 0, 1], 'a0a1' ],
        [ [8, 9, 8, 0], 'i9i0' ],
        [ [4, 0, 4, 1], 'e0e1' ],
    );
    for my $c (@cases) {
        my ($sq, $want) = @$c;
        my $m = mv(@$sq);
        is($N->iccs_of($m), $want, "writes $want");
        is($N->move_of_iccs($want), $m, "  and reads it straight back");
    }

    is($N->move_of_iccs('zz99'),  undef, 'a string that is not a move is refused');
    is($N->move_of_iccs('h2e'),   undef, '  and a truncated one');
    is($N->move_of_iccs('j2e2'),  undef, '  and a file that does not exist');
    is($N->move_of_iccs(undef),   undef, '  and undef');
};

# WXF strings anybody who plays this game will recognise. Hand-derived from the
# rules of the notation, not generated by the code under test.
subtest 'WXF, against strings a player would recognise' => sub {
    my $b = $E->new;
    my @cases = (
        [ [7, 2, 4, 2], 'C2.5', 'the cannon to the centre file, the commonest first move there is' ],
        [ [7, 0, 6, 2], 'H2+3', 'the horse up, and a horse carries its DESTINATION FILE' ],
        [ [8, 0, 8, 1], 'R1+1', 'the chariot up one, and a chariot carries a DISTANCE' ],
        [ [0, 3, 0, 4], 'P9+1', 'a soldier one step' ],
        [ [2, 0, 4, 2], 'E7+5', 'the elephant, which also carries a file' ],
        [ [3, 0, 4, 1], 'A6+5', 'and the advisor' ],
    );
    for my $c (@cases) {
        my ($sq, $want, $why) = @$c;
        is($N->wxf_of($b, mv(@$sq)), $want, "$want: $why");
    }
};

# THE ASSERTION THAT PINS THE RELATIVITY, and it is the reason there is no
# parser. Files run 1 to 9 from THE MOVER'S OWN RIGHT, so the same string means
# two different moves depending on who wrote it.
subtest 'one WXF string, two different moves' => sub {
    my $red = $E->new;
    my $black = $E->new;
    $black->set_side(BLACK);

    my $rm = mv(7, 2, 4, 2);     # red cannon h2 to e2
    my $bm = mv(1, 7, 4, 7);     # black cannon b7 to e7

    is($N->wxf_of($red, $rm),   'C2.5', 'red writes C2.5');
    is($N->wxf_of($black, $bm), 'C2.5', 'and black writes C2.5');
    isnt($N->iccs_of($rm), $N->iccs_of($bm), 'but the moves are not the same move');
    is($N->iccs_of($rm), 'h2e2', '  red played h2e2');
    is($N->iccs_of($bm), 'b7e7', '  and black played b7e7');

    # and the file numbering runs in opposite directions across one board
    is($N->wxf_file(0, RED),   9, 'file a is 9 to Red');
    is($N->wxf_file(0, BLACK), 1, '  and 1 to Black');
    is($N->wxf_file(8, RED),   1, 'file i is 1 to Red');
    is($N->wxf_file(8, BLACK), 9, '  and 9 to Black');
};

subtest 'THE PARSER IS DELIBERATELY MISSING' => sub {
    ok(!Game::Xiangqi::Notation->can('move_of_wxf'),
        'there is no move_of_wxf, and its absence is the design');
    ok(Game::Xiangqi::Notation->can('move_of_iccs'),
        'ICCS is the one that parses');
    like(do { local $/; open my $fh, '<', $INC{'Game/Xiangqi/Notation.pm'} or die; <$fh> },
        qr/no way to spell a WXF move without knowing whose it is/,
        'and the POD says why, where a reader will find it');
};

# Two identical pieces on one file take a marker INSTEAD of a file number,
# because the number cannot tell them apart. FRONT MEANS NEARER THE ENEMY, so
# the order reverses with the colour.
subtest 'two on a file take front and rear, not a file number' => sub {
    my $b = $E->new(empty => 1);
    $b->put(pt(4, 0), RED | GENERAL);
    $b->put(pt(8, 9), BLACK | GENERAL);
    $b->put(pt(0, 2), RED | CHARIOT);      # the rear one
    $b->put(pt(0, 6), RED | CHARIOT);      # the front one, nearer black

    is($N->wxf_of($b, mv(0, 6, 0, 7)), '+R+1', 'the front chariot advances');
    is($N->wxf_of($b, mv(0, 2, 0, 3)), '-R+1', 'and the rear one');
    unlike($N->wxf_of($b, mv(0, 6, 0, 7)), qr/9/,
        'neither carries the file number, which could not tell them apart');

    # and for Black, front is the OTHER way
    my $k = $E->new(empty => 1);
    $k->put(pt(4, 0), RED | GENERAL);
    $k->put(pt(8, 9), BLACK | GENERAL);
    $k->put(pt(0, 2), BLACK | CHARIOT);    # nearer red, so the FRONT one
    $k->put(pt(0, 6), BLACK | CHARIOT);
    $k->set_side(BLACK);
    is($N->wxf_of($k, mv(0, 2, 0, 1)), '+R+1', 'black-s front chariot is the one on rank 2');
    is($N->wxf_of($k, mv(0, 6, 0, 5)), '-R+1', '  and its rear one is on rank 6');
};

subtest 'three or more on a file are numbered from the front' => sub {
    my $b = $E->new(empty => 1);
    $b->put(pt(4, 0), RED | GENERAL);
    $b->put(pt(8, 9), BLACK | GENERAL);
    $b->put(pt(0, 4), RED | SOLDIER);
    $b->put(pt(0, 5), RED | SOLDIER);
    $b->put(pt(0, 6), RED | SOLDIER);

    is($N->wxf_of($b, mv(0, 6, 0, 7)), '1P+1', 'the front soldier is 1');
    is($N->wxf_of($b, mv(0, 5, 0, 6)), '2P+1', '  the next is 2');
    is($N->wxf_of($b, mv(0, 4, 0, 5)), '3P+1', '  and the rear one is 3');

    # five on one file is legal and rare, and the general case is implemented
    # rather than the common one
    $b->put(pt(0, 2), RED | SOLDIER);
    $b->put(pt(0, 3), RED | SOLDIER);
    is($N->wxf_of($b, mv(0, 2, 0, 3)), '5P+1', 'five on a file still numbers correctly');
};

# AFTER + OR -, WHICH PIECES CARRY A DISTANCE AND WHICH CARRY A FILE. Getting
# this backwards produces strings that look right and name the wrong square.
subtest 'a distance for the straight movers, a file for the diagonal ones' => sub {
    my $b = $E->new(empty => 1);
    $b->put(pt(4, 0), RED | GENERAL);
    $b->put(pt(8, 9), BLACK | GENERAL);
    $b->put(pt(0, 0), RED | CHARIOT);
    $b->put(pt(2, 0), RED | HORSE);

    is($N->wxf_of($b, mv(0, 0, 0, 5)), 'R9+5', 'a chariot five ranks up carries the 5');
    is($N->wxf_of($b, mv(2, 0, 3, 2)), 'H7+6', 'a horse carries the destination FILE, 6');
    is($N->wxf_of($b, mv(2, 0, 1, 2)), 'H7+8', '  and 8 the other way');
    is($N->wxf_of($b, mv(0, 0, 4, 0)), 'R9.5', 'and a traverse always carries a file');
};

subtest 'retreat, and a soldier that never can' => sub {
    my $b = $E->new(empty => 1);
    $b->put(pt(4, 0), RED | GENERAL);
    $b->put(pt(8, 9), BLACK | GENERAL);
    $b->put(pt(0, 5), RED | CHARIOT);
    is($N->wxf_of($b, mv(0, 5, 0, 2)), 'R9-3', 'a chariot retreating three');
    is($N->wxf_of($b, mv(0, 5, 0, 8)), 'R9+3', '  and advancing three');

    # black retreats the other way on the board and writes it the same way
    my $k = $E->new(empty => 1);
    $k->put(pt(4, 0), RED | GENERAL);
    $k->put(pt(8, 9), BLACK | GENERAL);
    $k->put(pt(0, 5), BLACK | CHARIOT);
    $k->set_side(BLACK);
    is($N->wxf_of($k, mv(0, 5, 0, 8)), 'R1-3', 'black retreating is UP the board');
    is($N->wxf_of($k, mv(0, 5, 0, 2)), 'R1+3', '  and advancing is down it');
};

# A GAME, IN BOTH NOTATIONS. No published record could be had under a licence
# that allows reproducing it: what exists is databases and viewers rather than
# records offered for reuse, and a game lifted out of one without its terms is
# not a citation. The search was made on 25 Sep 2026 and this is the record of
# it. The line below is therefore HAND-DERIVED and labelled as such.
subtest 'a short game in both notations, hand-derived' => sub {
    my $b = $E->new;
    my @line = (
        [ 'h2e2', 'C2.5' ],     # cannon to the centre
        [ 'h9g7', 'H8+7' ],     # black horse out
        [ 'h0g2', 'H2+3' ],     # red horse out
        [ 'i9h9', 'R9.8' ],     # black chariot across: file i is BLACK's 9
        [ 'i0h0', 'R1.2' ],     # the same squares for red: file i is RED's 1
    );
    my $g = $b->clone;
    for my $step (@line) {
        my ($iccs, $wxf) = @$step;
        my $m = $N->move_of_iccs($iccs);
        ok(scalar(grep { $_ == $m } $g->legal), "$iccs is legal");
        is($N->wxf_of($g, $m), $wxf, "  and reads $wxf");
        is($N->iccs_of($m), $iccs, "  and round-trips as $iccs");
        $g->do_move($m);
    }

    # THE RELATIVITY AGAIN, from the other side of the same fact. The last two
    # moves walk the same two files, i to h, one by each player. Red writes
    # R1.2 and black writes R9.8, because file i is Red's 1 and Black's 9.
    #
    # This expectation was wrong when it was written: R1.2 was predicted for
    # both, on the assumption that "the mover's own right" mirrors to the same
    # number. It does not. Black's file 1 is file a, so the mirror of Red's i0
    # is Black's a9 and not Black's i9.
    is($line[3][1], 'R9.8', 'black on file i writes 9');
    is($line[4][1], 'R1.2', 'and red on file i writes 1');
    is(substr($line[3][0], 0, 1), substr($line[4][0], 0, 1),
        'while the two moves start on the same FILE of the board');
};

done_testing();
