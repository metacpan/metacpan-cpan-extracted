# Claude Code — commit: skills/, agents/, rules/, hooks/, settings.json
# Ignore: local overrides, credentials, session data
.claude/*.local.*
.claude/local/
.claude/.credentials.json
.claude/statsig/
.claude/todos/
.claude/projects/

# karr materialized task view -- never commit
tasks/
config.yml

# skilletor: committe Config + Ignore-Block
!.claude/skilletor.json
!.claude/.gitignore

# Claude Code worktrees (claude --worktree / isolated agents) -- never commit
/.claude/worktrees/

# Perl build artifacts
/DBIO-DB2-*
/.build/
/blib/
/pm_to_blib
/Makefile
/Makefile.old
/Build
/_build/
/MYMETA.*
/META.json
/META.yml
/MANIFEST.bak
/MANIFEST.SKIP.bak
*.html
*.tar.gz
.bash_history
.env

# Editor / OS
*.swp
*.swo
*~
.DS_Store

# Repository-specific
.karr.log
.karr.state
