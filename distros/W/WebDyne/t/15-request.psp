<start_html>
<pre>
Status: <perl handler=status/>
Headers In: <perl handler=headers_in/>
Test No: <?  Test::Builder->new->current_test ?>

__PERL__

use Test::More;
use HTTP::Status qw(HTTP_OK);
use Data::Dumper;

my $self=&self();
my $test_no=$self->r->headers_in('x-test-no');
if ($test_no) {
    Test::Builder->new->current_test($test_no);
}

ok($self, 'self');
foreach my $method (qw(status headers_in method protocol uri)) {
    ok(&{$method}($self), "$method (all)");
}


sub status {

    my $self=shift();
    #diag("status: $self, caller: %s", Dumper([caller()]));
    my $r=$self->r();
    is($r->status, HTTP_OK, 'status');
    is($r->status(HTTP_OK), HTTP_OK, 'status');
    is($r->status(), HTTP_OK, 'status');
    return $r->status();

}

sub headers_in {

    my $self=shift();
    my $r=$self->r();
    is(ref($r->headers_in), 'HTTP::Headers::Fast' );
    is($r->headers_in('x-test-header-req-get'), 'OK');
    is($r->headers_in('X-Test-Header-Req-Get'), 'OK');
    $r->headers_in('X-Test-Header-Req-Set', 'OK');
    is($r->headers_in('X-Test-Header-Req-Set'), 'OK');

}

sub method {

    is(shift()->r->method(), 'GET', 'method');
    
}

sub protocol {

    like(shift()->r->protocol(), qr{^HTTP}, 'protocol');
    
}

sub uri {

    my $r=shift()->r();
    like(ref($r->uri), qr(^URI), 'uri');
    
}

sub path_info {

    my $r=shift()->r();
    diag($r->path_info);
    like($r->path_info, qr{15-request\.psp$});
    
}

__PERL__
__END__
