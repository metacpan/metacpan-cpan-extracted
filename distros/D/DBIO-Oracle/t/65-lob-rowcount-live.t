use strict;
use warnings;

use Test::More;
use Test::Exception;
use DBI;
use DBIO::Optional::Dependencies ();

# LIVE (karr k50). A LOB UPDATE is sent as BEGIN UPDATE ...; END; (see
# DBIO::Oracle::Storage::LOBSupport). DBD::Oracle reports the row count of the
# block -- always 1 -- not that of the UPDATE inside it, so $rs->update lied
# and Row::update's "no row matched" check (zero rows) never fired. The claim:
# the count the storage returns is the one of the inner statement, 0E0 when no
# row matched (core's convention, the zero-but-true of DBI).
#
# Second claim: a table with an auto-increment key and LOB columns, created
# without the key, goes through BEGIN INSERT ... RETURNING ... INTO ?; END;
# and hands the key and the LOBs back.

my ($dsn, $user, $pass) = @ENV{map { "DBIO_TEST_ORA_${_}" } qw/DSN USER PASS/};

plan skip_all => 'Set $ENV{DBIO_TEST_ORA_DSN}, _USER and _PASS to run this test'
  unless $dsn && defined $user && defined $pass;

plan skip_all => 'Test needs '
  . DBIO::Optional::Dependencies->req_missing_for('test_rdbms_oracle')
  unless DBIO::Optional::Dependencies->req_ok_for('test_rdbms_oracle');

alarm 300;

{
  package T::K50::Schema;
  use base 'DBIO::Schema';
  __PACKAGE__->load_components('Oracle');
  __PACKAGE__->storage_type('+DBIO::Oracle::Storage');
}
{
  package T::K50::Result::Doc;
  use base 'DBIO::Core';
  __PACKAGE__->table('k50_live_doc');
  __PACKAGE__->add_columns(
    id   => { data_type => 'integer', is_auto_increment => 1 },
    grp  => { data_type => 'integer' },
    body => { data_type => 'clob', is_nullable => 1 },
    bin  => { data_type => 'blob', is_nullable => 1 },
  );
  __PACKAGE__->set_primary_key('id');
}
T::K50::Schema->register_class(Doc => 'T::K50::Result::Doc');

my $admin = DBI->connect($dsn, $user, $pass, { RaiseError => 1, PrintError => 0, AutoCommit => 1, LongReadLen => 100000 });

plan skip_all => 'This test needs Oracle 12c or later: it creates an IDENTITY column'
  unless $admin->func('ora_server_version')->[0] >= 12;

sub wipe {
  eval { $admin->do('DROP TABLE "k50_live_doc" PURGE'); 1 }
    or $@ =~ /ORA-00942/ or die $@;
}
END { eval { wipe() } if $admin }

wipe();
$admin->do('CREATE TABLE "k50_live_doc" ('
  . ' "id" NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,'
  . ' "grp" NUMBER NOT NULL, "body" CLOB, "bin" BLOB)');

my $schema = T::K50::Schema->connect($dsn, $user, $pass, { quote_char => '"' });
my $rs     = $schema->resultset('Doc');

# create without a key: RETURNING ... INTO inside the block
my @rows;
for my $n (1, 2, 3) {
  my $row;
  lives_ok { $row = $rs->create({ grp => 7, body => "body $n", bin => "bin $n" }) }
    "create $n of a row with an auto-increment key and LOBs lives";
  push @rows, $row;
}
is_deeply [ map { $_ && $_->id } @rows ], [ 1, 2, 3 ], 'the keys the server gave come back';
is_deeply
  $admin->selectall_arrayref('SELECT "id", "body", "bin" FROM "k50_live_doc" ORDER BY "id"'),
  [ map { [ $_, "body $_", "bin $_" ] } 1, 2, 3 ],
  '... and the LOBs are stored under them';

# $rs->update: the count of the UPDATE, not of the block
is $rs->search({ grp => 7 })->update({ body => 'all' }), 3,
  '$rs->update setting a LOB reports the three rows it changed';
is $rs->search({ id => 2 })->update({ body => 'one', bin => 'raw' }), 1,
  '... one row for one';
is $rs->search({ id => 999 })->update({ body => 'none' }), '0E0',
  '... zero-but-true (0E0) when no row matches';
ok !($rs->search({ id => 999 })->update({ body => 'none' }) + 0), '... which is false as a number';

# LOB in SET and in WHERE (the split comparison)
is $rs->search({ id => 1, body => 'all' })->update({ body => 'cmp' }), 1,
  '$rs->update with a LOB in SET and WHERE reports 1';
is $rs->search({ id => 1, body => 'no such' })->update({ body => 'cmp2' }), '0E0',
  '... and 0E0 when the LOB comparison matches nothing';

# $row->update: Row::_update_body dies when no row matched
{
  my $row = $rs->find(3);
  lives_ok { $row->update({ body => 'row update', bin => 'row bin' }) }
    '$row->update setting LOBs lives';
  is $rs->find(3)->body, 'row update', '... and stored it';

  $admin->do('DELETE FROM "k50_live_doc" WHERE "id" = 3');
  throws_ok { $row->update({ body => 'ghost' }) } qr/not found|No row|0 rows|row/i,
    '$row->update of a row that is gone dies instead of reporting success';
}

# a non-LOB update stays a plain statement with its own count
is $rs->search({ grp => 7 })->update({ grp => 8 }), 2, 'a plain update still reports its count';

done_testing;
