use strict;
use warnings;
use Test::More;

use Game::Xiangqi::Engine ':all';
my $E = 'Game::Xiangqi::Engine';

# ---- the opening position, from the Asian Rules chapter 1 section 1 ----------
#
# Thirty-two pieces on named points, hand-written rather than read out of the
# engine that placed them. A table that was generated by board_new would assert
# only that board_new is consistent with itself.

subtest 'the opening position is the one the rules describe' => sub {
    my $b = $E->new;

    my @back = (CHARIOT, HORSE, ELEPHANT, ADVISOR, GENERAL,
                ADVISOR, ELEPHANT, HORSE, CHARIOT);
    for my $f (0 .. 8) {
        is($b->at($E->point_of($f, 0)), RED   | $back[$f], "red back rank file $f");
        is($b->at($E->point_of($f, 9)), BLACK | $back[$f], "black back rank file $f");
    }
    is($b->at($E->point_of(1, 2)), RED   | CANNON, 'red cannon on file b');
    is($b->at($E->point_of(7, 2)), RED   | CANNON, 'red cannon on file h');
    is($b->at($E->point_of(1, 7)), BLACK | CANNON, 'black cannon on file b');
    is($b->at($E->point_of(7, 7)), BLACK | CANNON, 'black cannon on file h');
    for my $f (0, 2, 4, 6, 8) {
        is($b->at($E->point_of($f, 3)), RED   | SOLDIER, "red soldier on file $f");
        is($b->at($E->point_of($f, 6)), BLACK | SOLDIER, "black soldier on file $f");
    }

    my $occupied = grep { $b->at($_) != EMPTY } $E->all_points;
    is($occupied, 32, 'thirty-two pieces and no more');
    is($b->count(RED   | GENERAL), 1, 'one red general');
    is($b->count(BLACK | GENERAL), 1, 'one black general');
    is($b->count(RED   | SOLDIER), 5, 'five red soldiers');
    is($b->side, RED, 'Red moves first, which is the rule and not a choice');
};

# ---- the padded index --------------------------------------------------------

subtest 'point_of and file_of round-trip over all ninety' => sub {
    my %seen;
    for my $r (0 .. 9) {
        for my $f (0 .. 8) {
            my $pt = $E->point_of($f, $r);
            ok(!$seen{$pt}++, "point ($f,$r) is distinct");
            is($E->file_of($pt), $f, "file_of round-trips at ($f,$r)");
            is($E->rank_of($pt), $r, "rank_of round-trips at ($f,$r)");
            ok($E->on_board($pt), "($f,$r) is on the board");
        }
    }
    is(scalar keys %seen, 90, 'ninety distinct points');

    # A POINT IS NOT rank * 9 + file, and this is the assertion that says so.
    isnt($E->point_of(0, 0), 0, 'point_of(0,0) is not index 0');
    is($E->point_of(0, 0), 12, 'it is (0+1)*11 + (0+1)');
    is($E->point_of(8, 9), 10 * 11 + 9, 'and the far corner is 119');
};

subtest 'the sentinel ring reads as BORDER from every edge point' => sub {
    my $b = $E->new(empty => 1);
    my $s = $E->stride;
    my $off = 0;
    for my $r (0 .. 9) {
        for my $f (0 .. 8) {
            my $pt = $E->point_of($f, $r);
            for my $step (-1, 1, -$s, $s, -$s-1, -$s+1, $s-1, $s+1) {
                my $n = $pt + $step;
                next if $E->on_board($n);
                $off++;
                is($b->at($n), BORDER, "neighbour $step of ($f,$r) is BORDER")
                    if $off <= 8;   # naming all of them would be four hundred
            }
        }
    }
    ok($off > 0, "walked $off off-board neighbours, every one a sentinel");

    my $bad = grep { $b->at($_) != BORDER } grep { !$E->on_board($_) } (0 .. 131);
    is($bad, 0, 'every one of the 42 padding cells is BORDER');
};

# The claim xq_abi.h makes and tells phase 03 to check: ONE RING IS ENOUGH. The
# elephant and the horse land two cells away, and neither they nor their
# blocking point ever lands more than one cell outside.
subtest 'one ring of padding is enough for every move in this game' => sub {
    my $s = $E->stride;
    my @elephant = (2*$s+2, 2*$s-2, -2*$s+2, -2*$s-2);
    my @horse    = (2*$s+1, 2*$s-1, -2*$s+1, -2*$s-1, $s+2, $s-2, -$s+2, -$s-2);
    my $worst = 0;
    for my $r (0 .. 9) {
        for my $f (0 .. 8) {
            my $pt = $E->point_of($f, $r);
            for my $d (@elephant, @horse) {
                my $to = $pt + $d;
                next if $to < 0 || $to > 131;
                # how far outside is it? measure in cells from the board edge
                my ($tf, $tr) = ($to % $s, int($to / $s));
                my $out = 0;
                $out = 1 - $tf if $tf < 1;
                $out = $tf - 9 if $tf > 9;
                my $outr = 0;
                $outr = 1 - $tr if $tr < 1;
                $outr = $tr - 10 if $tr > 10;
                $worst = $out  if $out  > $worst;
                $worst = $outr if $outr > $worst;
            }
        }
    }
    is($worst, 1, 'nothing lands more than one cell outside, so one ring holds');
};

# ---- the palace and the river ------------------------------------------------

subtest 'the palace is nine points a side and the river splits forty-five' => sub {
    my @red   = grep { $E->in_palace($_, RED) }   $E->all_points;
    my @black = grep { $E->in_palace($_, BLACK) } $E->all_points;
    is(scalar @red,   9, 'nine points in the red palace');
    is(scalar @black, 9, 'nine points in the black palace');
    is(scalar(grep { $E->in_palace($_, RED) && $E->in_palace($_, BLACK) } $E->all_points),
       0, 'and the two never overlap');

    for my $pt (@red) {
        my ($f, $r) = ($E->file_of($pt), $E->rank_of($pt));
        ok($f >= 3 && $f <= 5 && $r >= 0 && $r <= 2, "red palace point ($f,$r) is in the corner");
    }

    my @crossed_r = grep { $E->crossed_river($_, RED) }   $E->all_points;
    my @crossed_b = grep { $E->crossed_river($_, BLACK) } $E->all_points;
    is(scalar @crossed_r, 45, 'forty-five points are across the river for Red');
    is(scalar @crossed_b, 45, 'and forty-five for Black');
    is(scalar(grep { $E->crossed_river($_, RED) && $E->crossed_river($_, BLACK) } $E->all_points),
       0, 'and no point is across it for both');
};

# ---- put and lift judge nothing ----------------------------------------------

subtest 'put and lift are structure primitives and have no opinion' => sub {
    my $b = $E->new(empty => 1);
    # three generals, one of them outside its own palace. All legal to PUT.
    $b->put($E->point_of(0, 0), RED | GENERAL);
    $b->put($E->point_of(4, 5), RED | GENERAL);
    $b->put($E->point_of(8, 9), RED | GENERAL);
    is($b->count(RED | GENERAL), 3, 'three red generals, and the engine did not care');
    ok(!$E->in_palace($E->point_of(4, 5), RED), 'one of them is nowhere near a palace');

    $b->lift($E->point_of(4, 5));
    is($b->count(RED | GENERAL), 2, 'lift took it off');
    is($b->at($E->point_of(4, 5)), EMPTY, 'and left the point empty');

    # putting onto an occupied point replaces rather than stacks
    $b->put($E->point_of(0, 0), BLACK | CANNON);
    is($b->at($E->point_of(0, 0)), BLACK | CANNON, 'put replaces what was there');
    is($b->count(RED | GENERAL), 1, 'and the old piece is gone, not hidden');
};

subtest 'the constants agree with the C encoding' => sub {
    my $b = $E->new(empty => 1);
    my $pt = $E->point_of(4, 0);
    $b->put($pt, RED | CHARIOT);
    is($b->at($pt), RED | CHARIOT, 'a piece built from the constants reads back');
    is(Game::Xiangqi::Engine::kind_of($b->at($pt)),   CHARIOT, 'kind_of splits it');
    is(Game::Xiangqi::Engine::colour_of($b->at($pt)), RED,     'colour_of splits it');
    is(Game::Xiangqi::Engine::other(RED), BLACK, 'and other flips the colour');
    isnt(BORDER & (RED | BLACK), BORDER, 'BORDER carries no colour bit');
    is(BORDER & 7, 0, 'and no kind bits, so a sentinel is never a piece');
};

subtest 'a copy shares nothing' => sub {
    my $a = $E->new;
    my $c = $a->clone;
    is($c->to_fen, $a->to_fen, 'the copy starts identical');
    $c->lift($E->point_of(0, 0));
    isnt($c->to_fen, $a->to_fen, 'and moving on one does not touch the other');
    is($a->at($E->point_of(0, 0)), RED | CHARIOT, 'the original still has its chariot');
};

done_testing();
