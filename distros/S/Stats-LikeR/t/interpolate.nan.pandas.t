sub same {
	my ($got, $exp, $label) = @_;
	return 0 unless @$got == @$exp;
	for my $i (0 .. $#$exp) {
		my ($g, $e) = ($got->[$i], $exp->[$i]);
		if (!defined $e) {  # pandas left a NaN
			return 0 unless !defined $g || isnan($g);
		} else {
			return 0 unless defined $g && !isnan($g)
			             && abs($g - $e) <= 1e-9 * (1 + abs $e);
		}
	}
	return 1;
}

my $bad = 0;
for my $c (@CASES) {
	my ($method, $order, $limit, $dir, $area, $in, $exp) = @$c;
	my @args = (method => $method);
	push @args, order => $order if defined $order;
	push @args, limit => $limit if defined $limit;
	push @args, limit_direction => $dir if defined $dir;
	push @args, limit_area => $area if defined $area;
	my $label = "$method order=" . ($order // '-') . " limit=" . ($limit // '-')
	          . " dir=" . ($dir // '-') . " area=" . ($area // '-') . " [@{[ map { $_ // 'NA' } @$in ]}]";
	my %variant = (
		undef => [ @$in ],
		nan   => [ map { defined $_ ? $_ : $NaN } @$in ],
		mixed => [ map { defined $in->[$_] ? $in->[$_] : ($_ % 2 ? $NaN : undef) } 0 .. $#$in ],
	);
	for my $v (sort keys %variant) {
		my $in_copy = [ @{ $variant{$v} } ];
		my $got = interpolate({ v => $in_copy }, @args)->{v};
		my $ok = same($got, $exp);
		# an unfilled gap must come back as it went in (undef stays undef, NaN stays NaN)
		if ($ok) {
			for my $i (0 .. $#$exp) {
				next if defined $exp->[$i];
				my ($g, $w) = ($got->[$i], $variant{$v}[$i]);
				$ok = 0 if defined $g != defined $w;
			}
		}
		unless ($ok) {
			$bad++;
			diag "$v: $label\n  got [@{[ map { $_ // 'undef' } @$got ]}]\n  exp [@{[ map { $_ // 'undef' } @$exp ]}]"
				if $bad <= 10;
		}
	}
}
is($bad, 0, scalar(@CASES) . " pandas cases x 3 gap spellings: all match");

# the cases from the audit, spelled out
{
	my $r = interpolate({ v => [1, undef, 3, $NaN, 5, undef, 7, 8, 9] }, method => 'cubic')->{v};
	ok(!grep({ !defined $_ || isnan($_) || abs($r->[$_] - ($_ + 1)) > 1e-9 } 0 .. 8),
	   "cubic: a NaN cell among the anchors is a gap and the cubic y = x + 1 is recovered")
		or diag "@$r";
	$r = interpolate({ v => [1, undef, $NaN, undef, 5, 6, 7, 8] })->{v};
	is_deeply($r, [1, 2, 3, 4, 5, 6, 7, 8], "linear: a run of undef, NaN, undef is one gap");
	$r = interpolate({ v => [$NaN, $NaN, $NaN] })->{v};
	ok(isnan($_), "an all-NaN column stays NaN") for @$r;
	$r = interpolate([ { v => 1 }, { v => $NaN }, { v => 3 } ]);
	is($r->[1]{v}, 2, "AoH: NaN cell is filled");
	$r = interpolate([ [1], [$NaN], [3] ]);
	is($r->[1][0], 2, "AoA: NaN cell is filled");
	# a string that parses as NaN is a gap too
	$r = interpolate({ v => [1, "nan", 3] })->{v};
	is($r->[1], 2, "the string 'nan' is a gap");
}

# a NaN in the index croaks, as pandas' NotImplementedError does
for my $m (qw(index linear cubic)) {
	my $ok = eval { interpolate({ v => [1, undef, 3, 4, 5] }, method => $m, x => [0, 1, $NaN, 3, 4]); 1 };
	ok(!$ok && $@ =~ /'x' coordinates must not be NaN/, "x with a NaN croaks, method $m")
		or diag $@;
}
{
	my $ok = eval { interpolate({ v => [1, undef, 3], t => [0, $NaN, 2] }, method => 'index', x => 't'); 1 };
	ok(!$ok && $@ =~ /must not be NaN/, "x column with a NaN croaks");
}

# ip_far() is O(n): a long gap run with a huge limit must finish at once and
# select the cells pandas' window rule selects (every gap within limit of an
# anchor).  With O(n * limit) this was 4 s at these sizes.
{
	my ($n, $lim) = (200000, 100000);
	for my $c ([ both => $n < 2 * $lim ? $n : 2 * $lim ], [ forward => $lim ], [ backward => $lim ]) {
		my ($dir, $want) = @$c;
		my @v = (1, (undef) x $n, 2);
		my $r = interpolate({ v => \@v }, limit => $lim, limit_direction => $dir)->{v};
		my $filled = grep { defined $_ } @{$r}[1 .. $n];
		# forward fills from the left anchor only; backward from the right one
		is($filled, $want, "long run, limit $lim, $dir: $want gaps filled");
	}
	# hand-worked: 5 gaps, anchor, 20 gaps, anchor, 5 gaps; only gaps within 3
	# of an anchor are filled, so each run keeps its far end blank
	my @v = ((undef) x 5, 1, (undef) x 20, 2, (undef) x 5);
	my $r = interpolate({ v => \@v }, limit => 3, limit_direction => 'both')->{v};
	is(join('', map { defined $_ ? 1 : 0 } @$r),
	   '00111' . '1' . '111' . ('0' x 14) . '111' . '1' . '11100',
	   "limit 3 both: three gaps filled beside each anchor");
}

done_testing;
