^Makefile\.old$
^blib/
^pm_to_blib$
^MYMETA\.
\.o$
\.bs$
^Business\.c$
^Time-Keeper-Business-
\.tar\.gz$
^ignore\.txt$
^\.git
~$
\.swp$
^MANIFEST\.bak$
