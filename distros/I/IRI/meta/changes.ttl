	.

my:project
	a 							doap:Project ;
	doap:name					"IRI" ;
	doap:shortdesc				"A Perl implementation of Internationalized Resource Identifiers (IRIs)"@en ;
	doap:programming-language	"Perl" ;
	doap:created				"2014-07-23"^^xsd:date ;
	doap:maintainer				my:developer ;
	doap:developer				my:developer ;
	doap:documenter				my:developer ;
	doap:tester					my:developer ;
	doap:homepage				<http://search.cpan.org/dist/IRI/> ;
	doap:bug-database			<https://github.com/kasei/perl-iri/issues> ;
	doap:download-page			<https://metacpan.org/release/IRI/> ;
	doap:download-mirror		<http://kasei.us/code/files/> ;
	doap:license				<http://dev.perl.org/licenses/> ;
	doap:release				my:v_0-01 , my:v_0-02 , my:v_0-03 , my:v_0-04 , my:v_0-05 ,
								my:v_0-06 , my:v_0-07 , my:v_0-08 , my:v_0-09 , my:v_0-10 ,
								my:v_0-11 , my:v_0-12 , my:v_0-13 , my:v_0-14 , my:v_0-15 ,
