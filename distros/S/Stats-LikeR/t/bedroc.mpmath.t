#!/usr/bin/env perl
# bedroc()'s BEDROC, RIE, rie_min and rie_max against Truchon & Bayly (2007)
# eq. 36 evaluated as written in mpmath 1.3.0 at mp.dps = 60, across alpha
# from 1e-8 to 1500.
#
# The values in cases() are frozen from t/bedroc.mpmath.py; to regenerate
# them, run it from the distribution root and paste its output over the body
# of cases():
#
#   python3 t/bedroc.mpmath.py
#
# Up to 0.3217 bedroc() evaluated eq. 36 as written, in an NV.  On the first
# data set below that gave 0.87376 at alpha = 1e-4, 1200.75 at 1e-6, Inf at
# 1e-8 and NaN at 1500, where the exact values are 0.874998, 0.87499998,
# 0.8749999998 and 1.  It now evaluates an algebraically equal form, derived in
# the comment in bedroc() in LikeR.xs, that neither cancels nor overflows.
require 5.010;
use strict;
use warnings FATAL => 'all';
use Stats::LikeR;
use Test::More;

# Relative to the value, or absolute where it is below 1.  The worst error seen
# on perl-5.44.0 (double) was 2.2e-16, one ulp; this leaves 45 times that.  A
# long-double or quadmath build computes closer than a double and is limited
# by the 20 digits each value is frozen to (5e-20), far inside the bound.
my $TOL = 1e-14;
# rie_min falls below the smallest NV at alpha = 1500 (1.5e-434 on the first
# data set), where a double build gives 0 and a long-double build the value;
# below this absolute floor any answer in [0, floor] is right.
my $FLOOR = 1e-290;

sub close_enough {
	my ($got, $want) = @_;
	return 0 unless defined $got && $got == $got;	#NaN fails
	my $diff = abs($got - $want);
	return 1 if abs($want) < $FLOOR && abs($got) < $FLOOR;
	return $diff <= $TOL * (abs($want) > 1 ? abs($want) : 1);
}

my $worst = 0;
for my $c (cases()) {
	for my $a (sort { $a <=> $b } keys %{ $c->{alpha} }) {
		my ($b, $rie, $rmin, $rmax) = @{ $c->{alpha}{$a} };
		my $r = bedroc($c->{scores}, $c->{labels}, alpha => $a);
		my %want = (bedroc => $b, rie => $rie, rie_min => $rmin, rie_max => $rmax);
		for my $k (qw(bedroc rie rie_min rie_max)) {
			my $w = $want{$k};
			my $g = $r->{$k};
			if (abs($w) >= $FLOOR && defined $g) {
				my $e = abs($g - $w) / (abs($w) > 1 ? abs($w) : 1);
				$worst = $e if $e > $worst;
			}
			ok(close_enough($g, $w), "$c->{name}: $k at alpha $a")
				or diag("got $g, want $w");
		}
	}
}
diag("worst error: $worst (limit $TOL)");
done_testing();

