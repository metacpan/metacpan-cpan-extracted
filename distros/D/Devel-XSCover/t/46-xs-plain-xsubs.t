    int x
PPCODE:
{
    XSRETURN_IV(x);
}

int oneline(x)
    int x
  CODE:
    RETVAL = x;
  OUTPUT:
    RETVAL

INCLUDE: frag.xs
XS

put('frag.xs', <<'XS');
