sub card_ref { my ($r) = @_; "**$r->{repo}{name} k$r->{card}{id}**" }

sub card_head {
  my ($r) = @_;
  my $c = $r->{card};
  sprintf '%s (%s · %s) %s', card_ref($r), $c->{status}, $c->{priority} // '-', $c->{title};
}

sub claim_text {
  my ($r) = @_;
  my $c = $r->{card};
  return 'kein Claim' unless $c->{claim};
  my $cl = $c->{claim};
  sprintf 'Claim %s (%s alt, %s, Timeout %s)', $cl->{by}, fmt_age($cl->{age}),
    $cl->{live} ? 'lebend' : 'ABGELAUFEN', $r->{repo}{board}{claim_timeout_text};
}

sub say_list {
  my ($empty, @lines) = @_;
  print @lines ? join('', map { "$_\n" } @lines) : "$empty\n";
  print "\n";
}

