[%- WRAPPER 'web/en/layouts/default.html.tt' -%]

<style>
  .map-panel {
    background: var(--card-bg, #fff);
    border: 1px solid var(--border, #d8dee9);
    border-radius: 8px;
    padding: 0.5rem;
    margin: 0.75rem 0 1rem;
  }
  .map-panel #search-box {
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--border, #c3cad6);
    border-radius: 4px;
    min-width: 16rem;
  }
  .map-panel #reset-button,
  .map-panel #clear-search-button {
    border: 1px solid var(--border, #c3cad6);
    border-radius: 4px;
    background: var(--page-bg, #f4f6f9);
  }
  .map-notes {
    margin: 0.5rem 0 0;
    padding: 0.5rem 0.75rem;
    border-left: 3px solid var(--warning-border, #c9a227);
    background: var(--warning-bg, #fdf8e6);
    font-size: 0.88rem;
    color: var(--warning-fg, #5c4a11);
  }
  .map-notes ul { margin: 0; padding-left: 1.1rem; }
  .map-unplotted { margin: 0.35rem 0 0.15rem; }
  .map-unplotted summary { cursor: pointer; text-decoration: underline; }
  .map-unplotted-table { border-collapse: collapse; margin-top: 0.35rem; font-size: 0.85rem; }
  .map-unplotted-table th,
  .map-unplotted-table td { text-align: left; padding: 0.15rem 0.75rem 0.15rem 0; vertical-align: top; }
  .map-unplotted-table td.num { white-space: nowrap; }
  .map-unplotted-table a,
  .map-unplotted-all { color: var(--accent-text, #2c3e7a); text-decoration: underline; font-weight: 600; }
  .map-unplotted-all { display: inline-block; margin: 0.3rem 0 0; }
  .map-groups-why { margin: 0.35rem 0; font-size: 0.85rem; max-width: 60rem; }
  .map-summary {
    font-size: 0.85rem;
    color: var(--text-secondary, #555);
    margin: 0.25rem 0 0;
  }
  .chart-source {
    margin: 0.25rem 0 0;
    font-size: 0.82rem;
    color: var(--muted, #666);
    word-break: break-all;
  }
  .chart-source a { color: inherit; }
  .map-progress {
    margin: 0.5rem 0 0.75rem;
    padding: 0.6rem 0.75rem;
    border-left: 3px solid var(--info-border, #2980b9);
    background: var(--info-bg, #eaf4fb);
    color: var(--info-fg, #1a5276);
    font-size: 0.9rem;
  }
  .map-progress-text { margin: 0 0 0.4rem; overflow-wrap: anywhere; }
  .map-progress-row { display: flex; align-items: center; gap: 0.75rem; }
  .map-progress-track {
    flex: 1;
    height: 0.6rem;
    border-radius: 0.3rem;
    background: var(--card-bg, #fff);
    border: 1px solid var(--info-border, #2980b9);
    overflow: hidden;
  }
  .map-progress-fill {
    width: 0;
    height: 100%;
    background: var(--link, #0d6efd);
    transition: width 0.2s ease;
  }
  .map-progress-note { margin: 0.4rem 0 0; font-size: 0.82rem; }
  .map-progress-note:empty { display: none; }
  .map-retry { color: var(--accent-text, #2c3e7a); text-decoration: underline; font-weight: 600; }
</style>

<nav class="back-link" aria-label="Breadcrumb">[% PROCESS "web/en/layouts/breadcrumb.html.tt" %]</nav>
[% PROCESS "web/en/layouts/view_context.html.tt" %]

<h2 class="graph-title">[% title | html %]</h2>

[% IF geocode_pending %]
<div class="map-progress" id="map-progress" role="status" aria-live="polite"
     data-done-url="[% geocode_done_url | html %]" data-cached-url="[% geocode_cached_url | html %]">
  <p class="map-progress-text" id="map-progress-text">Looking up
    [%- IF geocode_places %] [% geocode_places %] place[% geocode_places == 1 ? '' : 's' %][% END %]
    [%- IF geocode_places && geocode_outlines %] and[% END %]
    [%- IF geocode_outlines %] [% geocode_outlines %] [% bounds_noun | html %] outline[% geocode_outlines == 1 ? '' : 's' %][% END %]
    that [% geocode_pending == 1 ? 'is' : 'are' %] not in the cache yet&hellip;</p>
  <div class="map-progress-row">
    <div class="map-progress-track" role="progressbar" id="map-progress-bar"
         aria-label="Lookups done" aria-valuemin="0" aria-valuemax="[% geocode_pending %]" aria-valuenow="0">
      <div class="map-progress-fill" id="map-progress-fill"></div>
    </div>
    <button type="button" class="btn-secondary" id="map-progress-cancel">Cancel</button>
  </div>
  <p class="map-progress-note" id="map-progress-note"></p>
  <noscript><p class="map-progress-note"><a class="map-retry" href="[% geocode_wait_url | html %]">Look them up and draw the map</a> (the page waits until they are all done).</p></noscript>
</div>
<script nonce="[% csp_nonce | html %]" type="application/json" id="map-pending">[% geocode_pending_json %]</script>
<script nonce="[% csp_nonce | html %]">
(function () {
  var box = document.getElementById('map-progress');
  if (!box) return;
  var list;
  try { list = JSON.parse(document.getElementById('map-pending').textContent); } catch (e) { return; }
  var text   = document.getElementById('map-progress-text');
  var bar    = document.getElementById('map-progress-bar');
  var fill   = document.getElementById('map-progress-fill');
  var note   = document.getElementById('map-progress-note');
  var cancel = document.getElementById('map-progress-cancel');
  var doneUrl = box.getAttribute('data-done-url');
  var cachedUrl = box.getAttribute('data-cached-url');
  var index = 0, found = 0, missing = 0, unsettled = 0, online = true;
  // OpenStreetMap failing once stops the online lookups of places, so that a
  // service that is down does not hold up each place left.  An outline is a
  // larger answer, and one slow reply is not a service that is down: those
  // stop after OUTLINE_FAILURES in a row.
  var OUTLINE_FAILURES = 3, outlineFailures = 0;
  var stopped = false, controller = null, message = '';

  function show(done) {
    bar.setAttribute('aria-valuenow', String(done));
    fill.style.width = (list.length ? (100 * done / list.length) : 100) + '%';
  }

  function counts() {
    var parts = [];
    if (found) parts.push(found + ' found');
    if (missing) parts.push(missing + ' not found');
    if (unsettled) parts.push(unsettled + ' left for later');
    return parts.join(', ');
  }

  // A place the server could not settle (not answered, or not saved) is
  // still not in the cache, so drawing the page again without geocode=cached
  // would only start the same run again.
  function finish() {
    stopped = true;
    cancel.disabled = true;
    text.textContent = 'Drawing the map\u2026';
    window.location.replace(unsettled ? cachedUrl : doneUrl);
  }

  function next() {
    if (stopped) return;
    if (index >= list.length) { finish(); return; }

    var item = list[index];
    // A place to geocode, or a point whose outline is wanted.
    var outline = Object.prototype.hasOwnProperty.call(item, 'point');
    text.textContent = 'Looking up ' + (index + 1) + ' of ' + list.length + ': '
      + (outline ? 'the outline at ' + item.point : item.place);

    var body = new URLSearchParams();
    if (outline) {
      body.append('point', item.point);
      body.append('level', item.level);
    } else {
      body.append('place', item.place);
    }
    body.append('sig', item.sig);
    if (!online) body.append('online', '0');

    controller = window.AbortController ? new AbortController() : null;
    fetch(outline ? '/geo/boundary' : '/geo/lookup', {
      method: 'POST',
      body: body,
      headers: { 'Accept': 'application/json' },
      signal: controller ? controller.signal : undefined
    }).then(function (res) {
      return res.json();
    }).then(function (reply) {
      if (stopped) return;
      if (reply.status === 'found' && reply.stored) found++;
      else if ((reply.status === 'not_found' || reply.status === 'nowhere') && reply.stored) missing++;
      else if (reply.status !== 'refused') unsettled++;
      if (outline) {
        outlineFailures = reply.online_failed ? outlineFailures + 1 : 0;
        if (outlineFailures >= OUTLINE_FAILURES) online = false;
      } else if (reply.online_failed) {
        online = false;
      }
      if (reply.messages && reply.messages.length) message = reply.messages[reply.messages.length - 1];
      else if (reply.error) message = reply.error;
      advance();
    }, function () {
      if (stopped) return;
      unsettled++;
      advance();
    });
  }

  function advance() {
    index++;
    show(index);
    var c = counts();
    note.textContent = (c ? c + '. ' : '') + message;
    next();
  }

  cancel.addEventListener('click', function () {
    if (stopped) return;
    stopped = true;
    cancel.disabled = true;
    if (controller) controller.abort();
    text.textContent = 'Canceled; drawing the map with the places found so far\u2026';
    window.location.replace(cachedUrl);
  });

  show(0);
  next();
})();
</script>
[% ELSIF messages.size %]
<div class="map-notes" role="status">
  <ul>
    [%- FOREACH message IN messages %]
    <li class="map-note" data-key="[% message.key | html %]">[% message.text | html %]
      [%- IF message.key == 'warn_map_rows_skipped' && unplotted_url.length %]
      <br><a class="map-unplotted-all" href="[% unplotted_url | html %]">Show the [% unplotted_rows %] row[% unplotted_rows == 1 ? '' : 's' %] that [% unplotted_rows == 1 ? 'was' : 'were' %] not plotted in the table</a>
      [%- END %]
      [%- IF message.key.match('^warn_map_bounds_') && bounds_left_url.length %]
      <br><a class="map-unplotted-all" id="map-bounds-left" href="[% bounds_left_url | html %]">Show the [% bounds_left_rows %] row[% bounds_left_rows == 1 ? '' : 's' %] with no [% bounds_noun | html %] outline in the table</a>
      [%- END %]
      [%- IF message.key == 'warn_map_bounds_pending' && bounds_retry_url.length %]
      <br><a class="map-retry" id="map-bounds-retry" href="[% bounds_retry_url | html %]">Look up the outline[% bounds_left == 1 ? '' : 's' %] not looked up yet</a>
      [%- END %]
      [%- IF message.key == 'warn_map_rows_skipped' && geocode_retry_url.length %]
      <br><a class="map-retry" id="map-retry" href="[% geocode_retry_url | html %]">Look up the places not looked up yet</a>
      [%- END %]
      [%- IF message.key == 'warn_map_rows_skipped' && unplotted.size %]
      <details class="map-unplotted">
        <summary>List the [% unplotted.size %] place[% unplotted.size == 1 ? '' : 's' %] that [% unplotted.size == 1 ? 'was' : 'were' %] not plotted</summary>
        [%- SET why = {
          empty     => 'No place in the row',
          refused   => 'Not a place name (a bare number)',
          not_found => 'Not found',
          later     => 'Not looked up yet; it will be tried next time',
        } %]
        [%- IF geocode_retry_url.length; why.later = 'Not looked up yet'; END %]
        <table class="map-unplotted-table">
          <thead><tr><th scope="col">Place</th><th scope="col">Rows</th><th scope="col">Why</th></tr></thead>
          <tbody>
          [%- FOREACH u IN unplotted %]
          <tr data-reason="[% u.reason | html %]">
            <td>[% IF u.place.length %][% u.place | html %][% ELSE %]<em>(empty)</em>[% END %]</td>
            <td class="num">[% IF u.url %]<a href="[% u.url | html %]" title="Show these rows in the table">[% u.rows %] row[% u.rows == 1 ? '' : 's' %]</a>[% ELSE %][% u.rows %][% END %]</td>
            <td>[% why.${u.reason} | html %]</td>
          </tr>
          [%- END %]
          </tbody>
        </table>
      </details>
      [%- END %]
    </li>
    [%- END %]
  </ul>
</div>
[% END %]

[% UNLESS geocode_pending && !marker_count %]
<p class="map-summary">Plotting [% marker_count %] marker[% marker_count == 1 ? '' : 's' %] for [% row_count %] of [% source_rows %] row[% source_rows == 1 ? '' : 's' %][% IF loc_col %] from column[% loc_many ? 's' : '' %] [% loc_col | html %][% IF loc_text.length %] with &ldquo;[% loc_text | html %]&rdquo; added[% END %][% END %][% IF lat_col %] from columns [% lat_col | html %] and [% lon_col | html %][% END %][% IF backend %]; resolved by [% backend | html %][% END %][% IF bounds_drawn %], with [% bounds_drawn %] [% bounds_noun | html %] outline[% bounds_drawn == 1 ? '' : 's' %][% IF bounds_shade.length && bounds_shade_as == 'markers' %] shaded by [% bounds_shade | html %] in the colors of the markers in them, stronger the further into each color's range[% ELSIF bounds_shade.length %] shaded by [% bounds_shade | html %], darker for more[% IF bounds_as_markers %], and outlined in the colors of the markers in them[% END %][% ELSIF bounds_as_markers %] colored as the markers in them[% ELSIF bounds_heat %] colored by [% IF bounds_weight.length %][% bounds_weight | html %], from green (least) to red (most)[% ELSE %]rows, from green (fewest) to red (most)[% END %][% END %][% END %].</p>
[%- IF bounds_groups.size %]
[%- SET shared = 0; SET shared_markers = 0; SET none_markers = 0 %]
[%- FOREACH g IN bounds_groups; IF g.none; none_markers = g.markers; ELSE; shared = shared + 1; shared_markers = shared_markers + g.markers; END; END %]
<details class="map-unplotted" id="map-bounds-groups">
  <summary>[% IF shared %][% shared_markers %] markers share [% shared %] [% bounds_noun | html %] outline[% shared == 1 ? '' : 's' %][% END %][% IF shared && none_markers %], and [% END %][% IF none_markers %][% none_markers %] marker[% none_markers == 1 ? ' is' : 's are' %] in no [% bounds_noun | html %] outline[% END %]: list them</summary>
  [%- IF loc_col %]
  <p class="map-groups-why">These places were looked up by name, and a name can be ambiguous: a lookup may answer with another place of the same name, or a street or town named after it. Two places in one outline, or a place in none, can be such a wrong answer; they can also be right, when the places really are in the same [% bounds_noun | html %]. Adding more to each place, or giving latitude and longitude columns, makes a lookup surer.</p>
  [%- END %]
  <table class="map-unplotted-table">
    <thead><tr><th scope="col">Outline</th><th scope="col">Markers</th><th scope="col">Rows</th><th scope="col">Places</th></tr></thead>
    <tbody>
    [%- FOREACH g IN bounds_groups %]
    <tr[% IF g.none %] data-none="1"[% END %]>
      <td>[% IF g.none %]<em>(in no [% bounds_noun | html %] outline)</em>[% ELSE %][% g.name | html %][% END %]</td>
      <td class="num">[% g.markers %]</td>
      <td class="num">[% IF g.url.length %]<a href="[% g.url | html %]" title="Show these rows in the table">[% g.rows %] row[% g.rows == 1 ? '' : 's' %]</a>[% ELSE %][% g.rows %][% END %]</td>
      <td>[% FOREACH place IN g.places %][% IF loop.index < 12 %][% place | html %][% UNLESS loop.last %], [% END %][% ELSIF loop.index == 12 %]&hellip;[% END %][% END %]</td>
    </tr>
    [%- END %]
    </tbody>
  </table>
</details>
[%- END %]
[% END %]

[% IF map_body %]
<div class="map-panel">
  [% map_body %]
</div>
[% END %]

[% IF source_url %]
<p class="chart-source">Source: <a href="[% source_url | html %]" rel="noopener noreferrer">[% source_url | html %]</a></p>
<p class="chart-source">Accessed on [% source_accessed | html %]</p>
[% END %]

[%- END -%]
