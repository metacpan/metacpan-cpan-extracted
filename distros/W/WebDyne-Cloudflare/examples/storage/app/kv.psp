<start_html title="WebDyne Cloudflare KV" h2>
<p>Save a greeting, then refresh to read it through the native KV binding.</p>
<form method="post">
  <button type="submit" name="save" value="1">Save greeting</button>
</form>
<perl handler="greeting"><p>${message}</p></perl>
<p><a href="d1.psp">D1 example</a></p>

__PERL__

use WebDyne::Cloudflare::KV;

sub greeting {
    my ($self)=@_;
    my $service_or=WebDyne::Cloudflare::KV->new(
        scope   => $self->r()->{'scope'},
        binding => 'CACHE',
    );
    my $cgi_or=$self->CGI();
    if (($cgi_or->request_method() eq 'POST')&&$cgi_or->param('save')) {
        $service_or->put('webdyne-example-greeting', 'Hello from WebDyne and KV!')->get();
    }
    my $message=$service_or->get('webdyne-example-greeting')->get();
    $message='No greeting saved yet (KV updates may take a little time to become visible).'
        unless defined($message);
    return $self->render(message => $self->html_tiny()->entity_encode($message));
}
