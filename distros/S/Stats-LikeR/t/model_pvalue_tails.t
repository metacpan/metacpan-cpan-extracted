#!/usr/bin/env perl
#
# Upper-tail p-values for aov, anova, lm and glm.
#
# All four used to build their p-value by subtracting from 1 --
# `1 - pf(F, df1, df2)` for the three F tests, `2 * (1 - pnorm(|z|))` for glm's
# Wald z -- which has no resolution below the ulp of 1.0. Every p-value past
# about 1e-16 came back as a flat 0, and precision was already eroding from
# roughly 1e-9 down. They now use pf_upper() and 2 * pnorm(-|z|), which stay in
# the tail throughout.
#
# Two kinds of assertion per case:
#
#   * expected_p  -- scipy.stats.f.sf / norm.sf evaluated at THIS module's own
#     F or z. That isolates the tail computation: it holds to 1e-12 regardless
#     of any difference in how the statistic itself was reached, and it is the
#     assertion that fails outright if the `1 - ...` form ever comes back.
#   * r_p / r_stat -- R 4.6.1 end to end (anova(aov()), anova(lm()),
#     summary(lm())$fstatistic, summary(glm())$coefficients). Tolerances here
#     are per-case, and looser where the statistic itself differs from R; see
#     the note on glm below.
#
# glm: the Wald z from IRLS differs from R in the 6th to 8th significant digit
# (poisson with a strong effect is the worst at 1.5e-5), and a p-value that far
# out amplifies that -- a 1.5e-5 error in z = 37 moves p by 2%. That is an
# upstream difference in the fit, not in the tail: given the same z, the
# p-value here matches scipy to under an ulp, which is what expected_p pins.

require 5.010;
use warnings FATAL => 'all';
use strict;
use Stats::LikeR;
use Test::More;

# The regression guard. Where the reference is a positive number, a 0 here
# means the `1 - ...` form is back. Where |z| is so large that 2*pnorm(-|z|)
# underflows a double even computed correctly -- R and scipy return 0 too --
# anything at or above DBL_MIN would be wrong.
#
# Not `is($got, 0)`: a perl whose NV is a long double has exponent range to
# spare below where the double that the reference implementations (and erfc())
# work in gives out, so a tail this far out can come back as a number there
# rather than a flat 0 -- and did, as 1e-600 out of glibc's i386 erfc(). Below
# DBL_MIN there is no accuracy left to hold the module to; the assertion is
# that the tail underflowed, not which side of it perl landed on.
sub undeflow_ok {
	my ($got, $exp, $lbl) = @_;
	return ok($got > 0, "$lbl: p-value did not underflow to 0") if $exp > 0;
	return cmp_ok($got, '<', 2.2250738585072014e-308,  # DBL_MIN
		"$lbl: p-value underflows, as it does in R and scipy");
}

# How much a tiny difference in the statistic moves the p-value.
#
# The expected_p values below were evaluated at the F or z THIS build produced
# on one machine. A different perl, compiler or libm reaches a statistic that
# differs in the last few digits -- between perl 5.10.1 and 5.44.0 on identical
# data, lm's Householder QR differs by 6e-13 relative -- and the tail multiplies
# that by d(log p)/d(log statistic). For the upper F tail p ~ F^(-df2/2), so the
# factor is df2/2; for the normal tail 2*pnorm(-z), it is z^2. Budget 2e-12 of
# statistic wobble and scale by the factor, so the check stays tight where the
# tail is shallow and loosens only where it genuinely amplifies.
# `cond` is ||y|| / ||residual||, carried per case below. A model that fits
# almost perfectly leaves a residual many orders below the response's own
# spread, so forming it loses digits to cancellation, and the statistic is only
# good to about cond * eps relative. That is a real numerical bound, not a fudge:
# anova_seq_noise1e-05 has cond = 1.4e7, and a long-double NV perl
# ($Config{nvtype} eq 'long double', which 5.12.5 is) lands 4.4e-10 from an
# ordinary double build on identical source data -- inside the bound, and 200x
# outside a flat 2e-12. Well-conditioned cases keep the 2e-12 floor.
sub stat_budget {
	my ($cond) = @_;
	my $b = ($cond || 1) * 1e-15;
	return $b > 2e-12 ? $b : 2e-12;
}
sub f_tail_tol {
	my ($df2, $cond) = @_;
	my $t = stat_budget($cond) * $df2 / 2;
	return $t > 1e-12 ? $t : 1e-12;
}
sub z_tail_tol {
	my ($z, $cond) = @_;
	my $t = stat_budget($cond) * abs($z) * abs($z);
	return $t > 1e-12 ? $t : 1e-12;
}

sub rel_ok {
	my ($got, $exp, $lbl, $tol) = @_;
	$tol = 1e-12 unless defined $tol;
	if ($got != $got) { fail("$lbl: got NaN, wanted $exp"); return 0 }
	my $scale = abs($got) > abs($exp) ? abs($got) : abs($exp);
	my $err   = $scale < 1e-300 ? abs($got - $exp) : abs($got - $exp) / $scale;
	if ($err <= $tol) { pass("$lbl (rel err $err <= $tol)"); return 1 }
	fail($lbl);
	diag("         got: $got\n    expected: $exp\n     rel err: $err");
	return 0;
}

