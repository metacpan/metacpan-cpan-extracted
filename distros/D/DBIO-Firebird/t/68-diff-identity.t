use strict;
use warnings;
use Test::More;

use DBIO::Firebird::Diff;
use DBIO::Firebird::Introspect::Columns;

# Offline (karr k46): IDENTITY in the introspected model and in the Diff.
#
# The introspected model had no auto-increment field, so a table or column
# created by `Deploy->upgrade` (target = the temp database, introspected) came
# out without IDENTITY while install_ddl wrote it. Now
#
#   * Introspect::Columns reads rdb$identity_type (0 ALWAYS, 1 BY DEFAULT,
#     NULL none) into is_auto_increment;
#   * Diff::Table CREATE and Diff::Column ADD write the clause with the helper
#     install_ddl uses;
#   * adding, removing or changing IDENTITY on an existing column is refused
#     like the k38 changes: reported by diff, but as_sql dies before any
#     statement.

# --- the introspector, over a fake handle --------------------------------------
{
  package T::Sth;
  sub new { my ($c, @rows) = @_; bless { rows => [@rows] }, $c }
  sub execute { 1 }
  sub fetchrow_hashref { shift @{ $_[0]{rows} } }

  package T::Dbh;
  sub new { bless {}, shift }
  sub prepare {
    my ($s, $sql) = @_;
    return T::Sth->new if $sql =~ /rdb\$relation_constraints/;
    my $row = sub {
      my ($name, $ident, $null) = @_;
      return {
        'rdb$relation_name' => 'T         ', 'rdb$field_name' => "$name   ",
        'rdb$field_position' => 0, 'rdb$null_flag' => $null,
        'rdb$field_type' => 8, 'rdb$field_sub_type' => 0, 'rdb$field_scale' => 0,
        'rdb$field_precision' => 0, 'rdb$character_set_id' => undef,
        'rdb$character_length' => undef, 'rdb$default_source' => undef,
        'rdb$identity_type' => $ident,
      };
    };
    return T::Sth->new($row->('BYDEF', 1, 1), $row->('ALWAYS', 0, 1), $row->('PLAIN', undef, undef));
  }
}

my $cols = DBIO::Firebird::Introspect::Columns->fetch(T::Dbh->new, { T => {} });
is_deeply { map { $_->{column_name} => $_->{is_auto_increment} } @{ $cols->{T} } },
  { BYDEF => 1, ALWAYS => 1, PLAIN => 0 },
  'rdb$identity_type 1 / 0 read as is_auto_increment 1, NULL as 0';

# --- the diff ----------------------------------------------------------------
sub col {
  my ($name, $type, %more) = @_;
  return { column_name => $name, data_type => $type, size => undef, not_null => 0,
           default_value => undef, is_pk => 0, is_auto_increment => 0, %more };
}
sub model {
  my (%columns) = @_;
  return {
    tables => { map { $_ => { table_name => $_, kind => 'table' } } keys %columns },
    columns => \%columns, indexes => {}, unique_constraints => {}, foreign_keys => {},
  };
}
sub diff { DBIO::Firebird::Diff->new(source => $_[0], target => $_[1]) }

# CREATE TABLE
{
  my $d = diff(model(), model(t => [
    col('id', 'integer', not_null => 1, is_pk => 1, is_auto_increment => 1),
    col('n',  'numeric', size => [9, 0], not_null => 1, is_auto_increment => 1),
    col('x',  'varchar', size => 10),
  ]));
  my $sql = $d->as_sql;
  like $sql, qr/^  "id" integer GENERATED BY DEFAULT AS IDENTITY NOT NULL,$/m,
    'CREATE TABLE: IDENTITY before NOT NULL';
  like $sql, qr/^  "n" numeric\(9,0\) GENERATED BY DEFAULT AS IDENTITY NOT NULL,$/m,
    'CREATE TABLE: a numeric(p,0) identity column';
  like $sql, qr/^  "x" varchar\(10\),$/m, 'a plain column stays plain';
}

# ADD COLUMN
{
  my $d = diff(model(t => [ col('x', 'integer') ]),
               model(t => [ col('x', 'integer'), col('id', 'integer', not_null => 1, is_auto_increment => 1) ]));
  is $d->as_sql, qq{ALTER TABLE "t" ADD "id" integer GENERATED BY DEFAULT AS IDENTITY NOT NULL;},
    'ADD COLUMN: IDENTITY clause';
}

# the same on both sides: nothing
ok !diff(model(t => [ col('id', 'integer', not_null => 1, is_auto_increment => 1) ]),
         model(t => [ col('id', 'integer', not_null => 1, is_auto_increment => 1) ]))->has_changes,
  'identity on both sides: no change';

# existing column gains / loses identity
for my $case ([ 'gains', 0, 1 ], [ 'loses', 1, 0 ]) {
  my ($what, $from, $to) = @$case;
  my $d = diff(model(t => [ col('id', 'integer', not_null => 1, is_auto_increment => $from) ]),
               model(t => [ col('id', 'integer', not_null => 1, is_auto_increment => $to) ]));
  ok $d->has_changes, "a column that $what IDENTITY is reported";
  like $d->summary, qr/t\.id/, '... in the summary';
  my $sql = eval { $d->as_sql };
  ok !defined $sql, "... and refused by as_sql ($what)";
  isa_ok $@, 'DBIO::Exception';
  like $@, qr/"t"\."id": integer( identity)? -> integer( identity)?\s+the column .*IDENTITY/is, '... naming table, column and IDENTITY';
}

# an identity refusal sits beside other refused changes in one message
{
  my $d = diff(
    model(t => [ col('id', 'integer', is_auto_increment => 0), col('s', 'varchar', size => 20) ]),
    model(t => [ col('id', 'integer', is_auto_increment => 1), col('s', 'varchar', size => 5) ]),
  );
  eval { $d->as_sql };
  like $@, qr/refusing to change 2 columns/, 'identity and narrowing are listed together';
}

# a not-null change on an identity column stays a plain ALTER
{
  my $d = diff(model(t => [ col('id', 'integer', is_auto_increment => 1, not_null => 0) ]),
               model(t => [ col('id', 'integer', is_auto_increment => 1, not_null => 1) ]));
  is $d->as_sql, qq{ALTER TABLE "t" ALTER "id" SET NOT NULL;}, 'other changes of an identity column are untouched';
}

done_testing;
