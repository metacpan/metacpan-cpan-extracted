+// Grows the SIZING_GROW containers listed in growContainers by up to sizeToDistribute along one
+// axis, smallest first, so they end up as equal as their max sizes allow. Containers that reach
+// their max are removed from the list.
+void Clay__GrowContainersAlongAxis(Clay__int32_tArray *growContainers, float sizeToDistribute, bool xAxis) {
+    Clay_Context* context = Clay_GetCurrentContext();
+    while (sizeToDistribute > CLAY__EPSILON && growContainers->length > 0) {
+        float smallest = CLAY__MAXFLOAT;
+        float secondSmallest = CLAY__MAXFLOAT;
+        float widthToAdd = sizeToDistribute;
+        for (int childIndex = 0; childIndex < growContainers->length; childIndex++) {
+            Clay_LayoutElement *child = Clay_LayoutElementArray_Get(&context->layoutElements, Clay__int32_tArray_GetValue(growContainers, childIndex));
+            float childSize = xAxis ? child->dimensions.width : child->dimensions.height;
+            if (Clay__FloatEqual(childSize, smallest)) { continue; }
+            if (childSize < smallest) {
+                secondSmallest = smallest;
+                smallest = childSize;
+            }
+            if (childSize > smallest) {
+                secondSmallest = CLAY__MIN(secondSmallest, childSize);
+                widthToAdd = secondSmallest - smallest;
+            }
+        }
+
+        widthToAdd = CLAY__MIN(widthToAdd, sizeToDistribute / growContainers->length);
+
+        for (int childIndex = 0; childIndex < growContainers->length; childIndex++) {
+            Clay_LayoutElement *child = Clay_LayoutElementArray_Get(&context->layoutElements, Clay__int32_tArray_GetValue(growContainers, childIndex));
+            float *childSize = xAxis ? &child->dimensions.width : &child->dimensions.height;
+            Clay_SizingAxis childSizing = Clay__GetElementSizing(child, xAxis);
+            float maxSize = childSizing.size.minMax.max;
+            float previousWidth = *childSize;
+            if (Clay__FloatEqual(*childSize, smallest)) {
+                *childSize += widthToAdd;
+                if (*childSize >= maxSize) {
+                    *childSize = maxSize;
+                    Clay__int32_tArray_RemoveSwapback(growContainers, childIndex--);
+                }
+                sizeToDistribute -= (*childSize - previousWidth);
+            }
+        }
+    }
+}
