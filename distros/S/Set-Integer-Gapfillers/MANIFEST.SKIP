# Version control files and dirs.
\bRCS\b
\bCVS\b
,v$
^.svn/
^.gitignore
\B\.git\b
\B\.github\b

# ExtUtils::MakeMaker generated files and dirs.
^MANIFEST\.(?!SKIP)
^MANIFEST.bak
^Makefile$
^Makefile.old$
^blib/
^blibdirs$
^PM_to_blib$
^pm_to_blib$
^MakeMaker-\d
^pm_to_blib$
^MYMETA\.json$
^MYMETA\.yml$

# Module::Build
^Build$
^_build

# Temp, old, vi and emacs files.
~$
\.old$
^#.*#$
^\.#
\.swp$
\.bak$

# Devel::Cover-generated files
^cover_db/

# misc
\.tar\.gz$
^init_update\.conf
.patch$
.DS_Store
