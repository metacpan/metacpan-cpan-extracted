# Test origin: AI
use Test2::V0;
use lib 't/lib';

use DBIx::QuickORM;
use DBIx::QuickORM::Test;

my $EXC = 'DBIx::QuickORM::Exception::DB';

# Keys the database generates, in each family's own form: [table, key DDL, accepts an explicit key].
sub key_tables {
    my ($dbh, $family) = @_;

    return ([k_auto    => 'INTEGER AUTO_INCREMENT PRIMARY KEY', 1])                                        if $family =~ m/^(?:MySQL|MariaDB)$/;
    return ([k_autoinc => 'INTEGER PRIMARY KEY AUTOINCREMENT',  1], [k_rowid => 'INTEGER PRIMARY KEY', 1]) if $family eq 'SQLite';

    if ($family eq 'DuckDB') {    # DuckDB has no identity columns
        $dbh->do("CREATE SEQUENCE k_seq_ids");
        return ([k_seq => "INTEGER PRIMARY KEY DEFAULT nextval('k_seq_ids')", 1]);
    }

    return (
        [k_always  => 'INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY',    0],
        [k_default => 'BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY', 1],
    );
}

# Computed columns, in each family's own form: [table, generated column DDL].
sub generated_tables {
    my ($family) = @_;

    return ([g_stored  => 'STORED'])  if $family eq 'PostgreSQL';
    return ([g_virtual => 'VIRTUAL']) if $family eq 'DuckDB';       # DuckDB has only virtual ones
    return ([g_stored  => 'STORED'], [g_virtual => 'VIRTUAL']);
}

do_for_all_dbs {
    my ($db, $set) = @_;
    my $family = $set->{family};
    my $mysql  = $family =~ m/^(?:MySQL|MariaDB)$/;

    my $dbh = $db->connect;
    my $pg  = $family eq 'PostgreSQL' ? $dbh->{pg_server_version} : undef;

    subtest generated_keys => sub {
        return pass("PostgreSQL before 10 has no identity columns") if $pg && $pg < 100000;

        my @tables = key_tables($dbh, $family);
        $dbh->do("CREATE TABLE $_->[0] (id $_->[1], name VARCHAR(20))") for @tables;
        my $orm = DBIx::QuickORM->new(dbh => $dbh);
        my $ret = $orm->connection->dialect->supports_returning_insert;

        for my $spec (@tables) {
            my ($t, undef, $explicit) = @$spec;

            my $row = $orm->insert($t => {name => 'a'});
            my $id  = $row->field('id');
            ok($id, "$t: insert returns the generated key");

            if ($ret) {
                my @many = @{$orm->insert_many($t => [{name => 'b'}, {name => 'c'}])};
                is([map { $_->field('name') } @many], ['b', 'c'], "$t: insert_many returns the new rows");
                ok((!grep { !$_->field('id') } @many), "$t: each with its generated key");
            }
            else {
                like(dies { my $rows = $orm->insert_many($t => [{name => 'b'}]) }, qr/cannot return rows unless every row carries its whole primary key/, "$t: insert_many cannot return generated keys without RETURNING");
            }

            $orm->clear_cache;
            my $found = $orm->find($t => $id);
            is($found->field('name'), 'a', "$t: find by the generated key");
            ok($found->update({name => 'w'}), "$t: update");
            is($found->refresh->field('name'), 'w', "$t: refresh");

            my $given = $orm->insert($t => {name => 'g'}, as_given => 1);
            ok($given->field('id'), "$t: as_given gets the generated key");
            is($given->field('name'), 'g', "$t: with the fields as sent");

            is($found->delete,        1,     "$t: delete");
            is($orm->find($t => $id), undef, "$t: the row is gone");

            if ($explicit) {
                is($orm->insert($t => {id => 999, name => 'e'})->field('id'), 999, "$t: an explicit key is accepted");
            }
            else {
                my $err = dies { $orm->insert($t => {id => 999, name => 'e'}) };
                isa_ok($err, [$EXC], "$t: an explicit key is the database's error");
                like($err->errstr, qr/GENERATED ALWAYS/i, "$t: passed through as the database gave it");
            }
        }
    };

    subtest generated_columns => sub {
        return pass("PostgreSQL before 12 has no generated columns") if $pg                 && $pg < 120000;
        return pass("SQLite before 3.31 has no generated columns")   if $family eq 'SQLite' && _older($dbh->{sqlite_version}, 3, 31);

        my @tables = generated_tables($family);
        $dbh->do("CREATE TABLE $_->[0] (id INTEGER NOT NULL PRIMARY KEY, a INTEGER, b INTEGER GENERATED ALWAYS AS (a * 2) $_->[1])") for @tables;
        my $orm = DBIx::QuickORM->new(dbh => $dbh);

        my $id = 0;
        for my $spec (@tables) {
            my ($t) = @$spec;

            my $row = $orm->insert($t => {id => ++$id, a => 4});
            is($row->field('b'), 8, "$t: the computed value is read back after insert");

            ok($row->update({a => 5}),      "$t: update");
            ok(!exists $row->row_data->{b}, "$t: the row holds only the key after an update") if $mysql;
            is($row->field('b'),          10, "$t: the computed value is refreshed");
            is($row->refresh->field('b'), 10, "$t: and refresh reads it");

            ok($orm->find($t => $id), "$t: find");
            is($row->delete, 1, "$t: delete");

            my $err = dies { $orm->insert($t => {id => ++$id, a => 1, b => 2}) };
            isa_ok($err, [$EXC], "$t: writing the computed column is the database's error");
            like($err->errstr, qr/\S/, "$t: passed through with the database's text");
        }
    };
};

sub _older {
    my ($version, @min) = @_;
    my @v = split m/\./, $version;
    return ($v[0] <=> $min[0] || $v[1] <=> $min[1]) < 0;
}

done_testing;
