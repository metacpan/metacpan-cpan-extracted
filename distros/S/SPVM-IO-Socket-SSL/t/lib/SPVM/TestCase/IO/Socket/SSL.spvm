class TestCase::IO::Socket::SSL {
  use IO::Socket::SSL;
  use Net::SSLeay::Constant as SSL;
  use Fn;
  use FindBin;
  
  our $FILE_DIR : string;
  
  INIT {
    $FILE_DIR = FindBin->Bin . "/file";
  }
  
  static method run_echo_server_accept_once_with_options : void ($port_ref : int[], $start_server_ch : Go::Channel) {
    
    my $localhost = "127.0.0.1";
    
    my $server_socket = IO::Socket::SSL->new({
      LocalAddr => $localhost,
      Listen    => 5,
      SSL_startHandshake => 0,
      SSL_cert_file => "$FILE_DIR/simple-cert.cert.pem",
      SSL_key_file => "$FILE_DIR/simple-cert.key.pem",
      SSL_alpn_protocols => ["spdy/1", "http/1.1"],
    });
    
    $port_ref->[0] = $server_socket->sockport;
    $start_server_ch->write(1);
    
    my $ssl_ctx = $server_socket->ssl_ctx;
    
    $ssl_ctx->use_certificate_chain_file("$FILE_DIR/simple-cert.certchain.pem");
    
    my $set_tlsext_servername_callback_result = [0];
    $ssl_ctx->set_tlsext_servername_callback([$set_tlsext_servername_callback_result : int[]] method : int ($ssl : Net::SSLeay, $al_ref : int*) {
      
      $set_tlsext_servername_callback_result->[0] = 1;
      
      my $servername = $ssl->get_servername(SSL->TLSEXT_NAMETYPE_host_name);
      
      warn "[Test Output][set_tlsext_servername_callback]\$ssl->get_servername:" . (string)Fn->or($servername, "undef");
      
      warn "[Test Output][set_tlsext_servername_callback]\$\$al_ref:$$al_ref";
      
      return 1;
    });
    
    my $accepted_socket = (IO::Socket::SSL)undef;
    eval {
      $accepted_socket = $server_socket->accept;
      $accepted_socket->accept_SSL;
    }
    
    if ($@) {
      warn "[Test Output][IO::Socket::SSL#accept]$@";
    }
    
    while (1) {
      
      my $data = (mutable string)new_string_len 1;
      my $read_length = $accepted_socket->sysread($data);
      
      if ($read_length > 0) {
        if ($data eq "\0") {
          last;
        }
        
        $accepted_socket->syswrite($data);
      }
      else {
        last;
      }
    }
    
  }
  
  static method run_echo_server_accept_once : void ($port_ref : int[], $start_server_ch : Go::Channel) {
    
    my $localhost = "127.0.0.1";
    
    my $server_socket = IO::Socket::SSL->new({
      LocalAddr => $localhost,
      Listen    => 5,
      SSL_cert_file => "$FILE_DIR/simple-cert.cert.pem",
      SSL_key_file => "$FILE_DIR/simple-cert.key.pem",
    });
    
    $port_ref->[0] = $server_socket->sockport;
    $start_server_ch->write(1);
    
    my $accepted_socket = (IO::Socket::SSL)undef;
    eval { $accepted_socket = $server_socket->accept; }
    
    if ($@) {
      warn "[Test Output][IO::Socket::SSL#accept]$@";
    }
    
    if ($accepted_socket) {
      while (1) {
        
        my $data = (mutable string)new_string_len 1;
        my $read_length = $accepted_socket->sysread($data);
        
        if ($read_length > 0) {
          if ($data eq "\0") {
            last;
          }
          
          $accepted_socket->syswrite($data);
        }
        else {
          last;
        }
      }
    }
    
  }
  
  static method client_and_server_basic : int () {
    
    my $success_ref = [1];
    my $server_start_ch = Go->make(1);
    
    my $wg = Go::Sync::WaitGroup->new;
    $wg->add(1);
    Go->go([$success_ref : int[], $server_start_ch : Go::Channel, $wg : Go::Sync::WaitGroup] method : void () {
      
      Fn->defer([$wg : Go::Sync::WaitGroup] method : void () {
        $wg->done;
      });
      
      my $port_ref = [0];
      Go->go([$server_start_ch : Go::Channel, $port_ref : int[], $wg : Go::Sync::WaitGroup] method : void () {
        &run_echo_server_accept_once_with_options($port_ref, $server_start_ch);
      });
      
      $server_start_ch->read;
      my $port = $port_ref->[0];
      {
        my $default_passwd_cb = method : int ($buf : mutable string, $size : int, $rwflag : int) {
          
          my $password = "test";
          my $password_length = length $password;
          
          Fn->memcpy($buf, 0, $password, 0, $password_length);
          
          return $password_length;
        };
        
        my $host = "127.0.0.1";
        my $socket = IO::Socket::SSL->new({
          PeerAddr => $host,
          PeerPort => $port,
          SSL_startHandshake => 0,
          SSL_verify_mode => SSL->SSL_VERIFY_NONE,
          SSL_cert_file => "$FILE_DIR/simple-cert.cert.pem",
          SSL_key_file => "$FILE_DIR/simple-cert.key.enc.pem",
          SSL_passwd_cb => $default_passwd_cb,
          SSL_alpn_protocols => ["http/1.1"],
          SSL_hostname => "localhost",
          SSL_crl_file => "$FILE_DIR/simple-cert.csr.pem",
          SSL_check_crl => 1,
          SSL_hostname => "localhost",
        });
        
        my $ssl_ctx = $socket->ssl_ctx;
        
        $ssl_ctx->set_post_handshake_auth(1);
        
        my $msg_callback_results = new object[10];
        
        my $msg_callback = [$msg_callback_results : object[]]method : void ($write_p : int, $version : int, $content_type : int, $buf : string, $len : int, $ssl : Net::SSLeay) {          
          unless ($msg_callback_results->[0]) {
            warn "[Test Output]\$write_p:$write_p,\$version:$version,\$content_type:$content_type,\$buf:" . dump $buf . ",\$len:$len,\$ssl:" . type_name($ssl);
            
            $msg_callback_results->[0] = $write_p;
            $msg_callback_results->[1] = $version;
            $msg_callback_results->[2] = $content_type;
            $msg_callback_results->[3] = $buf;
            $msg_callback_results->[4] = $len;
            
            my $ssl_hash = Hash->new;
            $ssl_hash->set("ssl", $ssl);
            $ssl_hash->weaken("ssl");
            
            $msg_callback_results->[5] = $ssl_hash;
            
          }
        };
        
        $socket->add_before_connect_SSL_cb([$msg_callback : Net::SSLeay::Callback::Msg] method : void ($socket : IO::Socket::SSL, $ssl : Net::SSLeay) {
          $ssl->set_msg_callback($msg_callback);
        });
        
        $socket->connect_SSL;
        
        my $ssl = $socket->ssl;
        
        my $version = $ssl->version;
        
        warn "[Test Output][Net::SSLeay#version]$version";
        
        my $version_string = $ssl->get_version;
        
        warn "[Test Output][Net::SSLeay#get_version]$version_string";
        
        $ssl = $socket->ssl;
        
        $ssl->set_msg_callback(undef);
        
        unless ($msg_callback_results->[0]->(int) >= 0) {
          $success_ref->[0] = 0;
        }
        
        unless ($msg_callback_results->[1]->(int) >= 0) {
          $success_ref->[0] = 0;
        }
        
        unless ($msg_callback_results->[2]->(int) > 0) {
          $success_ref->[0] = 0;
        }
        
        unless (length $msg_callback_results->[3]->(string) > 0) {
          $success_ref->[0] = 0;
        }
        
        unless ($msg_callback_results->[4]->(int) > 0) {
          $success_ref->[0] = 0;
        }
        
        unless ($msg_callback_results->[5]->(Hash)->get("ssl") is_type Net::SSLeay) {
          $success_ref->[0] = 0;
        }
        
        my $certificate = $ssl->get_certificate;
        
        my $peer_certificate = $ssl->get_peer_certificate;
        
        unless ($peer_certificate->get_subject_name->oneline eq "/C=PL/O=Net-SSLeay/OU=Test Suite/CN=simple-cert.net-ssleay.example") {
          $success_ref->[0] = 0;
        }
        
        my $peer_cert_chains = $ssl->get_peer_cert_chain;
        
        unless (@$peer_cert_chains == 3) {
          $success_ref->[0] = 0;
        }
        
        unless ($peer_cert_chains->[0]->get_subject_name->oneline eq "/C=PL/O=Net-SSLeay/OU=Test Suite/CN=simple-cert.net-ssleay.example") {
          $success_ref->[0] = 0;
        }
        
        unless ($peer_cert_chains->[1]->get_subject_name->oneline eq "/C=PL/O=Net-SSLeay/OU=Test Suite/CN=Intermediate CA") {
          $success_ref->[0] = 0;
        }
        
        unless ($peer_cert_chains->[2]->get_subject_name->oneline eq "/C=PL/O=Net-SSLeay/OU=Test Suite/CN=Root CA") {
          $success_ref->[0] = 0;
        }
        
        my $dump_peer_certificate = $ssl->dump_peer_certificate;
        
        unless (Fn->contains($dump_peer_certificate, "Subject Name: /C=PL/O=Net-SSLeay/OU=Test Suite/CN=simple-cert.net-ssleay.example")) {
          $success_ref->[0] = 0;
        }
        
        unless (Fn->contains($dump_peer_certificate, "Issuer  Name: /C=PL/O=Net-SSLeay/OU=Test Suite/CN=Intermediate CA")) {
          $success_ref->[0] = 0;
        }
        
        my $alpn_selected_protocol = $ssl->get0_alpn_selected_return_string;
        
        unless ($alpn_selected_protocol eq "http/1.1") {
          $success_ref->[0] = 0;
        }
        
        my $cipher = $ssl->get_cipher;
        
        unless ($cipher && !Fn->contains($cipher, "NONE")) {
          $success_ref->[0] = 0;
        }
        
        my $write_buffer = "abc";
          
        $socket->syswrite($write_buffer);
        
        $socket->syswrite("\0");
        
        my $string_buffer = StringBuffer->new;
        
        my $recv_buffer = (mutable string)new_string_len 1;
        
        while (1) {
          
          my $recv_length = -1;
          
          eval { $recv_length = $socket->sysread($recv_buffer); }
          
          if ($recv_length > 0) {
            $string_buffer->push($recv_buffer);
          }
          else {
            last;
          }
        }
        
        unless ($string_buffer->to_string eq "abc") {
          $success_ref->[0] = 0;
        }
        
        unless ($ssl->get_shutdown == SSL->SSL_RECEIVED_SHUTDOWN) {
          $success_ref->[0] = 0;
        }
        
        $socket->shutdown_SSL;
      }
    });
    $wg->wait;
    
    unless ($success_ref->[0]) {
      return 0;
    }
    
    return 1;
  }
  
  static method client_and_server_no_connect_SSL : int () {
    
    my $success_ref = [1];
    my $server_start_ch = Go->make(1);
    
    my $wg = Go::Sync::WaitGroup->new;
    $wg->add(1);
    Go->go([$success_ref : int[], $server_start_ch : Go::Channel, $wg : Go::Sync::WaitGroup] method : void () {
      
      Fn->defer([$wg : Go::Sync::WaitGroup] method : void () {
        $wg->done;
      });
      
      my $port_ref = [0];
      Go->go([$server_start_ch : Go::Channel, $port_ref : int[]] method : void () {
        &run_echo_server_accept_once($port_ref, $server_start_ch);
      });
      
      $server_start_ch->read;
      my $port = $port_ref->[0];
      
      {
        my $host = "127.0.0.1";
        my $socket = IO::Socket::SSL->new({
          PeerAddr => $host,
          PeerPort => $port,
          SSL_startHandshake => 0,
          SSL_verify_mode => SSL->SSL_VERIFY_NONE,
        });
      }
    });
    $wg->wait;
    
    unless ($success_ref->[0]) {
      return 0;
    }
    
    return 1;
  }
  
  static method client_and_server_SSL_key_SSL_cert : int () {
    
    my $success_ref = [1];
    my $server_start_ch = Go->make(1);
    
    my $wg = Go::Sync::WaitGroup->new;
    $wg->add(1);
    Go->go([$success_ref : int[], $server_start_ch : Go::Channel, $wg : Go::Sync::WaitGroup] method : void () {
      
      Fn->defer([$wg : Go::Sync::WaitGroup] method : void () {
        $wg->done;
      });
      
      my $port_ref = [0];
      Go->go([$server_start_ch : Go::Channel, $port_ref : int[]] method : void () {
        &run_echo_server_accept_once($port_ref, $server_start_ch);
      });
      
      $server_start_ch->read;
      my $port = $port_ref->[0];
      {
        my $certs_list = List->new(new Net::SSLeay::X509[0]);
        
        my $bio_cert = Net::SSLeay::BIO->new_file( "$FILE_DIR/simple-cert.cert.pem", "r");
        
        my $cert = Net::SSLeay::PEM->read_bio_X509($bio_cert);
        $certs_list->push($cert);
        
        my $bio_chain_certs = Net::SSLeay::BIO->new_file("$FILE_DIR/simple-cert.certchain.pem", "r");
        
        my $chain_certs_list = List->new(new Net::SSLeay::X509[0]);
        while (1) {
          my $chain_cert = (Net::SSLeay::X509)undef;
          
          eval { $chain_cert = Net::SSLeay::PEM->read_bio_X509($bio_chain_certs); }
          
          if ($@) {
            if (eval_error_id isa_error Net::SSLeay::Error::PEM_R_NO_START_LINE) {
              last;
            }
            else {
              die $@;
            }
          }
          
          $certs_list->push($chain_cert);
        }
        
        my $certs = (Net::SSLeay::X509[])$certs_list->to_array;
        
        my $bio_pkey = Net::SSLeay::BIO->new_file("$FILE_DIR/simple-cert.key.pem", "r");
        
        my $pkey = Net::SSLeay::PEM->read_bio_PrivateKey($bio_pkey);
        
        my $host = "127.0.0.1";
        my $socket = IO::Socket::SSL->new({
          PeerAddr => $host,
          PeerPort => $port,
          SSL_verify_mode => SSL->SSL_VERIFY_NONE,
          SSL_cert => $certs,
          SSL_key => $pkey,
        });
        
        my $write_buffer = "abc";
          
        $socket->syswrite($write_buffer);
        
        $socket->syswrite("\0");
        
        my $string_buffer = StringBuffer->new;
        
        my $recv_buffer = (mutable string)new_string_len 1;
        
        while (1) {
          
          my $recv_length = -1;
          
          eval { $recv_length = $socket->sysread($recv_buffer); }
          
          if ($recv_length > 0) {
            $string_buffer->push($recv_buffer);
          }
          else {
            last;
          }
        }
        
        unless ($string_buffer->to_string eq "abc") {
          $success_ref->[0] = 0;
        }
      }
    });
    $wg->wait;
    
    unless ($success_ref->[0]) {
      return 0;
    }
    
    return 1;
  }
  
  static method connect_deadline : int () {
    
    my $success_ref = [1];
    
    {
      my $host = "127.0.0.1";
      
      # Use a deadline that has already passed to ensure an immediate timeout.
      my $deadline = Go::Time->now->add(Go::Duration_1l->new_from_sec(-1.0));
      
      my $socket = (IO::Socket::SSL)undef;
      eval {
        $socket = IO::Socket::SSL->new({
          PeerAddr => $host,
          ReadDeadline => $deadline,
          WriteDeadline => $deadline,
          SSL_verify_mode => SSL->SSL_VERIFY_NONE,
        });
      }
      
      if ($@) {
        unless ($@ isa Go::Error::IOTimeout) {
          warn "Unexpected error: " . $@;
          $success_ref->[0] = 0;
        }
      }
      else {
        warn "Connection unexpectedly succeeded despite an expired deadline.";
        $success_ref->[0] = 0;
        if ($socket) { $socket->close; }
      }
    }
    
    unless ($success_ref->[0]) {
      return 0;
    }
    
    return 1;
  }
  
  static method read_deadline : int () {
    
    my $success_ref = [1];
    my $server_start_ch = Go->make(1);
    
    my $wg = Go::Sync::WaitGroup->new;
    $wg->add(1);
    Go->go([$success_ref : int[], $server_start_ch : Go::Channel, $wg : Go::Sync::WaitGroup] method : void () {
      
      Fn->defer([$wg : Go::Sync::WaitGroup] method : void () {
        $wg->done;
      });
      
      my $port_ref = [0];
      Go->go([$server_start_ch : Go::Channel, $port_ref : int[]] method : void () {
        eval {
          my $listen_socket = IO::Socket::SSL->new({
            LocalAddr => "127.0.0.1",
            Listen => 5,
            SSL_cert_file => "$FILE_DIR/simple-cert.cert.pem",
            SSL_key_file => "$FILE_DIR/simple-cert.key.pem",
          });
          
          $port_ref->[0] = $listen_socket->sockport;
          $server_start_ch->write(1);
          my $client_socket = $listen_socket->accept;
          
          # Sleep longer than the client's deadline to trigger the timeout.
          Go->sleep(Go::Duration_1l->new_from_sec(1.0));
          
          $client_socket->close;
          $listen_socket->close;
        }
        if ($@) { warn "Server error: " . $@; }
      });
      
      eval {
        $server_start_ch->read;
        my $port = $port_ref->[0];
        my $host = "127.0.0.1";
        
        # Connect to the server
        my $socket = IO::Socket::SSL->new({
          PeerAddr => $host,
          PeerPort => $port,
          SSL_verify_mode => SSL->SSL_VERIFY_NONE,
        });
        
        # Set a short deadline (0.5 seconds from now)
        my $deadline = Go::Time->now->add(Go::Duration_1l->new_from_sec(0.5));
        $socket->set_deadline($deadline);
        
        my $buffer = (mutable string)new_string_len 1024;
        
        # This should block and eventually throw DeadlineExceeded because the server sends nothing.
        $socket->sysread($buffer);
        
        # If no exception is thrown, it's a failure.
        warn "sysread unexpectedly succeeded or returned 0 before deadline.";
        $success_ref->[0] = 0;
        $socket->close;
      }
      if ($@) {
        # Check if the error is exactly Go::Error::IOTimeout
        unless ($@ isa Go::Error::IOTimeout) {
          warn "Unexpected error type: " . $@;
          $success_ref->[0] = 0;
        }
      }
    });
    $wg->wait;
    
    unless ($success_ref->[0]) {
      return 0;
    }
    
    return 1;
  }
  
  static method accept_deadline : int () {
    
    my $success_ref = [1];
    
    # Server side
    Go->go([$success_ref : int[]] method : void () {
      eval {
        my $listen_socket = IO::Socket::SSL->new({
          LocalAddr => "127.0.0.1",
          Listen => 5,
          SSL_cert_file => "$FILE_DIR/simple-cert.cert.pem",
          SSL_key_file => "$FILE_DIR/simple-cert.key.pem",
        });
        
        # Set a short deadline for accept and accept_SSL.
        my $deadline = Go::Time->now->add(Go::Duration_1l->new_from_sec(0.5));
        $listen_socket->set_deadline($deadline);
        
        # This should block and eventually throw DeadlineExceeded because no client connects.
        my $client_socket = $listen_socket->accept;
        
        warn "accept unexpectedly succeeded before deadline.";
        $success_ref->[0] = 0;
        $client_socket->close;
        $listen_socket->close;
      }
      if ($@) {
        unless ($@ isa Go::Error::IOTimeout) {
          warn "Unexpected error type in accept: " . $@;
          $success_ref->[0] = 0;
        }
      }
    });
    
    Go->gosched;
    
    return $success_ref->[0];
  }
  
  static method write_deadline : int () {
    
    my $success_ref = [1];
    my $server_start_ch = Go->make(1);
    
    my $wg = Go::Sync::WaitGroup->new;
    $wg->add(1);
    Go->go([$success_ref : int[], $server_start_ch : Go::Channel, $wg : Go::Sync::WaitGroup] method : void () {
      
      Fn->defer([$wg : Go::Sync::WaitGroup] method : void () {
        $wg->done;
      });
      
      my $port_ref = [0];
      Go->go([$server_start_ch : Go::Channel, $port_ref : int[]] method : void () {
        eval {
          my $listen_socket = IO::Socket::SSL->new({
            LocalAddr => "127.0.0.1",
            Listen => 5,
            SSL_cert_file => "$FILE_DIR/simple-cert.cert.pem",
            SSL_key_file => "$FILE_DIR/simple-cert.key.pem",
          });
          
          $port_ref->[0] = $listen_socket->sockport;
          $server_start_ch->write(1);
          
          # Accept the connection but DO NOT read.
          my $client_socket = $listen_socket->accept;
          
          # Keep the connection alive longer than the client's deadline.
          Go->sleep(Go::Duration_1l->new_from_sec(2.0));
          
          $client_socket->close;
          $listen_socket->close;
        }
        if ($@) { warn "Server error: " . $@; }
      });
      
      eval {
        $server_start_ch->read;
        my $port = $port_ref->[0];
        
        my $host = "127.0.0.1";
        my $socket = IO::Socket::SSL->new({
          PeerAddr => $host,
          PeerPort => $port,
          SSL_verify_mode => SSL->SSL_VERIFY_NONE,
        });
        
        # Set a very short deadline to ensure it triggers.
        my $deadline = Go::Time->now->add(Go::Duration_1l->new_from_sec(0.5));
        $socket->set_deadline($deadline);
        
        # Smaller payload, but send many times to fill the buffer.
        my $payload = Fn->repeat("a", 8192);
        
        while (1) {
          $socket->syswrite($payload);
        }
      }
      if ($@) {
        unless ($@ isa Go::Error::IOTimeout) {
          warn "Unexpected error: " . $@;
          $success_ref->[0] = 0;
        }
      } else {
        warn "Exited loop without exception";
        $success_ref->[0] = 0;
      }
    });
    $wg->wait;
    
    unless ($success_ref->[0]) {
      return 0;
    }
    
    return 1;
  }
  
  static method read_deadline_specific : int () {
    
    my $success_ref = [1];
    my $server_start_ch = Go->make(1);
    
    my $wg = Go::Sync::WaitGroup->new;
    $wg->add(1);
    Go->go([$success_ref : int[], $server_start_ch : Go::Channel, $wg : Go::Sync::WaitGroup] method : void () {
      
      Fn->defer([$wg : Go::Sync::WaitGroup] method : void () {
        $wg->done;
      });
      
      my $port_ref = [0];
      Go->go([$server_start_ch : Go::Channel, $port_ref : int[]] method : void () {
        eval {
          my $listen_socket = IO::Socket::SSL->new({
            LocalAddr => "127.0.0.1",
            Listen => 5,
            SSL_cert_file => "$FILE_DIR/simple-cert.cert.pem",
            SSL_key_file => "$FILE_DIR/simple-cert.key.pem",
          });
          $server_start_ch->write(1);
          $port_ref->[0] = $listen_socket->sockport;
          
          my $client_socket = $listen_socket->accept;
          
          # Server sleeps to trigger client-side read timeout
          Go->sleep(Go::Duration_1l->new_from_sec(1.0));
          
          $client_socket->close;
          $listen_socket->close;
        }
      });
      
      eval {
        $server_start_ch->read;
        my $port = $port_ref->[0];
        my $socket = IO::Socket::SSL->new({
          PeerAddr => "127.0.0.1",
          PeerPort => $port,
          SSL_verify_mode => SSL->SSL_VERIFY_NONE,
        });
        
        my $read_deadline = Go::Time->now->add(Go::Duration_1l->new_from_sec(0.3));
        $socket->set_read_deadline($read_deadline);
        
        my $buffer = (mutable string)new_string_len 1024;
        $socket->sysread($buffer);
        
        warn "sysread unexpectedly succeeded before ReadDeadline.";
        $success_ref->[0] = 0;
      }
      if ($@) {
        unless ($@ isa Go::Error::IOTimeout) {
          warn "Unexpected error type in sysread: " . $@;
          $success_ref->[0] = 0;
        }
      }
    });
    $wg->wait;
    
    unless ($success_ref->[0]) {
      return 0;
    }
    
    return 1;
  }
  
  static method write_deadline_specific : int () {
    
    my $success_ref = [1];
    my $server_start_ch = Go->make(1);
    
    my $wg = Go::Sync::WaitGroup->new;
    $wg->add(1);
    Go->go([$success_ref : int[], $server_start_ch : Go::Channel, $wg : Go::Sync::WaitGroup] method : void () {
      
      Fn->defer([$wg : Go::Sync::WaitGroup] method : void () {
        $wg->done;
      });
      
      my $port_ref = [0];
      Go->go([$server_start_ch : Go::Channel, $port_ref : int[]] method : void () {
        eval {
          my $listen_socket = IO::Socket::SSL->new({
            LocalAddr => "127.0.0.1",
            Listen => 5,
            SSL_cert_file => "$FILE_DIR/simple-cert.cert.pem",
            SSL_key_file => "$FILE_DIR/simple-cert.key.pem",
          });
          
          $port_ref->[0] = $listen_socket->sockport;
          
          $server_start_ch->write(1);
          my $client_socket = $listen_socket->accept;
          
          # Do not read to let the client's send buffer fill up.
          Go->sleep(Go::Duration_1l->new_from_sec(2.0));
          
          $client_socket->close;
          $listen_socket->close;
        }
      });
      
      eval {
        $server_start_ch->read;
        my $port = $port_ref->[0];
        
        my $socket = IO::Socket::SSL->new({
          PeerAddr => "127.0.0.1",
          PeerPort => $port,
          SSL_verify_mode => SSL->SSL_VERIFY_NONE,
        });
        
        my $write_deadline = Go::Time->now->add(Go::Duration_1l->new_from_sec(0.3));
        $socket->set_write_deadline($write_deadline);
        
        my $payload = Fn->repeat("a", 8192);
        while (1) {
          $socket->syswrite($payload);
        }
      }
      if ($@) {
        unless ($@ isa Go::Error::IOTimeout) {
          warn "Unexpected error type in syswrite: " . $@;
          $success_ref->[0] = 0;
        }
      } else {
        $success_ref->[0] = 0;
      }
    });
    $wg->wait;
    
    unless ($success_ref->[0]) {
      return 0;
    }
    
    return 1;
  }
  
}
