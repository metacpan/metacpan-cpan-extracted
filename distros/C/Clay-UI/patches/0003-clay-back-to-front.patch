+// ---------------------------------------------------------------------------
+// Stack layout (CLAY_BACK_TO_FRONT). Both axes are sized like the off axis
+// of the other directions: the container fits its largest child, and
+// SIZING_GROW children fill its inner size. Every child is placed on its own
+// by childAlignment, so children overlap and later ones are drawn on top.
+// ---------------------------------------------------------------------------
+
+// The size of a stack container's largest child on each axis, padding excluded.
+Clay_Dimensions Clay__BackToFrontContentSize(Clay_LayoutElement *parent) {
+    Clay_Context* context = Clay_GetCurrentContext();
+    Clay_Dimensions contentSize = CLAY__DEFAULT_STRUCT;
+    for (int32_t childOffset = 0; childOffset < parent->children.length; ++childOffset) {
+        Clay_LayoutElement *child = Clay_LayoutElementArray_Get(&context->layoutElements, parent->children.elements[childOffset]);
+        if (child->exiting) continue;
+        contentSize.width = CLAY__MAX(contentSize.width, child->dimensions.width);
+        contentSize.height = CLAY__MAX(contentSize.height, child->dimensions.height);
+    }
+    return contentSize;
+}
+
+// Returns the position of a child relative to its stack container, aligned within the
+// container's inner area by childAlignment on both axes.
+Clay_Vector2 Clay__BackToFrontPlaceChild(Clay_LayoutElement *parent, Clay_LayoutElement *child) {
+    Clay_LayoutConfig *layoutConfig = &parent->config.layout;
+    Clay_Vector2 position = { (float)layoutConfig->padding.left, (float)layoutConfig->padding.top };
+    float spaceBesideChild = parent->dimensions.width - (float)(layoutConfig->padding.left + layoutConfig->padding.right) - child->dimensions.width;
+    float spaceAroundChild = parent->dimensions.height - (float)(layoutConfig->padding.top + layoutConfig->padding.bottom) - child->dimensions.height;
+    switch (layoutConfig->childAlignment.x) {
+        case CLAY_ALIGN_X_LEFT: break;
+        case CLAY_ALIGN_X_CENTER: position.x += spaceBesideChild / 2; break;
+        case CLAY_ALIGN_X_RIGHT: position.x += spaceBesideChild; break;
+    }
+    switch (layoutConfig->childAlignment.y) {
+        case CLAY_ALIGN_Y_TOP: break;
+        case CLAY_ALIGN_Y_CENTER: position.y += spaceAroundChild / 2; break;
+        case CLAY_ALIGN_Y_BOTTOM: position.y += spaceAroundChild; break;
+    }
+    return position;
+}
