#!/usr/bin/env perl
#
# Cross-validation of binom_test() against the two reference implementations,
# using their own test suites and man-page examples rather than cases invented
# here.  t/binom_test.t already covers the basic hashref shape, the array-ref
# form, argument validation and leak checking; this file does not repeat those.
#
# Provenance of every expected value below:
#
#   * R 4.6.1 stats::binom.test() -- the function binom_test() is modelled on,
#     line for line (same two-sided tail-counting rule with the same 1e-7 fuzz,
#     same Clopper-Pearson qbeta() inversion).  The @P_CORPUS and @CI_CORPUS
#     tables were generated from it at options(digits=17): every x for n in
#     1,2,3,5,10 crossed with p in 0.5, 0.25, 0.7 and all three alternatives,
#     all of n = 20 two-sided, and then the targeted cases listed inline.
#   * R's own suite: the binom.test(c(800,10)) case from tests/reg-tests-2.R
#     ("p-value < epsilon"), and the Conover Mendelian-cross example from
#     src/library/stats/man/binom.test.Rd, whose printed output is pinned in
#     tests/Examples/stats-Ex.Rout.save.
#   * SciPy 1.17.1 scipy/stats/tests/test_morestats.py::TestBinomTest -- the
#     p-values and Clopper-Pearson bounds in test_two_sided_pvalues1/2,
#     test_edge_cases, test_confidence_intervals1/2,
#     test_confidence_interval_exact_k0, test_confidence_interval_exact_k_is_n
#     and test_estimate_equals_hypothesized_prop, all annotated "Expected
#     results here are from R binom.test" upstream.  They are reproduced
#     verbatim in @SCIPY below, at SciPy's own rtol, so this file fails if
#     either reference is contradicted.
#
# Two sections exist specifically as regression guards, because writing this
# file turned up two bugs in the numerics binom_test() sits on.  Both are fixed;
# @BIG_CORPUS and @TINY_CI are here so they stay fixed.  See the comments there.
#
# Where the references disagree with binom_test(), the divergence is recorded
# explicitly at the end of the file rather than papered over, so that a future
# change of mind is a deliberate one.

require 5.010;
use strict;
use warnings FATAL => 'all';
use Test::More;
use Stats::LikeR 'binom_test';

# The n = 2.1e7 cases scan the whole support once per call, which is a fixed
# ~2.1e7 iterations of Loader's dbinom -- fast enough on a plain double build
# (~0.4s each) but one to two orders slower on a long-double or __float128
# perl, where the inner loop is lgammal/lgammaq.  R does exactly the same O(n)
# scan, so this is not overhead binom_test() adds; it is just too slow for a
# CPAN smoker.  Everything else in this file runs in well under a second.
my $EXTENDED = $ENV{EXTENDED_TESTING} || $ENV{AUTHOR_TESTING} || $ENV{RELEASE_TESTING};
my $SLOW_WHY = 'slow O(n) case at n = 2.1e7; set EXTENDED_TESTING=1 to run it';

# Tolerances.
#
# $TOL_P is the p-value limit.  Across the 383 corpus cases this build's worst
# disagreement with R is 1.2e-11 (x=17, n=10000, p=0.001, greater) and the
# large-n cases sit at 3.3e-13, so the limit below has two orders of headroom
# for other NV widths.  It is still three orders tighter than the 9e-5 error
# that used to be here, which is the point: see @BIG_CORPUS.
#
# $TOL_CI is the Clopper-Pearson limit for bounds of ordinary size; worst
# observed over the 1560 bounds in @CI_CORPUS is 1.6e-12.
#
# $TOL_CI_TINY covers bounds many orders of magnitude below 1.  These are
# genuinely less accurate, and the reason is structural rather than sloppy: the
# regularized incomplete beta switches to its complement branch, I_x(a,b) =
# 1 - I_{1-x}(b,a), once x exceeds (a+1)/(a+b+2), and for x ~ 5e-9 the double
# 1-x pins x down only to an absolute 1.1e-16 -- a relative 2e-8.  No amount of
# bisection can resolve past that plateau, so the *upper* bound for a handful
# of successes in a billion trials carries ~1e-9 of relative error where R,
# which has TOMS 708's asymptotic expansions instead of one continued fraction,
# holds 1e-15.  The lower bound is unaffected (it stays on the direct branch),
# and 1e-9 on a bound that is itself deliberately conservative changes no
# inference.  Fixing it properly means porting bratio(), not tightening a loop.
my $TOL_P       = 1e-9;
my $TOL_CI      = 1e-10;
my $TOL_CI_TINY = 5e-8;

# Relative compare, with an absolute fallback for an expected value of exactly
# 0 -- which here means "underflowed", not "small", so the bar is 1e-300.
sub close_to {
	my ($got, $exp, $name, $rel) = @_;
	$rel //= $TOL_P;
	if ($exp == 0) {
		my $ok = ok(abs($got) < 1e-300, $name);
		diag("got=$got, expected exactly 0") unless $ok;
		return $ok;
	}
	my $err = abs($got - $exp) / abs($exp);
	ok($err < $rel, $name) or diag("got=$got expected=$exp rel_err=$err tol=$rel");
}

# ---------------------------------------------------------------------------
# 1. R's p-value, over every alternative.
#
# The first block is exhaustive: every x from 0 to n for n in 1, 2, 3, 5 and 10,
# crossed with p in 0.5, 0.25 and 0.7 and all three alternatives, then all of
# n = 20 two-sided at p in 0.5, 0.25, 0.3.  Small n is where the two-sided rule
# is easiest to get wrong -- it is not a tail probability but a sum over
# { i : dbinom(i) <= dbinom(x) * (1 + 1e-7) }, so it depends on which terms
# compare equal to the observed density, and at p = 0.5 the mirror term is
# exactly equal.  n = 20, p = 0.25 puts the mean at an exact integer (the
# x == m => 1 branch); p = 0.3 does not.
#
# The targeted block that follows covers x = 0, x = n, p = 0 and p = 1
# (degenerate branches), estimate == p exactly, x either side of an integer
