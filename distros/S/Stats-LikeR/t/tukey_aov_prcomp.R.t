require 5.010;
use strict;
use warnings FATAL => 'all';
use Test::More;
use Stats::LikeR qw(ptukey qtukey aov anova TukeyHSD lm prcomp scale vif qnorm);

# Cross-validation of ptukey(), qtukey(), aov(), anova(), TukeyHSD(), vif(),
# prcomp() and scale() against the R functions each one ports.  t/tukey.t,
# t/anova.t, t/aov.t, t/prcomp.t and t/vif_hoslem.t already cover the call
# shapes, the argument validation and leak checking; this file is only about the
# numbers, and about how many digits of them are actually right.
#
# PROVENANCE
# ----------
# The data section at the end holds the frozen table, regenerated by
# t/tukey_aov_prcomp.R.R under R 4.6.1 (2026-06-24).  The generator is never run
# by the test, so the distribution installs and tests with no R.
#
#   ptukey / qtukey  LikeR.xs carries a faithful port of R's
#       src/nmath/{ptukey,qtukey}.c (Copenhaver & Holland 1988), so the right
#       test is a dense grid against R rather than a few textbook entries: 637
#       points, nmeans in {2,3,4,5,6,10,20} crossed with df in
#       {3,5,10,27,60,120,1e6}, at seven quantiles and six probabilities, plus
#       both tails and the df -> Inf closed form.
#   aov / TukeyHSD   PlantGrowth (weight ~ group, 3 balanced groups of 10),
#       which is TukeyHSD's own example, at conf.level 0.95, 0.90 and 0.99;
#       and chickwts (weight ~ feed, 6 groups of unequal size), which is what
#       exercises the unbalanced studentized-range interval and produces 15
#       pairwise comparisons rather than 3.
#   anova            mtcars, mpg ~ wt + hp + disp -- sequential Type I over
#       three terms, so a Type-I/Type-III mix-up shows up in the second term.
#   vif              1/(1 - R^2) of each predictor on the others, which is what
#       car::vif computes; generated with base lm() so the generator needs no
#       contributed package.
#   prcomp           USArrests, which is prcomp.Rd's own example, both
#       scale.=TRUE and unscaled.
#   scale            base::scale, including R's center=FALSE divisor -- the root
#       mean square about zero, sqrt(sum(x^2)/(n-1)), not the standard
#       deviation, which is the detail that is easy to get wrong.
#
# WHY THIS FILE EXISTS ALONGSIDE t/tukey.t
# ----------------------------------------
# t/tukey.t checks qtukey to an absolute 1e-3 and the TukeyHSD columns to 1e-4.
# Those limits are eleven and ten orders of magnitude looser than the port
# actually is: measured over the 637-point grid here, ptukey agrees with R to
# 3.0e-14 relative and qtukey to 2.5e-12, and the TukeyHSD columns to 4.7e-13.
# A 1e-3 limit would not notice the port being replaced by a normal
# approximation, which is precisely the regression it is there to catch.
#
# TOLERANCES
# ----------
# Each is the worst disagreement measured against the R table on a double
# build, with headroom for long-double and quadmath:
#
# The second column is the worst over all three local NV widths (double,
# long double and __float128), so the limits hold on the whole matrix rather
# than only on the default perl.
#
#   quantity        worst observed   limit    note
#   ptukey          3.30e-14         1e-11    over 343 grid points; the wider
#                                             widths are marginally worse, as
#                                             ptukey's internals are plain
#                                             double either way and only its
#                                             argument moves
#   qtukey          2.52e-12         1e-9     over 294 grid points
#   aov             1.67e-14         1e-11
#   anova / lm      2.46e-12         1e-11    worst is the 'disp' coefficient,
#                                             which is ~9e-4 and the smallest
#                                             of the three, so it carries the
#                                             normal-equation error
#   TukeyHSD        2.51e-12         1e-10    diff, lwr and upr.  'p adj'
#                                             reaches 9.47e-07 relative on the
#                                             wider widths and is governed by
#                                             $P_ABS_FLOOR instead -- see the
#                                             measurements there
#   prcomp sdev     1.07e-15         1e-11
#   prcomp rotation 5.92e-15         1e-9     eigenvectors, sign-free (below)
#   vif             1.05e-14         1e-11
#   scale           3.35e-16         1e-12
#
# Do not widen any of these to make a failure go away.
my %TOL = (
	ptukey   => 1e-11,
	qtukey   => 1e-9,
	aov      => 1e-11,
	anova    => 1e-11,
	tukey    => 1e-10,
	sdev     => 1e-11,
	rotation => 1e-9,
	vif      => 1e-11,
	scale    => 1e-12,
);

#
# The datasets, as R has them.
#
my @PG_WEIGHT = (4.17, 5.58, 5.18, 6.11, 4.50, 4.61, 5.17, 4.53, 5.33, 5.14,
                 4.81, 4.17, 4.41, 3.59, 5.87, 3.83, 6.03, 4.89, 4.32, 4.69,
                 6.31, 5.12, 5.54, 5.50, 5.37, 5.29, 4.92, 6.15, 5.80, 5.26);
