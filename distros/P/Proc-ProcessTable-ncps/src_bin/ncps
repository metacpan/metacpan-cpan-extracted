my $wait_channels_invert = 0;
my $zombie               = 0;
my $swapped              = 0;
my $no_color             = 0;
my $swapped_invert       = 0;
my $version;
my $help;
my $commands_string;
my $commands_invert = 0;
my $pids_string;
my $pids_invert = 0;
my $cpu_string;
my $cpu_invert = 0;
my $mem_string;
my $mem_invert = 0;
my $rss_string;
my $rss_invert = 0;
my $time_string;
my $time_invert = 0;
my $states_string;
my $states_invert = 0;
my $minor_faults  = 0;
my $major_faults  = 0;
my $cminor_faults = 0;
my $cmajor_faults = 0;
my $numthr        = 0;
my $tty           = 0;
my $jid           = 0;
my $jids_string;
my $jids_invert = 0;
my $uids_string;
my $uids_invert = 0;
my $euid        = 0;
my $euid_invert = 0;
my $egid        = 0;
my $egid_invert = 0;
my $self_proc   = 0;
