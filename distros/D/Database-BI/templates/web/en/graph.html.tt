[%- WRAPPER 'web/en/layouts/default.html.tt' -%]

<style>
  /* Allow rotated X-axis labels on the leftmost tick to render outside the SVG
     boundary without being clipped.
     Problem: D3 rotates labels -45° with text-anchor:end, so the leftmost label
     extends to a negative SVG x-coordinate.  overflow:visible on the SVG lets
     the ink escape the SVG box, but the parent .graph-container has
     overflow-x:auto, which creates a scroll context that clips child ink
     overflow at the container's left edge regardless.
     Fix: padding-left shifts the SVG rightward so the label's visual overflow
     falls within the container's padding area, which IS part of the scroll area. */
  #chart { overflow: visible; }
  .graph-container { padding-left: 3rem; }

  /* Reference-line checkboxes in the export bar */
  .graph-refline-controls {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: 0.5rem;
    padding-left: 0.75rem;
    border-left: 1px solid #ccc;
  }
  .refline-label {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.82rem;
    cursor: pointer;
    white-space: nowrap;
  }
  .refline-label input[type="checkbox"] { cursor: pointer; }

  /* Style the HTML::D3-generated Reset zoom button to match .btn-graph-export */
  #reset-btn {
    padding: 0.28rem 0.75rem;
    border: 1px solid #888;
    border-radius: 6px;
    background: transparent;
    color: #444;
    font-size: 0.82rem;
    cursor: pointer;
    transition: background 0.12s;
    margin-bottom: 0;
  }
  #reset-btn:hover { background: #f0f0f0; }
  .chart-source {
    margin: 0.25rem 0 0;
    font-size: 0.82rem;
    color: #666;
    word-break: break-all;
  }
  .chart-source a { color: inherit; }
</style>

<p class="back-link"><a href="/">&larr; Home</a> &rsaquo; <a href="[% back_url | html %]">[% back_label || 'Back' | html %]</a></p>

<h2 class="graph-title">[% title | html %]</h2>

<div class="graph-export-bar">
  <button class="btn-graph-export" onclick="biExportSVG()">Export SVG</button>
  <button class="btn-graph-export" onclick="biExportPNG()">Export PNG</button>
  <span class="graph-point-count">Plotting [% point_count %] point[% IF point_count != 1 %]s[% END %]</span>
  [% IF ref_min_y.defined %]
  <span class="graph-refline-controls">
    <label class="refline-label"><input type="checkbox" id="rl-min"> Min ([% ref_min_y %])</label>
    <label class="refline-label"><input type="checkbox" id="rl-avg"> Avg ([% ref_avg_y %])</label>
    <label class="refline-label"><input type="checkbox" id="rl-max"> Max ([% ref_max_y %])</label>
  </span>
  [% END %]
</div>

<div class="graph-container">
  <script src="https://d3js.org/d3.v7.min.js"></script>
  [% graph_html %]
</div>

<script>
(function () {
  // Widen the SVG viewBox so the first rotated X-axis label is not cropped.
  // D3 rotates labels -45° with text-anchor:end; the leftmost label extends
  // to a negative SVG x-coordinate.  A viewBox starting at -pad makes that
  // region part of the SVG viewport, bypassing all container overflow rules.
  // Run inside setTimeout(0) so D3's duration=0 transitions have completed
  // and the axis text elements are in the DOM before we size the viewport.
  setTimeout(function () {
    var _svg = document.getElementById('chart');
    if (!_svg) return;
    var _w   = parseFloat(_svg.getAttribute('width'))  || 1100;
    var _h   = parseFloat(_svg.getAttribute('height')) || 580;
    var _pad = 80;
    _svg.setAttribute('width',   _w + _pad);
    _svg.setAttribute('viewBox', (-_pad) + ' 0 ' + (_w + _pad) + ' ' + _h);
  }, 0);

  // Read source attribution from the hidden data div (present only for
  // URL-imported data).  Reading at call time means DOM order does not matter.
  function _getAttribution() {
    var el = document.getElementById('chart-attribution');
    return el ? { url: el.dataset.url, date: el.dataset.date } : null;
  }

  // Append two attribution <text> nodes to an SVG element, extending its
  // height and viewBox to make room.  Mutates the element in place.
  var ATTR_H = 38;
  function _addAttrToSVG(svgEl, attr) {
    if (!attr) return;
    var ns = 'http://www.w3.org/2000/svg';
    var h  = parseFloat(svgEl.getAttribute('height')) || 600;
    svgEl.setAttribute('height', h + ATTR_H);
    var vb = svgEl.getAttribute('viewBox');
    if (vb) {
      var p = vb.trim().split(/\s+/);
      if (p.length === 4) { p[3] = parseFloat(p[3]) + ATTR_H; svgEl.setAttribute('viewBox', p.join(' ')); }
    }
    var maxLen = 90;
    var urlText = attr.url.length > maxLen ? attr.url.slice(0, maxLen - 3) + '...' : attr.url;
    var style = 'font-family:sans-serif;font-size:11px;fill:#666;';
    var t1 = document.createElementNS(ns, 'text');
    t1.setAttribute('x', 10); t1.setAttribute('y', h + 16); t1.setAttribute('style', style);
    t1.textContent = 'Source: ' + urlText;
    var t2 = document.createElementNS(ns, 'text');
    t2.setAttribute('x', 10); t2.setAttribute('y', h + 30); t2.setAttribute('style', style);
    t2.textContent = 'Accessed on ' + attr.date;
    svgEl.appendChild(t1);
    svgEl.appendChild(t2);
  }

  function biExportSVG() {
    var svg = document.getElementById('chart');
    if (!svg) return;
    var clone = svg.cloneNode(true);
    _addAttrToSVG(clone, _getAttribution());
    var src = '<?xml version="1.0" encoding="UTF-8"?>\n'
            + new XMLSerializer().serializeToString(clone);
    var a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([src], { type: 'image/svg+xml;charset=utf-8' }));
    a.download = 'chart.svg';
    a.click();
    URL.revokeObjectURL(a.href);
  }
  function biExportPNG() {
    var svg = document.getElementById('chart');
    if (!svg) return;
    var attr   = _getAttribution();
    var w      = parseInt(svg.getAttribute('width'),  10) || 800;
    var h      = parseInt(svg.getAttribute('height'), 10) || 600;
    var extraH = attr ? ATTR_H : 0;
    var canvas = document.createElement('canvas');
    canvas.width = w; canvas.height = h + extraH;
    var ctx = canvas.getContext('2d');
    var src = new XMLSerializer().serializeToString(svg);
    var url = URL.createObjectURL(new Blob([src], { type: 'image/svg+xml;charset=utf-8' }));
    var img = new Image();
    img.onload = function () {
      ctx.fillStyle = '#fff';
      ctx.fillRect(0, 0, w, h + extraH);
      ctx.drawImage(img, 0, 0);
      URL.revokeObjectURL(url);
      if (attr) {
        var maxLen  = 90;
        var urlText = attr.url.length > maxLen ? attr.url.slice(0, maxLen - 3) + '...' : attr.url;
        ctx.font         = '11px sans-serif';
        ctx.fillStyle    = '#666';
        ctx.textBaseline = 'alphabetic';
        ctx.fillText('Source: ' + urlText,      10, h + 16);
        ctx.fillText('Accessed on ' + attr.date, 10, h + 30);
      }
      var a = document.createElement('a');
      a.href = canvas.toDataURL('image/png');
      a.download = 'chart.png';
      a.click();
    };
    img.src = url;
  }
  window.biExportSVG = biExportSVG;
  window.biExportPNG = biExportPNG;
}());
</script>

[% IF ref_min_y.defined %]
<script>
// Reference lines — drawn using the D3 `y` scale and `chart` group that
// render_zoomable_line_chart_snippet declares at the top level of its <script>
// block (not inside an IIFE), so they are accessible here.
(function () {
  var REF = {
    min: [% ref_min_y %],
    avg: [% ref_avg_y %],
    max: [% ref_max_y %]
  };
  var LINE_DEFS = [
    { id: 'rl-min', key: 'min', color: '#f59e0b', label: 'Min' },
    { id: 'rl-avg', key: 'avg', color: '#10b981', label: 'Avg' },
    { id: 'rl-max', key: 'max', color: '#ef4444', label: 'Max' }
  ];

  function colorDots() {
    // Recolor circle.pt dots whose Y value matches an active reference line.
    // Dots at REF.min get the Min color, dots at REF.max get the Max color,
    // all others revert to steelblue.  Only recolors when the corresponding
    // checkbox is checked so unchecking a line also resets the dot colors.
    if (typeof chart === 'undefined') return;
    var minCb = document.getElementById('rl-min');
    var maxCb = document.getElementById('rl-max');
    var showMin = minCb && minCb.checked;
    var showMax = maxCb && maxCb.checked;
    chart.selectAll('circle.pt').attr('fill', function (d) {
      if (showMin && d.value === REF.min) return '#f59e0b';
      if (showMax && d.value === REF.max) return '#ef4444';
      return 'steelblue';
    });
  }

  function drawRefLines() {
    // `chart` and `y` and `width` are declared by HTML::D3's snippet at the
    // top level of its <script> block — they are visible in this scope.
    if (typeof chart === 'undefined' || typeof y === 'undefined') return;
    chart.selectAll('.bi-ref-line').remove();
    chart.selectAll('.bi-ref-label').remove();
    LINE_DEFS.forEach(function (def) {
      var cb = document.getElementById(def.id);
      if (!cb || !cb.checked) return;
      var val  = REF[def.key];
      var yPos = y(val);
      chart.append('line')
        .attr('class', 'bi-ref-line')
        .attr('x1', 0).attr('x2', width)
        .attr('y1', yPos).attr('y2', yPos)
        .attr('stroke', def.color)
        .attr('stroke-width', 1.5)
        .attr('stroke-dasharray', '5 3')
        .attr('pointer-events', 'none');
      chart.append('text')
        .attr('class', 'bi-ref-label')
        .attr('x', width + 5)
        .attr('y', yPos + 4)
        .attr('fill', def.color)
        .attr('font-size', '11px')
        .attr('pointer-events', 'none')
        .text(def.label);
    });
    colorDots();
  }

  // Patch `redraw` (a function declaration — globally patchable) so that
  // reference lines recalculate whenever the chart updates.
  //
  // Why recalculate REF from newData?  HTML::D3 uses
  //   y.domain([0, d3.max(newData, d => d.value)]).nice()
  // so the y-domain minimum is always 0.  When the user zooms into a region
  // whose maximum is smaller than the full-dataset REF values, those values
  // fall above the visible domain and their pixel position is negative — i.e.
  // off-screen above the chart.  Recalculating from newData keeps the lines
  // inside the visible domain after every zoom or reset.
  //
  // Why setTimeout?  The `redraw` transition runs for `ms` ms (500 on zoom /
  // reset, 0 on initial render).  We must wait until the transition ends
  // before appending the reference lines; otherwise the y-axis is still
  // animating from its old position when we compute y(val), producing a
  // brief positional mismatch.
  if (typeof redraw === 'function') {
    var _origRedraw = redraw;
    redraw = function (newData, ms) {
      // Recalculate REF from the data currently being drawn so lines stay
      // within the visible y-domain even after a zoom or reset.
      if (newData && newData.length) {
        var yVals = newData.map(function (d) { return d.value; })
                          .filter(function (v) { return isFinite(v); });
        if (yVals.length) {
          REF.min = Math.min.apply(null, yVals);
          REF.max = Math.max.apply(null, yVals);
          REF.avg = yVals.reduce(function (a, b) { return a + b; }, 0) / yVals.length;
          // Update the checkbox label text to show the new recalculated value.
          // Each label is <label><input id="rl-*"> Min (X)</label>; the number
          // lives in the text node immediately after the <input>.
          LINE_DEFS.forEach(function (def) {
            var cb = document.getElementById(def.id);
            if (!cb || !cb.parentNode) return;
            var nodes = cb.parentNode.childNodes;
            for (var i = 0; i < nodes.length; i++) {
              if (nodes[i].nodeType === 3) {
                // 4 significant figures, stripping trailing zeros (like %.4g in Perl)
                var fmtVal = parseFloat(REF[def.key].toPrecision(4));
                nodes[i].textContent = nodes[i].textContent.replace(/\([^)]*\)/, '(' + fmtVal + ')');
              }
            }
          });
        }
      }
      // Remove stale lines before the transition starts.
      chart.selectAll('.bi-ref-line, .bi-ref-label').remove();
      _origRedraw(newData, ms);
      setTimeout(drawRefLines, (ms || 0) + 20);
    };
  }

  // Wire up checkboxes.
  LINE_DEFS.forEach(function (def) {
    var cb = document.getElementById(def.id);
    if (cb) cb.addEventListener('change', drawRefLines);
  });
}());
</script>
[% END %]

[% IF source_url %]
<div id="chart-attribution" data-url="[% source_url | html %]" data-date="[% source_accessed | html %]" hidden></div>
<p class="chart-source">Source: <a href="[% source_url | html %]" rel="noopener noreferrer">[% source_url | html %]</a></p>
<p class="chart-source">Accessed on [% source_accessed %]</p>
[% END %]

[%- END -%]
