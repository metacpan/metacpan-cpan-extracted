    "poll": {
      "why": "pollDeviceToken against a stub answering responses in order. waits is every delay the helper takes, in seconds, INCLUDING the one before a local deadline check. With a seam replacing BOTH the sleep and the monotonic clock, assert waits exactly. On the real clock assert each gap (call to first request, then request to request) is at least its wait - 0.05 s and under wait + 1 s, and that the call settles no sooner than sum(waits) - 0.05 s after it began. requests is exact, and every request is the exchangeDeviceCode form for clientId and device.device_code.",
      "cases": [
        {
          "name": "pending-then-token",
          "clientId": "internetdata-cli",
          "device": {
            "device_code": "mo_dc_poll",
            "user_code": "BCDF-GHJK",
            "verification_uri": "https://app.internetdata.io/device",
            "verification_uri_complete": "https://app.internetdata.io/device?user_code=BCDF-GHJK",
            "expires_in": 900,
            "interval": 1
          },
          "responses": [
            {
              "status": 400,
              "body": {
                "error": "authorization_pending"
              }
            },
            {
              "status": 200,
              "body": {
                "access_token": "mo_at_poll",
                "token_type": "Bearer",
                "expires_in": 3600,
                "refresh_token": "mo_rt_poll",
                "scope": "account.read"
              }
            }
          ],
          "expect": {
            "outcome": "token",
            "requests": 2,
            "waits": [
              1,
              1
            ],
            "token": {
              "access_token": "mo_at_poll"
            }
          }
        },
        {
          "name": "slow-down-widens-for-good",
          "clientId": "internetdata-cli",
          "device": {
            "device_code": "mo_dc_poll",
            "user_code": "BCDF-GHJK",
            "verification_uri": "https://app.internetdata.io/device",
            "verification_uri_complete": "https://app.internetdata.io/device?user_code=BCDF-GHJK",
            "expires_in": 900,
            "interval": 1
          },
          "why": "+5 s per slow_down, cumulative, and kept through a pending answer. Catches a widening that lasts one tick, one that does not accumulate, and one a pending answer resets.",
          "responses": [
            {
              "status": 400,
              "body": {
                "error": "slow_down"
              }
            },
            {
              "status": 400,
              "body": {
                "error": "authorization_pending"
              }
            },
            {
              "status": 400,
              "body": {
                "error": "slow_down",
                "error_description": "too many requests; slow down and try again"
              }
            },
            {
              "status": 200,
              "body": {
                "access_token": "mo_at_poll",
                "token_type": "Bearer",
                "expires_in": 3600,
                "refresh_token": "mo_rt_poll",
                "scope": "account.read"
              }
            }
          ],
          "expect": {
            "outcome": "token",
            "requests": 4,
            "waits": [
              1,
              6,
              6,
              11
            ]
          }
        },
