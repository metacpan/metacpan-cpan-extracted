#!/usr/bin/env perl

# Formal proof-style tests generated by /logic-reducer.
#
# Each subtest is a syllogism:
#   Major Premise  — a system invariant guaranteed by the API contract.
#   Minor Premise  — a specific input state.
#   Conclusion     — the post-condition that must hold.
#
# These tests prove logical invariants that are INDEPENDENT of path coverage;
# they complement t/path.t (which covers branches) by proving that mutually
# exclusive conditions behave correctly at their boundaries.

use warnings;
use strict;

BEGIN {
	# Prevent the real driver from loading; supply a minimal controllable mock.
	# set_row() is a plain function (not a method) — caller passes the hashref
	# directly as $_[0].
	$INC{'Genealogy/Obituary/Lookup/obituaries.pm'} = 1;

	package Genealogy::Obituary::Lookup::obituaries;

	my $_next_row;
	sub set_row           { $_next_row = $_[0] }
	sub new               { bless {}, ref($_[0]) || $_[0] }
	sub fetchrow_hashref  { $_next_row }
	sub selectall_hashref { defined($_next_row) ? [$_next_row] : [] }
}

use lib 'lib';
use lib 't/lib';
use Genealogy::Obituary::Lookup;

use File::Temp qw(tempdir);
use Scalar::Util qw(blessed);
use Test::Most;
use Readonly;

# ---------------------------------------------------------------------------
# Audit logger: records every method call to prove WHICH logger methods
# new() actually invokes for non-fatal events (bad directory, null byte).
# The contracted interface is {info, warn, error}; new() calls ->warn() for
# non-fatal diagnostics — this mock captures that call.
# ---------------------------------------------------------------------------
{
	package MockLoggerAudit;
	sub new    { bless { info => [], warn => [], error => [] }, shift }
	sub info   { push @{$_[0]->{info}},  $_[1] }
	sub warn   { push @{$_[0]->{warn}},  $_[1] }
	sub error  { push @{$_[0]->{error}}, $_[1] }
	sub _info  { @{$_[0]->{info}}  }
	sub _warn  { @{$_[0]->{warn}}  }
	sub _error { @{$_[0]->{error}} }
}

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

Readonly::Scalar my $PKG       => 'Genealogy::Obituary::Lookup';
Readonly::Scalar my $DIR       => tempdir(CLEANUP => 1);
Readonly::Scalar my $LAST      => 'Smith';
Readonly::Scalar my $PAGE      => '7';
Readonly::Scalar my $WAYBACK   =>
	'https://wayback.archive-it.org/20669/20231102044925/'
	. 'https://mlarchives.rootsweb.com/listindexes/'
	. 'emails?listname=gen-obit&page=';
Readonly::Scalar my $FREELISTS =>
	'https://www.freelists.org/post/obitdailytimes/Obituary-Daily-Times-';
Readonly::Scalar my $HTTP_URL  => 'https://example.com/obituary/123';

# Helper: fresh object pointed at the temp dir.
sub _obj { $PKG->new(directory => $DIR) }

# ===========================================================================
# INVARIANT 1 — Source dispatch exhaustion
#
# Major Premise:  _create_url() routes on source ∈ {M, F, L, other}.
# Invariant:      The three branches (if M|F / elsif L / fallthrough) are
#                 mutually exclusive and collectively exhaustive — no source
#                 value reaches more than one branch, and every value produces
#                 exactly one outcome.
# ===========================================================================

subtest '[DISPATCH-M] source=M routes to Wayback URL' => sub {
	# Major Premise: source ∈ {M,F} → URLS[source] . page (first branch).
	# Minor Premise: source='M', page=$PAGE.
	# Conclusion:    url = WAYBACK . PAGE.
	plan tests => 2;
	Genealogy::Obituary::Lookup::obituaries::set_row(
		{last => $LAST, first => 'A', source => 'M', page => $PAGE}
	);
	my $obj = _obj();
	my $hit = $obj->search(last => $LAST);
	ok(defined $hit,                'got a result');
	is($hit->{url}, $WAYBACK . $PAGE, 'Wayback URL assembled correctly');
};

subtest '[DISPATCH-F] source=F routes to FreeLists URL' => sub {
	# Major Premise: source ∈ {M,F} → URLS[source] . page (first branch).
	# Minor Premise: source='F', page=$PAGE.
	# Conclusion:    url = FREELISTS . PAGE.
	plan tests => 2;
	Genealogy::Obituary::Lookup::obituaries::set_row(
		{last => $LAST, first => 'A', source => 'F', page => $PAGE}
	);
	my $obj = _obj();
	my $hit = $obj->search(last => $LAST);
	ok(defined $hit,                    'got a result');
	is($hit->{url}, $FREELISTS . $PAGE, 'FreeLists URL assembled correctly');
};

subtest '[DISPATCH-L-N] source=L, http newspaper → returns newspaper URL' => sub {
	# Major Premise: source=L, newspaper =~ ^https?:// → return newspaper.
	# Conclusion:    url = $HTTP_URL (newspaper wins over bare page).
	plan tests => 2;
	Genealogy::Obituary::Lookup::obituaries::set_row(
		{last => $LAST, first => 'A', source => 'L',
		 page => $PAGE, newspaper => $HTTP_URL}
	);
	my $obj = _obj();
	my $hit = $obj->search(last => $LAST);
	ok(defined $hit,             'got a result');
	is($hit->{url}, $HTTP_URL,   'newspaper URL returned for L-source');
};

subtest '[DISPATCH-L-P] source=L, no newspaper, page is http URL → returns page' => sub {
	# Major Premise: source=L, newspaper undef, page =~ ^https?:// → return page.
	# Conclusion:    url = $HTTP_URL.
	plan tests => 2;
	Genealogy::Obituary::Lookup::obituaries::set_row(
		{last => $LAST, first => 'A', source => 'L', page => $HTTP_URL}
	);
	my $obj = _obj();
	my $hit = $obj->search(last => $LAST);
	ok(defined $hit,           'got a result');
	is($hit->{url}, $HTTP_URL, 'page URL returned when no newspaper');
};

subtest '[DISPATCH-L-X] source=L, neither newspaper nor page is http → croak' => sub {
	# Major Premise: source=L, neither field is an http URL → err_no_newspaper.
	# Conclusion:    search() croaks — proving the elsif exhausts the L branch.
	plan tests => 1;
	Genealogy::Obituary::Lookup::obituaries::set_row(
		{last => $LAST, first => 'A', source => 'L', page => $PAGE}
	);
	my $obj = _obj();
	throws_ok(
		sub { $obj->search(last => $LAST) },
		qr/undefined newspaper/,
		'croaks err_no_newspaper when L-source has no http URL'
	);
};

subtest '[DISPATCH-BAD] source ∉ {M,F,L} → croak err_bad_source' => sub {
	# Major Premise: after if(M|F) returns and elsif(L) is skipped, the only
	#                remaining path is the final croak.
	# Conclusion:    any other source value croaks — the dispatch is exhaustive.
	plan tests => 1;
	Genealogy::Obituary::Lookup::obituaries::set_row(
		{last => $LAST, first => 'A', source => 'X', page => $PAGE}
	);
	my $obj = _obj();
	throws_ok(
		sub { $obj->search(last => $LAST) },
		qr/Invalid source/,
		'croaks err_bad_source for unknown source value'
	);
};

# ===========================================================================
# INVARIANT 2 — Null-byte guard excludes the stat gate
#
# Major Premise:  The null-byte check and the untaint step share one outer
#                 `defined && !ref` block.  A path containing \0 is caught
#                 inside that block and returns before the untaint line or the
#                 subsequent stat gate.
# Invariant:      A path containing \0 cannot reach stat(); the carp fires
#                 first.  A clean path bypasses the null-byte branch and
#                 proceeds to stat().
# ===========================================================================

subtest '[NULL-GATE] null byte in directory triggers carp before stat' => sub {
	# Minor Premise: directory has a null byte embedded.
	# Conclusion:    new() returns undef; carp fires; stat never reached.
	plan tests => 2;
	my $badpath = $DIR . "/some\0evil";
	my $obj;
	warnings_exist { $obj = $PKG->new(directory => $badpath) }
		[qr/not a directory/i],
		'carp fires for null-byte path';
	ok(!defined($obj), 'new() returns undef for null-byte path');
};

subtest '[CLEAN-GATE] clean path reaches stat and succeeds for a valid dir' => sub {
	# Minor Premise: directory = $DIR (real temp dir, no null bytes).
	# Conclusion:    null-byte branch NOT taken → untaint succeeds → stat
	#                returns true → new() returns a blessed object.
	plan tests => 1;
	my $obj = $PKG->new(directory => $DIR);
	ok(blessed($obj), 'clean valid path reaches stat and returns blessed object');
};

# ===========================================================================
# INVARIANT 3 — Logger severity invariant: ->warn() is used for non-fatal
#               directory diagnostics, not ->error() or ->info()
#
# Major Premise:  new() carps and returns undef for a bad directory — it does
#                 NOT croak.  A non-fatal event should use a non-fatal logger
#                 method.  Log::Abstraction::error() calls die(); using it here
#                 would convert a graceful carp into a fatal exception.
# Invariant:      The directory-not-found and null-byte-in-path paths MUST
#                 call the logger's warn() method (non-fatal), never error().
# ===========================================================================

subtest '[LOGGER-WARN-DIR] bad directory calls logger->warn (not error)' => sub {
	# Major Premise: new() returns undef gracefully — it is not fatal.
	# The directory-not-found event is a warning, not an error.
	# Calling logger->error() (which dies in Log::Abstraction) would convert
	# a graceful return into a croak — violating the API contract.
	# Minor Premise: audit logger + bad directory.  Object::Configure replaces
	# the logger, so we pin it back after Object::Configure runs.
	# Conclusion:    ->warn() is called; ->error() is NOT called; no die.
	plan tests => 3;
	my $logger = MockLoggerAudit->new();
	my $obj;
	{
		# Object::Configure always injects its own logger.  Bypass it here so
		# we can audit which method new() calls on its logger.
		no warnings 'redefine';
		local *Object::Configure::configure = sub { return $_[1] };
		warnings_exist { $obj = $PKG->new(directory => '/no_such_path_$$', logger => $logger) }
			[qr/not a directory/i],
			'carp fires for nonexistent directory';
	}
	ok(!defined($obj),                 'new() returns undef');
	ok(scalar($logger->_warn) > 0,     '->warn() was called (not fatal ->error)');
};

subtest '[LOGGER-WARN-NULL] null-byte path calls logger->warn (not error)' => sub {
	# Minor Premise: audit logger + null-byte path; Object::Configure bypassed.
	# Conclusion:    ->warn() is called; no die.
	plan tests => 3;
	my $logger  = MockLoggerAudit->new();
	my $badpath = $DIR . "/x\0y";
	my $obj;
	{
		no warnings 'redefine';
		local *Object::Configure::configure = sub { return $_[1] };
		warnings_exist { $obj = $PKG->new(directory => $badpath, logger => $logger) }
			[qr/not a directory/i],
			'carp fires for null-byte path';
	}
	ok(!defined($obj),                 'new() returns undef');
	ok(scalar($logger->_warn) > 0,     '->warn() was called (not fatal ->error)');
};

# ===========================================================================
# INVARIANT 4 — Clone short-circuits all validation
#
# Major Premise:  blessed($class_in) → return immediately (clone path).
# Invariant:      A clone is constructed by hash-merge + bless only.  Logger
#                 validation and directory checks are not executed.
# ===========================================================================

subtest '[CLONE-BYPASS-LOGGER] clone with invalid logger bypasses logger validation' => sub {
	# Minor Premise: parent is valid; clone is called with logger => "not-an-object".
	# Conclusion:    new() returns a blessed clone without croaking.
	plan tests => 2;
	my $parent = $PKG->new(directory => $DIR);
	my $clone;
	lives_ok(
		sub { $clone = $parent->new(logger => 'not-an-object') },
		'clone bypasses logger validation'
	);
	ok(blessed($clone), 'clone is still a blessed object');
};

subtest '[CLONE-BYPASS-DIR] clone with bad directory bypasses directory check' => sub {
	# Minor Premise: parent is valid; clone is called with directory => nonexistent.
	# Conclusion:    new() returns a blessed clone (no -d check performed on clone).
	plan tests => 2;
	my $parent = $PKG->new(directory => $DIR);
	my $clone;
	lives_ok(
		sub { $clone = $parent->new(directory => '/no_such_path') },
		'clone bypasses directory check'
	);
	ok(blessed($clone), 'clone is blessed despite bad directory in args');
};

# ===========================================================================
# INVARIANT 5 — `last` field double-guard: schema catches format violations;
#               explicit check catches undef that schema passes through
#
# Major Premise:  Params::Validate::Strict enforces type/min/max/matches
#                 but passes undef for keys that are present-but-undef.
#                 The explicit `unless defined && length` guard is the second
#                 gate, catching that residual case.
# Invariant:      The two guards are non-overlapping and together cover the
#                 complete invalid partition for 'last'.
# ===========================================================================

subtest '[LAST-UNDEF] undef last passes schema structure but caught by explicit guard' => sub {
	# Minor Premise: last => undef — present in %args but undef.
	# Conclusion:    search() croaks with err_no_last (explicit guard fires).
	plan tests => 1;
	Genealogy::Obituary::Lookup::obituaries::set_row(
		{last => $LAST, first => 'A', source => 'M', page => $PAGE}
	);
	my $obj = _obj();
	throws_ok(
		sub { $obj->search(last => undef) },
		qr/mandatory/i,
		'undef last caught by explicit defined-and-length check'
	);
};

subtest '[LAST-EMPTY] empty-string last rejected by schema min=1 before explicit guard' => sub {
	# Minor Premise: last => "" — present, defined, but violates schema min => 1.
	# Conclusion:    search() croaks at schema gate (before explicit check).
	plan tests => 1;
	my $obj = _obj();
	throws_ok(
		sub { $obj->search(last => '') },
		qr/too short|min|mandatory|must match pattern/i,
		'empty last rejected at schema gate'
	);
};

# ===========================================================================
# INVARIANT 6 — Untaint post-condition: capture is infallible after null-byte
#               exclusion
#
# Major Premise:  m/\A([^\0]*)\z/ matches every string with no null bytes,
#                 including "" (the * quantifier accepts zero characters).
# Invariant:      Once the null-byte guard has returned for null-byte paths,
#                 the regex always produces a defined capture for all remaining
#                 plain-string directory values — the capture is infallible.
# ===========================================================================

subtest '[UNTAINT-EMPTY] empty-string directory: capture succeeds, then stat carps' => sub {
	# Minor Premise: directory = "" (no null byte, but -d "" is false).
	# The regex m/\A([^\0]*)\z/ matches "" → capture = "" (infallible).
	# Then -d "" is false → new() carps and returns undef.
	# Conclusion:    new() returns undef without crashing (regex did not fail).
	plan tests => 2;
	my $obj;
	warnings_exist { $obj = $PKG->new(directory => '') }
		[qr/not a directory/i],
		'carp fires for empty-string directory';
	ok(!defined($obj), 'new() returns undef for empty-string directory');
};

done_testing();
