+// clipping element pushes its own id on the clip stack, so unless the floating element clips, every element and tree
+// root carrying its id inherited the stand-in; when it clips, its descendants are clipped by it and only its own
+// entry is replaced. Attachments that lead around in a circle end unclipped.
+uint32_t Clay__ResolvePendingClipElementId(Clay__LayoutElementTreeRoot *root, int32_t depth) {
+    Clay_Context* context = Clay_GetCurrentContext();
