use strict;
use warnings;
use Test::More;
use File::Temp qw(tempdir);
use File::Path qw(make_path);
use Markdown::Pod::Embed;
use Markdown::Pod::Embed::Util qw(slurp blurp);

my $dir=tempdir(CLEANUP => 1);
my $fn="$dir/with space.pl";
blurp($fn, "print qq(ok\\n);\n");
blurp("$fn.md", "# NAME\n\nsample - a documented program\n");
chmod(0755, $fn);
my $original=slurp($fn);
my $processor_or=Markdown::Pod::Embed->new({dry_run => 1});
ok($processor_or->update($fn), 'dry run reports a change');
is(slurp($fn), $original, 'dry run preserves source');
ok(!-e "$fn.bak", 'dry run creates no backup');
$processor_or=Markdown::Pod::Embed->new({nobackup => 1});
ok($processor_or->update($fn), 'source is updated');
is((stat($fn))[2] & 0777, 0755, 'executable mode preserved');
is($processor_or->update($fn), 0, 'second update is unchanged');
make_path("$dir/t", "$dir/node_modules");
blurp("$dir/t/fixture.pm", "1;\n");
blurp("$dir/node_modules/vendor.pm", "1;\n");
is_deeply(Markdown::Pod::Embed->discover($dir), [$fn], 'discovery excludes fixtures and dependencies');
blurp("$dir/plain.pm", "1;\n");
is($processor_or->process("$dir/plain.pm"), undef, 'undocumented source is skipped');
is($processor_or->pod(), undef, 'reused processor does not expose previous POD');
blurp("$dir/data.pm", "1;\n__DATA__\nimportant data\n");
blurp("$dir/data.pm.md", "# NAME\n\ndata\n");
my $data=slurp("$dir/data.pm");
eval { $processor_or->update("$dir/data.pm") };
like($@, qr/data section/, 'unsafe data insertion is rejected');
is(slurp("$dir/data.pm"), $data, 'data remains intact');
my $status=system($^X, '-Ilib', 'bin/markpod', '--dry-run', $fn);
is($status, 0, 'CLI accepts a filename with spaces');
done_testing();
