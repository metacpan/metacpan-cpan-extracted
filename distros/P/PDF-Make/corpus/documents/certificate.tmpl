<doc page-size="A4" margin="60">
  <style h1="size:30;line-height:36;colour:#4a3510" text="size:12" />
  <box pad="24" border="#b08d3f">
    <h1 align="center">{% award.title %}</h1>
    <text align="center" size="11" spacing="10">This is to certify that</text>
    <text align="center" size="20"><b>{% recipient.name %}</b></text>
    <text align="center" size="11" spacing="10">{% award.reason %}</text>
    <text align="center" size="10" spacing="16"><i>{% award.date %}</i></text>
    <text align="center" size="10">{% award.signatory %}</text>
  </box>
</doc>
