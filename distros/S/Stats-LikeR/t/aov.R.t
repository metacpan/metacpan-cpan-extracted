my %ALIASED = (npk_full => ['N:P:K']);
# Levels R drops with their rows and this module keeps: see DIVERGENCE above.
my %DIVERGE = (br => { coef => ['tensionM'], level => { tension => ['M'] } });

my ($worst, $worst_at) = (0, '');
sub near {
	my ($got, $exp, $name, $floor) = @_;   # $floor: the scale below which the error is absolute
	if (!defined $exp) { ok(!defined $got, "$name: absent, as R's NA") or diag("got $got"); return }
	if (!defined $got) { fail("$name: missing"); return }
	my $scale = abs($exp) > $floor ? abs($exp) : $floor;
	my $rel = abs($got - $exp) / $scale;
	($worst, $worst_at) = ($rel, $name) if $rel > $worst;
	ok($rel <= 1e-9, $name) or diag("got $got, expected $exp, relative $rel");
}
sub is_nan { my $v = shift; defined $v && $v != $v }
my @COLS = ('Df', 'Sum Sq', 'Mean Sq', 'F value', 'Pr(>F)');

for my $key (sort keys %EXPECT) {
	my $e = $EXPECT{$key};
	my $d = $DATA{ $e->{data} };
	my $r = defined $e->{formula} ? aov($d, $e->{formula}) : aov($d);

	# the table
	my %rows = map { $_ => 1 } grep { ref $r->{$_} eq 'HASH' && exists $r->{$_}{Df} } keys %$r;
	for my $term (sort keys %{ $e->{table} }) {
		ok(delete $rows{$term}, "$key: has term '$term'") or next;
		for my $i (0 .. $#COLS) {
			my $x = $e->{table}{$term}[$i];
			if ($COLS[$i] eq 'Df') { is($r->{$term}{Df}, $x, "$key $term Df") }
			else { near($r->{$term}{ $COLS[$i] }, $x, "$key $term $COLS[$i]", 1e-300) }
		}
	}
	for my $t (@{ $ALIASED{$key} || [] }) {
		ok(delete $rows{$t}, "$key: aliased term '$t' kept") or next;
		is($r->{$t}{Df}, 0, "$key $t: Df 0");
		is($r->{$t}{'Sum Sq'}, 0, "$key $t: Sum Sq 0");
	}
	is_deeply([sort keys %rows], [], "$key: no terms R does not have");

	# coefficients, R's names
	my $dv = $DIVERGE{$key} || { coef => [], level => {} };
	for my $c (@{ $dv->{coef} }) {
		ok(is_nan(delete $r->{coefficients}{$c}), "$key coef $c: NaN, a level R drops");
	}
	for my $f (sort keys %{ $dv->{level} }) {
		for my $l (@{ $dv->{level}{$f} }) {
			my $gs = $r->{'group_stats'};
			my ($gm, $gn) = keys %{ $e->{gs} } == 1 ? ($gs->{mean}, $gs->{size}) : ($gs->{mean}{$f}, $gs->{size}{$f});
			ok(is_nan(delete $gm->{$l}) && delete $gn->{$l} eq '0', "$key group_stats $f=$l: size 0, a level R drops");
			ok((grep { $_ eq $l } @{ $r->{xlevels}{$f} }), "$key xlevels $f: keeps $l");
		}
	}
	is_deeply([sort keys %{ $r->{coefficients} }], [sort keys %{ $e->{coef} }], "$key: coefficient names");
	for my $c (sort keys %{ $e->{coef} }) {
		if (defined $e->{coef}{$c}) { near($r->{coefficients}{$c}, $e->{coef}{$c}, "$key coef $c", 1) }
		else { ok(is_nan($r->{coefficients}{$c}), "$key coef $c: NaN, R's NA") }
	}

	# fitted values, keyed by R's row names
	is_deeply([sort keys %{ $r->{'fitted_values'} }], [sort keys %{ $e->{fitted} }], "$key: fitted row names");
	my $fw = 0;
	for my $i (keys %{ $e->{fitted} }) {
		my ($g, $x) = ($r->{'fitted_values'}{$i}, $e->{fitted}{$i});
		my $rel = defined $g ? abs($g - $x) / (abs($x) > 1 ? abs($x) : 1) : 9**9**9;
		$fw = $rel if $rel > $fw;
	}
	($worst, $worst_at) = ($fw, "$key fitted") if $fw > $worst;
	ok($fw <= 1e-9, "$key: every fitted value") or diag("worst relative $fw");

	# group_stats
	my @f = sort keys %{ $e->{gs} };
	my $gs = $r->{'group_stats'};
	for my $f (@f) {
		my ($gm, $gn) = @f == 1 ? ($gs->{mean}, $gs->{size}) : ($gs->{mean}{$f}, $gs->{size}{$f});
		is_deeply($gn, $e->{gs}{$f}{size}, "$key group_stats size of $f");
		for my $l (sort keys %{ $e->{gs}{$f}{mean} }) {
			if (defined $e->{gs}{$f}{mean}{$l}) { near($gm->{$l}, $e->{gs}{$f}{mean}{$l}, "$key group_stats mean $f=$l", 1) }
			else { ok(is_nan($gm->{$l}), "$key group_stats mean $f=$l: NaN, an empty level") }
		}
	}
	is_deeply([sort keys %{ $gs->{mean} }], [@f == 1 ? sort keys %{ $e->{gs}{$f[0]}{mean} } : @f],
	          "$key group_stats: " . (@f == 1 ? 'keyed by level' : 'keyed by factor'));
}

# The stacked form and the same data written out long with a formula are one model.
{
	my (@v, @g);
	for my $grp (sort keys %{ $DATA{pg_n} }) { push @v, @{ $DATA{pg_n}{$grp} }; push @g, ("g$grp") x @{ $DATA{pg_n}{$grp} } }
	my $long = aov({ v => \@v, g => \@g }, 'v ~ g');
	my $st   = aov($DATA{pg_n});
	near($st->{Group}{'Sum Sq'}, $long->{g}{'Sum Sq'}, 'stacked and long forms: same Sum Sq', 1e-300);
	is($st->{Group}{Df}, $long->{g}{Df}, 'stacked and long forms: same Df');
}

diag(sprintf 'worst relative disagreement with R: %.3g (%s)', $worst, $worst_at);
done_testing();
