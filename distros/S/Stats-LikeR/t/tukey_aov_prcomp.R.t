# USArrests, in R's own column order: Murder, Assault, UrbanPop, Rape.
my @USA_ROWS = (
	[13.2,236,58,21.2],[10,263,48,44.5],[8.1,294,80,31],[8.8,190,50,19.5],
	[9,276,91,40.6],[7.9,204,78,38.7],[3.3,110,77,11.1],[5.9,238,72,15.8],
	[15.4,335,80,31.9],[17.4,211,60,25.8],[5.3,46,83,20.2],[2.6,120,54,14.2],
	[10.4,249,83,24],[7.2,113,65,21],[2.2,56,57,11.3],[6,115,66,18],
	[9.7,109,52,16.3],[15.4,249,66,22.2],[2.1,83,51,7.8],[11.3,300,67,27.8],
	[4.4,149,85,16.3],[12.1,255,74,35.1],[2.7,72,66,14.9],[16.1,259,44,17.1],
	[9,178,70,28.2],[6,109,53,16.4],[4.3,102,62,16.5],[12.2,252,81,46],
	[2.1,57,56,9.5],[7.4,159,89,18.8],[11.4,285,70,32.1],[11.1,254,86,26.1],
	[13,337,45,16.1],[0.8,45,44,7.3],[7.3,120,75,21.4],[6.6,151,68,20],
	[4.9,159,67,29.3],[6.3,106,72,14.9],[3.4,174,87,8.3],[14.4,279,48,22.5],
	[3.8,86,45,12.8],[13.2,188,59,26.9],[12.7,201,80,25.5],[3.2,120,80,22.9],
	[2.2,48,32,11.2],[8.5,156,63,20.7],[4,145,73,26.2],[5.7,81,39,9.3],
	[2.6,53,66,10.8],[6.8,161,60,15.6],
);
my @USA_COLS = qw(Murder Assault UrbanPop Rape);
my %USA;
for my $j (0 .. 3) {
	$USA{ $USA_COLS[$j] } = [ map { $_->[$j] } @USA_ROWS ];
}

my ($checks, %worst, %worst_at);

# An absolute floor, applied only to the quantities that are probabilities, and
# only in addition to the relative test -- a value of ordinary size still has to
# meet the relative limit above.
#
# It exists because of a real NV-width effect, measured rather than guessed.
# ptukey()'s internals are deliberately plain double / long double, exactly as
# R's src/nmath/ptukey.c has them, so the quadrature itself does not move with
# perl's NV.  What does move is its *argument*: q = |diff| / se comes from the
# aov mean square, which is computed in NV, so a wider NV shifts q in its last
# bits.  Deep in the tail that shift is relatively large and absolutely tiny.
# On the chickwts horsebean-casein comparison, where p adj is 3.07e-08:
#
#   NV width              p adj                    rel err   abs err
#   double                3.0701967967949884e-08   --        --
#   x87 long double       3.0701966635682254e-08   4.34e-08  1.3e-16
#   long double (5.12.5)  3.0701956643675032e-08   3.69e-07  1.1e-14
#   __float128            3.0701956643675032e-08   3.69e-07  1.1e-14
#
# So every build agrees on the p-value to about 1e-14 in absolute terms, which
# is all a probability in the 1e-8 tail can be asked for, and no build's answer
# is wrong in any way a user could act on.  The floor is set two orders above
# the worst absolute disagreement observed.  diff, lwr and upr are on the data's
# own scale and meet the relative limit on every width, so the floor does not
# apply to them.
my $P_ABS_FLOOR = 1e-12;

sub cmp_val {
	my ($which, $name, $got, $exp, $abs_floor) = @_;
	$checks++;
	if ($exp eq 'NaN') {
		return ok(!defined $got || $got != $got, "$name: NaN, as in R");
	}
	if (!defined $got) { fail("$name: got undef, expected $exp"); return 0 }
	my $err = $exp == 0 ? abs($got) : abs($got - $exp) / abs($exp);
	if ($err > ($worst{$which} || 0)) {
		$worst{$which}    = $err;
		$worst_at{$which} = sprintf '%s (R %s, got %.17g)', $name, $exp, $got;
	}
	my $ok = $err <= $TOL{$which};
	$ok ||= abs($got - $exp) <= $abs_floor if $abs_floor;
	ok($ok, $name)
		or diag(sprintf 'got %.17g, expected %s, rel err %.4g (tol %.3g, abs %.4g)',
			$got, $exp, $err, $TOL{$which}, abs($got - $exp));
	return $ok;
}

#
# Fits, computed once and shared by the table walk below.
#
my %PG = (weight => \@PG_WEIGHT, group => \@PG_GROUP);
my (@CW_W, @CW_F);
for my $lv (sort keys %CHICKWTS) {
	push @CW_W, @{ $CHICKWTS{$lv} };
	push @CW_F, ($lv) x scalar @{ $CHICKWTS{$lv} };
}
my %CW = (weight => \@CW_W, feed => \@CW_F);

my $AOV_PG = aov(\%PG, 'weight ~ group');
my $AOV_CW = aov(\%CW, 'weight ~ feed');
my %HSD_PG = map {
	my $cl = $_;
	($cl => TukeyHSD($AOV_PG, data => \%PG, formula => 'weight ~ group',
	                 'conf_level' => $cl))
} (0.95, 0.9, 0.99);
my $HSD_CW = TukeyHSD($AOV_CW, data => \%CW, formula => 'weight ~ feed');
my $ANOVA_MT = anova(\%MTCARS, 'mpg ~ wt + hp + disp');
my $LM_MT    = lm(formula => 'mpg ~ wt + hp + disp', data => \%MTCARS);
my $PC_SC    = prcomp(\%USA, scale => 1);
my $PC_NS    = prcomp(\%USA);

# prcomp sorts its variable names, while R keeps the data frame's column order,
# so every rotation / center / scale row has to be permuted once.  Doing it here
# rather than reordering the frozen table keeps the table exactly as R printed
# it.
my %R_COL_INDEX; @R_COL_INDEX{@USA_COLS} = 0 .. 3;
sub usa_permute {
	my ($p, $r_row) = @_;
	return [ map { $r_row->[ $R_COL_INDEX{$_} ] } @{ $p->{varnames} } ];
}

# One pairwise row of a TukeyHSD result, by comparison label.
sub tukey_row {
	my ($hsd, $key, $comparison) = @_;
	for my $row (@{ $hsd->{$key} }) {
		return [ $row->{diff}, $row->{lwr}, $row->{upr}, $row->{'p adj'} ]
			if $row->{comparison} eq $comparison;
	}
	return undef;
}

my $rows = 0;
while (my $line = <DATA>) {
	next if $line =~ /\A\s*#/ || $line !~ /\S/;
	chomp $line;
	my ($label, $csv) = split /\t/, $line;
	my @exp = split /,/, $csv;
	$rows++;

	if ($label =~ /\Aptukey\|(\S+)\|(\S+)\|(\S+)\z/) {
		cmp_val('ptukey', "ptukey($1, $2, $3)", ptukey($1, $2, $3), $exp[0]);
	}
	elsif ($label =~ /\Aqtukey\|(\S+)\|(\S+)\|(\S+)\z/) {
		cmp_val('qtukey', "qtukey($1, $2, $3)", qtukey($1, $2, $3), $exp[0]);
	}
	elsif ($label eq 'ptukey.upper|3|3|27') {
		cmp_val('ptukey', 'ptukey(3, 3, 27, upper)',
			ptukey(3, 3, 27, 'lower_tail' => 0), $exp[0]);
	}
	elsif ($label eq 'qtukey.upper|0.05|3|27') {
		cmp_val('qtukey', 'qtukey(0.05, 3, 27, upper)',
			qtukey(0.05, 3, 27, 'lower_tail' => 0), $exp[0]);
	}
	elsif ($label eq 'qtukey.inf2') {
		cmp_val('qtukey', 'qtukey(0.95, 2, 1e9)', qtukey(0.95, 2, 1e9), $exp[0]);
	}
	elsif ($label eq 'qnorm.975.sqrt2') {
		# the one closed form the studentized range has: for two means and
		# infinite df it is sqrt(2) * qnorm(0.975)
		cmp_val('qtukey', 'sqrt(2) * qnorm(0.975)',
			sqrt(2) * qnorm(0.975), $exp[0]);
	}
	elsif ($label eq 'aov.pg' || $label eq 'aov.cw') {
		my ($fit, $term) = $label eq 'aov.pg' ? ($AOV_PG, 'group')
		                                      : ($AOV_CW, 'feed');
		my @got = ($fit->{$term}{Df}, $fit->{$term}{'Sum Sq'},
		           $fit->{$term}{'Mean Sq'}, $fit->{$term}{'F value'},
		           $fit->{$term}{'Pr(>F)'}, $fit->{Residuals}{Df},
		           $fit->{Residuals}{'Sum Sq'}, $fit->{Residuals}{'Mean Sq'});
		my @nm = qw(Df SumSq MeanSq F p resDf resSumSq resMeanSq);
		cmp_val('aov', "$label $nm[$_]", $got[$_], $exp[$_],
			($nm[$_] eq 'p' ? $P_ABS_FLOOR : 0)) for 0 .. $#exp;
	}
	elsif ($label =~ /\Atukey\.pg(?:\.cl(\d+))?\|(\S+)\z/) {
		my $cl  = defined $1 ? $1 / 100 : 0.95;
		my $got = tukey_row($HSD_PG{$cl}, 'group', $2);
		ok($got, "$label: comparison present") or next;
		my @nm = ('diff', 'lwr', 'upr', 'p adj');
		# index 3 is 'p adj', the only probability in the row
		cmp_val('tukey', "$label $nm[$_]", $got->[$_], $exp[$_],
			($_ == 3 ? $P_ABS_FLOOR : 0)) for 0 .. $#exp;
	}
	elsif ($label =~ /\Atukey\.cw\|(\S+)\z/) {
		my $got = tukey_row($HSD_CW, 'feed', $1);
		ok($got, "$label: comparison present") or next;
		my @nm = ('diff', 'lwr', 'upr', 'p adj');
		# index 3 is 'p adj', the only probability in the row
		cmp_val('tukey', "$label $nm[$_]", $got->[$_], $exp[$_],
			($_ == 3 ? $P_ABS_FLOOR : 0)) for 0 .. $#exp;
	}
	elsif ($label =~ /\Aanova\.mt\|(\S+)\z/) {
		my $term = $1;
		my $t = $ANOVA_MT->{$term};
		ok($t, "$label: term present") or next;
		my @got = ($t->{Df}, $t->{'Sum Sq'}, $t->{'Mean Sq'},
		           $t->{'F value'}, $t->{'Pr(>F)'});
		my @nm = qw(Df SumSq MeanSq F p);
		for my $i (0 .. $#exp) {
			# R reports the Residuals row's F and p as NA; whether LikeR
			# reports undef or NaN there is checked by cmp_val's NaN branch.
			next if $exp[$i] eq 'NaN' && !defined $got[$i];
			cmp_val('anova', "$label $nm[$i]", $got[$i], $exp[$i],
				($nm[$i] eq 'p' ? $P_ABS_FLOOR : 0));
		}
	}
	elsif ($label eq 'lm.mt.coef') {
		my @nm = ('Intercept', 'wt', 'hp', 'disp');
		cmp_val('anova', "lm coef $nm[$_]",
			$LM_MT->{coefficients}{ $nm[$_] }, $exp[$_]) for 0 .. $#exp;
	}
	elsif ($label eq 'lm.mt.fit') {
		cmp_val('anova', 'lm r_squared',     $LM_MT->{'r_squared'},     $exp[0]);
		cmp_val('anova', 'lm adj_r_squared', $LM_MT->{'adj_r_squared'}, $exp[1]);
	}
	elsif ($label eq 'vif.mt') {
		my $v = vif(\%MTCARS, [qw(wt hp disp)]);
		my @nm = qw(wt hp disp);
		cmp_val('vif', "vif $nm[$_]", $v->{ $nm[$_] }, $exp[$_]) for 0 .. $#exp;
	}
	elsif ($label =~ /\Aprcomp\.(sc|ns)\.(sdev|center|scale|rot(\d))\z/) {
		my ($which, $what, $j) = ($1, $2, $3);
		my $p = $which eq 'sc' ? $PC_SC : $PC_NS;
		if ($what eq 'sdev') {
			cmp_val('sdev', "$label\[$_]", $p->{sdev}[$_], $exp[$_]) for 0 .. $#exp;
		}
		elsif ($what eq 'center' || $what eq 'scale') {
			my $e = usa_permute($p, \@exp);
			cmp_val('scale', "$label $p->{varnames}[$_]", $p->{$what}[$_], $e->[$_])
				for 0 .. $#exp;
		}
		else {
			# An eigenvector is only defined up to sign, and R and LikeR do not
			# agree on which one they return, so the comparison is made after
			# matching the sign on the first component.  Everything else about
			# the vector -- every ratio between its entries -- is still pinned.
			my $e   = usa_permute($p, \@exp);
			my $col = $j - 1;
			my @got = map { $p->{rotation}[$_][$col] } 0 .. 3;
			my $sgn = ($e->[0] * $got[0] < 0) ? -1 : 1;
			cmp_val('rotation', "$label $p->{varnames}[$_] (sign $sgn)",
				$sgn * $got[$_], $e->[$_]) for 0 .. 3;
		}
	}
	elsif ($label =~ /\Ascale\.mat(\.nc|\.ns)?\z/) {
		my $opt = !defined $1 ? {} : $1 eq '.nc' ? { center => 0 } : { scale => 0 };
		my $m = scale([[1, 2], [3, 4], [5, 6]], %$opt);
		# R's as.numeric() on a matrix walks it column-major
		my @got = ((map { $m->[$_][0] } 0 .. 2), (map { $m->[$_][1] } 0 .. 2));
		cmp_val('scale', "$label\[$_]", $got[$_], $exp[$_]) for 0 .. $#exp;
	}
	elsif ($label =~ /\Ascale\.(\S+)\z/) {
		my %opt = (
			'1to5'     => {},
			nocenter   => { center => 0 },
			noscale    => { scale  => 0 },
			neither    => { center => 0, scale => 0 },
			ctr3       => { center => 3 },
			'ctr3.sc2' => { center => 3, scale => 2 },
		);
		my $o = $opt{$1} or do { fail("unknown scale case '$1'"); next };
		my @got = scale(1 .. 5, %$o);
		cmp_val('scale', "$label\[$_]", $got[$_], $exp[$_]) for 0 .. $#exp;
	}
	else {
		fail("unhandled label '$label'");
	}
}

cmp_ok($rows,   '>', 690,  "reference rows exercised ($rows)");
cmp_ok($checks, '>', 750,  "values compared ($checks)");

#
# Properties the table cannot state.
#
{
	# ptukey and qtukey must invert each other to the accuracy of the weaker of
	# the two, over the whole grid rather than at one point.
	my $worst_rt = 0;
	for my $nm (2, 3, 5, 10) {
		for my $df (5, 27, 120) {
			for my $p (0.5, 0.9, 0.95, 0.99) {
				my $back = ptukey(qtukey($p, $nm, $df), $nm, $df);
				my $e = abs($back - $p) / $p;
				$worst_rt = $e if $e > $worst_rt;
			}
		}
	}
	# The round trip is limited by R's algorithm, not by the port.  R's
	# qtukey.c is a secant iteration that stops once successive iterates differ
	# by less than a hardcoded `const static double eps = 0.0001` -- an
	# absolute 1e-4 in q, not a relative tolerance on p -- so the inverse is
	# only good to about 1e-7 in p even in R itself.  Measured over this grid,
	# R's own worst round trip is 1.2744607e-07 at nmeans = 2, df = 27,
	# p = 0.5, and LikeR's is the same to the digits printed, which is the
	# strongest evidence here that the port really is faithful rather than
	# merely close.  The limit is set just above that shared figure: it would
	# catch the port drifting away from R's iteration, and does not pretend
	# either side is an exact inverse.
	cmp_ok($worst_rt, '<', 2e-7,
		sprintf 'ptukey(qtukey(p)) == p to R\'s own 1e-4 secant tolerance (worst %.3g)',
			$worst_rt);
	cmp_ok($worst_rt, '>', 1e-9,
		'...and is no better than that, exactly as in R (a tighter inverse '
		. 'would mean the qtukey port had stopped following R)');

	# The two tails must sum to 1.
	for my $q (1, 3, 5) {
		my $s = ptukey($q, 3, 27) + ptukey($q, 3, 27, 'lower_tail' => 0);
		cmp_ok(abs($s - 1), '<', 1e-14, "ptukey($q, 3, 27): the two tails sum to 1");
	}

	# TukeyHSD on 6 groups must produce all 15 pairs, and every interval must
	# contain its own difference.
	is(scalar @{ $HSD_CW->{feed} }, 15, 'chickwts: 6 groups give 15 comparisons');
	my $bad = 0;
	for my $row (@{ $HSD_CW->{feed} }) {
		$bad++ unless $row->{lwr} <= $row->{diff} && $row->{diff} <= $row->{upr};
	}
	is($bad, 0, 'chickwts: every Tukey interval contains its own difference');

	# A wider conf_level must widen every interval and leave every p adj and
	# every difference alone -- the adjusted p-value does not depend on the
	# level, which is a detail R gets right and an implementation can miss.
	for my $c (@{ $HSD_PG{0.95}{group} }) {
		my ($w) = grep { $_->{comparison} eq $c->{comparison} } @{ $HSD_PG{0.99}{group} };
		cmp_ok($w->{lwr}, '<', $c->{lwr}, "$c->{comparison}: 99% lwr below 95%");
		cmp_ok($w->{upr}, '>', $c->{upr}, "$c->{comparison}: 99% upr above 95%");
		cmp_ok(abs($w->{'p adj'} - $c->{'p adj'}), '<', 1e-14,
			"$c->{comparison}: p adj does not depend on conf_level");
	}

	# prcomp: the eigenvalues must account for the total variance.  With
	# scale.=TRUE every variable has unit variance, so sum(sdev^2) == ncol.
	my $tot = 0;
	$tot += $_ * $_ for @{ $PC_SC->{sdev} };
	cmp_ok(abs($tot - 4), '<', 1e-12,
		'prcomp(scale => 1): the eigenvalues sum to the number of variables');
	# and unscaled, to the total of the column variances
	my $tot_ns = 0;
	$tot_ns += $_ * $_ for @{ $PC_NS->{sdev} };
	my $var_sum = 0;
	for my $col (@USA_COLS) {
		my @v = @{ $USA{$col} };
		my $mean = 0; $mean += $_ for @v; $mean /= @v;
		my $ss = 0; $ss += ($_ - $mean) ** 2 for @v;
		$var_sum += $ss / (@v - 1);
	}
	cmp_ok(abs($tot_ns - $var_sum) / $var_sum, '<', 1e-12,
		'prcomp(): the eigenvalues sum to the total column variance');

	# Each rotation column must be a unit vector, in both scalings.
	for my $p ($PC_SC, $PC_NS) {
		for my $j (0 .. 3) {
			my $n = 0;
			$n += $p->{rotation}[$_][$j] ** 2 for 0 .. 3;
			cmp_ok(abs($n - 1), '<', 1e-12, "rotation column $j is a unit vector");
		}
	}

	# anova's sequential sums of squares must add up to lm's total.
	my $ss_tot = 0;
	$ss_tot += $ANOVA_MT->{$_}{'Sum Sq'} for keys %$ANOVA_MT;
	my @y = @{ $MTCARS{mpg} };
	my $ybar = 0; $ybar += $_ for @y; $ybar /= @y;
	my $tss = 0; $tss += ($_ - $ybar) ** 2 for @y;
	cmp_ok(abs($ss_tot - $tss) / $tss, '<', 1e-12,
		'anova: the sequential sums of squares add to the total');

	# vif accepts a formula as well as a list of names, and must agree.
	my $v1 = vif(\%MTCARS, [qw(wt hp disp)]);
	my $v2 = vif(\%MTCARS, 'mpg ~ wt + hp + disp');
	for my $k (qw(wt hp disp)) {
		cmp_ok(abs($v1->{$k} - $v2->{$k}), '<', 1e-12,
			"vif: the formula and arrayref forms agree on '$k'");
	}
}

diag(sprintf 'worst relative error vs R: %s',
	join ', ', map { sprintf '%s %.3g', $_, $worst{$_} } sort keys %worst);
diag("  $_: $worst_at{$_}") for grep { ($worst{$_} || 0) > 1e-12 } sort keys %worst;

done_testing();

