my %DATA = (MTCARS => \%MTCARS, SLEEP => \%SLEEP, IRIS => \%IRIS, TOOTH => \%TOOTH, AIR => \%AIR);
my $PTOL = 1e-8; # relative, see header
my @levelrows;
for my $c (@CASES) {
	my ($dn, $by, $var, $type, $nonpar, $test, $p, $overall, $grp) = @$c;
	my $tag = "$dn $var by $by" . ($nonpar ? ' nonparametric' : '') . ($type eq 'level' ? ' level' : '');
	if ($type ne 'level') {
		my $t1 = eval { table_one($DATA{$dn}, by => $by, vars => [$var],
			types => { $var => $type }, nonparametric => $nonpar) };
		if (!$t1) { fail("$tag: died: $@"); @levelrows = (); next }
		my ($row) = grep { $_->{variable} eq $var && (!defined $_->{level} || $_->{level} eq '') } @$t1;
		@levelrows = grep { $_->{variable} eq $var && defined $_->{level} && $_->{level} ne '' } @$t1;
		if (!$row) { fail("$tag: no row"); next }
		is($row->{test}, $test, "$tag: test label");
		near($row->{p_value}, $p, $PTOL, "$tag: p_value");
		if ($type eq 'continuous') {
			is($row->{Overall}, $overall, "$tag: Overall");
			is($row->{$_}, $grp->{$_}, "$tag: group $_") for sort keys %$grp;
		}
	} else {
		my $row = shift @levelrows;
		if (!$row) { fail("$tag: no level row"); next }
		is($row->{Overall}, $overall, "$tag: Overall");
		is($row->{$_}, $grp->{$_}, "$tag: group $_") for sort keys %$grp;
	}
}

my $m = \%MTCARS;
no_leaks_ok { table_one($m, by => 'am', vars => ['mpg']) } 'table_one does not leak'
	unless $INC{'Devel/Cover.pm'};

done_testing();
