# Claude Code — commit: skills/, agents/, hooks/, settings.json
# Ignore: local overrides, credentials, session data

# Tracked: shared config & extensibility
!/.claude/
.claude/*
!.claude/settings.json
!.claude/settings.local.json
!.claude/agents/
!.claude/agents/**
!.claude/skills/
!.claude/skills/**
!.claude/hooks/
!.claude/hooks/**
!.claude/rules/
!.claude/rules/**

# Local overrides (machine-specific)
.claude/*.local.*
.claude/local/

# Credentials & session state (never track)
.claude/.credentials.json
.claude/statsig/
.claude/todos/
.claude/projects/

.env
.env.*
!.env.example
Net-Async-WebSearch-*.tar.gz
Net-Async-WebSearch-*/
.build/
*.bak
*.swp
pm_to_blib
Makefile
Makefile.old
blib/
MYMETA.*
/searxng/

# karr materialized task view -- never commit
tasks/
config.yml
