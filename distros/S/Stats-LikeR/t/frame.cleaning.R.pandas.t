# fillna / ffill / bfill: pandas test_fillna.py
#--------
sub fill_args {
	my ($args, $f, $shape) = @_;
	my %a = %$args;
	$a{cols} = [ map { col_for($f, $shape, $_) } @{ $a{cols} } ] if $a{cols};
	if (ref $a{value} eq 'HASH') {
		$a{value} = { map { (col_for_loose($f, $shape, $_) => $a{value}{$_}) } keys %{ $a{value} } };
	}
	return %a;
}
# a dict key naming no column stays as it is (pandas ignores it)
sub col_for_loose { my ($f, $shape, $c) = @_; return $c unless $shape eq 'AoA'; for my $i (0 .. $#{ $f->{cols} }) { return $i if $f->{cols}[$i] eq $c } return $c . '_none' }
for my $c (@FILL) {
	my ($name, $op, $args, $in, $exp) = @$c;
	for my $shape (qw(AoA AoH HoA HoH)) {
		my %a = fill_args($args, $in, $shape);
		my $got = eval { no strict 'refs'; &{ \&{"Stats::LikeR::$op"} }(build($in, $shape), %a) };
		if ($@) { fail("pandas $name: $op [$shape] died: " . substr($@, 0, 100)); next }
		is_deeply(to_hoa($got, $shape, $in), $exp->{data}, "pandas $name: $op [$shape]")
			or diag('got ' . show(to_hoa($got, $shape, $in)) . "\nexp " . show($exp->{data}));
	}
}
# the input is never modified
{
	my $in = { x => [undef, 2], y => [undef, 2] };
	my $copy = { x => [undef, 2], y => [undef, 2] };
	fillna($in, value => -1); ffill($in); bfill($in);
	is_deeply($in, $copy, 'pandas test_inplace_dict_update_view: fillna/ffill/bfill do not modify their input');
}
# a missing key is NA and is filled in (README)
is_deeply(fillna([ { a => 1 }, { a => undef, b => 2 } ], value => 0), [ { a => 1, b => 0 }, { a => 0, b => 2 } ],
	'fillna: a missing key counts as NA, materialized when filled (README)')
	or diag('see README: "A missing hash key counts as NA and is materialized when filled"');
