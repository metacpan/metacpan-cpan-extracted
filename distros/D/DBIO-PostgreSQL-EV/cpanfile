requires 'perl', '5.020';

requires 'DBIO', '0.900007';
# Core carries what this transport fills or calls: the listen contract
# (_listen_watch), txn_do_async waiting on every statement and refusing a late
# one, _access_broker_call_options and _access_broker_pool_size for connect
# options beside an AccessBroker, DBIO::Util::mask_connect_secrets, and
# DBIO::Test::AsyncHarness::await, which gives the process alarm back, sets its
# own alarm a grace after the clock and catches a signal that arrives late
# (t/lib/GuardedWait.pm).
# DBIO::PostgreSQL carries quote_channel, number_placeholders (which also reads
# \? as a literal question mark and refuses a statement that mixes $N and ?),
# mask_error_details and mask_detail_values, and the SQL maker quoting t/102
# compares against. DBD::Pg comes with dbio-postgresql, whose floor covers the
# \? escape over the dbh (3.7.1 and later).
requires 'DBIO::PostgreSQL', '0.900007';
# EV::run returns a boolean (whether watchers are still active) from 4.15 on;
# DBIO::PostgreSQL::EV::Future::await reads it to tell a loop with nothing left
# from one that ran. An older EV returns nothing there, and every blocking
# wait dies with "the EV loop has nothing left that could complete it".
requires 'EV', '4.15';
# fork safety in a child (its exit, undef and finish leave the parent's session
# alone), error_fields cleared when a connection is lost, and no misdelivery to
# a nested loop run inside a callback.
requires 'EV::Pg', '0.09';
requires 'Future', '0.49';
# set_subname for the copy_in writer, so a refusal there names the caller's
# place; the same pin as DBIO core's.
requires 'Sub::Util', '1.70';

on test => sub {
  requires 'Test::More', '0.98';
  requires 'Test::Exception';
};
