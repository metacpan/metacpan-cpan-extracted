\B\.git\b
^blib/
^Makefile$
^Makefile\.old$
^MYMETA\.
^pm_to_blib$
^Punk-SAML-
\.tar\.gz$
^PSAML\.c$
^PSAML\.o$
^SAML\.bs$
^Install/
\.DS_Store
# t/02 and t/08 write a provider's metadata to the build root and unlink it
# in END. A run killed before END leaves one behind, and the author
# manifest test then reports a file nobody meant to ship.
^psaml-t0[0-9]-meta-
^psaml-t0[0-9]-.*\.xml$
