#!/usr/bin/env perl
# cohen_d() against effectsize 1.0.3 and effsize 0.8.1, with mpmath as the
# arbiter of its noncentral-t interval.
#
# PROVENANCE
#
# t/cohen_d.R.R, committed beside this file, generated every literal in %DATA,
# @R_ROWS and @FIXED under R 4.6.1 (2026-06-24) at options(digits = 17), and
# t/cohen_d.mpmath.py generated @MP_NCP from its output at mp.dps = 60:
#     Rscript t/cohen_d.R.R | python3 t/cohen_d.mpmath.py
# This test never invokes R or python; it reads the frozen literals.
#
# Neither package is installed here.  The generator carries, from their CRAN
# source tarballs, the pooled two-sample branch of effsize 0.8.1's
# cohen.d.default() (R/CohenD.R) -- d, the pooled SD, Hedges' J and the
# standard error S_d -- and effectsize 1.0.3's .get_ncp_t() (R/utils_ci.R),
# and solves the equations both packages' noncentral intervals are defined by
# with uniroot() over R's pt().  .get_ncp_t() itself minimises with optim(),
# which on these cases stops up to 5.9e-7 (relative) short of the root, so it
# is kept only to report that.  The data are the packages' own test data:
#
#   mtcars      effectsize tests/testthat/test-cohens_d.R, "cohens_d -
#               pooled" and "hedges_g": wt ~ am
#   iris        the same file, "cohens_d errors and warnings":
#               Sepal.Length against Sepal.Width, at ci = 0.80
#   issue23     effsize tests/testthat/testCohenD.R, issue #23's a and b
#   sleep       the same file, extra ~ group, noncentral = TRUE
#   cheese      the same file, "Cohen numeric first arg with own class"
#   howell      the same file, "confidence interval with non-central
#               distribution for two samples": Howell's Confidence Intervals
#               on Effect Size, the data of Adams, Wright and Lohr (1996),
#               drawn by the test's generate_data() under set.seed(537)
#   borenstein  the same file, "Two independent samples with Hedges G,
#               example from Borenstein et al, Introduction to
#               Meta-Analysis", set.seed(321)
#
# and two edge cases of no suite's: 'zero', two samples of the same four
# values, so d = 0 and the interval is symmetric; and 'two', two observations
# a group, the fewest cohen_d() takes (df = 2).  @FIXED is effectsize's "fixed
# values" test, on bayestestR 0.20.0's distribution_normal(n, mean, sd), which
# R/distribution.R defines as qnorm(ppoints(n), mean, sd); the test builds
# those vectors with qnorm() rather than reading them.  Its n = 2.5e5 row is
# not effectsize's; it puts df past 4e5, where exact_pnt() changes method.
#
# Each set runs at conf_level 0.8, 0.9, 0.95, 0.99 and 0.999, and through both
# ci_method values.  The packages' own pinned values, at the packages' own
# tolerances, are checked as well, below the frozen tables.
#
# WHAT IT PINS
#
# The default interval is effectsize's: t = d / sqrt(1/n1 + 1/n2) on
# n1 + n2 - 2 df, the noncentrality limits that put t at the noncentral t's
# alpha/2 points, scaled back by sqrt(1/n1 + 1/n2).  Through 0.3217 the only
# interval was d +- z * se, which effectsize's own mtcars test puts at 1.048
# to 2.737 for its 1.030 to 2.732, and which is still there as
# ci_method => 'normal'.
#
# WHERE IT DEPARTS FROM R, ON PURPOSE
#
# The noncentral limits are pinned to mpmath's, not to R's.  R's pt() is a
# series good to about 1e-12 in probability, which leaves the limits inverted
# from it good to 2e-10, the worst of them at borenstein's 0.999 lower limit,
# whose ncp of -0.39 is close to zero.  For |ncp| > 37.62 R does not sum the
# series at all (nmath/pnt.c, del^2 > 2 log(2) * 1021) but returns a normal
# approximation: iris's five upper limits, at ncp 38.7 to 42.4, are 1.0e-4 to
# 1.6e-3 from mpmath's in R, and @FIXED's n = 1e4 limits, near ncp -70, are
# 1.4e-6 from it.  Those rows are checked against mpmath only, and the size of
# R's error at each is asserted, so that a regenerated table which no longer
# shows it is noticed.  Where R sums its series, the limits are also held to
# R's at $TOL_R.  @FIXED's n = 2.5e5 row has no mpmath value -- mpmath's
# gammainc() does not converge at df/2 = 2.5e5 -- and there both R and
# exact_pnt() use Abramowitz and Stegun 26.7.10, so it is held to R's.
#
# TOLERANCE
#
# $TOL_EST, 1e-12 relative, for d, the pooled SD, Hedges' g, the standard
# error and the normal interval.  The worst disagreement with R observed on
# the double build is 1.3e-14, on cheese's 0.99 normal upper limit, whose
# value of 0.066 is -3 plus 3.066 and keeps only the digits that sum leaves;
# the estimates themselves agree to 1.6e-15.
#
# $TOL_NCT, 1e-11 relative, for the noncentral limits against mpmath.  The
# worst observed on the double build is 8.4e-13, at iris's 0.999 upper limit;
# the root is found to a relative step of 1e-12, which is what that is.
#
# $TOL_R, 1e-9 relative, for the noncentral limits against R where R sums its
# series: the worst observed is R's own 2e-10, above.
#
# The diag()s below report the worst of each on every run.  The data are
# 17-digit decimals of R's doubles, which a wider NV reads as slightly
# different numbers, at a relative distance of at most 2^-53 per value.
# Across the nine perls of ./test.all.perls.pl on 2026-10-17 the worst were
# 4e-15 on the estimates and 5.3e-14 on the normal interval, both on the
# long-double and quadmath perls, at borenstein's 0.999 lower limit of -0.076;
# 8.6e-13 on the noncentral limits, on the i686 and x87 builds; and R's own
# 2e-10 against $TOL_R everywhere.  That is 11-fold headroom on the noncentral
# limits and over 18-fold on the rest.  Against R it is 5-fold, but that
# disagreement is R's own error, frozen in the table, which no build changes.

require 5.010;
use strict;
use warnings FATAL => 'all';
use Test::More;
use Test::Exception;
use Test::LeakTrace 'no_leaks_ok';
use Stats::LikeR qw(cohen_d qnorm);
use Config;

my $TOL_EST = 1e-12;
my $TOL_NCT = 1e-11;
my $TOL_R   = 1e-9;
my $R_PNT_LIMIT = 37.62;   # sqrt(2 log(2) * 1021): beyond it R's pnt() is a normal approximation

# On a __float128 perl each exact_pnt() call is 30000 quadrature steps of
# quadmath libm: one interval took 3 s there on 2026-10-17, against 0.02 s on
# a double build, and the five levels made this file take 162 s.  There only
# conf_level 0.95 runs, every data set still included, unless EXTENDED_TESTING
# or AUTHOR_TESTING is set.  The long-double perls took 8 s and run it all.
my $ALL_LEVELS = $Config{nvtype} ne '__float128' || $ENV{EXTENDED_TESTING} || $ENV{AUTHOR_TESTING};

my %worst;
sub rel_ok {
	my ($got, $want, $kind, $tol, $name) = @_;
	my $err = $want == 0 ? abs($got) : abs($got - $want) / abs($want);
	ok($err <= $tol, $name) or diag(sprintf "  got %.17g\n  want %.17g", $got, $want);
	$worst{$kind} = [ $err, $name ] if !$worst{$kind} || $err > $worst{$kind}[0];
}

