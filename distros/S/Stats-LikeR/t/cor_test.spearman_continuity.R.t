#!/usr/bin/env perl
# cor_test(method => 'spearman', continuity => ...) against R 4.6.1's
# cor.test().
#
# Provenance: t/cor_test.spearman_continuity.R.R (committed next to this file)
# generated every value in @R_ROWS under R 4.6.1 (2026-11-03) at
# options(digits = 17), and says where each y comes from: R's own
# tests/reg-tests-2.R line 2425 ("and a little for Spearman's", x = 1:5,
# y = (8, 6, 7, 5, 3)), the corpus of t/cor_test.spearman.R.R, an n = 1300
# permutation past R's 1290 exact limit, and n = 6, y = (1, 5, 6, 3, 4, 2),
# whose S lies just above n(n^2 - 1)/6.  Re-run it with
#     Rscript t/cor_test.spearman_continuity.R.R
# This test never invokes R.
#
# What it pins.  Through 0.3413 cor_test() ignored `continuity` for Spearman
# and warned "continuity correction is not defined for Spearman in R and is
# ignored here".  R does define it: its pspearman() adds 1 to n(n^2 - 1)/6
# before forming r from S on the asymptotic t branch (cor.test.R lines
# 158-165, "Kendall et al (1939) p. 260").  On R's own case the corrected
# two-sided p is 0.096890237637730928 where cor_test() gave the uncorrected
# 0.03738607346849869.  Every row is crossed with continuity in {0, 1} and
# exact in {default, 1, 0}: the exact branches ignore the correction, in R
# and here, and the rows say so by agreeing in pairs.  `use warnings FATAL`
# turns the old warning into a failure.
#
# The straddle rows pin R's two-sided tail choice, which is the tail S lies
# in (q > (n^3 - n)/6), not the sign of the corrected r: at S = 36 > 35 the
# corrected r is positive, R doubles the lower tail, which is past 0.5, and
# returns 1.
#
# Tolerance.  1e-10 relative on S and p, as t/cor_test.spearman.R.t argues
# for the same quantities.  The worst disagreement measured over these rows
# on the double build on 2026-11-03 was 6.3e-14 for p_value and 7.2e-15 for
# the statistic, so 1e-10 is about 1600 times the larger, for the wider NV
# builds' AS 89 polynomial and t tails.

require 5.010;
use strict;
use warnings FATAL => 'all';
use Test::More;
use Stats::LikeR qw(cor_test);

my $TOL = 1e-10;   # justified in the header

my @MOD1301 = map { (37 * $_) % 1301 } 1 .. 1300;

my ($worst_p, $worst_s) = (0, 0);
sub rel_ok {
	my ($got, $exp, $name, $worst) = @_;
	my $rel = $exp == 0 ? abs($got) : abs($got - $exp) / abs($exp);
	$$worst = $rel if $rel > $$worst;
	ok($rel <= $TOL, $name)
		or diag(sprintf "got %.17g, expected %.17g, rel %.3e", $got, $exp, $rel);
}

