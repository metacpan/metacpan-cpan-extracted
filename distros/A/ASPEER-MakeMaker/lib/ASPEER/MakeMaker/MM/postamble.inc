#  Synchronize utility modules
# 
util_sync ::
	@$(ASPEER_MAKEMAKER_PM_TARGET) util_sync $(UPDATE_SOURCE_UTIL_FN)
	@$(ASPEER_MAKEMAKER_PM_TARGET) util_sync $(UPDATE_SOURCE_IMPORT_FN)


#  No arguments
#
ASPEER_MAKEMAKER_PM_DEFAULT=dump_param
$(ASPEER_MAKEMAKER_PM_DEFAULT) :
	@$(ASPEER_MAKEMAKER_PM_TARGET) $(ASPEER_MAKEMAKER_PM_DEFAULT)
