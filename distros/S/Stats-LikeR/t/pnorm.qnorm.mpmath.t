# The width the normal is computed to: NV_MANT_DIG on a LIKER_WIDE_NV build, else
# 53 (a double, or a long double with no l libm or of ppc64's double-double).
# See the header.
my $bits = Stats::LikeR::_incgamma_beta_bits();
my $width = $bits == 53 ? 'double' : ($bits == 64 ? 'long double' : ($bits == 113 ? '__float128' : ''));
BAIL_OUT("unexpected computed width of $bits bits (nvtype $Config{nvtype})") unless $width;
my $EPS = 2 ** (1 - $bits);

# K per group and width: see the header for how it was set.
my %K = (
	'double'      => { p => 8,  q => 48 },
	'long double' => { p => 16, q => 16 },
	'__float128'  => { p => 16, q => 16 },
);
my $K = $K{$width};

# smallest decimal exponent that is compared (see the header)
my $MIN10 = $width eq 'double' ? -300 : -4900;

# m * 2**e, exact: 2**e is exact down to the smallest subnormal, and every m * 2**e
# here is normal or a power of two (2**-1074 is the one subnormal)
sub nv { my ($m, $e) = @_; return $m * (2 ** $e); }

# relative error in units of EPS * scale, or undef when not compared
sub scaled_err {
	my ($got, $str, $is_log) = @_;
	my ($ex10) = $str =~ /e([-+]?\d+)\z/;
	return undef if defined $ex10 && $ex10 < $MIN10;
	my $exp = $str + 0;
	if ($exp == 0) { return $got == 0 ? 0 : 9e99 }
	return 9e99 if $got != $got;
	my $rel = abs($got - $exp) / abs($exp);
	my $scale = $is_log == 2 ? 1 : ((abs($exp) < 0.5 || !$is_log) ? 1 + abs(log(abs($exp))) : 1);
	return $rel / ($EPS * $scale);
}

my %worst_by;
sub check {
	my ($name, $K, $group, @pairs) = @_; # pairs: [got, expected-string, is_log]
	my @bad; my $w = 0;
	for my $i (0 .. $#pairs) {
		my $e = scaled_err(@{ $pairs[$i] }[0, 1, 2]);
		next unless defined $e;
		$w = $e if $e > $w;
		push @bad, sprintf('col %d: got %.36g want %s (%.3g K-units)', $i, $pairs[$i][0], $pairs[$i][1], $e) if $e > $K;
	}
	$worst_by{$group} = $w if !defined $worst_by{$group} || $w > $worst_by{$group};
	ok(!@bad, $name) or diag(join "\n", @bad);
}

for my $r (@PNORM) {
	my ($z, @e) = @$r;
	$z = nv(@$z);
	check(sprintf('pnorm(%.17g), both tails and logs', $z), $K->{p}, 'p',
		[pnorm($z), $e[0], 0], [pnorm($z, lower_tail => 0), $e[1], 0],
		[pnorm($z, log_p => 1), $e[2], 1], [pnorm($z, lower_tail => 0, log_p => 1), $e[3], 1]);
	my @v = @{ pnorm([$z, $z], lower_tail => 0) };
	is($v[1], pnorm($z, lower_tail => 0), sprintf('pnorm([%.17g]) is the scalar value', $z));
}
for my $r (@PNORM_MS) {
	my ($x, $mu, $sd, @e) = @$r;
	($x, $mu, $sd) = (nv(@$x), nv(@$mu), nv(@$sd));
	check(sprintf('pnorm(%.17g, mean => %.17g, sd => %.17g)', $x, $mu, $sd), $K->{p}, 'p',
		map { [pnorm($x, mean => $mu, sd => $sd, lower_tail => $_->[0], log_p => $_->[1]), $e[$_->[2]], $_->[1]] }
			[1, 0, 0], [0, 0, 1], [1, 1, 2], [0, 1, 3]);
}
for my $r (@QNORM) {
	my ($p, $lower, $want) = @$r;
	$p = nv(@$p);
	check(sprintf('qnorm(%.17g, lower_tail => %d)', $p, $lower), $K->{q}, 'q',
		[qnorm($p, lower_tail => $lower), $want, 2]);
}
for my $r (@QNORM_LOG) {
	my ($lp, $lower, $want) = @$r;
	$lp = nv(@$lp);
	check(sprintf('qnorm(%.17g, lower_tail => %d, log_p => 1)', $lp, $lower), $K->{q}, 'q',
		[qnorm($lp, lower_tail => $lower, log_p => 1), $want, 2]);
}

# The edges the wide path handles itself before pg_pnorm(), against R 4.6.1:
#   pnorm(Inf); pnorm(-Inf); pnorm(1, 1, 0); pnorm(0.5, 1, 0);
#   pnorm(2, 1, 0, lower = FALSE); pnorm(1, 1, 0, log = TRUE);
#   pnorm(0.5, 1, 0, log = TRUE); pnorm(1e308, -1e308, 1); pnorm(0, 0, 1e-320);
#   pnorm(-1, 0, 1e-310); pnorm(-Inf, log = TRUE); pnorm(Inf, lower = FALSE, log = TRUE)
# gave 1 0 1 0 0 0 -Inf 1 0.5 0 -Inf -Inf, and pnorm(NaN), pnorm(Inf, Inf) and
# pnorm(-Inf, -Inf) NaN. The 1e308 and 1e-310 rows overflow (x - mean) / sd on a
# double, and do not on a wide NV, where pg_pnorm() must give the same ends. The
# two subnormal sds are written as the powers of two nearest them, 2**-1063 and
# 2**-1030, which give R's answers too: perl 5.10.1 and 5.18.4 read the literal
# 1e-320 as 0, which made the first a step at the mean, and pnorm() 1.
{
	my $inf = 9**9**9;
	my $nan = $inf - $inf;
	my @edge = (
		[[$inf],                                       1,       'pnorm(Inf)'],
		[[-$inf],                                      0,       'pnorm(-Inf)'],
		[[1, mean => 1, sd => 0],                      1,       'sd 0, x = mean'],
		[[0.5, mean => 1, sd => 0],                    0,       'sd 0, x < mean'],
		[[2, mean => 1, sd => 0, lower_tail => 0],     0,       'sd 0, x > mean, upper'],
		[[1, mean => 1, sd => 0, log_p => 1],          0,       'sd 0, x = mean, log'],
		[[0.5, mean => 1, sd => 0, log_p => 1],        -$inf,   'sd 0, x < mean, log'],
		[[1e308, mean => -1e308],                      1,       '(x - mean) past DBL_MAX'],
		[[0, sd => 2**-1063],                          0.5,     'x = mean, subnormal sd'],
		[[-1, sd => 2**-1030],                         0,       '-1 / 2**-1030'],
		[[-$inf, log_p => 1],                          -$inf,   'log pnorm(-Inf)'],
		[[$inf, lower_tail => 0, log_p => 1],          -$inf,   'log upper pnorm(Inf)'],
	);
	is(pnorm(@{ $_->[0] }), $_->[1], "edge: $_->[2]") for @edge;
	for my $c ([[$nan], 'pnorm(NaN)'], [[$inf, mean => $inf], 'pnorm(Inf, Inf)'],
	           [[-$inf, mean => -$inf], 'pnorm(-Inf, -Inf)']) {
		my $v = pnorm(@{ $c->[0] });
		ok($v != $v, "edge: $c->[1] is NaN");
	}
}

diag(sprintf('worst observed on %s (units of the tolerance, K = %s): %s', $width,
	join(', ', map { "$_ $K->{$_}" } sort keys %$K),
	join(', ', map { sprintf('%s %.3g', $_, $worst_by{$_}) } sort keys %worst_by)));

done_testing();
