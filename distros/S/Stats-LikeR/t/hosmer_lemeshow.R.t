	[ 'doc', 48, 61.818095708002865, 46, 0.059544573329697204, 48 ],
	[ 'tie', 3, 0.89393517727380001, 0, 0, 2 ],
	[ 'tie', 4, 1.4933400719581078, 1, 0.22169895113893645, 3 ],
	[ 'tie', 5, 1.6758978679190975, 2, 0.43259689891958542, 4 ],
	[ 'tie', 6, 1.8217641567734644, 2, 0.40216932266390482, 4 ],
	[ 'tie', 7, 2.5013334941686174, 3, 0.47505013928980755, 5 ],
