#!/usr/bin/env perl
#
# interpolate(): a NaN cell is a gap, as in pandas, and the limit_* options
# select the same cells as pandas.
#
# Up to 0.3413 only undef was a gap: looks_like_number() accepts "nan", so a
# NaN cell was an anchor.  interpolate({v => [1,undef,3,"nan"+0,5,undef,7,8,9]},
# method => 'cubic') came back 1 NaN 3 NaN 5 NaN 7 8 9, where pandas gives
# 1 2 3 4 5 6 7 8 9, because the NaN anchor made the global fit NaN everywhere.
# ip_far(), which applies limit, is also rewritten here (O(n) instead of
# O(n * limit)); the table pins every limit / limit_direction / limit_area
# combination against pandas so that rewrite stays a change of cost only.
#
# Provenance:
#
#   * pandas 3.0.4 with scipy 1.18.1, Series.interpolate(), Series.ffill() and
#     Series.bfill() (pandas 3 no longer accepts method='pad'/'bfill' in
#     interpolate(); the fill is the same).  Every expected value is pandas'
#     own output, frozen in @CASES below by the generator committed beside this
#     file; re-run it with
#         python3 -I t/interpolate.nan.pandas.py
#     and paste the result over @CASES.  The test never calls it.
#   * The input series come from pandas/tests/series/methods/
#     test_interpolate.py: test_interp_limit, test_interp_limit_forward,
#     test_interp_limit_area, test_interp_limit_direction,
#     test_interp_limit_to_ends, test_interp_limit_before_ends,
#     test_interp_limit_direction_limit_exceeds_length and
#     test_interpolate_invalid_nonpositive_limit (the series it shares with
#     test_interp_limit), plus the series at line 676, and two series from the
#     2026-11-03 audit.  Many of pandas' own expected arrays are the
#     limit_* ones asserted there; the table crosses every method with the
#     whole option space rather than only the options those tests used.
#   * The NaN index: pandas' test_interp_nan_idx (pandas/tests/frame/methods/
#     test_interpolate.py) expects NotImplementedError, "Interpolation with
#     NaNs in the index has not been implemented".  interpolate() croaks on a
#     NaN in x for the same reason.
#
# Each case is run three ways: with every gap written as undef, with every gap
# written as NaN, and with the gaps alternating, and all three must give
# pandas' answer.  A gap that stays unfilled must come back as it went in.
#
# Tolerance: the local methods copy or linearly combine two doubles, and the
# global fits (quadratic .. polynomial) agree with scipy to about 1e-14
# relative on these 4..9 point columns; 1e-9 * (1 + |expected|) leaves five
# orders of headroom for long-double and quadmath builds without being loose
# enough to hide a wrong value (the bug gave NaN, or errors of order 1).

require 5.010;
use strict;
use warnings FATAL => 'all';
use Test::More;
use Stats::LikeR;

my $NaN = "nan" + 0;
sub isnan { defined $_[0] && $_[0] != $_[0] }

