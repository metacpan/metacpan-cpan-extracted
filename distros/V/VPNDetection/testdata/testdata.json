  "bogonResponse": {
    "why": "A bogon is answered locally in the full max shape. Every flag is present and false, every detail object is present and empty, and is_bogon marks it as computed rather than served.",
    "flagsFalse": [
      "is_vpn",
      "is_hosting",
      "is_relay",
      "is_tor",
      "is_cdn",
      "is_resproxy",
      "is_dcproxy",
      "is_mobproxy"
    ],
    "emptyObjects": [
      "vpn",
      "hosting",
      "relay",
      "tor",
      "cdn",
      "resproxy",
      "dcproxy",
      "mobproxy"
    ]
  },
  "lookup": [
    {
      "name": "free-not-vpn",
      "why": "The free shape. Every tier-gated member is absent, which means not-in-your-plan and must not read as false.",
      "status": 200,
      "body": {
        "ip": "1.1.1.1",
        "is_vpn": false
      },
      "expect": {
        "ip": "1.1.1.1",
        "isBogon": false,
        "present": {
          "is_vpn": false
        },
        "absent": [
          "is_hosting",
          "is_relay",
          "is_tor",
          "is_cdn",
          "is_resproxy",
          "is_dcproxy",
          "is_mobproxy",
