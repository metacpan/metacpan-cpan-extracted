  "errors": [
    {
      "name": "invalid-ip",
      "status": 400,
      "headers": {},
      "body": {
        "error": "not a valid IP address"
      },
      "expect": {
        "kind": "bad_request",
        "retryable": false,
        "message": "not a valid IP address"
      }
    },
    {
      "name": "invalid-key",
      "status": 401,
      "headers": {},
      "body": {
        "error": "invalid API key"
      },
      "expect": {
        "kind": "unauthorized",
        "retryable": false,
        "message": "invalid API key"
      }
    },
    {
      "name": "cidr-restricted",
      "status": 403,
      "headers": {},
      "body": {
        "error": "source address not allowed for this API key"
      },
      "expect": {
        "kind": "forbidden",
        "retryable": false
      }
    },
    {
      "name": "not-found-is-not-retryable",
      "why": "A 404 is a CLIENT error. Falling through to the server_error default makes it retryable, so a bad dataset id is retried before it fails. Only 5xx and transport failures are retryable.",
      "status": 404,
      "headers": {},
      "body": {
        "rc": "NOT_FOUND"
      },
      "expect": {
        "kind": "bad_request",
        "retryable": false
      }
    },
    {
      "name": "rate-limited-is-retryable",
      "why": "Retry-After present. This is the API protecting itself and retrying WILL succeed.",
      "status": 429,
      "headers": {
        "Retry-After": "1"
      },
      "body": {
        "error": "rate limit exceeded"
      },
      "expect": {
        "kind": "rate_limited",
        "retryable": true,
        "retryAfterSeconds": 1
      }
    },
    {
      "name": "keyless-daily-quota-is-not-retryable",
      "why": "No Retry-After. The keyless daily allowance is spent and retrying will not help.",
      "status": 429,
      "headers": {},
      "body": {
        "error": "daily limit for unauthenticated requests exceeded; use an API key"
      },
      "expect": {
        "kind": "quota_exceeded",
        "retryable": false
      }
    },
    {
      "name": "plan-quota-is-not-retryable",
      "status": 429,
      "headers": {},
      "body": {
        "error": "request allowance exceeded; raise or remove your overage limit"
      },
      "expect": {
        "kind": "quota_exceeded",
        "retryable": false
      }
    },
    {
      "name": "server-error-is-retryable",
      "status": 500,
      "headers": {},
      "body": {
        "error": "lookup failed"
      },
      "expect": {
        "kind": "server_error",
        "retryable": true
      }
    }
  ],
  "batch": [
    {
      "name": "dedup-bogon-and-order-free-keying",
      "why": "Duplicates collapse to one request, bogons never reach the network, and the result is keyed by IP so input order stops mattering.",
      "input": [
        "1.1.1.1",
        "8.8.8.8",
        "1.1.1.1",
        "10.0.0.1",
        "192.168.1.1"
      ],
      "expect": {
        "keys": [
          "1.1.1.1",
          "8.8.8.8",
          "10.0.0.1",
          "192.168.1.1"
        ],
        "httpRequests": 2,
        "bogonKeys": [
          "10.0.0.1",
          "192.168.1.1"
        ]
      }
    },
    {
      "name": "partial-failure-does-not-fail-the-batch",
      "why": "One address erroring must leave the others answered; the failure is carried in that key's value.",
      "input": [
        "1.1.1.1",
        "notanip"
      ],
      "expect": {
        "keys": [
          "1.1.1.1",
          "notanip"
        ],
        "errorKeys": [
          "notanip"
        ]
      }
    },
    {
      "name": "cache-hit-issues-no-second-request",
      "why": "The second batch over the same address is served entirely from the per-client cache.",
      "input": [
        "1.1.1.1"
      ],
      "repeat": 2,
      "expect": {
        "keys": [
          "1.1.1.1"
        ],
        "httpRequests": 1
      }
    }
  ],
  "middleware": {
    "why": "The framework middleware contract: how a block condition is evaluated, and which conditions must be refused outright. Field names are the WIRE names; each SDK maps them to its own idiom exactly as it maps a response.",
    "conditions": [
      {
        "name": "flag-true-matches",
        "why": "The simplest condition there is: a served flag that is true.",
        "body": {
          "ip": "45.83.91.1",
          "is_vpn": true,
          "is_hosting": true,
          "is_relay": false,
          "is_tor": false,
          "is_cdn": false,
          "is_resproxy": true,
          "is_dcproxy": false,
          "is_mobproxy": false,
          "vpn": {
            "provider": "nordvpn",
            "confidence": "high",
            "method": "rdns",
            "last_seen": "2026-09-01"
          },
          "hosting": {
            "provider": "ovh",
            "confidence": "medium",
            "last_seen": "2026-09-01"
          },
          "relay": {},
          "tor": {},
          "cdn": {},
          "resproxy": {
            "provider": "brightdata",
            "first_seen": "2026-06-01",
            "last_seen": "2026-09-01",
            "hits": 7,
            "hits_days_pct": 42,
            "providers_num": 2
          },
          "dcproxy": {},
          "mobproxy": {}
        },
        "condition": {
          "is_vpn": true
        },
        "expect": {
          "blocked": true,
          "missing": []
        }
      },
      {
        "name": "flag-true-against-false",
        "why": "A served flag that is false does not match.",
