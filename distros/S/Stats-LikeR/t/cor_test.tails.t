#!/usr/bin/env perl
#
# cor_test: the large-sample z approximation used by the Spearman and Kendall
# methods (`exact => 0`, and automatically whenever n is large or there are
# ties) built its two-sided p-value as `2 * (1 - pnorm(|z|))` and its `greater`
# p-value as `1 - pnorm(z)`. Neither form has any resolution below the ulp of
# 1.0, so a strong rank correlation reported a p-value of a flat 0. Both are now
# evaluated on the side they belong to -- `2 * pnorm(-|z|)` and `pnorm(-z)` --
# which costs nothing, since pnorm is erfc-based and accurate deep into its
# lower tail. R writes them the same way.
#
# References: R 4.6.1 cor.test(x, y, method = ..., alternative = ...,
# exact = FALSE), p.value and estimate. Kendall's statistic is the z itself and
# is checked too; Spearman's `statistic` differs by definition (R reports S,
# this module reports the z), so only estimate and p.value are compared there.
#
# Tolerances are derived, not chosen: d(log p)/d(log z) for the normal tail is
# about z^2, so a p-value this far out multiplies any last-digit difference in z
# by that factor. Budget 2e-12 of z wobble -- the spread seen between perl
# 5.10.1 and 5.44.0 on identical data -- and scale by z^2.

require 5.010;
use warnings FATAL => 'all';
use strict;
use Stats::LikeR;
use Test::More;

sub rel_ok {
	my ($got, $exp, $lbl, $tol) = @_;
	$tol = 1e-12 unless defined $tol;
	if ($got != $got) { fail("$lbl: got NaN, wanted $exp"); return 0 }
	my $scale = abs($got) > abs($exp) ? abs($got) : abs($exp);
	my $err   = $scale < 1e-300 ? abs($got - $exp) : abs($got - $exp) / $scale;
	if ($err <= $tol) { pass("$lbl (rel err $err <= $tol)"); return 1 }
	fail($lbl);
	diag("         got: $got\n    expected: $exp\n     rel err: $err");
	return 0;
}

