# Dist::Zilla itself runs on Perl 5.22 and later.
requires 'perl', '5.022';
requires 'Dist::Zilla', '6.000';
requires 'Dist::Zilla::Plugin::Bootstrap::lib';
requires 'Dist::Zilla::Plugin::Git::CheckFor::CorrectBranch';
requires 'Dist::Zilla::Plugin::InstallRelease';
requires 'Dist::Zilla::Plugin::LicenseFile', '0.002';
requires 'Dist::Zilla::Plugin::MakeMaker::Awesome';
requires 'Dist::Zilla::Plugin::MetaProvides::Package';
requires 'Dist::Zilla::Plugin::PodWeaver';
requires 'Dist::Zilla::Plugin::Prereqs::FromCPANfile';
requires 'Dist::Zilla::Plugin::ShareDir';
requires 'Dist::Zilla::Plugin::Test::ChangesHasContent';
requires 'Dist::Zilla::Plugin::TestRelease';
requires 'Dist::Zilla::Plugin::GatherAgentContext';
requires 'Dist::Zilla::PluginBundle::Git';
requires 'Dist::Zilla::PluginBundle::Git::VersionManager';
requires 'File::pushd';
requires 'Moose';
requires 'Path::Tiny';
requires 'Pod::Weaver';
requires 'Pod::Weaver::Section::GenerateSection';

# The coverage gate of the bundle loads Devel::Cover::DB when it runs for a
# dist, at that dist's release. The bundle itself never loads it, and no
# minimum version is measurable.
recommends 'Devel::Cover';

on test => sub {
  requires 'Test::More', '0.98';
  requires 'Dist::Zilla::Tester';
  requires 'Pod::Elemental';
  requires 'Pod::Simple';
  requires 'PPI';
  requires 'Software::License::Perl_5';
};
