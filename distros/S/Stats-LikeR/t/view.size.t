#!/usr/bin/env perl
# view()'s size: the bytes of the data it is given, in the first line of the
# table.
#
# Two things are tested apart, because a frame cannot be built to a chosen
# size: how a byte count is written, and how the bytes are counted.
#
# THE FORMAT is pandas'. view() writes a size as DataFrame.info() writes its
# "memory usage:" line -- "152.0 bytes", "22.5 KB", "1.4 GB" -- and the
# expected strings in @FMT are the output of the function pandas does that
# with: _sizeof_fmt() in pandas/io/formats/info.py, pandas 3.0.4, run under
# Python 3.14.2. Its docstring's own example is in the table
# (_sizeof_fmt(23028, "") is '22.5 KB'), as are counts of the kind pandas'
# tests pin for small frames ("memory usage: {n}.0 bytes" in
# pandas/tests/frame/methods/test_info.py). The table was generated by
# t/view.size.python.py, which sits next to this file and says how to re-run
# it; this test never calls it and needs neither Python nor pandas.
#
# Each row is [m, k, text] for m * 2**k bytes, m below 2**32, so that the
# count is exact on a perl with 32-bit integers and is rebuilt by doubling
# rather than by pow(). The rows cross every unit boundary, every exact tie in
# the tenths that such a product can make (pandas' "3.1f" rounds them half to
# even), a tenth that carries into the whole number, "1024.0" of a unit, and
# the counts past 1024 PB, which stay in PB. The strings are compared exactly:
# there is no tolerance, the arithmetic being integer.
#
# THE COUNT has no reference to freeze. How many bytes a structure takes is
# the perl's own business -- it moves with the pointer width, the IV and NV
# widths, the perl release (5.22 moved a double into the SV's head, 5.36 moved
# a hash's iterator) and the allocator's rounding of a string buffer -- so no
# byte count is written here. What is pinned instead is what must hold on
# every perl: the count is the same for the same structure, a thing reached
# twice is counted once, a cycle ends, a weak reference and a code reference
# are not entered, a tied container is not fetched from, and view() leaves the
# frame the size it found it. Against Devel::Size 0.87 on perl-5.44.0 the
# count differed by 8 bytes a string and nothing else on 200000-row frames;
# LikeR.xs, above ds_size(), has that comparison and why the 8 are
# Devel::Size's. It is not repeated here, since a test may not depend on a
# module being installed.
require 5.010;
use strict;
use warnings FATAL => 'all';
use Test::More;
use Test::Exception;
use Test::LeakTrace 'no_leaks_ok';
use Scalar::Util 'weaken';
use Stats::LikeR;

$ENV{COLUMNS} = 1000;	# one block of columns, whatever the terminal

my @FMT = (
