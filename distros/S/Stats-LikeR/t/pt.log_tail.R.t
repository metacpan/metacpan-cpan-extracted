#!/usr/bin/env perl
# pt(), pf(), qt() and qf() on the log scale for large degrees of freedom, in
# the far tail, against R 4.6.1.
#
# Provenance.  Every expected value was produced by t/pt.log_tail.R.R
# (committed next to this file) under R 4.6.1 (2026-06-24) at
# options(digits = 17); re-run it with
#     Rscript t/pt.log_tail.R.R
# except the rows marked ADJUDICATED, which are mpmath 1.3 at mp.dps = 60 from
# t/pt.log_tail.mpmath.py (python3 t/pt.log_tail.mpmath.py).  This test never
# invokes R, python3 or mpmath.  The four pt() rows of the audit of 2026-11-03
# (-960 on 2508.3 df, -3000 on 5000, -3008.9140148087536 on 14327.789749923935
# and the qt() row at log p = -7500 on 2500 df) are in the tables.
#
# What it pins.  incbeta_xy_core() sent every case with one shape >= 1000 and
# the other <= 1 to ib_bgrat() unless the continued fraction's own side
# applied.  bgrat's expansion is poor for a tiny variable, where R's
# bratio() uses bpser(): through 0.3413
#     pt(-960, 2508.3, log = TRUE)   was -7415.88159083737  for -7415.88468997047
#     pt(-3000, 5000, log = TRUE)    was NaN                for -18745.42067
#     pt(-3008.914..., 14327.78..., log = TRUE) was -46214.395501477
#                                                           for -46214.93154430409
#     qt(-7500, 2500, log = TRUE)    was -1001.09374101345  for -1001.0906694080401
# The table crosses both tails and both argument orders of pf().
#
# ADJUDICATED.  R's qt() stops refining early at these log p, and its qf() at
# one point returns a value past DBL_MAX; the module agrees with mpmath
# (bisection on the defining regularized incomplete beta, not a library
# inverse) in every case, so mpmath's value is the expectation and R's is
# recorded here:
#     qt(-1000, 1500):  R rel error 2.9e-08   qt(-7500, 14327.79): 2.9e-09
#     qt(-1000, 2500):  R 1.6e-09             qt(-5000, 14327.79): 3.6e-10
#     qt(-5000, 2500):  R 5.0e-11
#     qf(-10, 1, 2000, lower):   R 8.7e-05    qf(-10, 1, 1e5, lower): 1.3e-03
#     qf(-10, 2, 2000, lower):   R 7.4e-10    qf(-1, 1, 1e5, upper): 1.1e-11
# qf(-1000, 2000, 1, upper) and its kin are omitted: the true quantile, about
# e^2000, exceeds DBL_MAX, R prints 4.49e304 (an internal cap) and the module
# returns Inf.
# df stays at or below 1e5 because R's pt() uses a normal approximation above
# 4e5.
#
# Tolerance.  1e-11 relative throughout.  The worst disagreements observed on
# the double build were 1.1e-13 (pt), 2.2e-14 (pf), 9.6e-14 (qt) and 1.6e-12
# (qf, which inverts pf by root finding and stops where pf's rounding does),
# so the headroom is 6x for qf and 90x or more for the rest; the qf bound is
# the one the long-double and quadmath builds are most likely to press on, and
# it was not loosened.

require 5.010;
use strict;
use warnings FATAL => 'all';
use Test::More;
use lib 'blib/lib', 'blib/arch';
use Stats::LikeR qw(pt pf qt qf);

my $TOL = 1e-11;   # justified in the header: worst observed 1.6e-12

sub rel_ok {
	my ($got, $exp, $name) = @_;
	my $rel = abs($got - $exp) / abs($exp);
	ok($got == $got && $rel <= $TOL, $name)
		or diag(sprintf "got %.17g, expected %.17g, rel %.3e", $got, $exp, $rel);
}

