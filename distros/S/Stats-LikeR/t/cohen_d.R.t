# One result's noncentral limits against mpmath's, and against R's where R
# sums its series; where it does not, R's own error is what is asserted.
sub nct_ok {
	my ($r, $key, @R) = @_;
	my $hn = sqrt(1 / $r->{n1} + 1 / $r->{n2});
	my $mp = $MP{$key} or return fail("$key: no mpmath limits");
	for my $i (0, 1) {
		my $side = $i ? 'upper' : 'lower';
		my $want = $mp->[$i] * $hn;
		rel_ok($r->{conf_int}[$i], $want, 'nct vs mpmath', $TOL_NCT, "$key: nct $side limit, mpmath's");
		if (abs($mp->[$i]) <= $R_PNT_LIMIT) {
			rel_ok($r->{conf_int}[$i], $R[$i], 'nct vs R', $TOL_R, "$key: nct $side limit, R's");
		} else {
			my $r_err = abs($R[$i] - $want) / abs($want);
			ok($r_err > 1e-7, sprintf "%s: R's %s limit, at ncp %.1f, is its normal approximation, %.1g from mpmath's",
				$key, $side, $mp->[$i], $r_err);
		}
	}
}

my %res;   # set => the conf_level 0.95 result, for the packages' own checks below
for my $row (@R_ROWS) {
	my ($set, $cl, $d, $sd, $g, $se, $nlo, $nhi, $zlo, $zhi) = @$row;
	next unless $ALL_LEVELS || $cl == 0.95;
	my ($x, $y) = @{ $DATA{$set} }{qw(x y)};
	my $r = cohen_d($x, $y, conf_level => $cl);
	my $z = cohen_d($x, $y, conf_level => $cl, ci_method => 'normal');
	my $key = "$set $cl";
	$res{$set}{$cl} = $r;
	rel_ok($r->{estimate},  $d,  'estimates', $TOL_EST, "$key: d");
	rel_ok($r->{pooled_sd}, $sd, 'estimates', $TOL_EST, "$key: pooled SD");
	rel_ok($r->{hedges_g},  $g,  'estimates', $TOL_EST, "$key: Hedges' g, with effsize's J");
	rel_ok($r->{se},        $se, 'estimates', $TOL_EST, "$key: se, effsize's S_d");
	is($r->{ci_method}, 'nct', "$key: the default interval is 'nct'");
	is($z->{ci_method}, 'normal', "$key: ci_method => 'normal' says so");
	is($r->{conf_level}, $cl, "$key: conf_level");
	is_deeply([ @$r{qw(n1 n2)} ], [ scalar @$x, scalar @$y ], "$key: n1 and n2");
	nct_ok($r, $key, $nlo, $nhi);
	rel_ok($z->{conf_int}[0], $zlo, 'normal interval', $TOL_EST, "$key: normal lower limit");
	rel_ok($z->{conf_int}[1], $zhi, 'normal interval', $TOL_EST, "$key: normal upper limit");
	is($z->{estimate}, $r->{estimate}, "$key: ci_method changes only the interval");
}

# d = 0: each limit is the other's negative
for my $cl (sort keys %{ $res{zero} }) {
	my $ci = $res{zero}{$cl}{conf_int};
	rel_ok(-$ci->[0], $ci->[1], 'nct vs mpmath', $TOL_NCT, "zero $cl: the interval is symmetric about d = 0");
}

# effsize's "When inverting control and treatment effsize just change sign":
# swapping the groups negates d and mirrors the interval
{
	my $r = cohen_d(@{ $DATA{sleep} }{qw(y x)});
	my $s = $res{sleep}{0.95};
	is($r->{estimate}, -$s->{estimate}, 'sleep, groups swapped: d changes sign');
	rel_ok($r->{conf_int}[0], -$s->{conf_int}[1], 'nct vs mpmath', $TOL_NCT, 'sleep, groups swapped: lower limit is minus the upper');
	rel_ok($r->{conf_int}[1], -$s->{conf_int}[0], 'nct vs mpmath', $TOL_NCT, 'sleep, groups swapped: upper limit is minus the lower');
}

# effectsize's "fixed values": bayestestR's distribution_normal(n, mean, sd),
# qnorm(ppoints(n), mean, sd), with ppoints(n) = (1:n - 0.5) / n for n > 10
my %fixed;
for my $f (@FIXED) {
	my ($n, $m2, $s2, $cl, $d, $lo, $hi) = @$f;
	my @x = map { qnorm(($_ - 0.5) / $n) } 1 .. $n;
	my @y = map { $m2 + $s2 * qnorm(($_ - 0.5) / $n) } 1 .. $n;
	my $r = cohen_d(\@x, \@y, conf_level => $cl);
	my $key = "fixed_${n}_${m2}_$s2";
	$fixed{$key} = $r;
	rel_ok($r->{estimate}, $d, 'estimates', $TOL_EST, "$key: d");
	if ($MP{"$key $cl"}) {
		nct_ok($r, "$key $cl", $lo, $hi);
	} else {
		# df = 5e5 > 4e5: R and exact_pnt() both use A&S 26.7.10.  The worst
		# disagreement observed is 1.4e-13.
		rel_ok($r->{conf_int}[0], $lo, 'nct vs R, A&S 26.7.10', 1e-12, "$key: nct lower limit, R's");
		rel_ok($r->{conf_int}[1], $hi, 'nct vs R, A&S 26.7.10', 1e-12, "$key: nct upper limit, R's");
	}
}

# The packages' own pinned values, at their own tolerances: testthat's
# expect_equal() tolerance is a relative difference.
sub pkg_ok {
	my ($got, $want, $tol, $name) = @_;
	ok(abs($got - $want) <= $tol * abs($want), "$name: $want, to $tol") or diag("  got $got");
}
{
	my $mt = $res{mtcars}{0.95};
	pkg_ok($mt->{estimate},    1.892, 0.001, 'effectsize "cohens_d - pooled": Cohens_d');
	pkg_ok($mt->{conf_int}[0], 1.030, 0.001, 'effectsize "cohens_d - pooled": CI_low');
	pkg_ok($mt->{conf_int}[1], 2.732, 0.001, 'effectsize "cohens_d - pooled": CI_high');
	pkg_ok($mt->{hedges_g},    1.844, 0.001, 'effectsize "hedges_g": Hedges_g');
	my $hw = $res{howell}{0.95};
	pkg_ok($hw->{estimate},    0.62,  0.01,  'effsize "Non centrality parameter": estimate');
	# effsize asks for 0.117 to a tolerance of 0.001, which testthat reads as
	# relative: |x - 0.117| < 0.000117.  The limit is 0.1173390, and effsize's
	# own compute_ncp() gets 0.1173390 too and fails that check by the same
	# 0.0029; the quoted value is good to its three decimals, so that is how
	# it is checked here.
	ok(abs($hw->{conf_int}[0] - 0.117) < 0.0005,
		'effsize "confidence interval with non-central distribution for two samples": lower: 0.117, to three decimals');
	pkg_ok($hw->{conf_int}[1], 1.126, 0.001, 'effsize "confidence interval with non-central distribution for two samples": upper');
	pkg_ok($res{issue23}{0.95}{estimate}, 0.63236, 0.0001, 'effsize issue #23: estimate');
	pkg_ok($res{sleep}{0.95}{estimate}, -0.8321, 0.0001, 'effsize "Two samples paired formula paired and noncentral": estimate');
	pkg_ok($res{cheese}{0.95}{estimate}, -3, 0.1, 'effsize "Cohen numeric first arg with own class": estimate');
	pkg_ok($res{borenstein}{0.95}{hedges_g}, 0.5924, 0.0001, 'effsize, Borenstein et al.: Hedges g');
	ok($res{iris}{0.95}{estimate} > 0, 'effectsize "cohens_d errors and warnings": d has the sign of the t statistic');
	pkg_ok($fixed{fixed_10000_1_1}{estimate}, -1, 0.001, 'effectsize "fixed values": N(0, 1) against N(1, 1)');
	pkg_ok($fixed{'fixed_10000_1.5_2'}{estimate}, -sqrt(0.9), 0.01, 'effectsize "fixed values": N(0, 1) against N(1.5, 2)');
}

