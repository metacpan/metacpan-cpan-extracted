{
  "openapi": "3.1.0",
  "info": { "title": "Petstore 3.0", "version": "1.0.0" },
  "paths": {
    "/pets": {
      "get": {
        "operationId": "listPets",
        "parameters": [
          {
            "name": "limit", "in": "query",
            "schema": {
              "type": "integer", "exclusiveMinimum": 1,
              "maximum": 100, "default": 10
            }
          },
          {
            "name": "tags", "in": "query",
            "schema": { "type": "array", "items": { "type": "string" } }
          }
        ],
        "responses": {
          "200": {
            "description": "pets",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Pet" } }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createPet",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewPet",
                "description": "the pet to create"
              }
            },
            "text/plain": {}
          }
        },
        "responses": {
          "201": {
            "description": "created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Pet" }
              }
            }
          }
        }
      }
    },
    "/pets/{petId}": {
      "parameters": [
        { "name": "petId", "in": "path", "required": true, "schema": { "type": "integer" } }
      ],
      "get": {
        "operationId": "getPet",
        "parameters": [
          { "name": "X-Request-Id", "in": "header", "schema": { "type": "string", "minLength": 4 } }
        ],
        "responses": {
          "200": {
            "description": "one pet",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Pet" }
              }
            }
          },
          "404": { "description": "no such pet" }
        }
      },
      "delete": {
        "operationId": "deletePet",
        "parameters": [
          { "name": "session", "in": "cookie", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "204": { "description": "deleted" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Pet": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id":    { "type": "integer", "exclusiveMinimum": 0 },
          "name":  { "type": "string", "examples": ["Fido"] },
          "tag":   { "type": ["string", "null"] },
          "photo": { "type": "string", "contentEncoding": "base64" },
          "owner": {
            "anyOf": [
              { "$ref": "#/components/schemas/Owner" },
              { "type": "null" }
            ]
          },
          "score": {
            "type": "array",
            "prefixItems": [ { "type": "string" }, { "type": "integer" } ],
            "items": { "type": "boolean" }
          }
        }
      },
      "NewPet": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "tag":  { "type": ["string", "null"] }
        }
      },
      "Owner": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string" } }
      }
    }
  }
}
