#!/usr/bin/env perl
# epi_2x2(), against statsmodels and R.
#
# Provenance:
#   statsmodels 0.14.6 (NumPy 2.4.6), t/epi_2x2.R.statsmodels.py: Table2x2
#     oddsratio, oddsratio_confint, riskratio, riskratio_confint (log-scale
#     Wald), and statsmodels.stats.proportion.confint_proportions_2indep(
#     method="wald", compare="diff") for the risk difference.  The first table
#     is statsmodels/stats/tests/test_contingency_tables.py::Test2x2_1 (table
#     [[2, 2], [2, 2]]; upstream's own constants: oddsratio_confint
#     [0.062548836166112329, 15.987507702689751], riskratio_confint
#     [0.25009765325990629, 3.9984381579173824], which the frozen row below
#     matches).  The others are tables from R's Rd examples (fisher.test.Rd
#     Convictions and TeaTasting, mcnemar.test.Rd Performance, prop.test.Rd
#     smokers 1 vs 2 and 3 vs 4) and the README's own example.  Rows are
#     exposure, columns outcome, as in statsmodels.
#   R 4.6.2: odds ratio and its Wald interval from glm(binomial) +
#     confint.default (t/epi_2x2.R.statsmodels.R).
#   Zero cells and correct => 1: statsmodels and R have no +0.5 option, so the
#     corrected rows hand the table plus 0.5 in every cell to statsmodels, the
#     documented semantics of epi_2x2 (README, `correct`).  They test the
#     arithmetic after the correction, not the choice of correction.
# Re-run:  python3 -I t/epi_2x2.R.statsmodels.py ; Rscript t/epi_2x2.R.statsmodels.R
# This test never runs R or Python.
#
# Tolerances: statsmodels, 1e-12 relative (closed-form arithmetic; observed
# disagreement on double was a few ulp, headroom ~4500 epsilons for long
# double and quadmath).  R glm, 1e-9 relative: IRLS is an iteration; with R's
# default epsilon 1e-8 the CI bounds were off by up to 2.7e-6 ('rare'), so the
# generator runs glm.control(epsilon = 1e-14, maxit = 100) (R warns it did not
# converge for two tables, at the limit of double precision); the values then
# agree with the closed form to 4e-15 relative at worst, and 1e-9 leaves 2e5x
# (the glm iteration, not the arithmetic, is the limit on other builds).
#
# Deliberate differences:
#   - statsmodels Table2x2 has no number needed to treat; nnt is 1/|risk_diff|
#     (README; Inf for a zero difference).
#   - epi_2x2's z is qnorm(1 - (1 - conf_level)/2), the same as statsmodels'.

require 5.010;
use strict;
use warnings FATAL => 'all';
use Stats::LikeR;
use Test::Exception; # throws_ok / lives_and
use Test::More;
use Test::LeakTrace 'no_leaks_ok';

sub near {
	my ($got, $want, $tol, $name) = @_;
	my $scale = abs($want) > 1e-3 ? abs($want) : 1e-3;
	my $ok = defined $got && abs($got - $want) <= $tol * $scale;
	ok($ok, $name) or diag("got " . (defined $got ? $got : 'undef') . ", expected $want");
}

