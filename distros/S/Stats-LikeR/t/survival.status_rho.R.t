#!/usr/bin/env perl
# survfit(), logrank_test() and coxph(): the status coding, logrank_test()'s
# rho, and the inputs that used to hang, against R 4.6.1 with survival 3.8-12.
#
# Provenance.  Every expected value is R 4.6.1 survdiff(), survfit() or coxph()
# at options(digits = 17), from t/survival.status_rho.R.R, which is committed
# next to this file; re-run it with
#     Rscript t/survival.status_rho.R.R
# and paste its blocks over %DATA, %LR, %KM and %COX.  This test never invokes
# R.  The cases are:
#   lung_inst_rho0.5  survival 3.8-12 tests/cancer.R,
#                     survdiff(Surv(time, status) ~ inst, lung, rho=.5); its
#                     tests/cancer.Rout.save prints the same Observed and
#                     Expected to six figures, and "Chisq= 15.1 on 17 degrees
#                     of freedom, p= 0.5904".
#   lung_inst_rho0    the same data on the log-rank test.
#   ovarian_rho0      survival 3.8-12 man/survdiff.Rd,
#                     survdiff(Surv(futime, fustat) ~ rx, data=ovarian).
#   ovarian_rho1, aml_rho1, aml_rho2, aml_rho-0.5
#                     written here: rho across its range on ovarian and on
#                     tests/difftest.R's aml.
#   %KM               survival 3.8-12 man/Surv.Rd and tests/cancer.R,
#                     survfit(Surv(time, status) ~ ph.ecog, data=lung).
#   %COX              written here: coxph(Surv(time, status) ~ age, lung,
#                     iter.max = 65536).
# lung codes status 1 = censored, 2 = dead, so every lung case also reads that
# coding.  The lung cases leave out the row whose inst or ph.ecog is NA, which
# R drops under na.omit and which is an error here.
#
# What it pins.
#
# 1. Status coded 1/2.  Surv() reads a status whose largest value is 2 as
#    1 = censored, 2 = event.  Through 0.33 survfit() and logrank_test() took
#    any nonzero status as an event, so every lung row was a death; coxph()
#    alone read 1/2.  An invalid status, perl's false, and a 0 in a 1/2 column
#    are pinned below too.
# 2. rho.  logrank_test() read nothing after its third argument, so rho => 1
#    was accepted and answered as the log-rank test.
# 3. A NaN time, which passed srv_read()'s `t < 0` check: survfit() pushed onto
#    its curve until it ran out of memory, and logrank_test() never returned.
#    A NaN status, which read as an event, and an undef group label, which
#    made a group named "" and pooled with a real "", are refused too.
# 4. coxph()'s maxit was an unsigned short, so maxit => 65536 ran no
#    iterations at all and reported the null model's coefficient of 0.
#
# Departures from R, deliberate and recorded so that changing one is too:
#   * An undef or NaN time, status or group croaks, and so does an invalid
#     status.  R makes each NA, warns for the invalid status, and drops the row.
#   * std_err is the standard error of S, R's std.err * surv, as in
#     t/survival.t.
#
# Tolerance.  1e-12 relative (absolute below 1) on every real-valued field;
# the counts and the df are compared exactly.  Worst observed, on 2026-10-20
# with AUTHOR_TESTING=1, which reports it: 1.46e-14 on the double build
# (perl 5.44.0), 7.7e-16 on long double (5.12.5) and on quadmath.  The double
# figure is lung_inst_rho0's p-value and statistic, a quadratic form through
# the 16 x 16 reduced variance matrix of the 18 institutions, whose solve
# loses about 1e-14 at double width; the wider builds land on R's own
# rounding.  That leaves about 70x headroom.

require 5.010;
use strict;
use warnings FATAL => 'all';
use Test::More;
use Test::LeakTrace 'no_leaks_ok';
use lib 'blib/lib', 'blib/arch';
use Stats::LikeR qw(logrank_test survfit coxph);

my $TOL = 1e-12;   # relative; justified in the header

my $worst = 0;	#largest relative error seen, reported by diag() for the header
sub near {
	my ($got, $want, $name) = @_;
	if (!defined $want) { return ok(!defined $got, "$name is undef, as R gives NA") }
	if (!defined $got) { return fail("$name: got undef, want $want") }
	my $err = abs($got - $want) / (abs($want) > 1 ? abs($want) : 1);
	$worst = $err if $err > $worst;
	ok($err <= $TOL, $name) or diag("got $got, want $want, relative error $err");
}

