# Template only. Copy to .env and fill in -- .env is gitignored and must stay that way.
# Every value below is a placeholder; none of them are usable credentials.
# Compose reads this file for ${...} substitution in docker-compose.yml; a variable reaches a
# container only where docker-compose.yml passes it on.

# Skeid image. Unset: the published raudssus/langertha-skeid:latest.
# SKEID_IMAGE=raudssus/langertha-skeid:test

# Dev-mode OpenBao root token. Used by the openbao service and by skeid-init, which must
# agree on it -- one variable, both services.
OPENBAO_ROOT_TOKEN=skeid-dev-root-token

# OpenBao AppRole credentials, printed by skeid-init. Dev-mode OpenBao forgets them on every
# restart of its container: run skeid-init again and replace both.
OPENBAO_ROLE_ID=00000000-0000-0000-0000-000000000000
OPENBAO_SECRET_ID=00000000-0000-0000-0000-000000000000

# Admin API key -- gates /skeid/*. Absent or empty means the admin API answers 404.
SKEID_ADMIN_API_KEY=change-me-in-prod

# PostgreSQL password: the postgres service's, and what skeid.yaml's password_env reads.
POSTGRES_PASSWORD=skeid_password_change_me

# Upstream provider keys. skeid-init writes each one that is set into OpenBao at
# secret/skeid/remote/<provider>; Skeid reads it from there when a node's api_key_ref names
# that path. SKEID_GROQ_KEY feeds the sample node groq-main. Clear these once init has run.
SKEID_GROQ_KEY=
SKEID_OPENAI_KEY=
SKEID_ANTHROPIC_KEY=
