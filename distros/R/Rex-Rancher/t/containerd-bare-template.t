use strict;
use warnings;
use Test::More;

# -----------------------------------------------------------------------------
# k72 (kubernetes-ocp k196, R2): a containerd config.toml.tmpl that holds only
# `imports = [...]` and `version = 2` -- what Rex::GPU 0.001 and kubernetes-ocp
# before its k23 wrote -- is rendered by rke2 and k3s instead of their own
# containerd config: no SystemdCgroup, sandbox image or registry mirrors.
# install_server and install_agent remove it before they (re)start the
# service, for rke2 and k3s, decided by content and never by path: any other
# template is somebody's configuration and stays, with a log line. Then the
# existing rule restarts a running service whose config.toml is still that
# template's output, once, so the distribution renders its own config.
#
# run and file are faked: this proves the decision, the commands (cat and rm
# over the exec channel, before the start) and the log lines, not that a real
# rke2 or k3s renders its own config afterwards.
# -----------------------------------------------------------------------------

use Rex::Rancher::Server;
use Rex::Rancher::Agent;
use Rex::Rancher::Distribution;

my $D = 'Rex::Rancher::Distribution';

my @perl_warnings;
$SIG{__WARN__} = sub { push @perl_warnings, @_ };

# kubernetes-ocp's _legacy_containerd_template, byte for byte; Rex::GPU 0.001
# wrote the same two lines.
my $OCP     = qq{imports = ["/etc/containerd/conf.d/*.toml"]\nversion = 2\n};
my $FOREIGN = <<'TMPL';
{{ template "base" . }}

[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.custom]
  runtime_type = "io.containerd.runc.v2"
TMPL
my $EXTRA   = $OCP . qq{root = "/data/containerd"\n};
my $NATIVE  = <<'TOML';
# File generated by rke2. DO NOT EDIT. Use config-v3.toml.tmpl instead.
version = 3

[plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.runc.options]
  SystemdCgroup = true
TOML

# Fake host: %files maps path => content, $active is `systemctl is-active`,
# $rm_fails makes `rm` fail. @log records every command and file write.
my ( %files, @log, @info, @warn, $active, $rm_fails );
{
  no warnings 'redefine';
  my $run = sub {
    my ( $cmd ) = @_;
    push @log, $cmd;
    $? = 0;
    if ( $cmd =~ m{^cat (\S+) 2>/dev/null$} ) {
      return $files{$1} if exists $files{$1};
      $? = 1 << 8;
      return '';
    }
    if ( $cmd =~ m{^rm -f (\S+)} ) {
      if ($rm_fails) {
        $? = 1 << 8;
        return "rm: cannot remove '$1': Operation not permitted\n";
      }
      delete $files{$1};
      return '';
    }
    if ( $cmd =~ m{^test -e (\S+)$} ) { $? = exists $files{$1} ? 0 : 1 << 8; return '' }
    if ( $cmd =~ m{^systemctl is-active --quiet } ) { $? = $active ? 0 : 3 << 8; return '' }
    return "active\n"              if $cmd =~ m{^systemctl is-active };
    return "/usr/local/bin/rke2\n" if $cmd =~ m{^command -v rke2};
    return 'G' x 48                if $cmd =~ m{/dev/urandom};
    return "yes\n"                 if $cmd =~ m{^test -f };
    return '';
  };
  my $file = sub { push @log, 'file '.$_[0] };
  *Rex::Commands::Run::run    = $run;
  *Rex::Rancher::Server::run  = $run;
  *Rex::Rancher::Agent::run   = $run;
  *Rex::Commands::File::file  = $file;
  *Rex::Rancher::Server::file = $file;
  *Rex::Rancher::Agent::file  = $file;
  *Rex::Logger::info = sub { push @{ ( $_[1] // '' ) eq 'warn' ? \@warn : \@info }, $_[0] };
}

sub reset_host {
  my ( %args ) = @_;
  %files    = %{ $args{files} // {} };
  $active   = $args{active};
  $rm_fails = $args{rm_fails};
  ( @log, @info, @warn ) = ();
}

# The public functions, as a Rexfile calls them.
my %install = (
  server => sub {
    my ( $dist ) = @_;
    install_server( distribution => $dist, token => 't' x 32,
      ( $dist eq 'k3s' ? ( server => 'https://cp1:6443' ) : () ) );
  },
  agent  => sub {
    my ( $dist ) = @_;
    install_agent( distribution => $dist, token => 't',
      server => ( $dist eq 'k3s' ? 'https://cp1:6443' : 'https://cp1:9345' ) );
  },
);

sub start_index { my $i = 0; for (@log) { return $i if /^systemctl (?:start|restart) --no-block /; $i++ } return }
sub index_of    { my ( $re ) = @_; my $i = 0; for (@log) { return $i if $_ =~ $re; $i++ } return }

for my $dist (qw( rke2 k3s )) {
  for my $role (qw( server agent )) {
    my $d       = $D->new_for( $dist, role => $role );
    my $dir     = $d->containerd_dir;
    my $tmpl    = "$dir/config.toml.tmpl";
    my $service = $d->service;
    my $label   = $dist.' '.$role;

    is( $dir, "/var/lib/rancher/$dist/agent/etc/containerd", $label.': containerd dir' );

    subtest $label.': bare template, running service: removed before the start, then one restart' => sub {
      reset_host( active => 1, files => { $tmpl => $OCP, "$dir/config.toml" => $OCP } );
      $install{$role}->($dist);

      ok( !exists $files{$tmpl}, 'template removed' );
      my $rm    = index_of(qr{^rm -f \Q$tmpl\E\b});
      my $start = start_index();
      ok( defined $rm, 'rm -f over the exec channel' );
      ok( defined $rm && defined $start && $rm < $start, 'before the service is (re)started' );
      my $cat = index_of(qr{^cat \Q$tmpl\E 2>/dev/null$});
      ok( defined $cat && defined $rm && $cat < $rm, 'read with cat first' );
      is( $log[$start], "systemctl restart --no-block $service",
        'restarted, so '.$dist.' renders its own containerd config' );
      my @removed = grep { /Removing \Q$tmpl\E/ } @warn;
      is( scalar @removed, 1, 'the removal is logged as a warning' );
      like( $removed[0], qr/only imports and version = 2/, '... says what it held' );
      like( $removed[0], qr/instead of its own containerd config/, '... and why it goes' );
      ok( ( grep { /config\.toml was rendered from a config\.toml\.tmpl that is gone/ } @warn ),
        'the restart says why' );
      ok( !( grep { /Remove it/ } @warn ), 'no "Remove it" left to the user' );
    };

    subtest $label.': OCP form without the final newline: removed' => sub {
      ( my $no_nl = $OCP ) =~ s/\n\z//;
      reset_host( active => 1, files => { $tmpl => $no_nl, "$dir/config.toml" => $NATIVE } );
      $install{$role}->($dist);
      ok( !exists $files{$tmpl}, 'template removed' );
      my ( $rm, $start ) = ( index_of(qr{^rm -f \Q$tmpl\E\b}), start_index() );
      ok( defined $rm && defined $start && $rm < $start, 'before the start' );
    };

    subtest $label.': bare template, fresh node (nothing running, no config.toml): removed, then started' => sub {
      reset_host( active => 0, files => { $tmpl => $OCP } );
      $install{$role}->($dist);
      ok( !exists $files{$tmpl}, 'template removed before the first start' );
      is( $log[ start_index() ], 'systemctl '.$d->default_start_verb." --no-block $service",
        'the start the distribution does anyway' );
    };

    subtest $label.': foreign template: kept, with a note' => sub {
      reset_host( active => 1, files => { $tmpl => $FOREIGN, "$dir/config.toml" => $NATIVE } );
      $install{$role}->($dist);
      is( $files{$tmpl}, $FOREIGN, 'untouched' );
      ok( !( grep { /^rm / } @log ), 'no rm' );
      ok( ( grep { /Keeping \Q$tmpl\E/ } @info ), 'a note in the log' );
      ok( !( grep { /\Q$tmpl\E/ } @warn ), 'no warning about it' );
      is( $log[ start_index() ], 'systemctl '.$d->default_start_verb." --no-block $service",
        'start as without it' );
    };

    subtest $label.': template with a further directive: kept' => sub {
      reset_host( active => 1, files => { $tmpl => $EXTRA, "$dir/config.toml" => $NATIVE } );
      $install{$role}->($dist);
      is( $files{$tmpl}, $EXTRA, 'untouched' );
      ok( !( grep { /^rm / } @log ), 'no rm' );
      ok( ( grep { /Keeping \Q$tmpl\E/ } @info ), 'a note in the log' );
    };

    subtest $label.': no template: nothing done' => sub {
      reset_host( active => 1, files => { "$dir/config.toml" => $NATIVE } );
      $install{$role}->($dist);
      ok( !( grep { /^rm / } @log ), 'no rm' );
      ok( !( grep { /config\.toml\.tmpl/ } @info, @warn ), 'nothing logged about it' );
      is( $log[ start_index() ], 'systemctl '.$d->default_start_verb." --no-block $service",
        'start as always' );
    };

    subtest $label.': rm fails: dies loudly, nothing (re)started' => sub {
      reset_host( active => 1, rm_fails => 1, files => { $tmpl => $OCP, "$dir/config.toml" => $OCP } );
      ok( !eval { $install{$role}->($dist); 1 }, 'dies' );
      like( $@, qr/Could not remove \Q$tmpl\E/, 'names the file' );
      like( $@, qr/Operation not permitted/, 'carries rm\'s error' );
      like( $@, qr/\Q$service\E was not \(re\)started/, 'says the service was not touched' );
      ok( !defined start_index(), 'no systemctl start or restart' );
    };
  }
}

subtest 'remove_bare_containerd_template: return value' => sub {
  my $d    = $D->new_for('rke2');
  my $tmpl = $d->containerd_dir.'/config.toml.tmpl';
  reset_host( files => { $tmpl => $OCP } );
  is( $d->remove_bare_containerd_template, 1, 'removed: 1' );
  reset_host( files => { $tmpl => $FOREIGN } );
  is( $d->remove_bare_containerd_template, 0, 'foreign: 0' );
  reset_host();
  is( $d->remove_bare_containerd_template, 0, 'none: 0' );
  is_deeply( \@log, [ "cat $tmpl 2>/dev/null" ], 'none: only the cat' );
};

is_deeply( \@perl_warnings, [], 'no Perl warnings' );

done_testing;
