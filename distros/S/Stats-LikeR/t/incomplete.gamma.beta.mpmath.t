# The width the functions are computed to, which is not always the NV's: a
# long-double perl whose libm lacks the l functions, or whose long double is
# ppc64's double-double, keeps R's double port (LIKER_WIDE_NV in LikeR.xs), and
# an aarch64 long double is an IEEE quad, computed as __float128 is.
my $bits = Stats::LikeR::_incgamma_beta_bits();
my $width = $bits == 53 ? 'double' : ($bits == 64 ? 'long double' : ($bits == 113 ? '__float128' : ''));
BAIL_OUT("unexpected computed width of $bits bits (nvtype $Config{nvtype})") unless $width;

# The epsilon of that width: 2.2e-16, 1.08e-19 or 1.93e-34
my $EPS = 2 ** (1 - $bits);

# K per group and width: see the header for how it was set.
my %K = (
	'double'      => { gamma => 72, beta => 128, tiny => 8, quant => 32, bup => 24, eps => 8 },
	'long double' => { gamma => 8, beta => 24, tiny => 4, quant => 32, bup => 4, eps => 5 },
	'__float128'  => { gamma => 16, beta => 32, tiny => 4, quant => 32, bup => 5, eps => 4 },
);
my $K = $K{$width} or BAIL_OUT("unknown NV type $Config{nvtype}");

# smallest decimal exponent that is compared (see the header)
my $MIN10 = $width eq 'double' ? -250 : -4800;

sub nv { my ($m, $e) = @_; return $e >= 0 ? $m * (2 ** $e) : $m / (2 ** -$e); }

# [relative error / (NV_EPSILON * allowance scale), 1] for one value, or undef when it is not compared
sub scaled_err {
	my ($got, $str, $is_log) = @_;
	my ($ex10) = $str =~ /e([-+]?\d+)\z/;
	return undef if defined $ex10 && $ex10 < $MIN10;
	my $exp = $str + 0;
	return undef if $exp == 0;
	return 9e99 if $got != $got;
	my $rel = abs($got - $exp) / abs($exp);
	my $scale = $is_log == 2 ? 1 : ((abs($exp) < 0.5 || !$is_log) ? 1 + abs(log(abs($exp))) : 1);
	return $rel / ($EPS * $scale);
}

my $worst = 0;
sub check_row {
	my ($name, $K, @pairs) = @_; # pairs: [got, expected-string, is_log]
	my @bad; my $row_worst = 0;
	for my $i (0 .. $#pairs) {
		my $e = scaled_err(@{ $pairs[$i] }[0, 1, 2]);
		next unless defined $e;
		$row_worst = $e if $e > $row_worst;
		push @bad, sprintf('col %d: got %.20g want %s (%.3g K-units)', $i, $pairs[$i][0], $pairs[$i][1], $e) if $e > $K;
	}
	$worst = $row_worst if $row_worst > $worst;
	ok(!@bad, $name) or diag(join "\n", @bad);
	return $row_worst;
}

my %worst_by;
sub note_worst { my ($g, $w) = @_; $worst_by{$g} = $w if !defined $worst_by{$g} || $w > $worst_by{$g}; }

for my $r (@GAMMA) {
	my ($a, $x, @e) = @$r;
	$a = nv(@$a); $x = nv(@$x);
	my @got = (
		pchisq(2 * $x, df => 2 * $a, lower_tail => 1, log_p => 0),
		pchisq(2 * $x, df => 2 * $a, lower_tail => 0, log_p => 0),
		pchisq(2 * $x, df => 2 * $a, lower_tail => 1, log_p => 1),
		pchisq(2 * $x, df => 2 * $a, lower_tail => 0, log_p => 1),
	);
	note_worst(gamma => check_row(sprintf('P/Q(a=%.12g, x=%.12g) and logs', $a, $x), $K->{gamma},
		[$got[0], $e[0], 0], [$got[1], $e[1], 0], [$got[2], $e[2], 1], [$got[3], $e[3], 1]));
}

for my $r (@BETA) {
	my $group = ref $r->[0] ? 'beta' : shift @$r; # 'tiny', 'bup' or 'eps' where the row names one
	my ($a, $b, $x, $y, @e) = @$r;
	($a, $b, $x, $y) = (nv(@$a), nv(@$b), nv(@$x), nv(@$y));
	my @got = (
		Stats::LikeR::_incbeta_xy($a, $b, $x, $y, 0),
		Stats::LikeR::_incbeta_xy($b, $a, $y, $x, 0),
		Stats::LikeR::_incbeta_xy($a, $b, $x, $y, 1),
		Stats::LikeR::_incbeta_xy($b, $a, $y, $x, 1),
	);
	note_worst($group => check_row(sprintf('I_x(a=%.12g, b=%.12g), x=%.12g, both tails and logs', $a, $b, $x), $K->{$group},
		[$got[0], $e[0], 0], [$got[1], $e[1], 0], [$got[2], $e[2], 1], [$got[3], $e[3], 1]));
}

# The quantile functions invert the tails above, so they are as good as those and
# the root-finder: compared in relative terms with K epsilons.
for my $r (@QUANT) {
	my ($kind, $p, $d1, $d2, $lower, $str) = @$r;
	$p = nv(@$p); $d1 = nv(@$d1); $d2 = nv(@$d2) if $d2;
	my $q = $kind eq 'chisq' ? qchisq($p, df => $d1, lower_tail => $lower)
	      : $kind eq 't'     ? qt($p, df => $d1, lower_tail => $lower)
	      :                    qf($p, df1 => $d1, df2 => $d2, lower_tail => $lower);
	my $e = scaled_err($q, $str, 2);
	my $df = defined $d2 ? "$d1, $d2" : $d1;
	note_worst(quant => $e) if defined $e;
	ok(defined $e && $e <= $K->{quant}, sprintf('q%s(p=%.10g, df=%s, lower=%d)', $kind, $p, $df, $lower))
		or diag(sprintf('got %.20g want %s (%.3g K-units, K = %g)', $q, $str, $e // -1, $K->{quant}));
}

diag(sprintf('worst observed on %s (units of the tolerance, K = %s): %s', $width,
	join(', ', map { "$_ $K->{$_}" } sort keys %$K),
	join(', ', map { sprintf('%s %.3g', $_, $worst_by{$_}) } sort keys %worst_by)));

# Edges that need no reference: the tails of the same call add to 1, and the two
# orders of the same probability agree.
{
	my ($p, $q) = (pchisq(7.5, df => 4, lower_tail => 1), pchisq(7.5, df => 4, lower_tail => 0));
	cmp_ok(abs($p + $q - 1), '<=', 4 * $EPS, 'P + Q = 1 for pchisq(7.5, 4)');
	is(pchisq(0, df => 3), 0, 'pchisq(0) is 0');
	is(pchisq(0, df => 3, lower_tail => 0), 1, 'upper tail at 0 is 1');
	is(pchisq(9**9**9, df => 3), 1, 'pchisq(Inf) is 1');
	is(Stats::LikeR::_incbeta_xy(2, 3, 0, 1, 0), 0, 'I_0 = 0');
	is(Stats::LikeR::_incbeta_xy(2, 3, 1, 0, 0), 1, 'I_1 = 1');
	my $m = Stats::LikeR::_incbeta_xy(7.5, 7.5, 0.5, 0.5, 0);
	cmp_ok(abs($m - 0.5), '<=', 4 * $EPS, 'I_1/2(a, a) = 1/2');
}

done_testing();
