    sub { (parse_warnings("use warnings; use feature 'enhanced_xx';\n/a#b\n/x;\n") =~ /\ADid you mean this to be a comment\?/) ? 1 : 0 },
    sub { local $^W = 0; parse_warnings("use feature 'enhanced_xx';\n/[a #bad\nb]/xx;\n") eq '' },
    sub { local $^W = 1; (parse_warnings("use feature 'enhanced_xx';\n/[a #bad\nb]/xx;\n") =~ /\ADid you mean/) ? 1 : 0 },
    sub { local $^W = 1; parse_warnings("no warnings; use feature 'enhanced_xx';\n/[a #bad\nb]/xx;\n") eq '' },
    sub { parse_warnings("use warnings; no warnings 'regexp'; use feature 'enhanced_xx';\n/[a #bad\nb]/xx;\n") eq '' },
    sub { parse_warnings("use warnings; use feature 'enhanced_xx'; { no warnings; /[a #bad\nb]/xx; }\n") eq '' },
    sub { (parse_warnings("use warnings; use feature 'enhanced_xx'; { no warnings; }\n\$_ =~ /[a #bad\nb]/xx;\n") =~ /\ADid you mean/) ? 1 : 0 },
    sub { (parse_warnings("use v5.36; use feature 'enhanced_xx';\n/[a #bad\nb]/xx;\n") =~ /\ADid you mean/) ? 1 : 0 },
    sub { local $^W = 0; parse_warnings("use v5.34; use feature 'enhanced_xx';\n/[a #bad\nb]/xx;\n") eq '' },
    sub { parse_warnings("use warnings;\n/[a #nofeature\nb]/xx;\n") eq '' },
#
);

# returns the contents of a file
sub slurp {
    my($file) = @_;
    local $/ = undef;
    local *FH;
    open(FH, $file) or return '';
    my $text = <FH>;
    close(FH);
    return $text;
}

# returns 1 if the codepoint class "[a # x\nb]" of the script was
# transpiled without 'enhanced_xx' (only space is removed under /xx)
sub is_plain_cc {
    my($script) = @_;
    my $parsed = CORE::eval { mb::parse($script) };
    return 0 if not defined $parsed;
    return ($parsed =~ /mb::_cc\(qq\[a#x\nb\]\)/) ? 1 : 0;
}

# returns 1 if the codepoint class "[a # x\nb]" of the script was
# transpiled with 'enhanced_xx' (the comment and newline are removed)
sub is_enhanced_cc {
    my($script) = @_;
    my $parsed = quiet_parse($script);
    return 0 if not defined $parsed;
    return ($parsed =~ /mb::_cc\(qq\[ab\]\)/) ? 1 : 0;
}

# returns the error message of mb::parse, or '' if it did not die
sub parse_error {
    my($script) = @_;
    my $parsed = quiet_parse($script);
    return defined($parsed) ? '' : $@;
}

# returns the warnings given by mb::parse
sub parse_warnings {
    my($script) = @_;
    my @warning = ();
    local $SIG{__WARN__} = sub { push @warning, $_[0] };
    CORE::eval { mb::parse($script) };
    return join '', @warning;
}

